        <attvalues>
          <attvalue for="11" value="DETERMINES" />
          <attvalue for="12" value="High proportions of γ'-forming elements result in a γ' fraction of approximately 70%." />
          <attvalue for="13" value="Proportions of y'-forming elements such as Al, Ti and Ta should be high, such that the γ' fraction is ~70%." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-ed24a575ccc7da550855ce4a7d4ebb9f" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
