        <attvalues>
          <attvalue for="11" value="IS_OPERATION_IN" />
          <attvalue for="12" value="Open- and closed-die forging is an operation used for disc production." />
          <attvalue for="13" value="Process modelling of the operations used for disc production – particularly open- and closed-die forging, heat treatment and machining – is developing rapidly and will assume greater importance in the coming years." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-ee6f1e6770197cb40d6002c5cd9212fd" />
