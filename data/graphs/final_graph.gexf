      <node id="chunk-f7802da45487754a86d28619b81d1a73-e-9" label="Heat Engine">
        <attvalues>
          <attvalue for="0" value="Heat Engine" />
          <attvalue for="1" value="Machine Category" />
          <attvalue for="2" value="热机是一种将热能转化为机械功的技术装置。它利用工作介质在高温热源和低温热源之间循环，从而对外做功。转换效率是其核心性能指标，而卡诺循环定义了任何热机在给定温度下所能达到的理论最高效率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-f7802da45487754a86d28619b81d1a73" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;heat engines&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f7802da45487754a86d28619b81d1a73-e-9&quot;, &quot;chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-1&quot;, &quot;chunk-2f922c93a3f1955e166d2270226ee05e-e-10&quot;, &quot;chunk-fab5556d25e36a12308d5e081229601a-e-7&quot;, &quot;chunk-569a3d8aec20d9df6a256b4cf4b263a7-e-5&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-f7802da45487754a86d28619b81d1a73-e-10" label="Power Output">
        <attvalues>
          <attvalue for="0" value="Power Output" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="功率输出 (Power Output) 是衡量热机性能的关键物理量，指其在单位时间内对外输出的有效功。在热力学中，它的数值大小取决于工质的温升或温差。该属性通常以瓦特（W）或马力（hp）为单位进行度量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-f7802da45487754a86d28619b81d1a73" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f7802da45487754a86d28619b81d1a73-e-10&quot;, &quot;chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-2&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f7802da45487754a86d28619b81d1a73-e-11" label="Temperature Increment">
        <attvalues>
          <attvalue for="0" value="Temperature Increment" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="温升（Temperature Increment）是一个热力学属性，指热机中工质被加热所提升的温度范围。它是一个决定热机性能和功率输出的关键参数，通常温升越大，热机的功率输出也越高。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-f7802da45487754a86d28619b81d1a73" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f7802da45487754a86d28619b81d1a73-e-11&quot;, &quot;chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-4" label="Working Fluid">
        <attvalues>
          <attvalue for="0" value="Working Fluid" />
          <attvalue for="1" value="Substance" />
          <attvalue for="2" value="工质，又称工作流体，是在热力系统中借以实现能量转换和传递的流体介质。它通过自身的状态变化（如气液相变）经历一个完整的热力循环，从而在热机中将热能转化为机械功，或在制冷与热泵系统中传递热量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-fde6ea024225fb3f2b1ed1373ce39c8f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Working fluid&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-4&quot;, &quot;chunk-b455c334b535d063bfe8817108154093-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-5" label="Carnot's Reversible Heat Engine">
        <attvalues>
          <attvalue for="0" value="Carnot's Reversible Heat Engine" />
          <attvalue for="1" value="Device" />
          <attvalue for="2" value="卡诺可逆热机是一种理想化的理论模型，它以理想气体为工作物质，在两个热源之间进行可逆的卡诺循环，从而将热量转化为功。其效率代表了在相同高低温热源下，任何热机所能达到的最大理论效率，是热力学的重要基准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-fde6ea024225fb3f2b1ed1373ce39c8f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-5&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-6" label="Ideal Gas">
        <attvalues>
          <attvalue for="0" value="Ideal Gas" />
          <attvalue for="1" value="Substance" />
          <attvalue for="2" value="作为卡诺可逆热机中的工作物质，它在高温热源和低温热源之间进行可逆循环，通过周期性地吸收和释放热量，实现热能与机械功之间的转换。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-fde6ea024225fb3f2b1ed1373ce39c8f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-7" label="Hot Reservoir">
        <attvalues>
          <attvalue for="0" value="Hot Reservoir" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="在热力学中，高温热储（Hot Reservoir）指一个具有恒定高温（T₁）的大热容量热源。作为热机（如卡诺引擎）的组成部分，它向工作物质提供热量（QAB），而自身温度保持不变。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;T₁&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-fde6ea024225fb3f2b1ed1373ce39c8f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;hot reservoir&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-7&quot;, &quot;chunk-7e7c6ace2cc9c7181a60293d264541f2-e-2&quot;, &quot;chunk-9b0d001712f3c9617fcf101c325d1706-e-8&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-8" label="Cold Reservoir">
        <attvalues>
          <attvalue for="0" value="Cold Reservoir" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="在热力学中，冷源是一种理想化的热力学系统，通常具有极大的热容量。它在热力学过程中作为低温热源或热沉，能从其他系统吸收任意有限的热量，而其自身温度可认为保持恒定不变。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;T₂&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-fde6ea024225fb3f2b1ed1373ce39c8f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-8&quot;, &quot;chunk-7e7c6ace2cc9c7181a60293d264541f2-e-4&quot;, &quot;chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-9" label="QAB">
        <attvalues>
          <attvalue for="0" value="QAB" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="一个物理量，符号为QAB，指热力学系统在从状态A转变为状态B的过程中所传递的热量。它是一个过程量，根据热力学第一定律，与该过程中的功（W）共同构成系统内能变化的总和。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-fde6ea024225fb3f2b1ed1373ce39c8f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Heat (QAB)&quot;, &quot;QAB (Heat Absorbed)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-9&quot;, &quot;chunk-7e7c6ace2cc9c7181a60293d264541f2-e-1&quot;, &quot;chunk-8b3b1764bb264c55b0e58ee44dab55cb-e-2&quot;, &quot;chunk-2f21206d7404a291608cd3acb39afcf6-e-8&quot;, &quot;chunk-c7e7be1b79841f37e4aee97dd32c3432-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-10" label="QCD">
        <attvalues>
          <attvalue for="0" value="QCD" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="一个物理量，指热力学系统在从状态C到状态D的等温压缩过程中向外界放出的热量。在此过程中，系统温度保持不变，内能不变，因此放出的热量在数值上等于外界对系统所做的功 (WCD)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-fde6ea024225fb3f2b1ed1373ce39c8f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Heat (QCD)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-10&quot;, &quot;chunk-7e7c6ace2cc9c7181a60293d264541f2-e-3&quot;, &quot;chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-5&quot;, &quot;chunk-2f21206d7404a291608cd3acb39afcf6-e-9&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-11" label="T₁">
        <attvalues>
          <attvalue for="0" value="T₁" />
          <attvalue for="1" value="Temperature" />
          <attvalue for="2" value="T₁是一个热力学状态变量，表示气体在特定热力学过程（BC过程）中的初始绝对温度。它作为过程的起点温度，与终点温度T₂共同决定了理想气体内能的变化量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-fde6ea024225fb3f2b1ed1373ce39c8f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-11&quot;, &quot;chunk-40c0e393b62f65182f74ede2f3638558-e-8&quot;, &quot;chunk-c7e7be1b79841f37e4aee97dd32c3432-e-4&quot;, &quot;chunk-7e4651521e38ecb1e7b820e4fae7814d-e-1&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-12" label="T₂">
        <attvalues>
          <attvalue for="0" value="T₂" />
          <attvalue for="1" value="Temperature" />
          <attvalue for="2" value="T₂ 是一个热力学状态变量，表示气体在经历特定热力学过程（如BC过程）后达到的最终绝对温度。它定义了系统的末态，并与初态温度T₁共同用于计算该过程中的内能变化量 ΔU = nR(T₁ - T₂)/(γ-1)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-fde6ea024225fb3f2b1ed1373ce39c8f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-12&quot;, &quot;chunk-40c0e393b62f65182f74ede2f3638558-e-9&quot;, &quot;chunk-c7e7be1b79841f37e4aee97dd32c3432-e-5&quot;, &quot;chunk-7e4651521e38ecb1e7b820e4fae7814d-e-2&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-7e7c6ace2cc9c7181a60293d264541f2-e-7" label="Conservation of Energy">
        <attvalues>
          <attvalue for="0" value="Conservation of Energy" />
          <attvalue for="1" value="Physical Law" />
          <attvalue for="2" value="能量守恒定律是物理学中的一项基本定律。它指出，在一个孤立系统中，总能量保持恒定。能量既不能被创造，也不能被消灭，只能从一种形式（如动能、势能、热能）转化为另一种形式，或从一个物体转移到另一个物体。该定律是热力学第一定律的基础，支配着功与热的转换关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-7e7c6ace2cc9c7181a60293d264541f2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7e7c6ace2cc9c7181a60293d264541f2-e-10" label="V">
        <attvalues>
          <attvalue for="0" value="V" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="体积是一个物理量，用于度量物质或物体所占据的三维空间的大小。在国际单位制中，其主单位是立方米（m³）。它通常用符号V表示，是描述物质宏观性质的基本参数之一，并在理想气体状态方程等众多物理和化学定律中作为关键变量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-7e7c6ace2cc9c7181a60293d264541f2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Volume, V&quot;, &quot;volume&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7e7c6ace2cc9c7181a60293d264541f2-e-10&quot;, &quot;chunk-9b0d001712f3c9617fcf101c325d1706-e-3&quot;, &quot;chunk-a6a0b0d2c85b7b920c33d8bae94d9958-e-1&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-7e7c6ace2cc9c7181a60293d264541f2-e-11" label="T">
        <attvalues>
          <attvalue for="0" value="T" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="**T** 是一个物理学参数符号，代表热力学温度（Thermodynamic Temperature），用于在科学及工程公式中描述物质或系统的热状态。它是一个基本物理量，其国际单位制（SI）单位为开尔文（K）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-7e7c6ace2cc9c7181a60293d264541f2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7e7c6ace2cc9c7181a60293d264541f2-e-11&quot;, &quot;chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-12&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7e7c6ace2cc9c7181a60293d264541f2-e-12" label="R">
        <attvalues>
          <attvalue for="0" value="R" />
          <attvalue for="1" value="Physical Constant" />
          <attvalue for="2" value="气体常数（又称理想气体常数、普适气体常数，符号为R）是一个重要的物理常数。它在理想气体定律（PV=nRT）中作为比例系数，关联了气体的压强、体积、物质的量与温度等宏观物理量。其值是玻尔兹曼常数与阿伏伽德罗常数的乘积。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-7e7c6ace2cc9c7181a60293d264541f2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Gas Constant&quot;, &quot;gas constant&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7e7c6ace2cc9c7181a60293d264541f2-e-12&quot;, &quot;chunk-9b0d001712f3c9617fcf101c325d1706-e-5&quot;, &quot;chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-11&quot;, &quot;chunk-a974f22f27e1564b9b5db9cb4b218aa2-e-11&quot;, &quot;chunk-e3bc91d02528ce132349b28825081f88-e-12&quot;, &quot;chunk-e169602f8c36042ddef4827a52729f2a-e-1&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9b0d001712f3c9617fcf101c325d1706-e-1" label="Ideal Gas Law">
        <attvalues>
          <attvalue for="0" value="Ideal Gas Law" />
          <attvalue for="1" value="Equation of State" />
          <attvalue for="2" value="理想气体定律是描述假想理想气体状态的状态方程，其数学表达式为pV = nRT。该方程阐明了气体的压力(p)、体积(V)、物质的量(n)与绝对温度(T)这几个宏观参数间的定量关系，其中R为理想气体常数。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;pV = nRT&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-9b0d001712f3c9617fcf101c325d1706" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Ideal Gas Equation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7e7c6ace2cc9c7181a60293d264541f2-e-8&quot;, &quot;chunk-9b0d001712f3c9617fcf101c325d1706-e-1&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-9b0d001712f3c9617fcf101c325d1706-e-4" label="temperature">
        <attvalues>
          <attvalue for="0" value="temperature" />
          <attvalue for="1" value="Physical Condition" />
          <attvalue for="2" value="温度（Temperature）是表示物体冷热程度的物理量，宏观上是物体内能的外在表现，微观上是物质分子热运动平均动能的标志。它是决定物质状态和影响众多物理、化学及生物过程的关键参数。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;T&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-9b0d001712f3c9617fcf101c325d1706" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Temperature&quot;, &quot;Temperatures&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9b0d001712f3c9617fcf101c325d1706-e-4&quot;, &quot;chunk-b90feda161b295cfb50134cb85d41526-e-8&quot;, &quot;chunk-84d1269d81f3d4fb66cfdbb567801e32-e-2&quot;, &quot;chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc-e-4&quot;, &quot;chunk-3b4422ce09cd66eaf6abd58690d6f8ef-e-6&quot;, &quot;chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-19&quot;, &quot;chunk-466225ab73e7ea49ac0af36e5725c4c1-e-6&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-9b0d001712f3c9617fcf101c325d1706-e-6" label="number of moles">
        <attvalues>
          <attvalue for="0" value="number of moles" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="摩尔数（number of moles），符号为n，是用于衡量物质所含基本单元（如原子、分子）数量的物理量，单位为摩尔（mol）。它是国际单位制七个基本物理量之一“物质的量”的度量单位。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;n&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-9b0d001712f3c9617fcf101c325d1706" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9b0d001712f3c9617fcf101c325d1706-e-7" label="gas">
        <attvalues>
          <attvalue for="0" value="gas" />
          <attvalue for="1" value="Substance" />
          <attvalue for="2" value="一种作为热力学工质的气体。它与恒温热源保持热接触，进行无限缓慢的准静态膨胀。在此等温膨胀过程中，气体从热源吸收热量以对外做功（WAB），其内部状态被认为始终处于平衡态。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-9b0d001712f3c9617fcf101c325d1706" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-9b0d001712f3c9617fcf101c325d1706-e-9" label="infinitely slow expansion">
        <attvalues>
          <attvalue for="0" value="infinitely slow expansion" />
          <attvalue for="1" value="Thermodynamic Process" />
          <attvalue for="2" value="一种理想化的准静态热力学过程，指气体系统以无限缓慢的速率，从初始体积VA膨胀至最终体积VB。由于系统在每一瞬间都无限接近平衡态，故该过程为可逆过程。在此期间，气体对外做功WAB。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-9b0d001712f3c9617fcf101c325d1706" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-9b0d001712f3c9617fcf101c325d1706-e-10" label="VA">
        <attvalues>
          <attvalue for="0" value="VA" />
          <attvalue for="1" value="State Variable" />
          <attvalue for="2" value="VA是一个状态变量，指气体在“无限慢膨胀”这一热力学过程开始时的初始体积，是定义该过程起始状态的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-9b0d001712f3c9617fcf101c325d1706" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9b0d001712f3c9617fcf101c325d1706-e-11" label="VB">
        <attvalues>
          <attvalue for="0" value="VB" />
          <attvalue for="1" value="State Variable" />
          <attvalue for="2" value="在热力学中，VB是一个状态变量，指气体在经历一个无限缓慢的膨胀过程后所达到的最终体积。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-9b0d001712f3c9617fcf101c325d1706" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9b0d001712f3c9617fcf101c325d1706-e-12" label="WAB">
        <attvalues>
          <attvalue for="0" value="WAB" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="一个热力学物理量，指理想气体在等温过程中，从状态A变化到状态B时对外所做的功。根据热力学第一定律，由于理想气体内能不变，该过程气体对外做的功（WAB）在数值上等于其从外界吸收的热量（QAB）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-9b0d001712f3c9617fcf101c325d1706" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9b0d001712f3c9617fcf101c325d1706-e-12&quot;, &quot;chunk-8b3b1764bb264c55b0e58ee44dab55cb-e-1&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8b3b1764bb264c55b0e58ee44dab55cb-e-3" label="Adiabatic Expansion">
        <attvalues>
          <attvalue for="0" value="Adiabatic Expansion" />
          <attvalue for="1" value="Thermodynamic Process" />
          <attvalue for="2" value="绝热膨胀是一种热力学过程。在此过程中，系统（如气体）在与外界无热量交换的条件下对外做功并膨胀。由于功的输出是以消耗系统内能为代价的，该过程会导致系统温度降低，且遵循关系式 pV^γ = 常数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-8b3b1764bb264c55b0e58ee44dab55cb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8b3b1764bb264c55b0e58ee44dab55cb-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-8b3b1764bb264c55b0e58ee44dab55cb-e-4" label="Gas">
        <attvalues>
          <attvalue for="0" value="Gas" />
          <attvalue for="1" value="Substance" />
          <attvalue for="2" value="一种物质的基本状态。其粒子可自由运动，没有固定的形状和体积，可充满整个容器。在热力学中，它是一种重要的工质，其宏观状态由压力、体积和温度描述，并在绝热膨胀等过程中发生变化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-8b3b1764bb264c55b0e58ee44dab55cb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8b3b1764bb264c55b0e58ee44dab55cb-e-5" label="State B">
        <attvalues>
          <attvalue for="0" value="State B" />
          <attvalue for="1" value="Thermodynamic State" />
          <attvalue for="2" value="State B 是一个热力学状态，特指一个系统在进行绝热膨胀过程之前的初始条件。该状态由系统在过程开始时的一组宏观物理性质（如压力、体积、温度）所唯一确定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-8b3b1764bb264c55b0e58ee44dab55cb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8b3b1764bb264c55b0e58ee44dab55cb-e-6" label="State C">
        <attvalues>
          <attvalue for="0" value="State C" />
          <attvalue for="1" value="Thermodynamic State" />
          <attvalue for="2" value="一个热力学状态，特指气体在等温压缩过程开始时的初始状态。该状态由此刻气体的压力、体积、温度等一组宏观物理量所确定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-8b3b1764bb264c55b0e58ee44dab55cb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8b3b1764bb264c55b0e58ee44dab55cb-e-6&quot;, &quot;chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-9&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8b3b1764bb264c55b0e58ee44dab55cb-e-7" label="pBVB^γ = pCVC^γ">
        <attvalues>
          <attvalue for="0" value="pBVB^γ = pCVC^γ" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="该方程为理想气体的绝热过程状态方程。它定义了气体在经历一个从状态B到状态C的可逆绝热过程时，其压力(p)与体积(V)所遵循的关系。γ是该气体的绝热指数（热容比），此关系表明pV^γ为一常量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-8b3b1764bb264c55b0e58ee44dab55cb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8b3b1764bb264c55b0e58ee44dab55cb-e-7&quot;, &quot;chunk-40c0e393b62f65182f74ede2f3638558-e-2&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8b3b1764bb264c55b0e58ee44dab55cb-e-8" label="γ">
        <attvalues>
          <attvalue for="0" value="γ" />
          <attvalue for="1" value="Physical Constant" />
          <attvalue for="2" value="γ，即绝热指数或比热比，是热力学中的一个无量纲物理常数。它定义为理想气体的定压比热容(Cp)与定容比热容(Cv)的比值。作为描述气体绝热过程（如 pV^γ = 常数）的核心参数，其数值取决于气体分子的自由度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-8b3b1764bb264c55b0e58ee44dab55cb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Specific Heat Ratio (y)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8b3b1764bb264c55b0e58ee44dab55cb-e-8&quot;, &quot;chunk-40c0e393b62f65182f74ede2f3638558-e-3&quot;, &quot;chunk-c25d44ad87f3dc200703221956ca5dd1-e-5&quot;, &quot;chunk-38bfa031d75570a78eacff17ed6bac4a-e-10&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-40c0e393b62f65182f74ede2f3638558-e-1" label="Adiabat BC">
        <attvalues>
          <attvalue for="0" value="Adiabat BC" />
          <attvalue for="1" value="Thermodynamic Process" />
          <attvalue for="2" value="一个作用于气体的热力学绝热过程，使其从状态B过渡到状态C。过程中系统与外界无热量交换，其状态变化遵循关系式 pV^γ = 常数，并通过体积变化产生功WBC。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-40c0e393b62f65182f74ede2f3638558" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-40c0e393b62f65182f74ede2f3638558-e-4" label="Gas">
        <attvalues>
          <attvalue for="0" value="Gas" />
          <attvalue for="1" value="Thermodynamic System" />
          <attvalue for="2" value="作为热力学系统的工作物质，特指在绝热过程BC中，与外界无热量交换的气体。该气体的状态变化遵循绝热线（Adiabat BC），其热力学特性由比热容比（γ）所描述。" />
          <attvalue for="3" value="{&quot;state&quot;: &quot;isolated&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-40c0e393b62f65182f74ede2f3638558" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-40c0e393b62f65182f74ede2f3638558-e-5" label="QBC">
        <attvalues>
          <attvalue for="0" value="QBC" />
          <attvalue for="1" value="Thermodynamic Quantity" />
          <attvalue for="2" value="在热力学中，QBC是一个物理量符号，表示气体系统在经历从状态B到状态C的热力学过程时，所吸收或放出的热量。它是一个过程量，其数值与过程的具体路径有关。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;0&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-40c0e393b62f65182f74ede2f3638558" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-40c0e393b62f65182f74ede2f3638558-e-6" label="WBC">
        <attvalues>
          <attvalue for="0" value="WBC" />
          <attvalue for="1" value="Thermodynamic Quantity" />
          <attvalue for="2" value="一个热力学量，指气体在绝热过程BC中对外所做的功。其数值由初末状态决定，可根据理想气体绝热功公式 W = nR(T₁ - T₂)/(γ-1) 计算，其中T₁、T₂分别为过程的初末温度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-40c0e393b62f65182f74ede2f3638558" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Work (WBC)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-40c0e393b62f65182f74ede2f3638558-e-6&quot;, &quot;chunk-2f21206d7404a291608cd3acb39afcf6-e-6&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-40c0e393b62f65182f74ede2f3638558-e-7" label="nR(T₁ - T₂)/(γ-1)">
        <attvalues>
          <attvalue for="0" value="nR(T₁ - T₂)/(γ-1)" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="该公式用于计算理想气体在可逆绝热过程中所做的功（WBC）。其数值取决于气体的初始温度T₁、末态温度T₂、摩尔数n以及作为常数的热容比γ（也称绝热指数）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-40c0e393b62f65182f74ede2f3638558" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-1" label="Isothermal Compression">
        <attvalues>
          <attvalue for="0" value="Isothermal Compression" />
          <attvalue for="1" value="Thermodynamic Process" />
          <attvalue for="2" value="等温压缩是一种热力学过程。在此过程中，系统（如气体）的体积减小，而温度保持恒定。为维持恒温，系统必须与一个冷源接触，将外界对其做功所产生的热量排出，从而从一个初态转变为压力更高、体积更小的末态。" />
          <attvalue for="3" value="{&quot;start_volume&quot;: &quot;VC&quot;, &quot;end_volume&quot;: &quot;VD&quot;, &quot;temperature&quot;: &quot;T₂&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-66d0225c1c0d4eadbd8c6655548b3d21" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-2" label="Gas">
        <attvalues>
          <attvalue for="0" value="Gas" />
          <attvalue for="1" value="Working Substance" />
          <attvalue for="2" value="作为能量转换或传递媒介的工质。在等温压缩与绝热压缩等热力学过程中，它接受外界对其所做的功，从而改变其压力、体积等宏观状态参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-66d0225c1c0d4eadbd8c6655548b3d21" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-4" label="Work (WCD)">
        <attvalues>
          <attvalue for="0" value="Work (WCD)" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="标准化描述:&#10;指气体在从状态C到D的等温压缩过程中，外界对气体所做的功(WCD)。根据热力学定律，在此等温过程中，外界对系统做的功在数值上等于系统向外界释放的热量(QCD)。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;nRT₂ ln{VD/VC}&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-66d0225c1c0d4eadbd8c6655548b3d21" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-6" label="Adiabatic Compression">
        <attvalues>
          <attvalue for="0" value="Adiabatic Compression" />
          <attvalue for="1" value="Thermodynamic Process" />
          <attvalue for="2" value="绝热压缩是一种热力学过程，指系统在不与外界发生热量交换（Q=0）的条件下被压缩。在此过程中，外界对系统做功（W&gt;0），导致其内能、温度和压强升高。在特定的热力学循环中，它作为最后一步，使气体从状态D回到初始状态A。" />
          <attvalue for="3" value="{&quot;start_state&quot;: &quot;D&quot;, &quot;end_state&quot;: &quot;A&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-66d0225c1c0d4eadbd8c6655548b3d21" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-6&quot;, &quot;chunk-2f21206d7404a291608cd3acb39afcf6-e-1&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-7" label="State D">
        <attvalues>
          <attvalue for="0" value="State D" />
          <attvalue for="1" value="Thermodynamic State" />
          <attvalue for="2" value="状态D是一个热力学系统在进行绝热压缩过程前的初始状态。在这一特定过程中，系统在与外界无热量交换的情况下，其体积被压缩，通常导致其内部温度和压力升高。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;VD&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-66d0225c1c0d4eadbd8c6655548b3d21" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-7&quot;, &quot;chunk-2f21206d7404a291608cd3acb39afcf6-e-2&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-8" label="State A">
        <attvalues>
          <attvalue for="0" value="State A" />
          <attvalue for="1" value="Thermodynamic State" />
          <attvalue for="2" value="State A 是一个热力学状态，特指气体在经历一次绝热压缩过程后所达到的最终平衡状态。该状态是绝热压缩过程的终点，其热力学性质（如压力、体积、温度）由过程的初始条件和性质决定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-66d0225c1c0d4eadbd8c6655548b3d21" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-8&quot;, &quot;chunk-2f21206d7404a291608cd3acb39afcf6-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2f21206d7404a291608cd3acb39afcf6-e-4" label="Work (WDA)">
        <attvalues>
          <attvalue for="0" value="Work (WDA)" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="物理量WDA，指热力学系统中气体从状态D到状态A经历绝热压缩过程时，外界对气体所做的功。该过程使系统内能增加，通常作为某个热力学循环总功(W)的组成部分。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;nR(T₂ - T₁)/(γ-1)&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-2f21206d7404a291608cd3acb39afcf6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2f21206d7404a291608cd3acb39afcf6-e-5" label="Heat (QDA)">
        <attvalues>
          <attvalue for="0" value="Heat (QDA)" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="一个物理量，指气体从状态D到状态A进行绝热压缩过程中的热量传递。根据绝热过程的定义，系统与外界没有热交换，因此该过程的热量传递（QDA）数值为零。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;0&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2f21206d7404a291608cd3acb39afcf6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2f21206d7404a291608cd3acb39afcf6-e-7" label="Total Work (W)">
        <attvalues>
          <attvalue for="0" value="Total Work (W)" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="总功(W)是在一个完整的热力学循环中，系统对外所做的净功。其数值等于循环过程中所有分过程功的代数和。根据热力学第一定律，对于一个循环，总功也等于系统从外界吸收的净热量。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;WAB + WBC + WCD + WDA&quot;, &quot;alternate_formula&quot;: &quot;QAB + QCD&quot;, &quot;alternate_formula_2&quot;: &quot;nRT₁ ln{VB/VA} - nRT₂ ln{VC/VD}&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-2f21206d7404a291608cd3acb39afcf6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c7e7be1b79841f37e4aee97dd32c3432-e-6" label="Equation 1.6">
        <attvalues>
          <attvalue for="0" value="Equation 1.6" />
          <attvalue for="1" value="Formula" />
          <attvalue for="2" value="定义热力学效率(η)的公式，它基于等温过程和绝热过程的关系推导得出。该效率由两个热源的温度T₁和T₂决定，是分析理想热机循环（如卡诺循环）性能的基本方程。" />
          <attvalue for="3" value="{&quot;expression&quot;: &quot;η = W/QAB = 1 - T₂ ln{Vc/VD} / T₁ ln{VB/VA} = 1 - T₂/T₁&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c7e7be1b79841f37e4aee97dd32c3432" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-c7e7be1b79841f37e4aee97dd32c3432-e-7" label="Isothermal Process Relationship">
        <attvalues>
          <attvalue for="0" value="Isothermal Process Relationship" />
          <attvalue for="1" value="Formula" />
          <attvalue for="2" value="等温过程关系式(pAVA = pBVB)是一个热力学公式，它描述了理想气体在温度恒定的情况下，其压力(p)与体积(V)的乘积为一常数的规律（玻意耳定律）。该关系式是推导热力学系统（如热机）效率公式的基础。" />
          <attvalue for="3" value="{&quot;expression&quot;: &quot;pAVA = pBVB&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c7e7be1b79841f37e4aee97dd32c3432" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c7e7be1b79841f37e4aee97dd32c3432-e-7&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c7e7be1b79841f37e4aee97dd32c3432-e-8" label="Adiabatic Process Relationship">
        <attvalues>
          <attvalue for="0" value="Adiabatic Process Relationship" />
          <attvalue for="1" value="Formula" />
          <attvalue for="2" value="绝热过程关系式指理想气体在无热量交换的绝热过程中，压力(p)与体积(V)所遵循的数学关系，其标准形式为 pV^γ = 常数，其中γ为绝热指数。该公式是分析和推导热力学循环（如卡诺循环）效率的基础。" />
          <attvalue for="3" value="{&quot;expression&quot;: &quot;pBVB^γ = pCVC^γ&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-c7e7be1b79841f37e4aee97dd32c3432" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c7e7be1b79841f37e4aee97dd32c3432-e-8&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c7e7be1b79841f37e4aee97dd32c3432-e-9" label="∫ p dV">
        <attvalues>
          <attvalue for="0" value="∫ p dV" />
          <attvalue for="1" value="Mathematical Expression" />
          <attvalue for="2" value="在热力学中，该定积分表达式用于定义压力-体积功（PV功）。它计算一个系统在体积（V）从初始状态到最终状态发生变化时，由其压力（p）对环境所做的功，是过程函数。" />
          <attvalue for="3" value="{&quot;expression&quot;: &quot;∫ p dV&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-c7e7be1b79841f37e4aee97dd32c3432" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7e4651521e38ecb1e7b820e4fae7814d-e-3" label="Work extracted from the cycle">
        <attvalues>
          <attvalue for="0" value="Work extracted from the cycle" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="指热力学循环中系统对外输出的净功，是一个衡量循环效率的关键性能指标。在特定条件下，当热源温度T₁或冷源温度T₂升高时，该循环所提取的功会相应增加。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-7e4651521e38ecb1e7b820e4fae7814d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7e4651521e38ecb1e7b820e4fae7814d-e-4" label="Efficiency">
        <attvalues>
          <attvalue for="0" value="Efficiency" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="效率是衡量热力学循环性能的关键指标。它的大小取决于T₁和T₂两个变量，通过优化这两个变量可以提高循环效率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-7e4651521e38ecb1e7b820e4fae7814d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7e4651521e38ecb1e7b820e4fae7814d-e-5" label="Turbomachinery">
        <attvalues>
          <attvalue for="0" value="Turbomachinery" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="**涡轮机械 (Turbomachinery):** 一种通过旋转部件与流体交换能量的核心组件。它的性能和寿命受材料耐受高温和高应力能力的限制，这直接决定了整个系统所能达到的最高工作温度（T₁）等性能上限。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-7e4651521e38ecb1e7b820e4fae7814d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-7e4651521e38ecb1e7b820e4fae7814d-e-6" label="High-temperatures">
        <attvalues>
          <attvalue for="0" value="High-temperatures" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="高温 (High-temperatures) 是指涡轮机械必须承受的严苛热工况。这种条件对材料性能构成挑战，从而成为限制整个热力循环参数（如效率和功率输出）的关键设计约束。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-7e4651521e38ecb1e7b820e4fae7814d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7e4651521e38ecb1e7b820e4fae7814d-e-7" label="Stresses">
        <attvalues>
          <attvalue for="0" value="Stresses" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="指涡轮机械部件必须承受的内部机械应力。作为一项关键的设计约束条件，它限制了机器本身及其所在热力学循环的运行参数，是决定涡轮机械性能和寿命的重要因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-7e4651521e38ecb1e7b820e4fae7814d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7e4651521e38ecb1e7b820e4fae7814d-e-8" label="Carnot cycle">
        <attvalues>
          <attvalue for="0" value="Carnot cycle" />
          <attvalue for="1" value="Thermodynamic Cycle" />
          <attvalue for="2" value="卡诺循环是一种理想的可逆热力学循环，由两个等温过程和两个绝热过程组成。它为所有工作于两个给定温度热源间的热机提供了理论上的最大效率，是衡量实际热机性能的理想基准，而非特定发动机的直接近似模型。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-7e4651521e38ecb1e7b820e4fae7814d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Carnot Cycle&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7e4651521e38ecb1e7b820e4fae7814d-e-8&quot;, &quot;chunk-b455c334b535d063bfe8817108154093-e-1&quot;, &quot;chunk-f0112f08a3353476a4be1ec83e308c35-e-3&quot;, &quot;chunk-2f922c93a3f1955e166d2270226ee05e-e-9&quot;, &quot;chunk-569a3d8aec20d9df6a256b4cf4b263a7-e-6&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-7e4651521e38ecb1e7b820e4fae7814d-e-9" label="Temperature-entropy plot">
        <attvalues>
          <attvalue for="0" value="Temperature-entropy plot" />
          <attvalue for="1" value="Diagram" />
          <attvalue for="2" value="温熵图（T-s diagram）是一种热力学图表，以温度（T）为纵轴，比熵（s）为横轴，用于可视化工作流体的状态变化。因其过程曲线下的面积可直观表示热量传递，该图被广泛用于分析和计算热力学循环的性能和效率，例如涡轮喷气发动机所遵循的布雷顿循环。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-7e4651521e38ecb1e7b820e4fae7814d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Temperature-Entropy Plot&quot;, &quot;temperature-entropy diagrams&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7e4651521e38ecb1e7b820e4fae7814d-e-9&quot;, &quot;chunk-f0112f08a3353476a4be1ec83e308c35-e-5&quot;, &quot;chunk-3b4422ce09cd66eaf6abd58690d6f8ef-e-16&quot;, &quot;chunk-502aba15d381acd1fe322927c6f750ed-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-b455c334b535d063bfe8817108154093-e-5" label="Fuel-to-air ratio">
        <attvalues>
          <attvalue for="0" value="Fuel-to-air ratio" />
          <attvalue for="1" value="Performance Parameter" />
          <attvalue for="2" value="燃空比是燃气涡轮发动机的一项关键性能参数，定义为进入燃烧室的燃料与空气的质量比。该比值直接影响燃烧温度、效率和功率输出，是表征和控制发动机在不同工况下运行状态的重要依据。" />
          <attvalue for="3" value="{&quot;maximum power&quot;: &quot;0.02-0.03&quot;, &quot;cruise conditions&quot;: &quot;0.01&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-b455c334b535d063bfe8817108154093" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b455c334b535d063bfe8817108154093-e-7" label="Pressure-volume cycle">
        <attvalues>
          <attvalue for="0" value="Pressure-volume cycle" />
          <attvalue for="1" value="Thermodynamic Diagram" />
          <attvalue for="2" value="压力-容积循环（P-V图）是一种热力学图，用于描述工作物质在经历一个完整热力学循环时，其压力与体积的变化关系。图上闭合曲线所包围的面积在数值上等于该循环所做的净功，是分析涡轮喷气发动机等热机性能的重要工具。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-b455c334b535d063bfe8817108154093" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f0112f08a3353476a4be1ec83e308c35-e-2" label="Brayton Cycle">
        <attvalues>
          <attvalue for="0" value="Brayton Cycle" />
          <attvalue for="1" value="Thermodynamic Cycle" />
          <attvalue for="2" value="**布雷顿循环 (Brayton Cycle)**：一种理想热力学循环，是简单涡轮喷气发动机等燃气轮机的工作基础。它由等熵压缩、等压加热、等熵膨胀和等压放热四个过程组成，其状态变化常在压力-容积(P-V)图上表示。" />
          <attvalue for="3" value="{&quot;pressure_increase&quot;: &quot;40-fold&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-f0112f08a3353476a4be1ec83e308c35" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Pressure-Volume Cycle&quot;, &quot;working cycle&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f0112f08a3353476a4be1ec83e308c35-e-2&quot;, &quot;chunk-0ba22e2612dbc225416101c15d4cb857-e-19&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-f0112f08a3353476a4be1ec83e308c35-e-4" label="Figure 1.11(a)">
        <attvalues>
          <attvalue for="0" value="Figure 1.11(a)" />
          <attvalue for="1" value="Figure" />
          <attvalue for="2" value="图1.11(a)是一张展示简单涡轮喷气发动机的压容循环（Pressure-Volume Cycle）的示意图。该图表通过绘制发动机在完整工作循环中，工质压力随体积变化的对应关系，来直观地描述其理想热力学过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f0112f08a3353476a4be1ec83e308c35" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f0112f08a3353476a4be1ec83e308c35-e-6" label="Figure 1.11(b)">
        <attvalues>
          <attvalue for="0" value="Figure 1.11(b)" />
          <attvalue for="1" value="Figure" />
          <attvalue for="2" value="图1.11(b)是一幅描绘温熵图（T-s图）的插图。该图表是热力学分析中的重要工具，以温度（T）为纵轴、熵（s）为横轴，用于直观地展示和分析热力系统经历的热力过程与循环。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-f0112f08a3353476a4be1ec83e308c35" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f0112f08a3353476a4be1ec83e308c35-e-6&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1625b0a2cb4064b74a1462b9381bbb49-e-1" label="Work of compression">
        <attvalues>
          <attvalue for="0" value="Work of compression" />
          <attvalue for="1" value="Thermodynamic Process" />
          <attvalue for="2" value="在压缩机中发生的实际压缩热力学过程。它区别于理想的等熵过程，由于包含摩擦、热量损失等不可逆因素，过程中系统的熵会增加。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-1625b0a2cb4064b74a1462b9381bbb49" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1625b0a2cb4064b74a1462b9381bbb49-e-1&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-1625b0a2cb4064b74a1462b9381bbb49-e-2" label="Work of expansion">
        <attvalues>
          <attvalue for="0" value="Work of expansion" />
          <attvalue for="1" value="Thermodynamic Process" />
          <attvalue for="2" value="一种发生在压缩机中的非等熵热力学过程。与理想的等熵过程相对，该过程因存在摩擦、热量传递等不可逆因素，导致熵值发生变化。在实际压缩中，这通常指代一个效率并非100%的实际压缩过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-1625b0a2cb4064b74a1462b9381bbb49" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1625b0a2cb4064b74a1462b9381bbb49-e-2&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1625b0a2cb4064b74a1462b9381bbb49-e-3" label="Compressor">
        <attvalues>
          <attvalue for="0" value="Compressor" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="指在其内部进行压缩功与膨胀功的机械组件。其核心功能是通过改变工作流体的体积与压力，从而实现能量的转换或传递。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-1625b0a2cb4064b74a1462b9381bbb49" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1625b0a2cb4064b74a1462b9381bbb49-e-4" label="Isentropic Process">
        <attvalues>
          <attvalue for="0" value="Isentropic Process" />
          <attvalue for="1" value="Thermodynamic Concept" />
          <attvalue for="2" value="等熵过程是一种理想化的热力学过程，其熵保持恒定（ΔS=0）。它被定义为绝热且可逆的过程，常用作分析压缩机和涡轮机等装置的理想基准，以简化计算。在温熵（T-S）图上，该过程表现为一条垂直线。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1625b0a2cb4064b74a1462b9381bbb49" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1625b0a2cb4064b74a1462b9381bbb49-e-4&quot;, &quot;chunk-4093026dc043845c048897c7c1f6fe61-e-4&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-1625b0a2cb4064b74a1462b9381bbb49-e-5" label="Irreversibility">
        <attvalues>
          <attvalue for="0" value="Irreversibility" />
          <attvalue for="1" value="Thermodynamic Property" />
          <attvalue for="2" value="在热力学中，不可逆性(Irreversibility)是真实过程的一种属性，由压缩与膨胀等非等熵过程引起，导致系统熵增和有效能损失。它标志着实际循环与理想模型（如卡诺分析）的偏差，是衡量能量转换过程中因摩擦等因素造成的功损失的尺度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1625b0a2cb4064b74a1462b9381bbb49" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1625b0a2cb4064b74a1462b9381bbb49-e-6" label="Chemical energy">
        <attvalues>
          <attvalue for="0" value="Chemical energy" />
          <attvalue for="1" value="Energy" />
          <attvalue for="2" value="化学能是一种储存在物质分子内化学键中的势能。它通过化学反应（如燃烧）被释放，并转化为热能、光能等其他形式的能量。在内燃机中，燃料的化学能通过燃烧转化为热能，从而驱动发动机。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-1625b0a2cb4064b74a1462b9381bbb49" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Chemical Energy&quot;, &quot;chemical energy&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1625b0a2cb4064b74a1462b9381bbb49-e-6&quot;, &quot;chunk-557dabfd98e07916fb11233921ddc06d-e-13&quot;, &quot;chunk-d0bef0969eda4d511c2167bafe9aeae0-e-1&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-1625b0a2cb4064b74a1462b9381bbb49-e-7" label="Combustion chamber">
        <attvalues>
          <attvalue for="0" value="Combustion chamber" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="燃烧室是一种使燃料与氧化剂（如空气）混合并进行持续燃烧的密闭组件。它将燃料储存的化学能高效转化为高温高压气体的热能，用以产生推力或驱动涡轮等机械做功。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-1625b0a2cb4064b74a1462b9381bbb49" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1625b0a2cb4064b74a1462b9381bbb49-e-8" label="Temperature increase">
        <attvalues>
          <attvalue for="0" value="Temperature increase" />
          <attvalue for="1" value="Physical Effect" />
          <attvalue for="2" value="一种物理效应，指由化学能释放或转化引起的系统温度显著上升。该过程通常是不可逆的，因此不被理想化的卡诺分析等热力学模型所考虑。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;about 800 K&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-1625b0a2cb4064b74a1462b9381bbb49" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1625b0a2cb4064b74a1462b9381bbb49-e-9" label="Carnot analysis">
        <attvalues>
          <attvalue for="0" value="Carnot analysis" />
          <attvalue for="1" value="Analytical Model" />
          <attvalue for="2" value="卡诺分析是一种热力学分析方法，基于理想可逆的卡诺循环，用于计算热机或制冷系统在两个定温热源之间运行时的最大理论效率（或性能系数）。它为实际系统的性能设定了一个不可超越的上限基准，但其分析过程忽略了摩擦、热损失等所有现实世界中的不可逆因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-1625b0a2cb4064b74a1462b9381bbb49" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1625b0a2cb4064b74a1462b9381bbb49-e-9&quot;, &quot;chunk-4093026dc043845c048897c7c1f6fe61-e-1&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-4093026dc043845c048897c7c1f6fe61-e-2" label="Compressor stages">
        <attvalues>
          <attvalue for="0" value="Compressor stages" />
          <attvalue for="1" value="System Component" />
          <attvalue for="2" value="压气机级是多级压缩机的基本增压单元，通常由转子和静子构成。在理想热力学分析中，为简化性能计算，其气体压缩过程被假设为一种没有热量交换和内部摩擦损失的理想等熵过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-4093026dc043845c048897c7c1f6fe61" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4093026dc043845c048897c7c1f6fe61-e-5" label="Lines 1–3">
        <attvalues>
          <attvalue for="0" value="Lines 1–3" />
          <attvalue for="1" value="Diagram Feature" />
          <attvalue for="2" value="图1.11(b)中描绘的三条特征线。它们用于表示等熵过程，在此假设下，这三条线在图中呈现为垂直形态，以反映该过程的特定热力学性质。" />
