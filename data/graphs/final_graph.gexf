      </node>
      <node id="chunk-8a8245180b98739270d9b9b4befedd30-e-13" label="Nickel-aluminide coatings">
        <attvalues>
          <attvalue for="0" value="Nickel-aluminide coatings" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍铝涂层是一种主要由镍铝金属间化合物（如NiAl）构成的高温防护涂层，广泛用于燃气轮机叶片等部件。在高温热循环过程中，其表面会发生一种被称为“褶皱机制”的特殊塑性变形与退化现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-8a8245180b98739270d9b9b4befedd30" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a8245180b98739270d9b9b4befedd30-e-15" label="Tolpygo and Clarke Publication">
        <attvalues>
          <attvalue for="0" value="Tolpygo and Clarke Publication" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由V. K. Tolpygo和D. R. Clarke合著的一篇科学论文，题为《关于镍铝涂层中的褶皱机制，第一部分...》。该出版物通过实验方法，深入研究了镍铝涂层表面发生的褶皱现象及其内在的形成机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-8a8245180b98739270d9b9b4befedd30" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8a8245180b98739270d9b9b4befedd30-e-15&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c15f4840811d8961d78c6bb255597276-e-1" label="K. Tolpygo">
        <attvalues>
          <attvalue for="0" value="K. Tolpygo" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="K. Tolpygo是一位研究人员，其学术贡献主要集中在材料科学领域。他/她以撰写关于镍铝涂层（nickel-aluminide coatings）起皱机理（rumpling mechanism）的系列论文而闻名，内容涵盖了实验评估、表面波纹表征及粘结层溶胀等方面的研究。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-c15f4840811d8961d78c6bb255597276" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c15f4840811d8961d78c6bb255597276-e-1&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c15f4840811d8961d78c6bb255597276-e-3" label="On the rumpling mechanism in nickel-aluminide coatings, part I: An experimental assessment">
        <attvalues>
          <attvalue for="0" value="On the rumpling mechanism in nickel-aluminide coatings, part I: An experimental assessment" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由K. Tolpygo与D. R. Clarke合著的科学论文，发表于期刊《Acta Materialia》。该文是关于镍铝涂层起皱机理的两部分系列研究的第一部分，侧重于通过实验方法进行评估。其续篇为《On the rumpling mechanism in nickel-aluminide coatings, part II》。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2004&quot;, &quot;pages&quot;: &quot;5115-5127&quot;, &quot;part&quot;: &quot;I&quot;}" />
          <attvalue for="4" value="e-3" />
