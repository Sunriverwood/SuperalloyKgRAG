        <attvalues>
          <attvalue for="11" value="HAS_MICROSTRUCTURE_CONTAINING" />
          <attvalue for="12" value="The microstructure of a turbine disc alloy is described as having a complex y' phase distribution." />
          <attvalue for="13" value="It follows that the y' phase distribution is, in practice, rather complex; see Figure 4.23, which is a schematic illustration of the microstructure of a turbine disc alloy [19]." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-b7bfd8f1e9243bc095953814aae07253" />
          <attvalue for="17" value="0.4" />
        </attvalues>
