        <attvalues>
          <attvalue for="0" value="d" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="变量`d`是一个输入参数，在用于计算另一实体`p4`的表达式中被使用。它的值直接影响`p4`的最终计算结果。" />
          <attvalue for="3" value="{}" />
