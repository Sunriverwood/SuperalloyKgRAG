        <attvalues>
          <attvalue for="11" value="INFLUENCED_BY" />
          <attvalue for="12" value="Buckling is more likely to occur with low in-plane stiffness (E||)." />
          <attvalue for="13" value="This occurs when h is small, b is large or for low in-plane stiffness, E||, i.e. on the bottom left-hand side of the failure map." />
