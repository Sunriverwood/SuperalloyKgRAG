      <node id="chunk-fb8636aebcb8b8d854ebe34fb885b102-e-12" label="J. R. Nicholls">
        <attvalues>
          <attvalue for="0" value="J. R. Nicholls" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="J. R. Nicholls 是一位学者或研究员，作为作者发表了科学文章《Advances in coating design for high performance gas turbines》，其研究领域为高性能燃气轮机的涂层设计。" />
