        <attvalues>
          <attvalue for="11" value="IS_A_COMPONENT_OF" />
          <attvalue for="12" value="The critical crack size (a_crit) is a variable in the integrated formula for No." />
          <attvalue for="13" value="No = 1 / (A(m/2 – 1)Y^m Δσ^m π^(m/2)) * [1 / a_NDI^(m/2-1) - 1 / a_crit^(m/2-1)]" />
          <attvalue for="14" value="r-10" />
