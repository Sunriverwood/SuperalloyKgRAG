      <node id="chunk-fc5aa264fb28225ff63c38a7e3698291-e-6" label="R. C. Tucker">
        <attvalues>
          <attvalue for="0" value="R. C. Tucker" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="R. C. Tucker是一名作者与研究员，专注于等离子喷涂涂层技术领域。他作为专业出版物《Plasma spray coating processes》的合著者而知名。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
