        <attvalues>
          <attvalue for="11" value="REQUIRES_SMALL_DEFECTS_FOR" />
          <attvalue for="12" value="To achieve an adequate life of 10000 cycles, higher-strength alloys must have a very small initial defect size." />
          <attvalue for="13" value="The size of initial defect in the higher-strength alloys such that an adequate life of 10000 cycles is reached is very small indeed." />
          <attvalue for="14" value="r-2" />
