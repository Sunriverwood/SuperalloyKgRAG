        <attvalues>
          <attvalue for="11" value="DEFINES" />
          <attvalue for="12" value="Choosing a prescribed life (No) defines the flaw size (d)." />
          <attvalue for="13" value="Third, a prescribed life, No, is chosen; this defines d, and hence d/Di" />
