      <node id="chunk-cd90df188efe63a1aba2d62ab225c3ae-e-9" label="D. F. Mitchell">
        <attvalues>
          <attvalue for="0" value="D. F. Mitchell" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. F. Mitchell是一位研究人员，因合著阐述β-NiAl+Zr氧化机理的科学论文《Oxidation mechanisms of β-NiAl + Zr determined by SIMS》而知名。" />
          <attvalue for="3" value="{}" />
