        <attvalues>
          <attvalue for="11" value="USES_MEDIUM" />
          <attvalue for="12" value="Quenching is performed using a bath of oil." />
          <attvalue for="13" value="At the end of processing the forged discs are either quenched into a bath of oil or water, or else left to cool on the shop floor." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad" />
          <attvalue for="16" value="0.0003132613992342499" />
          <attvalue for="17" value="0.40018795683954056" />
        </attvalues>
      </edge>
      <edge source="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-2" target="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-4" id="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-r-3" weight="4.0">
        <attvalues>
          <attvalue for="11" value="USES_MEDIUM" />
          <attvalue for="12" value="Quenching can be performed using a bath of water." />
          <attvalue for="13" value="At the end of processing the forged discs are either quenched into a bath of oil or water, or else left to cool on the shop floor." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad" />
          <attvalue for="16" value="0.00010442046641141663" />
          <attvalue for="17" value="0.2667293189465135" />
        </attvalues>
      </edge>
      <edge source="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-2" target="chunk-0d8b8971d722c099aa85646d423e67e5-e-9" id="chunk-93160044ac8bb07b73d5b072ebae265b-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="FOLLOWS" />
          <attvalue for="12" value="The quenching operation is employed after the heat treatment process." />
          <attvalue for="13" value="A quenching operation, typically into oil, is employed following the heat treatment to ‘freeze in' the precipitation structure." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-93160044ac8bb07b73d5b072ebae265b" />
          <attvalue for="16" value="0.0053254437869822485" />
          <attvalue for="17" value="0.4031952662721894" />
        </attvalues>
      </edge>
      <edge source="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-2" target="chunk-93160044ac8bb07b73d5b072ebae265b-e-3" id="chunk-93160044ac8bb07b73d5b072ebae265b-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="MODIFIES" />
          <attvalue for="12" value="The quenching operation is used to 'freeze in' the precipitation structure." />
          <attvalue for="13" value="A quenching operation, typically into oil, is employed following the heat treatment to ‘freeze in' the precipitation structure." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-93160044ac8bb07b73d5b072ebae265b" />
          <attvalue for="16" value="0.00010442046641141663" />
