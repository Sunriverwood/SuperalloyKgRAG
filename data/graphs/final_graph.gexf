      <node id="chunk-d5ce586afcf8fd710ae4779854d26909-e-12" label="Gas turbine">
        <attvalues>
          <attvalue for="0" value="Gas turbine" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="燃气轮机是一种将燃料化学能转为机械功的旋转式动力机械。因其在高温高压下工作，对材料性能要求极高，但根据上下文，多种先进金属间化合物（如NiAl、TiAl）及特种合金尚未成功应用于此类设备。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-d5ce586afcf8fd710ae4779854d26909" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-19e6563f4b098e6973872824ea3f1dec-e-2" label="Gas turbine">
        <attvalues>
          <attvalue for="0" value="Gas turbine" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="燃气轮机是一种将燃料化学能转化为机械功的旋转式动力机械。它通过压缩空气与燃料在燃烧室中混合燃烧，产生高温高压燃气，驱动涡轮高速旋转做功。因其核心部件工作在极端高温下，它是高温材料的关键应用领域，广泛用于发电、航空发动机和工业驱动。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-19e6563f4b098e6973872824ea3f1dec" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-19e6563f4b098e6973872824ea3f1dec-e-3" label="Figure 1.16">
        <attvalues>
          <attvalue for="0" value="Figure 1.16" />
          <attvalue for="1" value="Data Visualization" />
          <attvalue for="2" value="图1.16是一个阐释拉森-米勒（Larson–Miller）线的工程数据图表。它通过绘制特定参数，直观地展示了材料在不同温度和应力下的蠕变性能关系，可用于推导或预测材料在高温环境下的持久寿命和性能数据点。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-19e6563f4b098e6973872824ea3f1dec" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-19e6563f4b098e6973872824ea3f1dec-e-3&quot;]}]" />
          <attvalue for="9" value="160" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-19e6563f4b098e6973872824ea3f1dec-e-4" label="Larson–Miller line">
        <attvalues>
          <attvalue for="0" value="Larson–Miller line" />
          <attvalue for="1" value="Technical Concept" />
          <attvalue for="2" value="在材料科学中，一种用于预测材料高温蠕变断裂寿命的图形化经验方法。它通过一个综合了温度和时间的参数（拉森-米勒参数）与应力建立关系，特定材料的数据在图上常呈现为一条近似直线，用于进行寿命外推和评估。" />
          <attvalue for="3" value="{&quot;linearity&quot;: &quot;approximately straight&quot;, &quot;non-linearity&quot;: &quot;tendency for some non-linearity, which results in the lines curving gently downwards&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-19e6563f4b098e6973872824ea3f1dec" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-19e6563f4b098e6973872824ea3f1dec-e-4&quot;]}]" />
          <attvalue for="9" value="160" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-19e6563f4b098e6973872824ea3f1dec-e-6" label="Other materials">
        <attvalues>
          <attvalue for="0" value="Other materials" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="一个泛指的材料类别，特指在与单晶高温合金进行性能对比时，用作参照基准的材料。其综合性能通常被单晶高温合金所超越。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-19e6563f4b098e6973872824ea3f1dec" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-19e6563f4b098e6973872824ea3f1dec-e-6&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ba75e6448ea6f9f49ca3935b800555ba-e-6" label="Creep resistance">
        <attvalues>
          <attvalue for="0" value="Creep resistance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**抗蠕变性 (Creep resistance)**&#10;一种材料属性，指材料在高温和恒定应力作用下抵抗缓慢永久变形（蠕变）的能力。它是衡量材料高温结构稳定性的关键指标，通过添加晶界强化元素等方法可有效提升，以确保部件在高温下长期服役的可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-ba75e6448ea6f9f49ca3935b800555ba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Creep Resistance&quot;, &quot;creep resistance&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ba75e6448ea6f9f49ca3935b800555ba-e-6&quot;, &quot;chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-8&quot;, &quot;chunk-cd1c24f9a838008fb8d63b627fa85467-e-2&quot;, &quot;chunk-4fd900e79f8eed0adbe03897dc24fda9-e-4&quot;, &quot;chunk-7fe022ba8cc7632d553ef231b0a1a4ea-e-12&quot;, &quot;chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f-e-3&quot;, &quot;chunk-b38b75a018fa569ff580b1d94d62395d-e-5&quot;, &quot;chunk-e7b8406b8d85a1255a692ddd5452a482-e-3&quot;, &quot;chunk-471c3b3783689510c8ddf1dbb87d4b46-e-6&quot;, &quot;chunk-1d0418c28a59c280072dbd96eeaaa524-e-6&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-d13800606f8047850e1ad6f9b8f895ce-e-1" label="Niobium-based alloy system">
        <attvalues>
          <attvalue for="0" value="Niobium-based alloy system" />
          <attvalue for="1" value="Alloy System" />
          <attvalue for="2" value="以金属铌为基体，添加一种或多种其他元素所构成的合金体系。该体系合金以高熔点、优异的高温强度、良好抗腐蚀性及超导特性为主要特征，是航空航天、核工业和超导技术等领域关键的结构与功能材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-d13800606f8047850e1ad6f9b8f895ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Niobium alloys&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d13800606f8047850e1ad6f9b8f895ce-e-1&quot;, &quot;chunk-d190e8215d72110cf452de429687e055-e-5&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d13800606f8047850e1ad6f9b8f895ce-e-2" label="Polycrystalline superalloys">
        <attvalues>
          <attvalue for="0" value="Polycrystalline superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="多晶高温合金是一种高性能金属材料，其微观结构由大量取向各异的晶粒构成。这类合金通常以镍、钴或铁为基体，在高温环境下展现出卓越的机械强度、抗蠕变、抗氧化和抗腐蚀性能，是制造航空发动机涡轮盘等关键热端部件的核心材料。" />
          <attvalue for="3" value="{&quot;creep_performance&quot;: &quot;less good&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-d13800606f8047850e1ad6f9b8f895ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;polycrystalline superalloy&quot;, &quot;polycrystalline superalloys&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f5c07b55f3d29bb402b546962b69a445-e-12&quot;, &quot;chunk-d13800606f8047850e1ad6f9b8f895ce-e-2&quot;, &quot;chunk-2b6a04ecc641ed4c1cec1b3e414ec201-e-4&quot;, &quot;chunk-53753c2242e7dd6a1f075c9d1be8ff40-e-9&quot;, &quot;chunk-d4529d405393ac6d501a33e3c215f2a0-e-1&quot;, &quot;chunk-d9d581e86b96c92ccf2b9c353b4e4e11-e-10&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-d13800606f8047850e1ad6f9b8f895ce-e-4" label="Many other alloy systems">
        <attvalues>
          <attvalue for="0" value="Many other alloy systems" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="一类合金材料的总称，其综合性能被多晶高温合金所超越。该术语通常用于材料性能比较中，作为一个参照基准，以凸显多晶高温合金在特定应用场景下的优越性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d13800606f8047850e1ad6f9b8f895ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d13800606f8047850e1ad6f9b8f895ce-e-4&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d13800606f8047850e1ad6f9b8f895ce-e-5" label="Intermetallic compounds">
        <attvalues>
          <attvalue for="0" value="Intermetallic compounds" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="金属间化合物是由两种或多种金属元素按一定原子比例形成的、具有有序晶体结构的化合物。它们通常具有高熔点、高硬度和优异的高温强度及抗氧化性，不同于其组分金属，常被用作制造工业燃气轮机叶片等耐高温结构材料。" />
          <attvalue for="3" value="{&quot;density-corrected_performance&quot;: &quot;not bad&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d13800606f8047850e1ad6f9b8f895ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;intermetallic compounds&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d13800606f8047850e1ad6f9b8f895ce-e-5&quot;, &quot;chunk-1297af8788c2be7a2a158412cd2652f3-e-13&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-becba5847060251232d4df2b31913a6b-e-3" label="compressor sections of many aeroengines">
        <attvalues>
          <attvalue for="0" value="compressor sections of many aeroengines" />
          <attvalue for="1" value="component" />
          <attvalue for="2" value="航空发动机的核心增压部件，由多级旋转叶片组成，负责提高进入燃烧室的空气压力。为适应沿程逐渐升高的温度和压力，其前端低温级部件通常由钛合金制成，而后端高温级部件则采用耐热性能更优的超合金制造。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-becba5847060251232d4df2b31913a6b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d190e8215d72110cf452de429687e055-e-3" label="W-based materials">
        <attvalues>
          <attvalue for="0" value="W-based materials" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="钨基材料(W-based materials)是以金属钨为基体的合金或复合材料。因其优异的高温强度等性能，被视为有潜力的航空发动机替代材料。然而，其极高的密度是限制其实际应用的主要障碍。" />
          <attvalue for="3" value="{&quot;density&quot;: &quot;significant&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d190e8215d72110cf452de429687e055" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d190e8215d72110cf452de429687e055-e-4" label="Mo-based materials">
        <attvalues>
          <attvalue for="0" value="Mo-based materials" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="以钼为基的合金材料。因具有优异的高温强度，被视为有潜力的航空发动机替代材料，但其密度高是限制其应用的主要挑战。" />
          <attvalue for="3" value="{&quot;density&quot;: &quot;significant&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d190e8215d72110cf452de429687e055" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bccef826d0431af78a9477b3c9f26b2b-e-2" label="Alloy development">
        <attvalues>
          <attvalue for="0" value="Alloy development" />
          <attvalue for="1" value="Development Process" />
          <attvalue for="2" value="作为材料科学与工程的分支，合金开发是一门专注于设计、制备与优化新型金属材料的学科。它旨在通过调控合金的化学成分、加工工艺与微观结构，以获得具有特定物理、化学或机械性能的材料，满足不同应用需求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-bccef826d0431af78a9477b3c9f26b2b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;alloy development&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bccef826d0431af78a9477b3c9f26b2b-e-2&quot;, &quot;chunk-d97ee852ec4cf802eba7492551d5fcae-e-6&quot;, &quot;chunk-070dbf53e1878b9845a3e7782a58ad66-e-5&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-bccef826d0431af78a9477b3c9f26b2b-e-3" label="process development">
        <attvalues>
          <attvalue for="0" value="process development" />
          <attvalue for="1" value="Development Process" />
          <attvalue for="2" value="一项旨在系统性优化材料制造、加工与处理方法的开发活动。在高温合金领域，它与合金开发相辅相成，共同致力于提升材料的最终性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-bccef826d0431af78a9477b3c9f26b2b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bccef826d0431af78a9477b3c9f26b2b-e-4" label="1940s">
        <attvalues>
          <attvalue for="0" value="1940s" />
          <attvalue for="1" value="Time Period" />
          <attvalue for="2" value="1940年代指1940年至1949年。该时期被第二次世界大战及其后续影响所主导，开启了核时代与冷战。在技术领域，首批高温合金在此期间出现，为喷气发动机等高科技发展奠定了关键材料基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-bccef826d0431af78a9477b3c9f26b2b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bccef826d0431af78a9477b3c9f26b2b-e-4&quot;, &quot;chunk-d04c85025e4505eb3f79316f3a28ed39-e-2&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d04c85025e4505eb3f79316f3a28ed39-e-5" label="137 MPa">
        <attvalues>
          <attvalue for="0" value="137 MPa" />
          <attvalue for="1" value="Stress Value" />
          <attvalue for="2" value="137兆帕（MPa）是一个压力值，特指在特定实验中，为评估材料的蠕变性能而施加的载荷压力。它是一个关键的实验条件，用于确定材料在该应力水平下的长期形变特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d04c85025e4505eb3f79316f3a28ed39" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d04c85025e4505eb3f79316f3a28ed39-e-5&quot;, &quot;chunk-06552db6ca6c8a18f5c48e13e0d28d19-e-10&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d04c85025e4505eb3f79316f3a28ed39-e-6" label="1000 h">
        <attvalues>
          <attvalue for="0" value="1000 h" />
          <attvalue for="1" value="Time Duration" />
          <attvalue for="2" value="1000小时是评定材料蠕变性能的一项关键时间基准，特指在恒定的高温和应力条件下，材料发生蠕变断裂所需的最短时间。它被用来定义材料的蠕变强度等性能指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-d04c85025e4505eb3f79316f3a28ed39" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d04c85025e4505eb3f79316f3a28ed39-e-6&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d04c85025e4505eb3f79316f3a28ed39-e-7" label="Cast materials">
        <attvalues>
          <attvalue for="0" value="Cast materials" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="铸造材料 (Cast materials) 是一类通过铸造工艺制成的材料。因其能提供卓越的蠕变性能，以抵抗高温高应力下的永久变形，故成为涡轮叶片等关键部件的首选材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d04c85025e4505eb3f79316f3a28ed39" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d04c85025e4505eb3f79316f3a28ed39-e-7&quot;, &quot;chunk-77649a0b4c8ee5abb5b0b41c519cbbeb-e-2&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-d04c85025e4505eb3f79316f3a28ed39-e-8" label="Wrought materials">
        <attvalues>
          <attvalue for="0" value="Wrought materials" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="锻造材料（Wrought materials）指通过锻造、轧制等塑性变形工艺成型的金属材料。该工艺可细化材料的内部晶粒结构，从而获得比铸造材料更优越的强度、韧性和抗疲劳性能。因其卓越的力学性能，在制造叶片等关键承力部件时通常是首选。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-d04c85025e4505eb3f79316f3a28ed39" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d04c85025e4505eb3f79316f3a28ed39-e-8&quot;, &quot;chunk-77649a0b4c8ee5abb5b0b41c519cbbeb-e-3&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-77649a0b4c8ee5abb5b0b41c519cbbeb-e-1" label="Blading application">
        <attvalues>
          <attvalue for="0" value="Blading application" />
          <attvalue for="1" value="Technical Application" />
          <attvalue for="2" value="指将材料用于制造叶片的特定技术领域，其特点是优先选用铸造材料替代锻造材料。通过应用镍基合金等先进材料与真空感应铸造等工艺，可显著提升叶片性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-77649a0b4c8ee5abb5b0b41c519cbbeb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-77649a0b4c8ee5abb5b0b41c519cbbeb-e-5" label="Aerofoils">
        <attvalues>
          <attvalue for="0" value="Aerofoils" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="翼型（Aerofoils）是一种用于叶片应用的部件，通过其特定剖面形状与流体作用以产生力。该部件最初以锻造工艺生产，由锻造材料制成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-77649a0b4c8ee5abb5b0b41c519cbbeb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-77649a0b4c8ee5abb5b0b41c519cbbeb-e-7" label="Vacuum induction casting technologies">
        <attvalues>
          <attvalue for="0" value="Vacuum induction casting technologies" />
          <attvalue for="1" value="Manufacturing Technology" />
          <attvalue for="2" value="一种20世纪50年代问世的先进制造技术。它在真空条件下，利用电磁感应原理加热熔化金属并进行浇注成型。该技术能防止材料氧化和污染，显著提升金属纯度与性能，常用于制造航空发动机涡轮叶片等精密高温部件。" />
          <attvalue for="3" value="{&quot;introduction_period&quot;: &quot;1950s&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-77649a0b4c8ee5abb5b0b41c519cbbeb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-77649a0b4c8ee5abb5b0b41c519cbbeb-e-7&quot;, &quot;chunk-1d4877c041c898c2ccde9f07a4b45ed8-e-1&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1d4877c041c898c2ccde9f07a4b45ed8-e-3" label="Improved casting methods">
        <attvalues>
          <attvalue for="0" value="Improved casting methods" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="一类先进铸造工艺的总称。与传统铸造相比，它们通过精确控制金属或合金的凝固过程（如定向凝固），来优化铸件的微观组织与力学性能，从而获得综合性能显著提升的高质量材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-1d4877c041c898c2ccde9f07a4b45ed8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1d4877c041c898c2ccde9f07a4b45ed8-e-4" label="Directional solidification">
        <attvalues>
          <attvalue for="0" value="Directional solidification" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="定向凝固是一种先进材料制造工艺。它通过精确控制热流方向和冷却速率，引导熔体自一端向另一端有序结晶，旨在获得具有择优取向的柱状晶或单晶结构。该工艺常使用籽晶法或晶粒选择器技术，是制造高性能合金部件（如航空发动机叶片）的关键工序。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1d4877c041c898c2ccde9f07a4b45ed8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Directional solidification/investment casting&quot;, &quot;directional solidification&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1d4877c041c898c2ccde9f07a4b45ed8-e-4&quot;, &quot;chunk-db41dbaa9105de2b903a433936c3b590-e-8&quot;, &quot;chunk-ec660a3c0fa5875c4c6a5a9b4f0933db-e-5&quot;, &quot;chunk-f1dbde91fa2668ef8c190d0d43e91e27-e-7&quot;, &quot;chunk-b6d430b58fe5b3336f2235e2e6daa465-e-13&quot;, &quot;chunk-a67bfee0cc0003cfb8efe7f82e7665c2-e-1&quot;, &quot;chunk-d9d581e86b96c92ccf2b9c353b4e4e11-e-4&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="18" />
        </attvalues>
      </node>
      <node id="chunk-1d4877c041c898c2ccde9f07a4b45ed8-e-5" label="Columnar microstructures">
        <attvalues>
          <attvalue for="0" value="Columnar microstructures" />
          <attvalue for="1" value="Material Structure" />
          <attvalue for="2" value="柱状微观结构是一种微观组织特征，其晶粒沿特定方向择优生长，形成相互平行的柱状阵列。这种结构常由电子束物理气相沉积(EB-PVD)等定向工艺形成，是导致材料(如YSZ涂层)产生模量各向异性的主要原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1d4877c041c898c2ccde9f07a4b45ed8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Columnar Microstructure&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1d4877c041c898c2ccde9f07a4b45ed8-e-5&quot;, &quot;chunk-e0eaec940932f96aaacae0dab5000c8c-e-7&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-1d4877c041c898c2ccde9f07a4b45ed8-e-6" label="Transverse grain boundaries">
        <attvalues>
          <attvalue for="0" value="Transverse grain boundaries" />
          <attvalue for="1" value="Material Feature" />
          <attvalue for="2" value="指在多晶材料中，取向大致垂直于主应力轴或晶粒生长方向的晶界。该类晶界通常是材料的薄弱环节，尤其在高温蠕变条件下易成为裂纹萌生和扩展的优先路径，因此在定向凝固合金等高性能材料中常被消除。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-1d4877c041c898c2ccde9f07a4b45ed8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1d4877c041c898c2ccde9f07a4b45ed8-e-6&quot;, &quot;chunk-9b774f1b41192a64910256e8cc94923b-e-1&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9b774f1b41192a64910256e8cc94923b-e-2" label="Grain boundaries">
        <attvalues>
          <attvalue for="0" value="Grain boundaries" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="晶界（Grain Boundaries）是α-Al₂O₃等多晶材料内部，不同晶体取向的晶粒之间所形成的接触界面。在特定材料体系中，它们是构成材料的微观结构特征，并作为稀土元素（REs）发生偏析和迁移的区域与通道。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-9b774f1b41192a64910256e8cc94923b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Grain Boundaries&quot;, &quot;grain boundaries&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9b774f1b41192a64910256e8cc94923b-e-2&quot;, &quot;chunk-0625d83d7200f989528119d9ba61865a-e-5&quot;, &quot;chunk-6007146f18f54e1531784eefc3822dae-e-4&quot;, &quot;chunk-bc10585f3ad1de63f724705efe275831-e-5&quot;, &quot;chunk-7638042a561888cfdce1fb2ee9ad0428-e-3&quot;, &quot;chunk-4e1df0fa0fa7afa66a5ee088dbcbc837-e-3&quot;, &quot;chunk-3f04709d6681598a00c3a9a4a76620aa-e-10&quot;, &quot;chunk-44a9440aa3e5fad0c388f77698c519bf-e-1&quot;, &quot;chunk-e4445ec100361e8a0d56ff46090155d6-e-2&quot;, &quot;chunk-0ba22e2612dbc225416101c15d4cb857-e-9&quot;, &quot;chunk-870742dec10263e0078e94a0b6a827aa-e-2&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="11" />
        </attvalues>
      </node>
      <node id="chunk-9b774f1b41192a64910256e8cc94923b-e-4" label="Grain-boundary strengthening elements">
        <attvalues>
          <attvalue for="0" value="Grain-boundary strengthening elements" />
          <attvalue for="1" value="Material Additive" />
          <attvalue for="2" value="晶界强化元素是一类用于增强多晶高温合金晶界强度的材料添加剂，典型代表为硼和碳。其作用是抑制晶界滑移和开裂。由于单晶高温合金没有晶界，因此无需添加此类元素，从而允许进行更优化的热处理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-9b774f1b41192a64910256e8cc94923b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Grain-boundary-strengthening elements&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9b774f1b41192a64910256e8cc94923b-e-4&quot;, &quot;chunk-8cc148c1ca974c554ee456036519b0b3-e-9&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-9b774f1b41192a64910256e8cc94923b-e-5" label="Boron">
        <attvalues>
          <attvalue for="0" value="Boron" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="硼（Boron）是一种化学元素，符号为B，原子序数为5。作为一种重要的非金属元素，它在冶金中是典型的晶界强化元素，能显著改善合金性能。此外，硼及其化合物还广泛应用于半导体、核工业、特种玻璃和陶瓷等领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-9b774f1b41192a64910256e8cc94923b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;B&quot;, &quot;Boron (B)&quot;, &quot;boron&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9b774f1b41192a64910256e8cc94923b-e-5&quot;, &quot;chunk-8cc148c1ca974c554ee456036519b0b3-e-11&quot;, &quot;chunk-4fd900e79f8eed0adbe03897dc24fda9-e-2&quot;, &quot;chunk-001e173127ba04e558ad53ba47c3764c-e-8&quot;, &quot;chunk-6007146f18f54e1531784eefc3822dae-e-1&quot;, &quot;chunk-804bbac328e38b8447144e9fc384514f-e-2&quot;, &quot;chunk-7f5d267485eb6b44a173a04ba9a301e4-e-4&quot;, &quot;chunk-61584d620a7ea3197cac715cb4ce2e82-e-5&quot;, &quot;chunk-a8e2ede64fab8f44656d400d86989bf1-e-2&quot;, &quot;chunk-11fd3f8dd428533f2dacdd280d5458c0-e-3&quot;, &quot;chunk-44a103d3439804fea5910e3206b26742-e-5&quot;, &quot;chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f-e-7&quot;, &quot;chunk-def444476734c5b41ca30b16989718fd-e-2&quot;, &quot;chunk-61a441c3ea495edfbd1f923ab25e12c9-e-15&quot;, &quot;chunk-2f922c93a3f1955e166d2270226ee05e-e-1&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-9b774f1b41192a64910256e8cc94923b-e-6" label="Carbon">
        <attvalues>
          <attvalue for="0" value="Carbon" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="碳（Carbon）是一种化学元素，符号为C，原子序数为6。它是一种常见的四价非金属，是所有已知生命的化学基础。碳能形成多种同素异形体（如金刚石和石墨），并能与其他元素结合成数百万种化合物，构成了有机化学的核心。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-9b774f1b41192a64910256e8cc94923b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;C&quot;, &quot;Carbon (C)&quot;, &quot;carbon&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9b774f1b41192a64910256e8cc94923b-e-6&quot;, &quot;chunk-8cc148c1ca974c554ee456036519b0b3-e-10&quot;, &quot;chunk-4fd900e79f8eed0adbe03897dc24fda9-e-3&quot;, &quot;chunk-001e173127ba04e558ad53ba47c3764c-e-9&quot;, &quot;chunk-6007146f18f54e1531784eefc3822dae-e-2&quot;, &quot;chunk-7f5d267485eb6b44a173a04ba9a301e4-e-5&quot;, &quot;chunk-61584d620a7ea3197cac715cb4ce2e82-e-6&quot;, &quot;chunk-11fd3f8dd428533f2dacdd280d5458c0-e-4&quot;, &quot;chunk-def444476734c5b41ca30b16989718fd-e-3&quot;, &quot;chunk-2f922c93a3f1955e166d2270226ee05e-e-8&quot;, &quot;chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676-e-16&quot;, &quot;chunk-5518f1c4ab4a7b4e100f841b3b90e572-e-3&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-9b774f1b41192a64910256e8cc94923b-e-8" label="Microsegregation">
        <attvalues>
          <attvalue for="0" value="Microsegregation" />
          <attvalue for="1" value="Material Phenomenon" />
          <attvalue for="2" value="微观偏析(Microsegregation)是一种在铸造等凝固过程中产生的材料缺陷，指合金元素或杂质在微观尺度（如枝晶间）的非均匀分布。这种成分不均的现象会影响材料性能，但通常可以通过后续的均匀化热处理来减轻或消除。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-9b774f1b41192a64910256e8cc94923b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Casting microsegregation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9b774f1b41192a64910256e8cc94923b-e-8&quot;, &quot;chunk-6e49788baa7d330741785c1ce4799ebc-e-2&quot;, &quot;chunk-d2428cb3e80954cab38bfce19b363f27-e-8&quot;, &quot;chunk-98dc45a2c81a5783151664ba74c4681e-e-7&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9b774f1b41192a64910256e8cc94923b-e-9" label="Eutectic content">
        <attvalues>
          <attvalue for="0" value="Eutectic content" />
          <attvalue for="1" value="Material Feature" />
          <attvalue for="2" value="共晶含量（Eutectic content）是指材料中由共晶反应形成的微观组织所占的比例。该特征通常在铸造过程中产生，其含量和形态可通过后续的热处理工艺进行调控或减少，以优化材料的最终性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-9b774f1b41192a64910256e8cc94923b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9b774f1b41192a64910256e8cc94923b-e-9&quot;, &quot;chunk-6e49788baa7d330741785c1ce4799ebc-e-3&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9b774f1b41192a64910256e8cc94923b-e-10" label="Casting">
        <attvalues>
          <attvalue for="0" value="Casting" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="铸造是一种将熔融金属等材料浇入铸模，经冷却凝固获得预定形状、尺寸和性能铸件的制造工艺。在凝固过程中，合金成分的再分配常会引发微观偏析（Microsegregation）和形成共晶组织（Eutectic content）等现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-9b774f1b41192a64910256e8cc94923b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Casting process&quot;, &quot;casting&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9b774f1b41192a64910256e8cc94923b-e-10&quot;, &quot;chunk-6e49788baa7d330741785c1ce4799ebc-e-4&quot;, &quot;chunk-023a8b25fea34ca6c8a3ebfc0f239288-e-7&quot;, &quot;chunk-2f922c93a3f1955e166d2270226ee05e-e-14&quot;, &quot;chunk-fbbf41abcd4950c59415caeec768db40-e-2&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-6e49788baa7d330741785c1ce4799ebc-e-5" label="Incipient melting">
        <attvalues>
          <attvalue for="0" value="Incipient melting" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="初熔（Incipient Melting）是一种物理现象，指多晶材料在低于其整体固相线温度时，在晶界等高能量区域开始发生的局部熔化。该现象通常由合金元素或杂质在晶界的偏析，导致局部熔点降低而引起，可能影响材料的高温性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-6e49788baa7d330741785c1ce4799ebc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;incipient melting&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6e49788baa7d330741785c1ce4799ebc-e-5&quot;, &quot;chunk-86425bad56c0d52ed7246eff0fe06dd8-e-10&quot;, &quot;chunk-502aba15d381acd1fe322927c6f750ed-e-2&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6e49788baa7d330741785c1ce4799ebc-e-6" label="Fatigue life">
        <attvalues>
          <attvalue for="0" value="Fatigue life" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="疲劳寿命是一种材料力学性能，指材料或构件在循环应力（通常低于其屈服强度）作用下，发生疲劳断裂前所能承受的载荷循环总次数。它是衡量材料抵抗疲劳失效能力的关键指标，可通过热处理等工艺进行改善。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-6e49788baa7d330741785c1ce4799ebc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6e49788baa7d330741785c1ce4799ebc-e-8" label="Gas turbine engine">
        <attvalues>
          <attvalue for="0" value="Gas turbine engine" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="燃气涡轮发动机是一种将燃料化学能转化为机械功的内燃动力机械。它通过驱动涡轮高速旋转产生动力，其工作在极端高温高压环境下的核心部件（如涡轮叶片），通常采用单晶高温合金等先进耐热材料制造。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-6e49788baa7d330741785c1ce4799ebc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6e49788baa7d330741785c1ce4799ebc-e-9" label="Creep properties">
        <attvalues>
          <attvalue for="0" value="Creep properties" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="蠕变性能指材料在高温和恒定应力作用下，抵抗随时间缓慢发生永久塑性变形的能力。它是评估材料（尤其是单晶高温合金）在航空发动机等高温、高应力环境下长期服役可靠性的核心指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-6e49788baa7d330741785c1ce4799ebc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6e49788baa7d330741785c1ce4799ebc-e-9&quot;, &quot;chunk-d60cc087d5f03ae6059fa8890a861a5b-e-4&quot;, &quot;chunk-e15d40b719932710977e7301c85e011b-e-5&quot;, &quot;chunk-1176c140725a24bab24c669fe05a7824-e-7&quot;, &quot;chunk-2954a9d8cd39d35e1c2ce761efb0de31-e-11&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-d60cc087d5f03ae6059fa8890a861a5b-e-1" label="Gas turbine engine">
        <attvalues>
          <attvalue for="0" value="Gas turbine engine" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="燃气涡轮发动机是一种利用连续流动的高温燃气产生动力的内燃机。由于其内部工作温度极高，涡轮叶片等关键热端部件必须采用单晶高温合金、柱状晶或等轴晶铸件等先进耐高温材料制造，以确保结构完整性和可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-d60cc087d5f03ae6059fa8890a861a5b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d60cc087d5f03ae6059fa8890a861a5b-e-3" label="Turbine engineers">
        <attvalues>
          <attvalue for="0" value="Turbine engineers" />
          <attvalue for="1" value="Role" />
          <attvalue for="2" value="一种专业工程师，负责燃气轮机的设计、制造与维护。其核心职责包括根据严苛的性能要求（如抗蠕变性），为涡轮关键部件选择和应用单晶高温合金等先进材料，以确保设备在极端工况下的性能与可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d60cc087d5f03ae6059fa8890a861a5b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;turbine designers&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d60cc087d5f03ae6059fa8890a861a5b-e-3&quot;, &quot;chunk-1a3aca6895e2c3ed98b3470c9aa4ae29-e-6&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d60cc087d5f03ae6059fa8890a861a5b-e-5" label="Columnar castings">
        <attvalues>
          <attvalue for="0" value="Columnar castings" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="柱状晶铸件是一种通过定向凝固工艺制成的金属构件，其特点是晶粒沿一个方向呈柱状排列。这种结构消除了横向晶界，显著提升了材料的高温蠕变强度和抗热疲劳性能，主要用于制造燃气涡轮发动机的涡轮叶片等关键热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d60cc087d5f03ae6059fa8890a861a5b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d60cc087d5f03ae6059fa8890a861a5b-e-5&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d60cc087d5f03ae6059fa8890a861a5b-e-6" label="Equiaxed castings">
        <attvalues>
          <attvalue for="0" value="Equiaxed castings" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="一种通过铸造工艺形成的金属材料晶体结构。其内部由大量尺寸相近、取向随机的等轴晶粒组成，使材料宏观上表现出各向同性的力学性能。它是制造涡轮叶片等高温部件的传统材料形式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-d60cc087d5f03ae6059fa8890a861a5b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Equiaxed form&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d60cc087d5f03ae6059fa8890a861a5b-e-6&quot;, &quot;chunk-5e30fb63f189d46677273b5c0f9ed52d-e-3&quot;, &quot;chunk-0f24474e96c9ef42ab24560f2ccf918e-e-14&quot;, &quot;chunk-e3bc91d02528ce132349b28825081f88-e-4&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c8bfe4fa64e107ddff8d923b426a8333-e-3" label="Rupture Life">
        <attvalues>
          <attvalue for="0" value="Rupture Life" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="持久寿命 (Rupture life) 是一种材料属性，指材料在恒定载荷与高温下，直至发生断裂所能持续的时间。它是评估高压涡轮叶片等高温承力部件性能的关键指标。拓扑密排（TCP）相的析出会显著缩短其寿命，损害材料的可靠性。" />
          <attvalue for="3" value="{&quot;improvement_period&quot;: &quot;1980-1995&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c8bfe4fa64e107ddff8d923b426a8333" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Rupture life&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c8bfe4fa64e107ddff8d923b426a8333-e-3&quot;, &quot;chunk-561d2449c805db1de389831a67f53313-e-6&quot;, &quot;chunk-98dc45a2c81a5783151664ba74c4681e-e-9&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-738d5a08a05f18670227192d3b2434f7-e-3" label="Materials suppliers">
        <attvalues>
          <attvalue for="0" value="Materials suppliers" />
          <attvalue for="1" value="Organization Type" />
          <attvalue for="2" value="指致力于研发、生产和供应拥有自主知识产权的专有材料配方的组织。它们通过技术创新，开发出具有特定性能优势的高性能材料（如高温合金），以满足市场特殊需求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-738d5a08a05f18670227192d3b2434f7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="44" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-738d5a08a05f18670227192d3b2434f7-e-4" label="Proprietary compositions">
        <attvalues>
          <attvalue for="0" value="Proprietary compositions" />
          <attvalue for="1" value="Material Specification" />
          <attvalue for="2" value="专有配方是一种由特定实体拥有、通常作为商业秘密的独特材料配方。作为一种材料规格，它因能赋予产品独特的性能和竞争优势，而被发动机制造商及材料供应商等积极寻求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-738d5a08a05f18670227192d3b2434f7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="44" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-738d5a08a05f18670227192d3b2434f7-e-5" label="Table 1.3">
        <attvalues>
          <attvalue for="0" value="Table 1.3" />
          <attvalue for="1" value="Data Source" />
          <attvalue for="2" value="Table 1.3是一个数据源，以表格形式详细列出了常见铸造高温合金的化学成分。该表格系统地呈现了这些合金中各元素的含量，为材料科学研究和工程应用提供了关键的参考数据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-738d5a08a05f18670227192d3b2434f7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-738d5a08a05f18670227192d3b2434f7-e-7" label="Single-crystal form">
        <attvalues>
          <attvalue for="0" value="Single-crystal form" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="单晶是一种材料形态，指整个部件由单一取向的晶粒构成，从而消除了作为性能薄弱环节的晶界。这种结构能赋予铸造高温合金等材料卓越的高温蠕变强度和力学性能，常用于航空发动机涡轮叶片等。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-738d5a08a05f18670227192d3b2434f7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-738d5a08a05f18670227192d3b2434f7-e-9" label="First-generation single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="First-generation single-crystal superalloys" />
          <attvalue for="1" value="Material Subclass" />
          <attvalue for="2" value="第一代单晶高温合金（First-generation single-crystal superalloys）指一类特定的单晶高温合金，是该材料的首个发展阶段。其不含有或仅含少量贵重金属铼（Re），典型牌号包括PWA1480和Rene N4。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-738d5a08a05f18670227192d3b2434f7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-738d5a08a05f18670227192d3b2434f7-e-10" label="PWA1480">
        <attvalues>
          <attvalue for="0" value="PWA1480" />
          <attvalue for="1" value="Superalloy" />
          <attvalue for="2" value="PWA 1480是一种由美国航空发动机制造商普拉特·惠特尼公司(Pratt &amp; Whitney)开发的专有合金牌号。作为PWA合金系列的成员，它是一种镍基高温合金，专为制造航空发动机涡轮盘等在极端高温高压环境下工作的关键部件而设计。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-738d5a08a05f18670227192d3b2434f7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;PWA 1480&quot;, &quot;PWA1480 single-crystal superalloy&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-738d5a08a05f18670227192d3b2434f7-e-10&quot;, &quot;chunk-8cc148c1ca974c554ee456036519b0b3-e-2&quot;, &quot;chunk-740f6c1fef49d66e9d25ef0e2de914da-e-6&quot;, &quot;chunk-a32309070a2ae9bb93878cff40ade2c7-e-7&quot;, &quot;chunk-ae682ac4e4eb339bd48233482011cdd1-e-13&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-738d5a08a05f18670227192d3b2434f7-e-11" label="Rene N4">
        <attvalues>
          <attvalue for="0" value="Rene N4" />
          <attvalue for="1" value="Specific Material" />
          <attvalue for="2" value="Rene N4是勒内(René)合金家族的一员，是一种先进的镍基高温合金。它以在高温下拥有卓越的机械强度、抗蠕变和抗氧化性能而著称，主要用于制造航空发动机和燃气轮机中的涡轮叶片等关键热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-738d5a08a05f18670227192d3b2434f7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-738d5a08a05f18670227192d3b2434f7-e-11&quot;, &quot;chunk-8cc148c1ca974c554ee456036519b0b3-e-3&quot;, &quot;chunk-ae682ac4e4eb339bd48233482011cdd1-e-20&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8cc148c1ca974c554ee456036519b0b3-e-1" label="First-generation single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="First-generation single-crystal superalloys" />
          <attvalue for="1" value="Alloy Generation" />
          <attvalue for="2" value="第一代单晶高温合金指早期开发的一类单晶高温合金，以PWA1480、Rene N4等为代表。其特点是依靠γ'相作为主要强化相来获得高温强度，并且由于其单晶结构消除了晶界，因此成分中不含有或极少含有晶界强化元素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-8cc148c1ca974c554ee456036519b0b3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-8cc148c1ca974c554ee456036519b0b3-e-5" label="γ' hardening elements">
        <attvalues>
          <attvalue for="0" value="γ' hardening elements" />
          <attvalue for="1" value="Element Category" />
          <attvalue for="2" value="指在镍基高温合金中，能促进并稳定γ'相析出的一类关键合金元素，主要包括铝(Al)、钛(Ti)和钽(Ta)。它们作为γ'强化相的主要形成元素，通过沉淀强化效应，赋予合金优异的高温强度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-8cc148c1ca974c554ee456036519b0b3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8cc148c1ca974c554ee456036519b0b3-e-5&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8cc148c1ca974c554ee456036519b0b3-e-7" label="Ti">
        <attvalues>
          <attvalue for="0" value="Ti" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="钛（Titanium）是一种化学元素，符号为Ti，原子序数22。它是一种银白色的过渡金属，以低密度、高强度和卓越的抗腐蚀性著称。因其优异的强度重量比和生物相容性，被广泛应用于航空航天、医疗植入物等高科技领域。其氧化物二氧化钛是重要的白色颜料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-8cc148c1ca974c554ee456036519b0b3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Titanium&quot;, &quot;Titanium (Ti)&quot;, &quot;titanium&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8cc148c1ca974c554ee456036519b0b3-e-7&quot;, &quot;chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-8&quot;, &quot;chunk-f14b0074e13363327f2213611a99c96e-e-8&quot;, &quot;chunk-ed24a575ccc7da550855ce4a7d4ebb9f-e-6&quot;, &quot;chunk-a4d65971a0e96c0f576b576adadc50ce-e-8&quot;, &quot;chunk-0d8b8971d722c099aa85646d423e67e5-e-2&quot;, &quot;chunk-a112fb1af2aeb898bf0f5a14a40c216f-e-5&quot;, &quot;chunk-5354da7deedb75e784b4ab18d7e8dbe0-e-8&quot;, &quot;chunk-35442490006b7aff468c9227749684e6-e-4&quot;, &quot;chunk-c66cb4a523402b814bf33ff19d16eb24-e-9&quot;, &quot;chunk-a00605aad03a48315b6372d73ae11d54-e-6&quot;, &quot;chunk-2b6a04ecc641ed4c1cec1b3e414ec201-e-6&quot;, &quot;chunk-99e1c2354bf8364a02d01889797902c8-e-2&quot;, &quot;chunk-b01056d7d0ec300f60d9bb3706353f8f-e-4&quot;, &quot;chunk-6cc9936949c5f333eaac7910b952ef48-e-4&quot;, &quot;chunk-9f8adabfb1010fa4a4528e361c3f5223-e-8&quot;, &quot;chunk-78c519f8cce4113c48c714a60ca273ce-e-1&quot;, &quot;chunk-23df60e783372fb64b1a5a9966ec4edc-e-10&quot;, &quot;chunk-23893d297564190aa46fd314ec1e6f0e-e-2&quot;, &quot;chunk-3ca8a51d3be3a429f4f741571769150f-e-3&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="15" />
        </attvalues>
      </node>
      <node id="chunk-8cc148c1ca974c554ee456036519b0b3-e-12" label="Directionally solidified alloys">
        <attvalues>
          <attvalue for="0" value="Directionally solidified alloys" />
          <attvalue for="1" value="Alloy Type" />
          <attvalue for="2" value="定向凝固合金是一种高温合金。它通过控制凝固工艺，使柱状晶沿特定方向平行生长，从而消除或减少了垂直于主应力方向的横向晶界。这类合金通常含有晶界强化元素以提高高温性能，是介于传统等轴晶合金与单晶合金之间的先进材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-8cc148c1ca974c554ee456036519b0b3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8cc148c1ca974c554ee456036519b0b3-e-12&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8cc148c1ca974c554ee456036519b0b3-e-13" label="Second-generation alloys">
        <attvalues>
          <attvalue for="0" value="Second-generation alloys" />
          <attvalue for="1" value="Alloy Generation" />
          <attvalue for="2" value="第二代合金是一类以添加约3 wt%的铼(Re)为关键特征的高温合金。它们在第一代合金基础上发展而来，旨在提升高温蠕变强度和抗疲劳性能。典型牌号包括PWA1484、CMSX-4和Rene N5。" />
          <attvalue for="3" value="{&quot;Re_concentration&quot;: &quot;3 wt%&quot;}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-8cc148c1ca974c554ee456036519b0b3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8cc148c1ca974c554ee456036519b0b3-e-14" label="PWA1484">
        <attvalues>
          <attvalue for="0" value="PWA1484" />
          <attvalue for="1" value="Superalloy" />
          <attvalue for="2" value="PWA 1484是美国航空发动机制造商普拉特·惠特尼（Pratt &amp; Whitney）公司的一种材料规范。该规范通常指代一种镍基或钴基高温合金，因其优异的高温强度和抗腐蚀性，被广泛用于制造航空发动机的涡轮叶片、盘件等关键热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-8cc148c1ca974c554ee456036519b0b3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;PWA 1484&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8cc148c1ca974c554ee456036519b0b3-e-14&quot;, &quot;chunk-ae682ac4e4eb339bd48233482011cdd1-e-14&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8cc148c1ca974c554ee456036519b0b3-e-16" label="Rene N5">
        <attvalues>
          <attvalue for="0" value="Rene N5" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="Rene N5是一种镍基单晶高温合金。因其优异的高温强度、抗蠕变及抗氧化性能，主要用于制造航空发动机和工业燃气轮机的涡轮叶片等热端部件。它常作为基体材料，在其表面沉积铂铝化物粘结层等热障涂层以提供额外防护。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-8cc148c1ca974c554ee456036519b0b3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Rene N5 single-crystal superalloy&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e3bf4592567fa4c79f22955763ff9714-e-2&quot;, &quot;chunk-8cc148c1ca974c554ee456036519b0b3-e-16&quot;, &quot;chunk-ae682ac4e4eb339bd48233482011cdd1-e-21&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8cc148c1ca974c554ee456036519b0b3-e-18" label="Third-generation alloys">
        <attvalues>
          <attvalue for="0" value="Third-generation alloys" />
          <attvalue for="1" value="Alloy Generation" />
          <attvalue for="2" value="第三代合金是一类以铼（Re）浓度显著增加为核心特征的高温合金。与前代相比，更高的铼含量能有效提升其在高温下的蠕变抗力、稳定性和持久寿命。" />
          <attvalue for="3" value="{&quot;Re_concentration&quot;: &quot;about 6 wt%&quot;}" />
          <attvalue for="4" value="e-18" />
          <attvalue for="5" value="chunk-8cc148c1ca974c554ee456036519b0b3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-2" label="Third-generation alloys">
        <attvalues>
          <attvalue for="0" value="Third-generation alloys" />
          <attvalue for="1" value="Alloy Generation" />
          <attvalue for="2" value="第三代合金指一类以增加铼(Re)含量为主要特征的镍基单晶高温合金，旨在显著提升材料的高温性能。其典型代表为CMSX-10和Rene N6等合金。" />
          <attvalue for="3" value="{&quot;Re_concentration&quot;: &quot;about 6 wt%&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-934fe384c1e1c8aa8f00e3faee00cc14" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-3" label="CMSX-10">
        <attvalues>
          <attvalue for="0" value="CMSX-10" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="CMSX-10是一种由美国Cannon-Muskegon公司开发的第三代含铼(Re)镍基单晶高温合金。它具有卓越的高温强度、抗蠕变性和抗氧化性，主要用于制造航空发动机和工业燃气轮机的高压涡轮叶片。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-934fe384c1e1c8aa8f00e3faee00cc14" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-3&quot;, &quot;chunk-f23caa328479b9d419f0d855b9335eb4-e-4&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-4" label="Rene N6">
        <attvalues>
          <attvalue for="0" value="Rene N6" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="Rene N6是一种由通用电气公司开发的第六代镍基单晶高温合金。因其含有铼等元素，具有卓越的高温强度、抗蠕变和抗氧化性能，主要用于制造高性能航空发动机的涡轮叶片等关键热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-934fe384c1e1c8aa8f00e3faee00cc14" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-4&quot;, &quot;chunk-ae682ac4e4eb339bd48233482011cdd1-e-22&quot;, &quot;chunk-e3a2ad2f86c91d0494cd03450bd94ade-e-1&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-5" label="Modern Alloys">
        <attvalues>
          <attvalue for="0" value="Modern Alloys" />
          <attvalue for="1" value="Alloy Category" />
          <attvalue for="2" value="现代合金 (Modern alloys) 是一类具有特定化学成分特征的合金。其典型特征为：含有较低的铬（Cr）、较高的铝（Al）和铼（Re），以及适中含量的钛（Ti）和钼（Mo）。这种独特的元素配比旨在优化材料在特定应用环境下的综合性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-934fe384c1e1c8aa8f00e3faee00cc14" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Modern alloys&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-5&quot;, &quot;chunk-ece73a04275b10b6ad2874686306213a-e-1&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-10" label="Fourth-generation single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="Fourth-generation single-crystal superalloys" />
          <attvalue for="1" value="Alloy Generation" />
          <attvalue for="2" value="第四代单晶高温合金是21世纪初问世的新一代镍基高温合金。其核心特征是通过优化添加钌(Ru)等多种难熔元素，获得了比第三代合金更卓越的高温强度、抗蠕变性能和组织稳定性，能够承受更高的工作温度。主要用于制造先进航空发动机的涡轮叶片等关键热端部件。" />
          <attvalue for="3" value="{&quot;emergence_period&quot;: &quot;since 2000&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-934fe384c1e1c8aa8f00e3faee00cc14" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-11" label="MC-NG">
        <attvalues>
          <attvalue for="0" value="MC-NG" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="MC-NG是一种下一代（Next Generation）镍基高温合金，其名称中的“MC”指通过MC型碳化物进行强化。该合金具备优异的高温强度、抗蠕变及抗氧化性能，主要用于制造航空发动机涡轮叶片等关键热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-934fe384c1e1c8aa8f00e3faee00cc14" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;MC-NG superalloy&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-11&quot;, &quot;chunk-1ac5bc0c5780485801a680d4bc6fcb10-e-2&quot;, &quot;chunk-2947345c06e9b1b937f82bc1b2da5774-e-4&quot;, &quot;chunk-f23caa328479b9d419f0d855b9335eb4-e-16&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-12" label="EPM-102">
        <attvalues>
          <attvalue for="0" value="EPM-102" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="EPM-102是一种第四代单晶高温合金。这类先进合金材料通过消除晶界，在极端高温下具有卓越的强度、抗蠕变和持久寿命，通常被用作制造高性能航空发动机涡轮叶片等关键热端部件的核心材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-934fe384c1e1c8aa8f00e3faee00cc14" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-12&quot;, &quot;chunk-1ac5bc0c5780485801a680d4bc6fcb10-e-3&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-13" label="TMS-162">
        <attvalues>
          <attvalue for="0" value="TMS-162" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="TMS-162是一种第四代单晶高温合金。作为一类先进的工程材料，它被设计用于在极端高温环境下保持卓越的力学性能和结构稳定性，代表了该领域材料的先进水平。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-934fe384c1e1c8aa8f00e3faee00cc14" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-13&quot;, &quot;chunk-1ac5bc0c5780485801a680d4bc6fcb10-e-4&quot;, &quot;chunk-aad5a5786d03a03d8f644b4cda7a85fb-e-5&quot;, &quot;chunk-e3a2ad2f86c91d0494cd03450bd94ade-e-10&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-1ac5bc0c5780485801a680d4bc6fcb10-e-1" label="single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="single-crystal superalloys" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="单晶高温合金是一种整体由单个晶粒构成的特种合金。因消除了晶界这一结构薄弱环节，其高温强度、抗蠕变和持久性能极为优异，是制造航空发动机叶片等核心热端部件的关键材料。现代先进的该类合金常添加钌(Ru)等元素以进一步提升综合性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-1ac5bc0c5780485801a680d4bc6fcb10" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-1ac5bc0c5780485801a680d4bc6fcb10-e-5" label="Ruthenium">
        <attvalues>
          <attvalue for="0" value="Ruthenium" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="钌（Ruthenium）是一种化学元素，化学符号为Ru，原子序数为44。它属于铂族金属，是一种硬而脆、呈银白色的稀有过渡金属。钌主要用作合金添加剂，能显著提高铂、钯等金属的硬度和耐磨性。此外，其化合物在多种化学反应中是高效的催化剂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1ac5bc0c5780485801a680d4bc6fcb10" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Ru&quot;, &quot;Ruthenium (Ru)&quot;, &quot;ruthenium&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1ac5bc0c5780485801a680d4bc6fcb10-e-5&quot;, &quot;chunk-a921a108c7811dc9a541483523b2c983-e-11&quot;, &quot;chunk-6f03154ca36cf3915a23738d2e17bbfa-e-3&quot;, &quot;chunk-480d57aecb221d6739d918eba055fa57-e-2&quot;, &quot;chunk-3840a842bb1a54d4d273056bed0dac49-e-7&quot;, &quot;chunk-1d0418c28a59c280072dbd96eeaaa524-e-3&quot;, &quot;chunk-22dadd8677004929f45649f589c98023-e-3&quot;, &quot;chunk-9f8adabfb1010fa4a4528e361c3f5223-e-6&quot;, &quot;chunk-64f0b642dc984a92646a132ee856bc18-e-9&quot;, &quot;chunk-cad1eaa9ffb0e731892120bbe3415da7-e-17&quot;, &quot;chunk-dddd9f3ab574da5297f93e141b49d4a6-e-2&quot;, &quot;chunk-3d0590efade07af78fea353ef909c7ec-e-7&quot;, &quot;chunk-1ad3d9def6416eb2826a0448d6287c6f-e-4&quot;, &quot;chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-5&quot;, &quot;chunk-114d612b5f5f30e54d96d2a909a6dd20-e-7&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="14" />
        </attvalues>
      </node>
      <node id="chunk-1ac5bc0c5780485801a680d4bc6fcb10-e-7" label="polycrystalline form">
        <attvalues>
          <attvalue for="0" value="polycrystalline form" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="多晶形态是一种由大量取向各异的微小晶体（晶粒）组成的固体材料形态，晶粒间由晶界分隔。它是变形高温合金等大多数金属材料所采用的典型微观结构，其晶粒尺寸、形状和分布共同决定了材料的宏观力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-1ac5bc0c5780485801a680d4bc6fcb10" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1ac5bc0c5780485801a680d4bc6fcb10-e-8" label="Cast Superalloys">
        <attvalues>
          <attvalue for="0" value="Cast Superalloys" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="铸造高温合金是一类采用铸造工艺成形的高温合金，主要通过γ'相沉淀强化。与锻造高温合金相比，其成分允许加入更高含量的合金元素，因此具有更优异的高温强度、持久性能和抗蠕变性，适用于制造航空发动机涡轮叶片等形状复杂的热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-1ac5bc0c5780485801a680d4bc6fcb10" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Cast forms of superalloys&quot;, &quot;Common cast superalloys&quot;, &quot;cast superalloys&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1ac5bc0c5780485801a680d4bc6fcb10-e-8&quot;, &quot;chunk-e6c8cf32e29caa40f92e13ee8d574c84-e-2&quot;, &quot;chunk-23893d297564190aa46fd314ec1e6f0e-e-8&quot;, &quot;chunk-738d5a08a05f18670227192d3b2434f7-e-6&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-1ac5bc0c5780485801a680d4bc6fcb10-e-9" label="γ' hardening">
        <attvalues>
          <attvalue for="0" value="γ' hardening" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种存在于镍基等高温合金中的主要沉淀强化机制。它通过在基体中析出弥散的有序γ'相来阻碍位错运动，从而显著提升材料的高温强度。γ'相的含量是区分和比较铸造与变形高温合金性能的一个关键特征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-1ac5bc0c5780485801a680d4bc6fcb10" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1ac5bc0c5780485801a680d4bc6fcb10-e-9&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9108d08e6e7d916cfb35fde79b233c67-e-1" label="perfect crystals">
        <attvalues>
          <attvalue for="0" value="perfect crystals" />
          <attvalue for="1" value="Crystal Structure" />
          <attvalue for="2" value="晶体位错（Dislocation）的理论模型。它指理想晶体的一部分晶格相对于另一部分，沿着一个特定矢量（伯格斯矢量，如a/2(101)）发生滑移位移，从而在晶体内部形成一种线缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-9108d08e6e7d916cfb35fde79b233c67" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9108d08e6e7d916cfb35fde79b233c67-e-2" label="a/2(101)">
        <attvalues>
          <attvalue for="0" value="a/2(101)" />
          <attvalue for="1" value="Displacement Vector" />
          <attvalue for="2" value="在有序合金或超晶格中的一种位移矢量。它并非晶格矢量，其位移作用会在完美晶体中产生称为反相畴界（APB）的平面缺陷，与此缺陷相关的能量即为反相畴界能。" />
          <attvalue for="3" value="{&quot;is_lattice_vector&quot;: &quot;false&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-9108d08e6e7d916cfb35fde79b233c67" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9108d08e6e7d916cfb35fde79b233c67-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9108d08e6e7d916cfb35fde79b233c67-e-4" label="{110} plane">
        <attvalues>
          <attvalue for="0" value="{110} plane" />
          <attvalue for="1" value="Crystallographic Plane" />
          <attvalue for="2" value="{110}晶面是晶体学中由密勒指数{110}所代表的一族晶面。在有序合金等材料中，该晶面是研究反相畴界（APB）能的一个重要平面，因为剪切会在此平面上形成高能的“错误近邻键”（Forbidden Bond），其能量是决定材料性能的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-9108d08e6e7d916cfb35fde79b233c67" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9108d08e6e7d916cfb35fde79b233c67-e-4&quot;, &quot;chunk-a147395bb93a2c0f3ea0e531840ca795-e-10&quot;, &quot;chunk-9b30e2ac693416c047e70b5d2cbba7ff-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-9108d08e6e7d916cfb35fde79b233c67-e-5" label="{001} plane">
        <attvalues>
          <attvalue for="0" value="{001} plane" />
          <attvalue for="1" value="Crystallographic Plane" />
          <attvalue for="2" value="在晶体学中，{001}晶面指由(100)、(010)、(001)等所有等效晶面构成的晶面族。在许多有序金属间化合物（如L1₂结构）中，该晶面族具有最低的反相畴界（Anti-Phase Boundary, APB）能量，这一特性对材料的位错滑移和力学性能有决定性影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-9108d08e6e7d916cfb35fde79b233c67" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9108d08e6e7d916cfb35fde79b233c67-e-5&quot;, &quot;chunk-9b30e2ac693416c047e70b5d2cbba7ff-e-5&quot;, &quot;chunk-9718b105c96174ffb3694bd3c4362a1e-e-4&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-9108d08e6e7d916cfb35fde79b233c67-e-8" label="complex stacking faults">
        <attvalues>
          <attvalue for="0" value="complex stacking faults" />
          <attvalue for="1" value="Crystallographic Defect" />
          <attvalue for="2" value="复杂层错（Complex Stacking Fault, CSF）是一种晶体中的面缺陷。它是一种位错分解机制，指一个全位错（如a[101]）分解为两个不全位错（如a/6[112]和a/6[211]）时，在它们之间形成的层错区域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-9108d08e6e7d916cfb35fde79b233c67" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;CSF&quot;, &quot;CSFs&quot;, &quot;Complex Stacking Fault (CSF)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9108d08e6e7d916cfb35fde79b233c67-e-8&quot;, &quot;chunk-be2e5714ffd15b4d499890769149ecb3-e-7&quot;, &quot;chunk-13624c30d54236964523cb607119931d-e-5&quot;, &quot;chunk-da122ebde0d16d97da9e3e19d5be9708-e-7&quot;, &quot;chunk-988dabd61f21e6f460ff885a9055c6a6-e-2&quot;, &quot;chunk-d965a70b739082dfa928e6608abf4061-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-9108d08e6e7d916cfb35fde79b233c67-e-9" label="Planar defects">
        <attvalues>
          <attvalue for="0" value="Planar defects" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="面缺陷（Planar defects），又称二维缺陷，是晶体材料中几何形态在二维平面上延伸的一类晶体缺陷。它包括层错、反相畴界等主要类型，常参与位错分解反应，并对原子扩散等过程产生影响，进而改变材料的宏观性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-9108d08e6e7d916cfb35fde79b233c67" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;planar defect&quot;, &quot;planar defects&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9108d08e6e7d916cfb35fde79b233c67-e-9&quot;, &quot;chunk-b38b75a018fa569ff580b1d94d62395d-e-8&quot;, &quot;chunk-dc4fc8b9731ff54ceedadcde2ec92655-e-2&quot;, &quot;chunk-66ba88a6026c55d38eeb24aad6777073-e-4&quot;, &quot;chunk-bcb76bb0ef5881469a3b9478e223d894-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="11" />
        </attvalues>
      </node>
      <node id="chunk-9108d08e6e7d916cfb35fde79b233c67-e-10" label="dislocation dissociation">
        <attvalues>
          <attvalue for="0" value="dislocation dissociation" />
          <attvalue for="1" value="Physical Mechanism" />
          <attvalue for="2" value="位错分解反应 (Dislocation dissociation reactions) 是一种晶体材料中的物理过程。为降低弹性应变能，一个能量较高的全位错会自发地分解成两个或多个能量较低的不全位错。这些不全位错之间通常由一个层错区域分隔开。此过程是镍基高温合金γ'相等有序相中的一种典型位错行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-9108d08e6e7d916cfb35fde79b233c67" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Dislocation dissociation reactions&quot;, &quot;dislocation dissociation reactions&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9108d08e6e7d916cfb35fde79b233c67-e-10&quot;, &quot;chunk-dc4fc8b9731ff54ceedadcde2ec92655-e-5&quot;, &quot;chunk-cb76da6f86e534b7b2a34ae7c293d1f0-e-10&quot;, &quot;chunk-12efe43c66bf3765417cf87c1dbf67ad-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-3e64561be3c56bb2625ff8ce6474f540-e-2" label="y phase">
        <attvalues>
          <attvalue for="0" value="y phase" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="y相是一种材料相，其关键特征是作为a/2(110){111}型位错的运动基体。在这种相的晶体结构中，该特定类型的位错可以滑移和传播，这构成了该材料发生塑性变形等力学行为的微观机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-3e64561be3c56bb2625ff8ce6474f540" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3e64561be3c56bb2625ff8ce6474f540-e-2&quot;, &quot;chunk-1a93cf0e7220cae761fdbf08f5ce260b-e-5&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3e64561be3c56bb2625ff8ce6474f540-e-5" label="γ/γ' structure">
        <attvalues>
          <attvalue for="0" value="γ/γ' structure" />
          <attvalue for="1" value="Material Microstructure" />
          <attvalue for="2" value="γ/γ'结构是镍基高温合金的典型两相微观结构，由立方状的γ'强化相弥散分布于γ基体相中构成。在高温和应力作用下，该结构会发生定向粗化形成“筏排”(Rafts)结构，并可能导致两相拓扑关系翻转。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3e64561be3c56bb2625ff8ce6474f540" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3e64561be3c56bb2625ff8ce6474f540-e-5&quot;, &quot;chunk-9a94346ed73c8bcf6797ad71ded00b42-e-5&quot;, &quot;chunk-1a93cf0e7220cae761fdbf08f5ce260b-e-8&quot;, &quot;chunk-7cf96eceef65bf46495ba2d8c36b9a73-e-7&quot;, &quot;chunk-59b9b1adda4a73bb67c682f77b77e783-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-3e64561be3c56bb2625ff8ce6474f540-e-6" label="Pairs of dislocations">
        <attvalues>
          <attvalue for="0" value="Pairs of dislocations" />
          <attvalue for="1" value="Dislocation Configuration" />
          <attvalue for="2" value="一种由两个超分位错（superpartials）构成的特定位错组态。它通过切过γ/γ'结构中的有序相来实现材料的塑性变形，是“有序强化”现象的微观物理起源。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-3e64561be3c56bb2625ff8ce6474f540" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-3e64561be3c56bb2625ff8ce6474f540-e-7" label="Order strengthening">
        <attvalues>
          <attvalue for="0" value="Order strengthening" />
          <attvalue for="1" value="Strengthening Mechanism" />
          <attvalue for="2" value="有序强化是一种材料强化机制，常见于具有原子长程有序结构的合金（如金属间化合物）中。当位错运动破坏其有序排列时，会形成高能量的反相畴界，从而对位错滑移产生巨大阻力。这迫使位错以能量更高的“超位错”形式运动，进而显著提高材料的强度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-3e64561be3c56bb2625ff8ce6474f540" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3e64561be3c56bb2625ff8ce6474f540-e-7&quot;, &quot;chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-5&quot;, &quot;chunk-dc4fc8b9731ff54ceedadcde2ec92655-e-9&quot;, &quot;chunk-4f41447104e1101d06dfe6066a69e83c-e-5&quot;, &quot;chunk-41c4572391c7a506f02a50c6ea737ecc-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-3e64561be3c56bb2625ff8ce6474f540-e-8" label="Static, tensile properties">
        <attvalues>
          <attvalue for="0" value="Static, tensile properties" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="静态拉伸性能指材料在缓慢施加的拉伸载荷下，所表现出的抵抗变形和断裂的力学特性。它由屈服强度、抗拉强度、伸长率和弹性模量等一系列核心指标来表征，是评估材料适用性的基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-3e64561be3c56bb2625ff8ce6474f540" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3e64561be3c56bb2625ff8ce6474f540-e-8&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-78b756dd65fb78d8b34a959b45292e60-e-1" label="Superpartial">
        <attvalues>
          <attvalue for="0" value="Superpartial" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="Superpartial 是一种材料组件，其核心特性是耦合强度具有可变性，能够以弱耦合或强耦合两种状态存在。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-78b756dd65fb78d8b34a959b45292e60" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-78b756dd65fb78d8b34a959b45292e60-e-2" label="Weak Coupling">
        <attvalues>
          <attvalue for="0" value="Weak Coupling" />
          <attvalue for="1" value="Coupling State" />
          <attvalue for="2" value="弱耦合是一种位错状态，指在材料中强化相（如γ'相）的体积分数较低时，所出现的一种超偏位错耦合形式。该状态的形成受γ'相分数的直接影响，是理解和预测材料力学行为的关键机制之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-78b756dd65fb78d8b34a959b45292e60" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-78b756dd65fb78d8b34a959b45292e60-e-2&quot;, &quot;chunk-f263635cd44ee57c5a9142ff0e73030b-e-7&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-78b756dd65fb78d8b34a959b45292e60-e-3" label="Strong Coupling">
        <attvalues>
          <attvalue for="0" value="Strong Coupling" />
          <attvalue for="1" value="Coupling State" />
          <attvalue for="2" value="强耦合是一种描述超偏位错（superpartials）的耦合状态。其核心特征是：成对的超偏位错之间的间距，与决定该状态的γ'粒子（gamma-prime particle）的直径相比非常小。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-78b756dd65fb78d8b34a959b45292e60" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Strong coupling&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-78b756dd65fb78d8b34a959b45292e60-e-3&quot;, &quot;chunk-b90feda161b295cfb50134cb85d41526-e-4&quot;, &quot;chunk-f263635cd44ee57c5a9142ff0e73030b-e-6&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-78b756dd65fb78d8b34a959b45292e60-e-5" label="Under-aged condition">
        <attvalues>
          <attvalue for="0" value="Under-aged condition" />
          <attvalue for="1" value="Material State" />
          <attvalue for="2" value="欠时效状态（under-aged condition）是材料在时效硬化过程中，因时效不足而未达到峰值硬度的亚稳状态。其微观特征为基体中分布着可被位错切过的细小共格析出相（如faulted particles），位错切过机制是此阶段的主要强化方式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-78b756dd65fb78d8b34a959b45292e60" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;under-aged condition&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-78b756dd65fb78d8b34a959b45292e60-e-5&quot;, &quot;chunk-0fc62816353bfe4473c22a2bef9a696b-e-4&quot;]}]" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-78b756dd65fb78d8b34a959b45292e60-e-7" label="Weak-coupling mechanism">
        <attvalues>
          <attvalue for="0" value="Weak-coupling mechanism" />
          <attvalue for="1" value="Physical Mechanism" />
          <attvalue for="2" value="一种材料强化机制，指位错因无法切削第二相粒子而绕过其运动（Orowan机制），从而提高材料强度。其强化效果与粒子半径的平方根成正比。当粒子尺寸超过某一临界值后，该机制会取代强耦合的粒子切削机制成为主导。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-78b756dd65fb78d8b34a959b45292e60" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-78b756dd65fb78d8b34a959b45292e60-e-7&quot;, &quot;chunk-b90feda161b295cfb50134cb85d41526-e-3&quot;]}]" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-78b756dd65fb78d8b34a959b45292e60-e-8" label="Strong-coupling mechanism">
        <attvalues>
          <attvalue for="0" value="Strong-coupling mechanism" />
          <attvalue for="1" value="Physical Mechanism" />
          <attvalue for="2" value="强耦合机制是一种适用于过时效组织的物理切削机制。其特征是，在切削过程中，刀具与材料内粗大的强化相发生强相互作用，并将其直接切断，而非绕过。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-78b756dd65fb78d8b34a959b45292e60" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-78b756dd65fb78d8b34a959b45292e60-e-9" label="Hardening">
        <attvalues>
          <attvalue for="0" value="Hardening" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**标准化描述**：&#10;&#10;硬化是一种材料属性，其强度大小与材料内部的颗粒半径及耦合机制密切相关。当颗粒在某一临界尺寸（机制转变点）时，硬化效果达到最大值，随后其强度通常随颗粒半径的增大而减小。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-78b756dd65fb78d8b34a959b45292e60" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-78b756dd65fb78d8b34a959b45292e60-e-9&quot;, &quot;chunk-b90feda161b295cfb50134cb85d41526-e-1&quot;, &quot;chunk-c026408b0eb125d3c56d1ed05d0a0f15-e-3&quot;]}]" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-78b756dd65fb78d8b34a959b45292e60-e-10" label="Particle radius (r)">
        <attvalues>
          <attvalue for="0" value="Particle radius (r)" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="颗粒半径（r）是表征材料中颗粒尺寸的基本物理属性。作为一个关键的几何参数，它直接影响材料的宏观力学行为和物理性质，例如材料的临界剪切应力（τc）等物理量的大小就取决于颗粒半径。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-78b756dd65fb78d8b34a959b45292e60" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Particle radius, r&quot;, &quot;r&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-78b756dd65fb78d8b34a959b45292e60-e-10&quot;, &quot;chunk-b90feda161b295cfb50134cb85d41526-e-2&quot;, &quot;chunk-c026408b0eb125d3c56d1ed05d0a0f15-e-9&quot;]}]" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b90feda161b295cfb50134cb85d41526-e-5" label="γ' particle size at transition">
        <attvalues>
          <attvalue for="0" value="γ' particle size at transition" />
          <attvalue for="1" value="State" />
          <attvalue for="2" value="指材料强化效应达到峰值时的γ'相临界颗粒尺寸。该尺寸是位错与颗粒相互作用从弱耦合机制向强耦合机制转变的标志点。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-b90feda161b295cfb50134cb85d41526" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b90feda161b295cfb50134cb85d41526-e-5&quot;]}]" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b90feda161b295cfb50134cb85d41526-e-6" label="γ/γ' alloys">
        <attvalues>
          <attvalue for="0" value="γ/γ' alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="γ/γ'合金是一种以γ为基体、由γ'相沉淀强化的镍基高温合金。其独特之处在于，屈服强度在一定温度范围内随温度升高而保持稳定或反常增加，因此是制造航空发动机涡轮叶片等高温结构件的关键材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-b90feda161b295cfb50134cb85d41526" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;γ + γ' alloys&quot;, &quot;γ' or γ + γ' alloys&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b90feda161b295cfb50134cb85d41526-e-6&quot;, &quot;chunk-12efe43c66bf3765417cf87c1dbf67ad-e-12&quot;, &quot;chunk-795763ad7f38bb8adeb25f9d763ce8dd-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-b90feda161b295cfb50134cb85d41526-e-9" label="anomalous yielding effect">
        <attvalues>
          <attvalue for="0" value="anomalous yielding effect" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="**反常屈服效应 (Anomalous yielding effect)**&#10;&#10;一种在特定高温合金（尤其是镍基高温合金）中出现的独特力学现象。其特征为，材料的屈服强度在一定温度区间内，随温度的升高反而显著增加，这与绝大多数金属材料强度随温度升高而降低的规律相反。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-b90feda161b295cfb50134cb85d41526" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Anomalous yield effect&quot;, &quot;Anomalous yielding effect&quot;, &quot;anomalous yield effect&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-542eb38b71ebf203cb6df08f03ceb063-e-6&quot;, &quot;chunk-b90feda161b295cfb50134cb85d41526-e-9&quot;, &quot;chunk-c170c36341964554c175d2ca279d86c6-e-1&quot;, &quot;chunk-151e712d06b4c385e5757120e064b560-e-11&quot;, &quot;chunk-264495632c5fce243bda26582e560253-e-3&quot;, &quot;chunk-44a9440aa3e5fad0c388f77698c519bf-e-4&quot;, &quot;chunk-be2e5714ffd15b4d499890769149ecb3-e-17&quot;, &quot;chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-2&quot;, &quot;chunk-dc4fc8b9731ff54ceedadcde2ec92655-e-10&quot;, &quot;chunk-c14396eea836d3f1007eeea78f6bab8c-e-2&quot;, &quot;chunk-d965a70b739082dfa928e6608abf4061-e-8&quot;, &quot;chunk-169f02cd5c7c6d28badcb341503cb862-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-b90feda161b295cfb50134cb85d41526-e-10" label="γ' phase">
        <attvalues>
          <attvalue for="0" value="γ' phase" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="γ'相 (Gamma Prime Phase) 是镍基高温合金中的主要强化相。它是一种具有L1₂有序晶体结构的金属间化合物，通常为Ni₃(Al, Ti)类型。其有序结构能有效阻碍位错运动（如引起位错离解），是合金具有优异高温强度和蠕变抗性的关键。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-b90feda161b295cfb50134cb85d41526" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;gamma prime strengthening phase&quot;, &quot;gamma-prime (y') phase&quot;, &quot;y' phase&quot;, &quot;γ'&quot;, &quot;γ' (gamma prime)&quot;, &quot;γ' particle&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2f58aaf4e11b140e948152f6a58bcf03-e-5&quot;, &quot;chunk-542eb38b71ebf203cb6df08f03ceb063-e-2&quot;, &quot;chunk-9108d08e6e7d916cfb35fde79b233c67-e-11&quot;, &quot;chunk-3e64561be3c56bb2625ff8ce6474f540-e-3&quot;, &quot;chunk-b90feda161b295cfb50134cb85d41526-e-10&quot;, &quot;chunk-81bc3923680aea07100d05a64a8f3afc-e-7&quot;, &quot;chunk-9a94346ed73c8bcf6797ad71ded00b42-e-6&quot;, &quot;chunk-b64f0440514a10a330fae0f79e407e4c-e-3&quot;, &quot;chunk-a5ab94c496162dae08a6cf75a408debb-e-3&quot;, &quot;chunk-de934887953c10df356d75f9bd459e77-e-3&quot;, &quot;chunk-2ea107a54755373c4c649a5b4b0b14ad-e-3&quot;, &quot;chunk-003c7763c31b55c8a5748939ac729c6a-e-3&quot;, &quot;chunk-cb76da6f86e534b7b2a34ae7c293d1f0-e-11&quot;, &quot;chunk-d965a70b739082dfa928e6608abf4061-e-6&quot;, &quot;chunk-c2b78e8b376569da6104df59fa66c5ca-e-7&quot;, &quot;chunk-7cf96eceef65bf46495ba2d8c36b9a73-e-1&quot;, &quot;chunk-af1f9e9d18ac9effde532d2b56262cf6-e-5&quot;, &quot;chunk-02948169a54de26c861e1fa5741b30de-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="14" />
        </attvalues>
      </node>
      <node id="chunk-c170c36341964554c175d2ca279d86c6-e-2" label="y' phase">
        <attvalues>
          <attvalue for="0" value="y' phase" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="γ'相 (Gamma Prime Phase) 是镍基高温合金中的关键强化相，为一种化学式通常为Ni₃(Al, Ti)的金属间化合物。其有序的L1₂晶体结构与基体共格，能在高温下有效阻碍位错运动，从而赋予合金优异的高温强度、持久强度和抗蠕变性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c170c36341964554c175d2ca279d86c6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;y'&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c170c36341964554c175d2ca279d86c6-e-2&quot;, &quot;chunk-9a58de583a6c9c66ff501b98683b07d7-e-1&quot;, &quot;chunk-bfbc49438adee74f98c04c5e0bb57599-e-1&quot;, &quot;chunk-b7bfd8f1e9243bc095953814aae07253-e-1&quot;, &quot;chunk-5682b41ca5ff8b266cfe8297070b22b7-e-5&quot;, &quot;chunk-8fe8d1c616def00dd2818c380aea80d6-e-7&quot;, &quot;chunk-c577786ed818c3adfe9e2cc146b9c0be-e-2&quot;, &quot;chunk-024c36ea3394fc7ba3bfdd8df0168497-e-7&quot;, &quot;chunk-476c99d22cc46115c3dc1dca1b6b4708-e-1&quot;, &quot;chunk-b38b75a018fa569ff580b1d94d62395d-e-1&quot;, &quot;chunk-dc4fc8b9731ff54ceedadcde2ec92655-e-7&quot;, &quot;chunk-c14396eea836d3f1007eeea78f6bab8c-e-1&quot;, &quot;chunk-a00605aad03a48315b6372d73ae11d54-e-1&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="12" />
        </attvalues>
      </node>
      <node id="chunk-c170c36341964554c175d2ca279d86c6-e-3" label="Cross-slip of y' superpartials">
        <attvalues>
          <attvalue for="0" value="Cross-slip of y' superpartials" />
          <attvalue for="1" value="Mechanism" />
          <attvalue for="2" value="一种关键的位错运动机制，指γ'超偏位错分段在应用应力、反相畴界能各向异性等因素促进下，从{111}滑移面转向{001}面。此过程通过固定位错来阻碍塑性变形，是导致材料出现反常屈服效应的直接原因。" />
          <attvalue for="3" value="{&quot;from_plane&quot;: &quot;{111}&quot;, &quot;to_plane&quot;: &quot;{001}&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c170c36341964554c175d2ca279d86c6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c170c36341964554c175d2ca279d86c6-e-6" label="Elastic anisotropy">
        <attvalues>
          <attvalue for="0" value="Elastic anisotropy" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="Elastic anisotropy is a material property wherein elastic characteristics, such as Young's modulus, depend on the direction of measurement. In such materials, the relationship between stress and strain varies with orientation, causing different deformations under loads from various directions. This property is common in materials with an ordered internal structure, like single crystals, wood, or fiber-reinforced composites." />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c170c36341964554c175d2ca279d86c6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Elastic Anisotropy&quot;, &quot;anisotropic elasticity&quot;, &quot;elastic anisotropy&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c170c36341964554c175d2ca279d86c6-e-6&quot;, &quot;chunk-234c3eebb3d42a0daf6e298133c20255-e-8&quot;, &quot;chunk-2954a9d8cd39d35e1c2ce761efb0de31-e-14&quot;, &quot;chunk-8001720db94f44ac88b442f606ab7d39-e-4&quot;, &quot;chunk-91405e06bb69c5ec0eb63c43e028bfc6-e-5&quot;, &quot;chunk-3ff783a5b26a130b0577173680195866-e-1&quot;, &quot;chunk-f6159d3dd840711c5298adf7f057d3b6-e-11&quot;, &quot;chunk-151e712d06b4c385e5757120e064b560-e-10&quot;, &quot;chunk-264495632c5fce243bda26582e560253-e-2&quot;, &quot;chunk-44a9440aa3e5fad0c388f77698c519bf-e-11&quot;, &quot;chunk-fab5556d25e36a12308d5e081229601a-e-8&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-c170c36341964554c175d2ca279d86c6-e-7" label="Creep behaviour">
        <attvalues>
          <attvalue for="0" value="Creep behaviour" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="蠕变行为是一种材料属性，指材料在恒定应力（尤其在高温下）作用下随时间缓慢发生永久变形的倾向。在工程应用中，通常目标是提高材料的抗蠕变性。例如，增加碳和硼等元素的含量可以有效增强材料的抗蠕变能力，改善此项性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c170c36341964554c175d2ca279d86c6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Creep behaviour of nickel and its alloys&quot;, &quot;Creep deformation behaviour&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c170c36341964554c175d2ca279d86c6-e-7&quot;, &quot;chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f-e-8&quot;, &quot;chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-5&quot;, &quot;chunk-2954a9d8cd39d35e1c2ce761efb0de31-e-13&quot;, &quot;chunk-c14396eea836d3f1007eeea78f6bab8c-e-5&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-c170c36341964554c175d2ca279d86c6-e-8" label="Nickel and its alloys">
        <attvalues>
          <attvalue for="0" value="Nickel and its alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍及其合金是以镍为基体加入其他元素形成的金属材料。它们以卓越的高温强度、抗蠕变性和耐腐蚀性而著称，常被用作高温合金或耐蚀合金，广泛应用于航空航天、能源和化工等严苛环境。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-c170c36341964554c175d2ca279d86c6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c170c36341964554c175d2ca279d86c6-e-9" label="Metallurgical structure">
        <attvalues>
          <attvalue for="0" value="Metallurgical structure" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="金相组织（Metallurgical structure）指金属或合金的内部微观结构。其特征由材料的组成相（如晶粒、颗粒）的尺寸、形态和分布，以及合金元素的浓度与分布共同决定。这种微观结构是影响并决定材料宏观物理与机械性能的根本因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-c170c36341964554c175d2ca279d86c6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c170c36341964554c175d2ca279d86c6-e-9&quot;, &quot;chunk-5c24b22e063be5dfa3ae3afab37099c6-e-1&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c170c36341964554c175d2ca279d86c6-e-10" label="Grain size">
        <attvalues>
          <attvalue for="0" value="Grain size" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**晶粒尺寸 (Grain size)**&#10;&#10;一种衡量材料内部晶体颗粒平均大小的关键微观结构参数。它对材料的力学性能有决定性影响：通常，晶粒越细小，材料的屈服强度和抗疲劳裂纹萌生能力越高；但同时会降低其蠕变强度及抗疲劳裂纹扩展能力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-c170c36341964554c175d2ca279d86c6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Grain Size&quot;, &quot;grain size&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c170c36341964554c175d2ca279d86c6-e-10&quot;, &quot;chunk-5c24b22e063be5dfa3ae3afab37099c6-e-2&quot;, &quot;chunk-1cfc07c1de96187a9aff83a89de841ed-e-6&quot;, &quot;chunk-234c3eebb3d42a0daf6e298133c20255-e-5&quot;, &quot;chunk-4297db8e1cac52d92cbbb0fc36d27aaf-e-3&quot;, &quot;chunk-e0b75e1db98f5ed18e200239c3a5bcc3-e-3&quot;, &quot;chunk-f15a8c6d190d14d1db32161520fa75ce-e-1&quot;, &quot;chunk-9b97021f9b9b8256b6c78711278f4654-e-1&quot;, &quot;chunk-8827e315f10ef4c6612df3e85c9f593c-e-9&quot;, &quot;chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-6&quot;, &quot;chunk-b8f64fb156fdeb0f33d3fd48ce26370d-e-9&quot;, &quot;chunk-100afba087a43fc5308b3284aa10cb35-e-3&quot;, &quot;chunk-821a3f267f9ff96b58c19914c2c7eff8-e-6&quot;, &quot;chunk-024c36ea3394fc7ba3bfdd8df0168497-e-5&quot;, &quot;chunk-870742dec10263e0078e94a0b6a827aa-e-6&quot;, &quot;chunk-b7b41d99b7968db6938fc41d4745dc0d-e-15&quot;, &quot;chunk-be2e5714ffd15b4d499890769149ecb3-e-1&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="18" />
        </attvalues>
      </node>
      <node id="chunk-c170c36341964554c175d2ca279d86c6-e-11" label="γ' particle size">
        <attvalues>
          <attvalue for="0" value="γ' particle size" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="y' 颗粒尺寸 (y' particle size) 是指镍基高温合金等材料中，作为主要强化相的伽马撇 (γ') 相沉淀物的尺寸。它是一个关键的微观结构参数，其大小受冷却速率等热处理工艺的控制，较慢的冷却会形成更大的颗粒。该尺寸的增大会加速疲劳裂纹的扩展速率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-c170c36341964554c175d2ca279d86c6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;y' particle size&quot;, &quot;γ' size&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c170c36341964554c175d2ca279d86c6-e-11&quot;, &quot;chunk-5c24b22e063be5dfa3ae3afab37099c6-e-3&quot;, &quot;chunk-1af21239034eac9b97020a65cbbdcded-e-7&quot;, &quot;chunk-198cb71263c64f896cad9847f29b39cf-e-4&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-c170c36341964554c175d2ca279d86c6-e-12" label="Concentrations of alloying additions">
        <attvalues>
          <attvalue for="0" value="Concentrations of alloying additions" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="合金添加物浓度是一种关键的材料属性，指在基体金属中有意添加的合金元素的含量或比例。它直接决定了材料的冶金组织（如相组成和微观结构），并进而影响其最终的机械性能、物理性能与化学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-c170c36341964554c175d2ca279d86c6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c170c36341964554c175d2ca279d86c6-e-12&quot;, &quot;chunk-5c24b22e063be5dfa3ae3afab37099c6-e-4&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5c24b22e063be5dfa3ae3afab37099c6-e-5" label="Polycrystalline nickel">
        <attvalues>
          <attvalue for="0" value="Polycrystalline nickel" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="多晶镍是一种由大量取向各异的微小晶粒构成的金属材料。其一个显著的力学特性是，在特定条件下（如高温蠕变），其变形速率与所施加的应力之间表现出五次方律的依赖关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-5c24b22e063be5dfa3ae3afab37099c6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5c24b22e063be5dfa3ae3afab37099c6-e-6" label="Fifth-power-law dependence">
        <attvalues>
          <attvalue for="0" value="Fifth-power-law dependence" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="五次方律依赖关系是一种材料蠕变现象，指在稳态蠕变阶段，材料的应变速率与外加应力的五次方成正比。该规律在多晶镍等纯金属中很典型，其物理机制可由位错过程的动态平衡来解释。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-5c24b22e063be5dfa3ae3afab37099c6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-5c24b22e063be5dfa3ae3afab37099c6-e-8" label="Steady-state ‘secondary' regime">
        <attvalues>
          <attvalue for="0" value="Steady-state ‘secondary' regime" />
          <attvalue for="1" value="Process Stage" />
          <attvalue for="2" value="稳态蠕变阶段，也称第二蠕变阶段，是材料蠕变变形过程中的一个核心时期。在此阶段，蠕变速率基本保持恒定，其应力与应变率之间的依赖关系遵循一个特征性的五次方定律。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-5c24b22e063be5dfa3ae3afab37099c6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5c24b22e063be5dfa3ae3afab37099c6-e-8&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5c24b22e063be5dfa3ae3afab37099c6-e-9" label="Pure metals">
        <attvalues>
          <attvalue for="0" value="Pure metals" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="纯金属 (Pure metals) 是指由单一金属元素构成的材料类别。在特定物理学背景下，这类材料的一个显著特性是表现出“五次方律依赖性”（fifth-power-law dependence）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-5c24b22e063be5dfa3ae3afab37099c6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;pure metals&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5c24b22e063be5dfa3ae3afab37099c6-e-9&quot;, &quot;chunk-1cfc07c1de96187a9aff83a89de841ed-e-2&quot;, &quot;chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-8&quot;, &quot;chunk-eb23a1fa1bb857c2e5b4e84047321caa-e-5&quot;, &quot;chunk-52c2368c38f01bd3aedce678a81a8dc2-e-6&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-5c24b22e063be5dfa3ae3afab37099c6-e-10" label="Balancing of dislocation processes">
        <attvalues>
          <attvalue for="0" value="Balancing of dislocation processes" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="在材料科学中，指位错增殖与位错湮灭速率达到动态平衡的过程。该过程导致了稳态的位错密度，是恢复控制蠕变模型的核心机制，并被用来合理解释蠕变变形中的五次方律依赖关系。其具体模型通常需要对材料的亚结构进行假设。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-5c24b22e063be5dfa3ae3afab37099c6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5c24b22e063be5dfa3ae3afab37099c6-e-10&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-5c24b22e063be5dfa3ae3afab37099c6-e-14" label="Sub-structure">
        <attvalues>
          <attvalue for="0" value="Sub-structure" />
          <attvalue for="1" value="Material Feature" />
          <attvalue for="2" value="**亚结构 (Sub-structure)**: 一种材料组分。在“lled”蠕变变形模型中，假定该组分会随时间的三次方根发生粗化，这是确保此模型有效性的一个前提条件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-5c24b22e063be5dfa3ae3afab37099c6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5c24b22e063be5dfa3ae3afab37099c6-e-14&quot;, &quot;chunk-3029d23645f5b8329b94fe4d5e582d6f-e-3&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3029d23645f5b8329b94fe4d5e582d6f-e-1" label="'lled' model of creep deformation">
        <attvalues>
          <attvalue for="0" value="'lled' model of creep deformation" />
          <attvalue for="1" value="Model" />
          <attvalue for="2" value="“lled”蠕变模型是一种描述材料蠕变变形的理论模型。其有效性基于一个关键前提：材料的亚结构会随着时间的三次方根而发生粗化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-3029d23645f5b8329b94fe4d5e582d6f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3029d23645f5b8329b94fe4d5e582d6f-e-2" label="Creep deformation">
        <attvalues>
          <attvalue for="0" value="Creep deformation" />
          <attvalue for="1" value="Mechanical Process" />
          <attvalue for="2" value="蠕变（Creep deformation）是一种物理现象，指固体材料在持续的恒定应力（尤其在高温下）作用时，随时间缓慢发生的永久性变形。它是导致材料失效的重要机制，可通过合金化等手段来提高材料的抗蠕变性。该现象可被不同模型描述，并分为Class I、Class II等多种类型。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-3029d23645f5b8329b94fe4d5e582d6f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Creep Deformation&quot;, &quot;creep deformation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3029d23645f5b8329b94fe4d5e582d6f-e-2&quot;, &quot;chunk-369e1699258e2ec0c85dd739d4083ccc-e-1&quot;, &quot;chunk-ee27b5b0461f20c87cc65a6eed743e2e-e-4&quot;, &quot;chunk-c44bc316af8bfbfde3c05fd247258d3c-e-4&quot;, &quot;chunk-86425bad56c0d52ed7246eff0fe06dd8-e-13&quot;, &quot;chunk-1297af8788c2be7a2a158412cd2652f3-e-1&quot;, &quot;chunk-3b4422ce09cd66eaf6abd58690d6f8ef-e-8&quot;, &quot;chunk-44260d4b7de8c9a00040496e0aad271b-e-15&quot;, &quot;chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-5&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="10" />
        </attvalues>
      </node>
      <node id="chunk-3029d23645f5b8329b94fe4d5e582d6f-e-5" label="Polycrystalline nickel">
        <attvalues>
          <attvalue for="0" value="Polycrystalline nickel" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="多晶镍是一种由大量取向各异的镍晶粒构成的金属材料。它常作为研究高温蠕变等力学行为的基础材料，其性能（如强度和抗蠕变性）可通过添加合金元素进行调控与改善。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3029d23645f5b8329b94fe4d5e582d6f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3029d23645f5b8329b94fe4d5e582d6f-e-6" label="Atomic size misfit">
        <attvalues>
          <attvalue for="0" value="Atomic size misfit" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="原子尺寸错配 (Atomic size misfit) 是材料科学中的一个属性，指在固溶体（合金）中，溶质原子与溶剂原子半径的差异。该差异会引起晶格畸变，阻碍位错运动，是决定固溶强化效应强弱的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-3029d23645f5b8329b94fe4d5e582d6f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-3029d23645f5b8329b94fe4d5e582d6f-e-7" label="Solute">
        <attvalues>
          <attvalue for="0" value="Solute" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="在合金等固溶体中，指被溶剂（基体）溶解或含量较少的组分。其原子尺寸与溶剂原子不同，是造成晶格中原子尺寸错配（misfit）的主要原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-3029d23645f5b8329b94fe4d5e582d6f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3029d23645f5b8329b94fe4d5e582d6f-e-7&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3029d23645f5b8329b94fe4d5e582d6f-e-8" label="Solvent">
        <attvalues>
          <attvalue for="0" value="Solvent" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="在固溶体合金中，构成基体晶格且含量占优的主体组分。其原子尺寸与溶质原子的差异，是导致原子尺寸错配（misfit）并引起晶格畸变的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-3029d23645f5b8329b94fe4d5e582d6f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3029d23645f5b8329b94fe4d5e582d6f-e-8&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3029d23645f5b8329b94fe4d5e582d6f-e-9" label="'Class I' behaviour">
        <attvalues>
          <attvalue for="0" value="'Class I' behaviour" />
          <attvalue for="1" value="Behavior" />
          <attvalue for="2" value="一种蠕变行为，其主要机制是位错的线性粘性运动，宏观上表现出蠕变速率对应力存在特定的幂律依赖关系。" />
          <attvalue for="3" value="{&quot;power-law_stress_dependence&quot;: &quot;three&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-3029d23645f5b8329b94fe4d5e582d6f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3029d23645f5b8329b94fe4d5e582d6f-e-9&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3029d23645f5b8329b94fe4d5e582d6f-e-10" label="Dislocations">
        <attvalues>
          <attvalue for="0" value="Dislocations" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="位错（Dislocations）是一种线状晶体缺陷。其在晶体中的运动及与γ'粒子等强化相的相互作用，是决定材料强度与塑性的关键机制。该相互作用的模式与γ'粒子的尺寸、间距和晶格错配度（如2r/λ比率差异所反映的）密切相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-3029d23645f5b8329b94fe4d5e582d6f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;dislocations&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3029d23645f5b8329b94fe4d5e582d6f-e-10&quot;, &quot;chunk-26ae1c8b32c505920e532d6304655e87-e-3&quot;, &quot;chunk-44a9440aa3e5fad0c388f77698c519bf-e-7&quot;, &quot;chunk-003c7763c31b55c8a5748939ac729c6a-e-2&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-3029d23645f5b8329b94fe4d5e582d6f-e-11" label="'Class II' behaviour">
        <attvalues>
          <attvalue for="0" value="'Class II' behaviour" />
          <attvalue for="1" value="Behavior" />
          <attvalue for="2" value="一种以位错攀移为速率控制步骤的蠕变行为，常见于纯金属和部分金属基固溶体。其应力指数n值通常接近5，与以位错滑移为主要机制的Class I行为相区别。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-3029d23645f5b8329b94fe4d5e582d6f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Class II behaviour&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3029d23645f5b8329b94fe4d5e582d6f-e-11&quot;, &quot;chunk-1cfc07c1de96187a9aff83a89de841ed-e-1&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1cfc07c1de96187a9aff83a89de841ed-e-5" label="Creep life">
        <attvalues>
          <attvalue for="0" value="Creep life" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="蠕变寿命(Creep life)指材料在高温和恒定应力作用下，发生蠕变直至断裂所能持续的时间。它是一项关键的高温力学性能指标，其长短主要受材料微观结构（如γ'相分数、晶粒尺寸）的显著影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1cfc07c1de96187a9aff83a89de841ed" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1cfc07c1de96187a9aff83a89de841ed-e-5&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1cfc07c1de96187a9aff83a89de841ed-e-7" label="Creep damage">
        <attvalues>
          <attvalue for="0" value="Creep damage" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="蠕变损伤(creep damage)是一种材料在高温应力下发生的损伤现象。在多晶镍基合金中，其主要形式为沿晶界发生的蠕变孔洞。该损伤受晶粒尺寸影响，因此单晶高温合金通过消除晶界来有效抑制此现象的发生。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-1cfc07c1de96187a9aff83a89de841ed" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;creep damage&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1cfc07c1de96187a9aff83a89de841ed-e-7&quot;, &quot;chunk-234c3eebb3d42a0daf6e298133c20255-e-1&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-1cfc07c1de96187a9aff83a89de841ed-e-8" label="Polycrystalline nickel alloys">
        <attvalues>
          <attvalue for="0" value="Polycrystalline nickel alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="多晶镍基合金是一种由多个晶粒组成的镍基合金，通常作为高温合金使用。在高温和持续应力作用下，蠕变（材料缓慢的塑性变形）是其主要的损伤和失效形式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-1cfc07c1de96187a9aff83a89de841ed" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-234c3eebb3d42a0daf6e298133c20255-e-2" label="polycrystalline nickel alloys">
        <attvalues>
          <attvalue for="0" value="polycrystalline nickel alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="多晶镍基合金是一种由多个晶粒组成的镍基金属材料。其在高温和应力作用下的主要失效机制为蠕变损伤，具体表现为晶界处发生蠕变孔洞的形核与长大，最终导致材料断裂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-234c3eebb3d42a0daf6e298133c20255" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-234c3eebb3d42a0daf6e298133c20255-e-3" label="creep cavitation">
        <attvalues>
          <attvalue for="0" value="creep cavitation" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="**蠕变空化 (Creep Cavitation)**：一种材料损伤机制，指在持续应力作用下，材料内部（尤其在孔隙处）形成、长大并合并空洞。此过程通常局限于断裂面附近，是导致材料发生最终蠕变断裂的主要原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-234c3eebb3d42a0daf6e298133c20255" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Creep cavitation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-234c3eebb3d42a0daf6e298133c20255-e-3&quot;, &quot;chunk-023a8b25fea34ca6c8a3ebfc0f239288-e-5&quot;, &quot;chunk-870742dec10263e0078e94a0b6a827aa-e-4&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-234c3eebb3d42a0daf6e298133c20255-e-7" label="Chapter 3">
        <attvalues>
          <attvalue for="0" value="Chapter 3" />
          <attvalue for="1" value="Document Section" />
          <attvalue for="2" value="“Chapter 3”是一个文档章节，其主题为“单晶高温合金”。该章节对这一先进材料的特性、制备、性能或应用等知识进行了系统性的阐述和讨论。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-234c3eebb3d42a0daf6e298133c20255" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a28f8cc76e765a7c0aa9878e6ea3e623-e-2" label="Single-crystal form">
        <attvalues>
          <attvalue for="0" value="Single-crystal form" />
          <attvalue for="1" value="Material State" />
          <attvalue for="2" value="单晶形态指整个固体由单一、连续且无晶界的晶格构成的材料状态。这种结构导致其物理性质（如弹性）具有各向异性，即在不同方向上性能不同。例如，单晶镍因其优异的高温力学性能，被广泛用于制造航空发动机的涡轮叶片等高要求部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a28f8cc76e765a7c0aa9878e6ea3e623" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a28f8cc76e765a7c0aa9878e6ea3e623-e-3" label="Stiffness">
        <attvalues>
          <attvalue for="0" value="Stiffness" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="刚度（Stiffness）是一种衡量材料抵抗弹性变形能力的力学性能。其数值越高，材料在受力时发生的形变越小，且在屈服前产生的弹性应变也越低。该性质对晶体材料可能表现出各向异性，例如在(111)晶向上具有更大的刚度值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a28f8cc76e765a7c0aa9878e6ea3e623" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a28f8cc76e765a7c0aa9878e6ea3e623-e-3&quot;, &quot;chunk-7319e10c21751146ade723f5be6c80d4-e-7&quot;, &quot;chunk-0659b62691281fc5f1e0a0636a9eb57b-e-10&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-a28f8cc76e765a7c0aa9878e6ea3e623-e-5" label="Strain">
        <attvalues>
          <attvalue for="0" value="Strain" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="应变（Strain）是表征材料在外力、温度变化等因素作用下产生相对形变的物理量，定义为物体某方向上尺寸的变化量与其原始尺寸的比值。它直接衡量材料的变形程度，通常是无量纲的。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a28f8cc76e765a7c0aa9878e6ea3e623" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a28f8cc76e765a7c0aa9878e6ea3e623-e-5&quot;, &quot;chunk-561d2449c805db1de389831a67f53313-e-4&quot;, &quot;chunk-c88b048c96dc246f3cddc3e769c47af8-e-6&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a28f8cc76e765a7c0aa9878e6ea3e623-e-6" label="Crystallographic orientation">
        <attvalues>
          <attvalue for="0" value="Crystallographic orientation" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="晶体取向 (Crystallographic Orientations) 是一个描述晶体内部晶格相对于参考坐标系空间姿态的物理概念。由于晶体的各向异性，弹性模量等物理性质会随取向而变化。它通常由方向余弦等数学方法进行定量描述。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a28f8cc76e765a7c0aa9878e6ea3e623" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Crystallographic Orientations&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a28f8cc76e765a7c0aa9878e6ea3e623-e-6&quot;, &quot;chunk-28445053586870da241f4ba6806f06eb-e-2&quot;, &quot;chunk-dbeae8c905eb9660d64dd5fc3e317235-e-7&quot;, &quot;chunk-d3a53a265ee93c6aee58baa1a1638be0-e-8&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-a28f8cc76e765a7c0aa9878e6ea3e623-e-7" label="Loading configuration">
        <attvalues>
          <attvalue for="0" value="Loading configuration" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="在材料测试中，指所施加载荷相对于材料晶体取向的具体方式。作为一个关键测试条件，它直接影响材料的刚度测量结果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a28f8cc76e765a7c0aa9878e6ea3e623" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a28f8cc76e765a7c0aa9878e6ea3e623-e-8" label="Elastic properties">
        <attvalues>
          <attvalue for="0" value="Elastic properties" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="弹性性质是描述材料在外力作用下发生可恢复形变时，其应力与应变之间关系的物理性质。它衡量材料抵抗弹性变形的能力（即刚度），通常由弹性模量、剪切模量和泊松比等参数表征。对于多晶合金等材料，该性质通常表现为各向同性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-a28f8cc76e765a7c0aa9878e6ea3e623" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a28f8cc76e765a7c0aa9878e6ea3e623-e-8&quot;, &quot;chunk-5e30fb63f189d46677273b5c0f9ed52d-e-4&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8001720db94f44ac88b442f606ab7d39-e-2" label="Single-crystal form">
        <attvalues>
          <attvalue for="0" value="Single-crystal form" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="一种材料的微观结构形态，指整个部件由单一取向的晶粒构成，内部不存在晶界。由于消除了晶界这一高温下的薄弱环节，其具有卓越的高温强度、抗蠕变和抗疲劳性能，是制造航空发动机涡轮叶片等关键热端部件的理想结构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-8001720db94f44ac88b442f606ab7d39" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8001720db94f44ac88b442f606ab7d39-e-3" label="Columnar-grained ((100)-textured) form">
        <attvalues>
          <attvalue for="0" value="Columnar-grained ((100)-textured) form" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="一种材料微观结构形态，其晶粒沿特定方向生长呈柱状，并具有(100)晶体学优选取向（织构）。这种结构因消除了垂直于应力轴的晶界，能显著提升材料的高温蠕变抗性和热疲劳寿命，是制造高性能涡轮叶片的关键形式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-8001720db94f44ac88b442f606ab7d39" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8001720db94f44ac88b442f606ab7d39-e-3&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8001720db94f44ac88b442f606ab7d39-e-6" label="y' (gamma prime)">
        <attvalues>
          <attvalue for="0" value="y' (gamma prime)" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="γ′ (gamma prime) 是一种金属间化合物，作为镍基高温合金（如Waspaloy）中的主要强化相。它以有序的L1₂结构析出，能显著提高材料的高温强度。在特定的Waspaloy合金中，其固溶温度为1040 °C。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-8001720db94f44ac88b442f606ab7d39" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8001720db94f44ac88b442f606ab7d39-e-6&quot;, &quot;chunk-3ca811c71b95902808fa11b006721fe2-e-3&quot;, &quot;chunk-0d8b8971d722c099aa85646d423e67e5-e-4&quot;, &quot;chunk-166f31f5769126f6a4cd51ea1a1302a5-e-2&quot;, &quot;chunk-807030ab9eb9ee85e606b0c18c1d17af-e-1&quot;, &quot;chunk-6c1e5f01b68b0193af6f52382cd9e355-e-4&quot;, &quot;chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-7&quot;, &quot;chunk-ece73a04275b10b6ad2874686306213a-e-2&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-8001720db94f44ac88b442f606ab7d39-e-8" label="Stress (σ)">
        <attvalues>
          <attvalue for="0" value="Stress (σ)" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="应力（σ）是描述材料内部作用力的物理量。它是一个二阶张量，其分量（如σ11）反映了物体在不同方向上的受力状态。在弹性形变范围内，应力通过材料的弹性张量（或弹性常数）与应变（e）相关联，并可由后者计算得出。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-8001720db94f44ac88b442f606ab7d39" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Stress&quot;, &quot;Stress (σij)&quot;, &quot;Stresses&quot;, &quot;stress&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a28f8cc76e765a7c0aa9878e6ea3e623-e-4&quot;, &quot;chunk-8001720db94f44ac88b442f606ab7d39-e-8&quot;, &quot;chunk-48fb38bbeb039750896238861423b838-e-1&quot;, &quot;chunk-d6f6eec7dd0b201862043d9dfba0195d-e-5&quot;, &quot;chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-7&quot;, &quot;chunk-708b4323c9399297153036f203acb264-e-6&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-8001720db94f44ac88b442f606ab7d39-e-9" label="Strain (ε)">
        <attvalues>
          <attvalue for="0" value="Strain (ε)" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="应变(€ij)是一个物理量，用于衡量材料在应力(σij)作用下发生的几何形变程度。它是一个无量纲的二阶张量，描述了物体内部各点由于变形而产生的相对位移，分量€11, €22, €33代表沿坐标轴方向的拉伸或压缩。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-8001720db94f44ac88b442f606ab7d39" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Strain (e)&quot;, &quot;Strain (€ij)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8001720db94f44ac88b442f606ab7d39-e-9&quot;, &quot;chunk-48fb38bbeb039750896238861423b838-e-2&quot;, &quot;chunk-d6f6eec7dd0b201862043d9dfba0195d-e-4&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-8001720db94f44ac88b442f606ab7d39-e-10" label="Second-rank tensors">
        <attvalues>
          <attvalue for="0" value="Second-rank tensors" />
          <attvalue for="1" value="Mathematical Concept" />
          <attvalue for="2" value="二阶张量是一种数学概念，是标量和向量在更高维度上的推广。它用于精确描述一个物理量在不同方向上的多个分量，是物理学和工程学中表示应力(σ)和应变(e)的标准数学工具。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-8001720db94f44ac88b442f606ab7d39" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-48fb38bbeb039750896238861423b838-e-3" label="Elasticity Tensor">
        <attvalues>
          <attvalue for="0" value="Elasticity Tensor" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="弹性张量是一个表征材料弹性特性的四阶张量。它描述并建立了材料内部应力（σ）与应变（e）之间的线性关系，构成了广义胡克定律的数学核心，其具体分量决定了材料抵抗弹性变形的能力，即刚度。" />
          <attvalue for="3" value="{&quot;tensor_rank&quot;: &quot;fourth&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-48fb38bbeb039750896238861423b838" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-48fb38bbeb039750896238861423b838-e-4" label="Cubic single crystal">
        <attvalues>
          <attvalue for="0" value="Cubic single crystal" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="立方单晶是一种属于立方晶系的单晶材料。其晶体结构具有三个互相垂直的等长晶轴。由于其晶格的各向异性，其宏观弹性性质可由三个独立的弹性刚度常数（C11, C12, C44）完全确定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-48fb38bbeb039750896238861423b838" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-48fb38bbeb039750896238861423b838-e-4&quot;]}]" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-48fb38bbeb039750896238861423b838-e-5" label="Orthogonal axes (1, 2, 3)">
        <attvalues>
          <attvalue for="0" value="Orthogonal axes (1, 2, 3)" />
          <attvalue for="1" value="Coordinate System" />
          <attvalue for="2" value="一种用于描述立方单晶的正交坐标系。其三个互相垂直的坐标轴（1, 2, 3）分别与晶体学方向[100]、[010]和[001]对齐，用于定义晶体中的空间取向和属性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-48fb38bbeb039750896238861423b838" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-48fb38bbeb039750896238861423b838-e-6" label="Crystallographic directions ([100], [010], [001])">
        <attvalues>
          <attvalue for="0" value="Crystallographic directions ([100], [010], [001])" />
          <attvalue for="1" value="Crystallographic Direction" />
          <attvalue for="2" value="在晶体学中，指代晶格中三个互相正交的坐标轴（晶轴）的基本方向，通常用密勒指数[100]、[010]和[001]来表示。它们共同构成了晶体的基础坐标系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-48fb38bbeb039750896238861423b838" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-954a43f6bb0bc08cefcb62bd390ac3fa-e-1" label="Stress Components (σij)">
        <attvalues>
          <attvalue for="0" value="Stress Components (σij)" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="应力分量(σij)是在连续介质力学中，描述物体内部一点应力状态的二阶张量。它量化了单位面积上相互作用的内力，包含垂直于表面的正应力(i=j)和与表面相切的切应力(i≠j)分量，其与材料形变的关系由本构方程确定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-954a43f6bb0bc08cefcb62bd390ac3fa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Stress Components&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-954a43f6bb0bc08cefcb62bd390ac3fa-e-1&quot;, &quot;chunk-9fdfa272aaae5e3c817cad2953b39e4e-e-2&quot;]}]" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-954a43f6bb0bc08cefcb62bd390ac3fa-e-3" label="Elastic Constants (Cij)">
        <attvalues>
          <attvalue for="0" value="Elastic Constants (Cij)" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="弹性常数（Cij）是一种材料属性，作为广义胡克定律中的系数，用于线性描述材料的应力与应变关系。它是四阶刚度张量的分量，其独立常数的数量由晶体对称性决定，例如立方晶系有3个（C11, C12, C44），而三斜晶系则有21个。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-954a43f6bb0bc08cefcb62bd390ac3fa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Elastic stiffness constants (C11, C12, C44)&quot;, &quot;Elasticity Constants (Cij)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-48fb38bbeb039750896238861423b838-e-7&quot;, &quot;chunk-954a43f6bb0bc08cefcb62bd390ac3fa-e-3&quot;, &quot;chunk-d6f6eec7dd0b201862043d9dfba0195d-e-2&quot;]}]" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-954a43f6bb0bc08cefcb62bd390ac3fa-e-4" label="Constitutive Equations (A1)">
        <attvalues>
          <attvalue for="0" value="Constitutive Equations (A1)" />
          <attvalue for="1" value="Equation Set" />
          <attvalue for="2" value="**本构方程 (A1)**：一组包含六个方程的方程组，用于描述材料的弹性行为。它采用奈氏简约记法 [91]，并利用弹性常数 (Cij) 来定义应力分量 (σij) 与应变分量 (€ij) 之间的线性关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-954a43f6bb0bc08cefcb62bd390ac3fa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-954a43f6bb0bc08cefcb62bd390ac3fa-e-5" label="Cubic Symmetry">
        <attvalues>
          <attvalue for="0" value="Cubic Symmetry" />
          <attvalue for="1" value="Crystal Property" />
          <attvalue for="2" value="立方对称是一种属于立方晶系的晶体对称类型，是晶体结构中对称度最高的类型之一。其高度对称性导致材料的物理性质张量被极大简化，例如，它使得多个独立的弹性常数(Cij)相等，从而简化其矩阵表示。" />
          <attvalue for="3" value="{&quot;independent_constants&quot;: &quot;three&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-954a43f6bb0bc08cefcb62bd390ac3fa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Cubic symmetry&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-954a43f6bb0bc08cefcb62bd390ac3fa-e-5&quot;, &quot;chunk-3ca2e169452aac1fe72512e4665d8d85-e-4&quot;]}]" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-954a43f6bb0bc08cefcb62bd390ac3fa-e-6" label="Reduced Notation of Nye [91]">
        <attvalues>
          <attvalue for="0" value="Reduced Notation of Nye [91]" />
          <attvalue for="1" value="Nomenclature" />
          <attvalue for="2" value="**Reduced Notation**是一种数学约定，用于简化对称四阶张量（如弹性力学中的柔度或刚度张量）的表示。它通过特定的索引缩减规则，将具有四个索引的张量分量（例如 S_ijkl）映射为一个二阶张量（通常为6x6矩阵）的分量（例如 S_mn），从而极大地方便了工程计算与书写。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-954a43f6bb0bc08cefcb62bd390ac3fa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Reduced Notation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-954a43f6bb0bc08cefcb62bd390ac3fa-e-6&quot;, &quot;chunk-28445053586870da241f4ba6806f06eb-e-5&quot;]}]" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-954a43f6bb0bc08cefcb62bd390ac3fa-e-7" label="Triclinic Crystal">
        <attvalues>
          <attvalue for="0" value="Triclinic Crystal" />
          <attvalue for="1" value="Crystal Type" />
          <attvalue for="2" value="三斜晶系是七大晶系中对称性最低的一种。其晶胞特征为三根晶轴长度不等，三个轴间夹角也互不相等且均不为90度。因其对称性极低，描述其物理性质（如弹性）所需的独立常数最多，例如需要21个独立的弹性常数。" />
          <attvalue for="3" value="{&quot;required_constants&quot;: &quot;21&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-954a43f6bb0bc08cefcb62bd390ac3fa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-954a43f6bb0bc08cefcb62bd390ac3fa-e-7&quot;, &quot;chunk-d6f6eec7dd0b201862043d9dfba0195d-e-1&quot;]}]" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d6f6eec7dd0b201862043d9dfba0195d-e-3" label="Compliance Constants (Sij)">
        <attvalues>
          <attvalue for="0" value="Compliance Constants (Sij)" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="**柔度常数 (Sij)**&#10;&#10;一种物理性质，是弹性刚度常数(Cij)的逆矩阵。它描述材料在外加应力作用下产生应变的能力，通过胡克定律的矩阵形式直接将应变张量与应力张量联系起来，被用于计算应变分量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d6f6eec7dd0b201862043d9dfba0195d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-d6f6eec7dd0b201862043d9dfba0195d-e-6" label="€11">
        <attvalues>
          <attvalue for="0" value="€11" />
          <attvalue for="1" value="Strain Component" />
          <attvalue for="2" value="€11 (ε11) 是一个应变张量分量，指材料沿1轴方向的正应变，用于量化该方向单位长度的伸长或缩短。在弹性力学中，该值是描述材料变形状态的关键参数之一，可通过应力与材料的柔度常数(Sij)计算得出。" />
          <attvalue for="3" value="{&quot;defining_equation&quot;: &quot;S11σ11 + S12σ22 + S12σ33&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-d6f6eec7dd0b201862043d9dfba0195d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d6f6eec7dd0b201862043d9dfba0195d-e-7" label="€22">
        <attvalues>
          <attvalue for="0" value="€22" />
          <attvalue for="1" value="Strain Component" />
          <attvalue for="2" value="€22是一个正应变分量，在固体力学中用于描述材料沿“2”轴方向的相对伸长或缩短。它是一个无量纲的物理量，其数值可依据广义胡克定律，通过应力分量及材料的柔度常数(Sij)计算得到。" />
          <attvalue for="3" value="{&quot;defining_equation&quot;: &quot;S12σ11 + S11σ22 + S12σ33&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d6f6eec7dd0b201862043d9dfba0195d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d6f6eec7dd0b201862043d9dfba0195d-e-8" label="€33">
        <attvalues>
          <attvalue for="0" value="€33" />
          <attvalue for="1" value="Strain Component" />
          <attvalue for="2" value="**ε33**：固体力学中的一个正应变分量，表示材料沿“3”方向单位长度的伸长或缩短。它是描述物体变形的应变张量的组成部分，其数值可通过应力分量与材料的柔度常数（Sij）计算得到。" />
          <attvalue for="3" value="{&quot;defining_equation&quot;: &quot;S12σ11 + S12σ22 + S11σ33&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-d6f6eec7dd0b201862043d9dfba0195d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9fdfa272aaae5e3c817cad2953b39e4e-e-1" label="Strain Components">
        <attvalues>
          <attvalue for="0" value="Strain Components" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="应变分量(€ij)是定量描述材料内部某点变形程度的物理量，为二阶应变张量的组成部分。它包含描述长度变化的法向应变(如€11)和描述角度畸变的剪切应变(如€12)，是连接材料应力与变形的本构方程中的基本变量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-9fdfa272aaae5e3c817cad2953b39e4e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Strain Components (€ij)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-954a43f6bb0bc08cefcb62bd390ac3fa-e-2&quot;, &quot;chunk-9fdfa272aaae5e3c817cad2953b39e4e-e-1&quot;]}]" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-9fdfa272aaae5e3c817cad2953b39e4e-e-3" label="Compliance Constants">
        <attvalues>
          <attvalue for="0" value="Compliance Constants" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="柔量常数 (Compliance Constants) 是一组材料属性，用于定义应变与应力之间的线性关系。它们是柔量矩阵（通常用Sij表示）的分量，该矩阵与刚度矩阵互为逆矩阵，因此其数值可通过刚度常数计算得出。它决定了材料在特定应力作用下产生的应变分量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-9fdfa272aaae5e3c817cad2953b39e4e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Elastic Compliance Constants&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9fdfa272aaae5e3c817cad2953b39e4e-e-3&quot;, &quot;chunk-9b96433e844031d4f15964cb1b24320d-e-2&quot;]}]" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-9fdfa272aaae5e3c817cad2953b39e4e-e-4" label="Stiffness Constants">
        <attvalues>
          <attvalue for="0" value="Stiffness Constants" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="刚度常数（Stiffness Constants）是一组表征材料抵抗弹性变形能力的物理量，也称弹性常数。它们在广义胡克定律中作为比例系数，描述了材料内部应力与应变之间的线性关系。其张量形式（如C11, C12）在数值上是柔度常数的逆矩阵。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-9fdfa272aaae5e3c817cad2953b39e4e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9fdfa272aaae5e3c817cad2953b39e4e-e-4&quot;]}]" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7319e10c21751146ade723f5be6c80d4-e-1" label="Nickel single crystals">
        <attvalues>
          <attvalue for="0" value="Nickel single crystals" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍单晶是由纯镍构成的单晶体，其内部原子在整个晶体范围内呈高度有序的周期性排列。因其结构完整、无晶界干扰，是用于精确测量弹性常数等金属本征物理与力学性能的理想模型材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-7319e10c21751146ade723f5be6c80d4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7319e10c21751146ade723f5be6c80d4-e-6" label="Room temperature">
        <attvalues>
          <attvalue for="0" value="Room temperature" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="室温（Room temperature）指人类在室内感觉舒适的温度范围。在科学和工程领域，它常被用作实验和测量的标准条件，通常定义为20°C至25°C（约293K至298K）的区间。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-7319e10c21751146ade723f5be6c80d4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7319e10c21751146ade723f5be6c80d4-e-8" label="(100) crystallographic direction">
        <attvalues>
          <attvalue for="0" value="(100) crystallographic direction" />
          <attvalue for="1" value="Crystallographic Direction" />
          <attvalue for="2" value="(100)晶向是晶体学中由密勒指数定义的特定方向族。它代表晶体中一组等效的原子排列方向，常用于表征材料沿此方向的物理性能（如刚度），是分析材料各向异性的重要基准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-7319e10c21751146ade723f5be6c80d4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7319e10c21751146ade723f5be6c80d4-e-8&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7319e10c21751146ade723f5be6c80d4-e-9" label="C11">
        <attvalues>
          <attvalue for="0" value="C11" />
          <attvalue for="1" value="Elastic Stiffness Constant" />
          <attvalue for="2" value="C11是一个弹性刚度常数，为弹性刚度张量的主要分量。它量化了材料沿一个主轴方向抵抗拉伸或压缩变形的刚度，其数值是定义材料柔度常数（如S12）的关键参数之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-7319e10c21751146ade723f5be6c80d4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7319e10c21751146ade723f5be6c80d4-e-10" label="C12">
        <attvalues>
          <attvalue for="0" value="C12" />
          <attvalue for="1" value="Elastic Stiffness Constant" />
          <attvalue for="2" value="C12是一种弹性刚度常数，为材料刚度矩阵[C]的非对角项。它依据广义胡克定律，表征一个方向的正应力与另一垂直方向正应变间的耦合效应，是计算逆矩阵——柔度矩阵中对应分量（如S12）的基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-7319e10c21751146ade723f5be6c80d4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7319e10c21751146ade723f5be6c80d4-e-11" label="C44">
        <attvalues>
          <attvalue for="0" value="C44" />
          <attvalue for="1" value="Elastic Stiffness Constant" />
          <attvalue for="2" value="C44是一个弹性刚度常数，其值为柔度常数S44的倒数。它用于描述材料在特定剪切应力作用下的刚度，与柔度互为逆运算。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-7319e10c21751146ade723f5be6c80d4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7319e10c21751146ade723f5be6c80d4-e-11&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-acebf0b59de1a04e5bd5c03c23e7d583-e-1" label="E(100)">
        <attvalues>
          <attvalue for="0" value="E(100)" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="E(100)指单晶材料沿[100]晶向的弹性模量（杨氏模量），是衡量材料在该方向抵抗弹性形变能力的物理量。它表征了材料在该特定方向的刚度，其值为柔量常数S11的倒数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-acebf0b59de1a04e5bd5c03c23e7d583" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-acebf0b59de1a04e5bd5c03c23e7d583-e-4" label="Polycrystalline Nickel">
        <attvalues>
          <attvalue for="0" value="Polycrystalline Nickel" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="多晶镍是一种由大量随机取向的晶粒构成的镍材料。它在宏观上表现为各向同性，其整体刚度高于纯镍单晶在&lt;100&gt;晶向上的弹性模量(E(100))。" />
          <attvalue for="3" value="{&quot;expected_property&quot;: &quot;isotropic&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-acebf0b59de1a04e5bd5c03c23e7d583" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5d285668cb116d3577030c45282de28e-e-1" label="Polycrystalline nickel">
        <attvalues>
          <attvalue for="0" value="Polycrystalline nickel" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="多晶镍(Polycrystalline nickel)是一种由大量取向随机的微小晶粒构成的金属镍材料。这种结构使其宏观上表现为各向同性，即物理性质在所有方向上均一。其弹性模量约为207 GPa，该数值高于单晶镍在(100)晶向上的弹性模量。" />
          <attvalue for="3" value="{&quot;elastic modulus&quot;: &quot;207 GPa&quot;, &quot;property&quot;: &quot;isotropic&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-5d285668cb116d3577030c45282de28e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5d285668cb116d3577030c45282de28e-e-2" label="(100) direction">
        <attvalues>
          <attvalue for="0" value="(100) direction" />
          <attvalue for="1" value="Crystallographic Orientation" />
          <attvalue for="2" value="晶体学方向[100]，在纯镍晶体中，该方向的弹性模量最小，是刚度最低的原子排列方向。相较于[111]等其他晶向，其在外力作用下更容易发生弹性形变。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-5d285668cb116d3577030c45282de28e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5d285668cb116d3577030c45282de28e-e-2&quot;, &quot;chunk-d4ec865719f1815d38483ef812cf9ed2-e-2&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-5d285668cb116d3577030c45282de28e-e-4" label="Cubic metals">
        <attvalues>
          <attvalue for="0" value="Cubic metals" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="立方晶系金属（Cubic metals）是一类具有立方晶体结构的金属材料。其一个显著的各向异性特征是，在不同晶体学方向上刚度不同，而[100]方向通常是其刚度最低的方向。常见的镍（Nickel）即属于此类金属。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-5d285668cb116d3577030c45282de28e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5d285668cb116d3577030c45282de28e-e-4&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-28445053586870da241f4ba6806f06eb-e-1" label="Elastic Modulus">
        <attvalues>
          <attvalue for="0" value="Elastic Modulus" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="弹性模量是衡量材料刚度的物理量，表征其抵抗弹性变形的能力。在晶体材料中，它具有方向依赖性（各向异性），其值取决于特定的晶体学方向，如(001)和(111)。该属性通常与材料的疲劳强度等力学性能密切相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-28445053586870da241f4ba6806f06eb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-28445053586870da241f4ba6806f06eb-e-1&quot;, &quot;chunk-18e706cf8ca843db25be30e8eb057f20-e-2&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-28445053586870da241f4ba6806f06eb-e-3" label="Direction Cosines">
        <attvalues>
          <attvalue for="0" value="Direction Cosines" />
          <attvalue for="1" value="Mathematical Parameter" />
          <attvalue for="2" value="方向余弦 (Direction Cosines) 是一组数学参数，由特定方向向量与晶体坐标系各轴夹角的余弦值构成。它用于唯一定义晶体学取向，是计算材料沿该方向的各向异性物理性能（如弹性常数S'11）的基础。" />
          <attvalue for="3" value="{&quot;components&quot;: &quot;l1, l2, l3&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-28445053586870da241f4ba6806f06eb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-28445053586870da241f4ba6806f06eb-e-4" label="S (Compliance Tensor)">
        <attvalues>
          <attvalue for="0" value="S (Compliance Tensor)" />
          <attvalue for="1" value="Tensor" />
          <attvalue for="2" value="柔度张量 (S) 是弹性力学中一个四阶张量，遵循广义胡克定律，用于描述材料的柔顺性或弹性响应。它建立了应变张量与应力张量之间的线性关系，其各个分量构成了柔度矩阵，该矩阵是刚度张量的逆。" />
          <attvalue for="3" value="{&quot;rank&quot;: &quot;fourth-rank&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-28445053586870da241f4ba6806f06eb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Compliance Tensor Components&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-28445053586870da241f4ba6806f06eb-e-4&quot;, &quot;chunk-28445053586870da241f4ba6806f06eb-e-7&quot;]}]" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-28445053586870da241f4ba6806f06eb-e-6" label="S'11">
        <attvalues>
          <attvalue for="0" value="S'11" />
          <attvalue for="1" value="Tensor Component" />
          <attvalue for="2" value="S'11是一个变换后的柔度张量分量，表示在特定晶体学取向上材料的弹性柔度。其值是基于方向余弦对原始柔度张量进行坐标变换计算得出的，下标“11”遵循简化记法（Reduced Notation）约定。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;S'11 = [l1^4S11 + 2l1^2l2^2S12 + 2l1^2l3^2S13 + 2l1^2l2l3S14 + 2l1^3l3S15 + 2l1^3l2S16 + l2^4S22 + 2l2^2l3^&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-28445053586870da241f4ba6806f06eb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-28445053586870da241f4ba6806f06eb-e-6&quot;, &quot;chunk-04d8e878969e6a9500600ef092423800-e-7&quot;, &quot;chunk-9b96433e844031d4f15964cb1b24320d-e-1&quot;]}]" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-22ef75b1c4655668db62d8db90f9c1bb-e-1" label="(A5a)">
        <attvalues>
          <attvalue for="0" value="(A5a)" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="方程(A5a)是一个用于描述单斜晶体一般情况的数学公式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-22ef75b1c4655668db62d8db90f9c1bb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="161" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-22ef75b1c4655668db62d8db90f9c1bb-e-2" label="Monoclinic crystal">
        <attvalues>
          <attvalue for="0" value="Monoclinic crystal" />
          <attvalue for="1" value="Crystal System" />
          <attvalue for="2" value="单斜晶系是七大晶系之一。其晶体具有三个不等长的晶轴（a≠b≠c），其中两个晶轴的夹角为90°，而第三个夹角不为90°（即α=γ=90°, β≠90°）。这种不对称性是其区别于正交晶系和三斜晶系的关键特征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-22ef75b1c4655668db62d8db90f9c1bb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="161" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-22ef75b1c4655668db62d8db90f9c1bb-e-3" label="S">
        <attvalues>
          <attvalue for="0" value="S" />
          <attvalue for="1" value="Symmetry Tensor" />
          <attvalue for="2" value="一个记作S的对称张量。其固有的对称性是导致在方程(A5a)的表达式中出现多个因子“2”的直接原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-22ef75b1c4655668db62d8db90f9c1bb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="162" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-22ef75b1c4655668db62d8db90f9c1bb-e-7" label="S22">
        <attvalues>
          <attvalue for="0" value="S22" />
          <attvalue for="1" value="Tensor Component" />
          <attvalue for="2" value="S22是S张量的一个分量，在材料科学中通常指弹性柔度张量。在立方晶系这种高对称性结构中，它描述材料沿某一主轴的力学响应，其数值与另外两个主对角分量S11和S33相等。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-22ef75b1c4655668db62d8db90f9c1bb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-22ef75b1c4655668db62d8db90f9c1bb-e-8" label="S33">
        <attvalues>
          <attvalue for="0" value="S33" />
          <attvalue for="1" value="Tensor Component" />
          <attvalue for="2" value="S33是张量S的一个对角分量，常指材料的弹性柔量。在立方晶体中，由于其结构对称性，该分量与S11、S22的数值相等，共同表征材料的弹性性质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-22ef75b1c4655668db62d8db90f9c1bb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-22ef75b1c4655668db62d8db90f9c1bb-e-9" label="2's">
        <attvalues>
          <attvalue for="0" value="2's" />
          <attvalue for="1" value="Coefficient" />
          <attvalue for="2" value="指方程(A5a)中的数值系数，因S的对称性而出现，其值为2。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-22ef75b1c4655668db62d8db90f9c1bb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="162" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-04d8e878969e6a9500600ef092423800-e-1" label="S">
        <attvalues>
          <attvalue for="0" value="S" />
          <attvalue for="1" value="Compliance Matrix" />
          <attvalue for="2" value="柔量矩阵 (S) 是一个对称的二阶张量，用于描述晶体材料中应力与应变的线性关系，是劲度矩阵的逆矩阵。作为表征材料弹性性质的重要物理参数，它是立方晶系等各类晶体所具有的一种固有属性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-04d8e878969e6a9500600ef092423800" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-04d8e878969e6a9500600ef092423800-e-2" label="Cubic crystal">
        <attvalues>
          <attvalue for="0" value="Cubic crystal" />
          <attvalue for="1" value="Crystal Structure" />
          <attvalue for="2" value="立方晶体是一种高度对称的晶体结构。其对称性导致材料的柔顺常数（S）满足特定相等关系（S11=S22=S33，S44=S55=S66，S12=S13=S23），在各主轴方向的弹性相同。金属镍（Ni）是其典型例子。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-04d8e878969e6a9500600ef092423800" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-04d8e878969e6a9500600ef092423800-e-2&quot;, &quot;chunk-22ef75b1c4655668db62d8db90f9c1bb-e-4&quot;]}]" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-04d8e878969e6a9500600ef092423800-e-4" label="S11, S22, S33">
        <attvalues>
          <attvalue for="0" value="S11, S22, S33" />
          <attvalue for="1" value="Compliance Constants" />
          <attvalue for="2" value="S11, S22, S33是一组柔量常数。在立方晶体中，由于其高度对称性，这三个沿主轴方向的分量彼此相等 (S11=S22=S33)。它们描述了法向应力与同向法向应变之间的线性关系，是表征该类晶体材料弹性行为的关键参数，常用于相关力学计算（如方程A5b）中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-04d8e878969e6a9500600ef092423800" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-04d8e878969e6a9500600ef092423800-e-4&quot;]}]" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-04d8e878969e6a9500600ef092423800-e-5" label="S44, S55, S66">
        <attvalues>
          <attvalue for="0" value="S44, S55, S66" />
          <attvalue for="1" value="Compliance Constants" />
          <attvalue for="2" value="S44、S55、S66是材料的柔量常数，用于描述材料的弹性响应。在立方晶体这种对称结构中，这三个描述剪切形变的柔量分量彼此相等（S44=S55=S66）。这一特性是立方晶体的关键特征之一，并被用于相关物理方程（如方程A5b）的简化和求解。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-04d8e878969e6a9500600ef092423800" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-04d8e878969e6a9500600ef092423800-e-6" label="S12, S13, S23">
        <attvalues>
          <attvalue for="0" value="S12, S13, S23" />
          <attvalue for="1" value="Compliance Constants" />
          <attvalue for="2" value="一组柔量常数(Compliance Constants)，用于描述材料的弹性行为。在立方晶体中，由于其结构的高度对称性，这三个分别表征不同轴向应力与应变关系的常数彼此相等，即 S12 = S13 = S23。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-04d8e878969e6a9500600ef092423800" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-04d8e878969e6a9500600ef092423800-e-6&quot;]}]" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-04d8e878969e6a9500600ef092423800-e-8" label="l1, l2, l3">
        <attvalues>
          <attvalue for="0" value="l1, l2, l3" />
          <attvalue for="1" value="Direction Cosines" />
          <attvalue for="2" value="一组方向余弦，代表一个新坐标轴与原笛卡尔坐标系x、y、z三轴夹角的余弦值，用以确定该轴的空间指向。在张量变换理论中，它们是计算新坐标系下物理量（如应力分量S'11）的关键参数，如在方程(A5b)所示。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-04d8e878969e6a9500600ef092423800" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-04d8e878969e6a9500600ef092423800-e-9" label="Equation (A5b)">
        <attvalues>
          <attvalue for="0" value="Equation (A5b)" />
          <attvalue for="1" value="Mathematical Equation" />
          <attvalue for="2" value="数学方程式(A5b)是一个用于计算转换后柔度常数S'11的表达式。它将材料在原始坐标系下的柔度常数（如S11, S12等）与描述新坐标轴方向的方向余弦（l1, l2, l3）相结合，从而确定新坐标系下S'11的值。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;S'11 = S11(l1^4 + l2^4 + l3^4) + 2S12(l1^2l2^2 + l1^2l3^2 + l2^2l3^2) + S44(l2^2l3^2 + l1^2l3^2 + l1^2l2^2)&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-04d8e878969e6a9500600ef092423800" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-04d8e878969e6a9500600ef092423800-e-10" label="Mathematical Identities">
        <attvalues>
          <attvalue for="0" value="Mathematical Identities" />
          <attvalue for="1" value="Mathematical Concept" />
          <attvalue for="2" value="一组涉及方向余弦的数学恒等式，在材料力学等领域中，用于简化柔度常数在坐标系转换过程中的推导与计算。" />
          <attvalue for="3" value="{&quot;identity_1&quot;: &quot;l1^2 + l2^2 + l3^2 = 1&quot;, &quot;identity_2&quot;: &quot;l1^4 + l2^4 + l3^4 = 1 - 2(l1^2l2^2 + l1^2l3^2 + l2^2l3^2)&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-04d8e878969e6a9500600ef092423800" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9b96433e844031d4f15964cb1b24320d-e-3" label="[l1^2l2^2 + l2^2l3^2 + l3^2l1^2]">
        <attvalues>
          <attvalue for="0" value="[l1^2l2^2 + l2^2l3^2 + l3^2l1^2]" />
          <attvalue for="1" value="Mathematical Term" />
          <attvalue for="2" value="一个由方向余弦(l1,l2,l3)构成的取向函数，用于量化晶体材料的各向异性程度，决定了物理性质（如弹性）的方向依赖性。该函数沿立方晶轴(&lt;100&gt;)方向为最小值0，沿&lt;111&gt;方向为最大值1/3。" />
          <attvalue for="3" value="{&quot;minimum_value&quot;: &quot;zero&quot;, &quot;maximum_value&quot;: &quot;one-third&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-9b96433e844031d4f15964cb1b24320d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-9b96433e844031d4f15964cb1b24320d-e-4" label="Degree of Anisotropy">
        <attvalues>
          <attvalue for="0" value="Degree of Anisotropy" />
          <attvalue for="1" value="Physical Concept" />
          <attvalue for="2" value="一个量化材料物理性质（如弹性模量）随方向变化程度的物理指标。在晶体材料中，它常通过依赖于方向余弦的各向异性因子来表征。该指标的数值反映了材料性质从完全各向同性状态的偏离程度，数值越大通常意味着方向依赖性越强。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-9b96433e844031d4f15964cb1b24320d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9b96433e844031d4f15964cb1b24320d-e-5" label="Cube Axes">
        <attvalues>
          <attvalue for="0" value="Cube Axes" />
          <attvalue for="1" value="Crystallographic Direction" />
          <attvalue for="2" value="指立方晶系中的&lt;100&gt;晶向族。它是使磁晶各向异性项 `l1²l²²+l²²l³²+l³²l¹²` 达到最小值零的特定方向，因此通常是铁磁性材料的易磁化轴。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-9b96433e844031d4f15964cb1b24320d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9b96433e844031d4f15964cb1b24320d-e-6" label="(111)">
        <attvalues>
          <attvalue for="0" value="(111)" />
          <attvalue for="1" value="Crystallographic Direction" />
          <attvalue for="2" value="一个晶体学方向，在立方晶系中指晶胞的体对角线。它是一个特殊方向，在此方向上，由方向余弦构成的各向异性函数 l₁²l₂² + l₂²l₃² + l₃²l₁² 达到其最大值1/3。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-9b96433e844031d4f15964cb1b24320d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d4ec865719f1815d38483ef812cf9ed2-e-4" label="(110) direction">
        <attvalues>
          <attvalue for="0" value="(110) direction" />
          <attvalue for="1" value="Crystallographic Direction" />
          <attvalue for="2" value="由密勒指数[110]定义的晶体学方向。在立方晶系中，它代表连接晶胞原点和一个面中心的面对角线，是晶体的重要主轴之一。对于多数金属，其物理和力学性质（如杨氏模量）的数值介于[100]和[111]方向之间。" />
          <attvalue for="3" value="{&quot;Young's Modulus&quot;: &quot;220 GPa&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d4ec865719f1815d38483ef812cf9ed2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d4ec865719f1815d38483ef812cf9ed2-e-4&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7468b5a535de86347797d4977b885a9e-e-2" label="Anisotropy">
        <attvalues>
          <attvalue for="0" value="Anisotropy" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="各向异性（Anisotropy）是一种材料属性，指材料的物理或力学性能（如刚度、电导率）会因方向不同而呈现差异。这种特性在具有规则原子排列的晶体材料中尤为显著，例如单晶高温合金和纯镍。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-7468b5a535de86347797d4977b885a9e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7468b5a535de86347797d4977b885a9e-e-2&quot;, &quot;chunk-d3a53a265ee93c6aee58baa1a1638be0-e-6&quot;, &quot;chunk-d4ec865719f1815d38483ef812cf9ed2-e-6&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7468b5a535de86347797d4977b885a9e-e-3" label="Resistance to shearing">
        <attvalues>
          <attvalue for="0" value="Resistance to shearing" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="抗剪切是一种衡量材料抵抗剪切力作用的力学性能。该性能主要由柔度系数S44的大小所决定。由于其数值在23平面内会随角度而变化，因此它是一种具有方向依赖性（各向异性）的属性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-7468b5a535de86347797d4977b885a9e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7468b5a535de86347797d4977b885a9e-e-4" label="23 plane">
        <attvalues>
          <attvalue for="0" value="23 plane" />
          <attvalue for="1" value="Crystallographic Plane" />
          <attvalue for="2" value="一个晶体学平面，其法线方向与(100)凝固方向一致。材料在该平面上的抗剪切能力是一个随方向变化的重要物理特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-7468b5a535de86347797d4977b885a9e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7468b5a535de86347797d4977b885a9e-e-5" label="Solidification direction (100)">
        <attvalues>
          <attvalue for="0" value="Solidification direction (100)" />
          <attvalue for="1" value="Crystallographic Direction" />
          <attvalue for="2" value="一个由密勒指数[100]定义的晶体学方向。在立方晶系中，该方向平行于晶格的一个主轴（如x轴），并垂直于(100)晶面。它特指在材料凝固过程中，晶体沿此方向进行的优先生长。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-7468b5a535de86347797d4977b885a9e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7468b5a535de86347797d4977b885a9e-e-6" label="S44">
        <attvalues>
          <attvalue for="0" value="S44" />
          <attvalue for="1" value="Compliance Constant" />
          <attvalue for="2" value="S44是一个柔度常数，为材料柔度矩阵的一个分量，用于表征各向异性材料的力学性能。它根据广义胡克定律，在Voigt标记法中定义了yz平面上的剪切应变与相应剪切应力之间的线性比例关系，是衡量材料抗剪切变形能力的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-7468b5a535de86347797d4977b885a9e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7468b5a535de86347797d4977b885a9e-e-6&quot;, &quot;chunk-488553ca8f86a8be784d625006ec53f4-e-2&quot;, &quot;chunk-f8de8bf5059ef35e8409c085b9ffdb42-e-3&quot;, &quot;chunk-db41dbaa9105de2b903a433936c3b590-e-2&quot;, &quot;chunk-7319e10c21751146ade723f5be6c80d4-e-5&quot;, &quot;chunk-59efde3cc28eec2ad611a5941651c5d8-e-6&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="10" />
        </attvalues>
      </node>
      <node id="chunk-7468b5a535de86347797d4977b885a9e-e-7" label="Elasticity equations">
        <attvalues>
          <attvalue for="0" value="Elasticity equations" />
          <attvalue for="1" value="Physical Law/Model" />
          <attvalue for="2" value="弹性方程是一组描述弹性材料在受外力时如何形变的偏微分方程。它基于胡克定律，通过建立材料内部的应力、应变和位移之间的数学关系，用于预测和分析物体的力学行为与结构响应。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-7468b5a535de86347797d4977b885a9e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7468b5a535de86347797d4977b885a9e-e-8" label="S'44">
        <attvalues>
          <attvalue for="0" value="S'44" />
          <attvalue for="1" value="Elasticity Constant" />
          <attvalue for="2" value="S'44是材料力学中的一个柔量常数，其数值为剪切模量G的倒数（S'44 = 1/G）。它衡量材料在剪切应力作用下产生剪切变形的程度。该表示常用于描述特定坐标方向（如旋转π/4或45°）上的剪切特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-7468b5a535de86347797d4977b885a9e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7468b5a535de86347797d4977b885a9e-e-8&quot;, &quot;chunk-488553ca8f86a8be784d625006ec53f4-e-1&quot;, &quot;chunk-f8de8bf5059ef35e8409c085b9ffdb42-e-5&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-488553ca8f86a8be784d625006ec53f4-e-3" label="θ">
        <attvalues>
          <attvalue for="0" value="θ" />
          <attvalue for="1" value="Angle" />
          <attvalue for="2" value="θ (Theta) 是一个任意旋转角，用于在坐标变换中将分量 S44 转换为 S'44。该角度是方程 A7 的一个关键输入参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-488553ca8f86a8be784d625006ec53f4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-488553ca8f86a8be784d625006ec53f4-e-4" label="Equation A7">
        <attvalues>
          <attvalue for="0" value="Equation A7" />
          <attvalue for="1" value="Mathematical Formula" />
          <attvalue for="2" value="一个用于定义 S'44 的数学公式。它描述了如何基于输入参数 S44、S11、S12 及角度 θ，来计算从 S44 到 S'44 的变换。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;S'44 = S44 + (2S11 - 2S12 - S44) × 4 sin²θ cos²θ&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-488553ca8f86a8be784d625006ec53f4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-488553ca8f86a8be784d625006ec53f4-e-5" label="S11">
        <attvalues>
          <attvalue for="0" value="S11" />
          <attvalue for="1" value="Compliance Constant" />
          <attvalue for="2" value="S11是S张量的一个分量，在材料科学中通常指弹性柔度张量的主分量。它描述材料对特定方向应力的应变响应。在立方晶体中，由于其高度对称性，S11在数值上等于S22和S33，表明材料在三个主轴方向上具有相同的弹性性质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-488553ca8f86a8be784d625006ec53f4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-488553ca8f86a8be784d625006ec53f4-e-5&quot;, &quot;chunk-db41dbaa9105de2b903a433936c3b590-e-3&quot;, &quot;chunk-7319e10c21751146ade723f5be6c80d4-e-3&quot;, &quot;chunk-59efde3cc28eec2ad611a5941651c5d8-e-4&quot;, &quot;chunk-acebf0b59de1a04e5bd5c03c23e7d583-e-2&quot;, &quot;chunk-22ef75b1c4655668db62d8db90f9c1bb-e-6&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-488553ca8f86a8be784d625006ec53f4-e-6" label="S12">
        <attvalues>
          <attvalue for="0" value="S12" />
          <attvalue for="1" value="Compliance Constant" />
          <attvalue for="2" value="S12是一个柔量常数，为材料弹性柔量矩阵的分量。它量化了材料在一个方向受正应力时，在垂直方向产生的应变（即横向变形效应），是描述材料各向异性弹性的关键参数，其数值与泊松比和弹性模量密切相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-488553ca8f86a8be784d625006ec53f4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-488553ca8f86a8be784d625006ec53f4-e-6&quot;, &quot;chunk-db41dbaa9105de2b903a433936c3b590-e-4&quot;, &quot;chunk-7319e10c21751146ade723f5be6c80d4-e-4&quot;, &quot;chunk-59efde3cc28eec2ad611a5941651c5d8-e-5&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-f8de8bf5059ef35e8409c085b9ffdb42-e-2" label="θ">
        <attvalues>
          <attvalue for="0" value="θ" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="参数θ是一个角度，作为关键变量用于定义物理系统中的载荷施加方式。它精确描述了力的方向、作用点位置或其他与受力相关的几何配置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-f8de8bf5059ef35e8409c085b9ffdb42" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="274" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-f8de8bf5059ef35e8409c085b9ffdb42-e-4" label="119 GPa">
        <attvalues>
          <attvalue for="0" value="119 GPa" />
          <attvalue for="1" value="Value" />
          <attvalue for="2" value="一个表示剪切模量 (G) 的物理量值。在特定条件 (角度θ为0) 下，该模量的近似值为119吉帕斯卡 (GPa)。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;119&quot;, &quot;unit&quot;: &quot;GPa&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f8de8bf5059ef35e8409c085b9ffdb42" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f8de8bf5059ef35e8409c085b9ffdb42-e-4&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f8de8bf5059ef35e8409c085b9ffdb42-e-6" label="26 GPa">
        <attvalues>
          <attvalue for="0" value="26 GPa" />
          <attvalue for="1" value="Value" />
          <attvalue for="2" value="26 GPa（吉帕斯卡）是一个表示剪切模量（G）的近似值。该数值是在特定条件（角度θ = π/4）下测得或计算得出的。剪切模量是衡量材料抵抗剪切变形能力的物理指标，这个数值具体反映了该材料在特定方向上的刚度。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;26&quot;, &quot;unit&quot;: &quot;GPa&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-f8de8bf5059ef35e8409c085b9ffdb42" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f8de8bf5059ef35e8409c085b9ffdb42-e-6&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f8de8bf5059ef35e8409c085b9ffdb42-e-7" label="Isotropic, polycrystalline nickel">
        <attvalues>
          <attvalue for="0" value="Isotropic, polycrystalline nickel" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="各向同性多晶镍是一种由大量随机取向的晶粒构成的金属镍材料。这种微观结构使其宏观力学性能（如剪切模量）在所有方向上均保持一致，表现出各向同性特征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-f8de8bf5059ef35e8409c085b9ffdb42" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f8de8bf5059ef35e8409c085b9ffdb42-e-8" label="82 GPa">
        <attvalues>
          <attvalue for="0" value="82 GPa" />
          <attvalue for="1" value="Value" />
          <attvalue for="2" value="一个材料物理学数值，特指各向同性、多晶状态的镍（Nickel）所测得的剪切模量（G）。该物理量用于衡量材料抵抗剪切形变的能力，数值为82吉帕斯卡。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;82&quot;, &quot;unit&quot;: &quot;GPa&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-f8de8bf5059ef35e8409c085b9ffdb42" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f8de8bf5059ef35e8409c085b9ffdb42-e-8&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f8de8bf5059ef35e8409c085b9ffdb42-e-9" label="Numerical average of 119 GPa and 26 GPa">
        <attvalues>
          <attvalue for="0" value="Numerical average of 119 GPa and 26 GPa" />
          <attvalue for="1" value="Calculated Value" />
          <attvalue for="2" value="一个计算值，指在特定角度θ=0和θ=π/4下的剪切模量（119 GPa与26 GPa）的算术平均值，其具体数值为72.5 GPa。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-f8de8bf5059ef35e8409c085b9ffdb42" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f8de8bf5059ef35e8409c085b9ffdb42-e-9&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-db41dbaa9105de2b903a433936c3b590-e-1" label="Equation (A8)">
        <attvalues>
          <attvalue for="0" value="Equation (A8)" />
          <attvalue for="1" value="Mathematical Equation" />
          <attvalue for="2" value="Equation (A8)是一个数学方程，用于描述材料的柔度常数S44、S11和S12之间的定量关系。这些常数是材料力学中表征材料在外力作用下弹性变形能力的关键物理量。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;4/π ∫[0 to π/4] dθ / (S44 + (2S11 - 2S12 - S44) × sin²2θ) = [2S44(S11 - S12)]^-1/2&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-db41dbaa9105de2b903a433936c3b590" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-db41dbaa9105de2b903a433936c3b590-e-5" label="nickel data">
        <attvalues>
          <attvalue for="0" value="nickel data" />
          <attvalue for="1" value="Dataset" />
          <attvalue for="2" value="一个关于镍 (nickel) 的数据集。当该数据集中的数据代入特定方程进行计算时，可得出一个代表材料某种力学性能的数值，即73 GPa。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-db41dbaa9105de2b903a433936c3b590" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-db41dbaa9105de2b903a433936c3b590-e-6" label="73 GPa">
        <attvalues>
          <attvalue for="0" value="73 GPa" />
          <attvalue for="1" value="Physical Value" />
          <attvalue for="2" value="73 GPa是根据镍数据计算得出的一个物理量值，用于表征柱状晶镍（columnar-grained nickel）所具有的某项物理属性。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;73&quot;, &quot;unit&quot;: &quot;GPa&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-db41dbaa9105de2b903a433936c3b590" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-db41dbaa9105de2b903a433936c3b590-e-7" label="columnar-grained nickel">
        <attvalues>
          <attvalue for="0" value="columnar-grained nickel" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="柱状晶镍是一种通过定向凝固工艺制备的特殊镍材料。其微观结构由沿特定(100)晶向平行生长的细长晶粒组成，形成独特的柱状晶形态，这赋予了其各向异性的物理和力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-db41dbaa9105de2b903a433936c3b590" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-db41dbaa9105de2b903a433936c3b590-e-9" label="(100) growth direction">
        <attvalues>
          <attvalue for="0" value="(100) growth direction" />
          <attvalue for="1" value="Crystallographic Orientation" />
          <attvalue for="2" value="一种晶体学取向，指柱状晶镍的晶粒沿着晶格的[100]方向进行择优生长。在立方晶系中，该[100]晶向垂直于(100)晶面，它决定了晶粒的拉长方向和材料的各向异性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-db41dbaa9105de2b903a433936c3b590" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-db41dbaa9105de2b903a433936c3b590-e-11" label="Wrought Superalloys">
        <attvalues>
          <attvalue for="0" value="Wrought Superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="**变形高温合金(Wrought Superalloys)**&#10;&#10;一种通过锻造或轧制等热加工工艺成型的高温合金。其化学成分以高铬(Cr)为特征，通常含有铁(Fe)和铌(Nb)，而强化相元素铝(Al)和钛(Ti)的含量较低，并且基本不添加铼(Re)和钽(Ta)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-db41dbaa9105de2b903a433936c3b590" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Wrought forms of superalloys&quot;, &quot;Wrought superalloys&quot;, &quot;wrought superalloys&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-db41dbaa9105de2b903a433936c3b590-e-11&quot;, &quot;chunk-5e30fb63f189d46677273b5c0f9ed52d-e-2&quot;, &quot;chunk-23893d297564190aa46fd314ec1e6f0e-e-9&quot;, &quot;chunk-e6c8cf32e29caa40f92e13ee8d574c84-e-3&quot;, &quot;chunk-1ac5bc0c5780485801a680d4bc6fcb10-e-6&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="10" />
        </attvalues>
      </node>
      <node id="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-1" label="Polycrystalline alloys">
        <attvalues>
          <attvalue for="0" value="Polycrystalline alloys" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="多晶合金是由大量取向各异的微小晶粒（晶体）组成的金属合金。这些晶粒通过晶界相互连接，其尺寸、形状和取向共同决定了材料的宏观物理和力学性能。绝大多数工程合金，如锻造高温合金，都属于多晶合金。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-5e30fb63f189d46677273b5c0f9ed52d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;polycrystalline alloys&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5e30fb63f189d46677273b5c0f9ed52d-e-1&quot;, &quot;chunk-db41dbaa9105de2b903a433936c3b590-e-10&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-5" label="Isotropy">
        <attvalues>
          <attvalue for="0" value="Isotropy" />
          <attvalue for="1" value="Material Condition" />
          <attvalue for="2" value="各向同性是一种材料状态，指材料的物理性质不随晶体取向而变化。对于弹性性质，这意味着杨氏模量（E）、泊松比（v）和剪切模量等弹性常数在所有方向上都具有相同的值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-5e30fb63f189d46677273b5c0f9ed52d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-6" label="Equation (A9)">
        <attvalues>
          <attvalue for="0" value="Equation (A9)" />
          <attvalue for="1" value="Mathematical Equation" />
          <attvalue for="2" value="一个编号为(A9)的数学方程式，它为物理学中的各向同性（Isotropy）性质提供了形式化的数学定义和判定条件。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;S11 - S12 - 1/2 S44 = 0&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-5e30fb63f189d46677273b5c0f9ed52d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-9" label="Shear Modulus">
        <attvalues>
          <attvalue for="0" value="Shear Modulus" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="剪切模量（Shear Modulus），也称刚性模量，符号为G。它是一种材料力学性能，用于衡量材料抵抗剪切变形的能力，其定义为剪切应力与剪切应变之比。该模量反映了材料在剪切力作用下抵抗形状改变的刚度，是计算奥罗万应力等参数的关键依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-5e30fb63f189d46677273b5c0f9ed52d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;G&quot;, &quot;Shear modulus&quot;, &quot;shear modulus&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-488553ca8f86a8be784d625006ec53f4-e-7&quot;, &quot;chunk-f8de8bf5059ef35e8409c085b9ffdb42-e-1&quot;, &quot;chunk-5e30fb63f189d46677273b5c0f9ed52d-e-9&quot;, &quot;chunk-59efde3cc28eec2ad611a5941651c5d8-e-3&quot;, &quot;chunk-91405e06bb69c5ec0eb63c43e028bfc6-e-2&quot;, &quot;chunk-5b9a3c27ff490c221f01663699f4563f-e-6&quot;, &quot;chunk-3592621846181c3ac65f3ee4259b4898-e-2&quot;, &quot;chunk-88fbc7a52ff45f9431f17e23dd2d49a1-e-7&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="14" />
        </attvalues>
      </node>
      <node id="chunk-59efde3cc28eec2ad611a5941651c5d8-e-2" label="Poisson's ratio">
        <attvalues>
          <attvalue for="0" value="Poisson's ratio" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="泊松比 (Poisson's ratio, v) 是一个关键的材料弹性常数，用于衡量材料的横向变形。其定义为：当材料沿轴向受力发生拉伸或压缩时，其横向应变与轴向应变之比的负值。这个无量纲的参数量化了材料在主方向变形时，垂直方向上收缩或膨胀的程度，是描述各向同性材料力学行为的基本属性之一。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;v&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-59efde3cc28eec2ad611a5941651c5d8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Poisson ratio&quot;, &quot;Poisson's Ratio&quot;, &quot;Poisson's Ratio (ν)&quot;, &quot;Poisson's ratio (ν)&quot;, &quot;Poisson's ratio of the coating&quot;, &quot;Poisson's ratio, v&quot;, &quot;v&quot;, &quot;ν&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5e30fb63f189d46677273b5c0f9ed52d-e-8&quot;, &quot;chunk-59efde3cc28eec2ad611a5941651c5d8-e-2&quot;, &quot;chunk-91405e06bb69c5ec0eb63c43e028bfc6-e-4&quot;, &quot;chunk-bd60b7156cd23c0b756c44e832fda30b-e-4&quot;, &quot;chunk-150175465cd3482592c4a1c003a558af-e-8&quot;, &quot;chunk-7a1f5be456518061b87546ca7f9d9812-e-7&quot;, &quot;chunk-bf602d6d22c552a1206d1179123ca1f7-e-4&quot;, &quot;chunk-5395b7a3b731615ee1a2521907378b84-e-7&quot;, &quot;chunk-2e04fd0a8a6174c1165f0c60c65b783d-e-8&quot;, &quot;chunk-80545b960495f33fd33c6ee9963001b5-e-3&quot;, &quot;chunk-3b4a29632c8b1d02d0265d40c4880791-e-8&quot;, &quot;chunk-dddd9f3ab574da5297f93e141b49d4a6-e-3&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="10" />
        </attvalues>
      </node>
      <node id="chunk-59efde3cc28eec2ad611a5941651c5d8-e-7" label="Polycrystalline nickel">
        <attvalues>
          <attvalue for="0" value="Polycrystalline nickel" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="多晶镍是一种由大量取向各异的镍晶粒构成的金属材料。其微观晶体结构决定了材料的宏观物理性质，特别是其杨氏模量等力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-59efde3cc28eec2ad611a5941651c5d8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-91405e06bb69c5ec0eb63c43e028bfc6-e-1" label="Polycrystalline Nickel">
        <attvalues>
          <attvalue for="0" value="Polycrystalline Nickel" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="多晶镍是一种由大量取向各异的镍晶粒组成的金属材料。它具有特定的弹性性能，包括杨氏模量、泊松比和剪切模量，并因其微观晶体结构而表现出弹性各向异性。" />
          <attvalue for="3" value="{&quot;Young's Modulus (E)&quot;: &quot;207 GPa&quot;, &quot;Poisson's Ratio (v)&quot;: &quot;0.26&quot;, &quot;Shear Modulus (G)&quot;: &quot;82 GPa&quot;, &quot;S11&quot;: &quot;4.83 × 10-12 m²/N&quot;, &quot;S12&quot;: &quot;-1.26 × 10-12 m²/N&quot;, &quot;S44&quot;: &quot;12.17 × 10-12 m²/N&quot;, &quot;Measurement Condition&quot;: &quot;room temperature&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-91405e06bb69c5ec0eb63c43e028bfc6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-3ff783a5b26a130b0577173680195866-e-2" label="Anisotropy Factor (A)">
        <attvalues>
          <attvalue for="0" value="Anisotropy Factor (A)" />
          <attvalue for="1" value="Metric" />
          <attvalue for="2" value="各向异性因子 (A) 是一个用于量化立方晶系金属材料弹性各向异性程度的无量纲指标。当其值为1时，表示材料为完全各向同性；其值偏离1越远，则材料的弹性各向异性越显著。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;2C44 / (C11 - C12)&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-3ff783a5b26a130b0577173680195866" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3ff783a5b26a130b0577173680195866-e-3" label="Nickel (Ni)">
        <attvalues>
          <attvalue for="0" value="Nickel (Ni)" />
          <attvalue for="1" value="Cubic Metal" />
          <attvalue for="2" value="镍（Ni）是一种具有立方晶体结构的金属元素。其弹性各向异性是它的一项关键物理特性，拥有特定的各向异性因子(A)值。在材料学研究中，其性能常与铜(Cu)、金(Au)、硅(Si)等其他立方晶系元素进行对比分析。" />
          <attvalue for="3" value="{&quot;anisotropy_factor&quot;: &quot;2.44&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-3ff783a5b26a130b0577173680195866" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-3ff783a5b26a130b0577173680195866-e-4" label="Copper (Cu)">
        <attvalues>
          <attvalue for="0" value="Copper (Cu)" />
          <attvalue for="1" value="Cubic Metal" />
          <attvalue for="2" value="铜（Cu）是一种化学元素，原子序数29。它是一种具有立方晶体结构的金属，以其优异的导电、导热性能和独特的红橙色光泽而闻名，是人类最早使用的金属之一。" />
          <attvalue for="3" value="{&quot;anisotropy_factor&quot;: &quot;3.19&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-3ff783a5b26a130b0577173680195866" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3ff783a5b26a130b0577173680195866-e-5" label="Silver (Ag)">
        <attvalues>
          <attvalue for="0" value="Silver (Ag)" />
          <attvalue for="1" value="Cubic Metal" />
          <attvalue for="2" value="银（Ag），原子序数47，是一种具有立方晶体结构的化学元素和贵金属。它拥有所有金属中最高的导电率、导热率和反射率，因其独特的物理化学性质被广泛应用于珠宝、货币、电子和催化等领域。" />
          <attvalue for="3" value="{&quot;anisotropy_factor&quot;: &quot;2.97&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3ff783a5b26a130b0577173680195866" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3ff783a5b26a130b0577173680195866-e-7" label="Germanium (Ge)">
        <attvalues>
          <attvalue for="0" value="Germanium (Ge)" />
          <attvalue for="1" value="Cubic Metal" />
          <attvalue for="2" value="锗（Ge）是一种化学元素，原子序数32。它是一种坚硬、有光泽的灰白色类金属，具有立方晶体结构。作为一种重要的半导体材料，锗被广泛应用于红外光学、光纤通信和太阳能电池等领域。" />
          <attvalue for="3" value="{&quot;anisotropy_factor&quot;: &quot;1.65&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-3ff783a5b26a130b0577173680195866" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Ge&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3ff783a5b26a130b0577173680195866-e-7&quot;, &quot;chunk-f6159d3dd840711c5298adf7f057d3b6-e-3&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3ff783a5b26a130b0577173680195866-e-8" label="Silicon (Si)">
        <attvalues>
          <attvalue for="0" value="Silicon (Si)" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="硅（Si）是一种化学元素，原子序数为14，是一种重要的类金属。作为现代电子工业（如芯片、太阳能电池）的基础材料，它是最重要的半导体之一。此外，它也被广泛用作合金和特种涂层中的关键组分。" />
          <attvalue for="3" value="{&quot;anisotropy_factor&quot;: &quot;1.57&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-3ff783a5b26a130b0577173680195866" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Si&quot;, &quot;Silicon&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3ff783a5b26a130b0577173680195866-e-8&quot;, &quot;chunk-5354da7deedb75e784b4ab18d7e8dbe0-e-9&quot;, &quot;chunk-35442490006b7aff468c9227749684e6-e-5&quot;, &quot;chunk-a921a108c7811dc9a541483523b2c983-e-5&quot;, &quot;chunk-6d7a887b0ad8aa25cf8cb0d2e4a60af2-e-2&quot;, &quot;chunk-d55298f42964ce23c30b0bcafa72ab6c-e-4&quot;, &quot;chunk-4bc43156e1a0a7c73048cc8f158c8919-e-4&quot;, &quot;chunk-df56dbe04dca860f9b208ab9b4878418-e-12&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-f6159d3dd840711c5298adf7f057d3b6-e-2" label="Au">
        <attvalues>
          <attvalue for="0" value="Au" />
          <attvalue for="1" value="Metal" />
          <attvalue for="2" value="金（Au）是一种金属元素，具有立方晶体结构。根据提供的物理特性，其各向异性值被列为2.90。" />
          <attvalue for="3" value="{&quot;anisotropy_value&quot;: &quot;2.90&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-f6159d3dd840711c5298adf7f057d3b6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f6159d3dd840711c5298adf7f057d3b6-e-4" label="Si">
        <attvalues>
          <attvalue for="0" value="Si" />
          <attvalue for="1" value="Metalloid" />
          <attvalue for="2" value="硅（Si）是一种具有立方晶体结构的类金属，其各向异性值为1.57。作为一种重要的半导体材料，它的物理性质（如弹性模量）会随晶体方向的变化而表现出差异。" />
          <attvalue for="3" value="{&quot;anisotropy_value&quot;: &quot;1.57&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f6159d3dd840711c5298adf7f057d3b6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f6159d3dd840711c5298adf7f057d3b6-e-6" label="Cubic metals">
        <attvalues>
          <attvalue for="0" value="Cubic metals" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="指晶体结构属于立方晶系的一类材料。其原子在空间中呈立方体构型排列，此类别不仅包括金(Au)、铝(Al)等金属，也涵盖了具有相同晶体结构的硅(Si)、锗(Ge)等类金属元素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-f6159d3dd840711c5298adf7f057d3b6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-f6159d3dd840711c5298adf7f057d3b6-e-8" label="Single-crystal Ni">
        <attvalues>
          <attvalue for="0" value="Single-crystal Ni" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="单晶镍（Single-crystal Ni）是金属镍的一种材料形态，其整个固体由单一、无晶界的连续晶格构成。由于原子排列的高度有序性，它在不同晶向上具有不同的物理和力学性质，是一种典型的弹性各向异性材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-f6159d3dd840711c5298adf7f057d3b6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f6159d3dd840711c5298adf7f057d3b6-e-10" label="Single-crystal blading">
        <attvalues>
          <attvalue for="0" value="Single-crystal blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="单晶叶片是一种先进构件，通常采用镍基高温合金，通过定向凝固工艺使整个部件成为一个单一晶体。其结构完全消除了晶界这一高温薄弱环节，并利用材料的各向异性来优化性能，从而具备卓越的高温强度、蠕变抗性和热疲劳寿命，主要用于航空发动机等高端装备。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-f6159d3dd840711c5298adf7f057d3b6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ebd2dca09f2a068f351417ce368a2e3e-e-1" label="Polycrystalline nickel">
        <attvalues>
          <attvalue for="0" value="Polycrystalline nickel" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="多晶镍 (Polycrystalline nickel) 是一种金属镍材料，其微观结构由大量取向随机的细小晶粒组成。由于晶粒的随机排列，该材料在宏观上表现出各向同性的力学性能（如弹性），即物理性质在所有方向上均保持一致。" />
          <attvalue for="3" value="{&quot;E&quot;: &quot;207 GPa&quot;, &quot;G&quot;: &quot;82 GPa&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-ebd2dca09f2a068f351417ce368a2e3e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="102" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ebd2dca09f2a068f351417ce368a2e3e-e-2" label="Directionally solidified nickel">
        <attvalues>
          <attvalue for="0" value="Directionally solidified nickel" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="定向凝固镍是一种通过特定凝固工艺制备的镍基材料。该工艺使其内部晶粒沿特定方向（如(100)晶向）优先生长，形成强烈的择优取向织构。这种高度有序的微观结构导致其在不同方向上表现出不同的弹性性能，即各向异性。" />
          <attvalue for="3" value="{&quot;growth_texture&quot;: &quot;(100)&quot;, &quot;E(100)&quot;: &quot;125 GPa&quot;, &quot;shear_modulus&quot;: &quot;73 GPa&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-ebd2dca09f2a068f351417ce368a2e3e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ebd2dca09f2a068f351417ce368a2e3e-e-2&quot;]}]" />
          <attvalue for="9" value="102" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ebd2dca09f2a068f351417ce368a2e3e-e-3" label="Nickel">
        <attvalues>
          <attvalue for="0" value="Nickel" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种金属元素。在当前语境下，它是一种基础材料，被用作与其不同微观结构形态（如多晶态和定向凝固态）进行性能比较时的基准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-ebd2dca09f2a068f351417ce368a2e3e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="102" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9a7bf068d1a00a4855bbb44ade04eaa3-e-1" label="Shear Modulus (growth direction normal)">
        <attvalues>
          <attvalue for="0" value="Shear Modulus (growth direction normal)" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种材料属性，用于衡量各向异性材料在垂直于其生长方向的平面内抵抗剪切形变的能力。该属性是描述晶体、增材制造部件等方向相关材料力学性能的关键参数，其数值常与材料在各向同性情况下的剪切模量进行比较。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;73 GPa&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-9a7bf068d1a00a4855bbb44ade04eaa3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9a7bf068d1a00a4855bbb44ade04eaa3-e-1&quot;]}]" />
          <attvalue for="9" value="163" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9a7bf068d1a00a4855bbb44ade04eaa3-e-2" label="Isotropic Case Shear Modulus">
        <attvalues>
          <attvalue for="0" value="Isotropic Case Shear Modulus" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种理想化的材料属性，指材料在各向同性（所有方向性能一致）假设下的剪切模量。它通常作为基准值，用于计算或比较各向异性材料在特定方向上的剪切性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-9a7bf068d1a00a4855bbb44ade04eaa3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="163" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3c63640879572110ccd78db6ac213a06-e-1" label="Processing of turbine blading">
        <attvalues>
          <attvalue for="0" value="Processing of turbine blading" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="指制造涡轮叶片所涉及的一系列加工工艺和技术。它涵盖从铸造、锻造、精密加工到表面处理和特种涂层等多个阶段，旨在确保叶片达到精确的空气动力学外形、优异的材料性能和长期服役的可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-3c63640879572110ccd78db6ac213a06" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;processing of blades&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3c63640879572110ccd78db6ac213a06-e-1&quot;, &quot;chunk-61a441c3ea495edfbd1f923ab25e12c9-e-17&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3c63640879572110ccd78db6ac213a06-e-2" label="Experimental alloys">
        <attvalues>
          <attvalue for="0" value="Experimental alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一类具有“雀斑”缺陷（Freckling）相关实验数据的合金材料。它们通常作为研究对象，用于分析和预测金属在凝固过程中特定宏观偏析缺陷的形成机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-3c63640879572110ccd78db6ac213a06" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3c63640879572110ccd78db6ac213a06-e-3" label="Freckling">
        <attvalues>
          <attvalue for="0" value="Freckling" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="Freckling是一种在大型IN718铸锭的电渣重熔(ESR)过程中难以消除的冶金缺陷。其宏观特征是形成被称为“雀斑通道”(Freckle channels)的富集物通道，是一种严重的成分偏析现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-3c63640879572110ccd78db6ac213a06" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Freckling phenomenon&quot;, &quot;freckling&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3c63640879572110ccd78db6ac213a06-e-3&quot;, &quot;chunk-ec660a3c0fa5875c4c6a5a9b4f0933db-e-2&quot;, &quot;chunk-c66cb4a523402b814bf33ff19d16eb24-e-5&quot;, &quot;chunk-8c811c47750a116467f7951f64cda580-e-3&quot;, &quot;chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676-e-14&quot;, &quot;chunk-5518f1c4ab4a7b4e100f841b3b90e572-e-1&quot;, &quot;chunk-3d0590efade07af78fea353ef909c7ec-e-10&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="10" />
        </attvalues>
      </node>
      <node id="chunk-3c63640879572110ccd78db6ac213a06-e-4" label="Density difference (∆ρ)">
        <attvalues>
          <attvalue for="0" value="Density difference (∆ρ)" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="密度差(∆ρ)是在特定过冷度下评估的一种物理性质，通常指材料液相与固相的密度差异。该数值的大小与材料凝固过程中形成的雀斑链（一种成分偏析缺陷）数量具有相关性，是预测此类缺陷形成趋势的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-3c63640879572110ccd78db6ac213a06" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3c63640879572110ccd78db6ac213a06-e-5" label="Supercooling">
        <attvalues>
          <attvalue for="0" value="Supercooling" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="过冷（Undercooling）是一种物理现象，指液体被冷却至其正常凝固点以下，但仍未发生结晶或凝固。处于过冷状态的液体是一种热力学上的亚稳态。该现象是凝固过程中晶核形成和晶体生长的必要条件和驱动力。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;20 K&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3c63640879572110ccd78db6ac213a06" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;undercooling&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3c63640879572110ccd78db6ac213a06-e-5&quot;, &quot;chunk-9c5b2b7dade746247326fc0930d280e0-e-8&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-3c63640879572110ccd78db6ac213a06-e-6" label="Liquidus">
        <attvalues>
          <attvalue for="0" value="Liquidus" />
          <attvalue for="1" value="Thermodynamic State" />
          <attvalue for="2" value="在相图中，液相线 (liquidus) 是一条温度边界线，表示多组分体系在平衡条件下，冷却时开始结晶或加热时完全熔化的温度。在此线以上区域，体系完全处于均匀的液相状态。该线的斜率'm'是其重要物理属性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-3c63640879572110ccd78db6ac213a06" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;liquidus&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3c63640879572110ccd78db6ac213a06-e-6&quot;, &quot;chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58-e-7&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3c63640879572110ccd78db6ac213a06-e-7" label="Freckle chains">
        <attvalues>
          <attvalue for="0" value="Freckle chains" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="一种在叶片样品中发现的冶金缺陷，是斑点(freckling)缺陷的一种特定表现形式，呈链状分布。其平均数量的多少与材料的密度差(∆ρ)存在相关性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-3c63640879572110ccd78db6ac213a06" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3c63640879572110ccd78db6ac213a06-e-7&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3c63640879572110ccd78db6ac213a06-e-8" label="Blade sample">
        <attvalues>
          <attvalue for="0" value="Blade sample" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="指从涡轮叶片上截取的、用于分析研究的试样（specimen）。该样本因其内部存在呈链状分布的“雀斑”（Freckles）冶金缺陷而具有特殊性，通常用于材料的失效分析或制造工艺评估。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-3c63640879572110ccd78db6ac213a06" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3c63640879572110ccd78db6ac213a06-e-9" label="Density inversion">
        <attvalues>
          <attvalue for="0" value="Density inversion" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="密度反转是一种物理现象，指密度较大的流体位于密度较小的流体之上，形成不稳定分层。在重力作用下，这种结构会引发对流，是导致材料凝固过程中产生“雀斑”（Freckling）缺陷的根本驱动力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-3c63640879572110ccd78db6ac213a06" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3c63640879572110ccd78db6ac213a06-e-9&quot;, &quot;chunk-ec660a3c0fa5875c4c6a5a9b4f0933db-e-1&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ec660a3c0fa5875c4c6a5a9b4f0933db-e-3" label="Processing conditions">
        <attvalues>
          <attvalue for="0" value="Processing conditions" />
          <attvalue for="1" value="Parameter Category" />
          <attvalue for="2" value="加工条件是指在材料加工或生产制造过程中，为获得特定产品特性而设定并控制的一系列物理或化学参数。这些参数（如温度、压力、时间和速率等）直接决定了最终产品的微观结构、宏观性能和整体质量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-ec660a3c0fa5875c4c6a5a9b4f0933db" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Processing Conditions&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ec660a3c0fa5875c4c6a5a9b4f0933db-e-3&quot;, &quot;chunk-921a9348cd77597c4374323349308669-e-9&quot;, &quot;chunk-c2b78e8b376569da6104df59fa66c5ca-e-2&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ec660a3c0fa5875c4c6a5a9b4f0933db-e-4" label="Dendritic structure">
        <attvalues>
          <attvalue for="0" value="Dendritic structure" />
          <attvalue for="1" value="Microstructure" />
          <attvalue for="2" value="一种在材料（尤指金属与合金）凝固过程中形成的树枝状晶体结构。作为典型的微观组织，其尺寸和形态（如枝晶臂间距）会受到凝固速度等工艺条件的显著影响，并决定材料的最终性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-ec660a3c0fa5875c4c6a5a9b4f0933db" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;dendritic structure&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ec660a3c0fa5875c4c6a5a9b4f0933db-e-4&quot;, &quot;chunk-4ab48ef35596d95655c761b2200818d3-e-2&quot;, &quot;chunk-eb0014a3a43fb5fde37c84b8672a5167-e-5&quot;, &quot;chunk-04c90a85908ffdd0ad7cdb9fbce55d8b-e-1&quot;, &quot;chunk-a67bfee0cc0003cfb8efe7f82e7665c2-e-9&quot;, &quot;chunk-d548052a2344b0da613ab35155dcbdaa-e-10&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-ec660a3c0fa5875c4c6a5a9b4f0933db-e-6" label="Temperature gradient (G)">
        <attvalues>
          <attvalue for="0" value="Temperature gradient (G)" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="G代表温度梯度（Temperature Gradient），是描述材料凝固过程的核心参数之一。它定义为固液界面处液相的温度随距离的变化率，与凝固速率（v）共同作用，其比值（G/v）和乘积（Gv）决定了凝固后的微观组织形态与尺寸。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-ec660a3c0fa5875c4c6a5a9b4f0933db" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;G&quot;, &quot;Temperature gradient&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ec660a3c0fa5875c4c6a5a9b4f0933db-e-6&quot;, &quot;chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58-e-1&quot;, &quot;chunk-eb0014a3a43fb5fde37c84b8672a5167-e-10&quot;, &quot;chunk-ffe6519a8ab8051b1f17495905d64096-e-7&quot;, &quot;chunk-d2428cb3e80954cab38bfce19b363f27-e-9&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-ec660a3c0fa5875c4c6a5a9b4f0933db-e-7" label="Withdrawal velocity (v)">
        <attvalues>
          <attvalue for="0" value="Withdrawal velocity (v)" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="**提拉速率(speed of withdrawal)**&#10;&#10;定向凝固过程中的一个关键工艺参数，指样品或坩埚相对热源的移动速率。该参数直接影响固/液界面的温度梯度和凝固速率，是控制和决定最终材料微观组织与宏观性能的核心变量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ec660a3c0fa5875c4c6a5a9b4f0933db" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;speed of withdrawal&quot;, &quot;withdrawal velocity&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ec660a3c0fa5875c4c6a5a9b4f0933db-e-7&quot;, &quot;chunk-4ab48ef35596d95655c761b2200818d3-e-5&quot;, &quot;chunk-a67bfee0cc0003cfb8efe7f82e7665c2-e-11&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-4ab48ef35596d95655c761b2200818d3-e-1" label="velocity, v">
        <attvalues>
          <attvalue for="0" value="velocity, v" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="**速度 (velocity, v)**：一个工艺参数，其数值是影响并决定材料微观组织尺度的关键变量。它直接控制着枝晶结构等微观结构的最终尺寸。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-4ab48ef35596d95655c761b2200818d3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Velocity v&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4ab48ef35596d95655c761b2200818d3-e-1&quot;, &quot;chunk-04c90a85908ffdd0ad7cdb9fbce55d8b-e-5&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-4ab48ef35596d95655c761b2200818d3-e-3" label="liquid metal cooling">
        <attvalues>
          <attvalue for="0" value="liquid metal cooling" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="液态金属冷却工艺是一种利用高导热性液态金属作为冷却介质的制造技术。该工艺的核心在于通过控制温度梯度(G)和凝固速率(v)等关键参数，来精细调整材料凝固后的微观结构（如枝晶间距），从而获得具有特定力学性能的金属部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-4ab48ef35596d95655c761b2200818d3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Liquid Metal Cooling&quot;, &quot;Liquid metal cooling&quot;, &quot;Liquid metal cooling process&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4ab48ef35596d95655c761b2200818d3-e-3&quot;, &quot;chunk-398a384cc3aa286c4fab7654b4862802-e-6&quot;, &quot;chunk-a67bfee0cc0003cfb8efe7f82e7665c2-e-7&quot;, &quot;chunk-d548052a2344b0da613ab35155dcbdaa-e-8&quot;, &quot;chunk-c54fb0cde287461ac785a255da940d8d-e-13&quot;, &quot;chunk-d9d581e86b96c92ccf2b9c353b4e4e11-e-1&quot;, &quot;chunk-23df60e783372fb64b1a5a9966ec4edc-e-9&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-4ab48ef35596d95655c761b2200818d3-e-4" label="Dendrite arm spacing">
        <attvalues>
          <attvalue for="0" value="Dendrite arm spacing" />
          <attvalue for="1" value="Microstructural Parameter" />
          <attvalue for="2" value="枝晶臂间距（Dendrite Arm Spacing, DAS）是衡量材料在凝固过程中形成的树枝状晶体（枝晶）臂与臂之间距离的关键微观组织参数。该间距大小与冷却速率成反比，冷却速率越快（如通过液态金属冷却或提高抽拉速率实现），间距越小，形成的组织越细密，这直接影响材料的机械性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-4ab48ef35596d95655c761b2200818d3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;dendrite arm spacing&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4ab48ef35596d95655c761b2200818d3-e-4&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-4ab48ef35596d95655c761b2200818d3-e-6" label="G">
        <attvalues>
          <attvalue for="0" value="G" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="一个关键过程参数，常与速度(v)共同作用，对材料的微观结构尺度有重要影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-4ab48ef35596d95655c761b2200818d3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58-e-2" label="v">
        <attvalues>
          <attvalue for="0" value="v" />
          <attvalue for="1" value="Solidification Parameter" />
          <attvalue for="2" value="v，即凝固速率（Solidification Rate），是表征凝固过程中固/液界面推进速度的物理量。作为关键的凝固参数，它与温度梯度（G）共同作用，深刻影响并决定材料最终的微观组织形态、尺寸及性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58-e-5" label="temperature interval, AT₁">
        <attvalues>
          <attvalue for="0" value="temperature interval, AT₁" />
          <attvalue for="1" value="Thermodynamic Parameter" />
          <attvalue for="2" value="AT₁是一个热力学参数，定义了物质从开始凝固到完全转变为固态所需的温度范围。它量化了完成这一液-固相变过程所经历的整个温度区间。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58-e-6" label="phase diagram">
        <attvalues>
          <attvalue for="0" value="phase diagram" />
          <attvalue for="1" value="Thermodynamic Model" />
          <attvalue for="2" value="一种热力学模型，通常以图解形式表示。它描述了在不同温度、压力和组分等条件下，材料达到热力学平衡时存在的物相状态。相图包含如液相线等相界线，是预测和理解材料相变（如凝固）的基础工具。" />
          <attvalue for="3" value="{&quot;type&quot;: &quot;binary&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58-e-8" label="m">
        <attvalues>
          <attvalue for="0" value="m" />
          <attvalue for="1" value="Phase Diagram Parameter" />
          <attvalue for="2" value="在材料科学和热力学中，`m` 是指二元相图中液相线的斜率。它量化了液相点温度随溶质浓度变化的速率，是计算溶质引起的凝固温度区间变化（∆Tsolutal）方程中的一个关键物理参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58-e-8&quot;, &quot;chunk-a974f22f27e1564b9b5db9cb4b218aa2-e-8&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58-e-9" label="solid/liquid partitioning coefficient, k">
        <attvalues>
          <attvalue for="0" value="solid/liquid partitioning coefficient, k" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="分配系数（Partition Coefficient），一个关键的无量纲物理参数。它定义为在凝固过程中，溶质在固相与液相中的浓度比值。该参数决定了溶质的再分配行为，并被用于计算由溶质引起的凝固点变化量（∆Tsolutal）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;k&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58-e-9&quot;, &quot;chunk-eb0014a3a43fb5fde37c84b8672a5167-e-2&quot;, &quot;chunk-a974f22f27e1564b9b5db9cb4b218aa2-e-10&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58-e-10" label="To">
        <attvalues>
          <attvalue for="0" value="To" />
          <attvalue for="1" value="Thermodynamic Parameter" />
          <attvalue for="2" value="To是一个热力学参数，指一个由公式 mco(k-1)/k 定义的温度区间。该公式基于固/液相分配系数(k)以及另外两个物理参数(m, co)进行计算。此温度区间参数在概念上与另一温度区间AT₁相关。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;mco(k – 1)/k&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58-e-11" label="co">
        <attvalues>
          <attvalue for="0" value="co" />
          <attvalue for="1" value="Material Composition" />
          <attvalue for="2" value="指材料的整体化学成分或名义成分。它是一个独立的初始参数，常作为计算材料的特征温度（如To，相变点）或其他热力学性质的依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58-e-11&quot;, &quot;chunk-eb0014a3a43fb5fde37c84b8672a5167-e-4&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-eb0014a3a43fb5fde37c84b8672a5167-e-1" label="To">
        <attvalues>
          <attvalue for="0" value="To" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="一个用于量化枝晶干（Dendrite trunks）属性的变量，其值根据参数m、co和k，通过公式 mco(k – 1)/k 计算得出。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;mco(k – 1)/k&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-eb0014a3a43fb5fde37c84b8672a5167" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-eb0014a3a43fb5fde37c84b8672a5167-e-3" label="m">
        <attvalues>
          <attvalue for="0" value="m" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="变量`m`，一个用于计算另一变量`To`的输入参数。在`To`的计算公式中，`m`作为一个独立的变量，其取值会直接影响`To`的最终计算结果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-eb0014a3a43fb5fde37c84b8672a5167" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-eb0014a3a43fb5fde37c84b8672a5167-e-6" label="Dendrites">
        <attvalues>
          <attvalue for="0" value="Dendrites" />
          <attvalue for="1" value="Microstructure Feature" />
          <attvalue for="2" value="树枝晶（Dendrite）是在物质凝固过程中形成的树枝状晶体，是构成枝晶结构的基本单元。其尖端具有特定的曲率半径，这一几何特征是表征其形态和生长动力学的重要物理属性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-eb0014a3a43fb5fde37c84b8672a5167" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Dendrite&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-eb0014a3a43fb5fde37c84b8672a5167-e-6&quot;, &quot;chunk-04c90a85908ffdd0ad7cdb9fbce55d8b-e-6&quot;, &quot;chunk-a974f22f27e1564b9b5db9cb4b218aa2-e-4&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-eb0014a3a43fb5fde37c84b8672a5167-e-7" label="R">
        <attvalues>
          <attvalue for="0" value="R" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="变量R，指枝晶尖端的曲率半径。它是一个关键的几何参数，用于量化枝晶生长前端的锐利程度，对材料的凝固动力学和最终微观结构有重要影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-eb0014a3a43fb5fde37c84b8672a5167" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-eb0014a3a43fb5fde37c84b8672a5167-e-8" label="Lp">
        <attvalues>
          <attvalue for="0" value="Lp" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="`Lp`是一个材料科学领域的物理量，定义为枝晶组织中相邻枝晶尖端之间的距离。它是一个关键的微观结构参数，用于表征材料在凝固或生长过程中的组织尺寸。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-eb0014a3a43fb5fde37c84b8672a5167" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-eb0014a3a43fb5fde37c84b8672a5167-e-9" label="Dendrite trunks">
        <attvalues>
          <attvalue for="0" value="Dendrite trunks" />
          <attvalue for="1" value="Microstructure Feature" />
          <attvalue for="2" value="树枝晶干是一种显微组织特征，指在材料凝固过程中形成的树枝晶的主干或中心茎。作为树枝晶的基本组成部分，其形态、尺寸及间距（常用λ表示）等特性是决定材料宏观性能的关键参数，并用于计算温区（To）和温度梯度（G）等物理量。" />
          <attvalue for="3" value="{&quot;mean_height&quot;: &quot;∆To/G&quot;, &quot;root_thickness_symbol&quot;: &quot;λ&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-eb0014a3a43fb5fde37c84b8672a5167" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-eb0014a3a43fb5fde37c84b8672a5167-e-9&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-eb0014a3a43fb5fde37c84b8672a5167-e-11" label="λ">
        <attvalues>
          <attvalue for="0" value="λ" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="一个用于表示枝晶干在其根部厚度的物理变量。λ作为一个关键的几何参数，被用于描述和量化枝晶在凝固过程中的微观结构形态。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-eb0014a3a43fb5fde37c84b8672a5167" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-eb0014a3a43fb5fde37c84b8672a5167-e-11&quot;, &quot;chunk-04c90a85908ffdd0ad7cdb9fbce55d8b-e-3&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-04c90a85908ffdd0ad7cdb9fbce55d8b-e-2" label="Trunks">
        <attvalues>
          <attvalue for="0" value="Trunks" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="Trunks是指树突状结构位于根部的组成部分，具有以符号'λ'表示的厚度属性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-04c90a85908ffdd0ad7cdb9fbce55d8b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-04c90a85908ffdd0ad7cdb9fbce55d8b-e-4" label="Lp">
        <attvalues>
          <attvalue for="0" value="Lp" />
          <attvalue for="1" value="Symbol" />
          <attvalue for="2" value="一个用于量化树干厚度的参数，符号为Lp。其值定义为另一厚度参数λ的两倍，即Lp = 2λ。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-04c90a85908ffdd0ad7cdb9fbce55d8b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-04c90a85908ffdd0ad7cdb9fbce55d8b-e-4&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-04c90a85908ffdd0ad7cdb9fbce55d8b-e-7" label="Radius of curvature">
        <attvalues>
          <attvalue for="0" value="Radius of curvature" />
          <attvalue for="1" value="Geometric Property" />
          <attvalue for="2" value="曲率半径R (Radius of curvature R) 是一个几何属性，用于量化前导位错线在外力下形成的弓出构型的弯曲程度。它定义为与该位错曲线上某一点最贴合的圆的半径，其值越小表示位错线弯曲越剧烈，大小与驱动位错运动的有效应力直接相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-04c90a85908ffdd0ad7cdb9fbce55d8b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Radius of Curvature&quot;, &quot;Radius of curvature R&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-04c90a85908ffdd0ad7cdb9fbce55d8b-e-7&quot;, &quot;chunk-a6f8ce7a7c55e9b6f962543810b6ee71-e-9&quot;, &quot;chunk-2863217e233dc47e4fc60478978f8746-e-8&quot;, &quot;chunk-19203bda469f6dad8b0600aecd2de043-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-04c90a85908ffdd0ad7cdb9fbce55d8b-e-8" label="Parabola">
        <attvalues>
          <attvalue for="0" value="Parabola" />
          <attvalue for="1" value="Geometric Shape" />
          <attvalue for="2" value="抛物线是一种圆锥曲线，定义为平面上与一个定点（焦点）和一条定直线（准线）等距的点的轨迹。它常被用作数学模型，例如通过拟合枝晶尖端等物理形状，来估计其尖端的曲率半径。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-04c90a85908ffdd0ad7cdb9fbce55d8b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-04c90a85908ffdd0ad7cdb9fbce55d8b-e-9" label="Minor axis of the parabola">
        <attvalues>
          <attvalue for="0" value="Minor axis of the parabola" />
          <attvalue for="1" value="Geometric Property" />
          <attvalue for="2" value="一个用于表征拟合抛物线顶点处曲率的几何参数。虽然标准抛物线只有一个对称轴，但在特定应用中，该术语被借用以描述抛物线的“开口”宽度，并作为计算其曲率半径的关键输入值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-04c90a85908ffdd0ad7cdb9fbce55d8b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;minor axis of the parabola&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-04c90a85908ffdd0ad7cdb9fbce55d8b-e-9&quot;, &quot;chunk-40a3bf80811d3654201c78edd28fd126-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-40a3bf80811d3654201c78edd28fd126-e-1" label="R">
        <attvalues>
          <attvalue for="0" value="R" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="变量R是一个几何参数，定义为特定抛物线的短轴长度的平方与长轴长度的比值。它的计算值来源于该抛物线的长轴与短轴。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;λ2G/ΔΤο&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-40a3bf80811d3654201c78edd28fd126" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-40a3bf80811d3654201c78edd28fd126-e-3" label="major axis">
        <attvalues>
          <attvalue for="0" value="major axis" />
          <attvalue for="1" value="Geometric Property" />
          <attvalue for="2" value="主轴 (major axis) 是一个几何属性，在此特指与抛物线相关的一个量。根据上下文，其值被定义为等于公式 ∆Το/G。该属性是计算另一参数R的基础，表明它在特定计算或模型中是一个关键的中间变量。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;∆Το/G&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-40a3bf80811d3654201c78edd28fd126" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-40a3bf80811d3654201c78edd28fd126-e-4" label="λ (抛物线的短轴)">
        <attvalues>
          <attvalue for="0" value="λ (抛物线的短轴)" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="λ (Lambda) 是一个变量符号。在此特定上下文中，它被定义为“抛物线的短轴”，作为一个数学参数，用于量化和描述该抛物线的一个关键几何尺寸或特征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-40a3bf80811d3654201c78edd28fd126" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;λ&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-40a3bf80811d3654201c78edd28fd126-e-4&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-40a3bf80811d3654201c78edd28fd126-e-5" label="∆Το/G">
        <attvalues>
          <attvalue for="0" value="∆Το/G" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="∆Το/G是一个变量，其值等于一个二次曲线（通常是椭圆）的长轴。长轴是穿过椭圆中心和两个焦点的线段，为该椭圆的最长直径。此变量是定义椭圆尺寸与形状的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-40a3bf80811d3654201c78edd28fd126" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-40a3bf80811d3654201c78edd28fd126-e-7" label="superalloys">
        <attvalues>
          <attvalue for="0" value="superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="高温合金（Superalloys）是一类金属材料，通常以镍、铁或钴为基体。它们能在极端高温和高应力环境下，保持卓越的机械强度、抗蠕变、表面稳定性及抗腐蚀性能，其最终性能高度依赖于凝固过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-40a3bf80811d3654201c78edd28fd126" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="40" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-40a3bf80811d3654201c78edd28fd126-e-8" label="solutal undercooling (ΔTsolutal)">
        <attvalues>
          <attvalue for="0" value="solutal undercooling (ΔTsolutal)" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="**溶质过冷 (solutal undercooling, ∆Tsolutal)**：一种物理现象，指在凝固过程中，因溶质在固液界面发生再分配（溶质富集），导致界面前沿液相的局部平衡凝固温度降低。它是总过冷度的一个重要组成部分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-40a3bf80811d3654201c78edd28fd126" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;ATsolutal&quot;, &quot;solutal undercooling, ∆Tsolutal&quot;, &quot;∆Tsolutal&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-40a3bf80811d3654201c78edd28fd126-e-8&quot;, &quot;chunk-fc2c8c962be61e27a733cdf408bb1415-e-2&quot;, &quot;chunk-a974f22f27e1564b9b5db9cb4b218aa2-e-1&quot;]}]" />
          <attvalue for="9" value="40" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-40a3bf80811d3654201c78edd28fd126-e-9" label="ATcurvature">
        <attvalues>
          <attvalue for="0" value="ATcurvature" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="ATcurvature，也称曲率过冷，是一种由吉布斯-汤姆逊效应引起的物理现象。它描述了在材料凝固过程中，因固液界面存在曲率而导致的相变平衡温度降低。这种温差是构成总过冷度的重要组成部分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-40a3bf80811d3654201c78edd28fd126" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-40a3bf80811d3654201c78edd28fd126-e-9&quot;, &quot;chunk-fc2c8c962be61e27a733cdf408bb1415-e-3&quot;]}]" />
          <attvalue for="9" value="40" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-40a3bf80811d3654201c78edd28fd126-e-10" label="partitioning of solute">
        <attvalues>
          <attvalue for="0" value="partitioning of solute" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="在凝固过程中，因溶质在固相和液相中的溶解度不同，导致其在固-液界面发生重新分配的物理过程。该过程通常使溶质从固相中排出并在液相前沿富集，是引起成分过冷（solutal undercooling）的根本原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-40a3bf80811d3654201c78edd28fd126" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="40" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-40a3bf80811d3654201c78edd28fd126-e-12" label="solidification conditions">
        <attvalues>
          <attvalue for="0" value="solidification conditions" />
          <attvalue for="1" value="Process Condition" />
          <attvalue for="2" value="在高温合金的凝固过程中，为分析总过冷度而设定的一系列特定工艺条件。这些条件是研究材料凝固行为和微观结构形成的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-40a3bf80811d3654201c78edd28fd126" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="40" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-fc2c8c962be61e27a733cdf408bb1415-e-4" label="Gibbs–Thomson effect">
        <attvalues>
          <attvalue for="0" value="Gibbs–Thomson effect" />
          <attvalue for="1" value="Scientific Concept" />
          <attvalue for="2" value="吉布斯-汤姆逊效应是一种物理现象，描述了固/液界面曲率对相变平衡温度的影响。由于表面能的存在，小颗粒或液滴的熔点（或凝固点）会低于同种物质在大块状态下的熔点。这种因曲率导致的温度降低即为曲率过冷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-fc2c8c962be61e27a733cdf408bb1415" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Gibbs–Thomson&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-40a3bf80811d3654201c78edd28fd126-e-11&quot;, &quot;chunk-fc2c8c962be61e27a733cdf408bb1415-e-4&quot;]}]" />
          <attvalue for="9" value="40" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fc2c8c962be61e27a733cdf408bb1415-e-7" label="Blade applications">
        <attvalues>
          <attvalue for="0" value="Blade applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="一个特定的应用领域，主要指使用单晶高温合金制造高性能叶片，特别是涡轮叶片。这些部件通常在航空发动机或燃气轮机等高温、高应力环境下工作。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-fc2c8c962be61e27a733cdf408bb1415" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a974f22f27e1564b9b5db9cb4b218aa2-e-2" label="Ω">
        <attvalues>
          <attvalue for="0" value="Ω" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="Ω，代表过饱和度的物理量，其值由公式 Ω = Rv/D 给出。该物理量可用于近似计算溶质过冷度（solutal undercooling）∆Tsolutal。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a974f22f27e1564b9b5db9cb4b218aa2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;super-saturation (Ω)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a974f22f27e1564b9b5db9cb4b218aa2-e-2&quot;, &quot;chunk-7d1c0c8031d67aa9cde5e31731da960b-e-1&quot;]}]" />
          <attvalue for="9" value="40" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-a974f22f27e1564b9b5db9cb4b218aa2-e-3" label="@">
        <attvalues>
          <attvalue for="0" value="@" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="吉布斯-汤姆逊系数是材料科学和热力学中的一个物理参数，用于量化材料熔点或凝固点随颗粒尺寸或界面曲率变化的程度。它由材料的固液界面能、熔化焓和本体熔点等固有属性决定，是描述吉布斯-汤姆逊效应的核心常数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a974f22f27e1564b9b5db9cb4b218aa2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="275" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-a974f22f27e1564b9b5db9cb4b218aa2-e-5" label="Dendrite tips">
        <attvalues>
          <attvalue for="0" value="Dendrite tips" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="作为枝晶的组成部分，指其生长最前端呈半球形的区域。在材料凝固等物理过程中，其尖端曲率是决定晶体生长速度与稳定性的关键因素。" />
          <attvalue for="3" value="{&quot;shape&quot;: &quot;hemispherical&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a974f22f27e1564b9b5db9cb4b218aa2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a974f22f27e1564b9b5db9cb4b218aa2-e-5&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a974f22f27e1564b9b5db9cb4b218aa2-e-6" label="D">
        <attvalues>
          <attvalue for="0" value="D" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="溶质在液体中的扩散系数，是一个表征物质输运性质的关键物理参数。它量化了溶质分子因自身热运动而在液体中发生质量传递的速率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a974f22f27e1564b9b5db9cb4b218aa2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="40" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a974f22f27e1564b9b5db9cb4b218aa2-e-7" label="factor of 2">
        <attvalues>
          <attvalue for="0" value="factor of 2" />
          <attvalue for="1" value="Mathematical Term" />
          <attvalue for="2" value="在吉布斯-汤姆逊项中，因枝晶尖端的半球形几何形状而引入的一个数值为2的乘法因子。它用于量化凝固过程中界面曲率对相变温度的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a974f22f27e1564b9b5db9cb4b218aa2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a974f22f27e1564b9b5db9cb4b218aa2-e-9" label="c0">
        <attvalues>
          <attvalue for="0" value="c0" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="`c0`是一个变量，指合金中溶质的初始或名义浓度。在材料凝固理论中，它是计算溶质过冷度（∆Tsolutal）方程的关键参数，用于描述因溶质成分导致的液相线温度下降程度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-a974f22f27e1564b9b5db9cb4b218aa2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="276" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-a974f22f27e1564b9b5db9cb4b218aa2-e-12" label="v">
        <attvalues>
          <attvalue for="0" value="v" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="v是在过饱和度（Ω）计算公式中的一个变量。它通常指溶质（如电解质）在溶液中解离时，每个分子式单元所产生的离子总数，是一个无量纲的化学计量数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-a974f22f27e1564b9b5db9cb4b218aa2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a974f22f27e1564b9b5db9cb4b218aa2-e-12&quot;, &quot;chunk-7d1c0c8031d67aa9cde5e31731da960b-e-8&quot;]}]" />
          <attvalue for="9" value="40" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7d1c0c8031d67aa9cde5e31731da960b-e-2" label="D">
        <attvalues>
          <attvalue for="0" value="D" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="一个物理量，特指在凝固等相变过程中，溶质在界面前沿液相中的扩散系数。它表征溶质原子的迁移能力与扩散速率，是决定超饱和度(Ω)和最终微观组织形态的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-7d1c0c8031d67aa9cde5e31731da960b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="40" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7d1c0c8031d67aa9cde5e31731da960b-e-3" label="R">
        <attvalues>
          <attvalue for="0" value="R" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="一个由方程 R = λ²G/∆To 定义的变量，在物理推导中作为一个中间量，用于导出过冷度(AT)的表达式，并参与定义过饱和度(Ω)。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;λ2G/∆To&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-7d1c0c8031d67aa9cde5e31731da960b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="40" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-7d1c0c8031d67aa9cde5e31731da960b-e-4" label="total undercooling (ΔT)">
        <attvalues>
          <attvalue for="0" value="total undercooling (ΔT)" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="总过冷度（Total undercooling, AT）是一个材料科学领域的物理量，定义为溶质过冷度（solutal undercooling）与曲率过冷度（curvature undercooling）之和，用于描述合金凝固等相变过程中的总驱动力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-7d1c0c8031d67aa9cde5e31731da960b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;AT&quot;, &quot;total undercooling AT&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-40a3bf80811d3654201c78edd28fd126-e-6&quot;, &quot;chunk-fc2c8c962be61e27a733cdf408bb1415-e-1&quot;, &quot;chunk-7d1c0c8031d67aa9cde5e31731da960b-e-4&quot;]}]" />
          <attvalue for="9" value="40" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-7d1c0c8031d67aa9cde5e31731da960b-e-5" label="Equation (3.14)">
        <attvalues>
          <attvalue for="0" value="Equation (3.14)" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="方程 (3.14) 是一个数学表达式，用于描述过冷度 (AT) 与三个变量之间的依赖关系。该表达式是基于 R 推导得出的。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;mco(1-k) (v/2D) (λ2G/ΔTo) + 2θΔTo / λ2G&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-7d1c0c8031d67aa9cde5e31731da960b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="40" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7d1c0c8031d67aa9cde5e31731da960b-e-6" label="λ (Lp/2, overcooling parameter)">
        <attvalues>
          <attvalue for="0" value="λ (Lp/2, overcooling parameter)" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="λ (Lambda) 是一个物理变量，其数学表达式为Lp/2。它是决定材料或系统过冷度（AT）大小的三个关键变量之一。" />
          <attvalue for="3" value="{}" />
