          <attvalue for="9" value="23" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-28027332c1e907d2b9fb62cbdc68fd6c-e-16" label="R. H. Bricknell">
        <attvalues>
          <attvalue for="0" value="R. H. Bricknell" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="R. H. Bricknell是一位学者或编辑。其负责的出版物收录了由A. R. Nicholl和G. Wahl撰写的关于改性MCrAlY铸造材料氧化与高温腐蚀行为的研究论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-28027332c1e907d2b9fb62cbdc68fd6c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-28027332c1e907d2b9fb62cbdc68fd6c-e-16&quot;, &quot;chunk-e408a73fcde801378877f777a7391169-e-3&quot;, &quot;chunk-df56dbe04dca860f9b208ab9b4878418-e-15&quot;, &quot;chunk-6eb9964e0070cc2b73d942919084bb21-e-3&quot;]}]" />
