      <node id="chunk-0b443cc5c8498dc201a772ab50af4847-e-4" label="The Minerals, Metals and Materials Society (TMS)">
        <attvalues>
          <attvalue for="0" value="The Minerals, Metals and Materials Society (TMS)" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="矿物、金属与材料学会 (The Minerals, Metals and Materials Society, TMS) 是一个国际性专业组织，面向全球材料科学与工程领域的科学家、工程师及其他专业人士。该学会通过组织学术会议、出版期刊和书籍等方式，致力于促进从矿物加工到先进材料应用的整个领域的知识交流与技术发展。其总部位于美国宾夕法尼亚州沃伦代尔。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0b443cc5c8498dc201a772ab50af4847" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;The Metallurgical Society of AIME&quot;, &quot;The Minerals, Metals and Material&quot;, &quot;The Minerals, Metals and Materials Soc&quot;, &quot;The Minerals, Metals and Materials Society&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e408a73fcde801378877f777a7391169-e-9&quot;, &quot;chunk-6eb9964e0070cc2b73d942919084bb21-e-2&quot;, &quot;chunk-8031eb636b002393280031950b878895-e-13&quot;, &quot;chunk-61614a48414c169528ed8ada3a1933ea-e-3&quot;, &quot;chunk-61614a48414c169528ed8ada3a1933ea-e-8&quot;, &quot;chunk-0b443cc5c8498dc201a772ab50af4847-e-4&quot;, &quot;chunk-bdbf4600f0f46ee6111ce0bae60fe800-e-15&quot;, &quot;chunk-c5385f7f28e0875405c91c30084a5d9b-e-11&quot;, &quot;chunk-73957e2d0e70c072d7fd407a82b25f99-e-6&quot;, &quot;chunk-5d1954b761cf7718ff2558f9e10a2fac-e-7&quot;, &quot;chunk-b64074205c19193a279aa9e212f94d40-e-5&quot;, &quot;chunk-311ad4452372c744328957f626b3057d-e-1&quot;, &quot;chunk-c6e7b6a8ae77f73405b4c1cca62aa7e4-e-11&quot;]}]" />
          <attvalue for="9" value="10" />
