          <attvalue for="9" value="95" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cb57093a6357773efc0ab02b57f76fa1-e-23" label="France">
        <attvalues>
          <attvalue for="0" value="France" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="法国，全称法兰西共和国，是一个本土位于西欧的跨大陆国家。其首都为巴黎，是联合国安理会常任理事国及欧盟创始成员国之一。法国在文化、科技和军事等方面均具有全球性重要影响力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-23" />
