        <attvalues>
          <attvalue for="11" value="IS_ORIGIN_OF" />
          <attvalue for="12" value="The mechanism of dislocation pairing is the origin of order strengthening." />
          <attvalue for="13" value="this is the origin of a substantial precipitation-hardening effect known as order strengthening" />
