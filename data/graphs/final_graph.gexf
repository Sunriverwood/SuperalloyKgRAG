        <attvalues>
          <attvalue for="11" value="LOCATED_IN" />
          <attvalue for="12" value="Gold is located in the far east of the d block of the periodic table." />
          <attvalue for="13" value="...than those from the far west or far east of the d block, for example, Hf and Au;" />
