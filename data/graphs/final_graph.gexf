        <attvalues>
          <attvalue for="11" value="USED_TO_SIMPLIFY" />
          <attvalue for="12" value="Mathematical identities involving direction cosines are used to simplify or transform the compliance equation." />
          <attvalue for="13" value="Making use of the identities l1^2 + l2^2 + l3^2 = 1 and l1^4 + l2^4 + l3^4 = 1 - 2(l1^2l2^2 + l1^2l3^2 + l2^2l3^2), the transf" />
          <attvalue for="14" value="r-11" />
          <attvalue for="15" value="chunk-04d8e878969e6a9500600ef092423800" />
          <attvalue for="16" value="0.0033738191632928472" />
          <attvalue for="17" value="0.40202429149797575" />
        </attvalues>
      </edge>
      <edge source="chunk-9b96433e844031d4f15964cb1b24320d-e-3" target="chunk-9b96433e844031d4f15964cb1b24320d-e-5" id="chunk-9b96433e844031d4f15964cb1b24320d-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_MINIMUM_VALUE_AT" />
          <attvalue for="12" value="The anisotropy term has a minimum value of zero when measured along the cube axes." />
          <attvalue for="13" value="which has a minimum value of zero along the cube axes" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-9b96433e844031d4f15964cb1b24320d" />
          <attvalue for="16" value="0.0020242914979757085" />
