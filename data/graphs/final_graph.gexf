        <attvalues>
          <attvalue for="11" value="EQUALS" />
          <attvalue for="12" value="For a cubic crystal, the tensor component S22 is equal to S33." />
          <attvalue for="13" value="For a cubic crystal such as Ni, S11 = S22 = S33" />
