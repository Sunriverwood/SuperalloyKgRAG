          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-65dc63e5f84c9fe26415a54961f65c33-e-8&quot;, &quot;chunk-bdbf4600f0f46ee6111ce0bae60fe800-e-8&quot;, &quot;chunk-65335c426f17131b3458c32075ac90d7-e-5&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-65dc63e5f84c9fe26415a54961f65c33-e-9" label="Two-source jumping beam evaporation for advanced EB-PVD TBC Systems">
        <attvalues>
          <attvalue for="0" value="Two-source jumping beam evaporation for advanced EB-PVD TBC Systems" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由U. Schulz、K. Fritscher和C. Leyens合著的科学论文，发表于期刊《表面与涂层技术》。该文介绍了一种用于先进电子束物理气相沉积（EB-PVD）热障涂层（TBC）系统的双源跳跃束蒸发技术。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2000&quot;, &quot;volume&quot;: &quot;133–134&quot;}" />
          <attvalue for="4" value="e-9" />
