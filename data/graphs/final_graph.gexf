        <attvalues>
          <attvalue for="11" value="ENABLES_MIGRATION_OF" />
          <attvalue for="12" value="Interdiffusion with the substrate provides an opportunity for elements not present in the coating to migrate." />
          <attvalue for="13" value="Interdiffusion with the substrate provides an opportunity for elements not present in the coating to reach the bond coat/TGO interface" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-c4027f79a0ee2caae7fc9e91bab6483f" />
          <attvalue for="16" value="0.0009355787222667736" />
