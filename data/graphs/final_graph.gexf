      <node id="chunk-82c9ced81969f3e1552c36cf4bd5f22e-e-2" label="Di">
        <attvalues>
          <attvalue for="0" value="Di" />
          <attvalue for="1" value="Inclusion Class" />
          <attvalue for="2" value="Di是一个内含类别（Inclusion Class），作为nclasses集合的成员之一。它专门定义了一种特定的内含情况，其特征在于会提供或导致一个“致命缺陷”（fatal flaw）。" />
          <attvalue for="3" value="{}" />
