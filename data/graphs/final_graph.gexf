        <attvalues>
          <attvalue for="11" value="IS_PROPERTY_OF" />
          <attvalue for="12" value="The solvus is a specific temperature characteristic of the alloy being forged." />
          <attvalue for="13" value="the appropriate solvus of the alloy being forged" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-2b79180c24fc2ac7584f9f1d82b69f2b" />
