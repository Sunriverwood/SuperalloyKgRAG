      <edge source="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-1" target="chunk-54201ad9eae0d02b418a034d58136abe-e-4" id="chunk-8b5f0089753028d4f74bf5d1c1d40143-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="OCCURS_UNDER" />
          <attvalue for="12" value="Failure occurs at stresses that are nominally elastic." />
          <attvalue for="13" value="failure due to oscillating loads, at stresses which are nominally elastic." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="16" value="0.002662192393736018" />
          <attvalue for="17" value="0.4015973154362416" />
        </attvalues>
