      <edge source="chunk-54201ad9eae0d02b418a034d58136abe-e-2" target="chunk-54201ad9eae0d02b418a034d58136abe-e-4" id="chunk-54201ad9eae0d02b418a034d58136abe-r-3" weight="4.0">
        <attvalues>
          <attvalue for="11" value="OCCURS_AT" />
          <attvalue for="12" value="Fatigue failure occurs at stresses which are nominally elastic." />
          <attvalue for="13" value="As for all metallic materials, the single-crystal superalloys are prone to fatigue failure due to oscillating loads, at stresses which are nominally elastic." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-54201ad9eae0d02b418a034d58136abe" />
          <attvalue for="16" value="6.711409395973155e-05" />
          <attvalue for="17" value="0.2667069351230425" />
        </attvalues>
      </edge>
      <edge source="chunk-54201ad9eae0d02b418a034d58136abe-e-3" target="chunk-54201ad9eae0d02b418a034d58136abe-e-2" id="chunk-54201ad9eae0d02b418a034d58136abe-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CAUSES" />
          <attvalue for="12" value="Fatigue failure is caused by oscillating loads." />
          <attvalue for="13" value="As for all metallic materials, the single-crystal superalloys are prone to fatigue failure due to oscillating loads, at stresses which are nominally elastic." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-54201ad9eae0d02b418a034d58136abe" />
          <attvalue for="16" value="6.711409395973155e-05" />
          <attvalue for="17" value="0.40004026845637586" />
        </attvalues>
      </edge>
      <edge source="chunk-54201ad9eae0d02b418a034d58136abe-e-3" target="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-1" id="chunk-8b5f0089753028d4f74bf5d1c1d40143-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CAUSES" />
          <attvalue for="12" value="Oscillating loads are the cause of the failure." />
          <attvalue for="13" value="failure due to oscillating loads, at stresses which are nominally elastic." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="16" value="6.711409395973155e-05" />
