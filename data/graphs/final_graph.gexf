      <node id="chunk-8031eb636b002393280031950b878895-e-9" label="Microstructural instability">
        <attvalues>
          <attvalue for="0" value="Microstructural instability" />
          <attvalue for="1" value="Material Phenomenon" />
          <attvalue for="2" value="微观结构不稳定性 (Microstructural instability) 是指高温合金在高温、应力等服役条件下，其内部组织发生非预期演变，导致材料性能退化的现象。SRZ (spontaneous recrystallization zone) 是其新发现的一种类型。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-8031eb636b002393280031950b878895" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;instability of microstructure&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1297af8788c2be7a2a158412cd2652f3-e-6&quot;, &quot;chunk-8031eb636b002393280031950b878895-e-9&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8031eb636b002393280031950b878895-e-11" label="SRZ">
        <attvalues>
          <attvalue for="0" value="SRZ" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="SRZ是在高温合金中发现的一种新型微观结构不稳定性现象。作为材料的一种退化机制，它会导致合金在高温或应力环境下内部结构发生有害变化，进而影响其整体性能和服役寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-8031eb636b002393280031950b878895" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
