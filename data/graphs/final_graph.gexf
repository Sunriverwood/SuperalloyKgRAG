        <attvalues>
          <attvalue for="11" value="APPLIED_TO" />
          <attvalue for="12" value="The DC bias is applied to the substrate during the deposition process." />
          <attvalue for="13" value="oscillating the d.c. bias applied to the substrate during the EB-PVD process" />
