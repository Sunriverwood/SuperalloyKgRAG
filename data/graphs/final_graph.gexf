        <attvalues>
          <attvalue for="0" value="D. H. Boone" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. H. Boone是一位研究人员，作为合著者参与了学术出版物《Mechanisms of formation of di...》的撰写工作。这个身份是目前识别该人物的主要依据。" />
          <attvalue for="3" value="{}" />
