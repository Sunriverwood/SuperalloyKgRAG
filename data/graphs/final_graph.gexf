      <node id="chunk-e00b2aac6b639de957a0e986581a8e1c-e-7" label="manufacturing">
        <attvalues>
          <attvalue for="0" value="manufacturing" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="制造（manufacturing）是指将原材料转化为成品的生产过程。它是一个与部件设计和产品寿命估算需紧密集成的流程，意味着生产工艺的选择将直接影响组件的设计方案、最终性能、服役寿命及整体可靠性。" />
          <attvalue for="3" value="{}" />
