      <node id="chunk-807030ab9eb9ee85e606b0c18c1d17af-e-9" label="four alloys">
        <attvalues>
          <attvalue for="0" value="four alloys" />
          <attvalue for="1" value="Material Group" />
          <attvalue for="2" value="一个材料组，特指在图3.32中展示了其ay和ay'分析结果的四种特定合金。该组合金是特定实验或研究的对象。" />
          <attvalue for="3" value="{}" />
