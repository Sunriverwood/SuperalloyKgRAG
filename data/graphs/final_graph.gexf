          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f5c07b55f3d29bb402b546962b69a445-e-3&quot;, &quot;chunk-ba75e6448ea6f9f49ca3935b800555ba-e-4&quot;, &quot;chunk-c8bfe4fa64e107ddff8d923b426a8333-e-2&quot;, &quot;chunk-ae682ac4e4eb339bd48233482011cdd1-e-24&quot;, &quot;chunk-e3a2ad2f86c91d0494cd03450bd94ade-e-3&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-f5c07b55f3d29bb402b546962b69a445-e-7" label="Waspaloy">
        <attvalues>
          <attvalue for="0" value="Waspaloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="Waspaloy（瓦斯帕洛伊）是一种镍基高温合金，以其在高温下的高强度和耐腐蚀性而闻名。作为一种较早开发的材料，其强度低于Rene 95等更先进的合金。它被广泛用于制造燃气涡轮发动机的盘件、轴及紧固件等关键高温部件。" />
          <attvalue for="3" value="{&quot;category&quot;: &quot;polycrystalline superalloy&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-f5c07b55f3d29bb402b546962b69a445" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f5c07b55f3d29bb402b546962b69a445-e-7&quot;, &quot;chunk-d13800606f8047850e1ad6f9b8f895ce-e-3&quot;, &quot;chunk-6c1e5f01b68b0193af6f52382cd9e355-e-3&quot;, &quot;chunk-edc468109902c1fff7b3577a4b609989-e-7&quot;, &quot;chunk-095e7b19e19ba75f3f37b75ed9ca8622-e-4&quot;, &quot;chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec-e-1&quot;, &quot;chunk-e3a4ba849abe93a2a6728157cbd079b2-e-1&quot;, &quot;chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6-e-7&quot;, &quot;chunk-6ab819da0d17d27985ac5f6eebc6d38b-e-8&quot;, &quot;chunk-ee6f1e6770197cb40d6002c5cd9212fd-e-4&quot;, &quot;chunk-e59e76ae369265e25373e5545e9102c3-e-2&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-f5c07b55f3d29bb402b546962b69a445-e-8" label="Turbine discs">
        <attvalues>
          <attvalue for="0" value="Turbine discs" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="高压涡轮盘（HP turbine disc）是涡轮发动机中的核心旋转部件。它是一种断裂临界件，其失效可能导致灾难性后果。因此，该部件遵循严格的“安全寿命”策略进行管理，达到规定寿命后即强制退役。其结构完整性与可靠性在专门的旋转试验台中进行测试验证。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-f5c07b55f3d29bb402b546962b69a445" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;HP turbine disc&quot;, &quot;Superalloy Turbine Discs&quot;, &quot;Superalloy turbine discs&quot;, &quot;Turbine Disc&quot;, &quot;Turbine disc&quot;, &quot;Turbine disc alloy&quot;, &quot;Turbine disc superalloy&quot;, &quot;Turbine disc superalloys&quot;, &quot;turbine disc&quot;, &quot;turbine disc alloy&quot;, &quot;turbine discs&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-351e8ba4c7ea5776fa307b38afdc31ab-e-3&quot;, &quot;chunk-f5c07b55f3d29bb402b546962b69a445-e-8&quot;, &quot;chunk-c66cb4a523402b814bf33ff19d16eb24-e-3&quot;, &quot;chunk-6542d72e1fe020ba20ec3d195bda41be-e-7&quot;, &quot;chunk-eb085f02bba98b62b26a7b0962fa3843-e-1&quot;, &quot;chunk-7e79124b1e7a81a0aeb685547f1f14b7-e-2&quot;, &quot;chunk-49fe0f122b885e8929f914d54a677b92-e-1&quot;, &quot;chunk-9ab220eb8343ca4f69826c693a95cb6c-e-9&quot;, &quot;chunk-edc468109902c1fff7b3577a4b609989-e-2&quot;, &quot;chunk-577e71f977df9c88b625f750e5b679c3-e-3&quot;, &quot;chunk-1cedf1737fe4754f24d3e9eaa5f64aed-e-3&quot;, &quot;chunk-d9d4e9c6bdfb7df170a8302da4a9bf0c-e-5&quot;, &quot;chunk-54d9cab0bf8e738ae99d8958ce8cd086-e-1&quot;, &quot;chunk-b7bfd8f1e9243bc095953814aae07253-e-2&quot;, &quot;chunk-97f22587e687782a5433110f85b94c9e-e-6&quot;, &quot;chunk-cbf4d780dd2a841aa5348c2c70b0276f-e-8&quot;, &quot;chunk-925bc5f619d7b2214c7a718b66fcfe15-e-2&quot;, &quot;chunk-972c0e045da978a7171f69472773ae6a-e-1&quot;, &quot;chunk-698d77389e974f77703857501a37006f-e-4&quot;, &quot;chunk-926a036993bc42eccb957e97d54b732e-e-3&quot;, &quot;chunk-1ac6995f0fe228ff138a38c832d667fd-e-1&quot;, &quot;chunk-57054d164541d83734201813bb4b9d8f-e-3&quot;, &quot;chunk-e29ab0c1999b2fd0630fcd1c30c3554b-e-1&quot;, &quot;chunk-ac0f1d7e181ea0f31c302d3d4596599b-e-5&quot;, &quot;chunk-cde5a0fcf48daf01d0e3e3cd1cc4582e-e-5&quot;, &quot;chunk-9fd48949e9fa068e1f82454ee4d745a1-e-4&quot;, &quot;chunk-0cc0ddc3943d8f2fd7c506b872a6a90c-e-3&quot;, &quot;chunk-58ee51f26d85456c13aa639ae170ab36-e-5&quot;, &quot;chunk-e3bc91d02528ce132349b28825081f88-e-5&quot;, &quot;chunk-ee2c916092b69050b73e7898f576b082-e-1&quot;, &quot;chunk-eb23a1fa1bb857c2e5b4e84047321caa-e-10&quot;, &quot;chunk-fab5556d25e36a12308d5e081229601a-e-2&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="23" />
        </attvalues>
      </node>
      <node id="chunk-f5c07b55f3d29bb402b546962b69a445-e-9" label="MA754">
        <attvalues>
          <attvalue for="0" value="MA754" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="MA754是一种采用粉末冶金工艺制造的氧化物弥散强化（ODS）高温合金。它通过在合金基体中弥散稳定的氧化物颗粒，从而在极端高温环境下仍具备卓越的强度、抗蠕变及抗氧化性能。" />
          <attvalue for="3" value="{&quot;category&quot;: &quot;oxide-dispersion-strengthened superalloy&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-f5c07b55f3d29bb402b546962b69a445" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f5c07b55f3d29bb402b546962b69a445-e-11" label="Ti-6242">
        <attvalues>
          <attvalue for="0" value="Ti-6242" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="Ti-6242是一种近α型高温钛合金，名义成分为Ti-6Al-2Sn-4Zr-2Mo。该合金具有优异的高温强度、蠕变抗力和热稳定性，主要用于制造航空发动机的压气机盘和叶片等热端部件。" />
          <attvalue for="3" value="{&quot;category&quot;: &quot;titanium alloy&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-f5c07b55f3d29bb402b546962b69a445" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f5c07b55f3d29bb402b546962b69a445-e-11&quot;, &quot;chunk-d5ce586afcf8fd710ae4779854d26909-e-1&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f5c07b55f3d29bb402b546962b69a445-e-13" label="oxide-dispersion-strengthened superalloy">
        <attvalues>
          <attvalue for="0" value="oxide-dispersion-strengthened superalloy" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="一种高温合金，其特点是在金属基体中均匀弥散着稳定、细小的氧化物颗粒作为强化相。它通常采用粉末冶金工艺制备，具有极为优异的高温强度、抗蠕变性能和组织稳定性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-f5c07b55f3d29bb402b546962b69a445" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d5ce586afcf8fd710ae4779854d26909-e-2" label="Compressor sections of modern aeroengines">
        <attvalues>
          <attvalue for="0" value="Compressor sections of modern aeroengines" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="现代航空发动机的核心部件之一，主要功能是吸入并将空气逐级加压，然后输送至燃烧室。因其在高温高压环境下工作，常采用Ti-6242等高性能钛合金材料制造。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-d5ce586afcf8fd710ae4779854d26909" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d5ce586afcf8fd710ae4779854d26909-e-3" label="NiAl">
        <attvalues>
          <attvalue for="0" value="NiAl" />
          <attvalue for="1" value="Intermetallic Compound" />
          <attvalue for="2" value="NiAl是一种金属间化合物，被视为一种极具潜力的高温材料，但目前尚未在燃气轮机中获得实际应用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d5ce586afcf8fd710ae4779854d26909" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
