      <node id="chunk-cb57093a6357773efc0ab02b57f76fa1-e-10" label="Mr Atsushi Sato">
        <attvalues>
          <attvalue for="0" value="Mr Atsushi Sato" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="佐藤淳（Atsushi Sato）是一位日本学者，隶属于日本国立物质材料研究机构（National Institute for Materials Science）。该机构是专注于材料科学研究的日本国家级研究所。" />
          <attvalue for="3" value="{}" />
