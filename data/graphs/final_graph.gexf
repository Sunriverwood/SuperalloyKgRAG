        <attvalues>
          <attvalue for="11" value="IS_A" />
          <attvalue for="12" value="The spacing interval λ₁ is an instance of a 'Friedel spacing'." />
          <attvalue for="13" value="...and each is known as a ‘Friedel spacing’." />
          <attvalue for="14" value="r-9" />
          <attvalue for="15" value="chunk-0fc62816353bfe4473c22a2bef9a696b" />
          <attvalue for="16" value="5.632057672270564e-05" />
          <attvalue for="17" value="0.40003379234603365" />
        </attvalues>
      </edge>
      <edge source="chunk-0fc62816353bfe4473c22a2bef9a696b-e-9" target="chunk-0fc62816353bfe4473c22a2bef9a696b-e-6" id="chunk-0fc62816353bfe4473c22a2bef9a696b-r-8" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_SPACING_FOR" />
          <attvalue for="12" value="λ₂ is the spacing interval for particles being intersected by the second dislocation." />
          <attvalue for="13" value="The particles intersecting the first and second dislocations are assumed to be spaced at intervals λ₁ and λ₂, respectively..." />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-0fc62816353bfe4473c22a2bef9a696b" />
          <attvalue for="16" value="0.0013798541297062883" />
          <attvalue for="17" value="0.4008279124778238" />
        </attvalues>
