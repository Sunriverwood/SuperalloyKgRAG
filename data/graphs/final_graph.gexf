      <node id="chunk-61614a48414c169528ed8ada3a1933ea-e-7" label="Superalloys 2004">
        <attvalues>
          <attvalue for="0" value="Superalloys 2004" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Superalloys 2004》是一部关于高温合金的权威学术论文集。该出版物收录了2004年国际高温合金专题研讨会（International Symposium on Superalloys）发表的前沿研究论文，由K. A. Green、T. M. Pollock、H. Harada等人编辑，是该领域的关键参考文献。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2004&quot;, &quot;location&quot;: &quot;Warrendale, PA&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-61614a48414c169528ed8ada3a1933ea" />
          <attvalue for="6" value="true" />
