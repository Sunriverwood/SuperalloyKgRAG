      <node id="chunk-50f39f54006f612a0e1ae1be19a6ae87-e-11" label="K. Stiller">
        <attvalues>
          <attvalue for="0" value="K. Stiller" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="K. Stiller是一名作者，其代表著作为学术出版物《Microstructural and microchemical development of simple and Pt-modified aluminide》。该著作专注于材料科学领域，研究了简单及铂改性铝化物的微观结构与化学发展。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-50f39f54006f612a0e1ae1be19a6ae87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-50f39f54006f612a0e1ae1be19a6ae87-e-12" label="E. Bakchinova">
        <attvalues>
          <attvalue for="0" value="E. Bakchinova" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="E. Bakchinova是一位研究人员和作者。她因合著科学出版物《简单和铂改性铝化物的微观结构与微观化学发展》(Microstructural and microchemical development of simple and Pt-modified aluminide)而知名。该研究隶属于材料科学领域，聚焦于分析铝化物涂层的微观结构与化学特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-50f39f54006f612a0e1ae1be19a6ae87" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
