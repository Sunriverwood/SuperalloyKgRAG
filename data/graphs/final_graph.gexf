        </attvalues>
      </node>
      <node id="chunk-7156e9ba9e827ebbbc4b86d5bd16aa0b-e-9" label="The effect of dual microstructure heat treatment on an advanced nickel-base disk alloy">
        <attvalues>
          <attvalue for="0" value="The effect of dual microstructure heat treatment on an advanced nickel-base disk alloy" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由J. Gayda和T. Gabb合著的科学论文，发表于《Superalloys 2004》。该论文主要研究了双重微观结构热处理对一种先进镍基盘用高温合金性能的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
