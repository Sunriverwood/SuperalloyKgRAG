        <attvalues>
          <attvalue for="11" value="DEFINES" />
          <attvalue for="12" value="Equation (2.28a) provides a formula for λ₁³." />
          <attvalue for="13" value="λ₁³ = 2Rh × (L²/h) = 2L²R = L²λ₁/cos{φ/2} (2.28a)" />
          <attvalue for="14" value="r-3" />
