        <attvalues>
          <attvalue for="11" value="CALCULATED_ON" />
          <attvalue for="12" value="The APB energy is calculated specifically on the {111} plane." />
          <attvalue for="13" value="The APB energy on the {111} plane is then 2Ω/(a²√3)" />
