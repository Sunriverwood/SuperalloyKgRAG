          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e215022d1d6f514980641a512c1ab4f3-e-3" label="L. W. Wilson">
        <attvalues>
          <attvalue for="0" value="L. W. Wilson" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="L. W. Wilson是一位研究人员，主要研究领域为燃气轮机应用的电子束气相沉积涂层。其作为作者撰写的相关研究论文曾发表于学术期刊《真空科学与技术杂志》（Journal of Vacuum Science and Technology）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
