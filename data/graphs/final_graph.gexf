          <attvalue for="9" value="13" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-cb57093a6357773efc0ab02b57f76fa1-e-21" label="Dr Pierre Caron">
        <attvalues>
          <attvalue for="0" value="Dr Pierre Caron" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="皮埃尔·卡隆博士（Dr Pierre Caron）是法国国家航空航天研究中心（ONERA）的科学家。作为该机构的关联人员，他专注于航空航天领域的研究工作。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-21" />
