        <attvalues>
          <attvalue for="0" value="A. M. Karlsson" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="A. M. Karlsson是一位作者，根据资料记载，其是S. Darzens的合著者，双方曾共同署名发表作品。" />
          <attvalue for="3" value="{}" />
