        <attvalues>
          <attvalue for="11" value="DECREASES" />
          <attvalue for="12" value="Air cooling resulted in a y' particle size of 170 nm, a decrease from the 250 nm associated with furnace cooling." />
          <attvalue for="13" value="because the y' particle size decreased from 250 nm to 170 nm" />
