      </node>
      <node id="chunk-e780ac83d97fe15870adf76ec9226ed9-e-9" label="pyrochlore-structured La2Zr2O7">
        <attvalues>
          <attvalue for="0" value="pyrochlore-structured La2Zr2O7" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="锆酸镧(La₂Zr₂O₇)是一种具有烧绿石晶体结构的先进陶瓷材料。因其具有极低的热导率和优异的高温稳定性，被视为极具潜力的新一代热障涂层材料。相关研究表明，可通过电子束物理气相沉积(EB-PVD)等技术将其制备成高性能涂层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-e780ac83d97fe15870adf76ec9226ed9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;pyrochlore-structured La2Zr2O7-based TBCs&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e780ac83d97fe15870adf76ec9226ed9-e-9&quot;, &quot;chunk-be8d9004ced79264b7784b3065b5da94-e-3&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-be8d9004ced79264b7784b3065b5da94-e-5" label="J. Wu et al.">
        <attvalues>
          <attvalue for="0" value="J. Wu et al." />
          <attvalue for="1" value="Authors" />
          <attvalue for="2" value="以J. Wu为主要作者的研究团队。该团队因其在《美国陶瓷学会杂志》(Journal of the American Ceramic Society)上发表了关于低热导率稀土锆酸盐的研究成果而知名。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-be8d9004ced79264b7784b3065b5da94" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-be8d9004ced79264b7784b3065b5da94-e-6" label="Low thermal conductivity rare-earth zirconate">
        <attvalues>
          <attvalue for="0" value="Low thermal conductivity rare-earth zirconate" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="低热导率稀土锆酸盐是一类具有烧绿石或萤石结构的先进陶瓷材料。它们以固有的极低热导率和优异的高温稳定性而著称，被视为极具潜力的新一代热障涂层候选材料，用于航空发动机和燃气轮机等高温部件的防护。" />
          <attvalue for="3" value="{&quot;property&quot;: &quot;Low thermal conductivity&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-be8d9004ced79264b7784b3065b5da94" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Zirconates&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e780ac83d97fe15870adf76ec9226ed9-e-4&quot;, &quot;chunk-be8d9004ced79264b7784b3065b5da94-e-6&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-be8d9004ced79264b7784b3065b5da94-e-9" label="R. Gadow and M. Lischka">
        <attvalues>
          <attvalue for="0" value="R. Gadow and M. Lischka" />
          <attvalue for="1" value="Authors" />
          <attvalue for="2" value="R. Gadow与M. Lischka是两位学术作者，以其共同撰写的一篇关于六铝酸镧（Lanthanum hexaaluminate）的科学出版物而知名。他们的研究工作聚焦于该特定材料的领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-be8d9004ced79264b7784b3065b5da94" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-be8d9004ced79264b7784b3065b5da94-e-10" label="Lanthanum hexaaluminate">
        <attvalues>
          <attvalue for="0" value="Lanthanum hexaaluminate" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="六铝酸镧（Lanthanum hexaaluminate）是一种化学式为LaAl₁₁O₁₈的陶瓷材料，具有磁铅石晶体结构。因其热导率低、高温稳定性好且抗热震性优异，被视为一种重要的新型热学材料，常用于制备热障涂层，应用于航空航天及燃气轮机等高温防护领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-be8d9004ced79264b7784b3065b5da94" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-be8d9004ced79264b7784b3065b5da94-e-10&quot;, &quot;chunk-3335ffc26fd60180a0fad8ac8e695ea9-e-1&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3335ffc26fd60180a0fad8ac8e695ea9-e-4" label="thermal barrier systems">
        <attvalues>
          <attvalue for="0" value="thermal barrier systems" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="热障系统是一种先进的多层材料体系，通常应用于航空发动机等高温部件表面，通过隔热保护基材，使其能在更高温度下安全工作，从而提升装备效率与寿命。它是一个活跃的研发领域，新兴材料和工艺正为其开发以不断提升性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-3335ffc26fd60180a0fad8ac8e695ea9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="217" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3335ffc26fd60180a0fad8ac8e695ea9-e-5" label="Emerging materials">
        <attvalues>
          <attvalue for="0" value="Emerging materials" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="一类为热障系统专门开发的新型材料的总称。它们通常指处于研发或应用初期，旨在提供高温隔热保护的先进材料，以提升关键部件在严苛环境下的性能与寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3335ffc26fd60180a0fad8ac8e695ea9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="217" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-72bc234ea267d66a5baa8214264163ee-e-1" label="J. M. Ziman">
        <attvalues>
          <attvalue for="0" value="J. M. Ziman" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="J. M. Ziman (John Michael Ziman, 1925-2005)，英国物理学家，专注于凝聚态物理学研究。他所撰写的《固体理论原理》(Principles of the Theory of Solids) 是该领域的经典教科书，影响深远。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-72bc234ea267d66a5baa8214264163ee" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-72bc234ea267d66a5baa8214264163ee-e-2" label="Principles of the Theory of Solids">
        <attvalues>
          <attvalue for="0" value="Principles of the Theory of Solids" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《固体理论原理》(Principles of the Theory of Solids) 是一部关于固体物理学的经典学术专著，由物理学家约翰·M·齐曼 (J. M. Ziman) 撰写。该书于1972年由剑桥大学出版社首次出版，是凝聚态物理领域的重要参考书。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1972&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-72bc234ea267d66a5baa8214264163ee" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-72bc234ea267d66a5baa8214264163ee-e-5" label="K. J. Lawson">
        <attvalues>
          <attvalue for="0" value="K. J. Lawson" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="K. J. Lawson是一位学者，作为作者之一撰写了关于材料科学的研究论文《降低EB-PVD热障涂层导热系数的方法》。该研究聚焦于通过电子束物理气相沉积（EB-PVD）技术改进热障涂层性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-72bc234ea267d66a5baa8214264163ee" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-72bc234ea267d66a5baa8214264163ee-e-6" label="A. Johnstone">
        <attvalues>
          <attvalue for="0" value="A. Johnstone" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="A. Johnstone是一名学者，作为作者之一撰写了关于材料科学的学术论文《Methods to reduce the thermal conductivity of EB-PVD TBCs》，该论文研究降低电子束物理气相沉积（EB-PVD）热障涂层导热系数的方法。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-72bc234ea267d66a5baa8214264163ee" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-72bc234ea267d66a5baa8214264163ee-e-7" label="D. S. Rickerby">
        <attvalues>
          <attvalue for="0" value="D. S. Rickerby" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. S. Rickerby是一位研究人员，因其撰写了科学论文《降低EB-PVD TBCs热导率的方法》而知名。该研究属于材料科学领域，专注于探讨如何优化通过电子束物理气相沉积（EB-PVD）技术制备的热障涂层（TBCs）的隔热性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-72bc234ea267d66a5baa8214264163ee" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-72bc234ea267d66a5baa8214264163ee-e-8" label="Methods to reduce the thermal conductivity of EB-PVD TBCs">
        <attvalues>
          <attvalue for="0" value="Methods to reduce the thermal conductivity of EB-PVD TBCs" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由J. R. Nicholls等人合著的学术论文，于2002年发表在《Surface and Coatings Technology》期刊上。该论文主要研究并阐述了降低电子束物理气相沉积（EB-PVD）热障涂层（TBCs）热导率的多种方法。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2002&quot;, &quot;volume&quot;: &quot;151–152&quot;, &quot;pages&quot;: &quot;383–391&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-72bc234ea267d66a5baa8214264163ee" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-65dc63e5f84c9fe26415a54961f65c33-e-1" label="I. O. Golosnoy">
        <attvalues>
          <attvalue for="0" value="I. O. Golosnoy" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="I. O. Golosnoy是一位学者，他是学术论文《等离子喷涂热障涂层热流模拟的分析模型》的作者，其研究聚焦于材料科学领域中热障涂层的热流分析与建模。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-65dc63e5f84c9fe26415a54961f65c33" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-65dc63e5f84c9fe26415a54961f65c33-e-2" label="S. A. Tsipas">
        <attvalues>
          <attvalue for="0" value="S. A. Tsipas" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="S. A. Tsipas是一名研究人员，因合著学术论文《等离子喷涂热障涂层热流模拟分析模型》而知名。该研究为先进涂层材料中的热传导现象提供了数学分析模型，属于材料科学与热工程领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-65dc63e5f84c9fe26415a54961f65c33" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-65dc63e5f84c9fe26415a54961f65c33-e-4" label="An analytical model for simulation of heat flow in plasma-sprayed thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="An analytical model for simulation of heat flow in plasma-sprayed thermal barrier coatings" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由I. O. Golosnoy、S. A. Tsipas和T. W. Clyne合著的学术论文，发表于《Journal of Thermal Spray Technology》期刊。该文提出了一种解析模型，用于模拟等离子喷涂热障涂层中的热流过程。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2005&quot;, &quot;volume&quot;: &quot;14&quot;, &quot;pages&quot;: &quot;205–214&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-65dc63e5f84c9fe26415a54961f65c33" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-65dc63e5f84c9fe26415a54961f65c33-e-5" label="Journal of Thermal Spray Technology">
        <attvalues>
          <attvalue for="0" value="Journal of Thermal Spray Technology" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《热喷涂技术杂志》(Journal of Thermal Spray Technology)是一本由施普林格(Springer)为ASM热喷涂学会出版的同行评审学术期刊。该刊专注于热喷涂科学与工程的各个方面，内容涵盖材料加工、涂层性能、工艺诊断、建模与仿真及其实际应用等领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-65dc63e5f84c9fe26415a54961f65c33" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-65dc63e5f84c9fe26415a54961f65c33-e-6" label="U. Schulz">
        <attvalues>
          <attvalue for="0" value="U. Schulz" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="U. Schulz，材料科学领域的研究人员。他参与撰写了学术论文《Two-source jumping beam evaporation for advanced EB-PVD TBC Systems》，该论文探讨了一种用于制备先进热障涂层（TBC）的电子束物理气相沉积（EB-PVD）技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-65dc63e5f84c9fe26415a54961f65c33" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-65dc63e5f84c9fe26415a54961f65c33-e-6&quot;, &quot;chunk-65335c426f17131b3458c32075ac90d7-e-3&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-65dc63e5f84c9fe26415a54961f65c33-e-7" label="K. Fritscher">
        <attvalues>
          <attvalue for="0" value="K. Fritscher" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="K. Fritscher是一位研究人员。他是学术论文《Two-source jumping beam evaporation for advanced EB-PVD TBC Systems》的作者之一，该研究涉及材料科学领域中，关于先进电子束物理气相沉积（EB-PVD）热障涂层系统的创新蒸发技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-65dc63e5f84c9fe26415a54961f65c33" />
