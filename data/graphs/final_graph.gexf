        <attvalues>
          <attvalue for="11" value="IS_ANISOTROPIC_WITH_RESPECT_TO" />
          <attvalue for="12" value="The APB energy is anisotropic because the number of forbidden bonds depends on the crystallographic plane." />
          <attvalue for="13" value="The number of forbidden bonds is found to depend upon the crystallographic plane on which the APB resides [33] (see Figure 2.36); consequently, for this reason, the APB energy is anisotropic." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-96f36e4af04723225cb4d274300efd6e" />
