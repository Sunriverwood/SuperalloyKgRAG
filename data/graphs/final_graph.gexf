        <attvalues>
          <attvalue for="11" value="USED_IN" />
          <attvalue for="12" value="Nickel-based superalloys are used in critical components within gas turbine engines." />
          <attvalue for="13" value="Nickel-based superalloys represent a very important class of engineering material, finding widespread application for example in critical components within the gas turbine engines" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-562ab8120c986d32d5b96c3da5071063" />
          <attvalue for="16" value="0.0009521995810321843" />
