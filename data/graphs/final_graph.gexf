        <attvalues>
          <attvalue for="11" value="EQUALS" />
          <attvalue for="12" value="Under the condition that d = D, the actual life Np is equal to the reference life No." />
          <attvalue for="13" value="when d = D, the inclusion is at its most potent; then Np = No and p2 = 0." />
          <attvalue for="14" value="r-4" />
