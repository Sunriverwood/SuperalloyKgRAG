        <attvalues>
          <attvalue for="11" value="CONTROLS" />
          <attvalue for="12" value="The magnitude of the fatigue crack propagation rate controls the declarable fatigue life." />
          <attvalue for="13" value="since its magnitude controls the fatigue life which can be declared." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0" />
