      <edge source="chunk-88706c8690b0d2b2ae8b3e515c553936-e-5" target="chunk-306c5bd949573532d99c69946ae2e6b5-e-5" id="chunk-12839dddacb541f1c423c238ab49ba6e-r-3" weight="4.0">
        <attvalues>
          <attvalue for="11" value="IS_MORE_LIKELY_IN" />
          <attvalue for="12" value="By comparison with an isothermal test, spallation is more likely to occur during cyclic oxidation (represented by '1000 cycles')." />
          <attvalue for="13" value="spallation is much less likely in an isothermal 1000h test at 1150 °C than it is in 1000 cycles" />
          <attvalue for="14" value="r-3" />
