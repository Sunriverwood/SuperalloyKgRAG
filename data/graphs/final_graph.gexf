        <attvalues>
          <attvalue for="11" value="HAMPERS_DEVELOPMENT_OF" />
          <attvalue for="12" value="The unavailability of quantitative theory for nucleation is hampering the development of TBC lifetime estimation models." />
          <attvalue for="13" value="Currently, quantitative theory for this purpose is unavailable; this situation is hampering the development of models for TBC lifetime estimation which are physically based, such that the temporal evolution of defects is accounted for." />
          <attvalue for="14" value="r-1" />
