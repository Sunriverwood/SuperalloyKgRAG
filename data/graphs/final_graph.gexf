        <attvalues>
          <attvalue for="11" value="HAS_PROPERTY_VALUE" />
          <attvalue for="12" value="For pure nickel, the stiffness along the (100) direction, E(100), is 125 GPa." />
          <attvalue for="13" value="For the pure nickel data, this gives E(100) = 125 GPa." />
