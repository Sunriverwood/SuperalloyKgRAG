        <attvalues>
          <attvalue for="11" value="CONTAINS" />
          <attvalue for="12" value="N18 was designed with a relatively high concentration of Mo at 6.5 wt%." />
          <attvalue for="13" value="For this alloy, ... a relatively high concentration of Mo (6.5 wt%) were chosen [38];" />
