          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6368a72cf89a3485f9379d1f9ae026ed-e-3" label="materials-related curricula at universities">
        <attvalues>
          <attvalue for="0" value="materials-related curricula at universities" />
          <attvalue for="1" value="Educational Program" />
          <attvalue for="2" value="高等院校开设的专注于材料科学与工程的课程体系。这些课程涵盖各类材料的性能、制备与应用，通常包含对高温合金等特种先进材料的学习与研究内容。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-6368a72cf89a3485f9379d1f9ae026ed" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6368a72cf89a3485f9379d1f9ae026ed-e-4" label="Dr Mike Hicks">
        <attvalues>
          <attvalue for="0" value="Dr Mike Hicks" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="Dr Mike Hicks，罗尔斯·罗伊斯公司（Rolls-Royce plc）的材料首席技术专家。作为一名材料科学领域的资深专家，他在此职位上主要负责领导和规划公司在先进材料技术方面的研发方向、创新及核心技术战略。" />
          <attvalue for="3" value="{&quot;title&quot;: &quot;Chief Technologist – Materials&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-6368a72cf89a3485f9379d1f9ae026ed" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6368a72cf89a3485f9379d1f9ae026ed-e-4&quot;, &quot;chunk-77690a63edc0814cc6c868e5e4d95012-e-1&quot;]}]" />
          <attvalue for="9" value="28" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6368a72cf89a3485f9379d1f9ae026ed-e-5" label="Rolls-Royce plc">
        <attvalues>
          <attvalue for="0" value="Rolls-Royce plc" />
          <attvalue for="1" value="Company" />
          <attvalue for="2" value="罗尔斯·罗伊斯股份有限公司（Rolls-Royce plc）是一家英国跨国公司，核心业务为航空航天发动机的设计与制造，并涉足船舶及能源动力系统。该公司是独立的法人实体，与宝马集团旗下的豪华汽车制造商劳斯莱斯汽车（Rolls-Royce Motor Cars）无关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-6368a72cf89a3485f9379d1f9ae026ed" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6368a72cf89a3485f9379d1f9ae026ed-e-5&quot;, &quot;chunk-77690a63edc0814cc6c868e5e4d95012-e-2&quot;, &quot;chunk-8037aec19ea88422e6032e36e14ec0c5-e-10&quot;, &quot;chunk-a584f7fe38f352b7318e0169178d3d01-e-7&quot;]}]" />
          <attvalue for="9" value="28" />
          <attvalue for="10" value="14" />
        </attvalues>
      </node>
      <node id="chunk-77690a63edc0814cc6c868e5e4d95012-e-5" label="Chromium">
        <attvalues>
          <attvalue for="0" value="Chromium" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="铬（Cr）是一种化学元素，为坚硬且耐腐蚀的过渡金属。在材料科学领域，它是一种γ相分配元素（y-partitioning element），在特定合金（如高温合金）的相变过程中，会优先富集于γ（奥氏体）相中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-77690a63edc0814cc6c868e5e4d95012" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Chromium (Cr)&quot;, &quot;Cr&quot;, &quot;Cr (Chromium)&quot;, &quot;chromium&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-77690a63edc0814cc6c868e5e4d95012-e-5&quot;, &quot;chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-6&quot;, &quot;chunk-e1a389bc8645b3e7fa58f05c1e0a798f-e-6&quot;, &quot;chunk-b674e36d570cafb7928d33912e7c1b02-e-3&quot;, &quot;chunk-58a0b5872320286acd36be7afd8ed1ba-e-6&quot;, &quot;chunk-3031ff2205f827feea0affe73ca7d2ae-e-11&quot;, &quot;chunk-84e66d4c5b0aa04871a2cf1b578e46dd-e-2&quot;, &quot;chunk-44a103d3439804fea5910e3206b26742-e-3&quot;, &quot;chunk-d55298f42964ce23c30b0bcafa72ab6c-e-8&quot;, &quot;chunk-2292cbd804c7d75d1e8a3ada6e8b42bd-e-8&quot;, &quot;chunk-fda27af1d78f24b216020258d3d0926f-e-2&quot;, &quot;chunk-bb636c80a00702ec9bbe14461e908287-e-4&quot;, &quot;chunk-948eb47dbdfa551b6fd68c0a7d42b94a-e-3&quot;, &quot;chunk-84d1269d81f3d4fb66cfdbb567801e32-e-4&quot;, &quot;chunk-489a70985937a8298a8310efcc20db59-e-3&quot;, &quot;chunk-ece73a04275b10b6ad2874686306213a-e-3&quot;, &quot;chunk-def444476734c5b41ca30b16989718fd-e-4&quot;, &quot;chunk-fbbf41abcd4950c59415caeec768db40-e-13&quot;, &quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-8&quot;, &quot;chunk-23893d297564190aa46fd314ec1e6f0e-e-6&quot;, &quot;chunk-1ad3d9def6416eb2826a0448d6287c6f-e-12&quot;, &quot;chunk-466225ab73e7ea49ac0af36e5725c4c1-e-2&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-77690a63edc0814cc6c868e5e4d95012-e-6" label="Aluminium">
        <attvalues>
          <attvalue for="0" value="Aluminium" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="铝（Aluminium）是一种化学元素，化学符号为Al，原子序数为13。它是一种银白色的轻金属，具有良好的延展性、导电性和导热性。铝是地壳中含量最丰富的金属元素，其合金因质量轻、强度高和耐腐蚀的特性，被广泛应用于航空航天、建筑、交通运输及包装等领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-77690a63edc0814cc6c868e5e4d95012" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Al&quot;, &quot;Al (Aluminum)&quot;, &quot;Aluminum (Al)&quot;, &quot;aluminium&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-77690a63edc0814cc6c868e5e4d95012-e-6&quot;, &quot;chunk-8cc148c1ca974c554ee456036519b0b3-e-6&quot;, &quot;chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-7&quot;, &quot;chunk-3ff783a5b26a130b0577173680195866-e-9&quot;, &quot;chunk-f6159d3dd840711c5298adf7f057d3b6-e-5&quot;, &quot;chunk-ed24a575ccc7da550855ce4a7d4ebb9f-e-5&quot;, &quot;chunk-9a58de583a6c9c66ff501b98683b07d7-e-6&quot;, &quot;chunk-a4d65971a0e96c0f576b576adadc50ce-e-2&quot;, &quot;chunk-e1a389bc8645b3e7fa58f05c1e0a798f-e-9&quot;, &quot;chunk-a00605aad03a48315b6372d73ae11d54-e-5&quot;, &quot;chunk-2b6a04ecc641ed4c1cec1b3e414ec201-e-5&quot;, &quot;chunk-99e1c2354bf8364a02d01889797902c8-e-1&quot;, &quot;chunk-d55298f42964ce23c30b0bcafa72ab6c-e-9&quot;, &quot;chunk-b01056d7d0ec300f60d9bb3706353f8f-e-3&quot;, &quot;chunk-fda27af1d78f24b216020258d3d0926f-e-3&quot;, &quot;chunk-db8701f768a162b189950d821beb70d9-e-5&quot;, &quot;chunk-948eb47dbdfa551b6fd68c0a7d42b94a-e-2&quot;, &quot;chunk-8fe8d1c616def00dd2818c380aea80d6-e-3&quot;, &quot;chunk-c577786ed818c3adfe9e2cc146b9c0be-e-1&quot;, &quot;chunk-8ae2a6e700e675a50e2388df07f07883-e-4&quot;, &quot;chunk-3ef3a46d5883ceba55b19f3ce086fd54-e-12&quot;, &quot;chunk-ece73a04275b10b6ad2874686306213a-e-4&quot;, &quot;chunk-070dbf53e1878b9845a3e7782a58ad66-e-10&quot;, &quot;chunk-def444476734c5b41ca30b16989718fd-e-1&quot;, &quot;chunk-23893d297564190aa46fd314ec1e6f0e-e-1&quot;, &quot;chunk-3ca8a51d3be3a429f4f741571769150f-e-4&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="19" />
        </attvalues>
      </node>
      <node id="chunk-b3a801531784aa7ab699c1b1f24edd83-e-3" label="Modern civil aircraft">
        <attvalues>
          <attvalue for="0" value="Modern civil aircraft" />
          <attvalue for="1" value="Vehicle" />
          <attvalue for="2" value="一种由航空发动机提供动力的现代非军事飞行器。它主要用于执行客运、货运等民用航空任务，是当代社会中远距离公共交通和全球物流的关键运输工具。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-b3a801531784aa7ab699c1b1f24edd83" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b3a801531784aa7ab699c1b1f24edd83-e-4" label="Turbines">
        <attvalues>
          <attvalue for="0" value="Turbines" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="航空发动机的核心热端部件。它将高温燃气的能量转化为旋转机械功，用以驱动压气机。因其工作在发动机温度最高的区域，其叶片等关键零件通常采用耐受极高温度的超级合金材料制造。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-b3a801531784aa7ab699c1b1f24edd83" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-97a0a28a657f3432d5d667cd779eea4b-e-3" label="Jet aeroplane">
        <attvalues>
          <attvalue for="0" value="Jet aeroplane" />
          <attvalue for="1" value="Vehicle" />
          <attvalue for="2" value="一种以喷气发动机为动力来源的固定翼航空器。由于其发动机在极端高温高压环境下工作，涡轮叶片等核心部件的制造必须依赖具有优异耐热和抗氧化性能的高温合金。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-97a0a28a657f3432d5d667cd779eea4b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-97a0a28a657f3432d5d667cd779eea4b-e-4" label="Airbus A380">
        <attvalues>
          <attvalue for="0" value="Airbus A380" />
          <attvalue for="1" value="Vehicle" />
          <attvalue for="2" value="空中客车A380是由空中客车公司制造的四引擎、双层远程宽体客机，是全球体型最大、载客量最高的民航飞机。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-97a0a28a657f3432d5d667cd779eea4b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-97a0a28a657f3432d5d667cd779eea4b-e-5" label="Boeing 787 Dreamliner">
        <attvalues>
          <attvalue for="0" value="Boeing 787 Dreamliner" />
          <attvalue for="1" value="Aircraft" />
          <attvalue for="2" value="波音787梦想飞机（Boeing 787 Dreamliner）是由波音公司研制的中型双发宽体客机。它是航空史上首款以碳纤维复合材料为主体材料的民用喷气式飞机，以其卓越的燃油效率和远程飞行能力而闻名。该机型可选配通用电气GEnx或罗尔斯·罗伊斯遄达1000发动机。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-97a0a28a657f3432d5d667cd779eea4b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-97a0a28a657f3432d5d667cd779eea4b-e-5&quot;, &quot;chunk-3031ff2205f827feea0affe73ca7d2ae-e-7&quot;, &quot;chunk-49678bb9dd21687268c5616ea6e657b4-e-3&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-86d807c2e09f9a36246a74f6393dba7c-e-3" label="Electricity">
        <attvalues>
          <attvalue for="0" value="Electricity" />
          <attvalue for="1" value="Product" />
          <attvalue for="2" value="一种由电荷的静止或移动所产生的物理现象，是重要的二次能源。它可通过多种方式（如陆基涡轮系统）产生，并通过电网输送，广泛应用于生产和生活领域，作为驱动设备和照明的动力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-86d807c2e09f9a36246a74f6393dba7c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-86d807c2e09f9a36246a74f6393dba7c-e-4" label="Fuel economy">
        <attvalues>
          <attvalue for="0" value="Fuel economy" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="燃油经济性 (Fuel economy) 是一项衡量发动机或载具能源转换效率的性能指标，用于量化燃料的化学能转化为动能或功的效率。它通常以单位燃料行驶的距离或行驶单位距离的燃料消耗量来表示。通过提升发动机运行条件（如温度、压力）可以有效改善此项指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-86d807c2e09f9a36246a74f6393dba7c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Fuel Economy&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-86d807c2e09f9a36246a74f6393dba7c-e-4&quot;, &quot;chunk-f23239a1bb5839c40c8b54140289d1ce-e-3&quot;, &quot;chunk-c66ff8a529b9512996f0b3af456f00ce-e-1&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-86d807c2e09f9a36246a74f6393dba7c-e-5" label="Carbon emissions">
        <attvalues>
          <attvalue for="0" value="Carbon emissions" />
          <attvalue for="1" value="Environmental Factor" />
          <attvalue for="2" value="碳排放指含碳温室气体（主要是二氧化碳）被释放到大气中的过程。它主要源于化石燃料的燃烧、工业生产和人类活动，是加剧全球变暖和气候变化的主要驱动因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-86d807c2e09f9a36246a74f6393dba7c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-86d807c2e09f9a36246a74f6393dba7c-e-6" label="Higher operating conditions">
        <attvalues>
          <attvalue for="0" value="Higher operating conditions" />
          <attvalue for="1" value="Operating Condition" />
          <attvalue for="2" value="一种由超合金等先进材料实现的、允许发动机在更高温度和压力下工作的运行工况。这种工况能显著提升燃油经济性、提高能源效率，并有效减少碳排放等污染物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-86d807c2e09f9a36246a74f6393dba7c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-86d807c2e09f9a36246a74f6393dba7c-e-8" label="Ultra-efficient power generation systems">
        <attvalues>
          <attvalue for="0" value="Ultra-efficient power generation systems" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="超高效发电系统（Ultra-efficient power generation systems）是指旨在最大限度提高能量转换效率的新一代先进电力系统。这类系统通常在更高温度和压力等极端工况下运行，因此其发展依赖于超级合金冶金学的技术突破，以研发出能承受此严苛环境的先进材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-86d807c2e09f9a36246a74f6393dba7c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6e0983cf58b9c26b71630200f3b8184c-e-1" label="Power generation capacity">
        <attvalues>
          <attvalue for="0" value="Power generation capacity" />
          <attvalue for="1" value="System Capacity" />
          <attvalue for="2" value="发电能力（或称装机容量）指发电系统在单位时间内能发出的最大电功率，通常以兆瓦（MW）为单位。它是衡量一个国家或地区电力供应潜力的核心指标，反映其满足工业生产和居民生活等社会经济发展需求的能力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-6e0983cf58b9c26b71630200f3b8184c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="92" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6e0983cf58b9c26b71630200f3b8184c-e-2" label="Developing countries">
        <attvalues>
          <attvalue for="0" value="Developing countries" />
          <attvalue for="1" value="Geopolitical Region" />
          <attvalue for="2" value="发展中国家，又称开发中国家，泛指经济、工业及人类发展指数相对较低的国家。其典型特征是经济与人口常处于快速增长阶段，导致对电力等基础设施的需求也随之迅速增加。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-6e0983cf58b9c26b71630200f3b8184c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="92" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6e0983cf58b9c26b71630200f3b8184c-e-3" label="Developed countries">
        <attvalues>
          <attvalue for="0" value="Developed countries" />
          <attvalue for="1" value="Geopolitical Region" />
          <attvalue for="2" value="发达国家，又称已开发国家，是指经济发展水平高、技术先进、生活品质优越的国家集合。其普遍特征为高人均生产总值（GDP）、高度工业化、完善的基础设施以及高人类发展指数（HDI）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
