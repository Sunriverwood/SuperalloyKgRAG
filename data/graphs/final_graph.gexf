      <edge source="chunk-499702b336b2277c0acd3c75976b9758-e-7" target="chunk-cae41d8859f876b74046ac829e1e4b4c-e-9" id="chunk-cae41d8859f876b74046ac829e1e4b4c-r-5" weight="4.0">
        <attvalues>
          <attvalue for="11" value="IS_ASSUMED_IN" />
          <attvalue for="12" value="The scatter factor is an assumed value within the safe life calculation procedure." />
          <attvalue for="13" value="en this assumed scatter factor, the life corresponding to the lower 1/750 quartile is located at a factor of √6 below the geometric mean obtained from the spin testing." />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-cae41d8859f876b74046ac829e1e4b4c" />
