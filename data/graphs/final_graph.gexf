        <attvalues>
          <attvalue for="11" value="USED_TO_DETERMINE" />
          <attvalue for="12" value="Quantitative metallography is one of the approaches employed to glean the necessary information about particle size distribution." />
          <attvalue for="13" value="To glean the necessary information, different approaches have been employed. Quantitative metallography has been used to examine plane, polished cross-sections." />
          <attvalue for="14" value="r-2" />
