        <attvalues>
          <attvalue for="11" value="CAN_INTRODUCE" />
          <attvalue for="12" value="The stage involving material suppliers presents a risk that defects will be introduced." />
          <attvalue for="13" value="quite lengthy, involving a number of material suppliers, melters and forgemasters; at each stage there is a risk that defects will be introduced." />
          <attvalue for="14" value="r-1" />
