        <attvalues>
          <attvalue for="11" value="IS_A" />
          <attvalue for="12" value="Titanium (Ti) is an example of a y'-forming element." />
          <attvalue for="13" value="Clearly, significant reliance is being placed on the y'-forming elements such as Ta and Ti." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-a4d65971a0e96c0f576b576adadc50ce" />
