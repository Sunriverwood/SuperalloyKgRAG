          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7f5d267485eb6b44a173a04ba9a301e4-e-2" label="Jain et al. [35]">
        <attvalues>
          <attvalue for="0" value="Jain et al. [35]" />
          <attvalue for="1" value="Researcher" />
          <attvalue for="2" value="指由学者Jain等人领导的研究团队或其发表的科学文献（引用标记为[35]）。该研究的重点是分析掺杂对Udimet 720Li（一种镍基高温合金）性能所产生的影响。" />
