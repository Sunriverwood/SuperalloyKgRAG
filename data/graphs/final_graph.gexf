        <attvalues>
          <attvalue for="11" value="SUPPORTED" />
          <attvalue for="12" value="Cutting-edge superalloy development was conducted in support of engine designs for military aircraft." />
          <attvalue for="13" value="most cutting-edge superalloy development was carried out in support of engine designs for military aircraft" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24" />
