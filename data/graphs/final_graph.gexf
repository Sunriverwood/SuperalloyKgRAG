      <node id="chunk-ab782043d3ae1a90c5f1e5036270c1d8-e-1" label="g beam evaporation for advanced EB-PVD TBC Systems">
        <attvalues>
          <attvalue for="0" value="g beam evaporation for advanced EB-PVD TBC Systems" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇发表于《表面与涂层技术》（Surface and Coatings Technology）期刊的学术出版物。该文主要研究用于制备先进热障涂层（TBC）系统的电子束物理气相沉积（EB-PVD）技术中的蒸发工艺。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2000&quot;, &quot;volume&quot;: &quot;133–134&quot;, &quot;pages&quot;: &quot;40–48&quot;}" />
