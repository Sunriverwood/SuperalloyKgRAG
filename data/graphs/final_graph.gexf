        <attvalues>
          <attvalue for="11" value="ALTERS_MECHANISM_OF" />
          <attvalue for="12" value="Temperature alters the mechanism of fatigue crack growth, shifting from {111} planes at low temperatures to involving {001} facets at higher temperatures." />
          <attvalue for="13" value="At low temperatures, fatigue crack growth is found to occur parallel to slip band traces and thus along {111} planes; but, as the temperature increases, {001} facets become increasingly common" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd" />
          <attvalue for="16" value="0.0006102212051868803" />
          <attvalue for="17" value="0.13369946605644545" />
        </attvalues>
