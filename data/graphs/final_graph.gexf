      <node id="chunk-e408a73fcde801378877f777a7391169-e-2" label="MCrAlY cast materials">
        <attvalues>
          <attvalue for="0" value="MCrAlY cast materials" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="MCrAlY铸造材料是一类通过铸造工艺制备的镍基或钴基高温合金。其成分包含铬(Cr)、铝(Al)和钇(Y)，因能在高温下形成稳定的保护性氧化膜，而具有卓越的抗氧化与抗腐蚀性能，常用于航空发动机和燃气轮机的热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-e408a73fcde801378877f777a7391169" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e408a73fcde801378877f777a7391169-e-4" label="W. B. Kent">
        <attvalues>
          <attvalue for="0" value="W. B. Kent" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="W. B. Kent是一位编辑，因担任《Superalloys 1984》一书的编辑而知名。该出版物是第五届国际高温合金研讨会的官方会议论文集，汇集了当时高温合金领域的关键研究与进展。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-e408a73fcde801378877f777a7391169" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e408a73fcde801378877f777a7391169-e-4&quot;, &quot;chunk-df56dbe04dca860f9b208ab9b4878418-e-16&quot;, &quot;chunk-6eb9964e0070cc2b73d942919084bb21-e-4&quot;]}]" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e408a73fcde801378877f777a7391169-e-5" label="M. Gell">
        <attvalues>
          <attvalue for="0" value="M. Gell" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="M. Gell是一位研究人员，作为作者之一发表了关于热障涂层粘合强度、应力和剥落机制的学术论文《Bond strength, bond stress and spallation mechanisms of thermal barrier coatings》。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e408a73fcde801378877f777a7391169" />
          <attvalue for="6" value="true" />
