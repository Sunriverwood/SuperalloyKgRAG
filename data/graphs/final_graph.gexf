        <attvalues>
          <attvalue for="11" value="ACCELERATES" />
          <attvalue for="12" value="The remaining useful work from the core is used to accelerate the core air." />
          <attvalue for="13" value="The remaining useful work is used to accelerate the core air to a rather modest Vjet." />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-cdeb193bdb0bc0bd0987151c84c2d210" />
