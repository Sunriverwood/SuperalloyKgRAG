        <attvalues>
          <attvalue for="11" value="IS_APPROXIMATED_BY" />
          <attvalue for="12" value="The probability of an inclusion intersecting the free surface (P1) is approximated by the quantity 1 DS/V." />
          <attvalue for="13" value="to a first approximation, it is given by the quantity 1 DS/V, if stereological effects associated with the intersection of the particle with the free surface are neglected." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-b5f676dc61935d68cc39272b74bbea4b" />
