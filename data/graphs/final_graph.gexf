        <attvalues>
          <attvalue for="11" value="USED_AFTER" />
          <attvalue for="12" value="NDE is used on the turbine disc after it is removed from the engine and before it is placed back in service." />
          <attvalue for="13" value="...and then whenever the disc is removed from the engine, prior to a decision being made to place it back in service" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-0cc0ddc3943d8f2fd7c506b872a6a90c" />
          <attvalue for="16" value="0.0012028869286287089" />
