        <attvalues>
          <attvalue for="11" value="REQUIRES" />
          <attvalue for="12" value="Ultrasonic testing requires forgings to have a geometry very close to the 'sonic shape'." />
          <attvalue for="13" value="Second, significant savings in material can be made since forgings can be produced of a geometry very close to the ‘sonic shape' required by ultrasonic testing." />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-bdd419f61b4df7e511da7b854e288ce6" />
          <attvalue for="16" value="0.007217321571772253" />
          <attvalue for="17" value="0.4043303929430634" />
        </attvalues>
