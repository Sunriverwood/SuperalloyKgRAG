      <edge source="chunk-5abc3c05849dadfca952537bf1c8dc41-e-3" target="chunk-d55298f42964ce23c30b0bcafa72ab6c-e-13" id="chunk-5abc3c05849dadfca952537bf1c8dc41-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="REQUIRES" />
          <attvalue for="12" value="The oxidation resistance of the superalloy substrate is a critical property, especially when a TBC system is not used." />
          <attvalue for="13" value="oxidation resistance of the superalloy substrate will remain critical when the TBC system cannot be afforded" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-5abc3c05849dadfca952537bf1c8dc41" />
          <attvalue for="16" value="0.00013599891200870393" />
          <attvalue for="17" value="0.4000815993472052" />
        </attvalues>
      </edge>
      <edge source="chunk-5abc3c05849dadfca952537bf1c8dc41-e-5" target="chunk-5abc3c05849dadfca952537bf1c8dc41-e-6" id="chunk-5abc3c05849dadfca952537bf1c8dc41-r-3" weight="4.0">
        <attvalues>
          <attvalue for="11" value="IS_USED_IN" />
          <attvalue for="12" value="The TBC system is a technology used in turbines, though it may not always be affordable." />
          <attvalue for="13" value="when the TBC system cannot be afforded as is still the case for many turbines." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-5abc3c05849dadfca952537bf1c8dc41" />
          <attvalue for="16" value="0.5" />
          <attvalue for="17" value="0.5666666666666667" />
        </attvalues>
      </edge>
      <edge source="chunk-5abc3c05849dadfca952537bf1c8dc41-e-9" target="chunk-5abc3c05849dadfca952537bf1c8dc41-e-10" id="chunk-5abc3c05849dadfca952537bf1c8dc41-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="RESISTS" />
          <attvalue for="12" value="Superalloy turbine discs were traditionally designed to resist general yielding." />
          <attvalue for="13" value="Traditionally, superalloy turbine discs were designed to resist general yielding" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-5abc3c05849dadfca952537bf1c8dc41" />
          <attvalue for="16" value="3.4806822137138876e-05" />
          <attvalue for="17" value="0.4000208840932823" />
        </attvalues>
      </edge>
      <edge source="chunk-024c36ea3394fc7ba3bfdd8df0168497-e-1" target="chunk-5abc3c05849dadfca952537bf1c8dc41-e-10" id="chunk-024c36ea3394fc7ba3bfdd8df0168497-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DESIGNED_TO_RESIST" />
          <attvalue for="12" value="Superalloy turbine discs were traditionally designed to resist general yielding." />
          <attvalue for="13" value="Traditionally, superalloy turbine discs were designed to resist general yielding and low- cycle-fatigue cracking at sites of stress concentration near the bore" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-024c36ea3394fc7ba3bfdd8df0168497" />
          <attvalue for="16" value="0.0013226592412112774" />
          <attvalue for="17" value="0.40079359554472677" />
        </attvalues>
      </edge>
      <edge source="chunk-024c36ea3394fc7ba3bfdd8df0168497-e-1" target="chunk-024c36ea3394fc7ba3bfdd8df0168497-e-3" id="chunk-024c36ea3394fc7ba3bfdd8df0168497-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DESIGNED_TO_RESIST" />
          <attvalue for="12" value="Superalloy turbine discs were traditionally designed to resist low-cycle-fatigue cracking." />
          <attvalue for="13" value="Traditionally, superalloy turbine discs were designed to resist general yielding and low- cycle-fatigue cracking at sites of stress concentration near the bore" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-024c36ea3394fc7ba3bfdd8df0168497" />
          <attvalue for="16" value="0.002645318482422555" />
          <attvalue for="17" value="0.40158719108945357" />
        </attvalues>
      </edge>
