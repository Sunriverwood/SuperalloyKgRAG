      <edge source="chunk-c2bce381433d364861cf87ccbd650b94-e-1" target="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-4" id="chunk-c2bce381433d364861cf87ccbd650b94-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CONTAINS" />
          <attvalue for="12" value="Second-generation single-crystal superalloys contain Rhenium at a level of about 3 wt%." />
          <attvalue for="13" value="In the second-generation single-crystal superalloys, Re was added at levels of about 3 wt%, in view of its potent creep strengthening effect." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-c2bce381433d364861cf87ccbd650b94" />
          <attvalue for="16" value="0.002225169466548777" />
          <attvalue for="17" value="0.4013351016799293" />
        </attvalues>
      </edge>
      <edge source="chunk-c2bce381433d364861cf87ccbd650b94-e-3" target="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-4" id="chunk-c2bce381433d364861cf87ccbd650b94-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CONTAINS" />
          <attvalue for="12" value="Third-generation superalloys contain Rhenium at an increased concentration of 6 wt%." />
          <attvalue for="13" value="Concentrations of Re were subsequently increased to 6 wt% in the third-generation alloys to exploit further the so-called ‘Re-effect'." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-c2bce381433d364861cf87ccbd650b94" />
          <attvalue for="16" value="0.002225169466548777" />
          <attvalue for="17" value="0.4013351016799293" />
        </attvalues>
      </edge>
      <edge source="chunk-c2bce381433d364861cf87ccbd650b94-e-3" target="chunk-c2bce381433d364861cf87ccbd650b94-e-5" id="chunk-c2bce381433d364861cf87ccbd650b94-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="FORMS" />
          <attvalue for="12" value="Third-generation superalloys are unstable and can form topologically close-packed (TCP) phases." />
          <attvalue for="13" value="It is now recognised that the third-generation superalloys – which are heavily alloyed with Re are unstable with respect to the formation of topologically close-packed (TCP) phases." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-c2bce381433d364861cf87ccbd650b94" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
