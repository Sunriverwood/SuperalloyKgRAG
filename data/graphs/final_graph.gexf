      <edge source="chunk-91405e06bb69c5ec0eb63c43e028bfc6-e-1" target="chunk-c170c36341964554c175d2ca279d86c6-e-6" id="chunk-91405e06bb69c5ec0eb63c43e028bfc6-r-6" weight="4.0">
        <attvalues>
          <attvalue for="11" value="EXHIBITS" />
          <attvalue for="12" value="The text discusses determining the elastic anisotropy of nickel." />
          <attvalue for="13" value="Given the above considerations, it is interesting to determine whether the elastic anisotropy of nickel is greater or less than that displayed by other cubic" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-91405e06bb69c5ec0eb63c43e028bfc6" />
          <attvalue for="17" value="0.26666666666666666" />
        </attvalues>
      </edge>
      <edge source="chunk-3ff783a5b26a130b0577173680195866-e-2" target="chunk-c170c36341964554c175d2ca279d86c6-e-6" id="chunk-3ff783a5b26a130b0577173680195866-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="QUANTIFIES" />
          <attvalue for="12" value="The 'anisotropy factor', A, is defined to determine the elastic anisotropy of a material." />
          <attvalue for="13" value="It is helpful to define an 'anisotropy factor', A, according to A = 2C44 / (C11 - C12) which will be unity in the case of isotropy." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-3ff783a5b26a130b0577173680195866" />
          <attvalue for="16" value="0.005355276907001045" />
          <attvalue for="17" value="0.40321316614420066" />
        </attvalues>
      </edge>
      <edge source="chunk-3ff783a5b26a130b0577173680195866-e-3" target="chunk-3ff783a5b26a130b0577173680195866-e-2" id="chunk-3ff783a5b26a130b0577173680195866-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_VALUE_FOR" />
          <attvalue for="12" value="The anisotropy factor value for Nickel (Ni) is 2.44." />
          <attvalue for="13" value="The value for Ni is 2.44, which compares with Cu at 3.19, Ag at 2.97, Au at 2.90, Ge at 1.65, Si at 1.57 and Al at 1.22, for other cubic metals." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-3ff783a5b26a130b0577173680195866" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
