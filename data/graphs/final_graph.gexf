      <node id="chunk-9de67a861b4260c65467b4b0d1d09a13-e-4" label="Journal of the Electrochemical Society">
        <attvalues>
          <attvalue for="0" value="Journal of the Electrochemical Society" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《电化学学会杂志》(Journal of the Electrochemical Society)是由电化学学会(ECS)出版的、经同行评审的权威科学期刊。该期刊专注于发表固态与电化学科学技术领域的原创研究，内容涵盖电池、腐蚀、半导体材料、传感器及电化学工程等方向。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-9de67a861b4260c65467b4b0d1d09a13" />
