        <attvalues>
          <attvalue for="11" value="IS_PREPARED_FOR" />
          <attvalue for="12" value="A shaped superalloy billet is made into a form suitable for heat treatment." />
          <attvalue for="13" value="...into a form suitable for heat treatment and ultrasonic inspection." />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-e0ff1a8ba2325330670b26bb64b4b73d" />
          <attvalue for="16" value="0.012252001392272885" />
          <attvalue for="17" value="0.2740178675020304" />
        </attvalues>
