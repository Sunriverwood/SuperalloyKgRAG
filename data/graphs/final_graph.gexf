        <attvalues>
          <attvalue for="11" value="PREVENTS" />
          <attvalue for="12" value="Superclean melting technology aims to prevent non-metallic inclusions from being incorporated into superalloys." />
          <attvalue for="13" value="the superalloy industry on 'superclean melting technology' – the aim of which is to prevent non-metallic inclusions from becoming incorporated into superalloy forging stock" />
