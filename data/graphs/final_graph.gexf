        <attvalues>
          <attvalue for="11" value="IS_DERIVED_FROM" />
          <attvalue for="12" value="Δα is the difference in thermal expansion coefficients between the TBC and the substrate." />
          <attvalue for="13" value="where ∆α is the difference in thermal expansion coefficients of TBC and substrate" />
