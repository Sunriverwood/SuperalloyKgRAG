          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5b143324ae92718a4dde1cd69bd72bd2-e-7&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5b143324ae92718a4dde1cd69bd72bd2-e-8" label="Nickel-61">
        <attvalues>
          <attvalue for="0" value="Nickel-61" />
          <attvalue for="1" value="Isotope" />
          <attvalue for="2" value="镍-61（⁶¹Ni）是化学元素镍的一种稳定同位素，其原子核由28个质子和33个中子构成。它是镍在自然界中存在的五种稳定同位素之一，丰度约为1.14%。" />
          <attvalue for="3" value="{&quot;probability&quot;: &quot;1.25%&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-5b143324ae92718a4dde1cd69bd72bd2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Isotope 61&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5b143324ae92718a4dde1cd69bd72bd2-e-8&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5b143324ae92718a4dde1cd69bd72bd2-e-9" label="Nickel-62">
        <attvalues>
          <attvalue for="0" value="Nickel-62" />
          <attvalue for="1" value="Isotope" />
          <attvalue for="2" value="镍-62（⁶²Ni）是化学元素镍的一种稳定同位素。它的原子核由28个质子和34个中子构成，是自然界中存在的五种稳定镍同位素之一。" />
          <attvalue for="3" value="{&quot;probability&quot;: &quot;3.66%&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-5b143324ae92718a4dde1cd69bd72bd2" />
          <attvalue for="6" value="true" />
