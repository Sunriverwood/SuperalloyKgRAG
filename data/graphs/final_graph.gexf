        </attvalues>
      </node>
      <node id="chunk-0873a0a95770ac23ed7add0b0ad4b3c0-e-1" label="J. K. Tien and F. S. Pettit">
        <attvalues>
          <attvalue for="0" value="J. K. Tien and F. S. Pettit" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="J. K. Tien与F. S. Pettit是研究人员，共同撰写了题为《Mechanism of oxide adherence on Fe-25Cr-4A1 (Y or Sc) alloys》的科学论文，该文研究了特定铁基合金上的氧化物附着机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-0873a0a95770ac23ed7add0b0ad4b3c0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0873a0a95770ac23ed7add0b0ad4b3c0-e-2" label="Fe-25Cr-4A1 (Y or Sc) alloys">
        <attvalues>
          <attvalue for="0" value="Fe-25Cr-4A1 (Y or Sc) alloys" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="一种铁基高温合金，名义成分包含约25%的铬(Cr)和4%的铝(Al)，并掺杂微量活性元素钇(Y)或钪(Sc)。这类合金的设计目的在于通过“活性元素效应”，显著增强其在高温下形成的氧化铝保护膜的附着力，从而获得优异的抗氧化性能。" />
          <attvalue for="3" value="{&quot;composition&quot;: &quot;Fe-25Cr-4Al&quot;, &quot;additives&quot;: &quot;Y or Sc&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-0873a0a95770ac23ed7add0b0ad4b3c0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0873a0a95770ac23ed7add0b0ad4b3c0-e-3" label="Oxide adherence">
        <attvalues>
          <attvalue for="0" value="Oxide adherence" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="氧化铝皮附着力（alumina scale adhesion）是一种物理现象，指在高温下，材料表面形成的氧化铝保护层与其下方基体或结合层之间的结合强度。这种附着性能是评估高温合金及热障涂层系统耐久性的关键指标，并受到基体与结合层化学成分的显著影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-0873a0a95770ac23ed7add0b0ad4b3c0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;alumina scale adhesion&quot;, &quot;protective oxide scale adherence&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0873a0a95770ac23ed7add0b0ad4b3c0-e-3&quot;, &quot;chunk-62f2a69b28a3f59402f17b59e67f8707-e-15&quot;, &quot;chunk-c2ec04cbf3c90264a785b174dcc622ba-e-6&quot;]}]" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-0873a0a95770ac23ed7add0b0ad4b3c0-e-4" label="J. E. Antill and K. A. Peakall">
        <attvalues>
          <attvalue for="0" value="J. E. Antill and K. A. Peakall" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="J. E. Antill与K. A. Peakall是合作发表论文的研究者，其研究内容为钇（Yttrium）元素对不锈钢氧化过程的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0873a0a95770ac23ed7add0b0ad4b3c0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0873a0a95770ac23ed7add0b0ad4b3c0-e-6" label="Austenitic and a ferritic stainless steel">
        <attvalues>
          <attvalue for="0" value="Austenitic and a ferritic stainless steel" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="奥氏体和铁素体不锈钢是一种含钇(Y)的铁基合金，涵盖奥氏体与铁素体两种主要晶体结构类型。根据上下文，其在二氧化碳(CO2)环境中的抗氧化性能是特定的研究对象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0873a0a95770ac23ed7add0b0ad4b3c0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0873a0a95770ac23ed7add0b0ad4b3c0-e-7" label="Carbon dioxide">
        <attvalues>
          <attvalue for="0" value="Carbon dioxide" />
          <attvalue for="1" value="Environment" />
          <attvalue for="2" value="二氧化碳 (CO₂) 是一种无机化合物，在材料科学领域常作为一种特定的气体环境。它被用于研究金属材料（如奥氏体和铁素体不锈钢）在高温下的氧化和腐蚀行为，以评估其在含二氧化碳气氛中的性能和稳定性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-0873a0a95770ac23ed7add0b0ad4b3c0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0873a0a95770ac23ed7add0b0ad4b3c0-e-8" label="Oxidation behaviour">
        <attvalues>
          <attvalue for="0" value="Oxidation behaviour" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="氧化行为（Oxidation behaviour）是一种现象，指材料（尤其是金属和合金）在特定环境（通常为高温）下与氧或其它氧化剂发生化学反应的综合表现。它涵盖了氧化动力学、氧化产物的形态与结构、以及所形成氧化膜的保护性等一系列动态过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-0873a0a95770ac23ed7add0b0ad4b3c0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Oxidation Behavior&quot;, &quot;Oxidation Behaviour&quot;, &quot;oxidation behaviour&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-23667ab4826d0039e851f5cb53aa5455-e-3&quot;, &quot;chunk-0873a0a95770ac23ed7add0b0ad4b3c0-e-8&quot;, &quot;chunk-e59e76ae369265e25373e5545e9102c3-e-11&quot;, &quot;chunk-c8fee299c7ba0eef0fb9057ffd13203c-e-11&quot;, &quot;chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-2&quot;, &quot;chunk-2555e274f1223f9245526a48267868ff-e-11&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-d246d51e161275b250bc309214ccd241-e-1" label="J. E. McDonald">
        <attvalues>
          <attvalue for="0" value="J. E. McDonald" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="J. E. McDonald是一位学者或研究人员，其作为合著者发表了材料科学领域的出版物《Adhesion in aluminum oxide-metal systems》，该文研究氧化铝与金属间的粘附性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-d246d51e161275b250bc309214ccd241" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="86" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d246d51e161275b250bc309214ccd241-e-2" label="J. G. Eberhart">
        <attvalues>
          <attvalue for="0" value="J. G. Eberhart" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="J. G. Eberhart，一位作者，作为合著者参与撰写了出版物《氧化铝-金属体系中的附着力》(Adhesion in aluminum oxide-metal systems)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-d246d51e161275b250bc309214ccd241" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="86" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d246d51e161275b250bc309214ccd241-e-3" label="Adhesion in aluminum oxide-metal systems">
        <attvalues>
          <attvalue for="0" value="Adhesion in aluminum oxide-metal systems" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由J. E. McDonald与J. G. Eberhart合著的科学论文，发表于《美国矿业冶金工程师学会冶金会刊》(Transactions of the Metallurgical Society of AIME)。该文系统研究并阐述了氧化铝与金属两种材料构成的复合体系中，其界面间的附着力现象、理论及影响因素。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1965&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d246d51e161275b250bc309214ccd241" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="86" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-d246d51e161275b250bc309214ccd241-e-4" label="Transactions of the Metallurgical Society of AIME">
        <attvalues>
          <attvalue for="0" value="Transactions of the Metallurgical Society of AIME" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《Transactions of the Metallurgical Society of AIME》是由美国矿业、冶金和石油工程师协会（AIME）冶金学会出版的学术期刊。该刊于1957-1969年间发行，专注于冶金学及材料科学领域，后被《Metallurgical Transactions》取代。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d246d51e161275b250bc309214ccd241" />
          <attvalue for="6" value="true" />
