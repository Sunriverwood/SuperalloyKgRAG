      <node id="chunk-557dabfd98e07916fb11233921ddc06d-e-5" label="Distance 1–3">
        <attvalues>
          <attvalue for="0" value="Distance 1–3" />
          <attvalue for="1" value="Measurement" />
          <attvalue for="2" value="指在图1.12中描绘的一段特定距离，其长度与压缩功（Compression Work）的大小成正比，是压缩功的一种图形化衡量方式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-557dabfd98e07916fb11233921ddc06d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-557dabfd98e07916fb11233921ddc06d-e-6" label="Compression Work (CW)">
        <attvalues>
          <attvalue for="0" value="Compression Work (CW)" />
          <attvalue for="1" value="Work" />
          <attvalue for="2" value="压缩功（Compressor Work, CW）是一种热力学功，指外界为压缩气体，使其压力升高、体积减小所做的功。在特定工况下，其数值与系统中的透平功（Turbine Work, TW）相等。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-557dabfd98e07916fb11233921ddc06d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;CW&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-557dabfd98e07916fb11233921ddc06d-e-6&quot;, &quot;chunk-879f6969798c949bf5a7f72d18049a74-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-557dabfd98e07916fb11233921ddc06d-e-7" label="Distance 4–9">
        <attvalues>
          <attvalue for="0" value="Distance 4–9" />
          <attvalue for="1" value="Measurement" />
          <attvalue for="2" value="在图1.12中所示的一段距离测量值，其长度与系统所做的膨胀功（Work of Expansion, EW）大小成正比，是膨胀功的一种图形化表示和量度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-557dabfd98e07916fb11233921ddc06d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-557dabfd98e07916fb11233921ddc06d-e-8" label="Turbine Work (TW)">
        <attvalues>
          <attvalue for="0" value="Turbine Work (TW)" />
          <attvalue for="1" value="Thermodynamic Work" />
          <attvalue for="2" value="TW是透平功（Turbine Work）的缩写，一种热力学功。它代表透平（涡轮）设备对外输出的机械功。在此特定热力学系统中，其功的数值等于压缩机功（Compressor Work, CW）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-557dabfd98e07916fb11233921ddc06d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;TW&quot;, &quot;Turbine Work&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-557dabfd98e07916fb11233921ddc06d-e-8&quot;, &quot;chunk-35e59a51ed8121212e1426f0053ba534-e-6&quot;, &quot;chunk-879f6969798c949bf5a7f72d18049a74-e-5&quot;, &quot;chunk-38bfa031d75570a78eacff17ed6bac4a-e-4&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-557dabfd98e07916fb11233921ddc06d-e-10" label="Work of Expansion (EW)">
        <attvalues>
          <attvalue for="0" value="Work of Expansion (EW)" />
          <attvalue for="1" value="Work" />
          <attvalue for="2" value="**膨胀功 (Work of Expansion, EW)**&#10;&#10;在热力学中，指涡轮功（TW）与有用功（UW）的总和，是衡量系统在膨胀过程中对外做功能力的物理量。在热力学循环图上，其大小常与代表该过程的线段长度（如距离4–9）成比例。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-557dabfd98e07916fb11233921ddc06d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;EW&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-557dabfd98e07916fb11233921ddc06d-e-10&quot;, &quot;chunk-879f6969798c949bf5a7f72d18049a74-e-4&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-557dabfd98e07916fb11233921ddc06d-e-11" label="Vertical distance between 3 and 4">
        <attvalues>
          <attvalue for="0" value="Vertical distance between 3 and 4" />
          <attvalue for="1" value="Measurement" />
          <attvalue for="2" value="一个测量值，表示在以温度为纵轴的坐标系中，点3与点4之间的垂直距离。该距离值与变量Z成正比。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-557dabfd98e07916fb11233921ddc06d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-557dabfd98e07916fb11233921ddc06d-e-12" label="Z">
        <attvalues>
          <attvalue for="0" value="Z" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="在热力学中，Z指燃烧的理想功（ideal work of combustion）。它被定义为热容（Mcp）与温差（∆T）的乘积，是计算比燃料消耗率（specific fuel consumption）和评估发动机性能的一个关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-557dabfd98e07916fb11233921ddc06d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-557dabfd98e07916fb11233921ddc06d-e-12&quot;, &quot;chunk-116daeb47bda22d9815dd14d2f95ed25-e-9&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-557dabfd98e07916fb11233921ddc06d-e-15" label="Ideal Work of Combustion">
        <attvalues>
          <attvalue for="0" value="Ideal Work of Combustion" />
          <attvalue for="1" value="Work" />
          <attvalue for="2" value="理想燃烧功是在恒温恒压下，完全燃烧反应在可逆过程中所能获得的最大理论有用功。它在数值上等于该反应的吉布斯自由能变化的负值（-ΔG），是衡量燃料化学能做功能力的热力学指标，通常用符号Z表示。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-557dabfd98e07916fb11233921ddc06d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;ideal work of combustion&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-557dabfd98e07916fb11233921ddc06d-e-15&quot;, &quot;chunk-d0bef0969eda4d511c2167bafe9aeae0-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d0bef0969eda4d511c2167bafe9aeae0-e-4" label="Ideal Cycle">
        <attvalues>
          <attvalue for="0" value="Ideal Cycle" />
          <attvalue for="1" value="Thermodynamic Concept" />
          <attvalue for="2" value="理想循环是一种用于分析热机（特别是航空发动机）性能的理论热力学模型。该模型假设所有过程均为绝热可逆（等熵），忽略摩擦等实际损失。它以涡轮进口温度(TET)、总压比(OPR)等为关键输入参数，并以热效率、推力等指标来评估其理论性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d0bef0969eda4d511c2167bafe9aeae0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;ideal cycle&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d0bef0969eda4d511c2167bafe9aeae0-e-4&quot;, &quot;chunk-35e59a51ed8121212e1426f0053ba534-e-4&quot;, &quot;chunk-38bfa031d75570a78eacff17ed6bac4a-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="13" />
        </attvalues>
      </node>
      <node id="chunk-d0bef0969eda4d511c2167bafe9aeae0-e-5" label="CW">
        <attvalues>
          <attvalue for="0" value="CW" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="一个特定参数。在理想循环（ideal cycle）的理论模型下，其数值被定义为与参数TW相等。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d0bef0969eda4d511c2167bafe9aeae0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d0bef0969eda4d511c2167bafe9aeae0-e-5&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d0bef0969eda4d511c2167bafe9aeae0-e-6" label="TW">
        <attvalues>
          <attvalue for="0" value="TW" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="TW是一个功率参数，其数值在定义上与另一功率参数CW相等。它代表一个特定的功率水平，通常用于在技术规格或计算中作为参考或等效值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-d0bef0969eda4d511c2167bafe9aeae0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d0bef0969eda4d511c2167bafe9aeae0-e-6&quot;, &quot;chunk-15be551dd91daaae225854c1bc7fcd9d-e-9&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d0bef0969eda4d511c2167bafe9aeae0-e-7" label="UW">
        <attvalues>
          <attvalue for="0" value="UW" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="UW是一个有限的正值参数，可用于提供推进力或驱动外部轴。" />
          <attvalue for="3" value="{&quot;state&quot;: &quot;finite and positive&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d0bef0969eda4d511c2167bafe9aeae0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d0bef0969eda4d511c2167bafe9aeae0-e-8" label="propulsion">
        <attvalues>
          <attvalue for="0" value="propulsion" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="一个通过产生推力来驱动物体（如飞行器、船只）运动的应用领域。在该应用中，需要运用如‘UW’等特定物理量对系统性能进行计算、分析和控制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-d0bef0969eda4d511c2167bafe9aeae0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d0bef0969eda4d511c2167bafe9aeae0-e-9" label="external shaft">
        <attvalues>
          <attvalue for="0" value="external shaft" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种由“UW”驱动的外部传动轴组件。它通过旋转为发电机系统提供机械动力，以实现电能的生产。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-d0bef0969eda4d511c2167bafe9aeae0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d0bef0969eda4d511c2167bafe9aeae0-e-11" label="Turbojet">
        <attvalues>
          <attvalue for="0" value="Turbojet" />
          <attvalue for="1" value="Engine" />
          <attvalue for="2" value="一种航空燃气涡轮发动机。其核心原理是将吸入的空气经压气机压缩，与燃料混合燃烧后产生高温高压燃气。燃气驱动涡轮，涡轮仅用于带动压气机，剩余的燃气则通过喷管高速排出以产生推力。其性能由涡轮进口温度(TET)、总压比(OPR)等关键参数决定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-d0bef0969eda4d511c2167bafe9aeae0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Simple Turbojet&quot;, &quot;Simple turbojet&quot;, &quot;Turbojet engine&quot;, &quot;turbojet&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f0112f08a3353476a4be1ec83e308c35-e-1&quot;, &quot;chunk-d0bef0969eda4d511c2167bafe9aeae0-e-11&quot;, &quot;chunk-502aba15d381acd1fe322927c6f750ed-e-4&quot;, &quot;chunk-d9d4d301605356b62bd308e19ed1fd05-e-3&quot;, &quot;chunk-1176c140725a24bab24c669fe05a7824-e-9&quot;, &quot;chunk-9c5b2b7dade746247326fc0930d280e0-e-4&quot;, &quot;chunk-769ba0c0d24bfa76e90ec2af6878e559-e-14&quot;, &quot;chunk-08236d646ea8d17a369306269312b319-e-1&quot;, &quot;chunk-5ef6f14d86770095e6f2e178382f2c4c-e-9&quot;, &quot;chunk-116daeb47bda22d9815dd14d2f95ed25-e-7&quot;, &quot;chunk-b455c334b535d063bfe8817108154093-e-6&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="11" />
        </attvalues>
      </node>
      <node id="chunk-d0bef0969eda4d511c2167bafe9aeae0-e-13" label="Overall Pressure Ratio (OPR)">
        <attvalues>
          <attvalue for="0" value="Overall Pressure Ratio (OPR)" />
          <attvalue for="1" value="Operating Parameter" />
          <attvalue for="2" value="总压比（Overall Pressure Ratio, OPR）是一个关键性能参数，定义为燃气轮机或喷气发动机中，压气机出口总压与进口总压之比。它直接反映了发动机的增压能力和热力循环效率，常在性能曲线中与总效率（Noverall）等参数一同绘制，用于分析和评估发动机性能。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;25&quot;}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-d0bef0969eda4d511c2167bafe9aeae0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;OPR&quot;, &quot;OPR (Overall Pressure Ratio)&quot;, &quot;Overall Pressure Ratio&quot;, &quot;Overall pressure ratio (OPR)&quot;, &quot;overall pressure ratio (OPR)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d0bef0969eda4d511c2167bafe9aeae0-e-13&quot;, &quot;chunk-35e59a51ed8121212e1426f0053ba534-e-2&quot;, &quot;chunk-7655f48240441662095a40f8fdd54d47-e-5&quot;, &quot;chunk-879f6969798c949bf5a7f72d18049a74-e-2&quot;, &quot;chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-8&quot;, &quot;chunk-2555e274f1223f9245526a48267868ff-e-7&quot;, &quot;chunk-1176c140725a24bab24c669fe05a7824-e-11&quot;, &quot;chunk-38bfa031d75570a78eacff17ed6bac4a-e-1&quot;, &quot;chunk-b4a23a49ff02000ccb51fce56eab7364-e-4&quot;, &quot;chunk-8a64ae02bc80ec0db6abf53700e681de-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-35e59a51ed8121212e1426f0053ba534-e-5" label="Compression Work">
        <attvalues>
          <attvalue for="0" value="Compression Work" />
          <attvalue for="1" value="Thermodynamic Work" />
          <attvalue for="2" value="一种热力学功，指在压缩过程中为减小流体体积、提高其压力而对系统做的功。在理想循环中，它是压缩阶段的能量输入。在此特定上下文中，其数值与透平功（Turbine Work）相等，意味着压缩机消耗的功在量上等于涡轮机输出的功。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-35e59a51ed8121212e1426f0053ba534" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Work of Compression&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-35e59a51ed8121212e1426f0053ba534-e-5&quot;, &quot;chunk-38bfa031d75570a78eacff17ed6bac4a-e-5&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-35e59a51ed8121212e1426f0053ba534-e-7" label="Useful Working (Specific Power)">
        <attvalues>
          <attvalue for="0" value="Useful Working (Specific Power)" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="有用功（比功率）是衡量热力推进循环（如喷气发动机）性能的关键指标。它定义了单位质量工质（如空气）在循环中所产生的、可用于直接提供推进力的净功率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-35e59a51ed8121212e1426f0053ba534" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-35e59a51ed8121212e1426f0053ba534-e-7&quot;]}]" />
          <attvalue for="9" value="154" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-35e59a51ed8121212e1426f0053ba534-e-8" label="Thermal Efficiency (ηth)">
        <attvalues>
          <attvalue for="0" value="Thermal Efficiency (ηth)" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="热效率（Thermal Efficiency, ηth）是衡量热力学循环（如理想循环）性能的无量纲指标。它定义为一个循环中系统输出的净功（Net Work Output）与从高温热源吸收的总热量（Heat Input）之比。该指标量化了热能转化为有用功的有效程度，是评估热机性能的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-35e59a51ed8121212e1426f0053ba534" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Thermal efficiency&quot;, &quot;Thermal efficiency (ηth)&quot;, &quot;η&quot;, &quot;η (Efficiency)&quot;, &quot;ηth (Thermal Efficiency)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7e7c6ace2cc9c7181a60293d264541f2-e-5&quot;, &quot;chunk-c7e7be1b79841f37e4aee97dd32c3432-e-1&quot;, &quot;chunk-35e59a51ed8121212e1426f0053ba534-e-8&quot;, &quot;chunk-15be551dd91daaae225854c1bc7fcd9d-e-12&quot;, &quot;chunk-7655f48240441662095a40f8fdd54d47-e-1&quot;, &quot;chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-5&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="10" />
        </attvalues>
      </node>
      <node id="chunk-35e59a51ed8121212e1426f0053ba534-e-9" label="Thrust (FN)">
        <attvalues>
          <attvalue for="0" value="Thrust (FN)" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="FN是物理学和工程学中代表发动机推力（Thrust）的符号。它是一种反作用力，当发动机向后高速喷射工质（如燃气）时，工质对发动机产生的大小相等、方向相反的向前作用力。该力是驱动飞行器或车辆克服阻力、实现加速的核心动力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-35e59a51ed8121212e1426f0053ba534" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;FN&quot;, &quot;Thrust&quot;, &quot;Thrust, FN&quot;, &quot;thrust&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f23239a1bb5839c40c8b54140289d1ce-e-2&quot;, &quot;chunk-769ba0c0d24bfa76e90ec2af6878e559-e-15&quot;, &quot;chunk-08236d646ea8d17a369306269312b319-e-2&quot;, &quot;chunk-35e59a51ed8121212e1426f0053ba534-e-9&quot;, &quot;chunk-c25d44ad87f3dc200703221956ca5dd1-e-1&quot;, &quot;chunk-879f6969798c949bf5a7f72d18049a74-e-13&quot;, &quot;chunk-c5980c35223518f9aaec4d49ac82b647-e-5&quot;, &quot;chunk-11623a127f67a421f15bdd1ebd79d8af-e-5&quot;, &quot;chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-3&quot;, &quot;chunk-c66ff8a529b9512996f0b3af456f00ce-e-3&quot;, &quot;chunk-0ba22e2612dbc225416101c15d4cb857-e-18&quot;, &quot;chunk-23df60e783372fb64b1a5a9966ec4edc-e-6&quot;, &quot;chunk-5ef6f14d86770095e6f2e178382f2c4c-e-1&quot;, &quot;chunk-116daeb47bda22d9815dd14d2f95ed25-e-4&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="17" />
        </attvalues>
      </node>
      <node id="chunk-35e59a51ed8121212e1426f0053ba534-e-10" label="Propulsive Efficiency (ηprop)">
        <attvalues>
          <attvalue for="0" value="Propulsive Efficiency (ηprop)" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="**推进效率 (Propulsive efficiency, ηprop)**&#10;&#10;一个衡量推进系统（如喷气发动机或螺旋桨）性能的无量纲物理量。它定义为用于推动载具前进的有效功率（推力功率）与推进系统赋予工质的动能功率之比，是评估推进装置将能量转化为有效推力之能力的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-35e59a51ed8121212e1426f0053ba534" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Propulsive Efficiency (Nprop)&quot;, &quot;Propulsive Efficiency (nprop)&quot;, &quot;Propulsive efficiency&quot;, &quot;Propulsive efficiency (ηprop)&quot;, &quot;Propulsive efficiency, ηprop&quot;, &quot;propulsive efficiency&quot;, &quot;ηprop&quot;, &quot;ηprop (Propulsive Efficiency)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-35e59a51ed8121212e1426f0053ba534-e-10&quot;, &quot;chunk-c25d44ad87f3dc200703221956ca5dd1-e-2&quot;, &quot;chunk-c5980c35223518f9aaec4d49ac82b647-e-6&quot;, &quot;chunk-11623a127f67a421f15bdd1ebd79d8af-e-2&quot;, &quot;chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-6&quot;, &quot;chunk-cdeb193bdb0bc0bd0987151c84c2d210-e-2&quot;, &quot;chunk-0e6d1a98cce4649fa0a9b324b03113ce-e-4&quot;, &quot;chunk-dae9be5eb4b7208070b473c392dd0478-e-9&quot;, &quot;chunk-5ef6f14d86770095e6f2e178382f2c4c-e-2&quot;, &quot;chunk-8a64ae02bc80ec0db6abf53700e681de-e-6&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="11" />
        </attvalues>
      </node>
      <node id="chunk-35e59a51ed8121212e1426f0053ba534-e-12" label="Propulsive Force">
        <attvalues>
          <attvalue for="0" value="Propulsive Force" />
          <attvalue for="1" value="Physical Force" />
          <attvalue for="2" value="推进力是一种驱动运载工具（如飞机、火箭、船舶）前进的作用力，也常被称为推力。它本质上是一种反作用力，由发动机等动力系统通过热力学循环输出有效功，并将工质（如燃气）高速向后喷射而产生。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-35e59a51ed8121212e1426f0053ba534" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-35e59a51ed8121212e1426f0053ba534-e-12&quot;]}]" />
          <attvalue for="9" value="154" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c25d44ad87f3dc200703221956ca5dd1-e-3" label="Intake air">
        <attvalues>
          <attvalue for="0" value="Intake air" />
          <attvalue for="1" value="Medium" />
          <attvalue for="2" value="在特定初始条件（如初速度V₀）下，被吸入系统（如发动机）并用作工作流体（工质）的空气介质。" />
          <attvalue for="3" value="{&quot;velocity&quot;: &quot;250 m/s&quot;, &quot;temperature&quot;: &quot;288 K&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c25d44ad87f3dc200703221956ca5dd1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c25d44ad87f3dc200703221956ca5dd1-e-6" label="Atmospheric pressure">
        <attvalues>
          <attvalue for="0" value="Atmospheric pressure" />
          <attvalue for="1" value="Physical Condition" />
          <attvalue for="2" value="大气压（Atmospheric Pressure）是由大气层重量产生的压力，是一个基本的热力学状态变量，用于描述系统的物理状态。在分析热力学过程（如理想循环）时，它通常被用作系统与外界环境进行能量和物质交换时的初始条件或标准参考压力。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;101 325 Pa&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c25d44ad87f3dc200703221956ca5dd1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Atmospheric Pressure&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c25d44ad87f3dc200703221956ca5dd1-e-6&quot;, &quot;chunk-38bfa031d75570a78eacff17ed6bac4a-e-11&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c25d44ad87f3dc200703221956ca5dd1-e-7" label="Adiabatic, Reversible Process">
        <attvalues>
          <attvalue for="0" value="Adiabatic, Reversible Process" />
          <attvalue for="1" value="Thermodynamic Process" />
          <attvalue for="2" value="一种理想化的热力学过程，指系统与外界没有热量交换（绝热），且过程能沿原路径完全复原而不对外界留下任何净影响（可逆）。在此过程中，系统的熵保持恒定，因此也称为等熵过程，是分析气体压缩、膨胀等现象的重要理论模型。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c25d44ad87f3dc200703221956ca5dd1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Adiabatic Isentropic Reversible Processes&quot;, &quot;Adiabatic, Reversible Processes&quot;, &quot;Adiabatic, reversible process&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-35e59a51ed8121212e1426f0053ba534-e-11&quot;, &quot;chunk-c25d44ad87f3dc200703221956ca5dd1-e-7&quot;, &quot;chunk-15be551dd91daaae225854c1bc7fcd9d-e-1&quot;, &quot;chunk-38bfa031d75570a78eacff17ed6bac4a-e-12&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c25d44ad87f3dc200703221956ca5dd1-e-8" label="Temperature ratio (T₃/T₁)">
        <attvalues>
          <attvalue for="0" value="Temperature ratio (T₃/T₁)" />
          <attvalue for="1" value="State Ratio" />
          <attvalue for="2" value="温度比 (T₃/T₁) 是一个关键的热力学无量纲参数，特指热力循环（如布雷顿循环）中涡轮进口（或最高）温度T₃与压气机进口（或最低）温度T₁的比值。在燃气轮机等动力装置中，它与压力比共同决定了循环的热效率和比功。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-c25d44ad87f3dc200703221956ca5dd1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c25d44ad87f3dc200703221956ca5dd1-e-9" label="Pressure ratio (p₃/p₁)">
        <attvalues>
          <attvalue for="0" value="Pressure ratio (p₃/p₁)" />
          <attvalue for="1" value="State Ratio" />
          <attvalue for="2" value="在热力学循环（如布雷顿循环）中，指状态3的压力（p₃）与状态1的压力（p₁）的比值。它是一个关键的无量纲性能参数，反映了工作流体经历的总压力变化，并与温度比（T₃/T₁）等共同决定循环的效率与功输出。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-c25d44ad87f3dc200703221956ca5dd1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;p₃/p₁&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c25d44ad87f3dc200703221956ca5dd1-e-9&quot;, &quot;chunk-15be551dd91daaae225854c1bc7fcd9d-e-4&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c25d44ad87f3dc200703221956ca5dd1-e-10" label="V₀">
        <attvalues>
          <attvalue for="0" value="V₀" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="V₀是一个物理变量，用于表示进气（Intake air）的速度。下标“₀”通常指代初始状态、入口处或特定参考条件下的速度值，是流体力学和热力学分析中的一个关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-c25d44ad87f3dc200703221956ca5dd1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c25d44ad87f3dc200703221956ca5dd1-e-10&quot;, &quot;chunk-879f6969798c949bf5a7f72d18049a74-e-11&quot;, &quot;chunk-c5980c35223518f9aaec4d49ac82b647-e-4&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c25d44ad87f3dc200703221956ca5dd1-e-11" label="Exercise">
        <attvalues>
          <attvalue for="0" value="Exercise" />
          <attvalue for="1" value="Problem Statement" />
          <attvalue for="2" value="一个工程问题陈述，其目标是在给定大气压力、比热容(cp)和比热比(γ)等条件下，对推力(FN)和推进效率(ηprop)进行估算。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-c25d44ad87f3dc200703221956ca5dd1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-15be551dd91daaae225854c1bc7fcd9d-e-2" label="T₃">
        <attvalues>
          <attvalue for="0" value="T₃" />
          <attvalue for="1" value="Temperature" />
          <attvalue for="2" value="T₃指气体在经历绝热可逆（等熵）过程后，从初始状态1达到最终状态3时的温度。它是一个基于初始温度T₁、压力比p₃/p₁以及真实气体压缩因子Z计算得出的理论值，用于描述热力学系统的状态变化。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;723 K&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-15be551dd91daaae225854c1bc7fcd9d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-15be551dd91daaae225854c1bc7fcd9d-e-3" label="T₁">
        <attvalues>
          <attvalue for="0" value="T₁" />
          <attvalue for="1" value="Temperature" />
          <attvalue for="2" value="状态1时的温度，是一个关键的初始参数和基准值，用于计算后续状态的温度（T₃）以及其他相关参数（如CW）。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;288 K&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-15be551dd91daaae225854c1bc7fcd9d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-15be551dd91daaae225854c1bc7fcd9d-e-5" label="T₉">
        <attvalues>
          <attvalue for="0" value="T₉" />
          <attvalue for="1" value="Temperature" />
          <attvalue for="2" value="T₉是表示系统或流程中状态点9的温度参数。它基于状态点4的温度（T₄）计算得出，并作为计算另一参数EW的依据或输入值。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;558 K&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-15be551dd91daaae225854c1bc7fcd9d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-15be551dd91daaae225854c1bc7fcd9d-e-6" label="T₄">
        <attvalues>
          <attvalue for="0" value="T₄" />
          <attvalue for="1" value="Temperature" />
          <attvalue for="2" value="T₄指特定物理系统或过程在状态4时的温度。它是一个关键的基础物理量，作为初始条件，被用于计算后续状态温度（T₉）以及Z、EW等其他相关派生参数。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;1400 K&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-15be551dd91daaae225854c1bc7fcd9d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-15be551dd91daaae225854c1bc7fcd9d-e-7" label="Z">
        <attvalues>
          <attvalue for="0" value="Z" />
          <attvalue for="1" value="Power" />
          <attvalue for="2" value="Z是一种功率参数，作为一个计算值，其数值是依据温度点 T₄ 与 T₃ 的差值（T₄ – T₃）计算得出的结果。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;13.6 MW&quot;, &quot;formula&quot;: &quot;Ṁcp(T₄ – T₃)&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-15be551dd91daaae225854c1bc7fcd9d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-15be551dd91daaae225854c1bc7fcd9d-e-8" label="CW">
        <attvalues>
          <attvalue for="0" value="CW" />
          <attvalue for="1" value="Power" />
          <attvalue for="2" value="CW是一个表示功率(Power)的计算值，其数值基于温差(T₃ - T₁)得出。该值与TW相等，并作为计算另一参数UW的基础。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;8.7MW&quot;, &quot;formula&quot;: &quot;Ṁcp(T₃ - T₁)&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-15be551dd91daaae225854c1bc7fcd9d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-15be551dd91daaae225854c1bc7fcd9d-e-10" label="EW">
        <attvalues>
          <attvalue for="0" value="EW" />
          <attvalue for="1" value="Power" />
          <attvalue for="2" value="EW是一种计算功率值。它基于温度T₄与T₉的差值计算得出，并作为一个中间变量，用于进一步计算另一功率值UW。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;16.8 MW&quot;, &quot;formula&quot;: &quot;Ṁcp(T₄ – T₉)&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-15be551dd91daaae225854c1bc7fcd9d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-15be551dd91daaae225854c1bc7fcd9d-e-13" label="Useful Work">
        <attvalues>
          <attvalue for="0" value="Useful Work" />
          <attvalue for="1" value="Thermodynamic Quantity" />
          <attvalue for="2" value="在热力学中，有用功（W）指一个完整热力学循环中系统对外所做的净功。在压强-体积（P-V）图上，其数值等于循环曲线所包围的面积，数学上通过对压力p的循环积分∮ p dV进行计算。它是定义热机效率（η）的核心物理量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-15be551dd91daaae225854c1bc7fcd9d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Useful Work (UW)&quot;, &quot;Useful work&quot;, &quot;W&quot;, &quot;W (Useful Work)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7e7c6ace2cc9c7181a60293d264541f2-e-6&quot;, &quot;chunk-c7e7be1b79841f37e4aee97dd32c3432-e-2&quot;, &quot;chunk-557dabfd98e07916fb11233921ddc06d-e-9&quot;, &quot;chunk-15be551dd91daaae225854c1bc7fcd9d-e-13&quot;, &quot;chunk-7655f48240441662095a40f8fdd54d47-e-2&quot;, &quot;chunk-cdeb193bdb0bc0bd0987151c84c2d210-e-5&quot;, &quot;chunk-38bfa031d75570a78eacff17ed6bac4a-e-6&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="13" />
        </attvalues>
      </node>
      <node id="chunk-15be551dd91daaae225854c1bc7fcd9d-e-14" label="Work of combustion">
        <attvalues>
          <attvalue for="0" value="Work of combustion" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="一个热力学概念，指燃料燃烧释放的化学能通过工作物质（如燃气）膨胀而对外输出的有用功。它是计算热机热效率的核心参数，直接反映了热能转化为机械能的有效程度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-15be551dd91daaae225854c1bc7fcd9d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-15be551dd91daaae225854c1bc7fcd9d-e-14&quot;, &quot;chunk-7655f48240441662095a40f8fdd54d47-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-879f6969798c949bf5a7f72d18049a74-e-6" label="Work for propulsion">
        <attvalues>
          <attvalue for="0" value="Work for propulsion" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="一种衡量热机性能的热力学指标，定义为在工作循环中可用于产生推力的净功。其数值等于涡轮输出功与压气机消耗功之差，当二者趋于平衡时该值可忽略不计。总压比（OPR）是影响其大小的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-879f6969798c949bf5a7f72d18049a74" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-879f6969798c949bf5a7f72d18049a74-e-8" label="Kinetic Energy">
        <attvalues>
          <attvalue for="0" value="Kinetic Energy" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="一种物理属性，指气体流因其宏观运动而具有的能量。当外部通过有效功（UW）对气体流做功时，其动能会相应增加，是功与能量转化的体现。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-879f6969798c949bf5a7f72d18049a74" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-879f6969798c949bf5a7f72d18049a74-e-9" label="Gas Stream">
        <attvalues>
          <attvalue for="0" value="Gas Stream" />
          <attvalue for="1" value="Environment" />
          <attvalue for="2" value="燃气轮机内部由燃烧室产生的高温高压气体流。作为驱动涡轮旋转的工作介质，它流经喷嘴导向叶片、涡轮叶片等核心部件，构成了这些部件运行的严苛环境。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-879f6969798c949bf5a7f72d18049a74" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Gas stream&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-879f6969798c949bf5a7f72d18049a74-e-9&quot;, &quot;chunk-04fc5332fa43dcac6331c45b022dd378-e-8&quot;, &quot;chunk-a6f8ce7a7c55e9b6f962543810b6ee71-e-3&quot;, &quot;chunk-6c012ee00f9a31a25711418938f2f2ba-e-1&quot;, &quot;chunk-995a2b9cc489b030d64e320f8fc16f28-e-7&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-879f6969798c949bf5a7f72d18049a74-e-10" label="Vjet">
        <attvalues>
          <attvalue for="0" value="Vjet" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="Vjet是一个变量，特指喷气发动机产生的燃气喷流离开尾部喷管时的速度。它是决定发动机推力大小的核心物理量，也是评估推进系统性能的关键参数，单位通常是米/秒（m/s）。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;934 m/s&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-879f6969798c949bf5a7f72d18049a74" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-879f6969798c949bf5a7f72d18049a74-e-10&quot;, &quot;chunk-c5980c35223518f9aaec4d49ac82b647-e-3&quot;, &quot;chunk-5ef6f14d86770095e6f2e178382f2c4c-e-6&quot;, &quot;chunk-116daeb47bda22d9815dd14d2f95ed25-e-2&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c5980c35223518f9aaec4d49ac82b647-e-2" label="Ṁ (Mass Flow Rate)">
        <attvalues>
          <attvalue for="0" value="Ṁ (Mass Flow Rate)" />
          <attvalue for="1" value="Operating Parameter" />
          <attvalue for="2" value="Ṁ，一个热力学参数，表示质量流量（Mass Flow Rate），即单位时间内流过某一截面的流体质量。在理想循环分析中，它特指循环工质（如空气）的质量吸入率，常用单位为千克/秒(kg/s)。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;20&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c5980c35223518f9aaec4d49ac82b647" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Air Mass Intake (M)&quot;, &quot;Air mass intake (M)&quot;, &quot;M&quot;, &quot;M (Mass Flow)&quot;, &quot;Ṁ&quot;, &quot;air-mass intake, Ṁ&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d0bef0969eda4d511c2167bafe9aeae0-e-14&quot;, &quot;chunk-35e59a51ed8121212e1426f0053ba534-e-3&quot;, &quot;chunk-879f6969798c949bf5a7f72d18049a74-e-12&quot;, &quot;chunk-c5980c35223518f9aaec4d49ac82b647-e-2&quot;, &quot;chunk-1176c140725a24bab24c669fe05a7824-e-12&quot;, &quot;chunk-38bfa031d75570a78eacff17ed6bac4a-e-2&quot;, &quot;chunk-5ef6f14d86770095e6f2e178382f2c4c-e-5&quot;, &quot;chunk-77e7186c113af3c719badc55546273f4-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-c5980c35223518f9aaec4d49ac82b647-e-7" label="Jet kinetic energy">
        <attvalues>
          <attvalue for="0" value="Jet kinetic energy" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="指喷气发动机排出的高速气流相对于发动机自身所具有的动能。它代表了未转化为有效推进功的能量损失，是评估发动机推进效率的核心物理量之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c5980c35223518f9aaec4d49ac82b647" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-11623a127f67a421f15bdd1ebd79d8af-e-3" label="Bypass Design">
        <attvalues>
          <attvalue for="0" value="Bypass Design" />
          <attvalue for="1" value="Design Concept" />
          <attvalue for="2" value="**涵道设计 (Bypass Design)**&#10;&#10;现代民用涡扇发动机的一项核心设计。它将吸入的空气分为两路：少量进入核心机燃烧做功，大部分则绕过核心机，由风扇直接向后加速排出，产生主要推力。这种设计能显著提升燃油效率、降低噪音，是当代民航客机实现高效经济飞行的技术基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-11623a127f67a421f15bdd1ebd79d8af" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Bypass design&quot;, &quot;bypass design&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-11623a127f67a421f15bdd1ebd79d8af-e-3&quot;, &quot;chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-1&quot;, &quot;chunk-cdeb193bdb0bc0bd0987151c84c2d210-e-3&quot;, &quot;chunk-2f922c93a3f1955e166d2270226ee05e-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-11623a127f67a421f15bdd1ebd79d8af-e-4" label="modern civil aeroengine">
        <attvalues>
          <attvalue for="0" value="modern civil aeroengine" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="现代民用航空发动机是一种专为民用飞机设计的推进系统，通常指涡扇发动机。其核心特征是采用涵道设计，将部分吸入的空气绕过发动机核心机直接排出，从而显著提高燃油效率和推力，并有效降低噪音。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-11623a127f67a421f15bdd1ebd79d8af" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Modern Civil Aeroengine&quot;, &quot;Modern civil turbofan aeroengine&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-11623a127f67a421f15bdd1ebd79d8af-e-4&quot;, &quot;chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-2&quot;, &quot;chunk-0e6d1a98cce4649fa0a9b324b03113ce-e-1&quot;, &quot;chunk-2f922c93a3f1955e166d2270226ee05e-e-4&quot;, &quot;chunk-be2e5714ffd15b4d499890769149ecb3-e-5&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-11623a127f67a421f15bdd1ebd79d8af-e-6" label="propulsion">
        <attvalues>
          <attvalue for="0" value="propulsion" />
          <attvalue for="1" value="Physical Concept" />
          <attvalue for="2" value="推进是一种物理过程，指通过产生名为“推力”的作用力，使物体获得加速度以克服阻力、改变其运动状态。该过程是飞行器、船只及火箭等载具实现移动的核心。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-11623a127f67a421f15bdd1ebd79d8af" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-11623a127f67a421f15bdd1ebd79d8af-e-6&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-4" label="Propulsion">
        <attvalues>
          <attvalue for="0" value="Propulsion" />
          <attvalue for="1" value="Function" />
          <attvalue for="2" value="在航空工程领域，指航空发动机通过产生名为“推力”的反作用力，以克服空气阻力、驱动飞行器向前运动的核心功能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-52b9fbfdd63ba4008d7556b754b5ca8c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-9" label="UW (Useful Work)">
        <attvalues>
          <attvalue for="0" value="UW (Useful Work)" />
          <attvalue for="1" value="Thermodynamic Work" />
          <attvalue for="2" value="在航空推进领域，指有用功功率（或推力功率），即推进系统对飞行器做功的速率。它由喷流的部分动能转化而来，是决定推进效率的核心指标，可通过质量流率(Ṁ)、喷流速度(Vjet)和飞行器速度(V₀)计算得出。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-52b9fbfdd63ba4008d7556b754b5ca8c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;UW&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-879f6969798c949bf5a7f72d18049a74-e-7&quot;, &quot;chunk-c5980c35223518f9aaec4d49ac82b647-e-1&quot;, &quot;chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-9&quot;, &quot;chunk-15be551dd91daaae225854c1bc7fcd9d-e-11&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-10" label="Jet Velocity">
        <attvalues>
          <attvalue for="0" value="Jet Velocity" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="喷气速度（Jet Velocity）是一项衡量喷气发动机性能的关键指标，指发动机向后排出的高速燃气流的速度。它由发动机对空气做功而产生，是产生推力的直接来源。通常，更高的喷气速度意味着更大的推力，但也会导致更高的单位燃料消耗率（SFC）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-52b9fbfdd63ba4008d7556b754b5ca8c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-10&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-cdeb193bdb0bc0bd0987151c84c2d210-e-1" label="Specific Fuel Consumption (SFC)">
        <attvalues>
          <attvalue for="0" value="Specific Fuel Consumption (SFC)" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;单位燃料消耗率（Specific Fuel Consumption）是一个关键的性能参数，用于衡量发动机产生单位推力或功率所消耗的燃料量。它由燃料流量（Z）与净推力（FN）及相关系数（C）计算得出，是发动机性能图谱的核心指标之一。该数值越低，代表发动机的燃油效率越高。" />
          <attvalue for="3" value="{&quot;state&quot;: &quot;too large&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-cdeb193bdb0bc0bd0987151c84c2d210" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;SFC&quot;, &quot;SFC (Specific Fuel Consumption)&quot;, &quot;specific fuel consumption&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-11&quot;, &quot;chunk-cdeb193bdb0bc0bd0987151c84c2d210-e-1&quot;, &quot;chunk-0e6d1a98cce4649fa0a9b324b03113ce-e-5&quot;, &quot;chunk-0ba22e2612dbc225416101c15d4cb857-e-16&quot;, &quot;chunk-b7b41d99b7968db6938fc41d4745dc0d-e-16&quot;, &quot;chunk-be2e5714ffd15b4d499890769149ecb3-e-4&quot;, &quot;chunk-116daeb47bda22d9815dd14d2f95ed25-e-8&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="10" />
        </attvalues>
      </node>
      <node id="chunk-cdeb193bdb0bc0bd0987151c84c2d210-e-4" label="Core of the engine">
        <attvalues>
          <attvalue for="0" value="Core of the engine" />
          <attvalue for="1" value="Engine Component" />
          <attvalue for="2" value="发动机的核心系统，是由实现主要能量转换循环的关键组件构成的中心部分。其功能是将燃料化学能等转化为有用的功（如机械功或推力），是整个发动机产生动力的基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-cdeb193bdb0bc0bd0987151c84c2d210" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cdeb193bdb0bc0bd0987151c84c2d210-e-7" label="Bypass Air">
        <attvalues>
          <attvalue for="0" value="Bypass Air" />
          <attvalue for="1" value="Working Fluid" />
          <attvalue for="2" value="在涡轮风扇发动机中，指由风扇吸入并加速，但绕过核心机直接排出的空气工质。这部分气流质量远大于核心机气流，虽出口速度较低，但其加速过程产生了发动机绝大部分的推力（有用功）。" />
          <attvalue for="3" value="{&quot;relative_mass&quot;: &quot;much greater&quot;, &quot;exit_velocity&quot;: &quot;modest&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-cdeb193bdb0bc0bd0987151c84c2d210" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cdeb193bdb0bc0bd0987151c84c2d210-e-8" label="Core Air">
        <attvalues>
          <attvalue for="0" value="Core Air" />
          <attvalue for="1" value="Working Fluid" />
          <attvalue for="2" value="核心空气是指流经航空发动机核心机（压缩机、燃烧室、涡轮）的那部分工作气体。它在核心机内经过热力循环，由发动机所做的有用功加速后高速喷出，从而产生核心推力。" />
          <attvalue for="3" value="{&quot;Vjet&quot;: &quot;modest&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-cdeb193bdb0bc0bd0987151c84c2d210" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cdeb193bdb0bc0bd0987151c84c2d210-e-9" label="Figure 1.14">
        <attvalues>
          <attvalue for="0" value="Figure 1.14" />
          <attvalue for="1" value="Figure" />
          <attvalue for="2" value="图1.14是一张阐释性图表，用于揭示发动机性能中的一个关键问题：高比燃料消耗（SFC）与低推进效率（ηprop）同时出现所导致的能源利用率低下。该图直观地展示了这两个指标不佳时对整体效率的负面影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-cdeb193bdb0bc0bd0987151c84c2d210" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0e6d1a98cce4649fa0a9b324b03113ce-e-2" label="Military aeroengine">
        <attvalues>
          <attvalue for="0" value="Military aeroengine" />
          <attvalue for="1" value="Engine Type" />
          <attvalue for="2" value="军用航空发动机是专为军用飞机设计的动力装置。为满足高速飞行与高机动性的严苛作战要求，其核心技术特征为低涵道比、高推重比和较小的风扇直径，以实现最大化的速度与加速度。" />
          <attvalue for="3" value="{&quot;bypass_ratio&quot;: &quot;1.2:1&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-0e6d1a98cce4649fa0a9b324b03113ce" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-0e6d1a98cce4649fa0a9b324b03113ce-e-3" label="Bypass ratio">
        <attvalues>
          <attvalue for="0" value="Bypass ratio" />
          <attvalue for="1" value="Engine Parameter" />
          <attvalue for="2" value="涵道比是涡扇发动机的关键设计参数，定义为流经外涵道的空气质量流量与流经核心机的空气质量流量之比。该参数直接影响发动机的推进效率（ηprop）、燃油消耗率（SFC）和推力特性，是决定发动机经济性和用途（如高涵道比的民用与低涵道比的军用发动机）的核心指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-0e6d1a98cce4649fa0a9b324b03113ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Bypass Ratio (BPR)&quot;, &quot;Bypass ratio (BPR)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0e6d1a98cce4649fa0a9b324b03113ce-e-3&quot;, &quot;chunk-d4872d4d3fa3d8ec025e5fc82bfd4fba-e-10&quot;, &quot;chunk-77e7186c113af3c719badc55546273f4-e-9&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-0e6d1a98cce4649fa0a9b324b03113ce-e-6" label="Thrust-to-weight ratio">
        <attvalues>
          <attvalue for="0" value="Thrust-to-weight ratio" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="推力重量比（简称推重比）是发动机产生的推力与其自身重量的比值。作为一个关键性能指标，它直接反映了发动机的先进程度，是衡量特别是军用航空发动机性能的核心要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0e6d1a98cce4649fa0a9b324b03113ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0e6d1a98cce4649fa0a9b324b03113ce-e-6&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0e6d1a98cce4649fa0a9b324b03113ce-e-7" label="Fan diameter">
        <attvalues>
          <attvalue for="0" value="Fan diameter" />
          <attvalue for="1" value="Physical Characteristic" />
          <attvalue for="2" value="风扇直径是现代涡轮风扇发动机的一项核心设计参数，指发动机风扇转子叶片尖端所构成的圆周直径。它直接影响发动机的推力、涵道比和燃油效率等关键性能指标，同时也对发动机间隙等结构设计有决定性作用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-0e6d1a98cce4649fa0a9b324b03113ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Fan Diameter&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0e6d1a98cce4649fa0a9b324b03113ce-e-7&quot;, &quot;chunk-8a64ae02bc80ec0db6abf53700e681de-e-7&quot;, &quot;chunk-d4872d4d3fa3d8ec025e5fc82bfd4fba-e-4&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c5de5e22439ebb3ec48eac8694cd4e84-e-1" label="Engine">
        <attvalues>
          <attvalue for="0" value="Engine" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="作为应用于民用及军用飞机的核心动力部件，其空气动力学设计旨在最小化机身突出。通过不断提升压力比、涡轮进口温度等关键参数，为飞机提供强大推力，以最大化速度与加速度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-c5de5e22439ebb3ec48eac8694cd4e84" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-c5de5e22439ebb3ec48eac8694cd4e84-e-2" label="Airframe">
        <attvalues>
          <attvalue for="0" value="Airframe" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="机身（Airframes）是飞机的基本结构框架，作为一种关键飞机部件，它承载并抵抗飞行中的所有气动和惯性载荷。机身的设计理念、多样性及迭代速度，深刻影响着航空发动机等其他系统的设计哲学与衍生发展。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c5de5e22439ebb3ec48eac8694cd4e84" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Airframes&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c5de5e22439ebb3ec48eac8694cd4e84-e-2&quot;, &quot;chunk-d97ee852ec4cf802eba7492551d5fcae-e-4&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c5de5e22439ebb3ec48eac8694cd4e84-e-3" label="Speed">
        <attvalues>
          <attvalue for="0" value="Speed" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="作为一项性能指标，速度指飞行器等载具的移动速率。通过优化空气动力学设计以减小阻力，例如将发动机平滑地整合进机身，可以使该项指标最大化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c5de5e22439ebb3ec48eac8694cd4e84" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c5de5e22439ebb3ec48eac8694cd4e84-e-4" label="Acceleration">
        <attvalues>
          <attvalue for="0" value="Acceleration" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="作为一项性能指标，“加速度”衡量载具速度变化的速率。它主要由引擎等动力系统决定，并通过优化空气动力学设计（例如将引擎无缝融入机身以减少风阻）来达到最大化，从而实现更快的速度提升。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c5de5e22439ebb3ec48eac8694cd4e84" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c5de5e22439ebb3ec48eac8694cd4e84-e-5" label="ref. [10]">
        <attvalues>
          <attvalue for="0" value="ref. [10]" />
          <attvalue for="1" value="Reference" />
          <attvalue for="2" value="一篇参考文献，该文献对现代发动机的空气动力学设计进行了全面介绍。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c5de5e22439ebb3ec48eac8694cd4e84" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c5de5e22439ebb3ec48eac8694cd4e84-e-6" label="Aerodynamic design">
        <attvalues>
          <attvalue for="0" value="Aerodynamic design" />
          <attvalue for="1" value="Design Discipline" />
          <attvalue for="2" value="空气动力学设计是一门工程设计学科，旨在通过优化物体（如发动机叶片和涵道）的几何形状，来有效引导气流、减小空气阻力并获得所需的气动力。在航空发动机领域，其核心目标是最大化推力、提升运行效率和稳定性，是现代民用及军用飞机发动机研发的关键技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c5de5e22439ebb3ec48eac8694cd4e84" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c5de5e22439ebb3ec48eac8694cd4e84-e-7" label="Civil aircraft">
        <attvalues>
          <attvalue for="0" value="Civil aircraft" />
          <attvalue for="1" value="Vehicle" />
          <attvalue for="2" value="民用飞机，是泛指一切非军事用途航空器的总称。根据用途，其主要分为两大类：执行商业客运和货运任务的公共航空运输飞机（民航机），以及从事私人飞行、工农业作业等活动的通用航空飞机。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c5de5e22439ebb3ec48eac8694cd4e84" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c5de5e22439ebb3ec48eac8694cd4e84-e-7&quot;, &quot;chunk-1176c140725a24bab24c669fe05a7824-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c5de5e22439ebb3ec48eac8694cd4e84-e-8" label="Military aircraft">
        <attvalues>
          <attvalue for="0" value="Military aircraft" />
          <attvalue for="1" value="Vehicle" />
          <attvalue for="2" value="军用飞机是由国家武装力量操作，为执行作战、侦察、运输、预警等军事任务而专门设计或改装的航空器总称。其设计、性能和装备均以满足特定军事需求为首要目标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-c5de5e22439ebb3ec48eac8694cd4e84" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c5de5e22439ebb3ec48eac8694cd4e84-e-9" label="Pressure ratio">
        <attvalues>
          <attvalue for="0" value="Pressure ratio" />
          <attvalue for="1" value="Engine Parameter" />
          <attvalue for="2" value="压力比指发动机工作流体（如空气）经过压缩后的压力与压缩前压力的比值。它是一个衡量发动机性能的核心参数，提高压力比通常能显著提升发动机的热效率和功率输出，是现代发动机设计追求的关键目标之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-c5de5e22439ebb3ec48eac8694cd4e84" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-556d820ddbae9c9c730e555ef87312a3-e-1" label="Large land-based industrial gas turbines">
        <attvalues>
          <attvalue for="0" value="Large land-based industrial gas turbines" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="大型陆基工业燃气轮机是一种用于发电或机械驱动的复杂动力系统。它以在高温高压等严苛条件下运行为特征，内部包含为承受极端工况而设计的燃烧室、涡轮等关键热端部件。" />
          <attvalue for="3" value="{&quot;pressure_ratio&quot;: &quot;20&quot;, &quot;turbine_inlet_temperature&quot;: &quot;1425 °C&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-556d820ddbae9c9c730e555ef87312a3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-556d820ddbae9c9c730e555ef87312a3-e-3" label="Materials">
        <attvalues>
          <attvalue for="0" value="Materials" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="指用于制造工业燃气轮机的一类特种材料。由于燃气轮机在高温、高压等严苛工况下运行，这类材料必须满足极高的性能、强度与可靠性标准，以确保设备的安全和效率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-556d820ddbae9c9c730e555ef87312a3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-556d820ddbae9c9c730e555ef87312a3-e-4" label="Alloys">
        <attvalues>
          <attvalue for="0" value="Alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一类具有优异高温强度和抗氧化性能的特种金属材料，通常指高温合金。作为制造新一代大型工业燃气轮机（IGT）的关键材料，它被用于承受极端温度的燃烧室、涡轮叶片等热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-556d820ddbae9c9c730e555ef87312a3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-556d820ddbae9c9c730e555ef87312a3-e-6" label="Hot sections">
        <attvalues>
          <attvalue for="0" value="Hot sections" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="热端部件（Hot section components）是在涡轮机（特别是陆基涡轮机）高温区域工作的关键组件的统称。为承受极端工况，它们通常由高温合金制造，以应对高温和高应力环境。典型实例包括涡轮叶片（turbine blading）和工作叶片（buckets）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-556d820ddbae9c9c730e555ef87312a3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Hot section components&quot;, &quot;Hottest sections&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f23239a1bb5839c40c8b54140289d1ce-e-6&quot;, &quot;chunk-556d820ddbae9c9c730e555ef87312a3-e-6&quot;, &quot;chunk-3580e24626fc58694eb8b9e80eb9ed69-e-3&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-3f32f2a159ceed7150fba353307d3969-e-2" label="Single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="Single-crystal superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="单晶高温合金（Single-crystal superalloys）是一种整体由单一取向晶粒构成、无晶界的高性能金属材料。因消除了晶界这一高温下的薄弱环节，它具有卓越的高温强度、抗蠕变性和热疲劳寿命。这类材料表现出显著的各向异性（Anisotropy），是制造现代航空发动机和燃气轮机涡轮叶片等核心热端部件的关键材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-3f32f2a159ceed7150fba353307d3969" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Monocrystalline (single-crystal) superalloys&quot;, &quot;Single crystal superalloys&quot;, &quot;Single-crystal alloys&quot;, &quot;Single-crystal superalloy&quot;, &quot;Single-crystal superalloy compositions&quot;, &quot;nickel-based single crystal superalloys&quot;, &quot;single crystal superalloys&quot;, &quot;single-crystal superalloy&quot;, &quot;single-crystal superalloy compositions&quot;, &quot;single-crystal superalloys&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-12efe43c66bf3765417cf87c1dbf67ad-e-4&quot;, &quot;chunk-3f32f2a159ceed7150fba353307d3969-e-2&quot;, &quot;chunk-f5c07b55f3d29bb402b546962b69a445-e-4&quot;, &quot;chunk-19e6563f4b098e6973872824ea3f1dec-e-5&quot;, &quot;chunk-ba75e6448ea6f9f49ca3935b800555ba-e-1&quot;, &quot;chunk-9b774f1b41192a64910256e8cc94923b-e-3&quot;, &quot;chunk-6e49788baa7d330741785c1ce4799ebc-e-7&quot;, &quot;chunk-d60cc087d5f03ae6059fa8890a861a5b-e-2&quot;, &quot;chunk-234c3eebb3d42a0daf6e298133c20255-e-6&quot;, &quot;chunk-d4ec865719f1815d38483ef812cf9ed2-e-5&quot;, &quot;chunk-7468b5a535de86347797d4977b885a9e-e-1&quot;, &quot;chunk-fc2c8c962be61e27a733cdf408bb1415-e-6&quot;, &quot;chunk-398a384cc3aa286c4fab7654b4862802-e-8&quot;, &quot;chunk-46d5bcfdf9cb882db631b70343f35d62-e-1&quot;, &quot;chunk-556781150646701ac920f4765e92b077-e-3&quot;, &quot;chunk-f14b0074e13363327f2213611a99c96e-e-1&quot;, &quot;chunk-3219701e460dd07570bedda4067e6548-e-1&quot;, &quot;chunk-9a58de583a6c9c66ff501b98683b07d7-e-4&quot;, &quot;chunk-a4d65971a0e96c0f576b576adadc50ce-e-5&quot;, &quot;chunk-ada80b922694fd6450f48225d9ee63bb-e-6&quot;, &quot;chunk-6ba4a169178093a9ea2ecfdeeb70cb76-e-2&quot;, &quot;chunk-807030ab9eb9ee85e606b0c18c1d17af-e-4&quot;, &quot;chunk-06552db6ca6c8a18f5c48e13e0d28d19-e-7&quot;, &quot;chunk-aad5a5786d03a03d8f644b4cda7a85fb-e-6&quot;, &quot;chunk-25da441a3869f94baa3fcc9048297be3-e-3&quot;, &quot;chunk-9a94346ed73c8bcf6797ad71ded00b42-e-1&quot;, &quot;chunk-54201ad9eae0d02b418a034d58136abe-e-1&quot;, &quot;chunk-bec9ddac9ea109abb615ddd436849b16-e-4&quot;, &quot;chunk-d18410100c72f222901949093ef379ca-e-6&quot;, &quot;chunk-8f2b320fa48cfb5ef53d60e1a4ca2d11-e-5&quot;, &quot;chunk-e4445ec100361e8a0d56ff46090155d6-e-1&quot;, &quot;chunk-1a93cf0e7220cae761fdbf08f5ce260b-e-9&quot;, &quot;chunk-2947345c06e9b1b937f82bc1b2da5774-e-3&quot;, &quot;chunk-df56dbe04dca860f9b208ab9b4878418-e-11&quot;, &quot;chunk-61614a48414c169528ed8ada3a1933ea-e-9&quot;, &quot;chunk-e7b8406b8d85a1255a692ddd5452a482-e-9&quot;, &quot;chunk-19fc204ae20f257516bfb4e63a049a77-e-1&quot;, &quot;chunk-d973f1814c5a9a7309e3cc231f4b4d07-e-5&quot;, &quot;chunk-b821a94296e5e31338263fc084ea39d5-e-1&quot;, &quot;chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-9&quot;, &quot;chunk-3f04709d6681598a00c3a9a4a76620aa-e-4&quot;, &quot;chunk-d2428cb3e80954cab38bfce19b363f27-e-12&quot;, &quot;chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-2&quot;, &quot;chunk-5518f1c4ab4a7b4e100f841b3b90e572-e-13&quot;, &quot;chunk-f0829bcd269a8d2dfa4641c4b0e70d30-e-1&quot;, &quot;chunk-569a3d8aec20d9df6a256b4cf4b263a7-e-17&quot;, &quot;chunk-86425bad56c0d52ed7246eff0fe06dd8-e-2&quot;, &quot;chunk-d9d581e86b96c92ccf2b9c353b4e4e11-e-8&quot;, &quot;chunk-1159c2afbaaccc92d505d71fb856dee1-e-6&quot;, &quot;chunk-e039cb317db23e5137b0d2d1164a7ea9-e-5&quot;, &quot;chunk-33a73eedd5f0ffd402fd2e071201f517-e-9&quot;, &quot;chunk-dcabec43f1f2206a87597ccc217e55d1-e-7&quot;, &quot;chunk-502aba15d381acd1fe322927c6f750ed-e-10&quot;, &quot;chunk-8a91b63add4adbc77d4752d41b7c75aa-e-13&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="37" />
        </attvalues>
      </node>
      <node id="chunk-3f32f2a159ceed7150fba353307d3969-e-3" label="Blading">
        <attvalues>
          <attvalue for="0" value="Blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="Blading（叶片）是大型工业燃气轮机（Large IGTs）的关键部件。它通常指涡轮或压气机中由一系列叶片组成的系统，为承受高温高压的极端工作环境，越来越多地采用单晶高温合金等先进材料制造。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-3f32f2a159ceed7150fba353307d3969" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3f32f2a159ceed7150fba353307d3969-e-4" label="Cobalt-based superalloys">
        <attvalues>
          <attvalue for="0" value="Cobalt-based superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="钴基高温合金（Cobalt-based superalloys）是以钴为基体，加入铬、钨等元素形成的一类金属材料。它们具有优异的高温强度、热疲劳性能和抗腐蚀性，主要用于制造航空发动机、工业燃气轮机（IGTs）等设备的热端关键部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-3f32f2a159ceed7150fba353307d3969" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3f32f2a159ceed7150fba353307d3969-e-5" label="ECY-768">
        <attvalues>
          <attvalue for="0" value="ECY-768" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="ECY-768是一种钴基高温合金（Cobalt-based superalloy），是该类材料的一个具体牌号或实例。它是一种以钴为主要成分，为适应高温严苛环境而设计的特种金属材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3f32f2a159ceed7150fba353307d3969" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3f32f2a159ceed7150fba353307d3969-e-7" label="Environmental protection">
        <attvalues>
          <attvalue for="0" value="Environmental protection" />
          <attvalue for="1" value="Function" />
          <attvalue for="2" value="一项旨在保护自然环境、防止其退化或受污染的功能。在工业领域，该功能通过应用涂层等先进技术，提升燃气轮机等设备的能源效率、减少污染物排放来实现，以达到可持续发展的目的。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-3f32f2a159ceed7150fba353307d3969" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b2761392d08e0abe002c7c4fcb313ba7-e-2" label="Materials for high-temperature service">
        <attvalues>
          <attvalue for="0" value="Materials for high-temperature service" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="一类能够在高温环境下长期承受显著载荷，并保持其结构与性能稳定的特种材料。它们被专门设计和选用，以满足航空航天、能源等高温应用对部件可靠性和耐久性的严苛要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-b2761392d08e0abe002c7c4fcb313ba7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b2761392d08e0abe002c7c4fcb313ba7-e-2&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b2761392d08e0abe002c7c4fcb313ba7-e-5" label="Considerable loads">
        <attvalues>
          <attvalue for="0" value="Considerable loads" />
          <attvalue for="1" value="Mechanical Condition" />
          <attvalue for="2" value="**显著载荷 (Considerable loads)**：一种机械工况，特指高温服役材料必须承受的巨大机械应力。该应力的大小足以对其结构完整性、性能和使用寿命构成显著影响，是材料设计和评估中的关键考量因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-b2761392d08e0abe002c7c4fcb313ba7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fd74c8e70be26e44b9c77eba51f53c5e-e-1" label="Larson–Miller approach">
        <attvalues>
          <attvalue for="0" value="Larson–Miller approach" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="拉森-米勒方法（Larson–Miller approach）是材料科学中一种评估和预测材料高温蠕变性能的参数化方法。它利用一个综合了温度和时间的参数，建立了应力与材料蠕变断裂寿命之间的关系，从而能够依据短期实验数据外推长期服役寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-fd74c8e70be26e44b9c77eba51f53c5e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fd74c8e70be26e44b9c77eba51f53c5e-e-1&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fd74c8e70be26e44b9c77eba51f53c5e-e-2" label="creep performance">
        <attvalues>
          <attvalue for="0" value="creep performance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="蠕变性能（Creep performance）指材料在恒定应力（尤其是在高温）作用下，抵抗随时间缓慢发生永久性变形（即蠕变）的能力。它是评估材料在高温下长期服役时，结构稳定性和可靠性的关键力学性能指标，常用蠕变速率或蠕变极限（如在特定温度下断裂规定时长所需的应力）来表征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-fd74c8e70be26e44b9c77eba51f53c5e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Creep performance&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fd74c8e70be26e44b9c77eba51f53c5e-e-2&quot;, &quot;chunk-d04c85025e4505eb3f79316f3a28ed39-e-4&quot;, &quot;chunk-77649a0b4c8ee5abb5b0b41c519cbbeb-e-4&quot;, &quot;chunk-ee27b5b0461f20c87cc65a6eed743e2e-e-1&quot;, &quot;chunk-06552db6ca6c8a18f5c48e13e0d28d19-e-8&quot;, &quot;chunk-aad5a5786d03a03d8f644b4cda7a85fb-e-2&quot;, &quot;chunk-60c0ee3413a86135d14081dd80f51aaf-e-2&quot;, &quot;chunk-4e2080b39d531470813c664fcc6dedf9-e-4&quot;, &quot;chunk-166f31f5769126f6a4cd51ea1a1302a5-e-7&quot;, &quot;chunk-2b6a04ecc641ed4c1cec1b3e414ec201-e-1&quot;, &quot;chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0-e-2&quot;, &quot;chunk-ab0efb3d9b926e2af6dcfa9258a58f78-e-7&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="11" />
        </attvalues>
      </node>
      <node id="chunk-fd74c8e70be26e44b9c77eba51f53c5e-e-3" label="Resistance to creep deformation">
        <attvalues>
          <attvalue for="0" value="Resistance to creep deformation" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="指材料在恒定应力（尤其是在高温）作用下，抵抗随时间缓慢发生的永久性变形（即蠕变）的能力。该性能是衡量材料在高温下长期服役时尺寸稳定性的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-fd74c8e70be26e44b9c77eba51f53c5e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fd74c8e70be26e44b9c77eba51f53c5e-e-3&quot;]}]" />
          <attvalue for="9" value="260" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-fd74c8e70be26e44b9c77eba51f53c5e-e-4" label="creep strain rate">
        <attvalues>
          <attvalue for="0" value="creep strain rate" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="蠕变应变率 (creep strain rate) 是一个参数，指材料在恒定载荷与温度条件下，进入稳态蠕变阶段时的应变速率。在此阶段，该速率达到并保持为一个常数，通常表示为ε̇ss。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;ε̇ss&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-fd74c8e70be26e44b9c77eba51f53c5e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Creep strain rate&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fd74c8e70be26e44b9c77eba51f53c5e-e-4&quot;, &quot;chunk-561d2449c805db1de389831a67f53313-e-7&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-fd74c8e70be26e44b9c77eba51f53c5e-e-5" label="steady-state">
        <attvalues>
          <attvalue for="0" value="steady-state" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="稳态是一种材料在蠕变过程中达到的特定条件。在此状态下，蠕变应变率趋于一个恒定值。这是因为材料内部的加工硬化（强化作用）与动态回复（软化作用）机制达到了动态平衡，从而使得宏观变形速率保持稳定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-fd74c8e70be26e44b9c77eba51f53c5e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fd74c8e70be26e44b9c77eba51f53c5e-e-5&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-fd74c8e70be26e44b9c77eba51f53c5e-e-6" label="creep hardening">
        <attvalues>
          <attvalue for="0" value="creep hardening" />
          <attvalue for="1" value="Mechanism" />
          <attvalue for="2" value="蠕变硬化是一种材料现象，指在蠕变过程中，因位错增殖及其与障碍物的相互作用，导致位错运动受阻，从而使材料抗变形能力增强的过程。该过程与蠕变软化相互竞争并保持动态平衡。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-fd74c8e70be26e44b9c77eba51f53c5e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Creep hardening&quot;, &quot;Creep-hardening effect&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fd74c8e70be26e44b9c77eba51f53c5e-e-6&quot;, &quot;chunk-efc4350d2f88b203eca8b021ce05f9b3-e-1&quot;, &quot;chunk-bf4f5a9c3c730bf3e4d0cca1e80be672-e-5&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-fd74c8e70be26e44b9c77eba51f53c5e-e-7" label="Dislocation multiplication">
        <attvalues>
          <attvalue for="0" value="Dislocation multiplication" />
          <attvalue for="1" value="Mechanism" />
          <attvalue for="2" value="位错增殖是一种微观结构机制，指晶体材料在塑性变形中位错密度增加的现象。高密度的位错会相互作用并缠结，阻碍其进一步运动，从而使材料的强度和硬度提高，是导致蠕变硬化（或应变硬化）的关键原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-fd74c8e70be26e44b9c77eba51f53c5e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;dislocation multiplication&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fd74c8e70be26e44b9c77eba51f53c5e-e-7&quot;, &quot;chunk-efc4350d2f88b203eca8b021ce05f9b3-e-2&quot;, &quot;chunk-5c24b22e063be5dfa3ae3afab37099c6-e-12&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-efc4350d2f88b203eca8b021ce05f9b3-e-3" label="Dislocation interaction with obstacles">
        <attvalues>
          <attvalue for="0" value="Dislocation interaction with obstacles" />
          <attvalue for="1" value="Microstructural Mechanism" />
          <attvalue for="2" value="一种材料强化机制。指在塑性变形过程中，运动的位错受到晶体内部障碍物（如析出相、晶界等）的阻碍，增加了材料继续变形的难度，从而提高其强度和硬度。该机制是导致蠕变硬化的关键原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-efc4350d2f88b203eca8b021ce05f9b3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-efc4350d2f88b203eca8b021ce05f9b3-e-4" label="Creep softening">
        <attvalues>
          <attvalue for="0" value="Creep softening" />
          <attvalue for="1" value="Material Phenomenon" />
          <attvalue for="2" value="蠕变软化是一种材料现象，指在蠕变过程中，由位错湮灭和回复等机制导致的材料变形抗力降低的过程。它与蠕变硬化相互制衡，共同决定材料的稳态蠕变行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-efc4350d2f88b203eca8b021ce05f9b3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-efc4350d2f88b203eca8b021ce05f9b3-e-4&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-efc4350d2f88b203eca8b021ce05f9b3-e-5" label="Dislocation annihilation">
        <attvalues>
          <attvalue for="0" value="Dislocation annihilation" />
          <attvalue for="1" value="Microstructural Mechanism" />
          <attvalue for="2" value="位错湮灭是一种微观结构机制，指晶体中两个符号相反的位错相遇并相互抵消，导致位错总密度降低的现象。这种位错密度的减少会降低对后续位错运动的阻碍，是引起材料在高温下发生蠕变软化等现象的主要原因之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-efc4350d2f88b203eca8b021ce05f9b3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-efc4350d2f88b203eca8b021ce05f9b3-e-5&quot;, &quot;chunk-5c24b22e063be5dfa3ae3afab37099c6-e-11&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-efc4350d2f88b203eca8b021ce05f9b3-e-6" label="Recovery">
        <attvalues>
          <attvalue for="0" value="Recovery" />
          <attvalue for="1" value="Microstructural Mechanism" />
          <attvalue for="2" value="回复 (Recovery) 是一种低温退火下的冶金过程。指塑性变形金属在加热时，其内部位错通过重新排列形成更稳定的低能结构，从而降低内应力。作为一种与加工硬化相抗衡的软化机制，它在稳态蠕变中起着关键的动态平衡作用，但通常不显著改变金属的晶粒结构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-efc4350d2f88b203eca8b021ce05f9b3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-efc4350d2f88b203eca8b021ce05f9b3-e-6&quot;, &quot;chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-11&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-efc4350d2f88b203eca8b021ce05f9b3-e-7" label="Steady-state creep rate">
        <attvalues>
          <attvalue for="0" value="Steady-state creep rate" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="稳态蠕变速率 (Steady-state creep rate) 是一个物理量，指材料在恒定应力和温度下，进入蠕变第二阶段（稳态阶段）时所表现出的恒定、最低的应变速率。它通常用符号ε̇ss表示，其大小是施加应力、应力指数和活化能的函数，是衡量材料高温抗蠕变性能的关键指标。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;ε̇ss&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-efc4350d2f88b203eca8b021ce05f9b3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-efc4350d2f88b203eca8b021ce05f9b3-e-7&quot;, &quot;chunk-063edb5b1170ac940a0b2ac7356bfa53-e-7&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-efc4350d2f88b203eca8b021ce05f9b3-e-8" label="Applied stress">
        <attvalues>
          <attvalue for="0" value="Applied stress" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="外加应力（Applied stress）是一种施加于材料上的外部机械作用。在特定材料（如镍基高温合金）中，它是促使γ'超偏位错发生交滑移的关键驱动因素，进而影响材料的塑性变形行为和力学性能。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;σ&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-efc4350d2f88b203eca8b021ce05f9b3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Applied Stress (σο)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-efc4350d2f88b203eca8b021ce05f9b3-e-8&quot;, &quot;chunk-c170c36341964554c175d2ca279d86c6-e-4&quot;, &quot;chunk-5c24b22e063be5dfa3ae3afab37099c6-e-7&quot;, &quot;chunk-80545b960495f33fd33c6ee9963001b5-e-7&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-efc4350d2f88b203eca8b021ce05f9b3-e-9" label="Stress exponent">
        <attvalues>
          <attvalue for="0" value="Stress exponent" />
          <attvalue for="1" value="Material Constant" />
          <attvalue for="2" value="应力指数（n）是一个无量纲的材料常数，在蠕变本构方程中，它定量描述了材料的稳态蠕变速率对应力大小的依赖关系。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;n&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-efc4350d2f88b203eca8b021ce05f9b3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-efc4350d2f88b203eca8b021ce05f9b3-e-10" label="Constant A">
        <attvalues>
          <attvalue for="0" value="Constant A" />
          <attvalue for="1" value="Material Constant" />
          <attvalue for="2" value="一个材料常数，指稳态蠕变速率方程中的前置因子。它是一个与材料微观结构和变形机制相关的综合性参数，用于量化和预测材料在给定应力和温度下的蠕变变形速率。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;A&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-efc4350d2f88b203eca8b021ce05f9b3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="261" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-efc4350d2f88b203eca8b021ce05f9b3-e-12" label="Experimental creep data">
        <attvalues>
          <attvalue for="0" value="Experimental creep data" />
          <attvalue for="1" value="Data" />
          <attvalue for="2" value="指通过实验测量的，描述材料在应力作用下随时间发生形变（蠕变）的数据集。它是分析材料蠕变行为，并推导出蠕变激活能（Q）等关键性能参数的直接来源。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-efc4350d2f88b203eca8b021ce05f9b3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-efc4350d2f88b203eca8b021ce05f9b3-e-12&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-063edb5b1170ac940a0b2ac7356bfa53-e-1" label="Creep data">
        <attvalues>
          <attvalue for="0" value="Creep data" />
          <attvalue for="1" value="Experimental Data" />
          <attvalue for="2" value="蠕变数据（Creep data）是表征材料在高温和恒定应力下随时间变形趋势的力学性能指标。对于ME3高温合金，其优异的蠕变性能（高蠕变抗力）是确保涡轮盘轮缘区域在严苛环境下保持结构稳定性的关键。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-063edb5b1170ac940a0b2ac7356bfa53" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-063edb5b1170ac940a0b2ac7356bfa53-e-1&quot;, &quot;chunk-f942fb543f3ac01d63fdbc3537940608-e-4&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-063edb5b1170ac940a0b2ac7356bfa53-e-2" label="Activation energy for self-diffusion">
        <attvalues>
          <attvalue for="0" value="Activation energy for self-diffusion" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="自扩散激活能是一种物理性质，指原子在纯物质晶格内从一个位置迁移到另一位置所需的最低能量。该值是控制材料高温下原子扩散速率的关键参数，因此常作为评估材料抗蠕变性能的重要指标，并与实验蠕变数据高度相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-063edb5b1170ac940a0b2ac7356bfa53" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-063edb5b1170ac940a0b2ac7356bfa53-e-2&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-063edb5b1170ac940a0b2ac7356bfa53-e-3" label="Mass transport">
        <attvalues>
          <attvalue for="0" value="Mass transport" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="质量输运 (Mass transport) 是一种发生在微观结构尺度的物理过程，指物质（如原子、分子）的迁移。它通常是决定材料宏观行为的关键，例如在高温下，它作为速率控制步骤，主导了材料的蠕变过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-063edb5b1170ac940a0b2ac7356bfa53" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;mass transport&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-063edb5b1170ac940a0b2ac7356bfa53-e-3&quot;, &quot;chunk-e1a389bc8645b3e7fa58f05c1e0a798f-e-13&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-063edb5b1170ac940a0b2ac7356bfa53-e-5" label="Time to rupture">
        <attvalues>
          <attvalue for="0" value="Time to rupture" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**断裂时间 (Time to rupture)**&#10;&#10;一种材料属性，指材料在恒定的高温和应力作用下，从开始加载到发生蠕变断裂所经历的时间。它是衡量材料抗蠕变性能、进行抗蠕变设计和寿命评估的关键参数，其数值与稳态蠕变速率之间满足蒙克曼-格兰特关系（Monkman-Grant relationship）。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;tr&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-063edb5b1170ac940a0b2ac7356bfa53" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-063edb5b1170ac940a0b2ac7356bfa53-e-6" label="Monkman–Grant relationship">
        <attvalues>
          <attvalue for="0" value="Monkman–Grant relationship" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="蒙克曼-格兰特关系（Monkman-Grant relationship）是材料科学中的一个经验关系式，它描述了材料在高温蠕变过程中，其最小蠕变速率与断裂时间之间存在近似的倒数关系。该关系常被用于根据短时蠕变试验数据，来外推预测材料的长期蠕变断裂寿命。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;tr x ε̇ss = B&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-063edb5b1170ac940a0b2ac7356bfa53" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Monkman-Grant relationship&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-063edb5b1170ac940a0b2ac7356bfa53-e-6&quot;, &quot;chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-1&quot;, &quot;chunk-ec1da0ebfe72b58a50620a5a71c6abf7-e-7&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-063edb5b1170ac940a0b2ac7356bfa53-e-8" label="B">
        <attvalues>
          <attvalue for="0" value="B" />
          <attvalue for="1" value="Constant" />
          <attvalue for="2" value="蒙克曼-格兰特关系式中的一个材料常数。该经验关系式描述了材料的最小蠕变速率与其断裂寿命之间的关联。常数B的值取决于具体的材料种类和试验条件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-063edb5b1170ac940a0b2ac7356bfa53" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-063edb5b1170ac940a0b2ac7356bfa53-e-8&quot;, &quot;chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-4&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-063edb5b1170ac940a0b2ac7356bfa53-e-9" label="Design against creep">
        <attvalues>
          <attvalue for="0" value="Design against creep" />
          <attvalue for="1" value="Engineering Process" />
          <attvalue for="2" value="抗蠕变设计是一种工程设计过程，旨在防止材料因持续应力（尤其在高温下）而发生缓慢变形（蠕变）。该过程通过分析材料的蠕变断裂时间等关键参数，确保构件在其设计寿命内保持结构完整性和功能性，避免失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-063edb5b1170ac940a0b2ac7356bfa53" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-2" label="tr">
        <attvalues>
          <attvalue for="0" value="tr" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="在材料科学中，tr是蒙克曼-格兰特关系式中的一个参数，定义为材料在特定应力和温度下发生蠕变断裂所需的时间，也称蠕变断裂寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-1cdb1c1dd2e4f71643372fbdac975f4e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="262" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-3" label="ε̇ss">
        <attvalues>
          <attvalue for="0" value="ε̇ss" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="ε̇ss，即稳态蠕变速率，是材料科学中的一个关键参数。它描述了材料在恒定应力和温度下，于蠕变第二阶段（稳态阶段）所表现出的恒定且最小的塑性变形速率。该参数是评估材料长期尺寸稳定性、预测其服役寿命和进行结构设计的核心依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-1cdb1c1dd2e4f71643372fbdac975f4e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="263" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-5" label="creep ductility">
        <attvalues>
          <attvalue for="0" value="creep ductility" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="蠕变延性是一种材料力学性能，指材料在蠕变条件下发生断裂前所能承受的塑性变形能力。它是衡量材料在长期应力和高温下抵抗脆性断裂的重要指标，该性能的优劣与材料的内聚功直接相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1cdb1c1dd2e4f71643372fbdac975f4e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Creep ductility&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-5&quot;, &quot;chunk-001e173127ba04e558ad53ba47c3764c-e-4&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-6" label="creep strain to failure">
        <attvalues>
          <attvalue for="0" value="creep strain to failure" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种定义材料蠕变延性的物理属性，指材料在恒定应力和高温的蠕变试验中，从开始加载到最终断裂时所累积的总应变。该属性是衡量材料在断裂前承受塑性变形能力的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-1cdb1c1dd2e4f71643372fbdac975f4e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-6&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-7" label="σ">
        <attvalues>
          <attvalue for="0" value="σ" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="一个代表应力的物理参数，符号为σ。在特定条件下，它作为使相关方程（如 tr exp{-Q/RT} = C）成立而保持不变的恒定值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-1cdb1c1dd2e4f71643372fbdac975f4e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="155" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-8" label="Equation tr exp{-Q/RT} = C">
        <attvalues>
          <attvalue for="0" value="Equation tr exp{-Q/RT} = C" />
          <attvalue for="1" value="Model/Equation" />
          <attvalue for="2" value="该方程为阿伦尼乌斯型关系式 tr exp{-Q/RT} = C 的常用对数形式。它通过对原方程两边取以10为底的对数转换而来，建立了材料寿命(tr)、温度(T)和活化能(Q)之间的线性关系。其中常数D是原常数C的对数（D=log₁₀ C）。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;tr exp{-Q/RT} = C&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-1cdb1c1dd2e4f71643372fbdac975f4e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Equation log₁₀ tr - 0.4343(Q/RT) = D&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-8&quot;, &quot;chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-9&quot;]}]" />
          <attvalue for="9" value="155" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-13" label="C">
        <attvalues>
          <attvalue for="0" value="C" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="在描述材料热激活过程的导出关系式 tr exp{-Q/RT} = C 中的一个材料常数。其数值取决于具体材料的固有特性，综合反映了激活能(Q)、温度(T)和特征时间(tr)等因素的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-1cdb1c1dd2e4f71643372fbdac975f4e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="264" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-14" label="D">
        <attvalues>
          <attvalue for="0" value="D" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="D是一个在对数方程 `log₁₀ tr - 0.4343(Q/RT) = D` 中定义的材料常数。该方程遵循阿伦尼乌斯关系，用于量化时间变量(tr)、活化能(Q)与绝对温度(T)之间的相互作用。D的值通常通过实验数据确定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-1cdb1c1dd2e4f71643372fbdac975f4e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-14&quot;]}]" />
          <attvalue for="9" value="265" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-15" label="GE 7F, 7A/9F, Westinghouse 501F/701F and Siemens V84.3/94.3 turbines">
        <attvalues>
          <attvalue for="0" value="GE 7F, 7A/9F, Westinghouse 501F/701F and Siemens V84.3/94.3 turbines" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="一系列F级重型燃气轮机型号的统称，主要制造商包括通用电气(GE 7F/9F)、西屋(501F/701F)及西门子(V84.3/94.3)。这些机型技术水平相近，是全球发电市场的主力，常用于联合循环发电厂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-1cdb1c1dd2e4f71643372fbdac975f4e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-15&quot;]}]" />
          <attvalue for="9" value="266" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-16" label="GE 7H/9H, Westinghouse 501G/701G, Siemens V84.3A/94.3A and ABB GT24/26 turbines">
        <attvalues>
          <attvalue for="0" value="GE 7H/9H, Westinghouse 501G/701G, Siemens V84.3A/94.3A and ABB GT24/26 turbines" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="由通用电气(GE)、西屋(Westinghouse)、西门子(Siemens)和ABB公司生产的一系列先进重型燃气轮机型号。它们以高效率和大功率输出为特点，是用于大型联合循环发电厂的核心动力设备，代表了20世纪末至21世纪初的顶尖燃机技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-1cdb1c1dd2e4f71643372fbdac975f4e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-16&quot;]}]" />
          <attvalue for="9" value="267" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-1" label="GE 7H/9H">
        <attvalues>
          <attvalue for="0" value="GE 7H/9H" />
          <attvalue for="1" value="Turbine Model" />
          <attvalue for="2" value="GE 7H/9H是通用电气（GE）推出的H级重型燃气轮机系列，以其高效率和高性能闻名，主要用于联合循环发电。其中7H型号（如7HA）为60Hz电网设计，9H型号（如9HA）则为50Hz电网设计。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-f2dcbd0ede6add46d4e0540d9a794efa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="268" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-2" label="Westinghouse 501G/701G">
        <attvalues>
          <attvalue for="0" value="Westinghouse 501G/701G" />
          <attvalue for="1" value="Turbine Model" />
          <attvalue for="2" value="一款由原西屋公司研发的G级重型燃气轮机系列。501G适用于60Hz电网，而701G是其对应的50Hz版本。该系列是率先采用蒸汽冷却技术的大功率燃机之一，其技术资产后被西门子及三菱动力继承与发展，对现代燃气轮机技术有重要影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-f2dcbd0ede6add46d4e0540d9a794efa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="269" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-3" label="Siemens V84.3A/94.3A">
        <attvalues>
          <attvalue for="0" value="Siemens V84.3A/94.3A" />
          <attvalue for="1" value="Turbine Model" />
          <attvalue for="2" value="西门子(Siemens) V84.3A/94.3A是一款F级重型燃气轮机，现名SGT5-4000F。V94.3A适用于50Hz电网，V84.3A是其对应60Hz电网的型号。该机型以高可靠性和成熟技术著称，是全球应用最广泛的燃气轮机之一，主要用于大型联合循环发电厂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-f2dcbd0ede6add46d4e0540d9a794efa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="270" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-4" label="ABB GT24/26">
        <attvalues>
          <attvalue for="0" value="ABB GT24/26" />
          <attvalue for="1" value="Turbine Model" />
          <attvalue for="2" value="ABB GT24/26是一款重型燃气轮机系列，最初由ABB开发，后归属阿尔斯通及通用电气(GE)。该系列采用独特的顺序燃烧技术，GT24和GT26分别为其50Hz和60Hz版本，主要用于高效的联合循环发电。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f2dcbd0ede6add46d4e0540d9a794efa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="271" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-5" label="R1">
        <attvalues>
          <attvalue for="0" value="R1" />
          <attvalue for="1" value="Abbreviation" />
          <attvalue for="2" value="R1是“第一级转子部分”（first rotor section）的缩写。在航空发动机、燃气轮机等旋转机械工程领域，该术语特指由叶片和轮盘等组件构成的转子第一个旋转级。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-f2dcbd0ede6add46d4e0540d9a794efa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;first rotor section&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-5&quot;, &quot;chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-6&quot;]}]" />
          <attvalue for="9" value="272" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-8" label="second rotor section">
        <attvalues>
          <attvalue for="0" value="second rotor section" />
          <attvalue for="1" value="Abbreviation" />
          <attvalue for="2" value="R2是“second rotor section”（第二转子段）的缩写。在工程技术领域，它通常指代涡轮机、压缩机等旋转机械中，按特定顺序排列的第二个转子部件或区域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-f2dcbd0ede6add46d4e0540d9a794efa" />
