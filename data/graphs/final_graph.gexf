      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-6" target="chunk-6d7a887b0ad8aa25cf8cb0d2e4a60af2-e-1" id="chunk-6d7a887b0ad8aa25cf8cb0d2e4a60af2-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="MODIFIES" />
          <attvalue for="12" value="Hf is added to NiCoCrAlY-type coatings to modify them." />
          <attvalue for="13" value="plasma-sprayed NiCoCrAlY-type coatings modified with additions of Si and Hf at optimised concentrations of 0.4 and 0.25 wt%" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-6d7a887b0ad8aa25cf8cb0d2e4a60af2" />
          <attvalue for="16" value="0.0019304450338933096" />
          <attvalue for="17" value="0.401158267020336" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-6" target="chunk-d55298f42964ce23c30b0bcafa72ab6c-e-3" id="chunk-d55298f42964ce23c30b0bcafa72ab6c-r-5" weight="4.0">
        <attvalues>
          <attvalue for="11" value="IS_EXAMPLE_OF" />
          <attvalue for="12" value="Hf is given as an example of a low-vapour-pressure element." />
          <attvalue for="13" value="low-vapour-pressure elements (for example, Si, Ta, Hf)" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-d55298f42964ce23c30b0bcafa72ab6c" />
          <attvalue for="16" value="0.0007490912663326457" />
          <attvalue for="17" value="0.26711612142646624" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-6" target="chunk-1b1d17125a9be9ae98260d7ef4e48178-e-11" id="chunk-1b1d17125a9be9ae98260d7ef4e48178-r-5" weight="4.0">
        <attvalues>
          <attvalue for="11" value="IS_A" />
          <attvalue for="12" value="Hafnium is a reactive element addition used to improve Al2O3 scale adherence." />
          <attvalue for="13" value="...by which the adherence of the Al2O3 scale is improved by small amounts (typically less than 1 wt%) of Y, La, Zr or Hf..." />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-1b1d17125a9be9ae98260d7ef4e48178" />
          <attvalue for="17" value="0.26666666666666666" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-6" target="chunk-84d1269d81f3d4fb66cfdbb567801e32-e-1" id="chunk-84d1269d81f3d4fb66cfdbb567801e32-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="REDUCES" />
          <attvalue for="12" value="Hafnium reduces the solubility of sulphur in y-Ni." />
          <attvalue for="13" value="with elements such as Cr and Hf reducing the sulphur solubility" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-84d1269d81f3d4fb66cfdbb567801e32" />
          <attvalue for="16" value="0.0007908438942921702" />
          <attvalue for="17" value="0.40047450633657533" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-6" target="chunk-84d1269d81f3d4fb66cfdbb567801e32-e-6" id="chunk-84d1269d81f3d4fb66cfdbb567801e32-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="REDUCES" />
          <attvalue for="12" value="Hafnium reduces the degree of sulphur's grain-boundary segregation." />
          <attvalue for="13" value="with elements such as Cr and Hf reducing the sulphur solubility and also its degree of grain-boundary segregation" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-84d1269d81f3d4fb66cfdbb567801e32" />
          <attvalue for="16" value="0.0007908438942921702" />
          <attvalue for="17" value="0.40047450633657533" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-6" target="chunk-728b3dfb00a054eed0104e938dfae641-e-4" id="chunk-7638042a561888cfdce1fb2ee9ad0428-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_A" />
          <attvalue for="12" value="Hafnium (Hf) is an example of a reactive element (RE)." />
          <attvalue for="13" value="However, doping with reactive elements (REs) such as Y, Hf, La and Zr has some significant effects." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-7638042a561888cfdce1fb2ee9ad0428" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-6" target="chunk-dceb4b755a836df5a6b40aba440100ba-e-4" id="chunk-dceb4b755a836df5a6b40aba440100ba-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_DOPANT_IN" />
          <attvalue for="12" value="Hafnium is used as a dopant in NiAl, specifically at a concentration of 0.05 at%." />
          <attvalue for="13" value="in fact, when doped with 0.05 at%" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-dceb4b755a836df5a6b40aba440100ba" />
          <attvalue for="16" value="0.002446212791040377" />
          <attvalue for="17" value="0.40146772767462424" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-6" target="chunk-bc88baa62dfcfaa0545bb367cad979a7-e-1" id="chunk-bc88baa62dfcfaa0545bb367cad979a7-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DOPES" />
          <attvalue for="12" value="NiAl is doped with 0.05 at% Hf, which makes it highly oxidation resistant." />
          <attvalue for="13" value="in fact, when doped with 0.05 at%Hf, NiAl has been found to be the most oxidation resistant substrate" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-bc88baa62dfcfaa0545bb367cad979a7" />
          <attvalue for="16" value="0.003669319186560566" />
          <attvalue for="17" value="0.40220159151193635" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-6" target="chunk-2a84c8f3deba57fec16eeb3e18ab4ff5-e-5" id="chunk-2a84c8f3deba57fec16eeb3e18ab4ff5-r-4" weight="4.0">
        <attvalues>
          <attvalue for="11" value="IMPROVES_SCALE_ADHERENCE_OF" />
          <attvalue for="12" value="Hf is used to improve the scale adherence of near-stoichiometric NiAl and serves as a benchmark for effectiveness against Pt." />
          <attvalue for="13" value="100 times more Pt than Hf is required to improve the scale adherence of near-stoichiometric NiAl (see Figure 5.44)" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-2a84c8f3deba57fec16eeb3e18ab4ff5" />
          <attvalue for="17" value="0.26666666666666666" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-6" target="chunk-1abe15e2f2db1602f97ac75bb847ef30-e-16" id="chunk-1abe15e2f2db1602f97ac75bb847ef30-r-7" weight="5.0">
        <attvalues>
          <attvalue for="11" value="INFLUENCES" />
          <attvalue for="12" value="Hafnium has an influence on the oxidation behaviour of CVD NiAl bond coat." />
          <attvalue for="13" value="Influence of sulphur, platinum and hafnium on the oxidation behaviour of CVD NiAl bond coat" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-1abe15e2f2db1602f97ac75bb847ef30" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
