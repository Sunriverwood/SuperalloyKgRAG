      <edge source="chunk-b5c5988ef25b1d82cffcb2320a89119f-e-1" target="chunk-b5c5988ef25b1d82cffcb2320a89119f-e-2" id="chunk-b5c5988ef25b1d82cffcb2320a89119f-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="ALLOWS_INGRESS_OF" />
          <attvalue for="12" value="The ceramic top coat is unable to prevent oxygen from passing through it." />
          <attvalue for="13" value="Since the ceramic top coat is unable to prevent ingress of oxygen, a ‘thermally grown oxide' (TGO) forms during thermal cycling due to oxidation at its interface with the underlying bond coat" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-b5c5988ef25b1d82cffcb2320a89119f" />
          <attvalue for="16" value="4.47427293064877e-05" />
          <attvalue for="17" value="0.4000268456375839" />
        </attvalues>
      </edge>
      <edge source="chunk-8ae2a6e700e675a50e2388df07f07883-e-3" target="chunk-77690a63edc0814cc6c868e5e4d95012-e-6" id="chunk-8ae2a6e700e675a50e2388df07f07883-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_DEPLETED_OF" />
          <attvalue for="12" value="The bond coat loses its aluminum content over time." />
          <attvalue for="13" value="The bond coat becomes depleted of aluminium over time;" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-8ae2a6e700e675a50e2388df07f07883" />
          <attvalue for="17" value="0.4" />
        </attvalues>
