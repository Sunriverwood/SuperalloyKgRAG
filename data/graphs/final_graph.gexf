      <node id="chunk-5e5643debeb7f102ea0f25bf148176a8-e-14" label="Special Metals Corporation">
        <attvalues>
          <attvalue for="0" value="Special Metals Corporation" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="特种金属公司（Special Metals Corporation）是一家全球领先的高性能镍基合金和超合金的研发与制造商。其产品以INCONEL®、INCOLOY®和MONEL®等商标闻名，广泛应用于航空航天、发电、石油和天然气等要求严苛的工业领域。" />
