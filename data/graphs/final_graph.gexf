        <attvalues>
          <attvalue for="0" value="Tailored microstructure of EB-PVD 8YSZ thermal barrier coatings" />
          <attvalue for="1" value="Academic Work" />
          <attvalue for="2" value="Title of a paper authored by D. E. Wolfe et al." />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-22" />
          <attvalue for="5" value="chunk-6dac0a4c73567f8946fa9c50957af9ca" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
