      <node id="chunk-ae682ac4e4eb339bd48233482011cdd1-e-19" label="Rene 125">
        <attvalues>
          <attvalue for="0" value="Rene 125" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="Rene 125是一种隶属于Rene合金家族的镍基高温合金。它以优异的高温强度和损伤容限性能而著称，主要用于制造航空发动机和工业燃气轮机中的涡轮盘等关键热端部件。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;6&quot;}" />
