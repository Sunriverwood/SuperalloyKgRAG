      <node id="chunk-7e597a71b078bd5a96ed4a1909874041-e-1" label="The Superalloys: Fundamentals and Applications">
        <attvalues>
          <attvalue for="0" value="The Superalloys: Fundamentals and Applications" />
          <attvalue for="1" value="Book" />
          <attvalue for="2" value="《高温合金：基础与应用》是由罗杰·C·里德（Roger C. Reed）撰写，剑桥大学出版社出版的一部权威学术专著。该书系统地介绍了高温合金材料的基础科学原理、制造工艺、微观结构、力学性能及其在航空航天和能源领域的关键应用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-7e597a71b078bd5a96ed4a1909874041" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Roger Reed's new textbook The Superalloys&quot;, &quot;The SUPERALLOYS Fundamentals and Applications&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dc7beb2c110a0e2f253f174dddd75d00-e-2&quot;, &quot;chunk-7e597a71b078bd5a96ed4a1909874041-e-1&quot;, &quot;chunk-8c60d2526947a5ab3509fae533f5e115-e-5&quot;, &quot;chunk-562ab8120c986d32d5b96c3da5071063-e-2&quot;]}]" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-7e597a71b078bd5a96ed4a1909874041-e-3" label="Cambridge University Press">
        <attvalues>
          <attvalue for="0" value="Cambridge University Press" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="剑桥大学出版社（Cambridge University Press）是隶属于剑桥大学的著名学术出版机构，也是世界上历史最悠久、规模最大的大学出版社之一。它致力于在全球范围内传播知识与学术研究成果，出版物涵盖各类学术专著，如《高温合金：基础与应用》。" />
          <attvalue for="3" value="{&quot;locations&quot;: &quot;Cambridge, New York, Melbourne, Madrid, Cape Town, Singapore, São Paulo&quot;, &quot;address&quot;: &quot;The Edinburgh Building, Cambridge cb&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-7e597a71b078bd5a96ed4a1909874041" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;CAMBRIDGE&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dc7beb2c110a0e2f253f174dddd75d00-e-4&quot;, &quot;chunk-7e597a71b078bd5a96ed4a1909874041-e-3&quot;, &quot;chunk-981a92f0f4067ae9a68b178dffd922ce-e-1&quot;, &quot;chunk-66786d3fc8599582196c612c1c9f270d-e-2&quot;, &quot;chunk-ff5c5e6729e918b44872ca5ff2ebf25a-e-4&quot;, &quot;chunk-8c60d2526947a5ab3509fae533f5e115-e-3&quot;, &quot;chunk-72bc234ea267d66a5baa8214264163ee-e-3&quot;, &quot;chunk-b18667fadfdf7cfdf2bd35cc10bf1f84-e-4&quot;]}]" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="10" />
        </attvalues>
      </node>
      <node id="chunk-981a92f0f4067ae9a68b178dffd922ce-e-2" label="The Edinburgh Building">
        <attvalues>
          <attvalue for="0" value="The Edinburgh Building" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="爱丁堡大楼（The Edinburgh Building）是剑桥大学出版社（Cambridge University Press）在英国的总部所在地，位于剑桥市。该建筑是这家世界知名出版社在英国的主要办公、编辑与运营中心。" />
          <attvalue for="3" value="{&quot;address&quot;: &quot;Cambridge cb2 2ru, UK&quot;}" />
