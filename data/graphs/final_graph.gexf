      <node id="chunk-ae682ac4e4eb339bd48233482011cdd1-e-9" label="Nimonic 105">
        <attvalues>
          <attvalue for="0" value="Nimonic 105" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="Nimonic 105是一种沉淀硬化型镍基高温合金，为Nimonic合金家族的一员。该合金以其卓越的高温强度、抗蠕变性和抗氧化性而著称，主要用于制造航空发动机和工业燃气轮机中的涡轮叶片、涡轮盘等关键热端部件。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;48, 81, 99, 101&quot;}" />
