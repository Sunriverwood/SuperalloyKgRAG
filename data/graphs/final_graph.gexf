        <attvalues>
          <attvalue for="0" value="Plasma spray coating processes" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Plasma spray coating processes》是由 B. J. Gill 和 R. C. Tucker 合著的学术论文，发表于《Materials Science and Technology》期刊。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1986&quot;, &quot;volume&quot;: &quot;2&quot;, &quot;pages&quot;: &quot;207–213&quot;}" />
