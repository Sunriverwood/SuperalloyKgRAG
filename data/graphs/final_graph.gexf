        <attvalues>
          <attvalue for="11" value="APPLIED_BY" />
          <attvalue for="12" value="The Ni–20Cr–12Al–Y overlay coating was applied using the EB-PVD method." />
          <attvalue for="13" value="application of a Ni–20Cr–12Al–Y overlay coating by the EB-PVD method was found to be detrimental" />
