        <attvalues>
          <attvalue for="11" value="FAILS_FROM_LOWER_END_OF" />
          <attvalue for="12" value="A test specimen is predicted to fail from an inclusion at the lower end of the particle size distribution." />
          <attvalue for="13" value="For example, a test specimen is predicted to fail from an inclusion at the lower end of the particle size distribution, whereas a turbine disc of reasonable size fails from an inclusion of greater size; see Figure 4.48." />
