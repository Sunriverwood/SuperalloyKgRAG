        <attvalues>
          <attvalue for="11" value="PROMOTES" />
          <attvalue for="12" value="High strain rates create a strong tendency for crystallographic cracking." />
          <attvalue for="13" value="at low temperatures, high strain rates and low AK, there is a strong tendency for crystallographic cracking on {111} planes" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa" />
          <attvalue for="16" value="0.00020614306328592042" />
          <attvalue for="17" value="0.4001236858379716" />
