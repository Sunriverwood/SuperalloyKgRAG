      <edge source="chunk-d89de553b45749db88cca84e98f06178-e-8" target="chunk-d89de553b45749db88cca84e98f06178-e-9" id="chunk-d89de553b45749db88cca84e98f06178-r-9" weight="5.0">
        <attvalues>
          <attvalue for="11" value="ENHANCES" />
          <attvalue for="12" value="Heat sinks are used to enhance the thermal gradients present during heat treatment." />
          <attvalue for="13" value="This is achieved by enhancing the thermal gradients present during heat treatment using heat sinks (typically solid metal cylinders)" />
          <attvalue for="14" value="r-9" />
          <attvalue for="15" value="chunk-d89de553b45749db88cca84e98f06178" />
          <attvalue for="16" value="6.961364427427775e-05" />
          <attvalue for="17" value="0.40004176818656456" />
        </attvalues>
