        <attvalues>
          <attvalue for="11" value="SOURCED_FROM" />
          <attvalue for="12" value="The equations are presented in the context of the book 'The physical metallurgy of nickel and its alloys'." />
          <attvalue for="13" value="[Source: Page 78, Block: page_16_block_1]&#10;The physical metallurgy of nickel and its alloys" />
          <attvalue for="14" value="r-8" />
