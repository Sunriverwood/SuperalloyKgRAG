        <attvalues>
          <attvalue for="0" value="b" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="物理量 b，是公式 (2.29) 中的一个变量，并在特定的比值表达式 γAPB/b 中充当分母。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;0.25 nm&quot;}" />
