        <attvalues>
          <attvalue for="11" value="THREATENS" />
          <attvalue for="12" value="The possibility of TBC failure is a major threat to the integrity of a turbine engine." />
          <attvalue for="13" value="The possibility of TBC failure represents a major threat to the integrity of a turbine engine" />
