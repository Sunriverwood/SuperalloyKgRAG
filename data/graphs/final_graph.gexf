        <attvalues>
          <attvalue for="11" value="IS_A_COMPONENT_OF" />
          <attvalue for="12" value="Concentrations of alloying additions are a component of the metallurgical structure." />
          <attvalue for="13" value="...the metallurgical structure, i.e. the grain size, γ', particle size and the concentrations of alloying ad" />
          <attvalue for="14" value="r-10" />
          <attvalue for="15" value="chunk-c170c36341964554c175d2ca279d86c6" />
