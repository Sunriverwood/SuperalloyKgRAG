        <attvalues>
          <attvalue for="11" value="CAUSES_FORMATION_OF" />
          <attvalue for="12" value="Group II alloys cause the formation of an external scale of Cr2O3." />
          <attvalue for="13" value="causes an external scale of Cr2O3" />
