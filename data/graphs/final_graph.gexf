        <attvalues>
          <attvalue for="11" value="HAS_LEAST_STIFF_DIRECTION" />
          <attvalue for="12" value="For nickel, the (100) direction is identified as the least stiff orientation." />
          <attvalue for="13" value="For nickel, it turns out that the (100) direction is the least stiff, and this is true for most other cubic metals." />
