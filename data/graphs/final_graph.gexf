        <attvalues>
          <attvalue for="11" value="IS_INCREASED_FOR" />
          <attvalue for="12" value="There is a drive to increase the turbine entry temperature of large engines." />
          <attvalue for="13" value="The analysis also explains why there has been a tremendous drive to increase both the pressure ratio and the turbine entry temperature of large" />
          <attvalue for="14" value="r-9" />
          <attvalue for="15" value="chunk-c5de5e22439ebb3ec48eac8694cd4e84" />
          <attvalue for="16" value="0.00818853933570269" />
          <attvalue for="17" value="0.4049131236014216" />
        </attvalues>
      </edge>
