        <attvalues>
          <attvalue for="11" value="IS_INVERSELY_PROPORTIONAL_TO" />
          <attvalue for="12" value="The square lattice spacing (L) is inversely proportional to the square root of the unzipped area (A)." />
          <attvalue for="13" value="which is, in turn, inversely proportional to the square root of the unzipped area, A." />
