        <attvalues>
          <attvalue for="11" value="DIFFUSES_SLOWER_THAN" />
          <attvalue for="12" value="Ruthenium (Ru) was found to diffuse several orders of magnitude more slowly than Gold (Au)." />
          <attvalue for="13" value="Elements near the centre of the d block of the periodic table, for example, Re and Ru, were found to diffuse several orders of magnitude more slowly than those from the far west or far east of the d block, for example, Hf and Au;" />
