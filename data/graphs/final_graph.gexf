        </attvalues>
      </node>
      <node id="chunk-491e59c42061a40a1fe533ef4ec8d245-e-9" label="T. Kameda">
        <attvalues>
          <attvalue for="0" value="T. Kameda" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="T. Kameda是一位材料科学领域的研究人员。他是学术论文《EB-PVD process and thermal properties of hafnia-based thermal barrier coating》的作者之一，该论文主要研究氧化铪基热障涂层的制备工艺与热性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
