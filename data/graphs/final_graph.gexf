        <attvalues>
          <attvalue for="11" value="HAS_COMPOSITIONAL_FEATURE" />
          <attvalue for="12" value="The concentration of γ' hardening is a compositional feature of wrought superalloys that is compared to cast superalloys." />
          <attvalue for="13" value="When their compositions are compared with those of the cast superalloys, various points emerge. The concentrations of the γ' hardening" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-1ac5bc0c5780485801a680d4bc6fcb10" />
