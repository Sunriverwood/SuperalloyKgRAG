        <attvalues>
          <attvalue for="11" value="IS_RICH_IN" />
          <attvalue for="12" value="Eutectic mixtures are described as being rich in the γ' phase." />
          <attvalue for="13" value="This is necessary because, after solidification, heat treatment is required to remove residual microsegregation and eutectic mixtures rich in γ'." />
