        </attvalues>
      </node>
      <node id="chunk-6eb9964e0070cc2b73d942919084bb21-e-13" label="Optimisation of MCrAlY-type coatings for single">
        <attvalues>
          <attvalue for="0" value="Optimisation of MCrAlY-type coatings for single" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由N. Czech与W. Stamm合著的一篇科技论文。该文主要研究MCrAlY型涂层的优化技术，特别是其在单晶高温合金部件上的应用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-6eb9964e0070cc2b73d942919084bb21" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-6eb9964e0070cc2b73d942919084bb21-e-14" label="N. Czech">
        <attvalues>
          <attvalue for="0" value="N. Czech" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="N. Czech 是一位学者或研究人员，其研究领域涉及材料科学与工程，特别是MCrAlY型高温防护涂层技术。他/她以发表题为《Optimisation of MCrAlY-type coatings for single》的学术论文而知名，该论文主要研究此类涂层的优化方法。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-6eb9964e0070cc2b73d942919084bb21" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6eb9964e0070cc2b73d942919084bb21-e-15" label="W. Stamm">
        <attvalues>
          <attvalue for="0" value="W. Stamm" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="W. Stamm是一位学者或研究人员，在MCrAlY型涂层领域有学术贡献。他是探讨该涂层优化技术的论文《Optimisation of MCrAlY-type coatings for single》的作者。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-6eb9964e0070cc2b73d942919084bb21" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-731dc84802c72d92f71d829e7e01d610-e-2" label="single crystal gas turbine blades">
        <attvalues>
          <attvalue for="0" value="single crystal gas turbine blades" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="由单晶高温合金制成的燃气轮机叶片，是燃气轮机翼型的一种。因其结构消除了晶界，故具有卓越的高温强度和抗蠕变性能，是发动机热端核心部件。常应用MCrAlY类涂层以增强其抗氧化和耐腐蚀能力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-731dc84802c72d92f71d829e7e01d610" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-731dc84802c72d92f71d829e7e01d610-e-3" label="conventional cast gas turbine blades">
        <attvalues>
          <attvalue for="0" value="conventional cast gas turbine blades" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种采用传统铸造工艺制造的燃气轮机翼型部件。为适应高温工作环境，其表面通常应用MCrAlY类涂层，以提高抗氧化和耐腐蚀性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-731dc84802c72d92f71d829e7e01d610" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-731dc84802c72d92f71d829e7e01d610-e-4" label="coatings for gas turbine aerofoils">
        <attvalues>
          <attvalue for="0" value="coatings for gas turbine aerofoils" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="专用于燃气轮机翼型表面的一类防护涂层，旨在保护翼型基材在高温环境下抵抗氧化和热腐蚀。它是一个通用类别，包含了如MCrAlY涂层等多种具体类型，是保障现代航空发动机和燃气轮机长寿命、高可靠性运行的关键技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-731dc84802c72d92f71d829e7e01d610" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-731dc84802c72d92f71d829e7e01d610-e-5" label="gas turbine aerofoils">
        <attvalues>
          <attvalue for="0" value="gas turbine aerofoils" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="燃气轮机中具有翼型剖面的核心气动元件。其功能是通过与工作流体相互作用，实现对气体的压缩或从高温燃气中提取能量。它是对燃气轮机中各种叶片（如动叶、静叶）的统称，因工作环境恶劣常需施加涂层保护。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-731dc84802c72d92f71d829e7e01d610" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-f84d9415930cf45b94dd88365f7c6b9e-e-1" label="Coatings Technology">
        <attvalues>
          <attvalue for="0" value="Coatings Technology" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《涂料技术》(Coatings Technology) 是一本已停刊的科学期刊，由美国涂料技术学会联合会(FSCT)出版。该刊专注于涂料、油漆、油墨及相关材料的科学、工程与应用研究，是《涂料技术与研究杂志》(Journal of Coatings Technology and Research) 的重要前身之一。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;108–109&quot;, &quot;year&quot;: &quot;1998&quot;, &quot;pages&quot;: &quot;73–79&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-f84d9415930cf45b94dd88365f7c6b9e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="340" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-f84d9415930cf45b94dd88365f7c6b9e-e-2" label="D. R. G. Archer">
        <attvalues>
          <attvalue for="0" value="D. R. G. Archer" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="D. R. G. Archer是一位学者，以合著者身份发表了学术论文《Modelling of phase equilibria in MCrAlY coating systems》。该研究聚焦于材料科学领域，对MCrAlY高温防护涂层系统的相平衡进行理论建模。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-f84d9415930cf45b94dd88365f7c6b9e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f84d9415930cf45b94dd88365f7c6b9e-e-3" label="R. Munoz-Arroyo">
        <attvalues>
          <attvalue for="0" value="R. Munoz-Arroyo" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="R. Munoz-Arroyo是一名学者，作为科学论文《Modelling of phase equilibria in MCrAlY coating systems》的合著者之一，该论文专注于材料科学领域中MCrAlY高温涂层系统的相平衡建模研究。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-f84d9415930cf45b94dd88365f7c6b9e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f84d9415930cf45b94dd88365f7c6b9e-e-4" label="L. Singheiser">
        <attvalues>
          <attvalue for="0" value="L. Singheiser" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="L. Singheiser是学术论文《MCrAlY涂层体系相平衡的建模研究》(Modelling of phase equilibria in MCrAlY coating systems) 的作者之一，该研究涉及对MCrAlY高温防护涂层材料的相平衡进行建模分析。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f84d9415930cf45b94dd88365f7c6b9e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f84d9415930cf45b94dd88365f7c6b9e-e-5" label="W. J. Quadakkers">
        <attvalues>
          <attvalue for="0" value="W. J. Quadakkers" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="W. J. Quadakkers是一位材料科学领域的研究者与作者。根据其合著的论文可知，他的研究方向涉及对MCrAlY等先进涂层系统中的相平衡进行建模与分析。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-f84d9415930cf45b94dd88365f7c6b9e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f84d9415930cf45b94dd88365f7c6b9e-e-6" label="Modelling of phase equilibria in MCrAlY coating systems">
        <attvalues>
          <attvalue for="0" value="Modelling of phase equilibria in MCrAlY coating systems" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由D. R. G. Archer等人合著的学术论文，发表于《表面与涂层技术》(Surface and Coatings Technology)期刊。该论文题为《MCrAlY涂层体系相平衡的建模》，专注于对MCrAlY高温防护涂层系统中的相平衡进行建模与分析。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2004&quot;, &quot;volume&quot;: &quot;187&quot;, &quot;pages&quot;: &quot;272–283&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-f84d9415930cf45b94dd88365f7c6b9e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-f84d9415930cf45b94dd88365f7c6b9e-e-9" label="F. S. Pettit">
        <attvalues>
          <attvalue for="0" value="F. S. Pettit" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="F. S. Pettit是一位学者，作为作者发表了关于材料科学的论文《1000-1200℃下Ni-Cr-Al合金的氧化》。该研究明确了他在高温合金氧化领域的专业贡献。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-f84d9415930cf45b94dd88365f7c6b9e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f84d9415930cf45b94dd88365f7c6b9e-e-9&quot;, &quot;chunk-a75e36db30fe3ec81b83ee56d7984b7f-e-3&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f84d9415930cf45b94dd88365f7c6b9e-e-10" label="Oxidation mechanisms of nickel-aluminium alloys at temperatures between 900°C and 1300°C">
        <attvalues>
          <attvalue for="0" value="Oxidation mechanisms of nickel-aluminium alloys at temperatures between 900°C and 1300°C" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由F. S. Pettit撰写的学术论文，发表于《Transactions AIME》。该文详细研究并阐述了镍铝合金在900°C至1300°C的高温环境下发生氧化反应的内在机理、过程与动力学。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1967&quot;, &quot;volume&quot;: &quot;239&quot;, &quot;pages&quot;: &quot;1297–1305&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-f84d9415930cf45b94dd88365f7c6b9e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f84d9415930cf45b94dd88365f7c6b9e-e-10&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-f84d9415930cf45b94dd88365f7c6b9e-e-11" label="nickel-aluminium alloys">
        <attvalues>
          <attvalue for="0" value="nickel-aluminium alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍铝合金（Nickel-Aluminium Alloys）是以镍和铝为主要组元的金属材料，以其优异的高温强度和抗氧化性能而著称。它常以金属间化合物（如NiAl、Ni₃Al）形式存在，是镍基高温合金的重要组成部分，广泛用于航空发动机叶片等高温结构件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-f84d9415930cf45b94dd88365f7c6b9e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f84d9415930cf45b94dd88365f7c6b9e-e-12" label="Transactions AIME">
        <attvalues>
          <attvalue for="0" value="Transactions AIME" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《Transactions of the AIME》是由美国采矿、冶金和石油工程师协会（AIME）出版的官方学术期刊系列。它发表采矿、冶金和石油工程等领域的经同行评审的研究论文，是这些领域内历史悠久且具重要影响力的核心刊物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-f84d9415930cf45b94dd88365f7c6b9e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f84d9415930cf45b94dd88365f7c6b9e-e-12&quot;, &quot;chunk-a75e36db30fe3ec81b83ee56d7984b7f-e-1&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a75e36db30fe3ec81b83ee56d7984b7f-e-2" label="C. S. Giggins">
        <attvalues>
          <attvalue for="0" value="C. S. Giggins" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="C. S. Giggins是一位材料科学领域的研究人员。他因撰写了研究镍铬铝(Ni-Cr-Al)合金在1000°C至1200°C高温环境下氧化行为的科学论文《Oxidation of Ni-Cr-Al alloys between 1000 °C and 1200 °C》而知名。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a75e36db30fe3ec81b83ee56d7984b7f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a75e36db30fe3ec81b83ee56d7984b7f-e-4" label="Oxidation of Ni-Cr-Al alloys between 1000 °C and 1200 °C">
        <attvalues>
          <attvalue for="0" value="Oxidation of Ni-Cr-Al alloys between 1000 °C and 1200 °C" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇题为《1000°C至1200°C间Ni-Cr-Al合金的氧化》的研究论文，由C. S. Giggins和F. S. Pettit合著。该文研究了特定高温条件下镍铬铝合金的氧化过程，并发表于《电化学学会杂志》。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1971&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a75e36db30fe3ec81b83ee56d7984b7f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a75e36db30fe3ec81b83ee56d7984b7f-e-4&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-a75e36db30fe3ec81b83ee56d7984b7f-e-6" label="Ni-Cr-Al alloys">
        <attvalues>
          <attvalue for="0" value="Ni-Cr-Al alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍铬铝(Ni-Cr-Al)合金是一种镍基高温合金。其关键特征是在高温环境中，铬和铝元素会在合金表面形成一层致密、稳定的保护性氧化膜（如Al₂O₃），从而赋予其卓越的抗氧化性能。" />
          <attvalue for="3" value="{&quot;temperature_range&quot;: &quot;1000 °C and 1200 °C&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a75e36db30fe3ec81b83ee56d7984b7f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a75e36db30fe3ec81b83ee56d7984b7f-e-7" label="D. P. Whittle">
        <attvalues>
          <attvalue for="0" value="D. P. Whittle" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. P. Whittle 是一位学者，因其在材料科学领域的贡献而闻名。他是研究通过添加活性元素或氧化物弥散体来提高材料高温抗氧化性的重要论文的作者。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a75e36db30fe3ec81b83ee56d7984b7f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a75e36db30fe3ec81b83ee56d7984b7f-e-7&quot;, &quot;chunk-0ae4835eab33f3ed749188c7a5dff87b-e-8&quot;]}]" />
          <attvalue for="9" value="39" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a75e36db30fe3ec81b83ee56d7984b7f-e-8" label="J. Stringer">
        <attvalues>
          <attvalue for="0" value="J. Stringer" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="J. Stringer是一位材料科学领域的研究者，其研究聚焦于高温氧化问题。他/她是学术论文《通过添加活性元素或氧化物弥散来改善高温抗氧化性》的作者，该论文探讨了如何提升材料在高温环境下的性能与耐久性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-a75e36db30fe3ec81b83ee56d7984b7f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a75e36db30fe3ec81b83ee56d7984b7f-e-8&quot;, &quot;chunk-0ae4835eab33f3ed749188c7a5dff87b-e-9&quot;, &quot;chunk-2ae64e13937ad7ab215b73765cbe0ff3-e-2&quot;, &quot;chunk-326ba48df9469bbb4fb6ddd6a5c15eb8-e-1&quot;]}]" />
          <attvalue for="9" value="39" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-a75e36db30fe3ec81b83ee56d7984b7f-e-9" label="Improvements in high-temperature oxidation resistance by additions of reactive elements or oxide dispersions">
        <attvalues>
          <attvalue for="0" value="Improvements in high-temperature oxidation resistance by additions of reactive elements or oxide dispersions" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由D. P. Whittle和J. Stringer合著的研究论文，发表于《皇家学会哲学汇刊》。该论文系统阐述了通过添加活性元素或氧化物弥散来提高材料高温抗氧化性能的机理与方法，是材料科学领域的关键文献。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-a75e36db30fe3ec81b83ee56d7984b7f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a75e36db30fe3ec81b83ee56d7984b7f-e-9&quot;]}]" />
          <attvalue for="9" value="39" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a75e36db30fe3ec81b83ee56d7984b7f-e-10" label="Philosophical Transactions of the Royal Society">
        <attvalues>
          <attvalue for="0" value="Philosophical Transactions of the Royal Society" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《伦敦皇家学会哲学汇刊》是由英国皇家学会出版的科学期刊，是世界上现存最古老的学术期刊之一。它致力于发表跨越多个科学领域的高质量原创研究成果，例如在1980年曾刊载过关于活性元素与氧化物弥散的论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-a75e36db30fe3ec81b83ee56d7984b7f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Philosophical Transactions of the Royal Society of London&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a75e36db30fe3ec81b83ee56d7984b7f-e-10&quot;, &quot;chunk-0ae4835eab33f3ed749188c7a5dff87b-e-3&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0ae4835eab33f3ed749188c7a5dff87b-e-2" label="oxide dispersions">
        <attvalues>
          <attvalue for="0" value="oxide dispersions" />
          <attvalue for="1" value="Material Additive" />
          <attvalue for="2" value="氧化物弥散体是一种复合材料或材料添加剂，指将热力学稳定的细小氧化物颗粒（如Y₂O₃、Al₂O₃）作为强化相，均匀地分布于金属基体中。它能有效阻碍位错运动，从而显著提升材料的高温强度、抗蠕变性能及组织稳定性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-0ae4835eab33f3ed749188c7a5dff87b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0ae4835eab33f3ed749188c7a5dff87b-e-2&quot;, &quot;chunk-1abe15e2f2db1602f97ac75bb847ef30-e-6&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0ae4835eab33f3ed749188c7a5dff87b-e-4" label="J. L. Smialek">
        <attvalues>
          <attvalue for="0" value="J. L. Smialek" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="J. L. Smialek是一位研究员，专注于NiAl（镍铝化合物）领域。他撰写了题为《Oxide morphology and spalling model for NiAl》的学术论文，深入探讨了该材料的氧化物形态与剥落模型。该研究成果发表于《Metallurgical Transactions》期刊。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0ae4835eab33f3ed749188c7a5dff87b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0ae4835eab33f3ed749188c7a5dff87b-e-4&quot;, &quot;chunk-dfe2f1887dc7e61661390cb2b77598da-e-13&quot;, &quot;chunk-99354e5831501ba1d07293128331db80-e-5&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-0ae4835eab33f3ed749188c7a5dff87b-e-6" label="Journal of Metals">
        <attvalues>
          <attvalue for="0" value="Journal of Metals" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="`Journal of Metals`是由矿物、金属与材料学会（TMS）主办、施普林格（Springer）出版的同行评审科学期刊。该期刊是TMS的官方出版物，专注于发表金属、矿物及材料科学与工程领域的最新研究成果和技术进展。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;52&quot;, &quot;year&quot;: &quot;2000&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0ae4835eab33f3ed749188c7a5dff87b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0ae4835eab33f3ed749188c7a5dff87b-e-6&quot;, &quot;chunk-311ad4452372c744328957f626b3057d-e-10&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0ae4835eab33f3ed749188c7a5dff87b-e-7" label="I. M. Allam">
        <attvalues>
          <attvalue for="0" value="I. M. Allam" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="I. M. Allam是一位学者，作为合著者发表了关于CoCrAl（钴铬铝）系统氧化行为的研究。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-0ae4835eab33f3ed749188c7a5dff87b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="39" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0ae4835eab33f3ed749188c7a5dff87b-e-10" label="CoCrAl systems">
        <attvalues>
          <attvalue for="0" value="CoCrAl systems" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="CoCrAl系统是一种以钴(Co)、铬(Cr)、铝(Al)为基础的合金体系，常含有活性元素添加物以增强其高温抗氧化性能。Allam、Whittle和Stringer等学者曾对该材料体系的氧化行为进行过深入研究。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-0ae4835eab33f3ed749188c7a5dff87b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="39" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-0ae4835eab33f3ed749188c7a5dff87b-e-11" label="active element additions">
        <attvalues>
          <attvalue for="0" value="active element additions" />
          <attvalue for="1" value="Material Additive" />
          <attvalue for="2" value="一种材料添加剂，特指在CoCrAl等高温合金中少量加入的化学活性强的元素（如钇、锆等）。其主要作用是通过增强保护性氧化膜与合金基体的结合力，从而显著提高材料的高温抗氧化性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-0ae4835eab33f3ed749188c7a5dff87b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="39" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2ae64e13937ad7ab215b73765cbe0ff3-e-1" label="P. Whittle">
        <attvalues>
          <attvalue for="0" value="P. Whittle" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="P. Whittle是一位研究人员和作者，因撰写了关于材料科学的论文《The oxidation behaviour of CoCrAl systems containing active element additions》而知名，该论文研究了含活性元素的CoCrAl合金体系的氧化行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-2ae64e13937ad7ab215b73765cbe0ff3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2ae64e13937ad7ab215b73765cbe0ff3-e-1&quot;]}]" />
          <attvalue for="9" value="39" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2ae64e13937ad7ab215b73765cbe0ff3-e-3" label="The oxidation behaviour of CoCrAl systems containing active element additions">
        <attvalues>
          <attvalue for="0" value="The oxidation behaviour of CoCrAl systems containing active element additions" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇关于含活性元素的CoCrAl系统氧化行为的学术论文，由P. Whittle和J. Stringer撰写，于1978年发表于《Oxidation of Metals》期刊。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1978&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-2ae64e13937ad7ab215b73765cbe0ff3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="39" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2ae64e13937ad7ab215b73765cbe0ff3-e-5" label="CoCrAl systems">
        <attvalues>
          <attvalue for="0" value="CoCrAl systems" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="CoCrAl体系是一种基于钴(Co)、铬(Cr)和铝(Al)的三元合金系统。其核心特性是在高温下能形成一层致密、稳定的氧化铝(Al₂O₃)保护膜，从而具备出色的抗氧化性能。该体系常添加钇(Y)等活性元素以提高氧化膜附着力，主要用作高温合金的防护涂层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2ae64e13937ad7ab215b73765cbe0ff3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="39" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2ae64e13937ad7ab215b73765cbe0ff3-e-6" label="A. S. Khan">
        <attvalues>
          <attvalue for="0" value="A. S. Khan" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="A. S. Khan是一名研究人员，作为期刊文章《The effect of zirconium on the cyclic oxidation of NiCrAl alloys》的作者之一，其研究工作涉及锆元素对镍铬铝（NiCrAl）高温合金循环氧化性能的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-2ae64e13937ad7ab215b73765cbe0ff3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2ae64e13937ad7ab215b73765cbe0ff3-e-6&quot;, &quot;chunk-ad330a92e751427aaea8ad592c6975d4-e-2&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2ae64e13937ad7ab215b73765cbe0ff3-e-7" label="C. E. Lowell">
        <attvalues>
          <attvalue for="0" value="C. E. Lowell" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="C. E. Lowell 是一位研究人员，其专业领域为材料科学。他/她是期刊文章《锆对NiCrAl合金循环氧化的影响》(The effect of zirconium on the cyclic oxidation of NiCrAl alloys) 的作者，该研究探讨了锆元素对镍铬铝合金高温氧化性能的作用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-2ae64e13937ad7ab215b73765cbe0ff3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2ae64e13937ad7ab215b73765cbe0ff3-e-7&quot;, &quot;chunk-ad330a92e751427aaea8ad592c6975d4-e-3&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2ae64e13937ad7ab215b73765cbe0ff3-e-8" label="C. A. Barrett">
        <attvalues>
          <attvalue for="0" value="C. A. Barrett" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="C. A. Barrett是一位研究人员和作者，以其在材料科学领域的贡献而闻名。其是期刊文章《锆对NiCrAl合金循环氧化的影响》(The effect of zirconium on the cyclic oxidation of NiCrAl alloys)的作者之一，该研究探讨了锆元素对镍铬铝合金高温抗氧化性能的作用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-2ae64e13937ad7ab215b73765cbe0ff3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2ae64e13937ad7ab215b73765cbe0ff3-e-8&quot;, &quot;chunk-ad330a92e751427aaea8ad592c6975d4-e-1&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2ae64e13937ad7ab215b73765cbe0ff3-e-9" label="The effect of zirconium on the isothermal oxidation of nominal Ni-14Cr-24Al alloys">
        <attvalues>
          <attvalue for="0" value="The effect of zirconium on the isothermal oxidation of nominal Ni-14Cr-24Al alloys" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由A. S. Khan、C. E. Lowell及C. A. Barrett合著的科学论文，于1980年发表于《电化学学会杂志》。该研究探讨了锆元素对名义Ni-14Cr-24Al镍基合金在恒温条件下氧化行为的影响。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1980&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-2ae64e13937ad7ab215b73765cbe0ff3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2ae64e13937ad7ab215b73765cbe0ff3-e-9&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-2ae64e13937ad7ab215b73765cbe0ff3-e-12" label="Ni-14Cr-24Al alloys">
        <attvalues>
          <attvalue for="0" value="Ni-14Cr-24Al alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种镍基高温合金，名义成分（重量百分比）为14%的铬和24%的铝。该合金因其高铝含量，在高温环境中能形成一层致密的氧化铝保护膜，从而具有卓越的抗氧化性能，是高温防护材料领域的重要研究对象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-2ae64e13937ad7ab215b73765cbe0ff3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2ae64e13937ad7ab215b73765cbe0ff3-e-13" label="The effect of zirconium on th">
        <attvalues>
          <attvalue for="0" value="The effect of zirconium on th" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由C. A. Barrett、A. S. Khan和C. E. Lowell共同撰写的一篇出版物。该出版物的标题不完整，已知部分为“The effect of zirconium on th”。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-2ae64e13937ad7ab215b73765cbe0ff3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-ad330a92e751427aaea8ad592c6975d4-e-4" label="The effect of zirconium on the cyclic oxidation of NiCrAl alloys">
        <attvalues>
          <attvalue for="0" value="The effect of zirconium on the cyclic oxidation of NiCrAl alloys" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="&quot;The effect of zirconium on the cyclic oxidation of NiCrAl alloys&quot;是一篇由C. A. Barrett、A. S. Khan及C. E. Lowell合著的期刊文章。该文于1981年发表在《电化学学会杂志》(Journal of the Electrochemical Society)上，研究了锆元素对镍铬铝(NiCrAl)合金循环氧化性能的影响。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1981&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-ad330a92e751427aaea8ad592c6975d4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ad330a92e751427aaea8ad592c6975d4-e-4&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-ad330a92e751427aaea8ad592c6975d4-e-7" label="NiCrAl alloys">
        <attvalues>
          <attvalue for="0" value="NiCrAl alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍铬铝合金（NiCrAl alloys）是一种以镍为基体，添加铬和铝元素形成的高温合金。它因在高温下能生成致密的氧化铝保护膜，而具备卓越的抗氧化与耐腐蚀性能，通常被用作航空发动机等热端部件的防护涂层材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ad330a92e751427aaea8ad592c6975d4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ad330a92e751427aaea8ad592c6975d4-e-8" label="B. A. Pint">
        <attvalues>
          <attvalue for="0" value="B. A. Pint" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="B. A. Pint是一位研究人员，其专业领域为材料科学，专注于合金的氧化性能。他是学术出版物《The use of two reactive elements to optimise oxidation performance of alumina-forming alloys》的作者之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-ad330a92e751427aaea8ad592c6975d4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ad330a92e751427aaea8ad592c6975d4-e-8&quot;, &quot;chunk-0b443cc5c8498dc201a772ab50af4847-e-11&quot;, &quot;chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a-e-2&quot;, &quot;chunk-1abe15e2f2db1602f97ac75bb847ef30-e-3&quot;, &quot;chunk-99354e5831501ba1d07293128331db80-e-7&quot;, &quot;chunk-bdbf4600f0f46ee6111ce0bae60fe800-e-1&quot;, &quot;chunk-c5385f7f28e0875405c91c30084a5d9b-e-1&quot;, &quot;chunk-68a06b7c34233385dd7e1ad8a70b5d54-e-1&quot;, &quot;chunk-0be0c36bfb88c04374e36b5059a1c5fc-e-3&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="14" />
        </attvalues>
      </node>
      <node id="chunk-ad330a92e751427aaea8ad592c6975d4-e-9" label="Experimental observations in support of the dynamic-segregation theory to explain the reactive-element effect">
        <attvalues>
          <attvalue for="0" value="Experimental observations in support of the dynamic-segregation theory to explain the reactive-element effect" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由B. A. Pint撰写，于1996年发表在《Oxidation of Metals》期刊上的一篇学术论文。该文通过实验观察，为用动态偏析理论解释“活性元素效应”（reactive-element effect）提供了支持性证据。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1996&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-ad330a92e751427aaea8ad592c6975d4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ad330a92e751427aaea8ad592c6975d4-e-11" label="J. K. Tien">
        <attvalues>
          <attvalue for="0" value="J. K. Tien" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="J. K. Tien，一位研究人员，是学术出版物《Mechanism of oxide adh》的作者。该著作的标题表明其研究领域可能涉及材料科学或冶金学。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-ad330a92e751427aaea8ad592c6975d4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="118" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ad330a92e751427aaea8ad592c6975d4-e-12" label="F. S. Pettit">
        <attvalues>
          <attvalue for="0" value="F. S. Pettit" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="F. S. Pettit是一位作者，其撰写的出版物题为《Mechanism of oxide adh》。该描述明确了他的身份，并通过其具体作品来消除歧义。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-ad330a92e751427aaea8ad592c6975d4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="118" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ad330a92e751427aaea8ad592c6975d4-e-13" label="Mechanism of oxide adh">
        <attvalues>
          <attvalue for="0" value="Mechanism of oxide adh" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Mechanism of oxide adh》是由学者J. K. Tien与F. S. Pettit合著的一篇科学出版物。该文主要研究并阐释了氧化物薄膜在金属基底上的附着机理及其影响因素，是材料科学与冶金学领域的重要研究文献。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
