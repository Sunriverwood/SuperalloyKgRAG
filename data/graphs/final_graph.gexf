        <attvalues>
          <attvalue for="11" value="HAS_NORMAL" />
          <attvalue for="12" value="The 23 plane has the solidification direction (100) as its normal." />
          <attvalue for="13" value="in the 23 plane, which has as its normal the solidification direction (100)?" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-7468b5a535de86347797d4977b885a9e" />
