        <attvalues>
          <attvalue for="11" value="HAS_BETTER" />
          <attvalue for="12" value="The coarse-grain structure resulted in a better (lower) minimum creep rate under specific test conditions." />
          <attvalue for="13" value="the minimum creep rate differed by about an order of magnitude with grain size when testing was carried out at 750 °C and 300 MPa, being better for the coarse-grain size" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-c0d12490c7b814ce8a1cab25a00073a6" />
