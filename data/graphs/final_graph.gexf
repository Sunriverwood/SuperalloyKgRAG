      <edge source="chunk-2a630be2b8090ec92842cc9c1737eb42-e-5" target="chunk-64f0b642dc984a92646a132ee856bc18-e-5" id="chunk-ac23817ca85b5e2cba9cb1da3a1960fc-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CONTROLS" />
          <attvalue for="12" value="The elastic force, R, controls the onset of particle shearing." />
          <attvalue for="13" value="The onset of particle shearing is controlled by the following forces which act on the pair of dislocations: ... (ii) the elastic force, R" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-ac23817ca85b5e2cba9cb1da3a1960fc" />
          <attvalue for="16" value="0.0012367059972027447" />
