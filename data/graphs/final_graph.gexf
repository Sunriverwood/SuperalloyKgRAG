        <attvalues>
          <attvalue for="11" value="CALCULATED_FROM" />
          <attvalue for="12" value="The critical buckling stress (σc) is inversely proportional to the square of the width/length (b)." />
          <attvalue for="13" value="σc = (π² / 12) * (E|| / (1 - ν²)) * (h/b)²" />
          <attvalue for="14" value="r-3" />
