        <attvalues>
          <attvalue for="11" value="CORRESPONDS_TO" />
          <attvalue for="12" value="The 95% confidence limit corresponds to 1.645 standard deviations." />
          <attvalue for="13" value="where the 95% confidence limit corresponds to 1.645 standard deviations." />
