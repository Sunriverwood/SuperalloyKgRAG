      <node id="chunk-c026408b0eb125d3c56d1ed05d0a0f15-e-1" label="临界分切应力 (Critical Resolved Shear Stress, τc)">
        <attvalues>
          <attvalue for="0" value="临界分切应力 (Critical Resolved Shear Stress, τc)" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**临界分切应力 (Critical Resolved Shear Stress, τc)**&#10;&#10;一个关键的材料属性，指在特定滑移系上启动晶体塑性变形（位错滑移）所需的最低切应力阈值。其大小依赖于温度(T)、反相畴界能(γAPB)以及强化相的体积分数(f)和尺寸(r)等微观结构因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-c026408b0eb125d3c56d1ed05d0a0f15" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;τc&quot;]" />
