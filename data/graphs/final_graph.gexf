        <attvalues>
          <attvalue for="11" value="IS_A_PROPERTY_OF" />
          <attvalue for="12" value="Creep performance is a characteristic property of disc alloys discussed in the text." />
          <attvalue for="13" value="The factors controlling the creep performance of the disc alloys remain largely unexplored, and they provide an important topic for future research." />
          <attvalue for="14" value="r-2" />
