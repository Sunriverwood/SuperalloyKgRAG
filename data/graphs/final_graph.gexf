      <node id="chunk-c6e7b6a8ae77f73405b4c1cca62aa7e4-e-9" label="Tenth International Symposium on the Superalloys">
        <attvalues>
          <attvalue for="0" value="Tenth International Symposium on the Superalloys" />
          <attvalue for="1" value="Event" />
          <attvalue for="2" value="第十届国际高温合金研讨会 (Tenth International Symposium on the Superalloys) 是一场专注于高温合金领域的国际学术会议。作为该系列专题研讨会的第十次会议，其官方论文集以《Superalloys 2004》为题出版，标志着该会议于2004年左右举行。" />
          <attvalue for="3" value="{}" />
