        <attvalues>
          <attvalue for="11" value="HAS_HIGHER_CR_CONTENT_THAN" />
          <attvalue for="12" value="Wrought superalloys have a higher Cr content than cast superalloys." />
          <attvalue for="13" value="The Cr content is usually at least 15 wt%, higher than for the cast superalloys." />
