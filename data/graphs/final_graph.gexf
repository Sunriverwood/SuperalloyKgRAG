      </node>
      <node id="chunk-c87d6224a6dfa2402ba4ce5b82dd066c-e-5" label="Significant loads and temperatures">
        <attvalues>
          <attvalue for="0" value="Significant loads and temperatures" />
          <attvalue for="1" value="Operational Condition" />
          <attvalue for="2" value="指在现代喷气发动机等高性能热机中存在的严酷运行工况。它描述了设备运行时，内部关键部件同时承受的巨大机械载荷与极端高温。这些因素共同作用，会在部件中产生巨大的热-机械应力，对材料的性能和耐久性提出了极高要求，通常需由高温合金等先进材料承受。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c87d6224a6dfa2402ba4ce5b82dd066c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
