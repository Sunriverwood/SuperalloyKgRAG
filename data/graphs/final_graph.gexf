      <node id="chunk-8037aec19ea88422e6032e36e14ec0c5-e-13" label="Jim Wickerson">
        <attvalues>
          <attvalue for="0" value="Jim Wickerson" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="吉姆·威克森（Jim Wickerson），罗尔斯·罗伊斯公众有限公司（Rolls-Royce plc）的关联人士。该描述明确了他的身份、官方工作隶属关系，并提供了中英文全称以消除歧义。" />
