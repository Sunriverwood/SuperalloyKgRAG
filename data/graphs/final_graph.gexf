        <attvalues>
          <attvalue for="0" value="Components" />
          <attvalue for="1" value="Part" />
          <attvalue for="2" value="一类由高温合金制造的特种机械部件。它们被专门设计并安装在涡轮机等动力设备温度最高的区域，凭借其优异的耐高温和抗腐蚀性能，以承受极端的工作环境，确保设备稳定运行。" />
          <attvalue for="3" value="{}" />
