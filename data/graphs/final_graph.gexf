      <node id="chunk-23956e10c58e231fcc8e8072af07e6f4-e-6" label="Critical components">
        <attvalues>
          <attvalue for="0" value="Critical components" />
          <attvalue for="1" value="Component Category" />
          <attvalue for="2" value="指对系统整体性能、功能及安全至关重要的核心部件类别。此类部件通常在高温、高压或高负载等严酷条件下工作，其一旦失效将可能导致整个系统的灾难性故障。典型的例子包括航空发动机的涡轮叶片和盘件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-23956e10c58e231fcc8e8072af07e6f4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="37" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-23956e10c58e231fcc8e8072af07e6f4-e-7" label="Turbine blades">
        <attvalues>
          <attvalue for="0" value="Turbine blades" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮叶片是涡轮机械（如航空发动机、发电机组）中的关键旋转部件，用于将流体的动能转化为机械能。它在高温高压的极端环境下工作，通常采用铸造工艺，并由具有优异高温强度和抗蠕变性能的高温合金（Superalloys）制成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-23956e10c58e231fcc8e8072af07e6f4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Blades&quot;, &quot;Turbine arrangements&quot;, &quot;Turbine blade&quot;, &quot;Turbine blading&quot;, &quot;turbine blade&quot;, &quot;turbine blades&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-23956e10c58e231fcc8e8072af07e6f4-e-7&quot;, &quot;chunk-542eb38b71ebf203cb6df08f03ceb063-e-10&quot;, &quot;chunk-f5c07b55f3d29bb402b546962b69a445-e-5&quot;, &quot;chunk-d04c85025e4505eb3f79316f3a28ed39-e-3&quot;, &quot;chunk-c1f941cda4f8b36efca8168f378f1be7-e-7&quot;, &quot;chunk-a28f8cc76e765a7c0aa9878e6ea3e623-e-9&quot;, &quot;chunk-8001720db94f44ac88b442f606ab7d39-e-1&quot;, &quot;chunk-fc2c8c962be61e27a733cdf408bb1415-e-5&quot;, &quot;chunk-9a94346ed73c8bcf6797ad71ded00b42-e-2&quot;, &quot;chunk-61a441c3ea495edfbd1f923ab25e12c9-e-13&quot;, &quot;chunk-d973f1814c5a9a7309e3cc231f4b4d07-e-6&quot;, &quot;chunk-b821a94296e5e31338263fc084ea39d5-e-2&quot;, &quot;chunk-0f24474e96c9ef42ab24560f2ccf918e-e-11&quot;, &quot;chunk-e3bc91d02528ce132349b28825081f88-e-1&quot;, &quot;chunk-0440023a44a202881a859e66f23ec3de-e-9&quot;, &quot;chunk-58ee51f26d85456c13aa639ae170ab36-e-1&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="17" />
        </attvalues>
      </node>
      <node id="chunk-23956e10c58e231fcc8e8072af07e6f4-e-9" label="Introductory text on this class of materials">
        <attvalues>
          <attvalue for="0" value="Introductory text on this class of materials" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一部面向物理冶金专业学生和执业工程师的入门教材。该书旨在为读者提供坚实的理论基础，系统阐述了合金设计、工艺开发、部件工程、寿命估算及材料行为等关键工程主题，并对关键部件给予了重点关注。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-23956e10c58e231fcc8e8072af07e6f4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="37" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-23956e10c58e231fcc8e8072af07e6f4-e-11" label="Practising engineers">
        <attvalues>
          <attvalue for="0" value="Practising engineers" />
          <attvalue for="1" value="Audience" />
          <attvalue for="2" value="在职工程师 (Practising Engineers) 是指具备专业工程资质，并在行业内从事技术应用、设计、开发或维护等实际工作的专业人士。作为一个目标群体，他们通常需要通过专业资料或培训来更新知识、学习新材料与技术，以解决具体的工程挑战。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-23956e10c58e231fcc8e8072af07e6f4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="37" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-36ca7e4f37f1d7c5cf301fbbdf528667-e-1" label="ROGER C. REED">
        <attvalues>
          <attvalue for="0" value="ROGER C. REED" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="罗杰·C·里德 (ROGER C. REED) 是一位材料科学领域的学者，现任伦敦帝国学院材料科学与工程系教授兼主席。他曾担任罗尔斯·罗伊斯大学的研究部助理主任。" />
          <attvalue for="3" value="{&quot;title&quot;: &quot;Professor and Chair&quot;, &quot;former_title&quot;: &quot;Assistant Director of Research&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-36ca7e4f37f1d7c5cf301fbbdf528667" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="28" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-36ca7e4f37f1d7c5cf301fbbdf528667-e-2" label="Imperial College London">
        <attvalues>
          <attvalue for="0" value="Imperial College London" />
          <attvalue for="1" value="Institution" />
          <attvalue for="2" value="伦敦帝国学院（Imperial College London），简称“帝国理工”，是一所位于英国伦敦的世界顶尖公立研究型大学，以其在科学、工程、医学和商学领域的卓越研究与教学而享誉全球。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-36ca7e4f37f1d7c5cf301fbbdf528667" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Imperial College&quot;, &quot;Imperial College, London&quot;]" />
