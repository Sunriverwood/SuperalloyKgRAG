      <node id="chunk-225043bdf7b58131b7138652c49cfca0-e-14" label="Walaikak University">
        <attvalues>
          <attvalue for="0" value="Walaikak University" />
          <attvalue for="1" value="Institution" />
          <attvalue for="2" value="瓦莱拉大学（Walailak University）是位于泰国南部洛坤府的一所公立自治大学。该校于1992年依法成立，校名由时任国王普密蓬·阿杜德以其女儿朱拉蓬公主的名字命名，是泰国主要的综合性高等教育机构之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-225043bdf7b58131b7138652c49cfca0" />
