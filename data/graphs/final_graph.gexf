        <attvalues>
          <attvalue for="11" value="IMPINGED_UPON" />
          <attvalue for="12" value="The escaped hot gases made contact with the inner surface of the combustion chamber outer case." />
          <attvalue for="13" value="this allowed hot gases to escape from it and impinge upon the inner surface of the combustion chamber outer case" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-6eb99f000765a2ae4e04228357023bf7" />
          <attvalue for="16" value="0.16666666666666666" />
