        <attvalues>
          <attvalue for="11" value="IS_CHARACTERIZED_BY" />
          <attvalue for="12" value="The steady-state 'secondary' regime is characterized by a fifth-power-law dependence of the applied stress." />
          <attvalue for="13" value="a fifth-power-law dependence of the applied stress for the steady-state ‘secondary' regime is found" />
          <attvalue for="14" value="r-4" />
