          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9a58de583a6c9c66ff501b98683b07d7-e-2" label="y">
        <attvalues>
          <attvalue for="0" value="y" />
          <attvalue for="1" value="Microstructural Phase" />
          <attvalue for="2" value="γ相 (Gamma Phase) 是单晶高温合金中的基体相，通常为面心立方结构的连续固溶体。它作为承载基底，使起到关键强化作用的 γ' 相在其中析出，二者共同赋予合金优异的高温性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-9a58de583a6c9c66ff501b98683b07d7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9a58de583a6c9c66ff501b98683b07d7-e-3" label="mixtures of y and y'">
        <attvalues>
          <attvalue for="0" value="mixtures of y and y'" />
          <attvalue for="1" value="Microstructure" />
          <attvalue for="2" value="一种在单晶高温合金中实现最佳性能的微观结构。它由γ基体相与具有最佳体积分数的γ'强化相共格构成。这种理想的两相混合组织是该类合金获得卓越高温强度和抗蠕变性能的基础。" />
          <attvalue for="3" value="{&quot;optimum_y'_fraction&quot;: &quot;~70%&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-9a58de583a6c9c66ff501b98683b07d7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9a58de583a6c9c66ff501b98683b07d7-e-5" label="Ni-Al binary diagram">
        <attvalues>
          <attvalue for="0" value="Ni-Al binary diagram" />
          <attvalue for="1" value="Technical Diagram" />
          <attvalue for="2" value="镍铝二元相图是一种描述镍(Ni)和铝(Al)两种元素在不同温度和成分下所形成平衡相区的图解。它揭示了合金的熔点、相变点及各相的成分范围，是研发和优化镍基单晶高温合金的成分设计、热处理工艺制定以及组织性能控制的基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-9a58de583a6c9c66ff501b98683b07d7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a4d65971a0e96c0f576b576adadc50ce-e-1" label="Ni-Al binary diagram">
        <attvalues>
          <attvalue for="0" value="Ni-Al binary diagram" />
          <attvalue for="1" value="Phase Diagram" />
          <attvalue for="2" value="镍-铝二元相图是一种用图形方式表示镍(Ni)和铝(Al)二元合金系统在热力学平衡条件下，其组分、温度和物相之间关系的图表。它为镍铝合金的成分设计、热处理工艺制定以及性能预测提供了重要的理论依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-a4d65971a0e96c0f576b576adadc50ce" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a4d65971a0e96c0f576b576adadc50ce-e-6" label="y'-forming elements">
        <attvalues>
          <attvalue for="0" value="y'-forming elements" />
          <attvalue for="1" value="Element Class" />
          <attvalue for="2" value="γ'相形成元素 (y'-forming elements) 指在高温合金中，能够促进和稳定关键强化相——γ'相形成的一类化学元素。通过优化其配比可调控γ'相的体积分数以提升合金性能，典型元素包括铝(Al)、钛(Ti)和钽(Ta)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a4d65971a0e96c0f576b576adadc50ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Guideline 1&quot;, &quot;γ'-forming elements&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a4d65971a0e96c0f576b576adadc50ce-e-6&quot;, &quot;chunk-0d8b8971d722c099aa85646d423e67e5-e-3&quot;, &quot;chunk-a00605aad03a48315b6372d73ae11d54-e-4&quot;]}, {&quot;merged_from&quot;: [&quot;chunk-a00605aad03a48315b6372d73ae11d54-e-4&quot;, &quot;chunk-ed24a575ccc7da550855ce4a7d4ebb9f-e-3&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-0d8b8971d722c099aa85646d423e67e5-e-6" label="y' fraction">
        <attvalues>
          <attvalue for="0" value="y' fraction" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="γ'相分数 (γ' phase fraction) 是一种关键的微观结构参数，指材料中起强化作用的γ'相所占的体积分数。它对材料的高温蠕变寿命有决定性影响，是衡量其抗蠕变性能的核心指标之一，其强化效果亦会受到晶粒尺寸等其他因素的调节。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0d8b8971d722c099aa85646d423e67e5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;y' phase fraction&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0d8b8971d722c099aa85646d423e67e5-e-6&quot;, &quot;chunk-c26d17a0082c516bc0b48b307c73e551-e-4&quot;, &quot;chunk-d4529d405393ac6d501a33e3c215f2a0-e-6&quot;, &quot;chunk-1cfc07c1de96187a9aff83a89de841ed-e-4&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-0d8b8971d722c099aa85646d423e67e5-e-9" label="Heat treatment">
        <attvalues>
          <attvalue for="0" value="Heat treatment" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="热处理是一种工业热加工工艺，通过对固体金属或合金进行特定的加热、保温和冷却，来改变其内部的显微组织，从而改善或获得所需的力学、物理或化学性能。此过程通常不改变工件的整体形状和化学成分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-0d8b8971d722c099aa85646d423e67e5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Heat Treatment&quot;, &quot;Heat Treatments&quot;, &quot;Heat treatment process&quot;, &quot;Heat treatments&quot;, &quot;Heat-treatment process&quot;, &quot;Thermal treatment&quot;, &quot;heat treatment&quot;, &quot;heat treatment process&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9b774f1b41192a64910256e8cc94923b-e-7&quot;, &quot;chunk-6e49788baa7d330741785c1ce4799ebc-e-1&quot;, &quot;chunk-0d8b8971d722c099aa85646d423e67e5-e-9&quot;, &quot;chunk-ada80b922694fd6450f48225d9ee63bb-e-1&quot;, &quot;chunk-c26d17a0082c516bc0b48b307c73e551-e-2&quot;, &quot;chunk-6ba4a169178093a9ea2ecfdeeb70cb76-e-7&quot;, &quot;chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-5&quot;, &quot;chunk-93160044ac8bb07b73d5b072ebae265b-e-2&quot;, &quot;chunk-a00605aad03a48315b6372d73ae11d54-e-8&quot;, &quot;chunk-d9d4e9c6bdfb7df170a8302da4a9bf0c-e-6&quot;, &quot;chunk-54d9cab0bf8e738ae99d8958ce8cd086-e-2&quot;, &quot;chunk-5efed09d54cb5442431710f41fa6ab69-e-3&quot;, &quot;chunk-97f22587e687782a5433110f85b94c9e-e-5&quot;, &quot;chunk-c0e09318f4b18b79d33ab740d82e3946-e-9&quot;, &quot;chunk-43f7a3d07847f327a8e75bdf9e852f1d-e-11&quot;, &quot;chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-9&quot;, &quot;chunk-a1650d74269b8238062c417df547e98e-e-1&quot;, &quot;chunk-ee6f1e6770197cb40d6002c5cd9212fd-e-10&quot;, &quot;chunk-2b0bf628a95c22fc39c3dcd9f2959fd7-e-3&quot;, &quot;chunk-870742dec10263e0078e94a0b6a827aa-e-14&quot;, &quot;chunk-569a3d8aec20d9df6a256b4cf4b263a7-e-2&quot;, &quot;chunk-1159c2afbaaccc92d505d71fb856dee1-e-16&quot;, &quot;chunk-ec1da0ebfe72b58a50620a5a71c6abf7-e-2&quot;, &quot;chunk-dae9be5eb4b7208070b473c392dd0478-e-3&quot;, &quot;chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-13&quot;, &quot;chunk-99c942e2e9af3f5f017d599dea23d62d-e-4&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="18" />
        </attvalues>
      </node>
      <node id="chunk-0d8b8971d722c099aa85646d423e67e5-e-10" label="Solidification">
        <attvalues>
          <attvalue for="0" value="Solidification" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="凝固（Solidification）指物质从液态转变为固态的物理相变过程。在金属铸造等材料工程领域，它是成型的关键步骤，其后通常需要进行热处理，以改善材料的微观组织和力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-0d8b8971d722c099aa85646d423e67e5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;solidification processes&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0d8b8971d722c099aa85646d423e67e5-e-10&quot;, &quot;chunk-925d9224734831ce5d9a5425d8dec113-e-7&quot;, &quot;chunk-dc663680c2568caff49f127612995631-e-8&quot;, &quot;chunk-9c5b2b7dade746247326fc0930d280e0-e-9&quot;, &quot;chunk-1522e93c065590bf976748cff2b67e57-e-2&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-0d8b8971d722c099aa85646d423e67e5-e-11" label="Residual microsegregation">
        <attvalues>
          <attvalue for="0" value="Residual microsegregation" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="残余微观偏析是一种微观组织特征，指金属合金在凝固后，合金元素在微观尺度上（如枝晶间）存在的不均匀分布。这种现象是一种有害特征，会降低材料的力学性能。它通常可以通过均匀化热处理来消除或减轻，该过程利用高温促进原子扩散，从而使成分趋于均匀。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-0d8b8971d722c099aa85646d423e67e5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Residual Microsegregation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0d8b8971d722c099aa85646d423e67e5-e-11&quot;, &quot;chunk-ada80b922694fd6450f48225d9ee63bb-e-2&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ada80b922694fd6450f48225d9ee63bb-e-3" label="Eutectic Mixtures rich in γ'">
        <attvalues>
          <attvalue for="0" value="Eutectic Mixtures rich in γ'" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="**共晶组织 (Eutectic mixtures)**&#10;&#10;一种富含γ'相的微观结构特征。它通常被视为对材料性能不利的非平衡相，因此常通过特定的热处理工艺将其溶解或消除，以优化合金的整体组织与性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-ada80b922694fd6450f48225d9ee63bb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Eutectic mixtures&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ada80b922694fd6450f48225d9ee63bb-e-3&quot;, &quot;chunk-0d8b8971d722c099aa85646d423e67e5-e-12&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ada80b922694fd6450f48225d9ee63bb-e-8" label="Primary Age">
        <attvalues>
          <attvalue for="0" value="Primary Age" />
          <attvalue for="1" value="Process Step" />
          <attvalue for="2" value="一次时效 (Primary Age) 是针对CMSX-4镍基高温合金热处理工艺的第二个步骤。该步骤在固溶处理之后、二次时效之前进行，其目的是在特定温度下析出主要的γ'强化相，以显著提高合金的高温强度和蠕变抗力。" />
          <attvalue for="3" value="{&quot;duration&quot;: &quot;4h&quot;, &quot;temperature&quot;: &quot;1140°C&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-ada80b922694fd6450f48225d9ee63bb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ada80b922694fd6450f48225d9ee63bb-e-8&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ada80b922694fd6450f48225d9ee63bb-e-9" label="Secondary Age">
        <attvalues>
          <attvalue for="0" value="Secondary Age" />
          <attvalue for="1" value="Process Step" />
          <attvalue for="2" value="二次时效 (Secondary Age) 是针对CMSX-4镍基高温合金热处理工艺的第三个步骤。该步骤紧随一次时效 (Primary Age) 之后，旨在通过热处理进一步优化材料的微观结构与高温力学性能。" />
          <attvalue for="3" value="{&quot;duration&quot;: &quot;16h&quot;, &quot;temperature&quot;: &quot;870°C&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-ada80b922694fd6450f48225d9ee63bb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ada80b922694fd6450f48225d9ee63bb-e-9&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c26d17a0082c516bc0b48b307c73e551-e-3" label="Solutioning Window">
        <attvalues>
          <attvalue for="0" value="Solutioning Window" />
          <attvalue for="1" value="Temperature Range" />
          <attvalue for="2" value="固溶窗口 (Solutioning Window) 是热处理中的一个关键工艺参数，指能使合金中特定强化相（如γ'相）溶解，又不会导致材料初熔的狭窄温度区间。该窗口的大小是CMSX-4等高温合金的一项重要属性，并会随着γ'相含量的增加而收窄。" />
          <attvalue for="3" value="{&quot;size&quot;: &quot;about 50°C&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c26d17a0082c516bc0b48b307c73e551" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Solutioning window (AT)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0d8b8971d722c099aa85646d423e67e5-e-7&quot;, &quot;chunk-c26d17a0082c516bc0b48b307c73e551-e-3&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c26d17a0082c516bc0b48b307c73e551-e-5" label="Higher-strength alloys">
        <attvalues>
          <attvalue for="0" value="Higher-strength alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="高强度合金是一类具有卓越机械性能的材料。其关键特性是对初始缺陷尺寸高度敏感，为了获得足够的服役寿命（如10000次循环），必须将其初始缺陷控制在极小范围内。因此，这类材料的应用通常需要借助无损检测技术进行严格的质量控制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c26d17a0082c516bc0b48b307c73e551" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;higher-strength alloys&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c26d17a0082c516bc0b48b307c73e551-e-5&quot;, &quot;chunk-6ba4a169178093a9ea2ecfdeeb70cb76-e-1&quot;, &quot;chunk-c49d762f9999a07400560c738c6df23e-e-3&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-6ba4a169178093a9ea2ecfdeeb70cb76-e-3" label="third-generation alloys">
        <attvalues>
          <attvalue for="0" value="third-generation alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="第三代合金是一种富含铼(Re)元素的高强度合金。其显著特点是由于铼含量较高，相比前代合金需要更长的固溶处理时间，从而获得优异的力学性能。" />
          <attvalue for="3" value="{&quot;solutioning_time&quot;: &quot;substantially longer&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-6ba4a169178093a9ea2ecfdeeb70cb76" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6ba4a169178093a9ea2ecfdeeb70cb76-e-4" label="fourth-generation alloys">
        <attvalues>
          <attvalue for="0" value="fourth-generation alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="第四代合金是一种富含铼(Re)元素的高强度合金。作为对前代合金的改进，其主要特点是需要显著延长的固溶处理时间，以实现更优异的材料性能。" />
          <attvalue for="3" value="{&quot;solutioning_time&quot;: &quot;substantially longer&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-6ba4a169178093a9ea2ecfdeeb70cb76" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6ba4a169178093a9ea2ecfdeeb70cb76-e-6" label="blade applications">
        <attvalues>
          <attvalue for="0" value="blade applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="叶片应用（Blade Applications）特指利用单晶高温合金等先进材料，制造在航空发动机、工业燃气轮机等设备中承受极端工况的涡轮叶片及导向叶片。这些应用旨在满足部件在高温、高压和离心力作用下，对卓越的高温强度、抗蠕变及抗疲劳性能的严苛要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-6ba4a169178093a9ea2ecfdeeb70cb76" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d916edba6cb97ae9adb8c87b210a4263-e-1" label="Alloy Composition">
        <attvalues>
          <attvalue for="0" value="Alloy Composition" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="合金成分是指构成合金的化学元素的种类及其比例。作为一项基本的材料特性，它直接决定了合金的固有属性，尤其是其低周疲劳（LCF）强度。该成分也与材料的γ'相分数等微观结构特征以及屈服强度等力学性能密切相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-d916edba6cb97ae9adb8c87b210a4263" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Alloy composition&quot;, &quot;Composition&quot;, &quot;Compositions&quot;, &quot;alloy chemistry&quot;, &quot;alloy composition&quot;, &quot;alloy compositions&quot;, &quot;compositions&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d916edba6cb97ae9adb8c87b210a4263-e-1&quot;, &quot;chunk-abbdf8441a4bf6e918fd13c6184c324e-e-4&quot;, &quot;chunk-d4529d405393ac6d501a33e3c215f2a0-e-5&quot;, &quot;chunk-070dbf53e1878b9845a3e7782a58ad66-e-4&quot;, &quot;chunk-8a91b63add4adbc77d4752d41b7c75aa-e-9&quot;, &quot;chunk-5518f1c4ab4a7b4e100f841b3b90e572-e-4&quot;, &quot;chunk-dcabec43f1f2206a87597ccc217e55d1-e-14&quot;, &quot;chunk-5d942c8f1c01db54bab51b31faea4836-e-13&quot;, &quot;chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-4&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-d916edba6cb97ae9adb8c87b210a4263-e-2" label="γ/γ' Lattice Misfit (δ)">
        <attvalues>
          <attvalue for="0" value="γ/γ' Lattice Misfit (δ)" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="γ/γ'晶格错配度（δ）是一种关键材料属性，用于量化基体γ相与强化γ'相的晶格参数（aγ与aγ'）之间的相对差异。它主要由合金成分控制，其值的大小决定了γ/γ'界面能。较小的错配度能降低界面能，对稳定析出相形态、提高高温合金的力学性能至关重要。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;δ = 2 x (aγ' - aγ) / (aγ' + aγ)&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-d916edba6cb97ae9adb8c87b210a4263" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;gamma/gamma prime misfit&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d916edba6cb97ae9adb8c87b210a4263-e-2&quot;, &quot;chunk-1159c2afbaaccc92d505d71fb856dee1-e-12&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-d916edba6cb97ae9adb8c87b210a4263-e-3" label="γ/γ' Interfacial Energy">
        <attvalues>
          <attvalue for="0" value="γ/γ' Interfacial Energy" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="γ/γ'界面能是一种材料属性，指在高温合金中，γ基体与γ'强化相界面处单位面积的过剩能量。其大小与两相的晶格错配度密切相关，较低的错配度可使其最小化。该能量是阻碍γ'相发生粗化的关键物理量，对维持材料的高温性能至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d916edba6cb97ae9adb8c87b210a4263" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d916edba6cb97ae9adb8c87b210a4263-e-3&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d916edba6cb97ae9adb8c87b210a4263-e-4" label="γ' coarsening">
        <attvalues>
          <attvalue for="0" value="γ' coarsening" />
          <attvalue for="1" value="Kinetic Process" />
          <attvalue for="2" value="γ'相粗化是一种在高温下发生的组织演化过程，属于奥氏瓦尔德熟化现象。在γ/γ'界面能驱动下，小尺寸γ'析出相溶解，大尺寸析出相长大，导致析出相平均尺寸增大、数量减少，通常会引起材料力学性能退化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d916edba6cb97ae9adb8c87b210a4263" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;y' particle coarsening&quot;, &quot;y' particle growth&quot;, &quot;γ' Coarsening&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e6cb5398ced000d3d2d4fd852f609957-e-3&quot;, &quot;chunk-e6cb5398ced000d3d2d4fd852f609957-e-2&quot;, &quot;chunk-d916edba6cb97ae9adb8c87b210a4263-e-4&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-d916edba6cb97ae9adb8c87b210a4263-e-5" label="γ phase lattice parameter (aγ)">
        <attvalues>
          <attvalue for="0" value="γ phase lattice parameter (aγ)" />
          <attvalue for="1" value="Physical Parameter" />
          <attvalue for="2" value="γ相晶格常数（aγ）是表征γ相晶胞尺寸的物理参数。其数值由该相的元素成分决定，此依赖关系常遵循维加德定律。作为计算γ/γ'晶格错配度（δ）的关键组成部分，它对材料（如高温合金）的性能有重要影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d916edba6cb97ae9adb8c87b210a4263" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;aγ&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d916edba6cb97ae9adb8c87b210a4263-e-5&quot;, &quot;chunk-81bc3923680aea07100d05a64a8f3afc-e-1&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-d916edba6cb97ae9adb8c87b210a4263-e-6" label="γ' phase lattice parameter (aγ')">
        <attvalues>
          <attvalue for="0" value="γ' phase lattice parameter (aγ')" />
          <attvalue for="1" value="Physical Parameter" />
          <attvalue for="2" value="γ'相晶格参数（aγ'）是表征γ'相晶胞尺寸的物理参数。其数值由该相的元素成分决定，此依赖关系通常遵循维加德定律（Vegard's Law）。该参数是计算γ/γ'晶格错配度（δ）的核心分量之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-d916edba6cb97ae9adb8c87b210a4263" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;aγ'&quot;, &quot;Αγ'&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d916edba6cb97ae9adb8c87b210a4263-e-6&quot;, &quot;chunk-81bc3923680aea07100d05a64a8f3afc-e-2&quot;, &quot;chunk-bfbc49438adee74f98c04c5e0bb57599-e-2&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-d916edba6cb97ae9adb8c87b210a4263-e-7" label="Vegard's Law">
        <attvalues>
          <attvalue for="0" value="Vegard's Law" />
          <attvalue for="1" value="Scientific Law" />
          <attvalue for="2" value="维加德定律（Vegard's law）是晶体学和材料科学中的一个经验法则。它指出，在恒定温度下，一种固溶体（如合金）的晶格常数与其构成元素的浓度近似成线性关系，可视为各组分晶格常数的加权平均值。该定律常用于估算γ/γ'相等合金相的晶格参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d916edba6cb97ae9adb8c87b210a4263" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Vegard law&quot;, &quot;Vegard's law&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d916edba6cb97ae9adb8c87b210a4263-e-7&quot;, &quot;chunk-81bc3923680aea07100d05a64a8f3afc-e-3&quot;, &quot;chunk-44260d4b7de8c9a00040496e0aad271b-e-11&quot;, &quot;chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d916edba6cb97ae9adb8c87b210a4263-e-8" label="Elemental Compositions in each phase">
        <attvalues>
          <attvalue for="0" value="Elemental Compositions in each phase" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一项材料属性，指构成γ相与γ'相的化学元素种类及比例。该成分是决定这两相各自晶格常数（aγ和aγ'）的根本因素，从而影响材料的宏观性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-d916edba6cb97ae9adb8c87b210a4263" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-81bc3923680aea07100d05a64a8f3afc-e-4" label="Elemental Compositions">
        <attvalues>
          <attvalue for="0" value="Elemental Compositions" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;元素组成是一种材料属性，指材料各相中所含化学元素的种类及比例。该属性是决定各相晶格常数（如 aγ 和 aγ'）和元素在相间分配（如 γ/γ' partitioning）等微观结构特征的基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-81bc3923680aea07100d05a64a8f3afc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-81bc3923680aea07100d05a64a8f3afc-e-5" label="γ/γ' partitioning">
        <attvalues>
          <attvalue for="0" value="γ/γ' partitioning" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="一种物理现象，指在含有γ（基体）相和γ'（析出）相的合金中，不同合金元素在这两相之间进行不均匀的分配。这种分配行为决定了γ相与γ'相各自的化学成分和晶格参数，从而影响材料的晶格错配和宏观性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-81bc3923680aea07100d05a64a8f3afc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-81bc3923680aea07100d05a64a8f3afc-e-6" label="γ phase">
        <attvalues>
          <attvalue for="0" value="γ phase" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="γ基体（γ matrix）是一种材料相，在γ'析出相之间形成连续的基体通道。作为优化微观结构的关键组分，这些通道是蠕变位错运动的主要区域。精确调控其体积分数（通常是减少）是提升材料高温强度和蠕变抗力等优异性能的重要途径。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-81bc3923680aea07100d05a64a8f3afc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;γ&quot;, &quot;γ (gamma)&quot;, &quot;γ matrix&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5b9a3c27ff490c221f01663699f4563f-e-3&quot;, &quot;chunk-81bc3923680aea07100d05a64a8f3afc-e-6&quot;, &quot;chunk-9a94346ed73c8bcf6797ad71ded00b42-e-7&quot;, &quot;chunk-2ea107a54755373c4c649a5b4b0b14ad-e-2&quot;, &quot;chunk-1a5bdd6114d60338a6db59595a5e76c4-e-2&quot;, &quot;chunk-003c7763c31b55c8a5748939ac729c6a-e-7&quot;, &quot;chunk-7cf96eceef65bf46495ba2d8c36b9a73-e-4&quot;, &quot;chunk-9a641206a39d9f183256b080afe1f768-e-2&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-81bc3923680aea07100d05a64a8f3afc-e-8" label="Equation 3.18">
        <attvalues>
          <attvalue for="0" value="Equation 3.18" />
          <attvalue for="1" value="Mathematical Equation" />
          <attvalue for="2" value="方程式3.18是用于计算γ相晶格常数(aγ)的数学公式。该公式以各元素的摩尔分数(xiγ)为变量进行计算，其常数项则根据第二章中的关联式推导得出。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;αγ = 3.524 + 0.110xCr + 0.478xMo +0.444xw + 0.441xRe +0.179xAl +0.422xTi + 0.700xTa&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-81bc3923680aea07100d05a64a8f3afc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-81bc3923680aea07100d05a64a8f3afc-e-9" label="Mole Fractions (xiγ)">
        <attvalues>
          <attvalue for="0" value="Mole Fractions (xiγ)" />
          <attvalue for="1" value="Chemical Measurement" />
          <attvalue for="2" value="摩尔分数 (xiγ) 是一种化学量度，指在γ相中，特定元素i（如Cr, Mo等）的摩尔数占该相总摩尔数的比例。它精确描述了γ相的化学成分，并被用于特定计算（如方程3.18）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-81bc3923680aea07100d05a64a8f3afc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-81bc3923680aea07100d05a64a8f3afc-e-10" label="Equation for aγ'">
        <attvalues>
          <attvalue for="0" value="Equation for aγ'" />
          <attvalue for="1" value="Mathematical Equation" />
          <attvalue for="2" value="一个不完整的数学公式，用于计算γ'相的晶格常数（aγ'）。γ'相是高温合金中的关键强化相，其晶格常数是影响材料错配度和性能的重要物理参数。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;Αγ' = 3.570 – 0.0...&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-81bc3923680aea07100d05a64a8f3afc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-81bc3923680aea07100d05a64a8f3afc-e-10&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-81bc3923680aea07100d05a64a8f3afc-e-11" label="Correlations from Chapter 2">
        <attvalues>
          <attvalue for="0" value="Correlations from Chapter 2" />
          <attvalue for="1" value="Data Source" />
          <attvalue for="2" value="一个数据源，指特定文献第二章中阐述的一组相关性（Correlations）。它为方程3.18的计算提供了所需的各种常数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-81bc3923680aea07100d05a64a8f3afc" />
