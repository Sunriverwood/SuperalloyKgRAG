      <node id="chunk-61614a48414c169528ed8ada3a1933ea-e-5" label="Relationships between microstructural instabilities and mechanical behaviour in new generation nickel-based single crystal superalloys">
        <attvalues>
          <attvalue for="0" value="Relationships between microstructural instabilities and mechanical behaviour in new generation nickel-based single crystal superalloys" />
          <attvalue for="1" value="Paper" />
          <attvalue for="2" value="一篇由O. Lavigne等人发表于《Superalloys 2004》的学术论文。该论文研究了新一代镍基单晶高温合金中，微观结构不稳定性与宏观力学行为之间的内在联系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-61614a48414c169528ed8ada3a1933ea" />
