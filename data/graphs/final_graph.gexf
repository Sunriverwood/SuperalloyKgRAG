      <node id="chunk-88fbc7a52ff45f9431f17e23dd2d49a1-e-9" label="[(6γAPB fr/(πT))¹/² − f]">
        <attvalues>
          <attvalue for="0" value="[(6γAPB fr/(πT))¹/² − f]" />
          <attvalue for="1" value="Mathematical Factor" />
          <attvalue for="2" value="一个数学因子，表达式为[(6γAPB fr/(πT))¹/² − f]。它在特定科学或工程计算中，作为公式(2.29)的一个乘法项，其值由多个物理变量（如γ, A, P, B, fr, T, f）共同决定。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;~0.46&quot;}" />
