      <edge source="chunk-98f4bd6f7320ce29bc3a42071b0fee20-e-1" target="chunk-a20a835d2cdab6d6d8e5c12e628578cc-e-4" id="chunk-a20a835d2cdab6d6d8e5c12e628578cc-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_BASED_ON_ASSUMPTION_ABOUT" />
          <attvalue for="12" value="The declaration of a safe service life is based on the assumption that the number of cycles to failure follows a specific statistical distribution." />
          <attvalue for="13" value="For the purposes of declaring a safe service life, it is assumed that (i) the number of cycles to failure is distributed according to a log-normal dens" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-a20a835d2cdab6d6d8e5c12e628578cc" />
          <attvalue for="16" value="0.013157894736842105" />
          <attvalue for="17" value="0.4078947368421053" />
        </attvalues>
      </edge>
      <edge source="chunk-98f4bd6f7320ce29bc3a42071b0fee20-e-1" target="chunk-cae41d8859f876b74046ac829e1e4b4c-e-3" id="chunk-98f4bd6f7320ce29bc3a42071b0fee20-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_LOWER_THAN" />
          <attvalue for="12" value="The 'safe life' is lower than the geometric mean of the results from spin testing by a factor equal to the denominator." />
          <attvalue for="13" value="The denominator in the above equation, i.e. the factor by which the 'safe life' is lower than the geometric mean of the results from spin testing, is 4.00 when n = 1, falling to 3.25 when n = 3 and 2.90 when n = 8-thus, a" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-98f4bd6f7320ce29bc3a42071b0fee20" />
          <attvalue for="16" value="0.015789473684210527" />
          <attvalue for="17" value="0.4094736842105263" />
        </attvalues>
      </edge>
      <edge source="chunk-98f4bd6f7320ce29bc3a42071b0fee20-e-1" target="chunk-98f4bd6f7320ce29bc3a42071b0fee20-e-3" id="chunk-98f4bd6f7320ce29bc3a42071b0fee20-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_CALCULATED_USING" />
          <attvalue for="12" value="The 'safe life' is calculated by dividing the geometric mean by the denominator." />
          <attvalue for="13" value="safe life = (Π(i=1 to n) Ni)^(1/n) / (2.449 x 6^((1.645)/(6√n)))" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-98f4bd6f7320ce29bc3a42071b0fee20" />
          <attvalue for="16" value="0.02368421052631579" />
          <attvalue for="17" value="0.4142105263157895" />
        </attvalues>
      </edge>
      <edge source="chunk-98f4bd6f7320ce29bc3a42071b0fee20-e-3" target="chunk-98f4bd6f7320ce29bc3a42071b0fee20-e-4" id="chunk-98f4bd6f7320ce29bc3a42071b0fee20-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="VALUE_DEPENDS_ON" />
          <attvalue for="12" value="The value of the denominator changes depending on the value of n; it is 4.00 when n=1, 3.25 when n=3, and 2.90 when n=8." />
          <attvalue for="13" value="The denominator in the above equation... is 4.00 when n = 1, falling to 3.25 when n = 3 and 2.90 when n = 8" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-98f4bd6f7320ce29bc3a42071b0fee20" />
          <attvalue for="16" value="0.010526315789473684" />
          <attvalue for="17" value="0.40631578947368424" />
        </attvalues>
      </edge>
      <edge source="chunk-98f4bd6f7320ce29bc3a42071b0fee20-e-3" target="chunk-cae41d8859f876b74046ac829e1e4b4c-e-7" id="chunk-98f4bd6f7320ce29bc3a42071b0fee20-r-4" weight="4.0">
        <attvalues>
          <attvalue for="11" value="IS_CALCULATED_USING" />
          <attvalue for="12" value="The denominator's formula includes an exponent that uses the value 1.645, which corresponds to 1.645 standard deviations." />
          <attvalue for="13" value="safe life = (Π(i=1 to n) Ni)^(1/n) / (2.449 x 6^((1.645)/(6√n)))" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-98f4bd6f7320ce29bc3a42071b0fee20" />
          <attvalue for="16" value="0.010526315789473684" />
          <attvalue for="17" value="0.2729824561403509" />
        </attvalues>
      </edge>
      <edge source="chunk-5672d8823c0e88aff98a62f9c1f74614-e-1" target="chunk-5672d8823c0e88aff98a62f9c1f74614-e-2" id="chunk-5672d8823c0e88aff98a62f9c1f74614-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_VALUE_WHEN" />
          <attvalue for="12" value="The safety factor is 4.00 when n=1, falls to 3.25 when n=3, and is 2.90 when n=8." />
          <attvalue for="13" value="is 4.00 when n = 1, falling to 3.25 when n = 3 and 2.90 when n = 8" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-5672d8823c0e88aff98a62f9c1f74614" />
          <attvalue for="16" value="0.5" />
          <attvalue for="17" value="0.7" />
