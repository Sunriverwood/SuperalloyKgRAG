      <node id="chunk-cd90df188efe63a1aba2d62ab225c3ae-e-12" label="Oxidation mechanisms of β-NiAl + Zr determined by SIMS">
        <attvalues>
          <attvalue for="0" value="Oxidation mechanisms of β-NiAl + Zr determined by SIMS" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由R. Prescott等人于1995年发表在《腐蚀科学》(Corrosion Science)上的研究论文。该文利用二次离子质谱(SIMS)技术，探讨了掺锆(Zr)的β-NiAl合金的氧化机理。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1995&quot;}" />
