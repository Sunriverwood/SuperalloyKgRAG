          <attvalue for="9" value="44" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3219701e460dd07570bedda4067e6548-e-6" label="1980">
        <attvalues>
          <attvalue for="0" value="1980" />
          <attvalue for="1" value="Year" />
          <attvalue for="2" value="1980年是第一代单晶高温合金出现的年份。它的问世是材料科学领域的重大里程碑，为现代高性能航空发动机的发展奠定了关键基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-3219701e460dd07570bedda4067e6548" />
          <attvalue for="6" value="true" />
