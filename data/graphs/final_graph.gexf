      <node id="chunk-6f4f79d57f35ab3e77324ff6707d70bf-e-7" label="M. Osawa">
        <attvalues>
          <attvalue for="0" value="M. Osawa" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="M. Osawa是一位研究人员，作为合著者发表了学术论文《Degradation mechanisms of an advanced jet engine service-retired TBC component》，该论文研究了先进航空发动机热障涂层部件的降解机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
