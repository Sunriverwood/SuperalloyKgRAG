        <attvalues>
          <attvalue for="11" value="IS_A" />
          <attvalue for="12" value="Vacuum melting is an example of a new process that played a key role." />
          <attvalue for="13" value="The development of new processes has played a key role too, partic- ularly vacuum melting, directional solidification/investment casting and powder metallurgy techniques." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-f1dbde91fa2668ef8c190d0d43e91e27" />
          <attvalue for="16" value="0.00034698126301179735" />
          <attvalue for="17" value="0.4002081887578071" />
        </attvalues>
      </edge>
      <edge source="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24-e-1" target="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24-e-2" id="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="OCCURRED_DURING" />
          <attvalue for="12" value="Superalloy development was carried out during the height of the Cold War." />
          <attvalue for="13" value="In the post-war period to the late 1970s when the Cold War was at its height, most cutting-edge superalloy development was carried out in support of engine designs for military aircraft" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24" />
          <attvalue for="16" value="0.00040816326530612246" />
