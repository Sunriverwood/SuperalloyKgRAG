        <attvalues>
          <attvalue for="11" value="IS_SOURCE_OF" />
          <attvalue for="12" value="Thermal gradients are inherited from the quenching process." />
          <attvalue for="13" value="thermal gradients inherited from the quenching process [6]." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-2b0bf628a95c22fc39c3dcd9f2959fd7" />
          <attvalue for="16" value="0.00020884093282283326" />
          <attvalue for="17" value="0.4001253045596937" />
