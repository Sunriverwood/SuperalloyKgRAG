          <attvalue for="9" value="370" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-f23caa328479b9d419f0d855b9335eb4-e-15" label="Mar-M247">
        <attvalues>
          <attvalue for="0" value="Mar-M247" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="Mar-M247是一种沉淀强化铸造镍基高温合金，以其卓越的高温强度、抗蠕变性、热疲劳性能和抗氧化性而著称。它主要用于制造航空发动机和工业燃气轮机在严苛环境下工作的涡轮叶片、导向叶片等热端部件。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;179&quot;}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-f23caa328479b9d419f0d855b9335eb4" />
