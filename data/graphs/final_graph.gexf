          <attvalue for="9" value="28" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-36ca7e4f37f1d7c5cf301fbbdf528667-e-3" label="Materials Science and Engineering">
        <attvalues>
          <attvalue for="0" value="Materials Science and Engineering" />
          <attvalue for="1" value="Field of Study" />
          <attvalue for="2" value="材料科学与工程 (Materials Science and Engineering) 是研究材料的制备、结构、性能和应用之间相互关系的交叉学科。该领域旨在理解并设计具有特定性能的新材料，以满足工程应用需求，而高温合金是其一个经典的案例研究。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-36ca7e4f37f1d7c5cf301fbbdf528667" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;materials&quot;, &quot;materials science and engineering&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-36ca7e4f37f1d7c5cf301fbbdf528667-e-3&quot;, &quot;chunk-6368a72cf89a3485f9379d1f9ae026ed-e-2&quot;, &quot;chunk-0898547a68d165adae5002ba87d72e05-e-5&quot;, &quot;chunk-21326bde35e345c13df547ee17d7383b-e-2&quot;]}]" />
          <attvalue for="9" value="28" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-6259a0e40ccab0aecc0c6e93b8bbc879-e-1" label="Unnamed Person">
        <attvalues>
          <attvalue for="0" value="Unnamed Person" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="一位在燃气轮机领域享有盛誉的杰出学者和研究员。其专业领域为超合金的物理冶金学，并曾执教该课程。曾担任加拿大首席研究教授（Canada Research Chair）和研究部副主任等重要学术及研究职务。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-6259a0e40ccab0aecc0c6e93b8bbc879" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="28" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-6259a0e40ccab0aecc0c6e93b8bbc879-e-2" label="Rolls-Royce University Technology Centre">
        <attvalues>
          <attvalue for="0" value="Rolls-Royce University Technology Centre" />
          <attvalue for="1" value="Institution" />
          <attvalue for="2" value="罗尔斯·罗伊斯大学技术中心是由罗尔斯·罗伊斯公司(Rolls-Royce)在剑桥大学设立的合作研究机构。作为其全球大学技术中心(UTC)网络的一部分，它致力于开展与公司核心业务相关的长期、前沿性工程技术研究，是典型的校企合作模式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-6259a0e40ccab0aecc0c6e93b8bbc879" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Rolls-Royce University&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-36ca7e4f37f1d7c5cf301fbbdf528667-e-4&quot;, &quot;chunk-6259a0e40ccab0aecc0c6e93b8bbc879-e-2&quot;]}]" />
          <attvalue for="9" value="28" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-6259a0e40ccab0aecc0c6e93b8bbc879-e-3" label="University of Cambridge">
        <attvalues>
          <attvalue for="0" value="University of Cambridge" />
          <attvalue for="1" value="University" />
          <attvalue for="2" value="剑桥大学（University of Cambridge）是一所位于英国剑bridge的世界顶尖公立研究型大学。它成立于1209年，是英语世界第二古老的大学，采用独特的学院制。该校在众多领域拥有崇高的学术地位，也是劳斯莱斯大学技术中心等知名研究机构的所在地。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-6259a0e40ccab0aecc0c6e93b8bbc879" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6259a0e40ccab0aecc0c6e93b8bbc879-e-3&quot;, &quot;chunk-db112f42ba337a9c38c411ed00ca9f69-e-3&quot;, &quot;chunk-225043bdf7b58131b7138652c49cfca0-e-5&quot;, &quot;chunk-8037aec19ea88422e6032e36e14ec0c5-e-11&quot;]}]" />
          <attvalue for="9" value="28" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-6259a0e40ccab0aecc0c6e93b8bbc879-e-4" label="Canada Research Chair">
        <attvalues>
          <attvalue for="0" value="Canada Research Chair" />
          <attvalue for="1" value="Academic Position" />
          <attvalue for="2" value="加拿大研究主席是加拿大政府为吸引和留住全球顶尖研究人才而设立的国家级重要学术头衔。该职位由符合条件的加拿大大学授予，旨在支持学者在其研究领域取得卓越成就。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-6259a0e40ccab0aecc0c6e93b8bbc879" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="28" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6259a0e40ccab0aecc0c6e93b8bbc879-e-5" label="Department of Materials Engineering">
        <attvalues>
          <attvalue for="0" value="Department of Materials Engineering" />
          <attvalue for="1" value="Academic Department" />
          <attvalue for="2" value="不列颠哥伦比亚大学温哥华分校的学术部门，专注于材料科学与工程领域的教学和研究。该系是加拿大为吸引世界顶尖学者而设立的“加拿大首席研究主席”(Canada Research Chair) 职位的所在地，代表了其在相关领域的重要学术地位。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-6259a0e40ccab0aecc0c6e93b8bbc879" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="28" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6259a0e40ccab0aecc0c6e93b8bbc879-e-7" label="gas turbine community">
        <attvalues>
          <attvalue for="0" value="gas turbine community" />
          <attvalue for="1" value="Community" />
          <attvalue for="2" value="一个由燃气轮机领域的专家、工程师、研究人员及相关从业者所组成的专业性社群。该群体围绕燃气轮机的研发、设计、制造、运维及应用等主题进行交流、合作与知识共享。" />
          <attvalue for="3" value="{}" />
