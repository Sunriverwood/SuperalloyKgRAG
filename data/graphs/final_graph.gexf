        <attvalues>
          <attvalue for="11" value="IS_A" />
          <attvalue for="12" value="Nickel-based superalloys are classified as a type of engineering material." />
          <attvalue for="13" value="Nickel-based superalloys represent a very important class of engineering material" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-562ab8120c986d32d5b96c3da5071063" />
          <attvalue for="16" value="0.00031739986034406146" />
