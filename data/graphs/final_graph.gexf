      <node id="chunk-db112f42ba337a9c38c411ed00ca9f69-e-4" label="University of British Columbia">
        <attvalues>
          <attvalue for="0" value="University of British Columbia" />
          <attvalue for="1" value="University" />
          <attvalue for="2" value="不列颠哥伦比亚大学（University of British Columbia, UBC）是加拿大的顶尖公立研究型大学，主校区位于温哥华。它被公认为世界一流高等学府，以其卓越的教学质量、科研实力和全球影响力而著称。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-db112f42ba337a9c38c411ed00ca9f69" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;University of British Columbia, Vancouver&quot;]" />
