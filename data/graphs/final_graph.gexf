        <attvalues>
          <attvalue for="11" value="ARRIVES_AT" />
          <attvalue for="12" value="The stream of molten metal arrives at the nozzle." />
          <attvalue for="13" value="A continuous stream of gas at high pressure is delivered to the stream of molten metal arriving at the nozzle" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-dc663680c2568caff49f127612995631" />
          <attvalue for="16" value="0.000784313725490196" />
