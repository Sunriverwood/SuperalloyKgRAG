        <attvalues>
          <attvalue for="11" value="USED_TO_DEMONSTRATE" />
          <attvalue for="12" value="Experiments on a generic disc shape were used to demonstrate the advantages and reliability of the dual grain structure." />
          <attvalue for="13" value="with experiments on a generic disc shape demonstrating the advantages and reliability of the dual grain structure at the component level" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-f942fb543f3ac01d63fdbc3537940608" />
