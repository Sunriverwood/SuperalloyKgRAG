        <attvalues>
          <attvalue for="11" value="IS_LOWER_THAN" />
          <attvalue for="12" value="The calculated value of Go (about 25 J/m²) is substantially lower than the mode II fracture toughness, ΓⅡ (60 to 100 J/m²)." />
          <attvalue for="13" value="This is substantially lower than the mode II fracture toughness, ΓⅡ, which is in the range 60 to 100 J/m²" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-5395b7a3b731615ee1a2521907378b84" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-bf602d6d22c552a1206d1179123ca1f7-e-1" target="chunk-bf602d6d22c552a1206d1179123ca1f7-e-3" id="chunk-5395b7a3b731615ee1a2521907378b84-r-6" weight="4.0">
        <attvalues>
          <attvalue for="11" value="IS_CALCULATED_USING" />
          <attvalue for="12" value="Go is calculated using the variable E||, which has a value of 20 GPa." />
          <attvalue for="13" value="Inserting reasonable values for the variables, for example, E|| = 20 GPa, ν = 0.3, h = 100 µm and єT = 5 × 10−3, one finds that Go is about 25 J/m²." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-5395b7a3b731615ee1a2521907378b84" />
          <attvalue for="16" value="0.0001546072974644403" />
