        <attvalues>
          <attvalue for="0" value="d" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="一个表示“规定寿命”(Prescribed Life)的变量，由参数`No`所定义。它是一个基本输入值，用于确定另一相关量`d/Di`。" />
          <attvalue for="3" value="{}" />
