        </attvalues>
      </edge>
      <edge source="chunk-98004d55693f7f9432c5daf0464e7353-e-6" target="chunk-c07d98a8c6e8b07242a68bd712fcfe4c-e-2" id="chunk-c07d98a8c6e8b07242a68bd712fcfe4c-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DEFINES" />
          <attvalue for="12" value="The Paris law expression defines the crack growth rate (da/dN)." />
          <attvalue for="13" value="da/dN = AΔK^m" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-c07d98a8c6e8b07242a68bd712fcfe4c" />
          <attvalue for="16" value="0.006578947368421052" />
          <attvalue for="17" value="0.40394736842105267" />
        </attvalues>
      </edge>
      <edge source="chunk-98004d55693f7f9432c5daf0464e7353-e-6" target="chunk-c07d98a8c6e8b07242a68bd712fcfe4c-e-10" id="chunk-c07d98a8c6e8b07242a68bd712fcfe4c-r-8" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_INTEGRATED_TO" />
          <attvalue for="12" value="The Paris law expression is integrated to derive the formula for No, the number of cycles to failure." />
          <attvalue for="13" value="Upon inserting the expression for ∆Κ = Υ∆σ√πa, and after performing the appropriate integration, one has No = 1 / (A(m/2 – 1)Y^m Δσ^m π^(m/2)) * [1 / a_NDI^(m/2-1) - 1 / a_crit^(m/2-1)]" />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-c07d98a8c6e8b07242a68bd712fcfe4c" />
          <attvalue for="16" value="0.0015467061693970024" />
          <attvalue for="17" value="0.4009280237016382" />
        </attvalues>
      </edge>
      <edge source="chunk-98004d55693f7f9432c5daf0464e7353-e-6" target="chunk-e77911125f8830a7b4bf67b20165ed0e-e-3" id="chunk-8f26cf45a6fdac28f68b7d1e6d3677ff-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_FORM" />
          <attvalue for="12" value="The specific form of the Paris relationship for the mentioned superalloys is given by the equation da/dN = 4 × 10−12 ΔΚ^3.3." />
          <attvalue for="13" value="For many of the polycrystalline nickel-based superalloys used for turbine disc applications, the Paris relationship is of the form da/dN = 4 × 10−12 ΔΚ^3.3" />
          <attvalue for="14" value="r-4" />
