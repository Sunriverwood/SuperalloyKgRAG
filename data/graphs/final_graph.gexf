        <attvalues>
          <attvalue for="0" value="d/Di" />
          <attvalue for="1" value="Ratio" />
          <attvalue for="2" value="一个表示为d/Di的数值比率，其值由参数d等决定，并用于确定p4。该比率在图4.46中有图示说明。" />
