        <attvalues>
          <attvalue for="11" value="OVERTAKES" />
          <attvalue for="12" value="The growth of the NiO scale rapidly surpasses the initial formation of the Ni(Al, Cr)2O4 spinel." />
          <attvalue for="13" value="Oxidation begins with the formation of Ni(Al, Cr)2O4, which is rapidly overtaken by a brittle, outward-growing NiO scale" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-2292cbd804c7d75d1e8a3ada6e8b42bd" />
          <attvalue for="16" value="0.00013599891200870393" />
