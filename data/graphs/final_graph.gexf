          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-28369a1f48e0d9ccd0e560147c06b368-e-6&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-28369a1f48e0d9ccd0e560147c06b368-e-7" label="29 ppm">
        <attvalues>
          <attvalue for="0" value="29 ppm" />
          <attvalue for="1" value="Concentration" />
          <attvalue for="2" value="29 ppm (百万分之二十九) 是一个浓度单位，此处特指在材料科学或半导体制造中，硼掺杂工艺经过提升后所达到的最终掺杂物浓度。" />
          <attvalue for="3" value="{}" />
