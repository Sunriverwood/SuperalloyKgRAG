      <node id="chunk-ab782043d3ae1a90c5f1e5036270c1d8-e-3" label="M. F. J. Koolloos">
        <attvalues>
          <attvalue for="0" value="M. F. J. Koolloos" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="M. F. J. Koolloos是一位研究人员，其研究领域涉及材料科学与工程。作为作者之一，他发表了关于人字形电子束物理气相沉积（EB-PVD）热障涂层燃烧器台架测试的学术出版物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
