      </node>
      <node id="chunk-19203bda469f6dad8b0600aecd2de043-e-3" label="Curvature">
        <attvalues>
          <attvalue for="0" value="Curvature" />
          <attvalue for="1" value="Geometric Property" />
          <attvalue for="2" value="曲率是一种几何属性，特指前沿位错在运动中因遭遇粒子阻碍，其位错线上所产生的弯曲。这种弯曲的程度由曲率半径来度量，是描述位错与障碍物相互作用的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-19203bda469f6dad8b0600aecd2de043" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-19203bda469f6dad8b0600aecd2de043-e-4" label="Particles">
        <attvalues>
          <attvalue for="0" value="Particles" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="在材料科学中，指阻碍位错运动的物理实体。在描述其与位错相互作用的模型（如l{x}函数）中，为简化计算，常被假定为球形。它们的存在是影响材料强度的关键障碍物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-19203bda469f6dad8b0600aecd2de043" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-19203bda469f6dad8b0600aecd2de043-e-4&quot;, &quot;chunk-bc7ac356d3b96aa45f10f8864536d6bf-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-19203bda469f6dad8b0600aecd2de043-e-5" label="Pinning Force">
        <attvalues>
          <attvalue for="0" value="Pinning Force" />
          <attvalue for="1" value="Force" />
          <attvalue for="2" value="钉扎力(Pinning Force)是一种物理力，指材料内部的粒子、析出相或缺陷对位错运动产生的最大阻碍力。该力将位错束缚（或“钉扎”）在特定位置，阻碍其滑移，是金属与合金强化的关键机制。当外力超过钉扎力时，位错将脱离束缚继续移动。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;F&quot;, &quot;formula&quot;: &quot;2γAPBr&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-19203bda469f6dad8b0600aecd2de043" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Pinning Forces&quot;, &quot;Pinning Forces (Fᵢ)&quot;, &quot;Pinning forces&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-8&quot;, &quot;chunk-a478184a271f81c44b621f35badc5f0a-e-3&quot;, &quot;chunk-aaf1405fdcaab5726ea1519f7e18e407-e-7&quot;, &quot;chunk-62e0b88322cda2b3939ddacaff16f02d-e-2&quot;, &quot;chunk-19203bda469f6dad8b0600aecd2de043-e-5&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
