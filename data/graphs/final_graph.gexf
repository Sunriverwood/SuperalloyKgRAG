        <attvalues>
          <attvalue for="11" value="EXISTS_BELOW" />
          <attvalue for="12" value="The solutioning window (AT) must exist below the melting temperature." />
          <attvalue for="13" value="There should exist a sufficient solutioning window, AT, below the melting temperature, across which y is the only stable phase." />
