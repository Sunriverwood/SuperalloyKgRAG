        <attvalues>
          <attvalue for="11" value="USED_TO_FIND_CORRELATION_FOR" />
          <attvalue for="12" value="Creep tests are the method used to establish the strong correlation between the Larson-Miller parameter (P) and logσ." />
          <attvalue for="13" value="When creep tests for various combinations of (σ, T) are carried out, one usually finds a strong correlation between P and logσ, consistent with the assumptions made." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-7cf221202ae924d5b8c87acce1ae3bfd" />
