      <node id="chunk-918e2b930e37d82a44d73a02b4fca57a-e-3" label="M. Y. He">
        <attvalues>
          <attvalue for="0" value="M. Y. He" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="M. Y. He是一位研究人员，因合著学术论文《残余压缩脆性薄膜和涂层的脱落微力学模型》(Micromechanics model for the detachment of residually compressed brittle films and coatings) 而为人所知。该论文属于固体力学与材料科学领域，为理解和预测脆性薄膜在残余压应力下的分离行为提供了理论模型。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-918e2b930e37d82a44d73a02b4fca57a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-918e2b930e37d82a44d73a02b4fca57a-e-4" label="Micromechanics model for the detachment of residually compressed brittle films and coatings">
        <attvalues>
          <attvalue for="0" value="Micromechanics model for the detachment of residually compressed brittle films and coatings" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《残余压缩脆性薄膜和涂层分离的微观力学模型》是一篇学术论文，由 A. G. Evans、J. W. Hutchinson 和 M. Y. He 共同撰写，于1999年发表在材料科学领域的权威期刊《Acta Materialia》上。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1999&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-918e2b930e37d82a44d73a02b4fca57a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-918e2b930e37d82a44d73a02b4fca57a-e-8" label="K. Vaidyanathan">
        <attvalues>
          <attvalue for="0" value="K. Vaidyanathan" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="K. Vaidyanathan是一位学者、研究员，是学术论文《热障涂层的结合强度、结合应力及剥落机理》(Bond strength, bond stress and spallation mechanisms of thermal barrier coatings) 的作者之一。其研究领域主要涉及热障涂层材料的力学性能与失效机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-918e2b930e37d82a44d73a02b4fca57a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-918e2b930e37d82a44d73a02b4fca57a-e-8&quot;, &quot;chunk-356a95a5ba9ccf9ed595619218c5107b-e-9&quot;]}]" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-918e2b930e37d82a44d73a02b4fca57a-e-9" label="Bond strength, bond stress and spallation mechanisms of thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="Bond strength, bond stress and spallation mechanisms of thermal barrier coatings" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由 M. Gell、E. Jordan 和 K. Vaidyanathan 合著的学术论文，全称为《热障涂层的结合强度、结合应力及剥落机理》，于1999年发表在学术期刊《表面与涂层技术》(Surface and Coatings Technology)上。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1999&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-918e2b930e37d82a44d73a02b4fca57a" />
