      <node id="chunk-a584f7fe38f352b7318e0169178d3d01-e-13" label="N. A. Cumpsty">
        <attvalues>
          <attvalue for="0" value="N. A. Cumpsty" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="N. A. Cumpsty是一位航空工程领域的专家与作者，以其在喷气推进技术方面的研究而闻名。他撰写的《Jet Propulsion: A Simple Guide to the Aerodynamic and Thermodynamic Design and Performance of Jet Engines》一书，是该领域内阐述喷气发动机设计与性能原理的权威著作。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
