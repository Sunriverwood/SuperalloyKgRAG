      <edge source="chunk-9718b105c96174ffb3694bd3c4362a1e-e-2" target="chunk-59b9b1adda4a73bb67c682f77b77e783-e-5" id="chunk-9718b105c96174ffb3694bd3c4362a1e-r-3" weight="4.0">
        <attvalues>
          <attvalue for="11" value="INFLUENCES" />
          <attvalue for="12" value="The fact that Al atoms are not in nearest-neighbour positions leads to the theoretical conclusion that the APB energy will be close to zero." />
          <attvalue for="13" value="It follows then that Al atoms are never brought into nearest-neighbour positions, so that the APB energy will be close to zero." />
          <attvalue for="14" value="r-3" />
