        <attvalues>
          <attvalue for="11" value="ACTS_BETWEEN" />
          <attvalue for="12" value="The repulsive force R acts between two dislocations of the same sign." />
          <attvalue for="13" value="The repulsive force acting between two dislocations of the same sign, separated by a distance xm, is approximately Gb²/(2πxm) per unit length" />
          <attvalue for="14" value="r-6" />
