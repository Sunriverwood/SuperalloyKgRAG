        <attvalues>
          <attvalue for="11" value="DEFINES" />
          <attvalue for="12" value="Equation (1.11) is the form used to define P, the Larson-Miller parameter." />
          <attvalue for="13" value="Equation (1.10) can be written in the form T[E + log₁₀ tr] = P (1.11) where P is known as the Larson–Miller parameter" />
          <attvalue for="14" value="r-9" />
          <attvalue for="15" value="chunk-f2dcbd0ede6add46d4e0540d9a794efa" />
          <attvalue for="16" value="0.06666666666666667" />
