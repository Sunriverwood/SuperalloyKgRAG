      </node>
      <node id="chunk-a584f7fe38f352b7318e0169178d3d01-e-12" label="The Metals Society">
        <attvalues>
          <attvalue for="0" value="The Metals Society" />
          <attvalue for="1" value="Publisher" />
          <attvalue for="2" value="The Metals Society是一家专注于冶金与材料科学领域的专业出版机构。该机构曾出版《高温用定向凝固材料》(Directionally Solidified Materials for High Temperature Service)等学术著作。" />
          <attvalue for="3" value="{&quot;location&quot;: &quot;London&quot;}" />
