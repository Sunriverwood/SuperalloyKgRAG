        <attvalues>
          <attvalue for="11" value="CREATES" />
          <attvalue for="12" value="The passage of the two paired dislocations leaves faulted particles between them." />
          <attvalue for="13" value="consequently, the second trailing dislocation is some way behind the first, leaving faulted particles between the two." />
          <attvalue for="14" value="r-7" />
