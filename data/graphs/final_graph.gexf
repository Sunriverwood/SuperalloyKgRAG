      <node id="chunk-0b443cc5c8498dc201a772ab50af4847-e-12" label="P. F. Tortorelli">
        <attvalues>
          <attvalue for="0" value="P. F. Tortorelli" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="P. F. Tortorelli是一位学者，作为作者之一参与撰写了材料科学领域的学术著作《金属间化合物的高温氧化和腐蚀》(High temperature oxidation and corrosion of intermetallics)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-0b443cc5c8498dc201a772ab50af4847" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0b443cc5c8498dc201a772ab50af4847-e-12&quot;, &quot;chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a-e-3&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0b443cc5c8498dc201a772ab50af4847-e-13" label="I. G. Wright">
        <attvalues>
          <attvalue for="0" value="I. G. Wright" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="I. G. Wright是一位研究人员，作为作者之一参与撰写了学术出版物《The use of two reactive elements to optimise oxidation performance of alumina-forming alloys》，该著作专注于优化氧化铝形成合金的氧化性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-0b443cc5c8498dc201a772ab50af4847" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0b443cc5c8498dc201a772ab50af4847-e-13&quot;, &quot;chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a-e-4&quot;, &quot;chunk-1abe15e2f2db1602f97ac75bb847ef30-e-12&quot;, &quot;chunk-bdbf4600f0f46ee6111ce0bae60fe800-e-7&quot;, &quot;chunk-c5385f7f28e0875405c91c30084a5d9b-e-4&quot;, &quot;chunk-68a06b7c34233385dd7e1ad8a70b5d54-e-3&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-0b443cc5c8498dc201a772ab50af4847-e-14" label="R. J. Hanrahan">
        <attvalues>
          <attvalue for="0" value="R. J. Hanrahan" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="R. J. Hanrahan是一位学者，也是专业出版物《High temperature oxidation and corrosion of intermetallics》的作者。该著作聚焦于材料科学领域，专门探讨金属间化合物在高温环境下的氧化与腐蚀问题。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-0b443cc5c8498dc201a772ab50af4847" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0b443cc5c8498dc201a772ab50af4847-e-14&quot;, &quot;chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a-e-5&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0b443cc5c8498dc201a772ab50af4847-e-15" label="High temperature oxidation">
        <attvalues>
          <attvalue for="0" value="High temperature oxidation" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一部由M. P. Brady、B. A. Pint、P. F. Tortorelli、I. G. Wright及R. J. Hanrahan合著的出版物。根据上下文信息，其完整标题以“High temperature oxidation”为开头。该实体指代的是这部具体的学术著作，而非高温氧化这一科学概念。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-0b443cc5c8498dc201a772ab50af4847" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a-e-6" label="High temperature oxidation and corrosion of intermetallics">
        <attvalues>
          <attvalue for="0" value="High temperature oxidation and corrosion of intermetallics" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《金属间化合物的高温氧化与腐蚀》(High temperature oxidation and corrosion of intermetallics) 是由 P. Brady、B. A. Pint、P. F. Tortorelli 等五位学者合著的学术章节。该文被收录于著作《材料科学与技术：综合论述，第二卷：腐蚀与环境退化》中，系统阐述了金属间化合物材料在高温环境下的氧化和腐蚀机理与行为。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;229–325&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a-e-7" label="M. Schutze">
        <attvalues>
          <attvalue for="0" value="M. Schutze" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="M. Schutze，材料科学领域专家。他担任了大型学术专著《材料科学与技术：综合处理》第二卷《腐蚀与环境退化》的编辑。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a-e-8" label="Materials Science and Technology: A Comprehensive Treatment, Vol. II: Corrosion and Environmental Degradation">
        <attvalues>
          <attvalue for="0" value="Materials Science and Technology: A Comprehensive Treatment, Vol. II: Corrosion and Environmental Degradation" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《材料科学与技术》系列丛书的第二卷，是一部论述材料腐蚀与环境降解的学术专著。该卷由M. Schutze主编，Wiley-VCH Verlag于2000年出版发行。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2000&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a-e-9" label="Wiley-VCH Verlag">
        <attvalues>
          <attvalue for="0" value="Wiley-VCH Verlag" />
          <attvalue for="1" value="Publisher" />
          <attvalue for="2" value="Wiley-VCH Verlag是一家德国科技出版社，隶属于约翰威立（John Wiley &amp; Sons）国际出版公司。其出版物专注于化学、材料科学、物理学等领域的学术专著和期刊，在相关科学界享有盛誉。" />
          <attvalue for="3" value="{&quot;location&quot;: &quot;Weinham, Germany&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a-e-10" label="J. R. Martin">
        <attvalues>
          <attvalue for="0" value="J. R. Martin" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="J. R. Martin是一位研究人员，其撰写的科学出版物《The oxidation mechanism of θ-Al2O3 scales》探讨了关于θ-氧化铝（θ-Al2O3）氧化层的形成机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a-e-12" label="The oxidation mechanism of θ-Al2O3 scales">
        <attvalues>
          <attvalue for="0" value="The oxidation mechanism of θ-Al2O3 scales" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《The oxidation mechanism of θ-Al2O3 scales》是一篇由B. A. Pint、J. R. Martin与L. W. Hobbs合著的研究论文，于1995年发表在材料科学期刊《Solid State Ionics》上。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1995&quot;, &quot;pages&quot;: &quot;99–107&quot;}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a-e-12&quot;, &quot;chunk-dfe2f1887dc7e61661390cb2b77598da-e-2&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a-e-13" label="Solid State Ionics">
        <attvalues>
          <attvalue for="0" value="Solid State Ionics" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《Solid State Ionics》是由爱思唯尔（Elsevier）出版的国际同行评议科学期刊。它专注于固体离子学领域，发表关于固体材料中离子输运、扩散与电化学反应的原创研究，涵盖固态电池、燃料电池、传感器及腐蚀科学等应用。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;78&quot;}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a-e-13&quot;, &quot;chunk-dfe2f1887dc7e61661390cb2b77598da-e-3&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dfe2f1887dc7e61661390cb2b77598da-e-1" label="W. Hobbs">
        <attvalues>
          <attvalue for="0" value="W. Hobbs" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="W. Hobbs是一名学者，其研究领域涉及材料的氧化机理。他以作者身份发表了学术论文《θ-Al2O3氧化皮的氧化机理》(The oxidation mechanism of θ-Al2O3 scales)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-dfe2f1887dc7e61661390cb2b77598da" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dfe2f1887dc7e61661390cb2b77598da-e-1&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dfe2f1887dc7e61661390cb2b77598da-e-4" label="θ-Al2O3 scales">
        <attvalues>
          <attvalue for="0" value="θ-Al2O3 scales" />
          <attvalue for="1" value="Material Phenomenon" />
          <attvalue for="2" value="θ-Al2O3 scales（θ-氧化铝皮层）是在含铝合金等材料表面，因高温氧化而形成的一种亚稳态氧化铝层。它作为一种过渡相，其形成、生长及向稳定α相转变的机理，是材料高温防护领域的重要研究课题。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-dfe2f1887dc7e61661390cb2b77598da" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dfe2f1887dc7e61661390cb2b77598da-e-5" label="J. C. Yang">
        <attvalues>
          <attvalue for="0" value="J. C. Yang" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="J. C. Yang，学者。他是学术论文《Transient oxidation of NiAl》的合著者之一，该论文主要研究镍铝金属间化合物（NiAl）的瞬态氧化过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-dfe2f1887dc7e61661390cb2b77598da" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dfe2f1887dc7e61661390cb2b77598da-e-6" label="E. Schumann">
        <attvalues>
          <attvalue for="0" value="E. Schumann" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="E. Schumann是一位学者或研究人员。根据现有信息，他/她是关于NiAl瞬态氧化的学术论文《Transient oxidation of NiAl》的合著者之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-dfe2f1887dc7e61661390cb2b77598da" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dfe2f1887dc7e61661390cb2b77598da-e-7" label="I. Levin">
        <attvalues>
          <attvalue for="0" value="I. Levin" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="I. Levin是一位研究人员，作为合著者发表了科学论文《Transient oxidation of NiAl》。该论文专注于研究镍铝（NiAl）金属间化合物在氧化初期的瞬态行为，表明其研究领域为材料科学或相关工程学科。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-dfe2f1887dc7e61661390cb2b77598da" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dfe2f1887dc7e61661390cb2b77598da-e-8" label="M. Ruhle">
        <attvalues>
          <attvalue for="0" value="M. Ruhle" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="M. Ruhle，学者，学术论文《Transient oxidation of NiAl》的合著者之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-dfe2f1887dc7e61661390cb2b77598da" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dfe2f1887dc7e61661390cb2b77598da-e-9" label="Transient oxidation of NiAl">
        <attvalues>
          <attvalue for="0" value="Transient oxidation of NiAl" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Transient oxidation of NiAl》是一篇由J. C. Yang等人于1998年发表在《Acta Materialia》期刊上的学术论文。该论文主要研究并讨论了镍铝化合物（NiAl）的瞬态氧化过程。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1998&quot;, &quot;volume&quot;: &quot;46&quot;, &quot;pages&quot;: &quot;2195–2201&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-dfe2f1887dc7e61661390cb2b77598da" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-dfe2f1887dc7e61661390cb2b77598da-e-11" label="NiAl">
        <attvalues>
          <attvalue for="0" value="NiAl" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="铝化镍（NiAl）是一种由镍和铝组成的金属间化合物。它作为一种高温结构材料，以其高熔点、低密度和出色的高温抗氧化性而著称，其瞬时氧化行为是重要的研究特性之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-dfe2f1887dc7e61661390cb2b77598da" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dfe2f1887dc7e61661390cb2b77598da-e-12" label="G. C. Rybicki">
        <attvalues>
          <attvalue for="0" value="G. C. Rybicki" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="G. C. Rybicki是一位材料科学领域的研究者。他作为合著者发表了题为《θ-α Al2O3相变对β-NiAl+Zr氧化行为的影响》的科学论文，专注于金属合金的高温氧化机理研究。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-dfe2f1887dc7e61661390cb2b77598da" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dfe2f1887dc7e61661390cb2b77598da-e-12&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dfe2f1887dc7e61661390cb2b77598da-e-14" label="Effect of theta-alpha Al2O3 transformation on the oxidation behaviour of β-NiAl+Zr">
        <attvalues>
          <attvalue for="0" value="Effect of theta-alpha Al2O3 transformation on the oxidation behaviour of β-NiAl+Zr" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Effect of theta-alpha Al2O3 transformation on the oxidation behaviour of β-NiAl+Zr》是由G. C. Rybicki和J. L. Smialek合著的一篇科学论文，于1989年发表在《Oxidation of Metals》期刊上。该研究探讨了θ-α Al2O3（氧化铝）相变对添加了锆（Zr）的β-NiAl合金的氧化行为所产生的影响。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1989&quot;, &quot;volume&quot;: &quot;31&quot;, &quot;pages&quot;: &quot;275–304&quot;}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-dfe2f1887dc7e61661390cb2b77598da" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dfe2f1887dc7e61661390cb2b77598da-e-14&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-dfe2f1887dc7e61661390cb2b77598da-e-16" label="theta-alpha Al2O3 transformation">
        <attvalues>
          <attvalue for="0" value="theta-alpha Al2O3 transformation" />
          <attvalue for="1" value="Material Process" />
          <attvalue for="2" value="θ-α Al2O3相变是一种固态相变过程，指亚稳态的θ相氧化铝在高温下转变为热力学上更稳定的α相（刚玉）。该过程对于在β-NiAl等高温合金表面形成的氧化物保护层的性能和稳定性至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-dfe2f1887dc7e61661390cb2b77598da" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dfe2f1887dc7e61661390cb2b77598da-e-17" label="β-NiAl+Zr">
        <attvalues>
          <attvalue for="0" value="β-NiAl+Zr" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种掺杂了锆(Zr)的β相镍铝(NiAl)金属间化合物合金。锆的添加旨在通过影响其氧化过程中形成的氧化铝保护层的相变，来改善材料的高温抗氧化性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-17" />
          <attvalue for="5" value="chunk-dfe2f1887dc7e61661390cb2b77598da" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1abe15e2f2db1602f97ac75bb847ef30-e-1" label="β-NiAl+Zr">
        <attvalues>
          <attvalue for="0" value="β-NiAl+Zr" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="β-NiAl+Zr是一种以β相镍铝化物（β-NiAl）为基体，通过添加锆（Zr）元素进行改性的金属间合金。作为一种潜在的高温结构材料，研究通常集中于锆的加入对其力学性能及高温抗氧化行为的影响，相关研究成果见于《金属氧化》（Oxidation of Metals）等学术期刊。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-1abe15e2f2db1602f97ac75bb847ef30" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1abe15e2f2db1602f97ac75bb847ef30-e-4" label="M. Treska">
        <attvalues>
          <attvalue for="0" value="M. Treska" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="M. Treska是一名学者，曾作为作者发表了一项关于β-NiAl（β相镍铝化合物）的研究。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1abe15e2f2db1602f97ac75bb847ef30" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="341" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-1abe15e2f2db1602f97ac75bb847ef30-e-5" label="L. W. Hobbs">
        <attvalues>
          <attvalue for="0" value="L. W. Hobbs" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="林恩·W·霍布斯（Linn W. Hobbs），美国材料科学家，麻省理工学院（MIT）材料科学与工程荣休教授。他主要利用电子显微学研究材料的辐射损伤等物理特性，是β-NiAl（β相镍铝化合物）等金属间化合物研究领域的权威学者。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1abe15e2f2db1602f97ac75bb847ef30" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="342" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-1abe15e2f2db1602f97ac75bb847ef30-e-10" label="K. L. More">
        <attvalues>
          <attvalue for="0" value="K. L. More" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="K. L. More 是一位材料科学领域的学者和作者。他/她是学术出版物《The use of two reactive elements to optimise oxidation performance of alumina-forming alloys》的作者之一，该著作研究了如何利用活性元素来优化氧化铝形成合金的抗氧化性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-1abe15e2f2db1602f97ac75bb847ef30" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
