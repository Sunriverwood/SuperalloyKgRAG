          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6f4f79d57f35ab3e77324ff6707d70bf-e-13&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6f4f79d57f35ab3e77324ff6707d70bf-e-15" label="P. K. Wright">
        <attvalues>
          <attvalue for="0" value="P. K. Wright" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="P. K. Wright，全名保罗·肯尼思·赖特（Paul Kenneth Wright），美国学者，加州大学伯克利分校机械工程学教授。他是智能制造、增材制造（3D打印）、机器人技术以及人工智能在设计中应用等领域的公认专家及作者，在该领域发表了众多学术著作与论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-6f4f79d57f35ab3e77324ff6707d70bf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="353" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-8765b343b5bd5551f3f9be47330d68d2-e-3" label="Mechanisms governing the performance of thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="Mechanisms governing the performance of thermal barrier coatings" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Mechanisms governing the performance of thermal barrier coatings》是一篇由A. G. Evans与P. K. Wright合著的学术论文，于1999年发表于期刊《Current Opinion in Solid State and Materials Science》。该文主要探讨并综述了决定热障涂层性能的关键物理与化学机制。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1999&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-8765b343b5bd5551f3f9be47330d68d2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8765b343b5bd5551f3f9be47330d68d2-e-3&quot;]}]" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8765b343b5bd5551f3f9be47330d68d2-e-4" label="Current Opinion in Solid State and Materials Science">
        <attvalues>
          <attvalue for="0" value="Current Opinion in Solid State and Materials Science" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《Current Opinion in Solid State and Materials Science》是一本由爱思唯尔(Elsevier)出版的国际同行评审学术期刊。该刊专注于固态科学与材料科学领域，以发表权威性的专家综述和评论文章为特色，旨在评述该领域的最新研究进展和未来发展方向。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-8765b343b5bd5551f3f9be47330d68d2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8765b343b5bd5551f3f9be47330d68d2-e-6" label="I. T. Spitsberg">
        <attvalues>
          <attvalue for="0" value="I. T. Spitsberg" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="I. T. Spitsberg 是一位研究人员，其学术成果包括发表了关于材料科学的论文《热障涂层系统中热生长氧化物的循环位移不稳定性表征》。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-8765b343b5bd5551f3f9be47330d68d2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8765b343b5bd5551f3f9be47330d68d2-e-7" label="Characterisation of a cyclic displacement instability for a thermally grown oxide in a thermal barrier coating system">
        <attvalues>
          <attvalue for="0" value="Characterisation of a cyclic displacement instability for a thermally grown oxide in a thermal barrier coating system" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由D. R. Mumm、A. G. Evans与I. T. Spitsberg合著的学术论文，于2001年发表在期刊《Acta Materialia》上。该论文主要研究和表征了热障涂层系统中热生长氧化物（TGO）的循环位移不稳定性问题。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2001&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-8765b343b5bd5551f3f9be47330d68d2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8765b343b5bd5551f3f9be47330d68d2-e-7&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-8765b343b5bd5551f3f9be47330d68d2-e-11" label="Thermal barrier coating system">
        <attvalues>
          <attvalue for="0" value="Thermal barrier coating system" />
          <attvalue for="1" value="Technical Concept" />
          <attvalue for="2" value="热障涂层系统（Thermal Barrier Coating System）是一种应用于金属部件（尤其是高温合金）表面的先进多层材料系统。它通过低热导率的陶瓷面层提供隔热，保护基材免受高温损害。该系统通常包括金属粘结层，并在高温服役时，会在两者间形成一层关键的热生长氧化物（TGO）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-8765b343b5bd5551f3f9be47330d68d2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-65335c426f17131b3458c32075ac90d7-e-1" label="rown oxide in a thermal barrier coating system">
        <attvalues>
          <attvalue for="0" value="rown oxide in a thermal barrier coating system" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇发表于材料科学期刊《Acta Materialia》的研究论文。该论文主要研究热障涂层系统中的热生长氧化物（TGO），该氧化物层是影响涂层耐久性与性能的关键因素。" />
          <attvalue for="3" value="{&quot;journal&quot;: &quot;Acta Materialia&quot;, &quot;volume&quot;: &quot;49&quot;, &quot;year&quot;: &quot;2001&quot;, &quot;pages&quot;: &quot;2329–2340&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-65335c426f17131b3458c32075ac90d7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-65335c426f17131b3458c32075ac90d7-e-4" label="M. Menzebach">
        <attvalues>
          <attvalue for="0" value="M. Menzebach" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="M. Menzebach是一位学者，作为作者发表了题为《Influence of substrate material on oxidation behaviour and cyclic lifetime of EB-PVD TBC systems》的研究论文，该论文探讨了基底材料对EB-PVD热障涂层系统的氧化行为和循环寿命的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-65335c426f17131b3458c32075ac90d7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-65335c426f17131b3458c32075ac90d7-e-6" label="Y. Q. Yang">
        <attvalues>
          <attvalue for="0" value="Y. Q. Yang" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="Y. Q. Yang是一位学者，其以作者身份发表了关于热障涂层(TBC)系统在不同基体材料上的氧化行为及循环寿命影响的研究论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-65335c426f17131b3458c32075ac90d7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-65335c426f17131b3458c32075ac90d7-e-7" label="Influence of substrate material on oxidation behaviour and cyclic lifetime of EB-PVD TBC systems">
        <attvalues>
          <attvalue for="0" value="Influence of substrate material on oxidation behaviour and cyclic lifetime of EB-PVD TBC systems" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由U. Schulz等人合著的学术论文，发表于《Surface and Coatings Technology》期刊。该研究探讨了基底材料对采用电子束物理气相沉积（EB-PVD）技术制备的热障涂层（TBC）系统的氧化行为与循环寿命的影响。" />
          <attvalue for="3" value="{&quot;journal&quot;: &quot;Surface and Coatings Technology&quot;, &quot;volume&quot;: &quot;146–147&quot;, &quot;year&quot;: &quot;2001&quot;, &quot;pages&quot;: &quot;117–123&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-65335c426f17131b3458c32075ac90d7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-65335c426f17131b3458c32075ac90d7-e-7&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-65335c426f17131b3458c32075ac90d7-e-10" label="Influence of cyclic strain on life of a PVD TBC">
        <attvalues>
          <attvalue for="0" value="Influence of cyclic strain on life of a PVD TBC" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Influence of cyclic strain on life of a PVD TBC》是1998年发表于《Materials Science and Engineering》期刊的一篇学术论文。该文研究了循环应变对通过物理气相沉积（PVD）技术制备的热障涂层（TBC）使用寿命的影响。" />
          <attvalue for="3" value="{&quot;journal&quot;: &quot;Materials Science and Engineering&quot;, &quot;volume&quot;: &quot;A245&quot;, &quot;year&quot;: &quot;1998&quot;, &quot;pages&quot;: &quot;1&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-65335c426f17131b3458c32075ac90d7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-65335c426f17131b3458c32075ac90d7-e-10&quot;, &quot;chunk-0be0c36bfb88c04374e36b5059a1c5fc-e-1&quot;]}]" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0be0c36bfb88c04374e36b5059a1c5fc-e-4" label="The role of chemical composition on the oxidation performance of aluminide coatings">
        <attvalues>
          <attvalue for="0" value="The role of chemical composition on the oxidation performance of aluminide coatings" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="这是一篇由B. A. Pint撰写的科学论文，于2004年发表在学术期刊《Surface and Coatings Technology》上。该论文主要研究和探讨了不同的化学成分对铝化物涂层的抗氧化性能所产生的影响。" />
          <attvalue for="3" value="{&quot;journal&quot;: &quot;Surface and Coatings Technology&quot;, &quot;volume&quot;: &quot;188–189&quot;, &quot;year&quot;: &quot;2004&quot;, &quot;pages&quot;: &quot;71–78&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0be0c36bfb88c04374e36b5059a1c5fc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0be0c36bfb88c04374e36b5059a1c5fc-e-6" label="B. Baufeld">
        <attvalues>
          <attvalue for="0" value="B. Baufeld" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="B. Baufeld是一位作者与研究人员。其主要贡献是作为出版物《Ni-Co-Cr-Al-Y氧化保护层中作为事后温度指标的微观结构变化》的作者之一。该研究属于材料科学领域，探讨了特定镍基合金涂层的微观结构变化如何被用作温度历史的指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0be0c36bfb88c04374e36b5059a1c5fc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0be0c36bfb88c04374e36b5059a1c5fc-e-7" label="M. Bartsch">
        <attvalues>
          <attvalue for="0" value="M. Bartsch" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="M. Bartsch是一位作者，因合著出版物《Microstructural changes as postmortem temperature indicator in Ni-Co-Cr-Al-Y oxidation protect》而知名。该研究属于材料科学领域，主要探讨如何通过分析镍钴铬铝钇（Ni-Co-Cr-Al-Y）高温防护涂层的微观结构变化，来判断其在失效或事件后所经历的温度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-0be0c36bfb88c04374e36b5059a1c5fc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0be0c36bfb88c04374e36b5059a1c5fc-e-8" label="P. Broz">
        <attvalues>
          <attvalue for="0" value="P. Broz" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="P. Broz是一位作者，其研究领域为材料科学。他/她是学术出版物《Microstructural changes as postmortem temperature indicator in Ni-Co-Cr-Al-Y oxidation protect》的作者之一，该研究探讨了通过分析高温合金的微观结构变化来判断其事后温度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-0be0c36bfb88c04374e36b5059a1c5fc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0be0c36bfb88c04374e36b5059a1c5fc-e-9" label="M. Schmucker">
        <attvalues>
          <attvalue for="0" value="M. Schmucker" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="M. Schmucker是一位研究员，作为作者之一发表了学术论文《Ni-Co-Cr-Al-Y氧化保护层中作为事后温度指标的微观结构变化》。其研究领域涉及材料科学，特别是高温合金的微观结构分析。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-0be0c36bfb88c04374e36b5059a1c5fc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-69451a0856df90ef7a5f897ca8878dd2-e-1" label="cker">
        <attvalues>
          <attvalue for="0" value="cker" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="一位学者，其发表的学术论文研究了利用镍钴铬铝钇（Ni-Co-Cr-Al-Y）氧化防护涂层的微观结构变化作为事后温度指示剂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-69451a0856df90ef7a5f897ca8878dd2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-69451a0856df90ef7a5f897ca8878dd2-e-2" label="Microstructural changes as postmortem temperature indicator in Ni-Co-Cr-Al-Y oxidation protection coatings">
        <attvalues>
          <attvalue for="0" value="Microstructural changes as postmortem temperature indicator in Ni-Co-Cr-Al-Y oxidation protection coatings" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Microstructural changes as postmortem temperature indicator in Ni-Co-Cr-Al-Y oxidation protect》是一篇科学出版物，由B. Baufeld、M. Bartsch、P. Broz及M. Schmucker共同撰写，探讨了Ni-Co-Cr-Al-Y合金氧化保护层中的微观结构变化。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2004&quot;, &quot;volume&quot;: &quot;384&quot;, &quot;pages&quot;: &quot;162–171&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-69451a0856df90ef7a5f897ca8878dd2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Microstructural changes as postmortem temperature indicator in Ni-Co-Cr-Al-Y oxidation protect&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0be0c36bfb88c04374e36b5059a1c5fc-e-10&quot;, &quot;chunk-69451a0856df90ef7a5f897ca8878dd2-e-2&quot;]}]" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-69451a0856df90ef7a5f897ca8878dd2-e-4" label="Ni-Co-Cr-Al-Y oxidation protection coatings">
        <attvalues>
          <attvalue for="0" value="Ni-Co-Cr-Al-Y oxidation protection coatings" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="Ni-Co-Cr-Al-Y抗氧化涂层是一种以镍、钴、铬、铝、钇为主要成分的合金涂层，用于在高温环境下保护基底材料免受氧化。由于其微观结构会随工作温度发生特征性变化，该涂层可作为一种事后温度指示器，用于分析和评估部件所经历的热历史。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-69451a0856df90ef7a5f897ca8878dd2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-69451a0856df90ef7a5f897ca8878dd2-e-5" label="J. A. Nychka">
        <attvalues>
          <attvalue for="0" value="J. A. Nychka" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="J. A. Nychka是一位学者，作为学术论文《Damage quantification in TBCs by photo-stimulated luminescence spectroscopy》的合著者，该研究专注于利用光激励光谱法对热障涂层进行损伤量化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-69451a0856df90ef7a5f897ca8878dd2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-69451a0856df90ef7a5f897ca8878dd2-e-7" label="Damage quantification in TBCs by photo-stimulated luminescence spectroscopy">
        <attvalues>
          <attvalue for="0" value="Damage quantification in TBCs by photo-stimulated luminescence spectroscopy" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由J. A. Nychka和D. R. Clarke合著，于2001年发表在《Surface and Coatings Technology》的学术论文。该研究探讨了运用光激励发光光谱法（photo-stimulated luminescence spectroscopy），对热障涂层（TBCs）的损伤进行定量分析。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2001&quot;, &quot;volume&quot;: &quot;146–147&quot;, &quot;pages&quot;: &quot;110–116&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-69451a0856df90ef7a5f897ca8878dd2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-69451a0856df90ef7a5f897ca8878dd2-e-8" label="TBCs">
        <attvalues>
          <attvalue for="0" value="TBCs" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="热障涂层（Thermal Barrier Coatings, TBCs）是一种应用于金属基体表面的先进材料系统。它通过优异的隔热性能，保护基体免受高温损害，从而提升发动机等关键热端部件的服役性能和寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-69451a0856df90ef7a5f897ca8878dd2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-69451a0856df90ef7a5f897ca8878dd2-e-9" label="photo-stimulated luminescence spectroscopy">
        <attvalues>
          <attvalue for="0" value="photo-stimulated luminescence spectroscopy" />
          <attvalue for="1" value="Technique" />
          <attvalue for="2" value="光致发光光谱学是一种无损检测技术，通过光激发材料使其发光，并分析其光谱特征（如峰位移和强度）来评估材料状态。该技术主要用于非接触式地定量测量热障涂层（TBCs）等材料的内部应力、温度及损伤程度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-69451a0856df90ef7a5f897ca8878dd2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-22e09ee7f38295f048d1264e0df1823f-e-1" label="D. R. Mumm and A. G. Evans">
        <attvalues>
          <attvalue for="0" value="D. R. Mumm and A. G. Evans" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="D. R. Mumm与A. G. Evans是材料科学领域的研究者，他们合作撰写了关于热障涂层失效机理的重要论文《On the role of imperfections in the failure of a thermal barrier coating made by electron beam deposition》，该研究聚焦于电子束沉积涂层中的缺陷及其影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-22e09ee7f38295f048d1264e0df1823f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-22e09ee7f38295f048d1264e0df1823f-e-5" label="M. Gell, K. Vaidyanathan, B. Barber, J. Cheng and E. Jordan">
        <attvalues>
          <attvalue for="0" value="M. Gell, K. Vaidyanathan, B. Barber, J. Cheng and E. Jordan" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="一组研究人员。他们共同撰写了题为《Mechanism of spallation in platinum aluminide/electron beam physical vapor-deposited thermal barrier coatings》的科学论文，该论文阐述了特定热障涂层中的剥落失效机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-22e09ee7f38295f048d1264e0df1823f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-22e09ee7f38295f048d1264e0df1823f-e-5&quot;]}]" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-22e09ee7f38295f048d1264e0df1823f-e-6" label="Platinum aluminide/electron beam physical vapor-deposited thermal barrier coating">
        <attvalues>
          <attvalue for="0" value="Platinum aluminide/electron beam physical vapor-deposited thermal barrier coating" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种采用电子束物理气相沉积（EBPVD）工艺制备的先进热障涂层系统。该系统通常以铂铝化物作为抗高温氧化的结合层，其上沉积陶瓷隔热层，为航空发动机涡轮叶片等关键热端部件提供优异的隔热与防护性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-22e09ee7f38295f048d1264e0df1823f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;platinum aluminide/electron beam physical vapor-deposited thermal barrier coatings&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-22e09ee7f38295f048d1264e0df1823f-e-6&quot;]}]" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-22e09ee7f38295f048d1264e0df1823f-e-8" label="On the role of imperfections in the failure of a thermal barrier coating made by electron beam deposition">
        <attvalues>
          <attvalue for="0" value="On the role of imperfections in the failure of a thermal barrier coating made by electron beam deposition" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由D. R. Mumm和A. G. Evans合著的一篇材料科学领域学术论文，其完整标题为《On the role of imperfections in the failure of a thermal barrier coating...》。该论文主要研究了缺陷在热障涂层失效过程中的作用和机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-22e09ee7f38295f048d1264e0df1823f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;On the role of imperfections in the fail&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-69451a0856df90ef7a5f897ca8878dd2-e-13&quot;, &quot;chunk-22e09ee7f38295f048d1264e0df1823f-e-8&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-22e09ee7f38295f048d1264e0df1823f-e-9" label="Mechanism of spallation in platinum aluminide/electron beam physical vapor-deposited thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="Mechanism of spallation in platinum aluminide/electron beam physical vapor-deposited thermal barrier coatings" />
          <attvalue for="1" value="Academic Paper" />
          <attvalue for="2" value="这是一篇由M. Gell等人撰写的学术论文，发表于《冶金与材料汇刊》。该论文深入研究了采用电子束物理气相沉积法（EB-PVD）制备的铂铝化物热障涂层的剥落失效机理，为提升涂层性能提供了理论依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-22e09ee7f38295f048d1264e0df1823f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-22e09ee7f38295f048d1264e0df1823f-e-9&quot;]}]" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-59a3edbbbcb792361a0376e0da5d6d3f-e-1" label="A. Rabiei">
        <attvalues>
          <attvalue for="0" value="A. Rabiei" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="A. Rabiei是一位材料科学领域的研究人员，其研究专注于热障涂层技术。他是关于“等离子喷涂热障涂层中热生长氧化物失效机制”这一课题的论文作者。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-59a3edbbbcb792361a0376e0da5d6d3f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-59a3edbbbcb792361a0376e0da5d6d3f-e-3" label="Failure mechanisms associated with the thermally grown oxide in plasma-sprayed thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="Failure mechanisms associated with the thermally grown oxide in plasma-sprayed thermal barrier coatings" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="这是一篇由A. Rabiei和A. G. Evans撰写，于2000年发表在期刊《Acta Materialia》上的研究论文。该文主要研究了等离子喷涂热障涂层中，因热生长氧化物（TGO）层所引发的各种失效机制。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2000&quot;, &quot;volume&quot;: &quot;48&quot;, &quot;pages&quot;: &quot;3963-3976&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-59a3edbbbcb792361a0376e0da5d6d3f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-59a3edbbbcb792361a0376e0da5d6d3f-e-6" label="plasma-sprayed thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="plasma-sprayed thermal barrier coatings" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种采用等离子喷涂技术制备的热障涂层。它通过表面的陶瓷层为高温环境下的金属基底提供隔热保护。其性能和失效模式与界面处热生长氧化物（TGO）的形成和演化密切相关，是该领域的研究重点。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-59a3edbbbcb792361a0376e0da5d6d3f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-59a3edbbbcb792361a0376e0da5d6d3f-e-9" label="Mechanics-based scaling laws for the durability of thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="Mechanics-based scaling laws for the durability of thermal barrier coatings" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《基于力学的热障涂层耐久性标度律》(Mechanics-based scaling laws for the durability of thermal barrier coatings) 是一篇由A. G. Evans、M. Y. He及J. W. Hutchinson合著的科学论文，发表于《材料科学进展》期刊。该文重点研究热障涂层的耐久性，并建立了用于预测其使用寿命的力学标度律。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-59a3edbbbcb792361a0376e0da5d6d3f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-59a3edbbbcb792361a0376e0da5d6d3f-e-9&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-59a3edbbbcb792361a0376e0da5d6d3f-e-10" label="Progress in Materials Science">
        <attvalues>
          <attvalue for="0" value="Progress in Materials Science" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《Progress in Materials Science》是由爱思唯尔(Elsevier)出版的材料科学领域顶尖综述期刊。该刊物致力于发表权威、全面的评述文章，旨在对特定研究领域的最新进展进行批判性评估和总结，在国际材料学界享有盛誉。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-59a3edbbbcb792361a0376e0da5d6d3f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-59a3edbbbcb792361a0376e0da5d6d3f-e-10&quot;, &quot;chunk-6dac0a4c73567f8946fa9c50957af9ca-e-14&quot;, &quot;chunk-9e6a9c9670a733534cf4cbfaf5e54d18-e-9&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-ff572be856494622eb9d81badd3c18da-e-1" label="J. S. Wang">
        <attvalues>
          <attvalue for="0" value="J. S. Wang" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="J. S. Wang是一名作者，撰写了题为《Measurement and analysis of buckling and buckle propagation in compressed oxide layers on superalloy substrates》的出版物，该文研究了超合金基底上压缩氧化物层的屈曲行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-ff572be856494622eb9d81badd3c18da" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ff572be856494622eb9d81badd3c18da-e-1&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ff572be856494622eb9d81badd3c18da-e-3" label="Measurement and analysis of buckling and buckle propagation in compressed oxide layers on superalloy substrates">
        <attvalues>
          <attvalue for="0" value="Measurement and analysis of buckling and buckle propagation in compressed oxide layers on superalloy substrates" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由J. S. Wang和A. G. Evans撰写的学术论文，于1998年发表在《Acta Materialia》期刊上。该研究测量并分析了高温合金基底上压缩氧化物层的屈曲及扩展行为。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1998&quot;, &quot;reference_number&quot;: &quot;[130]&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-ff572be856494622eb9d81badd3c18da" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ff572be856494622eb9d81badd3c18da-e-3&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-ff572be856494622eb9d81badd3c18da-e-5" label="compressed oxide layers">
        <attvalues>
          <attvalue for="0" value="compressed oxide layers" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="一种在高温合金基底上形成的、处于压缩应力状态的氧化层。这种应力会导致其发生屈曲及扩展等失效模式，因此对该层的行为分析是研究基底材料高温性能与涂层寿命的重要课题。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ff572be856494622eb9d81badd3c18da" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ff572be856494622eb9d81badd3c18da-e-6" label="superalloy substrates">
        <attvalues>
          <attvalue for="0" value="superalloy substrates" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="由高温合金制成的基底材料，用作形成压缩氧化物层的载体。在高温工况下，该基底的物理和化学性能对于其表面氧化物层的生长、附着及稳定性至关重要，是研究热应力下薄膜失效机理的关键部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-ff572be856494622eb9d81badd3c18da" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ff572be856494622eb9d81badd3c18da-e-7" label="J. W. Hutchinson">
        <attvalues>
          <attvalue for="0" value="J. W. Hutchinson" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="J. W. Hutchinson是一位学者，他作为共同作者，与研究者A. G. Evans和M. Y. He合作发表了学术著作（如文献[131]）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ff572be856494622eb9d81badd3c18da" />
