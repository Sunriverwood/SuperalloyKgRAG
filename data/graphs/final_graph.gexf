        <attvalues>
          <attvalue for="11" value="ACCOMMODATES_NON-STOICHIOMETRY_VIA" />
          <attvalue for="12" value="The Ni3Al compound accommodates non-stoichiometry through the mechanism of anti-site defects." />
          <attvalue for="13" value="non-stoichiometry is always accommodated by anti-site defects" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-2fb89ce2ee9a1401de467999142656eb" />
          <attvalue for="16" value="0.01928696668614845" />
          <attvalue for="17" value="0.4115721800116891" />
        </attvalues>
      </edge>
      <edge source="chunk-1a5bdd6114d60338a6db59595a5e76c4-e-4" target="chunk-0baebe66ecf34ef5401ef67e8b23af1b-e-4" id="chunk-0baebe66ecf34ef5401ef67e8b23af1b-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_DEFECT" />
          <attvalue for="12" value="The Ni3Al compound contains constitutional vacancies at a very small density at 950 K." />
          <attvalue for="13" value="...the density of constitutional vacancies at 950 K is very small, at ~10⁻⁸ and ~10⁻¹⁰ for the Ni and Al lattices, respectively..." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-0baebe66ecf34ef5401ef67e8b23af1b" />
          <attvalue for="16" value="0.0058445353594389245" />
          <attvalue for="17" value="0.4035067212156634" />
        </attvalues>
      </edge>
      <edge source="chunk-1a5bdd6114d60338a6db59595a5e76c4-e-4" target="chunk-0baebe66ecf34ef5401ef67e8b23af1b-e-5" id="chunk-0baebe66ecf34ef5401ef67e8b23af1b-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CONTRASTS_WITH" />
          <attvalue for="12" value="The defect behavior of Ni3Al is in contrast to that of β-NiAl." />
          <attvalue for="13" value="Once again, this behaviour is in contrast to that of β-NiAl..." />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-0baebe66ecf34ef5401ef67e8b23af1b" />
          <attvalue for="16" value="0.036528345996493274" />
          <attvalue for="17" value="0.42191700759789597" />
        </attvalues>
      </edge>
      <edge source="chunk-1a5bdd6114d60338a6db59595a5e76c4-e-5" target="chunk-1a5bdd6114d60338a6db59595a5e76c4-e-4" id="chunk-1a5bdd6114d60338a6db59595a5e76c4-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="OCCURS_IN" />
          <attvalue for="12" value="Planar faults arise in Ni3Al." />
          <attvalue for="13" value="planar faults in Ni3Al arise only as a consequence of mechanical deformation" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-1a5bdd6114d60338a6db59595a5e76c4" />
          <attvalue for="16" value="0.007451782583284629" />
          <attvalue for="17" value="0.4044710695499708" />
        </attvalues>
      </edge>
      <edge source="chunk-99c942e2e9af3f5f017d599dea23d62d-e-1" target="chunk-1a5bdd6114d60338a6db59595a5e76c4-e-4" id="chunk-99c942e2e9af3f5f017d599dea23d62d-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="OCCURS_IN" />
          <attvalue for="12" value="Planar faults are a feature that arises within the material Ni3Al." />
          <attvalue for="13" value="planar faults in Ni3Al arise only as a consequence of mechanical deformation" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-99c942e2e9af3f5f017d599dea23d62d" />
          <attvalue for="16" value="0.007451782583284629" />
          <attvalue for="17" value="0.4044710695499708" />
        </attvalues>
      </edge>
      <edge source="chunk-99c942e2e9af3f5f017d599dea23d62d-e-6" target="chunk-99c942e2e9af3f5f017d599dea23d62d-e-7" id="chunk-99c942e2e9af3f5f017d599dea23d62d-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CREATES" />
          <attvalue for="12" value="Shearing a top layer by the vector a/2⟨101⟩ results in the formation of an APB on a {111} plane." />
          <attvalue for="13" value="If the top layer is sheared by a/2⟨101⟩, as shown in Figure 2.39(b), one has an APB on {111}" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-99c942e2e9af3f5f017d599dea23d62d" />
          <attvalue for="16" value="1.408014418067641e-05" />
          <attvalue for="17" value="0.40000844808650843" />
        </attvalues>
      </edge>
      <edge source="chunk-99c942e2e9af3f5f017d599dea23d62d-e-6" target="chunk-08620c5a2f94ef5584dba0230f92c28f-e-8" id="chunk-99c942e2e9af3f5f017d599dea23d62d-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="FORMS" />
          <attvalue for="12" value="The shear displacement causes changes in nearest-neighbour bonds, resulting in the formation of Al-Al bonds." />
          <attvalue for="13" value="for example, Al-Al bonds are formed." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-99c942e2e9af3f5f017d599dea23d62d" />
          <attvalue for="16" value="1.408014418067641e-05" />
          <attvalue for="17" value="0.40000844808650843" />
        </attvalues>
      </edge>
      <edge source="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-2" target="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-3" id="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_SHEARED_BY" />
          <attvalue for="12" value="The top layer of the crystal is sheared by the displacement vector a/3⟨211⟩." />
          <attvalue for="13" value="If one shears the top layer by a/3⟨211⟩, see Figure 2.39(c), the Al atoms in the top layer now lie directly above those in the bottom one." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6" />
          <attvalue for="16" value="0.5" />
          <attvalue for="17" value="0.7" />
        </attvalues>
      </edge>
      <edge source="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-4" target="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-5" id="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="ALIGNS_ABOVE" />
          <attvalue for="12" value="As a result of the shear, the Al atoms in the top layer are positioned directly above the Al atoms in the bottom layer." />
          <attvalue for="13" value="If one shears the top layer by a/3⟨211⟩, see Figure 2.39(c), the Al atoms in the top layer now lie directly above those in the bottom one." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6" />
          <attvalue for="16" value="0.5" />
          <attvalue for="17" value="0.7" />
        </attvalues>
      </edge>
      <edge source="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-6" target="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-7" id="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CHANGES_TO" />
          <attvalue for="12" value="The shear operation causes the crystal's stacking sequence to change from ABCABCABCABC... to ABCACABCABC..." />
          <attvalue for="13" value="The stacking sequence changes from ABCABCABCABC. . . to ABCACABCABC. . ." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6" />
          <attvalue for="16" value="0.00046464475796232155" />
          <attvalue for="17" value="0.4002787868547774" />
        </attvalues>
      </edge>
      <edge source="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-7" target="chunk-be2e5714ffd15b4d499890769149ecb3-e-14" id="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DEFINES" />
          <attvalue for="12" value="The altered stacking sequence ABCACABCABC... is defined as a superlattice intrinsic stacking fault (SISF)." />
          <attvalue for="13" value="The stacking sequence changes from ABCABCABCABC. . . to ABCACABCABC. . ., which is equivalent to a single {111} being removed; hence, by analogy with the intrinsic stacking fault in γ, this is referred to as a superlattice intrinsic stacking fault (SISF)." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6" />
          <attvalue for="16" value="0.0009011292275632902" />
          <attvalue for="17" value="0.400540677536538" />
        </attvalues>
      </edge>
      <edge source="chunk-dc5958ae6c6275575fd05993164bcb7f-e-4" target="chunk-995a2b9cc489b030d64e320f8fc16f28-e-1" id="chunk-13624c30d54236964523cb607119931d-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_VECTOR_OF" />
          <attvalue for="12" value="The vector a/6⟨112⟩ is identified as the stacking fault vector for the FCC structure." />
          <attvalue for="13" value="fted by a/6⟨112⟩ – the stacking fault vector of the FCC structure as shown in Figure 2.39(d)" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-13624c30d54236964523cb607119931d" />
          <attvalue for="16" value="2.816028836135282e-05" />
          <attvalue for="17" value="0.40001689617301683" />
        </attvalues>
      </edge>
      <edge source="chunk-dc5958ae6c6275575fd05993164bcb7f-e-4" target="chunk-9108d08e6e7d916cfb35fde79b233c67-e-8" id="chunk-13624c30d54236964523cb607119931d-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CAUSES" />
          <attvalue for="12" value="The shift by the vector a/6⟨112⟩ causes the Al atoms to lie above Ni atoms, which results in the formation of a Complex Stacking Fault." />
          <attvalue for="13" value="so that the Al atoms in the top layer lie above directly above the Ni atoms in the bottom layer; the so-called complex stacking fault (CSF) then arises" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-13624c30d54236964523cb607119931d" />
          <attvalue for="16" value="0.0004083241812396159" />
          <attvalue for="17" value="0.4002449945087438" />
        </attvalues>
      </edge>
      <edge source="chunk-13624c30d54236964523cb607119931d-e-3" target="chunk-66ba88a6026c55d38eeb24aad6777073-e-9" id="chunk-13624c30d54236964523cb607119931d-r-3" weight="4.0">
        <attvalues>
          <attvalue for="11" value="POSITIONED_ABOVE" />
          <attvalue for="12" value="The formation of the CSF involves the Al atoms in the top layer being positioned directly above the Ni atoms in the bottom layer." />
          <attvalue for="13" value="the Al atoms in the top layer lie above directly above the Ni atoms in the bottom layer" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-13624c30d54236964523cb607119931d" />
          <attvalue for="16" value="1.408014418067641e-05" />
          <attvalue for="17" value="0.26667511475317507" />
        </attvalues>
      </edge>
      <edge source="chunk-13624c30d54236964523cb607119931d-e-6" target="chunk-1a5bdd6114d60338a6db59595a5e76c4-e-4" id="chunk-13624c30d54236964523cb607119931d-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_ESTIMATED_VALUE_IN" />
          <attvalue for="12" value="The CSF energy is estimated to be approximately 250 mJ/m² for the compound binary Ni3Al." />
          <attvalue for="13" value="for binary Ni3Al it has been estimated [37] to be ~250 mJ/m²" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-13624c30d54236964523cb607119931d" />
          <attvalue for="16" value="0.004675628287551139" />
          <attvalue for="17" value="0.4028053769725307" />
        </attvalues>
      </edge>
      <edge source="chunk-13624c30d54236964523cb607119931d-e-6" target="chunk-13624c30d54236964523cb607119931d-e-8" id="chunk-13624c30d54236964523cb607119931d-r-7" weight="4.0">
        <attvalues>
          <attvalue for="11" value="VARIES_WITH" />
          <attvalue for="12" value="The CSF energy varies across the range of stoichiometry of the compound." />
          <attvalue for="13" value="varying by perhaps 50 mJ/m² across the range of stoichiometry exhibited by the compound." />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-13624c30d54236964523cb607119931d" />
          <attvalue for="16" value="0.0002922267679719462" />
          <attvalue for="17" value="0.26684200272744985" />
        </attvalues>
      </edge>
      <edge source="chunk-e69ec61e4ba33a69deaed5cb75487264-e-2" target="chunk-be2e5714ffd15b4d499890769149ecb3-e-13" id="chunk-e69ec61e4ba33a69deaed5cb75487264-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="PRODUCES" />
          <attvalue for="12" value="The superlattice extrinsic stacking fault (SESF) is produced by a displacement of a/3⟨211⟩." />
          <attvalue for="13" value="Finally, the superlattice extrinsic stacking fault (SESF) – not shown in Figure 2.39 – is produced by displacing the top layer by a/3⟨211⟩." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-e69ec61e4ba33a69deaed5cb75487264" />
          <attvalue for="16" value="0.0004224043254202923" />
          <attvalue for="17" value="0.4002534425952522" />
        </attvalues>
      </edge>
      <edge source="chunk-003c7763c31b55c8a5748939ac729c6a-e-5" target="chunk-b90feda161b295cfb50134cb85d41526-e-10" id="chunk-003c7763c31b55c8a5748939ac729c6a-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="OCCURS_IN" />
          <attvalue for="12" value="Specific dislocations are described as being within the γ' phase." />
          <attvalue for="13" value="Dislocations in the L12 structure of the γ' phase dissociate into partial dislocations..." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-003c7763c31b55c8a5748939ac729c6a" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-003c7763c31b55c8a5748939ac729c6a-e-5" target="chunk-003c7763c31b55c8a5748939ac729c6a-e-6" id="chunk-003c7763c31b55c8a5748939ac729c6a-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DISSOCIATE_INTO" />
          <attvalue for="12" value="Dislocations within the γ' phase break down into partial dislocations." />
          <attvalue for="13" value="Dislocations in the L12 structure of the γ' phase dissociate into partial dislocations, just as for a a/2⟨110⟩{111} dislocation in γ." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-003c7763c31b55c8a5748939ac729c6a" />
          <attvalue for="16" value="0.00013061650992685477" />
          <attvalue for="17" value="0.40007836990595613" />
        </attvalues>
      </edge>
      <edge source="chunk-003c7763c31b55c8a5748939ac729c6a-e-5" target="chunk-003c7763c31b55c8a5748939ac729c6a-e-9" id="chunk-003c7763c31b55c8a5748939ac729c6a-r-6" weight="4.0">
        <attvalues>
          <attvalue for="11" value="HAS_PROPERTY" />
          <attvalue for="12" value="Dislocations in the γ' phase are characterized by their Burgers vectors." />
          <attvalue for="13" value="However, the Burgers vectors of dislocations in γ' are expected to be longer than in γ as a consequence of the ordering reaction" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-003c7763c31b55c8a5748939ac729c6a" />
          <attvalue for="16" value="0.00026123301985370953" />
          <attvalue for="17" value="0.2668234064785789" />
        </attvalues>
      </edge>
      <edge source="chunk-003c7763c31b55c8a5748939ac729c6a-e-9" target="chunk-003c7763c31b55c8a5748939ac729c6a-e-10" id="chunk-003c7763c31b55c8a5748939ac729c6a-r-7" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_LONGER_THAN" />
          <attvalue for="12" value="The Burgers vectors of dislocations in the γ' phase are expected to be longer than those in the γ phase." />
          <attvalue for="13" value="However, the Burgers vectors of dislocations in γ' are expected to be longer than in γ..." />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-003c7763c31b55c8a5748939ac729c6a" />
          <attvalue for="16" value="0.0003918495297805643" />
          <attvalue for="17" value="0.40023510971786835" />
        </attvalues>
      </edge>
      <edge source="chunk-003c7763c31b55c8a5748939ac729c6a-e-11" target="chunk-003c7763c31b55c8a5748939ac729c6a-e-9" id="chunk-003c7763c31b55c8a5748939ac729c6a-r-8" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CAUSES_ELONGATION_OF" />
          <attvalue for="12" value="The ordering reaction is the reason why the Burgers vectors of dislocations in γ' are longer." />
          <attvalue for="13" value="However, the Burgers vectors of dislocations in γ' are expected to be longer than in γ as a consequence of the ordering reaction" />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-003c7763c31b55c8a5748939ac729c6a" />
          <attvalue for="16" value="0.00026123301985370953" />
          <attvalue for="17" value="0.40015673981191224" />
