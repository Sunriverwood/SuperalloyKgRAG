      <node id="chunk-fd08a4d01f900e8f06f5ce2b9d625965-e-10" label="γAPB/b">
        <attvalues>
          <attvalue for="0" value="γAPB/b" />
          <attvalue for="1" value="Expression" />
          <attvalue for="2" value="`γAPB/b` 是一个表示切削应力（cutting stress）初步估算值的表达式。它是一个关键参数，其具体数值或应用会受到 `[(6γAPBfr/(πT))¹/² − f]` 这一公式的修正或影响，共同用于评估材料加工时的应力状态。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-fd08a4d01f900e8f06f5ce2b9d625965" />
