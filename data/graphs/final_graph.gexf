          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5d1954b761cf7718ff2558f9e10a2fac-e-4&quot;, &quot;chunk-b64074205c19193a279aa9e212f94d40-e-2&quot;, &quot;chunk-c6e7b6a8ae77f73405b4c1cca62aa7e4-e-6&quot;, &quot;chunk-bdbf4600f0f46ee6111ce0bae60fe800-e-12&quot;, &quot;chunk-c5385f7f28e0875405c91c30084a5d9b-e-8&quot;, &quot;chunk-0bff8302b00567f9758ab71ce974ace7-e-14&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="2" />
