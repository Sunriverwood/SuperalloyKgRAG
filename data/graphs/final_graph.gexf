      <node id="chunk-a584f7fe38f352b7318e0169178d3d01-e-1" label="Structural materials for aerospace systems">
        <attvalues>
          <attvalue for="0" value="Structural materials for aerospace systems" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Structural materials for aerospace systems》是发表于材料科学领域权威期刊《Acta Materialia》的一篇学术文章，其内容聚焦于航空航天系统中所使用的结构材料的研究、性能与应用。" />
