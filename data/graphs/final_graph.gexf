        <attvalues>
          <attvalue for="11" value="REDUCES_SUSCEPTIBILITY_TO" />
          <attvalue for="12" value="Research has shown that Ruthenium (Ru) reduces the susceptibility to TCP formation." />
          <attvalue for="13" value="Recent research has demonstrated that Ru reduces the susceptibility to TCP formation" />
