        <attvalues>
          <attvalue for="11" value="CAUSED_BY" />
          <attvalue for="12" value="Buckling is expected when the applied stress (σο) is in excess of the critical buckling stress (σc)." />
          <attvalue for="13" value="Note that when σο is in excess of σc, buckling is expected." />
