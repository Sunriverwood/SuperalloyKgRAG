        </attvalues>
      </node>
      <node id="chunk-4897104ddb336b2f8f129d218c5a2cc4-e-12" label="desulfurised Ni-base superalloy">
        <attvalues>
          <attvalue for="0" value="desulfurised Ni-base superalloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种经过脱硫处理的镍基高温合金。通过去除有害的硫杂质，该材料作为(Ni,Pt)Al等高温防护涂层的基体时，具有更强的涂层附着力和更优异的高温性能稳定性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-4897104ddb336b2f8f129d218c5a2cc4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
