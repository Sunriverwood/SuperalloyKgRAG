          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2863217e233dc47e4fc60478978f8746-e-3" label="Initial Pinning Points (X, Y, Z)">
        <attvalues>
          <attvalue for="0" value="Initial Pinning Points (X, Y, Z)" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="指前沿位错(leading dislocation)在运动前被初始固定住的一组三维空间坐标点(X, Y, Z)。这些点是阻碍位错运动的初始障碍或锚定位置，位错必须从中挣脱(break away)才能开始移动。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-2863217e233dc47e4fc60478978f8746" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2863217e233dc47e4fc60478978f8746-e-4" label="New Pinning Point (Y')">
        <attvalues>
          <attvalue for="0" value="New Pinning Point (Y')" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="新钉扎点（Y'）指前导位错从其原始钉扎点（Y）挣脱后，再次被钉扎（固定）时所在的新位置。该点是位错运动过程中的一个临时障碍，标志着位错在材料中移动的一个新阶段。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-2863217e233dc47e4fc60478978f8746" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2863217e233dc47e4fc60478978f8746-e-6" label="Slip plane">
        <attvalues>
          <attvalue for="0" value="Slip plane" />
          <attvalue for="1" value="Crystallographic Plane" />
          <attvalue for="2" value="在晶体学中，滑移面（Slip plane）是指位错（dislocation）进行滑移运动并引起材料塑性变形的特定晶体学平面。它通常是原子密排度最高的晶面，因为在此平面上移动原子所需的能量最低。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-2863217e233dc47e4fc60478978f8746" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2863217e233dc47e4fc60478978f8746-e-6&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2863217e233dc47e4fc60478978f8746-e-7" label="Area A">
        <attvalues>
          <attvalue for="0" value="Area A" />
          <attvalue for="1" value="Geometric Property" />
          <attvalue for="2" value="一种几何属性，指领先位错（Leading dislocation）在其滑移面（Slip plane）上运动时所扫过的区域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-2863217e233dc47e4fc60478978f8746" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
