      <node id="chunk-e09ab40c542042f5c2612bfc3901180e-e-2" label="nickel-base superalloys">
        <attvalues>
          <attvalue for="0" value="nickel-base superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍基高温合金是一种以镍为基体的高性能金属材料。它在600℃以上的高温下仍能保持优异的机械强度、抗蠕变和抗氧化腐蚀性能，主要用于制造航空发动机、燃气轮机等设备在严苛环境下工作的热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-e09ab40c542042f5c2612bfc3901180e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e09ab40c542042f5c2612bfc3901180e-e-5" label="Thermal Spray Technology">
        <attvalues>
          <attvalue for="0" value="Thermal Spray Technology" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="热喷涂技术是一类表面工程技术。它利用热源将涂层材料（如粉末或丝材）加热至熔融或半熔融状态，再通过高速气流喷射并沉积到工件表面，以形成具有耐磨、防腐、隔热等特定功能的保护性涂层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e09ab40c542042f5c2612bfc3901180e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="64" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e09ab40c542042f5c2612bfc3901180e-e-6" label="The ASM Thermal Spray Society">
        <attvalues>
          <attvalue for="0" value="The ASM Thermal Spray Society" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="ASM热喷涂学会 (TSS) 是隶属于ASM国际的专业技术学会，致力于服务全球热喷涂社群，通过会议、教育和出版物等方式促进该领域科学技术的发展与应用。该学会是行业权威著作《热喷涂技术手册》的出版机构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e09ab40c542042f5c2612bfc3901180e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e09ab40c542042f5c2612bfc3901180e-e-6&quot;, &quot;chunk-28027332c1e907d2b9fb62cbdc68fd6c-e-2&quot;]}]" />
          <attvalue for="9" value="64" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-28027332c1e907d2b9fb62cbdc68fd6c-e-1" label="Handbook of Thermal Spray Technology">
        <attvalues>
          <attvalue for="0" value="Handbook of Thermal Spray Technology" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《热喷涂技术手册》是由ASM热喷涂学会于2004年出版的权威专业手册。该书全面系统地阐述了热喷涂技术的原理、工艺、材料与应用，是该领域从业者与研究人员的重要参考资料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-28027332c1e907d2b9fb62cbdc68fd6c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="64" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-28027332c1e907d2b9fb62cbdc68fd6c-e-3" label="Materials Park, OH">
        <attvalues>
          <attvalue for="0" value="Materials Park, OH" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="Materials Park位于美国俄亥俄州，是国际材料信息学会（ASM International）的全球总部所在地。作为一个权威的材料科学与工程专业组织，该学会在此出版了包括《热喷涂技术手册》在内的众多专业技术文献。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-28027332c1e907d2b9fb62cbdc68fd6c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="64" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-28027332c1e907d2b9fb62cbdc68fd6c-e-4" label="2004">
        <attvalues>
          <attvalue for="0" value="2004" />
          <attvalue for="1" value="Date" />
          <attvalue for="2" value="2004年是《热喷涂技术手册》（Handbook of Thermal Spray Technology）的出版年份。这一日期标识了该权威技术手册首次向公众发布的时间。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-28027332c1e907d2b9fb62cbdc68fd6c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="64" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-28027332c1e907d2b9fb62cbdc68fd6c-e-5" label="D. H. Boone">
        <attvalues>
          <attvalue for="0" value="D. H. Boone" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. H. Boone是一位研究人员，其关于燃气轮机电子束气相沉积涂层应用的论文，曾发表在《真空科学与技术杂志》(Journal of Vacuum Science and Technology)上。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-28027332c1e907d2b9fb62cbdc68fd6c" />
