        <attvalues>
          <attvalue for="11" value="DEPENDS_ON" />
          <attvalue for="12" value="TBC life is dependent on the substrate material used in the combination." />
          <attvalue for="13" value="It has also become clear that TBC life is very dependent upon the combination of materials (substrate, bond coat, ceramic)" />
