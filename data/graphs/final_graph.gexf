      <node id="chunk-326ba48df9469bbb4fb6ddd6a5c15eb8-e-2" label="Coating">
        <attvalues>
          <attvalue for="0" value="Coating" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种先进材料，应用于最新一代大型工业燃气轮机（IGT）的热端部件。其主要作用是在高温、高压等严苛环境下提供热障、抗氧化和腐蚀的保护，以延长核心部件的使用寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-326ba48df9469bbb4fb6ddd6a5c15eb8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Coatings&quot;, &quot;coating&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-556d820ddbae9c9c730e555ef87312a3-e-5&quot;, &quot;chunk-326ba48df9469bbb4fb6ddd6a5c15eb8-e-2&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-326ba48df9469bbb4fb6ddd6a5c15eb8-e-3" label="superalloy system">
        <attvalues>
          <attvalue for="0" value="superalloy system" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="一种基于高温合金的材料体系。该类合金能在极端温度和机械应力下保持优异的强度、表面稳定性和抗腐蚀能力。作为一项关键使能技术，该体系为先进陆基燃气轮机等设备的核心高温部件提供材料基础，保障其可靠运行。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-326ba48df9469bbb4fb6ddd6a5c15eb8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-326ba48df9469bbb4fb6ddd6a5c15eb8-e-4" label="advanced land-based combustion turbine">
        <attvalues>
          <attvalue for="0" value="advanced land-based combustion turbine" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="一种先进的陆基燃气轮机技术。其发展依赖于特种涂层和高温合金系统等关键材料，这些材料使其能在更高温度下运行，从而显著提升发电效率和性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-326ba48df9469bbb4fb6ddd6a5c15eb8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-326ba48df9469bbb4fb6ddd6a5c15eb8-e-5" label="Gas Turbine Materials Technology">
        <attvalues>
          <attvalue for="0" value="Gas Turbine Materials Technology" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《燃气轮机材料技术》(Gas Turbine Materials Technology)是一本由ASM国际(ASM International)出版的专业技术出版物。该书由P. J. Maziasz、I. G. Wright、W. J. Brindley和C. O'Brien共同编辑，内容聚焦于燃气轮机所用材料及其相关技术，J. Stringer是该书的贡献者之一。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1999&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-326ba48df9469bbb4fb6ddd6a5c15eb8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="39" />
