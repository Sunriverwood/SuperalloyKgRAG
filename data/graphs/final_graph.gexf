        <attvalues>
          <attvalue for="11" value="INVALIDATES" />
          <attvalue for="12" value="A large volume fraction, f, of γ' causes the point obstacle approximation to become invalid." />
          <attvalue for="13" value="First, the point obstacle approximation is no longer valid, since the volume fraction, f, of γ' is then large." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-af1f9e9d18ac9effde532d2b56262cf6" />
          <attvalue for="16" value="2.816028836135282e-05" />
