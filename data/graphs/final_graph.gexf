      <node id="chunk-f5c07b55f3d29bb402b546962b69a445-e-1" label="SRR99">
        <attvalues>
          <attvalue for="0" value="SRR99" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="SRR99是一种合金的技术牌号。它是一种材料，其确切的化学成分、物理性能和技术规格，均通过特定的技术索引及关联的参考编号进行标准化定义和查询，常用于需要精确材料规范的工业或科研领域。" />
          <attvalue for="3" value="{&quot;generation&quot;: &quot;first-generation&quot;, &quot;category&quot;: &quot;single-crystal superalloy&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-f5c07b55f3d29bb402b546962b69a445" />
