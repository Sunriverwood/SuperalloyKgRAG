      </node>
      <node id="chunk-d246d51e161275b250bc309214ccd241-e-6" label="Beyond the sulphur effect">
        <attvalues>
          <attvalue for="0" value="Beyond the sulphur effect" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Beyond the sulphur effect》是由学者 P. Y. Hou 撰写的一篇学术文献，该文发表于材料腐蚀与防护领域的专业期刊《金属氧化》（Oxidation of Metals）。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1999&quot;}" />
          <attvalue for="4" value="e-6" />
