        <attvalues>
          <attvalue for="11" value="PRODUCES" />
          <attvalue for="12" value="Directed vapour deposition is the process used to create the 7YSZ coatings mentioned." />
          <attvalue for="13" value="conductivities of the 7YSZ coatings produced in this way were shown to be equivalent to those produced by APS processing [60]." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-e01b059cc1c9a00298a478f93a9ec05a" />
          <attvalue for="16" value="0.1" />
          <attvalue for="17" value="0.46" />
        </attvalues>
      </edge>
      <edge source="chunk-e01b059cc1c9a00298a478f93a9ec05a-e-5" target="chunk-e01b059cc1c9a00298a478f93a9ec05a-e-6" id="chunk-e01b059cc1c9a00298a478f93a9ec05a-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_EQUIVALENT_CONDUCTIVITY" />
          <attvalue for="12" value="The conductivity of 7YSZ coatings from directed vapour deposition is equivalent to coatings from APS processing." />
          <attvalue for="13" value="conductivities of the 7YSZ coatings produced in this way were shown to be equivalent to those produced by APS processing [60]." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-e01b059cc1c9a00298a478f93a9ec05a" />
          <attvalue for="16" value="0.1" />
          <attvalue for="17" value="0.46" />
        </attvalues>
      </edge>
