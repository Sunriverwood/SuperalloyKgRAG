        <attvalues>
          <attvalue for="11" value="YIELDS" />
          <attvalue for="12" value="Equations (2.23a) and (2.23b) can be manipulated to yield Equation (2.30a)." />
          <attvalue for="13" value="In these circumstances, Equations (2.23a) and (2.23b) can be manipulated to yield [49] 2τbL + (F₁ + F₂) = 0 (2.30a)" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-02948169a54de26c861e1fa5741b30de" />
          <attvalue for="16" value="0.5" />
          <attvalue for="17" value="0.7" />
        </attvalues>
      </edge>
      <edge source="chunk-171c1deb2bffaad5a637104b101eb41f-e-1" target="chunk-171c1deb2bffaad5a637104b101eb41f-e-2" id="chunk-171c1deb2bffaad5a637104b101eb41f-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_CALCULATED_FROM" />
          <attvalue for="12" value="The shear stress τ is calculated using the force F₁ in the expression τ = −½(F₁ + F₂)/(bL)." />
