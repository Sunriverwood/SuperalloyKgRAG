      <edge source="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-3" target="chunk-9e8ea14457e39729a875ffa2ee3efdb0-e-3" id="chunk-ee2c916092b69050b73e7898f576b082-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="MAKES_UNIFORM" />
          <attvalue for="12" value="Quenching in oil makes the heat transfer coefficient uniform around the part." />
          <attvalue for="13" value="Traditionally, turbine discs have been quenched in oil so that the heat transfer coefficient around the periphery of the part is then uniform" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-ee2c916092b69050b73e7898f576b082" />
          <attvalue for="16" value="0.00034806822137138876" />
          <attvalue for="17" value="0.40020884093282283" />
        </attvalues>
      </edge>
      <edge source="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-6" target="chunk-a4b011eeea4fbc315a0833a25a29121a-e-6" id="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="PROVIDES" />
          <attvalue for="12" value="Sufficient quantities of strengthening phases give the necessary high-temperature properties." />
          <attvalue for="13" value="A heat treatment is then applied to encourage the appropriate strengthening phases (for example, y') to precipitate in sufficient quantities to give the necessary high-temperature properties." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad" />
          <attvalue for="16" value="0.00011788977306218684" />
          <attvalue for="17" value="0.40007073386383735" />
        </attvalues>
      </edge>
      <edge source="chunk-93160044ac8bb07b73d5b072ebae265b-e-5" target="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-2" id="chunk-93160044ac8bb07b73d5b072ebae265b-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="FOLLOWS" />
