      <edge source="chunk-ee8fa246fa35655243004b46a963f27f-e-3" target="chunk-ee8fa246fa35655243004b46a963f27f-e-2" id="chunk-ee8fa246fa35655243004b46a963f27f-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DETERMINES_COMPATIBILITY_OF" />
          <attvalue for="12" value="Chemical effects determine the compatibility of superalloys with thermal barrier coating systems, but an adequate explanation for this is lacking." />
          <attvalue for="13" value="Furthermore, an adequate explanation has yet to be offered for the chemical effects which determine compatibility of the superalloys with thermal barrier coating systems." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-ee8fa246fa35655243004b46a963f27f" />
