        <attvalues>
          <attvalue for="11" value="IS_A" />
          <attvalue for="12" value="The spacing interval λ₂ is an instance of a 'Friedel spacing'." />
          <attvalue for="13" value="...and each is known as a ‘Friedel spacing’." />
          <attvalue for="14" value="r-10" />
          <attvalue for="15" value="chunk-0fc62816353bfe4473c22a2bef9a696b" />
          <attvalue for="16" value="2.816028836135282e-05" />
