      <node id="chunk-c026408b0eb125d3c56d1ed05d0a0f15-e-8" label="f">
        <attvalues>
          <attvalue for="0" value="f" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="颗粒的体积分数（f），定义为材料体系中所有颗粒的总体积与体系总体积之比。它是一个表征颗粒浓度的无量纲物理量，并直接影响材料的宏观力学性能，如临界剪切应力（τc）。" />
          <attvalue for="3" value="{}" />
