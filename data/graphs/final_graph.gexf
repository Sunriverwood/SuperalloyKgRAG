        <attvalues>
          <attvalue for="11" value="OUTPACES_CAPABILITY_OF" />
          <attvalue for="12" value="The turbine entry temperature (TET) is outpacing the temperature capability of single-crystal superalloys." />
          <attvalue for="13" value="the turbine entry temperature (TET) of the modern aeroengine is outpacing the temperature capability of the single-crystal superalloys" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-e7b8406b8d85a1255a692ddd5452a482" />
