      <node id="chunk-f7802da45487754a86d28619b81d1a73-e-4" label="Safe Working Conditions">
        <attvalues>
          <attvalue for="0" value="Safe Working Conditions" />
          <attvalue for="1" value="Requirement" />
          <attvalue for="2" value="安全工作条件是一项关键要求，适用于高温合金部件及燃气轮机。它是在部件设计、制造及寿命估算等全生命周期阶段都必须满足的先决条件，旨在确保设备在规定条件下能够完整、安全、可靠地运行。" />
