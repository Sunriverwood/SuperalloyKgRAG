      <edge source="chunk-7468b5a535de86347797d4977b885a9e-e-8" target="chunk-488553ca8f86a8be784d625006ec53f4-e-4" id="chunk-488553ca8f86a8be784d625006ec53f4-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DEFINED_BY" />
          <attvalue for="12" value="The value of the transformed compliance constant S'44 is calculated using Equation A7." />
          <attvalue for="13" value="S'44 = S44 + (2S11 - 2S12 - S44) × 4 sin²θ cos²θ = S44 + (2S11 - 2S12 - S44) × sin²2θ/2 (A7)" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-488553ca8f86a8be784d625006ec53f4" />
          <attvalue for="16" value="0.0006184291898577612" />
          <attvalue for="17" value="0.40037105751391466" />
        </attvalues>
      </edge>
      <edge source="chunk-488553ca8f86a8be784d625006ec53f4-e-3" target="chunk-488553ca8f86a8be784d625006ec53f4-e-4" id="chunk-488553ca8f86a8be784d625006ec53f4-r-6" weight="4.0">
        <attvalues>
          <attvalue for="11" value="IS_INPUT_TO" />
          <attvalue for="12" value="The angle θ is a variable in Equation A7." />
          <attvalue for="13" value="S'44 = S44 + (2S11 - 2S12 - S44) × 4 sin²θ cos²θ = S44 + (2S11 - 2S12 - S44) × sin²2θ/2 (A7)" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-488553ca8f86a8be784d625006ec53f4" />
          <attvalue for="16" value="0.00010307153164296021" />
