        <attvalues>
          <attvalue for="11" value="CAUSES" />
          <attvalue for="12" value="Interdiffusional fluxes can lead to the formation of Kirkendall voiding." />
          <attvalue for="13" value="Due to these interdiffusional fluxes, Kirkendall voiding can also be found in some coating/substrate combinations [90]." />
