      </node>
      <node id="chunk-28027332c1e907d2b9fb62cbdc68fd6c-e-8" label="1986">
        <attvalues>
          <attvalue for="0" value="1986" />
          <attvalue for="1" value="Date" />
          <attvalue for="2" value="1986年是一个公元年份，是多篇重要学术文章的发表年份。其中包括《物理气相沉积工艺》(Physical vapour deposition processes)与《等离子喷涂涂层的未来发展》(Future developments in plasma spray coating)等论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-28027332c1e907d2b9fb62cbdc68fd6c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-28027332c1e907d2b9fb62cbdc68fd6c-e-9" label="A. R. Nicholl">
        <attvalues>
          <attvalue for="0" value="A. R. Nicholl" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="A. R. Nicholl是一位材料科学领域的研究人员或学者，其专业方向涉及等离子喷涂涂层技术、MCrAlY铸造材料及其高温氧化与腐蚀行为。他是《等离子喷涂涂层的未来发展》等相关学术著作的合著者。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-28027332c1e907d2b9fb62cbdc68fd6c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="2" />
        </attvalues>
