        <attvalues>
          <attvalue for="11" value="INCREASED" />
          <attvalue for="12" value="Rolls-Royce increased the radius of curvature on the leading edge of the turbine blade." />
          <attvalue for="13" value="...which necessitated increasing the radius of curvature at the leading edge to ensure TBC adherence." />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-a6f8ce7a7c55e9b6f962543810b6ee71" />
