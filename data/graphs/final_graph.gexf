          <attvalue for="0" value="Gas Turbines" />
          <attvalue for="1" value="Machine" />
          <attvalue for="2" value="燃气轮机是一种将燃料燃烧能量转化为机械功的热机。它通过产生的高温燃气驱动涡轮高速旋转以输出动力，主要应用于喷气推进系统和发电领域。" />
          <attvalue for="3" value="{}" />
