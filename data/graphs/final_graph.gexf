      <edge source="chunk-ac23817ca85b5e2cba9cb1da3a1960fc-e-2" target="chunk-ac23817ca85b5e2cba9cb1da3a1960fc-e-4" id="chunk-ac23817ca85b5e2cba9cb1da3a1960fc-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_RADIUS_OF" />
          <attvalue for="12" value="r₁ is the radius of the particles along the first line." />
          <attvalue for="13" value="The radius of the particles along the first and second lines are r₁ and r₂." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-ac23817ca85b5e2cba9cb1da3a1960fc" />
          <attvalue for="16" value="0.16666666666666666" />
          <attvalue for="17" value="0.5" />
