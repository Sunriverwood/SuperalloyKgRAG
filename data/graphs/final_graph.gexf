          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e780ac83d97fe15870adf76ec9226ed9-e-3" label="R. Vassen, X. Q. Cao, F. Tietz, D. Basu and D. Stover">
        <attvalues>
          <attvalue for="0" value="R. Vassen, X. Q. Cao, F. Tietz, D. Basu and D. Stover" />
          <attvalue for="1" value="Authors" />
          <attvalue for="2" value="由R. Vassen、X. Q. Cao、F. Tietz、D. Basu与D. Stover五位研究者组成的作者团体，他们合作撰写并发表了关于“锆酸盐”（Zirconates）的科学论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
