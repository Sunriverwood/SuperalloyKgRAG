          <attvalue for="9" value="23" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-e408a73fcde801378877f777a7391169-e-6" label="C. S. Kortovich">
        <attvalues>
          <attvalue for="0" value="C. S. Kortovich" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="C. S. Kortovich是一位材料科学领域的编辑。他参与编纂了学术出版物《Superalloys 1984》（高温合金1984），该书是记录当年高温合金领域重要研究进展的论文集。" />
          <attvalue for="3" value="{}" />
