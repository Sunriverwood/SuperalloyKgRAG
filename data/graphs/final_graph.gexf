      <node id="chunk-6f4f79d57f35ab3e77324ff6707d70bf-e-2" label="A. M. Karlsson">
        <attvalues>
          <attvalue for="0" value="A. M. Karlsson" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="A. M. Karlsson是一位学者与研究人员，其代表性工作是作为合著者发表了关于铂改性镍铝化物粘结涂层微观结构发展的学术论文。该研究属于材料科学领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-6f4f79d57f35ab3e77324ff6707d70bf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6f4f79d57f35ab3e77324ff6707d70bf-e-3" label="On the microstructural development in platinum-modified nickel-aluminide bond coats">
        <attvalues>
          <attvalue for="0" value="On the microstructural development in platinum-modified nickel-aluminide bond coats" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由S. Darzens与A. M. Karlsson合著的学术论文，于2004年发表在《表面与涂层技术》期刊上。该论文旨在研究铂改性镍铝化物粘结涂层的微观结构发展。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2004&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-6f4f79d57f35ab3e77324ff6707d70bf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="3" />
