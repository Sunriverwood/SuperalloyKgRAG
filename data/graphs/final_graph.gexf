        <attvalues>
          <attvalue for="11" value="CAUSES" />
          <attvalue for="12" value="Compressive stress (σc) reaching a certain value causes the coating to undergo buckling." />
          <attvalue for="13" value="it undergoes buckling when the compressive stress, σc, in the coating attains a value" />
