        <attvalues>
          <attvalue for="11" value="AFFECTS_AVAILABILITY_OF" />
          <attvalue for="12" value="At very low or very high OPRs, negligible work is available for propulsion." />
          <attvalue for="13" value="This is because at very low or very high OPRs, the difference between CW and the EW is minimal, and, since CW = TW, then negligible work is available for propulsion." />
          <attvalue for="14" value="r-2" />
