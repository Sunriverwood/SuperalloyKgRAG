      <edge source="chunk-3b7190e1fe7c8f3dcc05817f989e004f-e-1" target="chunk-3b7190e1fe7c8f3dcc05817f989e004f-e-2" id="chunk-3b7190e1fe7c8f3dcc05817f989e004f-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="SENT_TO" />
          <attvalue for="12" value="A rocket is proposed to be sent to the moon." />
          <attvalue for="13" value="But if I were to say, my fellow citizens, that we shall send a rocket to the moon, 240000 miles away from the control station in Houston" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-3b7190e1fe7c8f3dcc05817f989e004f" />
          <attvalue for="16" value="0.01282051282051282" />
          <attvalue for="17" value="0.4076923076923077" />
        </attvalues>
      </edge>
      <edge source="chunk-3b7190e1fe7c8f3dcc05817f989e004f-e-1" target="chunk-3b7190e1fe7c8f3dcc05817f989e004f-e-4" id="chunk-3b7190e1fe7c8f3dcc05817f989e004f-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="MADE_OF" />
          <attvalue for="12" value="The rocket is made of new metal alloys." />
          <attvalue for="13" value="made of new metal alloys, some of which have not yet been invented" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-3b7190e1fe7c8f3dcc05817f989e004f" />
          <attvalue for="16" value="0.01282051282051282" />
          <attvalue for="17" value="0.4076923076923077" />
        </attvalues>
      </edge>
      <edge source="chunk-3b7190e1fe7c8f3dcc05817f989e004f-e-1" target="chunk-3b7190e1fe7c8f3dcc05817f989e004f-e-6" id="chunk-3b7190e1fe7c8f3dcc05817f989e004f-r-5" weight="4.0">
        <attvalues>
          <attvalue for="11" value="HAS_LENGTH_OF" />
          <attvalue for="12" value="The length of the rocket is compared to the length of a football field." />
          <attvalue for="13" value="a giant rocket more than three hundred feet tall, the length of this football field" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-3b7190e1fe7c8f3dcc05817f989e004f" />
          <attvalue for="16" value="0.00641025641025641" />
          <attvalue for="17" value="0.2705128205128205" />
        </attvalues>
      </edge>
      <edge source="chunk-3b7190e1fe7c8f3dcc05817f989e004f-e-2" target="chunk-3b7190e1fe7c8f3dcc05817f989e004f-e-3" id="chunk-3b7190e1fe7c8f3dcc05817f989e004f-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_DISTANT_FROM" />
          <attvalue for="12" value="The moon is 240,000 miles away from the control station in Houston." />
          <attvalue for="13" value="that we shall send a rocket to the moon, 240000 miles away from the control station in Houston" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-3b7190e1fe7c8f3dcc05817f989e004f" />
          <attvalue for="16" value="0.01282051282051282" />
          <attvalue for="17" value="0.4076923076923077" />
        </attvalues>
      </edge>
      <edge source="chunk-3b7190e1fe7c8f3dcc05817f989e004f-e-4" target="chunk-3b7190e1fe7c8f3dcc05817f989e004f-e-5" id="chunk-3b7190e1fe7c8f3dcc05817f989e004f-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="WITHSTANDS" />
          <attvalue for="12" value="The new metal alloys are capable of withstanding extreme heat and stresses." />
          <attvalue for="13" value="capable of standing heat and stresses several times more than have ever been experienced" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-3b7190e1fe7c8f3dcc05817f989e004f" />
          <attvalue for="16" value="0.01282051282051282" />
          <attvalue for="17" value="0.4076923076923077" />
        </attvalues>
      </edge>
      <edge source="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-3" target="chunk-3b7190e1fe7c8f3dcc05817f989e004f-e-5" id="chunk-08e3f5162aec4977b5f7bdcccbd3e160-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="WITHSTANDS" />
          <attvalue for="12" value="The mission involves withstanding heat and stresses greater than any previously experienced." />
          <attvalue for="13" value="standing heat and stresses several times more than have ever been experienced" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-08e3f5162aec4977b5f7bdcccbd3e160" />
          <attvalue for="16" value="0.00641025641025641" />
          <attvalue for="17" value="0.40384615384615385" />
        </attvalues>
      </edge>
      <edge source="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-3" target="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-2" id="chunk-08e3f5162aec4977b5f7bdcccbd3e160-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CARRIES" />
          <attvalue for="12" value="The mission carries all the necessary equipment for its various functions." />
          <attvalue for="13" value="carrying all the equipment needed for propulsion, guidance, control, communications, food and survival" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-08e3f5162aec4977b5f7bdcccbd3e160" />
          <attvalue for="16" value="0.00641025641025641" />
          <attvalue for="17" value="0.40384615384615385" />
        </attvalues>
      </edge>
      <edge source="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-3" target="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-4" id="chunk-08e3f5162aec4977b5f7bdcccbd3e160-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="TARGETS" />
          <attvalue for="12" value="The untried mission is directed to an unknown celestial body." />
          <attvalue for="13" value="on an untried mission, to an unknown celestial body" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-08e3f5162aec4977b5f7bdcccbd3e160" />
          <attvalue for="16" value="0.00641025641025641" />
          <attvalue for="17" value="0.40384615384615385" />
        </attvalues>
      </edge>
      <edge source="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-3" target="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-5" id="chunk-08e3f5162aec4977b5f7bdcccbd3e160-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="RETURNS_TO" />
          <attvalue for="12" value="The mission plan includes a safe return to Earth." />
          <attvalue for="13" value="and then return it safely to Earth" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-08e3f5162aec4977b5f7bdcccbd3e160" />
          <attvalue for="16" value="0.00641025641025641" />
          <attvalue for="17" value="0.40384615384615385" />
        </attvalues>
      </edge>
      <edge source="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-3" target="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-6" id="chunk-08e3f5162aec4977b5f7bdcccbd3e160-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="RE-ENTERS" />
          <attvalue for="12" value="The return phase of the mission involves re-entering the atmosphere." />
          <attvalue for="13" value="re-entering the atmosphere at speeds of over 25 000 miles per hour" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-08e3f5162aec4977b5f7bdcccbd3e160" />
          <attvalue for="16" value="0.00641025641025641" />
          <attvalue for="17" value="0.40384615384615385" />
        </attvalues>
      </edge>
      <edge source="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-3" target="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-7" id="chunk-08e3f5162aec4977b5f7bdcccbd3e160-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CAUSES" />
          <attvalue for="12" value="The atmospheric re-entry phase of the mission causes extreme heat." />
          <attvalue for="13" value="re-entering the atmosphere at speeds of over 25 000 miles per hour, causing heat about half that of the temperature of the sun" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-08e3f5162aec4977b5f7bdcccbd3e160" />
          <attvalue for="16" value="0.01282051282051282" />
          <attvalue for="17" value="0.4076923076923077" />
        </attvalues>
      </edge>
      <edge source="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-7" target="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-8" id="chunk-08e3f5162aec4977b5f7bdcccbd3e160-r-7" weight="4.0">
        <attvalues>
          <attvalue for="11" value="COMPARED_TO" />
          <attvalue for="12" value="The re-entry heat is described as being about half the temperature of the sun." />
          <attvalue for="13" value="causing heat about half that of the temperature of the sun" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-08e3f5162aec4977b5f7bdcccbd3e160" />
          <attvalue for="16" value="0.01282051282051282" />
          <attvalue for="17" value="0.27435897435897433" />
        </attvalues>
      </edge>
      <edge source="chunk-caf10e1ff2600a4e9c7b7b30e4ee750a-e-1" target="chunk-caf10e1ff2600a4e9c7b7b30e4ee750a-e-3" id="chunk-caf10e1ff2600a4e9c7b7b30e4ee750a-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DELIVERED_SPEECH_AT" />
          <attvalue for="12" value="John F. Kennedy delivered a speech at Rice University." />
          <attvalue for="13" value="From John F. Kennedy's speech at Rice University, Houston, Texas, 12 September 1962" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-caf10e1ff2600a4e9c7b7b30e4ee750a" />
          <attvalue for="16" value="0.16666666666666666" />
