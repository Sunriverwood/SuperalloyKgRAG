        <attvalues>
          <attvalue for="11" value="ADOPTED" />
          <attvalue for="12" value="Fighter aircraft were the first to adopt the new superalloy and coatings technology." />
          <attvalue for="13" value="During this time, new superalloy and coatings technology was adopted first in fighter aircraft" />
