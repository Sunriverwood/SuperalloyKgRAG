          <attvalue for="9" value="86" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d246d51e161275b250bc309214ccd241-e-5" label="P. Y. Hou">
        <attvalues>
          <attvalue for="0" value="P. Y. Hou" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="P. Y. Hou是一位作者，以其撰写的出版物《Beyond the sulphur effect》而为人所知，该作品是当前上下文中定义其身份的关键信息。" />
          <attvalue for="3" value="{}" />
