        <attvalues>
          <attvalue for="11" value="IS_A" />
          <attvalue for="12" value="Waspaloy is mentioned as an example of a superalloy." />
          <attvalue for="13" value="...superalloys of low yield stress such as Waspaloy or IN718." />
          <attvalue for="14" value="r-5" />
