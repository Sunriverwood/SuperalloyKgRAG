        <attvalues>
          <attvalue for="11" value="DISINTEGRATES_INTO" />
          <attvalue for="12" value="The stream of molten metal is broken down into spherical particles." />
          <attvalue for="13" value="the action of which causes its disintegration into spherical particles of diameter 30 to 300 µm." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-dc663680c2568caff49f127612995631" />
          <attvalue for="16" value="0.000784313725490196" />
