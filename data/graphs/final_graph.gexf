        <attvalues>
          <attvalue for="11" value="VARIES_DURING" />
          <attvalue for="12" value="The Turbine Entry Temperature (TET) varies greatly during a typical flight cycle." />
          <attvalue for="13" value="Of course, the TET varies greatly during a typical flight cycle" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-463ddd0dbebb2a2fc18f797d9effe3e6" />
          <attvalue for="16" value="0.0017112017901803344" />
