        <attvalues>
          <attvalue for="11" value="CALCULATED_FROM" />
          <attvalue for="12" value="The critical buckling stress (σc) is proportional to the square of the ratio of thickness (h) to width/length (b)." />
          <attvalue for="13" value="σc = (π² / 12) * (E|| / (1 - ν²)) * (h/b)²" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-80545b960495f33fd33c6ee9963001b5" />
