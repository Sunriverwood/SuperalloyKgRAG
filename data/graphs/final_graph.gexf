          <attvalue for="9" value="10" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d246d51e161275b250bc309214ccd241-e-9" label="Grain boundary segregation in Ni and binary Ni alloy">
        <attvalues>
          <attvalue for="0" value="Grain boundary segregation in Ni and binary Ni alloy" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由R. A. Mulford撰写的一篇科学出版物。该研究聚焦于晶界偏析现象，具体探讨了在纯镍（Ni）和镍二元合金材料中，化学元素在晶粒边界发生富集的物理过程及其机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-d246d51e161275b250bc309214ccd241" />
