      <node id="chunk-27d4439c082e1df0f703012a02b14ffb-e-5" label="High Temperature Surface Engineering">
        <attvalues>
          <attvalue for="0" value="High Temperature Surface Engineering" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《高温表面工程》(High Temperature Surface Engineering)是一部由J. Nicholls和D. Rickerby主编、材料学会(The Institute of Materials)出版的学术著作集。该书收录了多篇关于高温环境下材料表面改性与涂层技术的专业研究论文。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2000&quot;, &quot;location&quot;: &quot;London&quot;}" />
