          <attvalue for="6" value="true" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-981a92f0f4067ae9a68b178dffd922ce-e-3" label="United States of America">
        <attvalues>
          <attvalue for="0" value="United States of America" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="美国，全称美利坚合众国，是由50个州和一个联邦特区组成的联邦共和立宪制国家。该国主体位于北美洲中部，是世界在经济、文化和军事上最具影响力的国家之一，也是一个高度发达的资本主义国家。" />
