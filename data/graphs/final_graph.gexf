      </node>
      <node id="chunk-f23caa328479b9d419f0d855b9335eb4-e-14" label="Mar-M200">
        <attvalues>
          <attvalue for="0" value="Mar-M200" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="Mar-M200是一种由马丁·玛丽埃塔公司开发的镍基高温合金。它以钨（W）为主要强化元素，具有卓越的高温强度、持久性能和抗蠕变性，被广泛用于制造航空发动机和工业燃气轮机的涡轮叶片等关键热端部件。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;83, 127, 316&quot;}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-f23caa328479b9d419f0d855b9335eb4" />
