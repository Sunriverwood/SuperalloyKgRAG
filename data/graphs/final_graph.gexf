        <attvalues>
          <attvalue for="11" value="REDUCES" />
          <attvalue for="12" value="The growth and coalescence of incipient cracks lead to a reduction in the elastic strain energy of the system." />
          <attvalue for="13" value="these grow and coalesce to reduce the elastic strain energy in the system" />
