        <attvalues>
          <attvalue for="11" value="HAS_PROPERTY_IN_DIRECTION" />
          <attvalue for="12" value="In the (100) direction, pure nickel has a Young's Modulus of 125 GPa and is at its least stiff." />
          <attvalue for="13" value="Using the values of Sij for pure nickel, one can show that the (100) direction is the least stiff... The values are E(100) = 125 GPa..." />
          <attvalue for="14" value="r-1" />
