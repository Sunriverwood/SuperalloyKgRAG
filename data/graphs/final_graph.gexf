        <attvalues>
          <attvalue for="11" value="IS_DEFINED_BY" />
          <attvalue for="12" value="The misfit stress (σ₀) is calculated using the Young's modulus (E||) as per equation 5.2." />
          <attvalue for="13" value="σ₀ = E||εT/(1 − ν²)" />
          <attvalue for="14" value="r-6" />
