      <edge source="chunk-2a630be2b8090ec92842cc9c1737eb42-e-3" target="chunk-da09b64f941acad7c5dafb6cd99e1895-e-2" id="chunk-2a630be2b8090ec92842cc9c1737eb42-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CAUSES" />
          <attvalue for="12" value="The over-aged condition is the cause for the γ' particles being large." />
          <attvalue for="13" value="When the γ' particles are large, as will be the case for the over-aged condition, the spacing of the dislocation pairs becomes comparable to the particle diameter." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-2a630be2b8090ec92842cc9c1737eb42" />
          <attvalue for="16" value="0.0027315479710512233" />
          <attvalue for="17" value="0.40163892878263074" />
        </attvalues>
