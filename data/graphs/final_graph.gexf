      <edge source="chunk-98004d55693f7f9432c5daf0464e7353-e-6" target="chunk-cbf4d780dd2a841aa5348c2c70b0276f-e-2" id="chunk-cbf4d780dd2a841aa5348c2c70b0276f-r-7" weight="3.0">
        <attvalues>
          <attvalue for="11" value="IS_PART_OF" />
          <attvalue for="12" value="The Paris Law regime is a concept within the broader framework of linear elastic fracture mechanics." />
          <attvalue for="13" value="predicted from the linear elastic fracture mechanics, Paris Law regime" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-cbf4d780dd2a841aa5348c2c70b0276f" />
          <attvalue for="16" value="0.0015684907633321714" />
