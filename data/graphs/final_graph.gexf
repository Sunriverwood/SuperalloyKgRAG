      <node id="chunk-7027df3183981418ce449ee96ef327a1-e-8" label="M. Watanabe, D. R. Mumm, S. Chiras and A. G. Evans">
        <attvalues>
          <attvalue for="0" value="M. Watanabe, D. R. Mumm, S. Chiras and A. G. Evans" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="M. Watanabe, D. R. Mumm, S. Chiras 与 A. G. Evans 是一组研究人员。他们共同撰写了一篇关于测量铂铝化物粘结层（Pt-aluminide bond coat）中残余应力的科学论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-7027df3183981418ce449ee96ef327a1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-89e037006a60ff84d312fb1878f7b7ba-e-3" label="jet-powered civil aviation">
        <attvalues>
          <attvalue for="0" value="jet-powered civil aviation" />
          <attvalue for="1" value="Technology Era" />
          <attvalue for="2" value="一个始于20世纪50年代的民用航空技术时代，以喷气式客机的商业化为标志。该时代由燃气涡轮发动机技术的进步驱动，其发展与高温合金等耐高温材料的成功应用密不可分。" />
          <attvalue for="3" value="{&quot;start_period&quot;: &quot;1950s&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-89e037006a60ff84d312fb1878f7b7ba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-89e037006a60ff84d312fb1878f7b7ba-e-4" label="gas turbine engine">
        <attvalues>
          <attvalue for="0" value="gas turbine engine" />
          <attvalue for="1" value="Engine" />
          <attvalue for="2" value="燃气轮机发动机是一种将燃料化学能转化为机械功的内燃机。它通过燃烧产生高温燃气来驱动涡轮旋转。现代燃气轮机发动机的高性能表现，特别是在极端温度和压力下的效率与可靠性，关键得益于超级合金等先进材料的应用，这些材料支撑了其性能的根本性提升。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-89e037006a60ff84d312fb1878f7b7ba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6ef562415fc4e831401481f93072dca3-e-1" label="Gas turbine engine">
        <attvalues>
          <attvalue for="0" value="Gas turbine engine" />
          <attvalue for="1" value="Engine Technology" />
          <attvalue for="2" value="一种以连续流动的气体为工质、依靠布雷顿循环工作的热力发动机。它通过压缩机、燃烧室和涡轮，将燃料的化学能转化为机械功（轴功率）或产生推力，广泛应用于航空、发电和工业驱动领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-6ef562415fc4e831401481f93072dca3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="354" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-6ef562415fc4e831401481f93072dca3-e-2" label="Ghost engine">
        <attvalues>
          <attvalue for="0" value="Ghost engine" />
          <attvalue for="1" value="Engine Model" />
          <attvalue for="2" value="Ghost引擎是一款早期的涡轮喷气发动机，因作为世界首款商业喷气式客机“彗星一号”的动力装置而闻名。作为第一代民用喷气发动机的代表，其技术已被更先进的现代涡扇发动机超越。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-6ef562415fc4e831401481f93072dca3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6ef562415fc4e831401481f93072dca3-e-3" label="Comet I">
        <attvalues>
          <attvalue for="0" value="Comet I" />
          <attvalue for="1" value="Aircraft" />
          <attvalue for="2" value="彗星一型（Comet I）是由英国德哈维兰公司研制的世界上第一款喷气式客机。该机型搭载“幽灵”（Ghost）涡轮喷气发动机，于1952年投入商业服务，开创了民用航空的喷气时代。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-6ef562415fc4e831401481f93072dca3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c66ff8a529b9512996f0b3af456f00ce-e-2" label="Engine Weight">
        <attvalues>
          <attvalue for="0" value="Engine Weight" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="指发动机重量与所产生推力的比值（重量/推力），是衡量发动机（尤其是航空发动机）重量效率和技术水平的关键物理性能指标。更低的比值意味着能以更轻的重量获得同等推力，代表其设计更为先进。" />
          <attvalue for="3" value="{&quot;reduction_factor&quot;: &quot;about 4&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c66ff8a529b9512996f0b3af456f00ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c66ff8a529b9512996f0b3af456f00ce-e-2&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c66ff8a529b9512996f0b3af456f00ce-e-6" label="Turbine">
        <attvalues>
          <attvalue for="0" value="Turbine" />
          <attvalue for="1" value="Engine Section" />
          <attvalue for="2" value="涡轮是发动机的关键高温部件，它将来自燃烧室的高温高压气体的热能转化为驱动压气机的机械功。因其工作在极端高温高压环境下，其叶片等核心组件由具备优异耐热和抗蠕变性能的超合金材料制成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c66ff8a529b9512996f0b3af456f00ce" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c66ff8a529b9512996f0b3af456f00ce-e-7" label="Technological Success">
        <attvalues>
          <attvalue for="0" value="Technological Success" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="指发动机技术的成功进步，以燃油经济性提高、重量降低等综合性能的整体改善为标志。这种进步的实现，关键依赖于高温合金等先进材料的应用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c66ff8a529b9512996f0b3af456f00ce" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c66ff8a529b9512996f0b3af456f00ce-e-9" label="Fatigue">
        <attvalues>
          <attvalue for="0" value="Fatigue" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="疲劳（Fatigue）是一种材料属性，指材料在远低于其静态极限强度的循环应力或应变作用下，产生局部、渐进性损伤并最终导致断裂的现象。这种失效模式是评估超合金等关键结构材料在动态负载下可靠性和寿命的重要指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-c66ff8a529b9512996f0b3af456f00ce" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f1dbde91fa2668ef8c190d0d43e91e27-e-1" label="Alloys">
        <attvalues>
          <attvalue for="0" value="Alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种通过成分演变与新工艺开发而成的材料。这类合金旨在优化其力学性能，尤其是在抗蠕变（材料在应力下缓慢永久变形的趋势）和抗疲劳（材料在循环加载下失效的倾向）方面表现出显著的改进。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-f1dbde91fa2668ef8c190d0d43e91e27" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-f1dbde91fa2668ef8c190d0d43e91e27-e-3" label="Fatigue">
        <attvalues>
          <attvalue for="0" value="Fatigue" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="疲劳（Fatigue）是材料在反复交变的载荷或应力作用下，结构发生局部永久性损伤并最终导致断裂的力学性能。作为合金的关键属性，其性能的改善是提升涡轮发动机等高温部件可靠性与工作极限（如涡轮前温度）的关键。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-f1dbde91fa2668ef8c190d0d43e91e27" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f1dbde91fa2668ef8c190d0d43e91e27-e-5" label="New processes">
        <attvalues>
          <attvalue for="0" value="New processes" />
          <attvalue for="1" value="Process Category" />
          <attvalue for="2" value="指在材料开发，特别是合金发展中起关键作用的一类先进制造工艺。该类别是多种具体技术的总称，例如真空熔炼、定向凝固/熔模铸造以及粉末冶金技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-f1dbde91fa2668ef8c190d0d43e91e27" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-f1dbde91fa2668ef8c190d0d43e91e27-e-6" label="Vacuum melting">
        <attvalues>
          <attvalue for="0" value="Vacuum melting" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="真空熔炼是一种在低于一个大气压的真空环境中，对金属或合金进行加热熔化的冶金工艺。该工艺旨在防止材料与空气反应而氧化，并去除熔体中溶解的气体杂质，从而制备出纯净度高、性能优异的特种合金及高纯金属。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-f1dbde91fa2668ef8c190d0d43e91e27" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;vacuum melting&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f1dbde91fa2668ef8c190d0d43e91e27-e-6&quot;, &quot;chunk-44260d4b7de8c9a00040496e0aad271b-e-4&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24-e-1" label="Superalloy development">
        <attvalues>
          <attvalue for="0" value="Superalloy development" />
          <attvalue for="1" value="Technological Process" />
          <attvalue for="2" value="一项在冷战期间（战后至70年代末），由美国、欧洲和前苏联主导的前沿技术进程。该进程旨在开发出能支持先进军用飞机发动机设计的新型高温合金，是当时军备竞赛的关键一环。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24-e-2" label="Cold War">
        <attvalues>
          <attvalue for="0" value="Cold War" />
          <attvalue for="1" value="Historical Period" />
          <attvalue for="2" value="冷战（Cold War）指第二次世界大战后，以美国为首的西方集团与以苏联为首的东方集团之间长达数十年的政治对抗、军备竞赛和意识形态对立。该时期（约1947-1991年）双方避免了直接的军事冲突，但通过代理人战争、科技竞赛等方式进行全球性对抗。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24-e-3" label="Engine designs for military aircraft">
        <attvalues>
          <attvalue for="0" value="Engine designs for military aircraft" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="一项关键应用领域，指在冷战时期为满足高性能军事需求而进行的航空发动机设计。它成为推动高温合金材料发展的首要驱动力，因为这类合金能让发动机承受极端温度与压力，从而显著提升军用飞机的推力、速度及可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24-e-5" label="Europe">
        <attvalues>
          <attvalue for="0" value="Europe" />
          <attvalue for="1" value="Geopolitical Entity" />
          <attvalue for="2" value="欧洲，即欧罗巴洲，是世界七大洲之一，由多个国家组成的地缘政治实体。它在科技领域占有重要地位，是进行尖端超级合金研发等前沿科技活动的中心之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24-e-6" label="Former USSR">
        <attvalues>
          <attvalue for="0" value="Former USSR" />
          <attvalue for="1" value="Geopolitical Entity" />
          <attvalue for="2" value="苏维埃社会主义共和国联盟（简称苏联），一个存在于1922年至1991年的欧亚大陆社会主义联邦制国家。作为冷战时期的超级大国，它在政治、军事和科技领域，如尖端高温合金研发等方面，均取得了重大成就。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24-e-7" label="Superalloy technology">
        <attvalues>
          <attvalue for="0" value="Superalloy technology" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="高温合金技术（Superalloy technology）是一种关于制造与应用特种金属材料的工程技术。这些材料在极端高温高压环境下仍能保持卓越的机械强度、抗蠕变和耐腐蚀性。该技术是现代航空发动机的核心，最初被率先应用于战斗机以提升其高温性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24-e-9" label="Fighter aircraft">
        <attvalues>
          <attvalue for="0" value="Fighter aircraft" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="战斗机，又称歼击机，是主要用于在空中消灭敌机、夺取制空权的军用飞机。其特点是机动性强、速度快，并装备航炮、空对空导弹等攻击性武器。作为尖端技术应用平台，它常率先采用新型高温合金、涂层等先进技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24-e-9&quot;, &quot;chunk-cc0e4797c03b60c3cb27387672a6c026-e-2&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cc0e4797c03b60c3cb27387672a6c026-e-1" label="Superalloy and coatings technology">
        <attvalues>
          <attvalue for="0" value="Superalloy and coatings technology" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="高温合金与涂层技术是一项先进材料技术，专注于开发在极端高温高压下保持优异性能的金属合金及其保护涂层。该技术是航空航天工业的核心，对于制造民用航空发动机和军用战斗机中的关键耐热部件（如涡轮叶片）至关重要，其发展常由军事机构推动。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-cc0e4797c03b60c3cb27387672a6c026" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-cc0e4797c03b60c3cb27387672a6c026-e-3" label="Military organisations">
        <attvalues>
          <attvalue for="0" value="Military organisations" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="军事组织是使用政府补贴等国家财政资源，资助和推动关键先进技术（如高温合金技术）研发与应用的国家武装力量机构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-cc0e4797c03b60c3cb27387672a6c026" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cc0e4797c03b60c3cb27387672a6c026-e-4" label="Government subsidies">
        <attvalues>
          <attvalue for="0" value="Government subsidies" />
          <attvalue for="1" value="Financial Instrument" />
          <attvalue for="2" value="政府为实现特定公共政策目标，向特定企业、行业或个人提供的财政援助或税收优惠等激励措施。其旨在扶持产业发展、稳定市场价格或促进社会公平，是政府干预经济的重要工具。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-cc0e4797c03b60c3cb27387672a6c026" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cc0e4797c03b60c3cb27387672a6c026-e-5" label="Iron Curtain">
        <attvalues>
          <attvalue for="0" value="Iron Curtain" />
          <attvalue for="1" value="Geopolitical Concept" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;铁幕是冷战时期（约1945-1991）分割欧洲的政治军事与意识形态边界，用以隔离苏联及东欧卫星国与西方阵营。它的解体是地缘政治的重大转折，终结了军事驱动的技术主导模式，并促使民用领域成为科技创新的新引擎。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-cc0e4797c03b60c3cb27387672a6c026" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="120" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cc0e4797c03b60c3cb27387672a6c026-e-6" label="Civil sector">
        <attvalues>
          <attvalue for="0" value="Civil sector" />
          <attvalue for="1" value="Economic Sector" />
          <attvalue for="2" value="民用部门指经济中服务于普通民众而非军事或政府的部分。冷战结束后（铁幕倒塌后），它取代了军事部门，成为推动新材料技术创新与应用的主导力量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-cc0e4797c03b60c3cb27387672a6c026" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="120" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cc0e4797c03b60c3cb27387672a6c026-e-7" label="Military sector">
        <attvalues>
          <attvalue for="0" value="Military sector" />
          <attvalue for="1" value="Economic Sector" />
          <attvalue for="2" value="指负责国防及相关产品研发、生产和采购的经济部门。在历史上，它曾是新材料等尖端技术应用的先行者和主要驱动力，其主导作用后被民用部门超越。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-cc0e4797c03b60c3cb27387672a6c026" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="120" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cc0e4797c03b60c3cb27387672a6c026-e-8" label="Civil aeroengines">
        <attvalues>
          <attvalue for="0" value="Civil aeroengines" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="民用航空发动机是为商业客机、货机等民用飞行器提供推力的动力装置。作为一种技术高度复杂的燃气涡轮发动机，其涡轮盘等关键热端部件为承受极端高温高压环境，通常采用粉末冶金（P/M）高温合金等先进材料制造，以确保其性能与安全。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-cc0e4797c03b60c3cb27387672a6c026" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cc0e4797c03b60c3cb27387672a6c026-e-8&quot;, &quot;chunk-984b31532b15eb77f69439c6359615d7-e-4&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cc0e4797c03b60c3cb27387672a6c026-e-9" label="Civil aviation sector">
        <attvalues>
          <attvalue for="0" value="Civil aviation sector" />
          <attvalue for="1" value="Economic Sector" />
          <attvalue for="2" value="民航业（Civil aviation sector）是指提供非军事航空运输服务的经济部门。它主要包括商业航空公司（客运和货运）、机场运营、空中交通管制以及飞机制造和维护等相关产业。该部门在全球贸易和人员流动中扮演着至关重要的角色。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-cc0e4797c03b60c3cb27387672a6c026" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cc0e4797c03b60c3cb27387672a6c026-e-9&quot;, &quot;chunk-d97ee852ec4cf802eba7492551d5fcae-e-1&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cc0e4797c03b60c3cb27387672a6c026-e-10" label="Cost reduction">
        <attvalues>
          <attvalue for="0" value="Cost reduction" />
          <attvalue for="1" value="Business Goal" />
          <attvalue for="2" value="一项旨在降低企业开支的商业目标。在1990年代，由于民航领域的竞争加剧，这一需求变得至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-cc0e4797c03b60c3cb27387672a6c026" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d97ee852ec4cf802eba7492551d5fcae-e-3" label="'Faster and cheaper' derivative designs">
        <attvalues>
          <attvalue for="0" value="'Faster and cheaper' derivative designs" />
          <attvalue for="1" value="Design Philosophy" />
          <attvalue for="2" value="一种在航空发动机行业中被强调的设计理念。为应对市场压力及适应多样化机体的需求，该理念主张在现有设计基础上，以更短的周期和更低的成本快速开发出性能改进的派生型号。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d97ee852ec4cf802eba7492551d5fcae" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d97ee852ec4cf802eba7492551d5fcae-e-5" label="Computer-based design">
        <attvalues>
          <attvalue for="0" value="Computer-based design" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="基于计算机的设计是一种利用计算机软件进行产品或系统的建模、分析与优化的技术。它被广泛应用于工程领域，例如在材料科学中用于合金开发，或在机械工程中用于零部件优化，以提升设计效率和产品性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d97ee852ec4cf802eba7492551d5fcae" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d97ee852ec4cf802eba7492551d5fcae-e-7" label="Component optimisation">
        <attvalues>
          <attvalue for="0" value="Component optimisation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="组件优化是一种系统性过程，指利用计算机辅助设计与加工建模等技术，对零部件的结构、材料或制造工艺进行改进与完善，以达到提升性能、降低成本或减轻重量等特定目标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d97ee852ec4cf802eba7492551d5fcae" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d97ee852ec4cf802eba7492551d5fcae-e-8" label="Processing modelling">
        <attvalues>
          <attvalue for="0" value="Processing modelling" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="加工建模是一种用于部件优化的方法论。它通过为物理制造过程（如铸造、成型）建立数学或计算模型，模拟不同工艺参数对部件最终性能和质量的影响，从而实现对制造过程和产品特性的预测与优化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-d97ee852ec4cf802eba7492551d5fcae" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d97ee852ec4cf802eba7492551d5fcae-e-8&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-74b205b68dc7853e9ae3ea2980e3bc5a-e-1" label="industrial gas turbine (IGT) business">
        <attvalues>
          <attvalue for="0" value="industrial gas turbine (IGT) business" />
          <attvalue for="1" value="Industry Sector" />
          <attvalue for="2" value="工业燃气轮机(IGT)业务是一个专注于设计、制造和销售用于发电的工业燃气轮机的产业领域。该行业的发展与电力需求紧密相关，尤其受到“天然气热潮”(dash-for-gas)的显著推动，在世纪之交经历了快速增长。其市场表现通过销售额和市场份额等指标衡量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-74b205b68dc7853e9ae3ea2980e3bc5a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-74b205b68dc7853e9ae3ea2980e3bc5a-e-1&quot;]}]" />
          <attvalue for="9" value="45" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-74b205b68dc7853e9ae3ea2980e3bc5a-e-2" label="dash-for-gas">
        <attvalues>
          <attvalue for="0" value="dash-for-gas" />
          <attvalue for="1" value="Trend" />
          <attvalue for="2" value="“天然气冲刺”指一场主要发生在欧洲的能源趋势，即发电行业大规模从其他燃料（尤其是煤炭）转向使用天然气。这一转变是推动工业燃气轮机（IGT）业务增长的关键驱动力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-74b205b68dc7853e9ae3ea2980e3bc5a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="45" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-74b205b68dc7853e9ae3ea2980e3bc5a-e-3" label="Europe">
        <attvalues>
          <attvalue for="0" value="Europe" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="欧洲是位于北半球的大洲，为西方文明发源地。在现代能源史上，该地区是“天然气冲刺”（dash-for-gas）的典型发生地，指20世纪末发电能源从煤炭大规模转向天然气的经济现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-74b205b68dc7853e9ae3ea2980e3bc5a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="45" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-74b205b68dc7853e9ae3ea2980e3bc5a-e-4" label="Electricity">
        <attvalues>
          <attvalue for="0" value="Electricity" />
          <attvalue for="1" value="Commodity" />
          <attvalue for="2" value="电力是一种商品，在中国、印度等发展中经济体的需求日益增长。这种不断增长的能源需求是推动工业燃气轮机（IGT）业务发展的关键驱动力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-74b205b68dc7853e9ae3ea2980e3bc5a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="45" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-74b205b68dc7853e9ae3ea2980e3bc5a-e-5" label="China">
        <attvalues>
          <attvalue for="0" value="China" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="中华人民共和国，通常简称为中国，是位于东亚的国家。作为全球主要经济体和发展中国家，其快速的工业化和经济增长导致对电力的需求巨大且持续增加。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-74b205b68dc7853e9ae3ea2980e3bc5a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="45" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-74b205b68dc7853e9ae3ea2980e3bc5a-e-6" label="India">
        <attvalues>
          <attvalue for="0" value="India" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="印度是位于南亚的国家，也是一个主要的发展中经济体。伴随其快速的经济增长和工业化进程，该国对电力等能源的需求巨大且在持续增加。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-74b205b68dc7853e9ae3ea2980e3bc5a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="45" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-74b205b68dc7853e9ae3ea2980e3bc5a-e-7" label="IGT Sales">
        <attvalues>
          <attvalue for="0" value="IGT Sales" />
          <attvalue for="1" value="Financial Metric" />
          <attvalue for="2" value="一项财务指标，指工业燃气轮机 (Industrial Gas Turbine) 业务在特定时期内的销售总收入。它是衡量该业务部门经营业绩、财务状况和市场规模的核心关键绩效指标 (KPI)。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1999&quot;, &quot;initial_value&quot;: &quot;$8.5 bn&quot;, &quot;final_value&quot;: &quot;$13.0 bn&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-74b205b68dc7853e9ae3ea2980e3bc5a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="45" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-74b205b68dc7853e9ae3ea2980e3bc5a-e-8" label="Gas Turbine Market Share">
        <attvalues>
          <attvalue for="0" value="Gas Turbine Market Share" />
          <attvalue for="1" value="Market Metric" />
          <attvalue for="2" value="一个关键市场指标，用于衡量特定企业在工业燃气轮机业务中的销售额或销量，占整个市场总量的相对比例。该指标是评估企业竞争地位和行业影响力的重要依据。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1999&quot;, &quot;initial_share&quot;: &quot;30%&quot;, &quot;final_share&quot;: &quot;38%&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-74b205b68dc7853e9ae3ea2980e3bc5a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="45" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-df6bb30967499a4830b3c790bae2946f-e-1" label="Aeroengine Market Share">
        <attvalues>
          <attvalue for="0" value="Aeroengine Market Share" />
          <attvalue for="1" value="Market Metric" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;航空发动机市场份额是一个关键市场指标，指特定公司或产品的销售额（或销量）在整个航空发动机市场中所占的百分比。与反映绝对规模的销售额不同，该指标主要用于衡量和评估其相对的市场竞争地位。" />
          <attvalue for="3" value="{&quot;initial_value&quot;: &quot;65%&quot;, &quot;final_value&quot;: &quot;59%&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-df6bb30967499a4830b3c790bae2946f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="222" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-df6bb30967499a4830b3c790bae2946f-e-2" label="Aeroengine Sales">
        <attvalues>
          <attvalue for="0" value="Aeroengine Sales" />
          <attvalue for="1" value="Financial Metric" />
          <attvalue for="2" value="指在特定时期内，销售航空发动机所产生的总收入。该财务指标衡量的是绝对销售规模，与衡量相对占比的市场份额（Aeroengine Market Share）相区别。" />
          <attvalue for="3" value="{&quot;initial_value&quot;: &quot;$18.0 bn&quot;, &quot;final_value&quot;: &quot;$20.0 bn&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-df6bb30967499a4830b3c790bae2946f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="222" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a55ba38301e56c486550e13f957970e0-e-3" label="Combined-cycle power plant">
        <attvalues>
          <attvalue for="0" value="Combined-cycle power plant" />
          <attvalue for="1" value="Power Plant" />
          <attvalue for="2" value="联合循环发电厂是一种组合了燃气轮机与蒸汽轮机的高效发电设施。它通过燃气轮机发电，并利用其排出的高温废气作为热源，加热水产生蒸汽来驱动蒸汽轮机进行第二阶段发电，从而极大地提高了整体能源转换效率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a55ba38301e56c486550e13f957970e0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a55ba38301e56c486550e13f957970e0-e-4" label="Steam-powered turbines">
        <attvalues>
          <attvalue for="0" value="Steam-powered turbines" />
          <attvalue for="1" value="Turbine" />
          <attvalue for="2" value="一种将蒸汽热能转化为机械功的旋转动力机械。在联合循环发电厂中，它与工业燃气轮机（IGT）协同工作，利用燃气轮机排出的高温余热产生蒸汽并驱动自身发电，从而显著提升整体能源效率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a55ba38301e56c486550e13f957970e0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a55ba38301e56c486550e13f957970e0-e-4&quot;, &quot;chunk-fb2344899d3b3a491819f8a96ffd95f7-e-1&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a55ba38301e56c486550e13f957970e0-e-5" label="Intermediate-sized plant">
        <attvalues>
          <attvalue for="0" value="Intermediate-sized plant" />
          <attvalue for="1" value="Power Plant" />
          <attvalue for="2" value="中型发电厂是一种发电容量介于大型和小型电厂之间的电力设施，装机容量通常在几十到数百兆瓦之间。它能灵活地满足区域电力需求、支持电网稳定和可再生能源整合，常见形式包括燃气、太阳能和风力发电站。" />
          <attvalue for="3" value="{&quot;power_range&quot;: &quot;25 to 75 MW&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a55ba38301e56c486550e13f957970e0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a55ba38301e56c486550e13f957970e0-e-5&quot;, &quot;chunk-fb2344899d3b3a491819f8a96ffd95f7-e-2&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fb2344899d3b3a491819f8a96ffd95f7-e-3" label="Aeroderivative IGTs">
        <attvalues>
          <attvalue for="0" value="Aeroderivative IGTs" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="航改型工业燃气轮机是一种将航空发动机技术（如先进材料技术）应用于地面发电和工业驱动的燃气轮机。作为工业燃气轮机市场的一部分，它通常用于石油天然气行业和中型发电厂，具有效率高、启动快等特点。" />
          <attvalue for="3" value="{&quot;projected_market_share&quot;: &quot;about 10% of the total IGT market by 2025&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-fb2344899d3b3a491819f8a96ffd95f7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-fb2344899d3b3a491819f8a96ffd95f7-e-4" label="Oil and gas business">
        <attvalues>
          <attvalue for="0" value="Oil and gas business" />
          <attvalue for="1" value="Industry" />
          <attvalue for="2" value="石油和天然气行业（Oil and gas business）是一个从事石油与天然气勘探、开采、炼制、运输和销售的全球性产业。该行业是航改型工业燃气轮机（Aeroderivative IGTs）的重要应用市场，业务广泛分布于阿塞拜疆、巴西、中国、哈萨克斯坦及西非等地区。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-fb2344899d3b3a491819f8a96ffd95f7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-fb2344899d3b3a491819f8a96ffd95f7-e-5" label="Azerbaijan">
        <attvalues>
          <attvalue for="0" value="Azerbaijan" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="阿塞拜疆共和国（Azerbaijan）是一个位于东欧和西亚交界处外高加索地区的国家，东临里海。该国是重要的石油和天然气生产国，其经济高度依赖油气产业的发展。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-fb2344899d3b3a491819f8a96ffd95f7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fb2344899d3b3a491819f8a96ffd95f7-e-6" label="Brazil">
        <attvalues>
          <attvalue for="0" value="Brazil" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="巴西联邦共和国（通称巴西）是南美洲最大的国家。该国自然资源丰富，是全球重要的石油和天然气生产国，以及相关的工业与能源设备市场。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-fb2344899d3b3a491819f8a96ffd95f7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fb2344899d3b3a491819f8a96ffd95f7-e-7" label="China">
        <attvalues>
          <attvalue for="0" value="China" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="中华人民共和国（通称：中国）是位于东亚的主权国家。作为世界人口最多的国家之一和第二大经济体，它是在全球事务中拥有巨大影响力的世界大国。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-fb2344899d3b3a491819f8a96ffd95f7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fb2344899d3b3a491819f8a96ffd95f7-e-8" label="Kazakhstan">
        <attvalues>
          <attvalue for="0" value="Kazakhstan" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="哈萨克斯坦是一个横跨亚欧两洲的中亚国家，也是世界最大的内陆国。该国拥有丰富的石油与天然气资源，是全球重要的能源生产与出口国，其油气行业是国民经济的支柱。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-fb2344899d3b3a491819f8a96ffd95f7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fb2344899d3b3a491819f8a96ffd95f7-e-9" label="West Africa">
        <attvalues>
          <attvalue for="0" value="West Africa" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="西非（West Africa）是非洲大陆最西部的区域，南濒大西洋。该地区通常指由16个国家组成的地理、政治和经济区域集合，因其丰富的石油、天然气等自然资源，在全球经济和地缘政治中占有重要地位。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-fb2344899d3b3a491819f8a96ffd95f7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fb2344899d3b3a491819f8a96ffd95f7-e-10" label="Materials technologies">
        <attvalues>
          <attvalue for="0" value="Materials technologies" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="指源于航空发动机应用的一系列先进材料技术，后被移植并应用于航改型工业燃气轮机，旨在提升其在极端工况下的性能、效率与可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-fb2344899d3b3a491819f8a96ffd95f7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-fb2344899d3b3a491819f8a96ffd95f7-e-11" label="Aeroengine applications">
        <attvalues>
          <attvalue for="0" value="Aeroengine applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="指在航空发动机高温、氧化等严苛工况下的特定应用领域。该领域日益依赖先进防护涂层（如扩散型铝化物粘结涂层）来保护基体合金，以提升部件的耐久性和工作性能，从而降低对合金自身抗氧化性的要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-fb2344899d3b3a491819f8a96ffd95f7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fb2344899d3b3a491819f8a96ffd95f7-e-11&quot;, &quot;chunk-ef2350bf97175d40c9900d549c35b9f1-e-4&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-fb2344899d3b3a491819f8a96ffd95f7-e-12" label="Total IGT market">
        <attvalues>
          <attvalue for="0" value="Total IGT market" />
          <attvalue for="1" value="Market" />
          <attvalue for="2" value="工业燃气轮机（IGT）的全球总市场，指涵盖其所有相关产品、技术及服务的经济活动与交易总和。该市场由多个部分构成，主要包括航空衍生型（Aeroderivative）和重型（Heavy-duty）燃气轮机等细分市场。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-fb2344899d3b3a491819f8a96ffd95f7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-af0a9cb061b4d858fd5a6c9a30785963-e-3" label="environmental regulations">
        <attvalues>
          <attvalue for="0" value="environmental regulations" />
          <attvalue for="1" value="Driving Factor" />
          <attvalue for="2" value="指为应对日益紧张的油气供应与CO2排放等问题而制定的相关政策。作为一项重要驱动因素，这些法规推动了航空发动机和工业燃气轮机（IGTs）等领域的技术发展与革新。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-af0a9cb061b4d858fd5a6c9a30785963" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-af0a9cb061b4d858fd5a6c9a30785963-e-4" label="oil">
        <attvalues>
          <attvalue for="0" value="oil" />
          <attvalue for="1" value="Resource" />
          <attvalue for="2" value="石油是一种关键的化石燃料与工业原料，主要成分为烃类混合物。因其开采和使用会对环境造成显著影响，其日益紧张的供应和环境问题共同推动了相关环保法规的建立。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-af0a9cb061b4d858fd5a6c9a30785963" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-af0a9cb061b4d858fd5a6c9a30785963-e-5" label="gas">
        <attvalues>
          <attvalue for="0" value="gas" />
          <attvalue for="1" value="Resource" />
          <attvalue for="2" value="指天然气等气态化石燃料资源。作为一种重要能源，其燃烧会产生温室气体及污染物，是导致空气污染和气候变化的原因之一。因此，其开采和使用受到环境法规的严格监管。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-af0a9cb061b4d858fd5a6c9a30785963" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-af0a9cb061b4d858fd5a6c9a30785963-e-6" label="CO2 emissions">
        <attvalues>
          <attvalue for="0" value="CO2 emissions" />
          <attvalue for="1" value="Environmental Concern" />
          <attvalue for="2" value="二氧化碳排放（CO2 emissions）指燃烧化石燃料等人类活动向大气中释放二氧化碳的过程。作为最主要的温室气体，它会吸收并困住地球的热量，是驱动全球变暖和气候变化的首要因素。这一现象已成为全球性的环境焦点，并直接推动了各类环保法规的制定与实施。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-af0a9cb061b4d858fd5a6c9a30785963" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-af0a9cb061b4d858fd5a6c9a30785963-e-7" label="Physical metallurgy of superalloys">
        <attvalues>
          <attvalue for="0" value="Physical metallurgy of superalloys" />
          <attvalue for="1" value="Field of Study" />
          <attvalue for="2" value="高温合金冶金学是材料科学与工程的一个分支，专注于研究在极端高温高压下仍能保持优异强度、抗蠕变和抗腐蚀性能的金属材料（即高温合金）。该领域涵盖了其成分设计、制备工艺、微观结构与性能关系，是发展先进航空发动机和超高效发电系统等尖端技术的关键基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-af0a9cb061b4d858fd5a6c9a30785963" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Physical Metallurgy of the Superalloys&quot;, &quot;Physical metallurgy&quot;, &quot;Superalloy Metallurgy&quot;, &quot;Superalloy metallurgy&quot;, &quot;Superalloy metallurgy and processing&quot;, &quot;physical metallurgy of the superalloys&quot;, &quot;superalloy metallurgy&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-23956e10c58e231fcc8e8072af07e6f4-e-10&quot;, &quot;chunk-6259a0e40ccab0aecc0c6e93b8bbc879-e-8&quot;, &quot;chunk-2f58aaf4e11b140e948152f6a58bcf03-e-3&quot;, &quot;chunk-9718b105c96174ffb3694bd3c4362a1e-e-6&quot;, &quot;chunk-de934887953c10df356d75f9bd459e77-e-2&quot;, &quot;chunk-86d807c2e09f9a36246a74f6393dba7c-e-7&quot;, &quot;chunk-af0a9cb061b4d858fd5a6c9a30785963-e-7&quot;, &quot;chunk-09a658ec5283e54954737e18aa2766cc-e-1&quot;, &quot;chunk-683c24651dbc6713d385ae625ce4aa06-e-2&quot;, &quot;chunk-683c24651dbc6713d385ae625ce4aa06-e-9&quot;, &quot;chunk-9da63ec4314ccee7d0b95b714e1813b3-e-1&quot;, &quot;chunk-b38b75a018fa569ff580b1d94d62395d-e-2&quot;, &quot;chunk-c14396eea836d3f1007eeea78f6bab8c-e-3&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-af0a9cb061b4d858fd5a6c9a30785963-e-8" label="processing">
        <attvalues>
          <attvalue for="0" value="processing" />
          <attvalue for="1" value="Technical Field" />
          <attvalue for="2" value="高温合金冶金领域中的一个关键技术分支，专注于开发和应用制造航空发动机、工业燃气轮机等高端装备所需的核心工艺。该领域的技术进步对相关产业的发展至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-af0a9cb061b4d858fd5a6c9a30785963" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-09a658ec5283e54954737e18aa2766cc-e-2" label="Aeroengine sector">
        <attvalues>
          <attvalue for="0" value="Aeroengine sector" />
          <attvalue for="1" value="Industry Sector" />
          <attvalue for="2" value="航空发动机行业（Aeroengine sector）是从事航空飞行器发动机研发、制造、销售和维修的工业领域。该行业技术高度密集，对高温合金冶金与加工等尖端材料和工艺有极高要求，其市场主要面向新型民用飞机，是衡量一个国家高端制造能力和综合国力的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-09a658ec5283e54954737e18aa2766cc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Aeroengine business&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d97ee852ec4cf802eba7492551d5fcae-e-2&quot;, &quot;chunk-09a658ec5283e54954737e18aa2766cc-e-2&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-09a658ec5283e54954737e18aa2766cc-e-3" label="New civil engines">
        <attvalues>
          <attvalue for="0" value="New civil engines" />
          <attvalue for="1" value="Product" />
          <attvalue for="2" value="新型民用发动机是航空发动机领域的一类产品，预计未来20年市场规模将达9万台，价值5500亿美元。其市场需求主要由老旧飞机替换、亚洲市场增长、以及公务机和低成本航空领域的发展所驱动。" />
          <attvalue for="3" value="{&quot;projected market size (units)&quot;: &quot;90000&quot;, &quot;projected market value&quot;: &quot;$550 bn&quot;, &quot;timeframe&quot;: &quot;next 20 years&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-09a658ec5283e54954737e18aa2766cc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-09a658ec5283e54954737e18aa2766cc-e-4" label="Asia">
        <attvalues>
          <attvalue for="0" value="Asia" />
          <attvalue for="1" value="Geographical Region" />
          <attvalue for="2" value="亚洲，全称“亚细亚洲”，是世界上面积最广、人口最多的大洲。其绝大部分陆地位于东半球和北半球，与欧洲共同构成了世界最大的陆块——亚欧大陆。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-09a658ec5283e54954737e18aa2766cc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-09a658ec5283e54954737e18aa2766cc-e-5" label="Ageing aircraft">
        <attvalues>
          <attvalue for="0" value="Ageing aircraft" />
          <attvalue for="1" value="Asset Category" />
          <attvalue for="2" value="指因机龄增长、技术落后或机体损耗而临近服役寿命终点、需要被替换的飞机资产类别。这些飞机的退役和更新换代，是推动市场对新飞机及新民用发动机产生需求的主要驱动力。" />
          <attvalue for="3" value="{&quot;quantity for replacement&quot;: &quot;10000&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-09a658ec5283e54954737e18aa2766cc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-09a658ec5283e54954737e18aa2766cc-e-6" label="Business jet market">
        <attvalues>
          <attvalue for="0" value="Business jet market" />
          <attvalue for="1" value="Market Segment" />
          <attvalue for="2" value="民用航空领域的一个细分市场，专注于私人及企业用途喷气式飞机（公务机）的制造、销售和运营。该市场的规模和发展是影响新型民用发动机需求的关键驱动力。" />
          <attvalue for="3" value="{&quot;status&quot;: &quot;booming&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-09a658ec5283e54954737e18aa2766cc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-09a658ec5283e54954737e18aa2766cc-e-7" label="Low-cost airlines">
        <attvalues>
          <attvalue for="0" value="Low-cost airlines" />
          <attvalue for="1" value="Business Trend" />
          <attvalue for="2" value="低成本航空公司是一种通过简化服务、提高运营效率来提供低价机票的商业模式。作为一种重要的商业趋势，其机队的快速扩张和对燃油经济性的持续追求，直接驱动了市场对新型、高效民用发动机的需求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-09a658ec5283e54954737e18aa2766cc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-49678bb9dd21687268c5616ea6e657b4-e-1" label="Trent 1000">
        <attvalues>
          <attvalue for="0" value="Trent 1000" />
          <attvalue for="1" value="Engine" />
          <attvalue for="2" value="特伦特1000（Trent 1000）是一款专为波音787梦想飞机研制的航空发动机。它在其制造与持续的性能改进过程中，需要应用超级合金等关键的支撑技术来实现高效率与可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-49678bb9dd21687268c5616ea6e657b4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-49678bb9dd21687268c5616ea6e657b4-e-1&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-49678bb9dd21687268c5616ea6e657b4-e-2" label="GEnx">
        <attvalues>
          <attvalue for="0" value="GEnx" />
          <attvalue for="1" value="Engine" />
          <attvalue for="2" value="通用电气GEnx是一款由GE航空集团为波音787梦想飞机开发的先进高涵道比涡扇发动机。它采用了包括Rene 104镍基高温合金在内的先进材料，以提高燃油效率和耐久性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-49678bb9dd21687268c5616ea6e657b4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;General Electric's GEnx engine&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3031ff2205f827feea0affe73ca7d2ae-e-6&quot;, &quot;chunk-49678bb9dd21687268c5616ea6e657b4-e-2&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-49678bb9dd21687268c5616ea6e657b4-e-5" label="Supporting technologies">
        <attvalues>
          <attvalue for="0" value="Supporting technologies" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="指为实现新型航空发动机（如遄达1000）的设计，而必须与新型高温合金等先进材料协同应用的一系列关键技术。它们是确保新一代发动机研发成功、将设计转化为现实的技术基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-49678bb9dd21687268c5616ea6e657b4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-49678bb9dd21687268c5616ea6e657b4-e-6" label="Land-based turbines">
        <attvalues>
          <attvalue for="0" value="Land-based turbines" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="指安装在陆地上的风力涡轮机，是陆上风力发电的核心设备。它利用风能驱动叶片旋转，再通过发电机将机械能转换成电能，与安装于水域的海上涡轮机相对应。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-49678bb9dd21687268c5616ea6e657b4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="355" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-49678bb9dd21687268c5616ea6e657b4-e-7" label="Turbine blade applications">
        <attvalues>
          <attvalue for="0" value="Turbine blade applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="涡轮叶片应用，指将涡轮叶片作为能量转换核心部件的各类技术领域。在这些应用中，叶片将高速流体（如燃气、蒸汽、空气）的动能转化为旋转机械能，以驱动设备。其主要应用涵盖发电（燃气轮机、蒸汽轮机）、航空航天（航空发动机）和工业驱动等关键行业。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-49678bb9dd21687268c5616ea6e657b4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="356" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-49678bb9dd21687268c5616ea6e657b4-e-8" label="Performance improvements">
        <attvalues>
          <attvalue for="0" value="Performance improvements" />
          <attvalue for="1" value="Requirement" />
          <attvalue for="2" value="一项旨在大幅提升航空发动机性能的硬性要求，具体应用于如 Trent 1000 和 GEnx 等先进发动机型号。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-49678bb9dd21687268c5616ea6e657b4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3580e24626fc58694eb8b9e80eb9ed69-e-1" label="Land-based turbines">
        <attvalues>
          <attvalue for="0" value="Land-based turbines" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="陆基燃气轮机是一种安装在陆地上使用的旋转式动力设备。它以热端部件为核心，在高温高压等严苛工况下，将燃料的化学能高效转化为机械功，主要用于发电厂发电或为工业设备（如压缩机）提供机械驱动。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-3580e24626fc58694eb8b9e80eb9ed69" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3580e24626fc58694eb8b9e80eb9ed69-e-4" label="Turbine blading">
        <attvalues>
          <attvalue for="0" value="Turbine blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;涡轮叶片是涡轮机的核心热端部件，负责将高温气流的能量转化为机械能以驱动转子旋转。因其工作于极端高温高压环境，通常由能承受严苛工况的高温合金等先进耐热材料制造。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-3580e24626fc58694eb8b9e80eb9ed69" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3580e24626fc58694eb8b9e80eb9ed69-e-5" label="Buckets">
        <attvalues>
          <attvalue for="0" value="Buckets" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="也称涡轮动叶或工作叶片，是安装在涡轮机转子上的关键热端部件。它在高温高压燃气驱动下高速旋转，将气流的热能和动能转化为转子的机械能，从而驱动发电机或其他设备做功。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3580e24626fc58694eb8b9e80eb9ed69" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3580e24626fc58694eb8b9e80eb9ed69-e-6" label="Single-crystal turbine blade compositions">
        <attvalues>
          <attvalue for="0" value="Single-crystal turbine blade compositions" />
          <attvalue for="1" value="Material Composition" />
          <attvalue for="2" value="一类专用于制造航空发动机高压涡轮叶片的镍基单晶高温合金的化学成分。其配方经精确设计，旨在使叶片在极端高温、高应力和腐蚀环境下，仍能保持卓越的力学性能与结构完整性，是决定发动机性能和可靠性的关键材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-3580e24626fc58694eb8b9e80eb9ed69" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3580e24626fc58694eb8b9e80eb9ed69-e-7" label="High-pressure turbine blading">
        <attvalues>
          <attvalue for="0" value="High-pressure turbine blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="高压涡轮叶片是航空发动机的关键热端部件，它将高温高压燃气的能量转化为机械功，以驱动压气机。因其工作环境极端恶劣，通常采用具有优异耐高温性能的单晶高温合金材料制造。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-3580e24626fc58694eb8b9e80eb9ed69" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-471c3b3783689510c8ddf1dbb87d4b46-e-1" label="Crystal turbine blade compositions">
        <attvalues>
          <attvalue for="0" value="Crystal turbine blade compositions" />
          <attvalue for="1" value="Material Composition" />
          <attvalue for="2" value="一种专门为航空发动机的高压涡轮叶片开发的特定材料成分。其经过优化的晶体结构，旨在承受极端高温高压的工作环境，是制造高性能、长寿命涡轮叶片的关键，其成分配比随技术发展而不断演进。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-471c3b3783689510c8ddf1dbb87d4b46" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-471c3b3783689510c8ddf1dbb87d4b46-e-2" label="High-pressure turbine blading">
        <attvalues>
          <attvalue for="0" value="High-pressure turbine blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="高压涡轮叶片是航空发动机的核心热端部件，位于高压涡轮部分，用于将高温燃气的能量转化为转子旋转的机械功。因其工作环境极为严苛，常采用为其专门开发的先进晶体材料（如单晶高温合金）制造。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-471c3b3783689510c8ddf1dbb87d4b46" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-471c3b3783689510c8ddf1dbb87d4b46-e-4" label="Figure 6.2">
        <attvalues>
          <attvalue for="0" value="Figure 6.2" />
          <attvalue for="1" value="Reference" />
          <attvalue for="2" value="图6.2是一张示意图，旨在提供晶体涡轮叶片化学成分的近似概览。它直观地展示了构成这些高温合金的关键材料，为读者理解其组成提供快速参考。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-471c3b3783689510c8ddf1dbb87d4b46" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-471c3b3783689510c8ddf1dbb87d4b46-e-5" label="Chapter 3">
        <attvalues>
          <attvalue for="0" value="Chapter 3" />
          <attvalue for="1" value="Reference" />
          <attvalue for="2" value="Chapter 3 是一个参考文献章节，其核心内容是阐述晶体涡轮叶片合金成分发生变化的根本原因。该章节为理解特定材料成分的演变和优化提供了详细的理论依据和背景解释。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-471c3b3783689510c8ddf1dbb87d4b46" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-471c3b3783689510c8ddf1dbb87d4b46-e-8" label="Alloys">
        <attvalues>
          <attvalue for="0" value="Alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种合金材料，其γ'（伽马撇）相含量被特意提高至75%，旨在获得卓越的抗蠕变性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-471c3b3783689510c8ddf1dbb87d4b46" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ece73a04275b10b6ad2874686306213a-e-7" label="Hot Corrosion">
        <attvalues>
          <attvalue for="0" value="Hot Corrosion" />
          <attvalue for="1" value="Degradation Process" />
          <attvalue for="2" value="热腐蚀是一种在高温下发生的材料加速氧化降解过程。它由沉积在材料表面的熔融盐（如硫酸盐、氯化物）引起，这些熔盐会溶解或破坏金属原有的保护性氧化膜，导致基体金属发生快速腐蚀，常见于燃气轮机、锅炉等设备。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ece73a04275b10b6ad2874686306213a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;hot corrosion&quot;, &quot;hot corrosion attack&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ece73a04275b10b6ad2874686306213a-e-7&quot;, &quot;chunk-6cc9936949c5f333eaac7910b952ef48-e-1&quot;, &quot;chunk-264495632c5fce243bda26582e560253-e-17&quot;, &quot;chunk-61a441c3ea495edfbd1f923ab25e12c9-e-4&quot;, &quot;chunk-86425bad56c0d52ed7246eff0fe06dd8-e-8&quot;, &quot;chunk-64f0b642dc984a92646a132ee856bc18-e-14&quot;, &quot;chunk-dcabec43f1f2206a87597ccc217e55d1-e-5&quot;, &quot;chunk-0625d83d7200f989528119d9ba61865a-e-11&quot;, &quot;chunk-44260d4b7de8c9a00040496e0aad271b-e-9&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-6cc9936949c5f333eaac7910b952ef48-e-3" label="Marine Environments">
        <attvalues>
          <attvalue for="0" value="Marine Environments" />
          <attvalue for="1" value="Environment" />
          <attvalue for="2" value="海洋环境是地球上咸水体（如海洋、海、咸水湾等）的统称，覆盖了超过70%的地球表面。其主要特征为高盐度、强腐蚀性和动态的水文条件，对其中的人造结构物和设备构成严峻挑战，因此需要特殊的防护技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-6cc9936949c5f333eaac7910b952ef48" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6cc9936949c5f333eaac7910b952ef48-e-5" label="Oxidation">
        <attvalues>
          <attvalue for="0" value="Oxidation" />
          <attvalue for="1" value="Degradation Process" />
          <attvalue for="2" value="氧化是一种常见的物质降解过程，指物质与氧化剂（如氧）发生的化学反应。在特定条件下，金属钛（Titanium）的存在会作为催化剂或促进剂，显著加剧该过程的反应速率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-6cc9936949c5f333eaac7910b952ef48" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2fd5876b35a11cace4a36b2cc1865696-e-2" label="first-generation single-crystal alloys">
        <attvalues>
          <attvalue for="0" value="first-generation single-crystal alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="第一代单晶合金是一种早期开发的镍基高温合金。其典型特征是通过添加钽(Ta)和钨(W)等难熔金属元素进行固溶强化，以显著提升材料在高温环境下的抗蠕变性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-2fd5876b35a11cace4a36b2cc1865696" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-2fd5876b35a11cace4a36b2cc1865696-e-5" label="creep strengthening">
        <attvalues>
          <attvalue for="0" value="creep strengthening" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="蠕变强化（Creep Strengthening）是一种提高材料在高温下抵抗缓慢塑性变形（蠕变）能力的材料属性。它通常通过固溶强化或析出强化等方式实现，例如在合金中添加钽(Ta)、钨(W)、铼(Re)等元素来阻碍位错运动，从而增强材料的高温持久性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2fd5876b35a11cace4a36b2cc1865696" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Creep strengthening&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2fd5876b35a11cace4a36b2cc1865696-e-5&quot;, &quot;chunk-22dadd8677004929f45649f589c98023-e-2&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2fd5876b35a11cace4a36b2cc1865696-e-7" label="second-generation single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="second-generation single-crystal superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="第二代单晶高温合金是一种先进材料，其标志性特征是在合金成分中添加了约3%重量的铼(Re)元素。与第一代相比，铼的加入显著提升了合金在高温下的蠕变强度和持久性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-2fd5876b35a11cace4a36b2cc1865696" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c2bce381433d364861cf87ccbd650b94-e-1" label="Second-generation single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="Second-generation single-crystal superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="第二代单晶高温合金是一种镍基高温合金，以添加约3%重量比的铼(Re)为主要特征。铼的加入显著提升了材料的蠕变强度和耐高温性能，使其成为航空发动机和燃气轮机关键热端部件的核心材料，并为第三代高温合金的发展奠定了基础。" />
          <attvalue for="3" value="{&quot;Re_content&quot;: &quot;about 3 wt%&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-c2bce381433d364861cf87ccbd650b94" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c2bce381433d364861cf87ccbd650b94-e-3" label="Third-generation superalloys">
        <attvalues>
          <attvalue for="0" value="Third-generation superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="第三代单晶高温合金是从第二代单晶高温合金发展而来的一类材料。其主要特征是显著增加了铼（Re）的含量（可达6 wt%），但也因此存在微观结构不稳定性，易于析出有害的拓扑密堆相（TCP相）。" />
          <attvalue for="3" value="{&quot;Re_content&quot;: &quot;6 wt%&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c2bce381433d364861cf87ccbd650b94" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c2bce381433d364861cf87ccbd650b94-e-4" label="Creep strengthening effect">
        <attvalues>
          <attvalue for="0" value="Creep strengthening effect" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="蠕变强化效应是一种机械效应，指通过向合金中添加铼元素，显著提高材料在高温和长期应力作用下抵抗缓慢永久变形（即蠕变）的能力。这种效应在航空发动机的镍基高温合金中尤为关键。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c2bce381433d364861cf87ccbd650b94" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;creep strengthening effect&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c2bce381433d364861cf87ccbd650b94-e-4&quot;, &quot;chunk-3d0590efade07af78fea353ef909c7ec-e-9&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c2bce381433d364861cf87ccbd650b94-e-5" label="Topologically close-packed (TCP) phases">
        <attvalues>
          <attvalue for="0" value="Topologically close-packed (TCP) phases" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="拓扑密堆相（Topologically close-packed phases）是一类具有复杂、非立方密堆晶体结构的金属间化合物，如σ相、Laves相。它们通常在高温合金（如镍基高温合金）中经长期高温暴露后以析出相形式形成。由于其硬而脆的特性，其形成常对材料性能有害，会降低合金的延展性、韧性和蠕变强度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c2bce381433d364861cf87ccbd650b94" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;TCP phases&quot;, &quot;topologically close-packed&quot;, &quot;topologically close-packed (TCP) phases&quot;, &quot;topologically close-packed phase P&quot;, &quot;topologically close-packed phases&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-023a8b25fea34ca6c8a3ebfc0f239288-e-10&quot;, &quot;chunk-1a93cf0e7220cae761fdbf08f5ce260b-e-6&quot;, &quot;chunk-c2bce381433d364861cf87ccbd650b94-e-5&quot;, &quot;chunk-98dc45a2c81a5783151664ba74c4681e-e-3&quot;, &quot;chunk-1297af8788c2be7a2a158412cd2652f3-e-16&quot;, &quot;chunk-cad1eaa9ffb0e731892120bbe3415da7-e-7&quot;, &quot;chunk-0440023a44a202881a859e66f23ec3de-e-3&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-98dc45a2c81a5783151664ba74c4681e-e-1" label="Materials heavily alloyed with Re">
        <attvalues>
          <attvalue for="0" value="Materials heavily alloyed with Re" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="指一类铼（Re）含量较高的合金。高浓度的铼会降低材料的组织稳定性，使其在特定条件下易于形成脆性的拓扑密排（TCP）相，从而影响材料性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-98dc45a2c81a5783151664ba74c4681e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-98dc45a2c81a5783151664ba74c4681e-e-6" label="Re-rich dendritic regions">
        <attvalues>
          <attvalue for="0" value="Re-rich dendritic regions" />
          <attvalue for="1" value="Microstructural Region" />
          <attvalue for="2" value="一种富含铼(Re)的枝晶状微观结构区域。该区域通常保留了铸造过程中的微观偏析，并成为拓扑密排(TCP)相等有害相优先形成和析出的位置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-98dc45a2c81a5783151664ba74c4681e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-98dc45a2c81a5783151664ba74c4681e-e-10" label="High-pressure turbine blading">
        <attvalues>
          <attvalue for="0" value="High-pressure turbine blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="高压涡轮叶片是航空发动机或燃气轮机中的关键热端部件。它在极端高温高压环境下运行，其蠕变持久寿命会因有害的拓扑密排（TCP）相析出而显著降低，这是该部件面临的核心材料挑战之一。" />
          <attvalue for="3" value="{&quot;feature&quot;: &quot;thin-walled sections&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-98dc45a2c81a5783151664ba74c4681e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-10af7aee4fb23531546db15200cbea75-e-1" label="Turbine blading">
        <attvalues>
          <attvalue for="0" value="Turbine blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮叶片是涡轮机械的关键旋转部件，用于从高速流体（如燃气或蒸汽）中提取能量并将其转化为机械功。其复杂的翼型结构中常有薄壁部分，这些部分的承载能力对于保证涡轮机的安全、可靠运行至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-10af7aee4fb23531546db15200cbea75" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="357" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-10af7aee4fb23531546db15200cbea75-e-2" label="Thin-walled sections">
        <attvalues>
          <attvalue for="0" value="Thin-walled sections" />
          <attvalue for="1" value="Component Feature" />
          <attvalue for="2" value="指涡轮叶片上因材料不稳定性（如TCP相的形成）而导致有效承载截面积减小的特定区域。它是一种部件特征，会削弱叶片的结构强度和承载能力，影响其服役性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-10af7aee4fb23531546db15200cbea75" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-10af7aee4fb23531546db15200cbea75-e-3" label="TCP formation">
        <attvalues>
          <attvalue for="0" value="TCP formation" />
          <attvalue for="1" value="Metallurgical Phenomenon" />
          <attvalue for="2" value="TCP相形成（Topologically Close-Packed phase formation）是一种冶金学中的微观组织不稳定性现象。它指在特定条件下析出硬而脆的TCP相，从而破坏基体、显著降低材料（尤其在薄壁构件中）的有效承载面积。添加钌（Ru）等合金元素可以有效抑制其形成，降低材料对此现象的敏感性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-10af7aee4fb23531546db15200cbea75" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-10af7aee4fb23531546db15200cbea75-e-3&quot;, &quot;chunk-480d57aecb221d6739d918eba055fa57-e-8&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-10af7aee4fb23531546db15200cbea75-e-4" label="Ru">
        <attvalues>
          <attvalue for="0" value="Ru" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="Ruthenium, an element added to fourth-generation superalloys that reduces susceptibility to TCP formation." />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-10af7aee4fb23531546db15200cbea75" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-10af7aee4fb23531546db15200cbea75-e-5" label="Fourth-generation superalloys">
        <attvalues>
          <attvalue for="0" value="Fourth-generation superalloys" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="第四代高温合金是进入21世纪后开发的一类先进高温合金。其标志性特征是在成分中添加了钌（Ru）元素，并且其铼（Re）含量相较于第三代合金有所降低，以此获得更优异的综合性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-10af7aee4fb23531546db15200cbea75" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-10af7aee4fb23531546db15200cbea75-e-7" label="Third-generation alloys">
        <attvalues>
          <attvalue for="0" value="Third-generation alloys" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="第三代高温合金是一类以高铼(Re)含量（约6%）为特征的镍基单晶高温合金。其铼含量高于第四代合金，这赋予了材料优异的高温蠕变强度，使其成为制造先进航空发动机涡轮叶片等关键热端部件的核心材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-10af7aee4fb23531546db15200cbea75" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-480d57aecb221d6739d918eba055fa57-e-1" label="fourth-generation alloys">
        <attvalues>
          <attvalue for="0" value="fourth-generation alloys" />
          <attvalue for="1" value="Alloy Generation" />
          <attvalue for="2" value="第四代合金 (Fourth-generation alloys) 是一类以同时添加钌(Ru)和铼(Re)为特征的单晶高温合金。与第三代合金相比，其铼(Re)含量较低，旨在优化性能与成本。" />
          <attvalue for="3" value="{&quot;Re concentration&quot;: &quot;4.5 wt%&quot;, &quot;Ru concentration&quot;: &quot;4.0 wt%&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-480d57aecb221d6739d918eba055fa57" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-480d57aecb221d6739d918eba055fa57-e-4" label="Platinum-diffused diffusion coating">
        <attvalues>
          <attvalue for="0" value="Platinum-diffused diffusion coating" />
          <attvalue for="1" value="Alloy Generation" />
          <attvalue for="2" value="第三代合金是一个合金代别，其铼（Re）含量被用作衡量第四代合金的基准。与第四代合金相比，第三代合金拥有更高的铼含量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-480d57aecb221d6739d918eba055fa57" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;third-generation alloys&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-480d57aecb221d6739d918eba055fa57-e-4&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-480d57aecb221d6739d918eba055fa57-e-5" label="platinum-diffused diffusion coatings">
        <attvalues>
          <attvalue for="0" value="platinum-diffused diffusion coatings" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="铂扩散渗层是一种用作铝化物涂层替代品的扩散涂层。其主要优点在于不易产生二次反应区（SRZ）效应，从而提高耐久性；但它无法阻止拓扑密排相（TCP）的形成，这可能影响其高温性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-480d57aecb221d6739d918eba055fa57" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-480d57aecb221d6739d918eba055fa57-e-7" label="SRZ effect">
        <attvalues>
          <attvalue for="0" value="SRZ effect" />
          <attvalue for="1" value="Metallurgical Phenomenon" />
          <attvalue for="2" value="SRZ效应，或称“二次反应区”效应，是一种在高温合金扩散涂层中发生的不良冶金现象，会导致涂层性能退化和寿命降低。与传统铝化物涂层相比，铂扩散涂层能够有效抑制该反应区的形成，因此不易受此现象影响，稳定性更高。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-480d57aecb221d6739d918eba055fa57" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-480d57aecb221d6739d918eba055fa57-e-7&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3840a842bb1a54d4d273056bed0dac49-e-1" label="Fourth-generation single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="Fourth-generation single-crystal superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="第四代单晶高温合金是一类以添加铼(Re)和钌(Ru)为特征的先进材料。它在燃气涡轮发动机领域具有巨大应用潜力，旨在显著提升工作温度和效率。然而，由于其高昂的成本和高密度等因素的制约，该类合金目前尚未投入规模化的实际应用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-3840a842bb1a54d4d273056bed0dac49" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-3840a842bb1a54d4d273056bed0dac49-e-3" label="Cost">
        <attvalues>
          <attvalue for="0" value="Cost" />
          <attvalue for="1" value="Economic Factor" />
          <attvalue for="2" value="成本是一种关键经济因素，指生产或研发所需付出的货币代价。在新型高温合金（如第四、五代单晶高温合金）的设计中，它是一个必须与性能、可靠性等目标进行权衡的核心制约条件，直接影响最终产品的商业可行性与市场竞争力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-3840a842bb1a54d4d273056bed0dac49" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Costs&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3840a842bb1a54d4d273056bed0dac49-e-3&quot;, &quot;chunk-ab0efb3d9b926e2af6dcfa9258a58f78-e-8&quot;, &quot;chunk-0f24474e96c9ef42ab24560f2ccf918e-e-15&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-3840a842bb1a54d4d273056bed0dac49-e-4" label="Density">
        <attvalues>
          <attvalue for="0" value="Density" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="密度（Density）是一项关键的材料物理属性。在燃气轮机高温合金中，它与叶根载荷成正比并加剧轮盘应力，因此是一项需要被严格限制的指标。在第四、五代单晶高温合金等先进材料的设计中，必须在降低密度的同时，平衡其与其它关键性能的关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-3840a842bb1a54d4d273056bed0dac49" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3840a842bb1a54d4d273056bed0dac49-e-4&quot;, &quot;chunk-ab0efb3d9b926e2af6dcfa9258a58f78-e-1&quot;, &quot;chunk-78865a21d21766b0dd173d92dcbbfc0d-e-8&quot;, &quot;chunk-d2428cb3e80954cab38bfce19b363f27-e-11&quot;, &quot;chunk-e169602f8c36042ddef4827a52729f2a-e-9&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-3840a842bb1a54d4d273056bed0dac49-e-5" label="Creep rupture life">
        <attvalues>
          <attvalue for="0" value="Creep rupture life" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="蠕变断裂寿命指材料在特定高温和恒定应力作用下，从承受载荷到发生断裂所能持续的时间。它是一项关键的材料力学性能指标，用于衡量材料（尤其是高温合金）在高温环境下长期承载的可靠性和稳定性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3840a842bb1a54d4d273056bed0dac49" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3840a842bb1a54d4d273056bed0dac49-e-5&quot;, &quot;chunk-870742dec10263e0078e94a0b6a827aa-e-8&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1d0418c28a59c280072dbd96eeaaa524-e-1" label="Latest generation superalloys">
        <attvalues>
          <attvalue for="0" value="Latest generation superalloys" />
          <attvalue for="1" value="Alloy Category" />
          <attvalue for="2" value="最新一代高温合金是一类以添加大量铼(Re)和钌(Ru)为特征的先进材料。它们具有优异的抗蠕变性，但也伴随着高密度和高昂成本。与第三代高温合金相比，其铼含量有所降低，旨在优化性能与成本的平衡。" />
          <attvalue for="3" value="{&quot;density&quot;: &quot;approaching, or even exceeding, 9 g/cm³&quot;, &quot;cost&quot;: &quot;about five times that of the first-generation alloys&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-1d0418c28a59c280072dbd96eeaaa524" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-1d0418c28a59c280072dbd96eeaaa524-e-4" label="First-generation alloys">
        <attvalues>
          <attvalue for="0" value="First-generation alloys" />
          <attvalue for="1" value="Material Classification" />
          <attvalue for="2" value="第一代合金（First-generation alloy）是高温合金的一种早期材料分类，代表了该领域技术发展的初始阶段。这类合金为后续更高性能合金的研发奠定了基础，其典型代表为SRR99。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1d0418c28a59c280072dbd96eeaaa524" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;First-generation alloy&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d60cc087d5f03ae6059fa8890a861a5b-e-8&quot;, &quot;chunk-1d0418c28a59c280072dbd96eeaaa524-e-4&quot;, &quot;chunk-7fe022ba8cc7632d553ef231b0a1a4ea-e-8&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1d0418c28a59c280072dbd96eeaaa524-e-5" label="Third-generation superalloys">
        <attvalues>
          <attvalue for="0" value="Third-generation superalloys" />
          <attvalue for="1" value="Alloy Category" />
          <attvalue for="2" value="第三代高温合金是以重度铼（Re）合金化为关键特征的一代高温合金。与最新的高温合金相比，其铼含量更高，这赋予了合金优异的高温力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1d0418c28a59c280072dbd96eeaaa524" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ab0efb3d9b926e2af6dcfa9258a58f78-e-2" label="Loading at the blade root">
        <attvalues>
          <attvalue for="0" value="Loading at the blade root" />
          <attvalue for="1" value="Mechanical Force" />
          <attvalue for="2" value="作用于燃气轮机叶片根部的机械力，主要源于叶片自身质量在高速旋转下产生的离心力。该载荷的大小与叶片材料的密度成线性正比关系，是决定叶片结构强度和使用寿命的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-ab0efb3d9b926e2af6dcfa9258a58f78" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ab0efb3d9b926e2af6dcfa9258a58f78-e-3" label="Stresses imparted on the disc rim">
        <attvalues>
          <attvalue for="0" value="Stresses imparted on the disc rim" />
          <attvalue for="1" value="Mechanical Stress" />
          <attvalue for="2" value="指燃气涡轮发动机中，因高速旋转产生的离心力作用在盘缘上的机械应力。由于离心力与质量直接相关，因此该应力会随着部件材料密度的增加而增强。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-ab0efb3d9b926e2af6dcfa9258a58f78" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ab0efb3d9b926e2af6dcfa9258a58f78-e-4" label="Fourth-generation single-crystal superalloy">
        <attvalues>
          <attvalue for="0" value="Fourth-generation single-crystal superalloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="第四代单晶高温合金是一种专为未来燃气涡轮发动机应用而开发的先进材料。其核心设计目标是在高温蠕变性能、材料密度与制造成本等关键属性之间实现综合平衡，以满足新一代发动机对材料整体性能的严苛要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-ab0efb3d9b926e2af6dcfa9258a58f78" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-ab0efb3d9b926e2af6dcfa9258a58f78-e-5" label="Fifth-generation single-crystal superalloy">
        <attvalues>
          <attvalue for="0" value="Fifth-generation single-crystal superalloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="第五代单晶高温合金是面向未来燃气涡轮发动机的新一代先进材料。其研发关键在于综合平衡材料的蠕变性能、密度与成本等核心指标，以满足严苛的应用需求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ab0efb3d9b926e2af6dcfa9258a58f78" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-e7b8406b8d85a1255a692ddd5452a482-e-1" label="superalloys">
        <attvalues>
          <attvalue for="0" value="superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="高温合金（Superalloys）是一类专为高温严酷环境设计的高性能金属材料。它们具备卓越的抗蠕变、抗疲劳和抗氧化性能，是制造航空发动机及燃气轮机涡轮叶片等关键热端部件的理想材料，同时要求具有良好的涂层兼容性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-e7b8406b8d85a1255a692ddd5452a482" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-e7b8406b8d85a1255a692ddd5452a482-e-2" label="turbine blade applications">
        <attvalues>
          <attvalue for="0" value="turbine blade applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="指将具有优异高温强度和抗腐蚀性的高温合金，用于制造航空发动机、燃气轮机等设备中涡轮叶片的特定工程应用。这些叶片是承受极端温度和应力的核心部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-e7b8406b8d85a1255a692ddd5452a482" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e7b8406b8d85a1255a692ddd5452a482-e-6" label="coating compatibility">
        <attvalues>
          <attvalue for="0" value="coating compatibility" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="涂层相容性是一种材料属性，指基体材料与表面涂层在物理、化学及力学性能上的相互匹配程度。作为现代单晶高温合金等涡轮叶片材料的一项关键要求，它确保涂层能与基体稳定结合，在高温等苛刻环境下长期有效地发挥保护作用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e7b8406b8d85a1255a692ddd5452a482" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e7b8406b8d85a1255a692ddd5452a482-e-6&quot;, &quot;chunk-b821a94296e5e31338263fc084ea39d5-e-7&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e7b8406b8d85a1255a692ddd5452a482-e-10" label="nickel">
        <attvalues>
          <attvalue for="0" value="nickel" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍是一种化学元素。在材料科学领域，其熔点是决定单晶高温合金最高工作温度的根本限制，成为提升该类合金性能的关键瓶颈。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-e7b8406b8d85a1255a692ddd5452a482" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-19fc204ae20f257516bfb4e63a049a77-e-2" label="nickel">
        <attvalues>
          <attvalue for="0" value="nickel" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍（Ni）是一种金属元素，常作为单晶高温合金的关键基体材料。其自身的熔点（约1455°C）从根本上制约了镍基高温合金的最高服役温度，是决定该类材料耐热性能的天然上限。" />
          <attvalue for="3" value="{&quot;property&quot;: &quot;melting temperature&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-19fc204ae20f257516bfb4e63a049a77" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-19fc204ae20f257516bfb4e63a049a77-e-3" label="thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="thermal barrier coatings" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="热障涂层 (TBCs) 是一种先进的陶瓷涂层系统，常用于燃气轮机的高压叶片等高温部件表面。它作为热屏障保护金属基体，使其能在更高温度下工作，从而提升发动机的性能、效率与耐久性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-19fc204ae20f257516bfb4e63a049a77" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-19fc204ae20f257516bfb4e63a049a77-e-4" label="high-pressure blading">
        <attvalues>
          <attvalue for="0" value="high-pressure blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="高压叶片（high-pressure blading）是燃气轮机热端部分的核心部件，包含高压级的动叶与静叶。它在燃烧室后的高温高压气流中工作，直接将燃气热能转化为机械功，因此需要热障涂层保护，以提高发动机的耐温极限与运行效率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-19fc204ae20f257516bfb4e63a049a77" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-19fc204ae20f257516bfb4e63a049a77-e-5" label="aerofoils">
        <attvalues>
          <attvalue for="0" value="aerofoils" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="翼型是机翼或涡轮叶片等部件的横截面轮廓，用于产生空气动力。在燃气轮机等高温应用中，它特指一种利用内部通道引入冷却空气的关键组件，以承受极端工作温度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-19fc204ae20f257516bfb4e63a049a77" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="223" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-19fc204ae20f257516bfb4e63a049a77-e-6" label="cooling air">
        <attvalues>
          <attvalue for="0" value="cooling air" />
          <attvalue for="1" value="Medium" />
          <attvalue for="2" value="一种用作冷却剂的气体介质，特指用于冷却翼型（如航空发动机涡轮叶片）的空气。它通过流过翼型表面或内部通道，以对流换热的方式带走热量，从而控制翼型温度，确保其在高温工况下的结构完整性和性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-19fc204ae20f257516bfb4e63a049a77" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="223" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-355e3199ba9477d489a169627728bb4e-e-2" label="TBCs">
        <attvalues>
          <attvalue for="0" value="TBCs" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="热障涂层（TBCs）是一种先进的材料涂层，通常涂覆于高温合金叶片等基体表面。它凭借其低热导率特性提供隔热保护，并具有优异的抗烧结能力，能显著提升核心部件在极端高温环境下的稳定性和服役寿命。" />
          <attvalue for="3" value="{&quot;property&quot;: &quot;lower-conductivity&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-355e3199ba9477d489a169627728bb4e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-355e3199ba9477d489a169627728bb4e-e-3" label="Sintering">
        <attvalues>
          <attvalue for="0" value="Sintering" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="烧结是一种物理过程，指粉末或多孔材料在高温下（低于熔点）发生颗粒间黏结和致密化的现象。在热障涂层(TBCs)领域，烧结是一种劣化机制，它会降低涂层的孔隙率，从而削弱其隔热性能并增加热应力，是新型涂层需要着重抵抗的失效模式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-355e3199ba9477d489a169627728bb4e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-355e3199ba9477d489a169627728bb4e-e-4" label="Superalloy blading">
        <attvalues>
          <attvalue for="0" value="Superalloy blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;高温合金叶片是一种关键部件，作为热障涂层(TBC)的承载基体。它必须在整个服役寿命中为涂层提供稳定支撑，以防止其发生剥落。因此，优化叶片与涂层间的界面效应对确保系统整体性能至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-355e3199ba9477d489a169627728bb4e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-355e3199ba9477d489a169627728bb4e-e-6" label="Interfacial effects">
        <attvalues>
          <attvalue for="0" value="Interfacial effects" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="界面效应 (Interfacial effects) 是一种发生在两相接触界面处的物理化学现象。这些现象通过影响界面原子间的相互作用，成为决定和控制材料（如热障涂层TBC）附着性能的关键因素，是材料科学领域的核心关注点。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-355e3199ba9477d489a169627728bb4e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-355e3199ba9477d489a169627728bb4e-e-6&quot;, &quot;chunk-b2f60881d2d2c1c21716ac938726a812-e-1&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-355e3199ba9477d489a169627728bb4e-e-7" label="TBC development">
        <attvalues>
          <attvalue for="0" value="TBC development" />
          <attvalue for="1" value="Activity" />
          <attvalue for="2" value="TBC开发是一项以商业化为导向的活动，指研发和创造新型TBC的过程。该过程旨在通过技术创新推出更具市场竞争力的产品，其具体目标通常包括降低制造成本以提升商业可行性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-355e3199ba9477d489a169627728bb4e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="224" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-355e3199ba9477d489a169627728bb4e-e-8" label="Reduced manufacturing costs">
        <attvalues>
          <attvalue for="0" value="Reduced manufacturing costs" />
          <attvalue for="1" value="Goal" />
          <attvalue for="2" value="在热障涂层（TBC）开发中，降低制造成本是一项商业目标，旨在通过减少生产支出，来增强产品的经济可行性与市场竞争力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-355e3199ba9477d489a169627728bb4e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="224" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b2f60881d2d2c1c21716ac938726a812-e-2" label="TBC adhesion">
        <attvalues>
          <attvalue for="0" value="TBC adhesion" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="TBC附着力是一种材料属性，指热障涂层（TBC）与其附着的基体（如叶片）之间的结合强度。该属性决定了涂层抵抗剥落（Spallation）的能力，是评估涂层可靠性的关键指标。通过优化基体的曲率半径等几何设计，可以有效增强涂层的附着力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-b2f60881d2d2c1c21716ac938726a812" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;TBC adherence&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a6f8ce7a7c55e9b6f962543810b6ee71-e-10&quot;, &quot;chunk-b2f60881d2d2c1c21716ac938726a812-e-2&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-b2f60881d2d2c1c21716ac938726a812-e-3" label="Service life">
        <attvalues>
          <attvalue for="0" value="Service life" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="指产品、系统或部件在规定的使用条件下，能维持其预定功能、性能和可靠性的总运行时长或工作循环次数。它是一个衡量其耐用性和经济性的关键技术参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-b2f60881d2d2c1c21716ac938726a812" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b2f60881d2d2c1c21716ac938726a812-e-4" label="Superalloy substrates">
        <attvalues>
          <attvalue for="0" value="Superalloy substrates" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种用作热障涂层（TBC）基底的高性能合金材料。其自身的物理和化学性质，如热膨胀系数和抗氧化性，是决定涂层附着强度与抗剥落寿命的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-b2f60881d2d2c1c21716ac938726a812" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="68" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b2f60881d2d2c1c21716ac938726a812-e-5" label="TBC spallation lives">
        <attvalues>
          <attvalue for="0" value="TBC spallation lives" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="TBC剥落寿命指热障涂层（TBC）因发生剥落而失效前的服役时间。作为衡量涂层耐久性的关键性能指标，它主要受高温合金基底、粘结层、陶瓷面层以及制备工艺等因素的综合影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-b2f60881d2d2c1c21716ac938726a812" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="68" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-b2f60881d2d2c1c21716ac938726a812-e-6" label="Bond coat">
        <attvalues>
          <attvalue for="0" value="Bond coat" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;粘结涂层是热障涂层（TBC）系统中的关键金属中间层，位于基体与陶瓷顶涂层之间。其主要功能是增强二者的结合力，并保护基体免受高温氧化，是决定热障涂层剥落寿命的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-b2f60881d2d2c1c21716ac938726a812" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="68" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b2f60881d2d2c1c21716ac938726a812-e-7" label="Top coat">
        <attvalues>
          <attvalue for="0" value="Top coat" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="Top coat是热障涂层（TBC）系统的关键组成部分，通常指其最外层的陶瓷隔热层。它直接暴露于高温环境中，主要作用是提供隔热以保护金属基材。其材料、结构与性能是决定热障涂层抗剥落能力和整体服役寿命的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-b2f60881d2d2c1c21716ac938726a812" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="68" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b2f60881d2d2c1c21716ac938726a812-e-8" label="Processing condition">
        <attvalues>
          <attvalue for="0" value="Processing condition" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="在热障涂层（TBC）制备过程中，一组可被精确控制并保持恒定的制造工艺参数。这些参数的设定与稳定性，是影响并决定热障涂层最终剥落寿命和服役性能的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-b2f60881d2d2c1c21716ac938726a812" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="68" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b2f60881d2d2c1c21716ac938726a812-e-9" label="Turbine blade applications">
        <attvalues>
          <attvalue for="0" value="Turbine blade applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="标准化描述：&#10;指将涡轮叶片作为核心部件，把流体的动能或热能转化为旋转机械功的具体技术领域。其应用主要涵盖能源发电（燃气、蒸汽、风力轮机）、航空航天推进（喷气发动机）以及工业驱动等关键行业。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-b2f60881d2d2c1c21716ac938726a812" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="358" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-533ad7cdb770d7bc31f971d5ee333007-e-1" label="TBC spallation lives">
        <attvalues>
          <attvalue for="0" value="TBC spallation lives" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="指热障涂层（TBC）发生剥落失效前的使用寿命。该现象的特点是寿命数据具有显著分散性，其长短受到涂层所附着的基体材料等多种因素的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-533ad7cdb770d7bc31f971d5ee333007" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="225" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-533ad7cdb770d7bc31f971d5ee333007-e-2" label="bond coat">
        <attvalues>
          <attvalue for="0" value="bond coat" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="粘结层（bond coat）是热障涂层系统中的关键金属涂层，位于基体（如涡轮叶片）与陶瓷面层之间。其主要作用是增强面层与基体的结合力，并为基体提供高温抗氧化保护，其性能与设计需与体系内其他部件紧密集成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-533ad7cdb770d7bc31f971d5ee333007" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="121" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-533ad7cdb770d7bc31f971d5ee333007-e-3" label="ceramic top coat">
        <attvalues>
          <attvalue for="0" value="ceramic top coat" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="作为热障涂层（TBC）系统的最外层陶瓷层，常简称为“顶涂层”。它主要应用于涡轮叶片等高温部件，起核心隔热作用。其设计必须与下方的粘合层以及它所保护的部件（如涡轮叶片）进行一体化考量，以确保整个系统的稳定性和性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-533ad7cdb770d7bc31f971d5ee333007" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="121" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-533ad7cdb770d7bc31f971d5ee333007-e-4" label="substrate">
        <attvalues>
          <attvalue for="0" value="substrate" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种承载热障涂层（TBC）的底层部件材料。它的化学成分和物理特性是影响涂层附着性能，并最终决定TBC抗剥落寿命的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-533ad7cdb770d7bc31f971d5ee333007" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="225" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-533ad7cdb770d7bc31f971d5ee333007-e-6" label="uncoated alloy">
        <attvalues>
          <attvalue for="0" value="uncoated alloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种未经过表面涂层处理的合金材料。它通常作为涂层系统的基体，或作为基准对照物，用于评估涂层在改善材料性能（如抗氧化性）方面的效果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-533ad7cdb770d7bc31f971d5ee333007" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-533ad7cdb770d7bc31f971d5ee333007-e-7" label="TBC system">
        <attvalues>
          <attvalue for="0" value="TBC system" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="TBC系统是一种多组分涂层系统，其附着能力是关键性能指标。该系统的附着性能与其抗氧化性之间缺乏相关性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-533ad7cdb770d7bc31f971d5ee333007" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-533ad7cdb770d7bc31f971d5ee333007-e-8" label="turbine blading">
        <attvalues>
          <attvalue for="0" value="turbine blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮叶片（Turbine Blading）是涡轮发动机中的核心旋转部件，通常作为基体。其设计必须与粘合涂层（bond coat）和陶瓷顶涂层（ceramic top coat）进行一体化考量，三者共同构成一个完整的热障涂层系统，以保护叶片在高温环境下正常工作。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-533ad7cdb770d7bc31f971d5ee333007" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="121" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d973f1814c5a9a7309e3cc231f4b4d07-e-1" label="Turbine blading">
        <attvalues>
          <attvalue for="0" value="Turbine blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮叶片是涡轮机的核心部件，由一系列翼型叶片构成，其功能是将高速流体（如燃气、蒸汽）的能量转化为旋转动力。作为高度集成的组件，其设计和性能与整个系统紧密相关，因此必须采用系统性方法进行开发，而不能孤立进行。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-d973f1814c5a9a7309e3cc231f4b4d07" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="88" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d973f1814c5a9a7309e3cc231f4b4d07-e-2" label="Bond coat">
        <attvalues>
          <attvalue for="0" value="Bond coat" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="Bond coat是一种组件，由于其功能与系统其他部分高度关联，因此不能被孤立设计，必须采用系统化的方法进行整体考量与开发。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-d973f1814c5a9a7309e3cc231f4b4d07" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="88" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d973f1814c5a9a7309e3cc231f4b4d07-e-3" label="Ceramic top coat">
        <attvalues>
          <attvalue for="0" value="Ceramic top coat" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种作为复杂系统一部分的陶瓷涂层组件。其设计和性能与整个系统高度耦合，无法被孤立地进行，必须采用基于系统的方法进行综合开发、集成与评估。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d973f1814c5a9a7309e3cc231f4b4d07" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="88" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d973f1814c5a9a7309e3cc231f4b4d07-e-4" label="Systems-based approach">
        <attvalues>
          <attvalue for="0" value="Systems-based approach" />
          <attvalue for="1" value="Design Methodology" />
          <attvalue for="2" value="一种整体性的设计方法论，将系统的各个组成部分（如涡轮叶片与涂层）视为一个相互关联的集成整体进行分析与设计，而非孤立对待。它旨在通过理解组件间的相互作用来优化系统总性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d973f1814c5a9a7309e3cc231f4b4d07" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="88" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-b821a94296e5e31338263fc084ea39d5-e-3" label="low density">
        <attvalues>
          <attvalue for="0" value="low density" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="低密度是一种关键的材料物理属性，指物质单位体积的质量较低。在航空航天领域，它是现代涡轮叶片所用单晶高温合金的核心性能要求，对于减轻部件重量、提高发动机推重比至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-b821a94296e5e31338263fc084ea39d5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b821a94296e5e31338263fc084ea39d5-e-3&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b821a94296e5e31338263fc084ea39d5-e-4" label="stability with respect to TCP formation">
        <attvalues>
          <attvalue for="0" value="stability with respect to TCP formation" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种关键材料性能，指单晶高温合金等材料在高温长期服役中，抵抗有害、脆性的拓扑密排（TCP）相析出的能力。由于TCP相会严重损害材料的力学性能，因此该稳定性是确保涡轮叶片等关键热端部件可靠性的核心指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-b821a94296e5e31338263fc084ea39d5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b821a94296e5e31338263fc084ea39d5-e-4&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b821a94296e5e31338263fc084ea39d5-e-6" label="corrosion resistance">
        <attvalues>
          <attvalue for="0" value="corrosion resistance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="指材料在特定工作环境中，抵抗因与环境发生化学或电化学反应而引起的破坏或性能退化的能力。这种材料属性对于确保部件在腐蚀性介质（如高温气体、液体）中的可靠性和使用寿命至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-b821a94296e5e31338263fc084ea39d5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Corrosion resistance&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b821a94296e5e31338263fc084ea39d5-e-6&quot;, &quot;chunk-78865a21d21766b0dd173d92dcbbfc0d-e-9&quot;, &quot;chunk-d59969b39f742308167ec01469929e5b-e-8&quot;, &quot;chunk-fbbf41abcd4950c59415caeec768db40-e-14&quot;, &quot;chunk-5d942c8f1c01db54bab51b31faea4836-e-3&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b821a94296e5e31338263fc084ea39d5-e-8" label="castability">
        <attvalues>
          <attvalue for="0" value="castability" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="可铸造性是一项关键的制造性能，指熔融金属（特别是高温合金）填充模具以形成完整、无缺陷铸件的综合能力。该性能对制造如燃气轮机叶片等大型复杂部件至关重要，良好的可铸造性可有效防止产生气孔、裂纹等缺陷，确保最终产品质量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-b821a94296e5e31338263fc084ea39d5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b821a94296e5e31338263fc084ea39d5-e-8&quot;, &quot;chunk-d59969b39f742308167ec01469929e5b-e-10&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b821a94296e5e31338263fc084ea39d5-e-9" label="low cost">
        <attvalues>
          <attvalue for="0" value="low cost" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="指对材料经济成本的性能要求。近年来，该属性已成为涡轮叶片所用先进材料（如单晶高温合金）的一项日益关键的指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-b821a94296e5e31338263fc084ea39d5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b821a94296e5e31338263fc084ea39d5-e-10" label="low/high temperature creep resistance">
        <attvalues>
          <attvalue for="0" value="low/high temperature creep resistance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="指材料在持续应力和特定温度（尤其是高温）作用下，抵抗发生缓慢、永久性塑性变形（蠕变）的性能。它是确保如单晶高温合金涡轮叶片等高温承力部件，在服役期间保持尺寸稳定性和结构完整性的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-b821a94296e5e31338263fc084ea39d5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b821a94296e5e31338263fc084ea39d5-e-10&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-78865a21d21766b0dd173d92dcbbfc0d-e-1" label="alloying element">
        <attvalues>
          <attvalue for="0" value="alloying element" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="**合金元素 (Alloying elements)**&#10;&#10;作为一种关键的材料组分，指为改善基体金属的性能而人为添加的化学元素。在镍基高温合金中，通常包含十余种合金元素，它们能显著提升材料的高温强度、抗蠕变和抗氧化性能，是形成超级合金优异特性的基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-78865a21d21766b0dd173d92dcbbfc0d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Alloying element&quot;, &quot;Alloying elements&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-78865a21d21766b0dd173d92dcbbfc0d-e-1&quot;, &quot;chunk-61a441c3ea495edfbd1f923ab25e12c9-e-16&quot;, &quot;chunk-2f922c93a3f1955e166d2270226ee05e-e-2&quot;, &quot;chunk-1522e93c065590bf976748cff2b67e57-e-9&quot;, &quot;chunk-466225ab73e7ea49ac0af36e5725c4c1-e-9&quot;, &quot;chunk-323f9e8ea85610f0279e242666644995-e-8&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-78865a21d21766b0dd173d92dcbbfc0d-e-2" label="Ru">
        <attvalues>
          <attvalue for="0" value="Ru" />
          <attvalue for="1" value="Alloying Element" />
          <attvalue for="2" value="钌（Ru），一种贵金属合金元素，常用于改善材料的稳定性。虽然它能有效提升性能，但因其本身稀有且价格昂贵，会显著增加合金的制造成本。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-78865a21d21766b0dd173d92dcbbfc0d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-78865a21d21766b0dd173d92dcbbfc0d-e-4" label="Cr">
        <attvalues>
          <attvalue for="0" value="Cr" />
          <attvalue for="1" value="Alloying Element" />
          <attvalue for="2" value="铬（Cr）是一种关键的合金元素，能有效提升材料的耐腐蚀性，但也会在一定程度上降低材料的组织稳定性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-78865a21d21766b0dd173d92dcbbfc0d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-78865a21d21766b0dd173d92dcbbfc0d-e-5" label="Stability">
        <attvalues>
          <attvalue for="0" value="Stability" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="稳定性是一种材料属性，其性能会受到合金元素的影响。例如，添加钌(Ru)可以提升其稳定性，而铬(Cr)则会使其性能劣化或降低。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-78865a21d21766b0dd173d92dcbbfc0d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-78865a21d21766b0dd173d92dcbbfc0d-e-5&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-78865a21d21766b0dd173d92dcbbfc0d-e-6" label="Cost">
        <attvalues>
          <attvalue for="0" value="Cost" />
          <attvalue for="1" value="Economic Property" />
          <attvalue for="2" value="一种经济属性，指在特定经济活动或生产过程中，因添加或增加要素“Ru”而上升的资源消耗、支出或代价。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-78865a21d21766b0dd173d92dcbbfc0d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29-e-1" label="Turbine disc applications">
        <attvalues>
          <attvalue for="0" value="Turbine disc applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="指作为燃气轮机核心承力部件的涡轮盘，在航空发动机、发电、工业驱动等领域的具体工程用途。这些应用以高温、高转速和高应力为特征，对材料性能和制造工艺有极高要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="359" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29-e-2" label="Walston">
        <attvalues>
          <attvalue for="0" value="Walston" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="Walston是一位研究人员，他通过分析超合金的“设计空间”（design space），阐明了因其高度拥挤而导致的研发挑战与困难。他的相关论证和发现通常以图表（如图6.5）的形式进行可视化说明。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29-e-3" label="Figure 6.5">
        <attvalues>
          <attvalue for="0" value="Figure 6.5" />
          <attvalue for="1" value="Figure" />
          <attvalue for="2" value="图6.5是Walston著作中的一张示意图，它通过图解的方式，直观阐释了高温合金在广阔“设计空间”中所面临的复杂性与挑战。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29-e-4" label="'design space'">
        <attvalues>
          <attvalue for="0" value="'design space'" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="设计空间 (design space) 是一个概念性框架，它界定了开发新一代单晶高温合金时所有可行的参数组合与性能边界。这个框架为涡轮设计师在材料创新与选择上提供了理论依据和可行范围，直接影响其设计决策。" />
          <attvalue for="3" value="{&quot;state&quot;: &quot;increasingly 'crowded'&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29-e-5" label="next-generation single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="next-generation single-crystal superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="下一代单晶高温合金是为满足更高温度、更苛刻工况而开发的高性能材料。它通过消除晶界，获得了卓越的高温强度、抗蠕变和抗疲劳性能，是航空发动机及燃气轮机核心热端部件（如涡轮叶片）的关键材料。目前其成分优化的“设计空间”已近极限，进一步提升性能面临挑战。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d59969b39f742308167ec01469929e5b-e-1" label="'one-size-fits-all' composition">
        <attvalues>
          <attvalue for="0" value="'one-size-fits-all' composition" />
          <attvalue for="1" value="Material Composition" />
          <attvalue for="2" value="一种假想的、旨在普遍适用于所有涡轮发动机的单一材料成分。由于不同发动机及部件的运行条件（如温度、压力）差异巨大，这种“一刀切”的理念在现实中无法实现，因此该成分实际上并不适用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-d59969b39f742308167ec01469929e5b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="226" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d59969b39f742308167ec01469929e5b-e-2" label="turbine engines">
        <attvalues>
          <attvalue for="0" value="turbine engines" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="一种通过旋转叶轮（涡轮）从连续流动的高温燃气中提取能量的内燃式动力机械。因其功率大、重量轻、结构紧凑，被广泛用作飞机、发电机组及大型舰船的动力装置，其严苛工况对材料性能有极高要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-d59969b39f742308167ec01469929e5b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="226" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d59969b39f742308167ec01469929e5b-e-3" label="tailored compositions">
        <attvalues>
          <attvalue for="0" value="tailored compositions" />
          <attvalue for="1" value="Material Composition" />
          <attvalue for="2" value="一种为满足特定应用需求而专门设计的材料组分。与通用型材料不同，其成分和配比经过精确优化，旨在特定场景下实现最佳性能，而非提供普适性解决方案。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d59969b39f742308167ec01469929e5b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="227" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d59969b39f742308167ec01469929e5b-e-4" label="different applications">
        <attvalues>
          <attvalue for="0" value="different applications" />
          <attvalue for="1" value="Application Category" />
          <attvalue for="2" value="一个涵盖多种特定用途的应用类别。针对每一种应用场景，都会有为其专门设计的定制化组合物，以满足该场景下独特的功能或性能要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d59969b39f742308167ec01469929e5b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="227" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d59969b39f742308167ec01469929e5b-e-5" label="Metallurgist">
        <attvalues>
          <attvalue for="0" value="Metallurgist" />
          <attvalue for="1" value="Role" />
          <attvalue for="2" value="冶金专家（Metallurgist）是研究金属与合金特性并进行材料开发的专业人员。他们负责设计和优化合金成分以满足特定应用需求，例如为工业燃气轮机等设备开发高性能的高温合金。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d59969b39f742308167ec01469929e5b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Metallurgists&quot;, &quot;metallurgist&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ba75e6448ea6f9f49ca3935b800555ba-e-5&quot;, &quot;chunk-d59969b39f742308167ec01469929e5b-e-5&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d59969b39f742308167ec01469929e5b-e-6" label="superalloy composition for an IGT">
        <attvalues>
          <attvalue for="0" value="superalloy composition for an IGT" />
          <attvalue for="1" value="Material Composition" />
          <attvalue for="2" value="一种由冶金学家为工业燃气轮机(IGT)专门设计的超级合金材料配方。该配方在满足高温、高压等严苛性能要求的同时，也受到成本因素的制约，旨在实现性能与经济性的最佳平衡。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-d59969b39f742308167ec01469929e5b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-d59969b39f742308167ec01469929e5b-e-7" label="Industrial Gas Turbine (IGT)">
        <attvalues>
          <attvalue for="0" value="Industrial Gas Turbine (IGT)" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="大型工业燃气轮机（Large Industrial Gas Turbines）的简称。它是一种动力设备应用，其核心部件（如叶片）为在高温高压下运行，常需应用先进的涂层技术。该领域正经历材料革新，例如钴基高温合金的使用正在减少。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d59969b39f742308167ec01469929e5b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;IGT&quot;, &quot;IGTs&quot;, &quot;IGTs (Industrial Gas Turbines)&quot;, &quot;Large IGTs&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d59969b39f742308167ec01469929e5b-e-7&quot;, &quot;chunk-3f32f2a159ceed7150fba353307d3969-e-1&quot;, &quot;chunk-fb2344899d3b3a491819f8a96ffd95f7-e-14&quot;, &quot;chunk-a55ba38301e56c486550e13f957970e0-e-1&quot;, &quot;chunk-af0a9cb061b4d858fd5a6c9a30785963-e-2&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="11" />
        </attvalues>
      </node>
      <node id="chunk-d59969b39f742308167ec01469929e5b-e-9" label="cost">
        <attvalues>
          <attvalue for="0" value="cost" />
          <attvalue for="1" value="Economic Factor" />
          <attvalue for="2" value="作为一项关键经济因素，指在工业燃气轮机(IGT)应用中，超级合金的研发、制造和使用所产生的总货币支出。该成本是决定其成分设计与选择的核心制约条件，直接影响材料的性能与经济可行性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-d59969b39f742308167ec01469929e5b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d59969b39f742308167ec01469929e5b-e-11" label="large size of the blading">
        <attvalues>
          <attvalue for="0" value="large size of the blading" />
          <attvalue for="1" value="Component Characteristic" />
          <attvalue for="2" value="工业燃气轮机(IGT)的一项物理特征，指其叶片尺寸巨大。该特征是影响材料选择的关键设计因素，它对用于制造大型叶片的材料可铸性等性能提出了特定要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-d59969b39f742308167ec01469929e5b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d59969b39f742308167ec01469929e5b-e-12" label="operating environment">
        <attvalues>
          <attvalue for="0" value="operating environment" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="指一个系统、设备或部件在运行时所处的物理、化学等外部条件的总和。这些条件直接影响并决定了其设计规范、性能表现及材料选择要求，例如在腐蚀性环境中，材料必须具备相应的耐腐蚀性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-d59969b39f742308167ec01469929e5b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ef2350bf97175d40c9900d549c35b9f1-e-1" label="Blading">
        <attvalues>
          <attvalue for="0" value="Blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="Blading是一种组件，其主要特点是尺寸较大，且其特定的操作环境会对其制造成本和可铸性产生显著影响。" />
          <attvalue for="3" value="{&quot;size&quot;: &quot;large&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-ef2350bf97175d40c9900d549c35b9f1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="360" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-ef2350bf97175d40c9900d549c35b9f1-e-3" label="Life-cycle costs">
        <attvalues>
          <attvalue for="0" value="Life-cycle costs" />
          <attvalue for="1" value="Economic Factor" />
          <attvalue for="2" value="生命周期成本（Life-cycle Cost）是一个经济因素，指资产或系统在其整个生命周期内所发生的所有成本总和，包括购置、运营、维护及处置费用。它是一种旨在实现长期总成本最小化的评估方法，例如通过延长部件寿命来降低更换和维修频率，从而优化整体经济效益。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-ef2350bf97175d40c9900d549c35b9f1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="97" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5abc3c05849dadfca952537bf1c8dc41-e-3" label="superalloy substrate">
        <attvalues>
          <attvalue for="0" value="superalloy substrate" />
          <attvalue for="1" value="Material Substrate" />
          <attvalue for="2" value="高温合金基底 (superalloy substrate) 是一种由镍基、钴基等高温合金构成的基底材料。它通常在高温氧化环境下服役，因此其自身的抗氧化性能至关重要，尤其是在未应用热障涂层（TBC）系统提供额外保护的情况下。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-5abc3c05849dadfca952537bf1c8dc41" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5abc3c05849dadfca952537bf1c8dc41-e-5" label="TBC system">
        <attvalues>
          <attvalue for="0" value="TBC system" />
          <attvalue for="1" value="Coating System" />
          <attvalue for="2" value="热障涂层（TBC）系统是一种应用于燃气轮机、航空发动机等高温部件的先进保护涂层。它作为热绝缘体，可显著降低合金基体的温度，保护其免受高温氧化和腐蚀，从而延长部件的使用寿命和可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-5abc3c05849dadfca952537bf1c8dc41" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="228" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5abc3c05849dadfca952537bf1c8dc41-e-6" label="turbines">
        <attvalues>
          <attvalue for="0" value="turbines" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮机是一种将流体能量转化为机械功的旋转动力机械。在燃气轮机等高温应用中，其核心部件（如叶片）会使用热障涂层（TBC）系统进行热防护，以承受极端工作环境，提升设备性能与寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-5abc3c05849dadfca952537bf1c8dc41" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="228" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5abc3c05849dadfca952537bf1c8dc41-e-8" label="turbine disc applications">
        <attvalues>
          <attvalue for="0" value="turbine disc applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="指将高温合金用于制造航空发动机、燃气轮机等动力装置核心旋转部件——涡轮盘的应用领域。该应用要求材料能在高温、高压和高离心力下保持结构完整性和性能稳定性，是高温合金最关键和要求最严苛的用途之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-5abc3c05849dadfca952537bf1c8dc41" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5abc3c05849dadfca952537bf1c8dc41-e-9" label="superalloy turbine discs">
        <attvalues>
          <attvalue for="0" value="superalloy turbine discs" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="高温合金涡轮盘是燃气轮机或航空发动机中的关键承力旋转部件。它采用能在极端温度和应力下保持强度的超级合金材料制造，其核心设计要求是抵抗整体屈服变形，以保证发动机在严苛工况下的结构完整性与运行安全。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-5abc3c05849dadfca952537bf1c8dc41" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5abc3c05849dadfca952537bf1c8dc41-e-10" label="general yielding">
        <attvalues>
          <attvalue for="0" value="general yielding" />
          <attvalue for="1" value="Mechanical Failure Mode" />
          <attvalue for="2" value="**整体屈服 (General Yielding)**&#10;&#10;一种失效模式，指结构构件在过载作用下，大部分或整体截面进入塑性状态，发生显著的永久变形，导致其丧失承载能力。在工程设计中，它是高温合金涡轮盘等关键承力部件必须避免的一种失效形式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-5abc3c05849dadfca952537bf1c8dc41" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5abc3c05849dadfca952537bf1c8dc41-e-10&quot;, &quot;chunk-024c36ea3394fc7ba3bfdd8df0168497-e-2&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-024c36ea3394fc7ba3bfdd8df0168497-e-1" label="superalloy turbine discs">
        <attvalues>
          <attvalue for="0" value="superalloy turbine discs" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="高温合金涡轮盘是涡轮发动机的关键承力部件。其设计旨在抵抗整体屈服与低周疲劳开裂，通常采用沉淀硬化及晶粒尺寸控制等工艺强化，以保证在高温高压等极端工作条件下的结构完整性与可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-024c36ea3394fc7ba3bfdd8df0168497" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-024c36ea3394fc7ba3bfdd8df0168497-e-3" label="low-cycle-fatigue cracking">
        <attvalues>
          <attvalue for="0" value="low-cycle-fatigue cracking" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="低周疲劳开裂（Low-cycle-fatigue cracking）是在高应力、低次数循环载荷下发生的疲劳开裂失效模式。它通常萌生于结构的应力集中区域，如高温合金涡轮盘的中心孔附近，是此类关键部件设计时需着重防止的损伤。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-024c36ea3394fc7ba3bfdd8df0168497" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-024c36ea3394fc7ba3bfdd8df0168497-e-3&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-024c36ea3394fc7ba3bfdd8df0168497-e-4" label="stress concentration near the bore">
        <attvalues>
          <attvalue for="0" value="stress concentration near the bore" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="指涡轮盘中心孔洞附近的特定区域。由于几何结构不连续，该区域存在显著的应力集中，使其成为一个结构薄弱点，是低周疲劳裂纹萌生的典型高发位置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-024c36ea3394fc7ba3bfdd8df0168497" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-024c36ea3394fc7ba3bfdd8df0168497-e-6" label="precipitation hardening">
        <attvalues>
          <attvalue for="0" value="precipitation hardening" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="沉淀硬化（Precipitation Hardening）是一种通过热处理在金属基体中形成细小、弥散的第二相（析出相，如γ'相）的强化机制。这些析出相能有效阻碍位错运动，从而显著提高材料（如高温合金）的强度和硬度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-024c36ea3394fc7ba3bfdd8df0168497" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Precipitation-hardened systems&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c46fd89a11edd99dc16bcf1682764928-e-2&quot;, &quot;chunk-024c36ea3394fc7ba3bfdd8df0168497-e-6&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-024c36ea3394fc7ba3bfdd8df0168497-e-8" label="high-pressure discs">
        <attvalues>
          <attvalue for="0" value="high-pressure discs" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="高压盘是一种由高温合金制成的涡轮盘，是航空发动机或燃气轮机高压部分的核心承力与旋转部件。它在高温、高压、高转速的极端工况下运行，承受巨大的离心力和热负荷，对材料性能和制造工艺有极高要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-024c36ea3394fc7ba3bfdd8df0168497" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-476c99d22cc46115c3dc1dca1b6b4708-e-2" label="high-pressure discs">
        <attvalues>
          <attvalue for="0" value="high-pressure discs" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="高压盘是航空发动机中的一种关键承力部件，其结构包含轮缘等部分。它在高温、高应力的严苛工况下运行，因此要求材料具备优异的抗蠕变和抗高温驻留裂纹扩展性能，以满足不断提升的运行要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-476c99d22cc46115c3dc1dca1b6b4708" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-476c99d22cc46115c3dc1dca1b6b4708-e-4" label="turbine blading">
        <attvalues>
          <attvalue for="0" value="turbine blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="安装于高压涡轮盘轮缘部分的一组叶片。它通过特定的型面和排布方式定义了燃气流路，是引导气体膨胀做功、将热能转化为机械能的核心部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-476c99d22cc46115c3dc1dca1b6b4708" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-476c99d22cc46115c3dc1dca1b6b4708-e-5" label="gas flow path">
        <attvalues>
          <attvalue for="0" value="gas flow path" />
          <attvalue for="1" value="System Path" />
          <attvalue for="2" value="指涡轮机内，由涡轮叶片所构成的，用于引导高温燃气流动的特定通道或路径。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-476c99d22cc46115c3dc1dca1b6b4708" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-476c99d22cc46115c3dc1dca1b6b4708-e-6" label="advanced aeroengine designs">
        <attvalues>
          <attvalue for="0" value="advanced aeroengine designs" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="指一种现代化的航空发动机系统，其设计核心是通过提高运行温度（如在轮缘部分）来实现卓越性能，主要满足高性能军事应用的需求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-476c99d22cc46115c3dc1dca1b6b4708" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-476c99d22cc46115c3dc1dca1b6b4708-e-7" label="high-temperature ‘dwell' crack propagation">
        <attvalues>
          <attvalue for="0" value="high-temperature ‘dwell' crack propagation" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="高温“驻留”裂纹扩展是一种材料失效现象。它特指在高温和循环载荷的保载（驻留）阶段，由于蠕变、氧化等时间相关性损伤与疲劳损伤的交互作用，导致裂纹加速扩展。该现象对材料的微观结构极为敏感，因此受到加工工艺的显著影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-476c99d22cc46115c3dc1dca1b6b4708" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-476c99d22cc46115c3dc1dca1b6b4708-e-7&quot;, &quot;chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-1&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-3" label="processing steps">
        <attvalues>
          <attvalue for="0" value="processing steps" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="指在部件制造过程中所必需的一系列工艺步骤。这些步骤的设计与执行会显著受到蠕变、高温驻留裂纹扩展等现象的影响，因此面临日益严苛的技术要求，以确保最终产品的性能与可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-e0ff1a8ba2325330670b26bb64b4b73d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-4" label="component fabrication">
        <attvalues>
          <attvalue for="0" value="component fabrication" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="**组件制造 (Component Fabrication)**：指通过一系列必需的加工步骤，将原材料或半成品转化为特定组件的完整制造过程。该过程是生产更大系统或最终产品的基础环节。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-e0ff1a8ba2325330670b26bb64b4b73d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-5" label="turbine disc supplier">
        <attvalues>
          <attvalue for="0" value="turbine disc supplier" />
          <attvalue for="1" value="Role" />
          <attvalue for="2" value="指负责将高温合金坯料通过锻造、机加工等工艺塑造成形，以制造和供应关键航空发动机部件“涡轮盘”的实体或角色。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e0ff1a8ba2325330670b26bb64b4b73d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-6" label="superalloy billet">
        <attvalues>
          <attvalue for="0" value="superalloy billet" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="高温合金坯料是一种以高温合金为原料，通过模锻或机加工等工艺制成的中间产品。它主要用作制造涡轮盘等关键热端部件的起始材料，在最终成型前，通常需经过热处理和超声波探伤等工序。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e0ff1a8ba2325330670b26bb64b4b73d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-6&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-7" label="open/closed-die forming">
        <attvalues>
          <attvalue for="0" value="open/closed-die forming" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="开放式和闭合式模锻是两种核心锻造工艺，通过对金属坯料施加压缩力使其塑性变形，从而获得所需形状和性能的零件。在开放式模锻（自由锻）中，工件不被模具完全封闭。而在闭合式模锻中，工件在具有特定型腔的模具内受压成形，常用于生产盘类等锻件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-e0ff1a8ba2325330670b26bb64b4b73d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;open- and closed-die forging&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-7&quot;, &quot;chunk-ee6f1e6770197cb40d6002c5cd9212fd-e-9&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a1650d74269b8238062c417df547e98e-e-3" label="Minimum property levels">
        <attvalues>
          <attvalue for="0" value="Minimum property levels" />
          <attvalue for="1" value="Requirement" />
          <attvalue for="2" value="**最低性能要求 (Minimum property levels)**&#10;&#10;一项工程要求，指在特定部件区域（如孔区域、轮辋区域）内，材料性能参数（如强度、硬度）必须达到的最低标准值。该要求旨在确保关键部位的结构完整性与运行可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a1650d74269b8238062c417df547e98e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a1650d74269b8238062c417df547e98e-e-4" label="Bore region">
        <attvalues>
          <attvalue for="0" value="Bore region" />
          <attvalue for="1" value="Component Part" />
          <attvalue for="2" value="Bore regions是指零件上具有或需要形成细晶粒组织的孔洞特定区域。这种精细的微观结构通常是为了提升该部位的强度、硬度和耐磨性，以满足其在高应力或高摩擦工况下的性能要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a1650d74269b8238062c417df547e98e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Bore regions&quot;, &quot;bore region&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-925bc5f619d7b2214c7a718b66fcfe15-e-7&quot;, &quot;chunk-d015db7235325173c4b776781906ae0b-e-2&quot;, &quot;chunk-a1650d74269b8238062c417df547e98e-e-4&quot;, &quot;chunk-6261bb103f1582e3eddbed3d2b069224-e-6&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-a1650d74269b8238062c417df547e98e-e-6" label="Original equipment manufacturers (OEMs)">
        <attvalues>
          <attvalue for="0" value="Original equipment manufacturers (OEMs)" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="原始设备制造商 (OEM) 是一家根据另一家公司（品牌方）的规格和要求，为其生产产品或零部件的企业。这些产品最终以品牌方的名义进行销售，使品牌方能专注于自身的设计和营销，而将制造环节外包。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a1650d74269b8238062c417df547e98e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a1650d74269b8238062c417df547e98e-e-7" label="Microstructural and property differentiation">
        <attvalues>
          <attvalue for="0" value="Microstructural and property differentiation" />
          <attvalue for="1" value="Requirement" />
          <attvalue for="2" value="一项由原始设备制造商(OEM)提出的技术要求，旨在使单一构件的不同区域具有差异化的微观结构和材料性能，以满足复杂工况。该要求可通过双重微观结构热处理(DMHT)等技术实现。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a1650d74269b8238062c417df547e98e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d89de553b45749db88cca84e98f06178-e-7" label="Single component">
        <attvalues>
          <attvalue for="0" value="Single component" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种经过亚固溶与超固溶热处理的整体式金属构件。它通常为具有中心孔和轮缘的盘状结构，其特定热处理工艺旨在优化材料的微观结构与力学性能，以满足严苛工况下的高性能要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d89de553b45749db88cca84e98f06178" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d89de553b45749db88cca84e98f06178-e-8" label="Heat sinks">
        <attvalues>
          <attvalue for="0" value="Heat sinks" />
          <attvalue for="1" value="Tool" />
          <attvalue for="2" value="一种在热处理工艺中使用的工具，通过冷却圆盘的中心部位，从而在材料上建立并增强所需的热梯度。" />
          <attvalue for="3" value="{&quot;composition&quot;: &quot;typically solid metal cylinders&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-d89de553b45749db88cca84e98f06178" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d89de553b45749db88cca84e98f06178-e-9" label="Thermal gradients">
        <attvalues>
          <attvalue for="0" value="Thermal gradients" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="热梯度（Thermal gradients）是一种物理现象，指物体内部沿特定方向的温度变化率。在淬火等热处理过程中，它由表面的传热系数所建立，这种不均匀的温度分布是导致材料内部形成残余应力场的主要原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-d89de553b45749db88cca84e98f06178" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d89de553b45749db88cca84e98f06178-e-9&quot;, &quot;chunk-2b0bf628a95c22fc39c3dcd9f2959fd7-e-5&quot;, &quot;chunk-ee2c916092b69050b73e7898f576b082-e-5&quot;, &quot;chunk-523637843506c3574fe003659e8f0b3e-e-5&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-d89de553b45749db88cca84e98f06178-e-10" label="Disc">
        <attvalues>
          <attvalue for="0" value="Disc" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种具有外围和中心孔区域的盘状部件。作为冷却目标，它被计算机控制的高速气体射流作用，导致其表面的传热系数呈非均匀变化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-d89de553b45749db88cca84e98f06178" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;disc&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d89de553b45749db88cca84e98f06178-e-10&quot;, &quot;chunk-6261bb103f1582e3eddbed3d2b069224-e-4&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-f942fb543f3ac01d63fdbc3537940608-e-2" label="ME3 turbine disc superalloy">
        <attvalues>
          <attvalue for="0" value="ME3 turbine disc superalloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="ME3是一种先进的涡轮盘高温合金。它通过应用双晶粒结构概念，使其在盘件的不同区域能够同时具备优异的拉伸性能与抗蠕变性能，是专为高性能航空发动机设计的关键材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-f942fb543f3ac01d63fdbc3537940608" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-f942fb543f3ac01d63fdbc3537940608-e-3" label="Tensile data">
        <attvalues>
          <attvalue for="0" value="Tensile data" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一项关键的材料力学性能指标，特指ME3涡轮盘高温合金在承受轴向拉伸载荷时所表现出的特性。它通过抗拉强度、延伸率等数据进行量化，是评估该材料性能的重要依据，且在盘孔区域表现尤为优越。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-f942fb543f3ac01d63fdbc3537940608" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f942fb543f3ac01d63fdbc3537940608-e-5" label="Bore regions">
        <attvalues>
          <attvalue for="0" value="Bore regions" />
          <attvalue for="1" value="Component Part" />
          <attvalue for="2" value="ME3涡轮盘上的特定区域。与涡轮盘的其他部分相比，该区域材料的拉伸性能数据（如抗拉强度、屈服强度等）更为优越，表明其抵抗拉伸破坏的能力更强。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-f942fb543f3ac01d63fdbc3537940608" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f942fb543f3ac01d63fdbc3537940608-e-5&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f942fb543f3ac01d63fdbc3537940608-e-6" label="Rim regions">
        <attvalues>
          <attvalue for="0" value="Rim regions" />
          <attvalue for="1" value="Component Part" />
          <attvalue for="2" value="ME3涡轮盘的一个特定组成区域。其关键特征是具有优异的蠕变性能，即在高温和持续应力环境下，表现出极强的抵抗永久变形的能力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-f942fb543f3ac01d63fdbc3537940608" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f942fb543f3ac01d63fdbc3537940608-e-6&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f942fb543f3ac01d63fdbc3537940608-e-7" label="Generic disc shape">
        <attvalues>
          <attvalue for="0" value="Generic disc shape" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种通用的圆盘状组件，主要用于相关实验中，以验证并展示双晶粒结构所带来的性能优势。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-f942fb543f3ac01d63fdbc3537940608" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f942fb543f3ac01d63fdbc3537940608-e-8" label="Dual grain structure">
        <attvalues>
          <attvalue for="0" value="Dual grain structure" />
          <attvalue for="1" value="Microstructure" />
          <attvalue for="2" value="一种在单个构件中包含两种不同晶粒组织的微观结构。它通过在不同区域（如涡轮盘的盘心与盘缘）形成不同尺寸的晶粒（如细晶与粗晶），来分别优化局部的力学性能（如强度与抗蠕变性），从而提升构件的整体可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-f942fb543f3ac01d63fdbc3537940608" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-f942fb543f3ac01d63fdbc3537940608-e-9" label="Functionally graded discs">
        <attvalues>
          <attvalue for="0" value="Functionally graded discs" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="功能梯度盘是一种盘状部件，其材料属性（如晶粒结构）在空间上呈梯度式连续变化。它可通过特定工艺制造，以形成具有双重晶粒结构等特征的非均匀组织，旨在使构件的不同区域能够满足特定的、差异化的性能要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-f942fb543f3ac01d63fdbc3537940608" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f942fb543f3ac01d63fdbc3537940608-e-9&quot;, &quot;chunk-2582edaf6620b68f12a09bd6df3bb24c-e-1&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2582edaf6620b68f12a09bd6df3bb24c-e-3" label="Dual microstructure discs">
        <attvalues>
          <attvalue for="0" value="Dual microstructure discs" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种先进的燃气涡轮发动机盘件，在单个部件内集成两种不同的微观结构。通常轮毂区域采用细晶粒结构以提高抗疲劳性能，轮缘区域则采用粗晶粒结构以增强高温抗蠕变性，从而优化整体性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-2582edaf6620b68f12a09bd6df3bb24c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="229" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2582edaf6620b68f12a09bd6df3bb24c-e-4" label="Gas turbine engine">
        <attvalues>
          <attvalue for="0" value="Gas turbine engine" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="燃气涡轮发动机是一种以连续流动的气体为工质、依靠燃气能量驱动涡轮旋转做功的热机。它主要由压气机、燃烧室和燃气涡轮组成，通过将燃料的化学能转化为高温燃气的热能，再转变为机械能，以产生推力或轴功率。常作为飞机发动机或发电装置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-2582edaf6620b68f12a09bd6df3bb24c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="229" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2582edaf6620b68f12a09bd6df3bb24c-e-5" label="Powder Metallurgy (P/M) superalloys">
        <attvalues>
          <attvalue for="0" value="Powder Metallurgy (P/M) superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="粉末冶金高温合金指采用粉末冶金工艺制备的一类高性能合金。该工艺可获得均匀细致的微观组织，赋予其卓越的高温强度、抗蠕变和抗疲劳性能。它主要用于制造航空发动机的高压涡轮盘等关键热端承力部件，如Rene 95。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2582edaf6620b68f12a09bd6df3bb24c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;P/M superalloys&quot;, &quot;Powder metallurgy (P/M) superalloys&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2582edaf6620b68f12a09bd6df3bb24c-e-5&quot;, &quot;chunk-984b31532b15eb77f69439c6359615d7-e-1&quot;, &quot;chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f-e-14&quot;, &quot;chunk-6e297624caadd734c7908a7c84598380-e-1&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-2582edaf6620b68f12a09bd6df3bb24c-e-6" label="High-pressure turbine discs">
        <attvalues>
          <attvalue for="0" value="High-pressure turbine discs" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="高压涡轮盘是燃气轮机引擎的核心旋转部件，用于安装并带动涡轮叶片高速旋转。为承受极端的高温和离心应力，它成为首个采用粉末冶金高温合金制造的关键热端承力件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-2582edaf6620b68f12a09bd6df3bb24c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-984b31532b15eb77f69439c6359615d7-e-2" label="High-pressure turbine discs">
        <attvalues>
          <attvalue for="0" value="High-pressure turbine discs" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="高压涡轮盘是军用发动机中的一种关键旋转部件，采用粉末冶金高温合金制造以承受极端工况。它也是该先进材料技术的首个应用领域，用于将燃气能量转化为转动功。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-984b31532b15eb77f69439c6359615d7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-984b31532b15eb77f69439c6359615d7-e-3" label="Military engines">
        <attvalues>
          <attvalue for="0" value="Military engines" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="为军事用途设计的高性能发动机，通常指航空发动机。它集成高压涡轮盘等关键部件，是粉末冶金高温合金涡轮盘等尖端技术的初始应用领域，需在极端条件下满足高推力与高可靠性的严苛要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-984b31532b15eb77f69439c6359615d7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a5ab94c496162dae08a6cf75a408debb-e-1" label="First-generation P/M superalloys">
        <attvalues>
          <attvalue for="0" value="First-generation P/M superalloys" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="第一代粉末冶金高温合金（First-generation P/M superalloys）是以Rene 95为代表的一类材料。其设计目标是最大化拉伸强度，通常采用亚固溶热处理工艺，并以高体积分数的γ'相为主要强化特征。" />
          <attvalue for="3" value="{&quot;gamma_prime_volume_fraction&quot;: &quot;~55%&quot;, &quot;grain_size&quot;: &quot;~10 µm&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-a5ab94c496162dae08a6cf75a408debb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a5ab94c496162dae08a6cf75a408debb-e-1&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a5ab94c496162dae08a6cf75a408debb-e-6" label="Second-generation P/M superalloys">
        <attvalues>
          <attvalue for="0" value="Second-generation P/M superalloys" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="第二代粉末冶金（P/M）高温合金是为提升抗疲劳裂纹扩展性能而开发的一类先进材料。该类合金通过粉末冶金工艺制造，其显微组织的典型特征是分布精细的γ'（gamma-prime）强化相。Rene 88DT是其代表性牌号。" />
          <attvalue for="3" value="{&quot;grain_size&quot;: &quot;~50 µm&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a5ab94c496162dae08a6cf75a408debb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a5ab94c496162dae08a6cf75a408debb-e-6&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a5ab94c496162dae08a6cf75a408debb-e-8" label="Fatigue crack propagation resistance">
        <attvalues>
          <attvalue for="0" value="Fatigue crack propagation resistance" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="抗疲劳裂纹扩展性 (Fatigue crack propagation resistance) 是一项力学性能，指材料在循环载荷作用下，抵抗已有裂纹发生扩展的能力。它是衡量材料损伤容限和预测构件疲劳寿命的重要指标，对于开发第二代粉末冶金高温合金等先进材料至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-a5ab94c496162dae08a6cf75a408debb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a5ab94c496162dae08a6cf75a408debb-e-8&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7fe022ba8cc7632d553ef231b0a1a4ea-e-1" label="Larger grain sizes (~50 µm)">
        <attvalues>
          <attvalue for="0" value="Larger grain sizes (~50 µm)" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="一种约为50µm的粗大晶粒显微结构，通常通过热处理等工艺有意形成。该结构旨在显著提升材料的抗疲劳裂纹扩展、抗蠕变及抗驻留裂纹扩展性能，是第三代合金等先进材料为满足损伤容限设计而追求的关键目标。" />
          <attvalue for="3" value="{&quot;size&quot;: &quot;~50 µm&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-7fe022ba8cc7632d553ef231b0a1a4ea" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-7fe022ba8cc7632d553ef231b0a1a4ea-e-2" label="Fatigue crack propagation">
        <attvalues>
          <attvalue for="0" value="Fatigue crack propagation" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="疲劳裂纹扩展是一种材料失效机理，指材料在远低于其屈服强度的循环应力作用下，从已有缺陷处萌生的裂纹，并逐渐、稳定地向前扩展，最终导致结构断裂的过程。它是结构疲劳失效的主要阶段。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-7fe022ba8cc7632d553ef231b0a1a4ea" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7fe022ba8cc7632d553ef231b0a1a4ea-e-2&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7fe022ba8cc7632d553ef231b0a1a4ea-e-3" label="Damage-tolerance lifing methods">
        <attvalues>
          <attvalue for="0" value="Damage-tolerance lifing methods" />
          <attvalue for="1" value="Design Methodology" />
          <attvalue for="2" value="一种基于断裂力学的设计评定方法。它假定构件中存在初始缺陷，通过计算缺陷在服役载荷下的扩展过程，预测其达到临界尺寸所需的时间或循环数，从而确定构件在损伤存在下的安全使用寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-7fe022ba8cc7632d553ef231b0a1a4ea" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7fe022ba8cc7632d553ef231b0a1a4ea-e-3&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7fe022ba8cc7632d553ef231b0a1a4ea-e-4" label="Third-generation alloys">
        <attvalues>
          <attvalue for="0" value="Third-generation alloys" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="第三代合金是一类新设计的合金，以高γ'相体积分数为特征，并旨在获得更大的晶粒尺寸（约50µm）。其典型代表包括ME3和LSHR等材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-7fe022ba8cc7632d553ef231b0a1a4ea" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-7fe022ba8cc7632d553ef231b0a1a4ea-e-5" label="ME3">
        <attvalues>
          <attvalue for="0" value="ME3" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="ME3是一种合金的代号，特指在特定文献中提及的一种材料。由于信息有限，其具体的化学成分、物理性能、制造工艺及应用领域等详细信息，均取决于其原始出处的具体描述。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-7fe022ba8cc7632d553ef231b0a1a4ea" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7fe022ba8cc7632d553ef231b0a1a4ea-e-5&quot;, &quot;chunk-f23caa328479b9d419f0d855b9335eb4-e-17&quot;, &quot;chunk-ae682ac4e4eb339bd48233482011cdd1-e-4&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7fe022ba8cc7632d553ef231b0a1a4ea-e-9" label="DMHT process">
        <attvalues>
          <attvalue for="0" value="DMHT process" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="DMHT工艺（Direct and Modified Heat Treatment）是一种针对镍基高温合金的先进热处理工艺。该工艺通过精确控制热处理过程，旨在获得细小均匀的晶粒组织，以显著提高合金的疲劳寿命和强度等关键力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-7fe022ba8cc7632d553ef231b0a1a4ea" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="361" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-7fe022ba8cc7632d553ef231b0a1a4ea-e-10" label="Dwell-crack growth">
        <attvalues>
          <attvalue for="0" value="Dwell-crack growth" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="Dwell-crack growth是一种材料失效机制，指在持续载荷或保载（dwell）条件下发生的裂纹扩展现象。该机制对材料的微观结构敏感，其扩展速率可通过调控晶粒尺寸（如增大至约50微米）来有效抑制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-7fe022ba8cc7632d553ef231b0a1a4ea" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7fe022ba8cc7632d553ef231b0a1a4ea-e-11" label="Creep rates">
        <attvalues>
          <attvalue for="0" value="Creep rates" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="蠕变速率是一种材料属性，用于衡量材料在恒定应力（尤其是在高温下）作用下，随时间发生的缓慢永久变形（应变）的速率。该数值越低，表示材料抵抗蠕变损伤的能力越强，是高温合金等关键材料的核心性能指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-7fe022ba8cc7632d553ef231b0a1a4ea" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7fe022ba8cc7632d553ef231b0a1a4ea-e-11&quot;, &quot;chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f-e-2&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f-e-1" label="Dwell-crack growth">
        <attvalues>
          <attvalue for="0" value="Dwell-crack growth" />
          <attvalue for="1" value="Mechanical Phenomenon" />
          <attvalue for="2" value="一种在恒定载荷（保载）期间发生的、具有时间依赖性的裂纹扩展现象。它对温度和环境高度敏感，通常由蠕变与环境（如氧化）在裂纹尖端的协同作用驱动。该现象是粉末冶金高温合金在航空发动机涡轮盘等关键部件中的主要失效模式之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f-e-1&quot;]}]" />
          <attvalue for="9" value="362" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f-e-5" label="Powder disc compositions">
        <attvalues>
          <attvalue for="0" value="Powder disc compositions" />
          <attvalue for="1" value="Material Design" />
          <attvalue for="2" value="一种材料设计，指通过粉末冶金工艺制造的盘件的化学成分。该设计旨在优化材料配方，以提高其在高温高应力环境下的抗蠕变性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f-e-6" label="Carbon">
        <attvalues>
          <attvalue for="0" value="Carbon" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="碳是一种化学元素，在材料学中常作为关键的合金添加剂。它通过促进基体中碳化物的析出与强化，有效改善材料的组织稳定性与高温蠕变性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f-e-12" label="γ-grain growth">
        <attvalues>
          <attvalue for="0" value="γ-grain growth" />
          <attvalue for="1" value="Metallurgical Process" />
          <attvalue for="2" value="γ晶粒长大是一种冶金过程，指材料在高温下γ相晶粒尺寸增大的微观结构演变。该过程通常受到固溶线温度的限制，并通过第二相粒子等钉扎点阻碍晶界迁移来加以控制，以防止晶粒发生异常长大。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;y-grain growth&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-117357a69dc4feae2bf2578a7ae7467c-e-7&quot;, &quot;chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f-e-12&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f-e-13" label="Solvus temperature">
        <attvalues>
          <attvalue for="0" value="Solvus temperature" />
          <attvalue for="1" value="Temperature Threshold" />
          <attvalue for="2" value="固溶线温度（Solvus temperature）指合金中特定相（如强化相）完全溶解于基体固溶体中的临界温度。超过此温度，常因抑制晶粒长大的钉扎相消失，而导致基体（如γ相）晶粒发生有害的异常长大。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f-e-13&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6e297624caadd734c7908a7c84598380-e-2" label="Turbine industry">
        <attvalues>
          <attvalue for="0" value="Turbine industry" />
          <attvalue for="1" value="Industry" />
          <attvalue for="2" value="涡轮机工业是从事涡轮机设计、制造和维护的产业部门。该行业技术密集，其发展特点是日益广泛地应用粉末冶金高温合金等先进材料，并依靠概率性方法来精确预测关键部件的服役寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-6e297624caadd734c7908a7c84598380" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6e297624caadd734c7908a7c84598380-e-3" label="Probabilistic methods of lifing">
        <attvalues>
          <attvalue for="0" value="Probabilistic methods of lifing" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="一种在涡轮机行业日益重要的寿命评估方法论。它运用概率统计学原理，对材料、载荷等不确定性因素进行建模和分析，以预测部件的服役寿命。该方法通常在初步的筛选方法之后应用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-6e297624caadd734c7908a7c84598380" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6e297624caadd734c7908a7c84598380-e-3&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6e297624caadd734c7908a7c84598380-e-4" label="Screening methods">
        <attvalues>
          <attvalue for="0" value="Screening methods" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="一种在固结前快速评估高温合金粉末质量的方法。它通过定量分析非金属夹杂物，为材料的概率性寿命预测方法提供关键的输入数据，是确保最终部件性能的重要步骤。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-6e297624caadd734c7908a7c84598380" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-6e297624caadd734c7908a7c84598380-e-5" label="Superalloy powder">
        <attvalues>
          <attvalue for="0" value="Superalloy powder" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="高温合金粉末是一种用于增材制造、热等静压等先进成型技术的关键金属粉末材料。其纯净度（如非金属夹杂物含量）、粒度分布与球形度等质量特性，需在固化成型前通过筛分等方法严格评估，因其直接决定了最终制件的性能与可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-6e297624caadd734c7908a7c84598380" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6ab819da0d17d27985ac5f6eebc6d38b-e-2" label="powder material">
        <attvalues>
          <attvalue for="0" value="powder material" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;粉末材料是一种呈粉末形态的原材料，常作为粉末冶金等工艺的起点。它是一个关键的成本优化对象，可通过热等静压、常规压制等先进成型技术来有效降低其制造成本。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-6ab819da0d17d27985ac5f6eebc6d38b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="77" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6ab819da0d17d27985ac5f6eebc6d38b-e-3" label="hot isostatic pressing/conventional press conversion (cogging) practices">
        <attvalues>
          <attvalue for="0" value="hot isostatic pressing/conventional press conversion (cogging) practices" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="一种现代化的制造工艺，它采用热等静压（HIP）或常规压制（粗锻）等方法，对粉末材料进行固化成形。该工艺旨在降低生产成本，可作为传统热压实/挤压工艺路线的替代方案。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-6ab819da0d17d27985ac5f6eebc6d38b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="77" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6ab819da0d17d27985ac5f6eebc6d38b-e-4" label="hot compaction/extrusion routes">
        <attvalues>
          <attvalue for="0" value="hot compaction/extrusion routes" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="一种传统的粉末冶金制造工艺，通过在高温下对金属粉末进行压实和挤压，以制成坯料。该工艺的特点是需要专用模具和高吨位设备，可被热等静压等更先进的工艺替代。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-6ab819da0d17d27985ac5f6eebc6d38b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="77" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6ab819da0d17d27985ac5f6eebc6d38b-e-5" label="P/M billets">
        <attvalues>
          <attvalue for="0" value="P/M billets" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="一种通过粉末冶金（Powder Metallurgy, P/M）工艺制成的金属坯料。它将金属粉末经压实和烧结（或热等静压）制成，与传统铸坯相比，其化学成分和微观结构更均匀，常用于生产高性能或特殊合金的零部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-6ab819da0d17d27985ac5f6eebc6d38b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6ab819da0d17d27985ac5f6eebc6d38b-e-5&quot;, &quot;chunk-ee6f1e6770197cb40d6002c5cd9212fd-e-1&quot;]}]" />
          <attvalue for="9" value="77" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6ab819da0d17d27985ac5f6eebc6d38b-e-6" label="cast-and-wrought superalloy billets">
        <attvalues>
          <attvalue for="0" value="cast-and-wrought superalloy billets" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="一种采用铸造和后续锻压（或轧制）热加工工艺制成的高温合金棒状半成品。该工艺旨在消除铸态缺陷，细化晶粒组织，从而获得优异的综合力学性能。IN718和Waspaloy是其典型牌号。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-6ab819da0d17d27985ac5f6eebc6d38b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6ab819da0d17d27985ac5f6eebc6d38b-e-6&quot;, &quot;chunk-ee6f1e6770197cb40d6002c5cd9212fd-e-2&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ee6f1e6770197cb40d6002c5cd9212fd-e-5" label="random melt-related defects">
        <attvalues>
          <attvalue for="0" value="random melt-related defects" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="指在铸锻高温合金坯料的熔炼过程中随机产生的内在冶金缺陷。这类缺陷的存在会严重限制材料的疲劳潜能，使其无法达到预期的疲劳性能和使用寿命，是影响材料可靠性的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ee6f1e6770197cb40d6002c5cd9212fd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ee6f1e6770197cb40d6002c5cd9212fd-e-6" label="fatigue potential">
        <attvalues>
          <attvalue for="0" value="fatigue potential" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种材料性能，指高温合金在理想无缺陷状态下所能达到的最大抗疲劳能力。这项固有的潜在性能，在实际中会因随机熔炼相关缺陷的存在而受到限制，从而决定材料最终的疲劳表现。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-ee6f1e6770197cb40d6002c5cd9212fd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ee6f1e6770197cb40d6002c5cd9212fd-e-8" label="disc production">
        <attvalues>
          <attvalue for="0" value="disc production" />
          <attvalue for="1" value="Manufacturing Application" />
          <attvalue for="2" value="一种制造金属盘状零件的整体工艺应用。它集成了模锻（如开式与闭式模锻）、热处理和机械加工等关键工序，并通过工艺建模对其进行分析、仿真与优化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-ee6f1e6770197cb40d6002c5cd9212fd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-ee6f1e6770197cb40d6002c5cd9212fd-e-11" label="machining">
        <attvalues>
          <attvalue for="0" value="machining" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="机械加工是一种通过从工件上去除多余材料以获得所需几何形状的制造过程。它包括车削、铣削等多种具体操作。该过程可通过建模等技术进行优化，以控制和预防过度的金属移动与变形等缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-ee6f1e6770197cb40d6002c5cd9212fd" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Machining operations&quot;, &quot;machining operations&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-8&quot;, &quot;chunk-ee6f1e6770197cb40d6002c5cd9212fd-e-11&quot;, &quot;chunk-9b8241b51916aa0fe236ff3e6c045cdf-e-7&quot;, &quot;chunk-1159c2afbaaccc92d505d71fb856dee1-e-2&quot;, &quot;chunk-dae9be5eb4b7208070b473c392dd0478-e-6&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-f3de78de36038078dc14b547813962c5-e-1" label="Simulation of deformation trajectories and flow fields">
        <attvalues>
          <attvalue for="0" value="Simulation of deformation trajectories and flow fields" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种计算机数值模拟过程，通过专用软件执行，用于在锻造工艺中分析材料的变形轨迹与流场。该过程旨在预测材料在成形过程中的力学行为和流动模式，以优化工艺参数并确保产品质量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-f3de78de36038078dc14b547813962c5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f3de78de36038078dc14b547813962c5-e-3" label="Software packages">
        <attvalues>
          <attvalue for="0" value="Software packages" />
          <attvalue for="1" value="Software" />
          <attvalue for="2" value="一系列基于有限元方法的仿真软件工具。它们能够模拟材料的变形轨迹、流场以及高温合金的热粘塑性流动，主要用于模具设计和制造缺陷预测等工程应用。" />
          <attvalue for="3" value="{&quot;availability&quot;: &quot;two decades or more&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-f3de78de36038078dc14b547813962c5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-f3de78de36038078dc14b547813962c5-e-4" label="Finite-element method">
        <attvalues>
          <attvalue for="0" value="Finite-element method" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="有限元法是一种强大的数值计算方法，用于求解偏微分方程。它将复杂的物理域或结构离散化为一系列简单的、相互连接的子域（即“有限元”），在每个单元内近似求解，最终组合成全局解。它在结构力学、热传导和流体力学等领域应用广泛。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f3de78de36038078dc14b547813962c5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;finite element methods&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f3de78de36038078dc14b547813962c5-e-4&quot;, &quot;chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-15&quot;, &quot;chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676-e-1&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f3de78de36038078dc14b547813962c5-e-5" label="Superalloy's thermal-viscoplastic flow">
        <attvalues>
          <attvalue for="0" value="Superalloy's thermal-viscoplastic flow" />
          <attvalue for="1" value="Material Data" />
          <attvalue for="2" value="一种材料数据集，它定量描述了高温合金在高温和不同应变率下发生塑性变形时的力学行为。该数据是工程仿真软件进行精确计算和预测分析的基础，对高温部件的制造工艺模拟和服役性能评估至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-f3de78de36038078dc14b547813962c5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f3de78de36038078dc14b547813962c5-e-6" label="Die design">
        <attvalues>
          <attvalue for="0" value="Die design" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="模具设计（Die design）是一项工程应用，指为冲压、注塑、压铸等成型工艺开发专用工具（模具）。它借助仿真软件分析材料流动与应力，优化设计并预测缺陷，以提升产品质量和生产效率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-f3de78de36038078dc14b547813962c5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f3de78de36038078dc14b547813962c5-e-7" label="Prediction of defects">
        <attvalues>
          <attvalue for="0" value="Prediction of defects" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="缺陷预测是一种工程应用，指利用专业的模拟软件包，在产品制造（如铸造）的早期阶段，对可能出现的冷隔等缺陷进行分析和识别，以优化工艺、提高良品率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-f3de78de36038078dc14b547813962c5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f3de78de36038078dc14b547813962c5-e-8" label="Cold shuts">
        <attvalues>
          <attvalue for="0" value="Cold shuts" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="**冷隔 (Cold shuts)**&#10;&#10;铸造或成型过程中的一种缺陷。指两股或多股熔融材料在汇合时，因温度过低而未能完全熔合，从而在制品中形成接合缝隙或线性缺陷。它是一种可通过模拟软件预测的严重缺陷，会显著降低部件的结构强度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-f3de78de36038078dc14b547813962c5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f3de78de36038078dc14b547813962c5-e-8&quot;, &quot;chunk-2b0bf628a95c22fc39c3dcd9f2959fd7-e-1&quot;, &quot;chunk-5d942c8f1c01db54bab51b31faea4836-e-9&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-2b0bf628a95c22fc39c3dcd9f2959fd7-e-2" label="Thermal-elastic-plastic analyses">
        <attvalues>
          <attvalue for="0" value="Thermal-elastic-plastic analyses" />
          <attvalue for="1" value="Analysis Method" />
          <attvalue for="2" value="热-弹-塑性分析是一种耦合热-力学效应的数值分析方法。它通过模拟热处理过程，并综合考虑传热系数与材料的弹塑性本构行为，用于精确预测工件内部最终形成的残余应力场。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-2b0bf628a95c22fc39c3dcd9f2959fd7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-2b0bf628a95c22fc39c3dcd9f2959fd7-e-7" label="Heat transfer coefficients">
        <attvalues>
          <attvalue for="0" value="Heat transfer coefficients" />
          <attvalue for="1" value="Dataset" />
          <attvalue for="2" value="一种描述热量传递速率的物理量数据集。它作为热-弹-塑性分析的关键输入，用于计算温度场，进而预测与零件几何相关的材料变形行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-2b0bf628a95c22fc39c3dcd9f2959fd7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-2b0bf628a95c22fc39c3dcd9f2959fd7-e-8" label="Elastic/plastic constitutive behaviour">
        <attvalues>
          <attvalue for="0" value="Elastic/plastic constitutive behaviour" />
          <attvalue for="1" value="Dataset" />
          <attvalue for="2" value="一个描述材料弹塑性本构行为（如应力-应变关系）的数据集。它是进行热-弹塑性分析必需的输入参数，用于定义材料在不同力学和热载荷作用下的响应特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-2b0bf628a95c22fc39c3dcd9f2959fd7" />
