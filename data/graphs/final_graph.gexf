      <edge source="chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-17" target="chunk-7cf221202ae924d5b8c87acce1ae3bfd-e-4" id="chunk-7cf221202ae924d5b8c87acce1ae3bfd-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_STRONG_CORRELATION_WITH" />
          <attvalue for="12" value="The Larson-Miller parameter (P) is found to have a strong correlation with the logarithm of stress (logσ) in creep tests." />
          <attvalue for="13" value="one usually finds a strong correlation between P and logσ, consistent with the assumptions made." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-7cf221202ae924d5b8c87acce1ae3bfd" />
