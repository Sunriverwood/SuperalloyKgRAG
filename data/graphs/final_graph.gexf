      <edge source="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-e-11" target="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-e-1" id="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DEFINES" />
          <attvalue for="12" value="Equation (2.28b) provides a formula for the ratio (λ₁/L)²." />
          <attvalue for="13" value="(λ₁/L)² = 1/cos{φ/2} = 2T/F (2.28b)" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce" />
