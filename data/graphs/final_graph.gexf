        <attvalues>
          <attvalue for="11" value="USED_FOR" />
          <attvalue for="12" value="Superalloys are the material used to manufacture turbine discs for jet engines." />
          <attvalue for="13" value="Although superalloys have been used for the turbine discs in jet engines for about 50 years, the processing is not without some challenges." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-49fe0f122b885e8929f914d54a677b92" />
