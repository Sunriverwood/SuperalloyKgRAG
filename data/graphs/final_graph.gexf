        <attvalues>
          <attvalue for="11" value="REQUIRES" />
          <attvalue for="12" value="A triclinic crystal requires 21 independent elastic constants, in contrast to a crystal with cubic symmetry." />
          <attvalue for="13" value="Note that the cubic symmetry reduces the number of constants in Cij to three, from the 21 required for a triclinic crystal." />
          <attvalue for="14" value="r-6" />
