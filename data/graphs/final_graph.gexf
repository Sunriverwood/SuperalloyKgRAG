        <attvalues>
          <attvalue for="11" value="IS_TEMPERATURE_OF" />
          <attvalue for="12" value="Turbine entry temperature (TET) is defined as the temperature of the hot gases." />
          <attvalue for="13" value="When designing a gas turbine engine, great emphasis is placed on the choice of the turbine entry temperature (TET): the temperature of the hot gases entering the turbine arrangement [9]." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-8debf02eecb6d1c5cb6982c6f0228498" />
          <attvalue for="16" value="0.04084945811943311" />
          <attvalue for="17" value="0.4245096748716599" />
        </attvalues>
      </edge>
      <edge source="chunk-8debf02eecb6d1c5cb6982c6f0228498-e-2" target="chunk-8debf02eecb6d1c5cb6982c6f0228498-e-6" id="chunk-8debf02eecb6d1c5cb6982c6f0228498-r-6" weight="4.0">
        <attvalues>
          <attvalue for="11" value="CREATES_DEMANDING_CONDITIONS_FOR" />
          <attvalue for="12" value="The conditions at turbine entry, defined by the TET, are the most demanding for the turbomachinery." />
          <attvalue for="13" value="therefore the conditions at turbine entry can be considered to be the most demanding on the turbomachinery and the nickel-based superalloys from which are they made." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-8debf02eecb6d1c5cb6982c6f0228498" />
          <attvalue for="17" value="0.26666666666666666" />
        </attvalues>
