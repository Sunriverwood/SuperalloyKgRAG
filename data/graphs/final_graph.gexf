      <node id="chunk-398a384cc3aa286c4fab7654b4862802-e-4" label="G">
        <attvalues>
          <attvalue for="0" value="G" />
          <attvalue for="1" value="Process Variable" />
          <attvalue for="2" value="在液态金属冷却过程中，G是一个关键过程变量。它与材料凝固后形成的一次枝晶臂间距（Lp）成正比，且其影响作用被认为比另一变量v更为显著。" />
