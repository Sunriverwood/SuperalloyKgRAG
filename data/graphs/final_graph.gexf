        <attvalues>
          <attvalue for="11" value="USED_DURING" />
          <attvalue for="12" value="NDE is used during the manufacturing of the turbine disc." />
          <attvalue for="13" value="...both during the manufacturing of the turbine disc – i.e. before the turbine disc enters service for the first time to ensure that it is of acceptable quality..." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-0cc0ddc3943d8f2fd7c506b872a6a90c" />
