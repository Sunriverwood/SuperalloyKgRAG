        <attvalues>
          <attvalue for="11" value="DEPENDS_ON" />
          <attvalue for="12" value="The occurrence of buckling is determined by the applied stress (σο) relative to the critical stress (σc)." />
          <attvalue for="13" value="Note that when σο is in excess of σc, buckling is expected." />
          <attvalue for="14" value="r-5" />
