      <edge source="chunk-8debf02eecb6d1c5cb6982c6f0228498-e-2" target="chunk-15be551dd91daaae225854c1bc7fcd9d-e-13" id="chunk-7655f48240441662095a40f8fdd54d47-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="MAXIMIZES" />
          <attvalue for="12" value="A high turbine entry temperature (T₄) is required to maximize the useful work (UW)." />
          <attvalue for="13" value="These considerations demonstrate that the turbine entry temperature, T₄, needs to be as high as possible, if the useful work is to be maximised." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-7655f48240441662095a40f8fdd54d47" />
          <attvalue for="16" value="0.017872552030772385" />
          <attvalue for="17" value="0.41072353121846344" />
        </attvalues>
      </edge>
      <edge source="chunk-8debf02eecb6d1c5cb6982c6f0228498-e-2" target="chunk-d0bef0969eda4d511c2167bafe9aeae0-e-13" id="chunk-7655f48240441662095a40f8fdd54d47-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="REQUIRES_BALANCE_WITH" />
          <attvalue for="12" value="A balance is required between a high Turbine Entry Temperature (TET) and a large enough Overall Pressure Ratio (OPR)." />
          <attvalue for="13" value="There does, however, need to be a balance between a high TET and a large enough OPR; see Figure 1.13." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-7655f48240441662095a40f8fdd54d47" />
          <attvalue for="16" value="0.0004607081742793208" />
          <attvalue for="17" value="0.4002764249045676" />
        </attvalues>
      </edge>
