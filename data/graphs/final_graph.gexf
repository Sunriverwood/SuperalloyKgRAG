      <node id="chunk-fb8636aebcb8b8d854ebe34fb885b102-e-5" label="E. Goldman">
        <attvalues>
          <attvalue for="0" value="E. Goldman" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="E. Goldman，一位作者或研究人员，以其作为出版物《Protective coatings》（意为“防护涂层”）的合著者而闻名。这部著作的内容专注于材料科学或化学工程领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
