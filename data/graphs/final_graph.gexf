      <node id="chunk-cb57093a6357773efc0ab02b57f76fa1-e-12" label="Japan">
        <attvalues>
          <attvalue for="0" value="Japan" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="日本是一个位于东亚的岛屿国家，地处太平洋西部，由北海道、本州、四国、九州四大岛及数千小岛组成，首都是东京。该国是世界公认的经济、科技和文化强国。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-cb57093a6357773efc0ab02b57f76fa1" />
