        <attvalues>
          <attvalue for="11" value="FORMS_ON" />
          <attvalue for="12" value="An external scale of NiO forms on the alloy during oxidation." />
          <attvalue for="13" value="During the oxidation of the Ni-rich, Group I-type Ni-Cr-Al alloys, an external scale of NiO forms." />
