        <attvalues>
          <attvalue for="11" value="DRIVES_ENHANCEMENT_OF" />
          <attvalue for="12" value="The drive to raise the TET has provided the incentive to enhance the temperature capability of superalloys." />
          <attvalue for="13" value="this has provided the incentive and technological impetus to enhance the temperature capability of the superalloys" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-97c05a1094ea39aa5f2616ca79a05f13" />
          <attvalue for="17" value="0.4" />
        </attvalues>
