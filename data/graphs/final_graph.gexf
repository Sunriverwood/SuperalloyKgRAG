        <attvalues>
          <attvalue for="11" value="HAS_PROPERTY" />
          <attvalue for="12" value="A modern civil turbofan aeroengine has a bypass ratio between 6:1 and 9:1." />
          <attvalue for="13" value="These considerations explain why a modern civil turbofan aeroengine has a bypass ratio between 6:1 and perhaps 9:1 to develop reasonable ηprop and SFC." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-0e6d1a98cce4649fa0a9b324b03113ce" />
