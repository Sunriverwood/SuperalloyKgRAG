        <attvalues>
          <attvalue for="11" value="IS_PROPERTY_OF" />
          <attvalue for="12" value="The value of S44 is a property of pure nickel." />
          <attvalue for="13" value="For pure nickel at room temperature, typical values are S11 = 0.799 × 10−5/MPa, S12 = -0.312 × 10-5/MPa and S44 = 0.844 × 10-5/MPa." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-7319e10c21751146ade723f5be6c80d4" />
          <attvalue for="16" value="0.007215007215007216" />
          <attvalue for="17" value="0.40432900432900437" />
        </attvalues>
      </edge>
      <edge source="chunk-7468b5a535de86347797d4977b885a9e-e-6" target="chunk-7319e10c21751146ade723f5be6c80d4-e-11" id="chunk-7319e10c21751146ade723f5be6c80d4-r-7" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_INVERSE_OF" />
          <attvalue for="12" value="The compliance constant S44 is the mathematical inverse of the stiffness constant C44." />
          <attvalue for="13" value="S44 = 1/C44" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-7319e10c21751146ade723f5be6c80d4" />
          <attvalue for="16" value="0.002886002886002886" />
          <attvalue for="17" value="0.4017316017316018" />
        </attvalues>
      </edge>
      <edge source="chunk-7468b5a535de86347797d4977b885a9e-e-6" target="chunk-7468b5a535de86347797d4977b885a9e-e-7" id="chunk-7468b5a535de86347797d4977b885a9e-r-5" weight="4.0">
        <attvalues>
          <attvalue for="11" value="IS_DERIVED_FROM" />
          <attvalue for="12" value="The value of S44 is a component or result of the elasticity equations." />
          <attvalue for="13" value="From the elasticity equations, one can see that this is largely controlled by the value of S44" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-7468b5a535de86347797d4977b885a9e" />
          <attvalue for="16" value="0.002886002886002886" />
          <attvalue for="17" value="0.2683982683982684" />
        </attvalues>
      </edge>
      <edge source="chunk-7468b5a535de86347797d4977b885a9e-e-6" target="chunk-7468b5a535de86347797d4977b885a9e-e-8" id="chunk-7468b5a535de86347797d4977b885a9e-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CAN_BE_TRANSFORMED_TO" />
          <attvalue for="12" value="The elasticity constant S44 can be transformed to S'44." />
          <attvalue for="13" value="One can transform S44 to S'44 using similar methods" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-7468b5a535de86347797d4977b885a9e" />
          <attvalue for="16" value="0.0003092145949288806" />
          <attvalue for="17" value="0.40018552875695734" />
        </attvalues>
      </edge>
      <edge source="chunk-7468b5a535de86347797d4977b885a9e-e-6" target="chunk-488553ca8f86a8be784d625006ec53f4-e-4" id="chunk-488553ca8f86a8be784d625006ec53f4-r-3" weight="4.0">
        <attvalues>
          <attvalue for="11" value="IS_INPUT_TO" />
          <attvalue for="12" value="The compliance constant S44 is a variable in Equation A7." />
          <attvalue for="13" value="S'44 = S44 + (2S11 - 2S12 - S44) × 4 sin²θ cos²θ = S44 + (2S11 - 2S12 - S44) × sin²2θ/2 (A7)" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-488553ca8f86a8be784d625006ec53f4" />
          <attvalue for="16" value="0.0007558578987150415" />
          <attvalue for="17" value="0.26712018140589566" />
        </attvalues>
      </edge>
      <edge source="chunk-7468b5a535de86347797d4977b885a9e-e-6" target="chunk-488553ca8f86a8be784d625006ec53f4-e-5" id="chunk-59efde3cc28eec2ad611a5941651c5d8-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="EQUALS" />
          <attvalue for="12" value="The compliance component S44 is equal to 2(S11 – S12)." />
          <attvalue for="13" value="Since S44 = 2(S11 – S12), only two of E, v and G are independent" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-59efde3cc28eec2ad611a5941651c5d8" />
          <attvalue for="16" value="0.0017522160379303236" />
          <attvalue for="17" value="0.4010513296227582" />
        </attvalues>
      </edge>
      <edge source="chunk-7468b5a535de86347797d4977b885a9e-e-6" target="chunk-488553ca8f86a8be784d625006ec53f4-e-6" id="chunk-59efde3cc28eec2ad611a5941651c5d8-r-7" weight="5.0">
        <attvalues>
          <attvalue for="11" value="EQUALS" />
          <attvalue for="12" value="The compliance component S44 is equal to 2(S11 – S12)." />
          <attvalue for="13" value="Since S44 = 2(S11 – S12), only two of E, v and G are independent" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-59efde3cc28eec2ad611a5941651c5d8" />
          <attvalue for="16" value="0.0035044320758606472" />
          <attvalue for="17" value="0.4021026592455164" />
        </attvalues>
      </edge>
      <edge source="chunk-7468b5a535de86347797d4977b885a9e-e-8" target="chunk-7468b5a535de86347797d4977b885a9e-e-6" id="chunk-488553ca8f86a8be784d625006ec53f4-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_TRANSFORMATION_OF" />
          <attvalue for="12" value="S'44 is the result of transforming S44 through a rotation by an arbitrary angle θ." />
          <attvalue for="13" value="One can transform S44 to S'44 using similar methods used to determine S'11 above; one can show that the rotation through an arbitrary angle θ is accomplished via" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-488553ca8f86a8be784d625006ec53f4" />
          <attvalue for="16" value="0.0027829313543599257" />
          <attvalue for="17" value="0.40166975881261596" />
        </attvalues>
