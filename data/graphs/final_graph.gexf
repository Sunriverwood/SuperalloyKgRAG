      <node id="chunk-fd08a4d01f900e8f06f5ce2b9d625965-e-6" label="Equation (2.29)">
        <attvalues>
          <attvalue for="0" value="Equation (2.29)" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="方程(2.29)是一个用于估算切削应力(τc)的数学公式。该公式的计算综合了反相畴界能(γAPB)、摩擦应力(f)、半径(r)、剪切模量(G)和伯氏矢量(b)等关键物理变量。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;τc = (γAPB / 2b) * [((6γAPBrf) / (πT))¹/² − f]&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-fd08a4d01f900e8f06f5ce2b9d625965" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fd08a4d01f900e8f06f5ce2b9d625965-e-6&quot;, &quot;chunk-88fbc7a52ff45f9431f17e23dd2d49a1-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-fd08a4d01f900e8f06f5ce2b9d625965-e-8" label="r">
        <attvalues>
          <attvalue for="0" value="r" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="`r` 是一个变量，用于替代 `r₁`，旨在确保计算结果在均匀粒子分布的特定条件下有效。" />
          <attvalue for="3" value="{}" />
