        <attvalues>
          <attvalue for="11" value="IS_EVALUATED_AT" />
          <attvalue for="12" value="The elastic modulus is evaluated at different crystallographic orientations." />
          <attvalue for="13" value="one go about evaluating the elastic modulus at different crystallographic orientations, for example, along a direction with direction cosines l1, l2, l3 defined relative to the 1, 2, 3 axes?" />
          <attvalue for="14" value="r-1" />
