        <attvalues>
          <attvalue for="11" value="EVALUATED_FOR" />
          <attvalue for="12" value="Alloys of varying compositions are evaluated for their creep performance under specific conditions." />
          <attvalue for="13" value="alloys of varying compositions and their creep performance under loading at 1100 °C and 137 MPa" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-aad5a5786d03a03d8f644b4cda7a85fb" />
