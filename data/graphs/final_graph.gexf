      <node id="chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-11" label="V">
        <attvalues>
          <attvalue for="0" value="V" />
          <attvalue for="1" value="Abbreviation" />
          <attvalue for="2" value="V，英文缩写词，是“vane”的简称。Vane指风向标、叶轮或涡轮机上的叶片、翼片等装置，用于引导或利用流体（如空气或水）的流动。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-f2dcbd0ede6add46d4e0540d9a794efa" />
