        <attvalues>
          <attvalue for="11" value="IS_CALCULATED_USING" />
          <attvalue for="12" value="Go is calculated using the variable ν, which has a value of 0.3." />
          <attvalue for="13" value="Inserting reasonable values for the variables, for example, E|| = 20 GPa, ν = 0.3, h = 100 µm and єT = 5 × 10−3, one finds that Go is about 25 J/m²." />
          <attvalue for="14" value="r-7" />
