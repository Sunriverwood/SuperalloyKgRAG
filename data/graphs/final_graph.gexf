      <edge source="chunk-488553ca8f86a8be784d625006ec53f4-e-6" target="chunk-488553ca8f86a8be784d625006ec53f4-e-4" id="chunk-488553ca8f86a8be784d625006ec53f4-r-5" weight="4.0">
        <attvalues>
          <attvalue for="11" value="IS_INPUT_TO" />
          <attvalue for="12" value="The compliance constant S12 is a variable in Equation A7." />
          <attvalue for="13" value="S'44 = S44 + (2S11 - 2S12 - S44) × 4 sin²θ cos²θ = S44 + (2S11 - 2S12 - S44) × sin²2θ/2 (A7)" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-488553ca8f86a8be784d625006ec53f4" />
          <attvalue for="16" value="0.0006527863670720813" />
          <attvalue for="17" value="0.2670583384869099" />
