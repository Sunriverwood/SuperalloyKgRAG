        <attvalues>
          <attvalue for="11" value="ARE_PRECURSORS_TO" />
          <attvalue for="12" value="Chemical factors are precursors to failure." />
          <attvalue for="13" value="there is a need to identify and quantify the chemical and mechanical factors which are the precursors to failure." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-6b3f56bd4325c1b8abc874fe75903d49" />
          <attvalue for="16" value="8.94854586129754e-05" />
