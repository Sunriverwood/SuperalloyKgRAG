          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9de67a861b4260c65467b4b0d1d09a13-e-12&quot;, &quot;chunk-b740c8122a3674caed65056e75488d1f-e-2&quot;]}]" />
          <attvalue for="9" value="43" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b740c8122a3674caed65056e75488d1f-e-3" label="I. R. McGill">
        <attvalues>
          <attvalue for="0" value="I. R. McGill" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="I. R. McGill是一位研究人员，撰写了科技出版物《燃气轮机叶片的保护：铂铝化物扩散涂层》。其研究工作聚焦于材料科学与工程领域，具体探讨了通过铂铝化物扩散涂层来保护高温合金部件的技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-b740c8122a3674caed65056e75488d1f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="43" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b740c8122a3674caed65056e75488d1f-e-4" label="The protection of gas turbine blades: a platinum aluminide diffusion coating">
        <attvalues>
          <attvalue for="0" value="The protection of gas turbine blades: a platinum aluminide diffusion coating" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由 R. G. Wing 与 I. R. McGill 合著的学术文章，发表于《Platinum Metals Review》期刊。该文论述了用于燃气轮机叶片保护的铂铝化物扩散涂层技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-b740c8122a3674caed65056e75488d1f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="43" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-b740c8122a3674caed65056e75488d1f-e-5" label="Platinum Metals Review">
        <attvalues>
          <attvalue for="0" value="Platinum Metals Review" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《铂金属评论》(Platinum Metals Review) 是一份由庄信万丰 (Johnson Matthey) 公司出版的科技季刊 (1957-2014)。该期刊专注于铂族金属的科学、技术及工业应用，发表相关领域的评论与研究报告，涵盖催化、冶金、涂层等方面。现已被《庄信万丰科技评论》取代。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;25&quot;, &quot;year&quot;: &quot;1981&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-b740c8122a3674caed65056e75488d1f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="43" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b740c8122a3674caed65056e75488d1f-e-6" label="Gas turbine blades">
        <attvalues>
          <attvalue for="0" value="Gas turbine blades" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="燃气轮机叶片是燃气轮机的核心翼型部件，用于在极端高温高压环境下，从高速燃气流中提取能量。为抵御高温氧化和腐蚀，其表面通常需要涂覆铂铝扩散涂层等先进的热障涂层进行保护。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-b740c8122a3674caed65056e75488d1f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b740c8122a3674caed65056e75488d1f-e-8" label="M. R. Jackson">
        <attvalues>
          <attvalue for="0" value="M. R. Jackson" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="M. R. Jackson，科学出版物《The aluminisation of platinum and platinum-coated IN-738》的作者。该著作研究了铂以及涂有铂的IN-738合金的渗铝工艺。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-b740c8122a3674caed65056e75488d1f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b740c8122a3674caed65056e75488d1f-e-9" label="J. R. Rairden">
        <attvalues>
          <attvalue for="0" value="J. R. Rairden" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="J. R. Rairden是一位研究人员，作为作者之一参与撰写了学术出版物《The aluminisation of platinum and platinum-coated IN-738》。该著作主要研究铂及铂涂层IN-738超合金的渗铝技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-b740c8122a3674caed65056e75488d1f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b740c8122a3674caed65056e75488d1f-e-9&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b740c8122a3674caed65056e75488d1f-e-10" label="The aluminisation of platinum and platinum-coated IN-738">
        <attvalues>
          <attvalue for="0" value="The aluminisation of platinum and platinum-coated IN-738" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由M. R. Jackson与J. R. Rairden合著，发表于《Metallurgical Transactions》的一篇科学论文。该出版物主要探讨了在铂（Platinum）以及铂涂层IN-738合金上进行渗铝的工艺过程与效果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-b740c8122a3674caed65056e75488d1f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b740c8122a3674caed65056e75488d1f-e-10&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-b740c8122a3674caed65056e75488d1f-e-11" label="Metallurgical Transactions">
        <attvalues>
          <attvalue for="0" value="Metallurgical Transactions" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《Metallurgical Transactions》是由TMS（矿物、金属与材料学会）和ASM International（国际材料信息学会）联合出版的同行评审学术期刊系列。该期刊专注于冶金学和材料科学领域，发表关于材料加工、物理冶金和材料科学的原创研究，现分为A、B、E等分刊。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;8A&quot;, &quot;year&quot;: &quot;1977&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-b740c8122a3674caed65056e75488d1f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b740c8122a3674caed65056e75488d1f-e-11&quot;, &quot;chunk-819db6cd818e9e8d5c81db94051547db-e-6&quot;, &quot;chunk-62f2a69b28a3f59402f17b59e67f8707-e-3&quot;, &quot;chunk-06ba6595cab42702f10c3f20f15fc2ee-e-3&quot;, &quot;chunk-8858e7b554c309b2b183ee00a5fadc99-e-1&quot;, &quot;chunk-99354e5831501ba1d07293128331db80-e-4&quot;, &quot;chunk-4897104ddb336b2f8f129d218c5a2cc4-e-10&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-b740c8122a3674caed65056e75488d1f-e-13" label="IN-738">
        <attvalues>
          <attvalue for="0" value="IN-738" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="IN-738是一种镍基高温合金。在文中它作为一种基材，经过表面镀铂和随后的渗铝工艺处理，以形成能抵抗高温腐蚀和氧化的铂铝化物保护涂层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-b740c8122a3674caed65056e75488d1f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b740c8122a3674caed65056e75488d1f-e-13&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b740c8122a3674caed65056e75488d1f-e-14" label="A. L. Purvis">
        <attvalues>
          <attvalue for="0" value="A. L. Purvis" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="A. L. Purvis是一位研究人员，其研究领域涉及材料科学。他是《铂浓度对单相铝铂涂层高温合金抗氧化性的影响》(The effects of platinum concentration on the oxidation resistance of superalloys coated with single-phase platinum alum) 这一出版物的作者。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-b740c8122a3674caed65056e75488d1f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="58" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b740c8122a3674caed65056e75488d1f-e-15" label="B. W. Warnes">
        <attvalues>
          <attvalue for="0" value="B. W. Warnes" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="B. W. Warnes是一位研究人员，他撰写了一篇关于铂浓度对单相铂铝化物涂层超合金抗氧化性影响的学术著作。他的研究聚焦于材料科学，特别是高温合金涂层的性能优化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-b740c8122a3674caed65056e75488d1f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b740c8122a3674caed65056e75488d1f-e-15&quot;]}]" />
          <attvalue for="9" value="58" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b740c8122a3674caed65056e75488d1f-e-16" label="The effects of platinum concentration on the oxidation resistance of superalloys coated with single-phase platinum alum">
        <attvalues>
          <attvalue for="0" value="The effects of platinum concentration on the oxidation resistance of superalloys coated with single-phase platinum alum" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由A. L. Purvis和B. W. Warnes合著的一篇科学出版物。该文研究了在单相铂铝化物涂层中，不同铂（Pt）浓度对高温合金基体抗氧化性能的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-b740c8122a3674caed65056e75488d1f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="58" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-b740c8122a3674caed65056e75488d1f-e-17" label="Superalloys">
        <attvalues>
          <attvalue for="0" value="Superalloys" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="高温合金（Superalloys），或称超合金，是一类能在高温下保持优异机械强度、抗蠕变、抗氧化和抗腐蚀性能的金属材料。它们通常以镍、钴或铁为基体，是制造航空发动机、燃气轮机等高温环境下关键部件的核心材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-17" />
          <attvalue for="5" value="chunk-b740c8122a3674caed65056e75488d1f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="58" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b740c8122a3674caed65056e75488d1f-e-18" label="Platinum concentration">
        <attvalues>
          <attvalue for="0" value="Platinum concentration" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="指高温合金中铂(Pt)元素的含量或浓度。它是一个关键的材料属性，能够显著影响并提升该合金在高温环境下的抗氧化性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-18" />
          <attvalue for="5" value="chunk-b740c8122a3674caed65056e75488d1f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="58" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-23667ab4826d0039e851f5cb53aa5455-e-2" label="Superalloys">
        <attvalues>
          <attvalue for="0" value="Superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="超级合金（Superalloy）是一类金属材料，通常以镍、钴或铁为基体，能在高温下保持卓越的机械强度、抗蠕变和抗腐蚀性能。因其出色的高温特性，被广泛用于制造航空发动机和燃气轮机的热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-23667ab4826d0039e851f5cb53aa5455" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-23667ab4826d0039e851f5cb53aa5455-e-4" label="Pt content">
        <attvalues>
          <attvalue for="0" value="Pt content" />
          <attvalue for="1" value="Composition Variable" />
          <attvalue for="2" value="铂含量（Pt content）是衡量铂铝化物涂层中铂元素组分的变量。作为关键的成分参数，它直接影响涂层的微观结构发展和最终的抗氧化性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-23667ab4826d0039e851f5cb53aa5455" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-23667ab4826d0039e851f5cb53aa5455-e-5" label="microstructural development">
        <attvalues>
          <attvalue for="0" value="microstructural development" />
          <attvalue for="1" value="Material Characteristic" />
          <attvalue for="2" value="指材料在加工或服役过程中，其内部微观组织（如晶粒、相、织构及缺陷）的形成与演变的动态过程。此过程由成分、温度和应力等因素控制，并最终决定材料的宏观物理及力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-23667ab4826d0039e851f5cb53aa5455" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-23667ab4826d0039e851f5cb53aa5455-e-5&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-23667ab4826d0039e851f5cb53aa5455-e-6" label="high activity aluminizing process">
        <attvalues>
          <attvalue for="0" value="high activity aluminizing process" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="高活性工艺是一种用于制备铂铝涂层的制造方法。该工艺利用高活性的铝源，通过化学气相沉积或包埋法等技术，在基材表面形成富铝的铂铝化合物保护层，以提供优异的高温抗氧化和抗腐蚀性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-23667ab4826d0039e851f5cb53aa5455" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;high activity processes&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-23667ab4826d0039e851f5cb53aa5455-e-6&quot;, &quot;chunk-27d4439c082e1df0f703012a02b14ffb-e-3&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-819db6cd818e9e8d5c81db94051547db-e-1" label="Engineering">
        <attvalues>
          <attvalue for="0" value="Engineering" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《Engineering》是由中国工程院（CAE）于2015年创办的旗舰学术期刊。该刊为全英文、开放获取，旨在快速报道全球工程科技领域的重大突破与重要进展，覆盖所有工程学科。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;251A&quot;, &quot;year&quot;: &quot;1998&quot;, &quot;pages&quot;: &quot;40–47&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-819db6cd818e9e8d5c81db94051547db" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="339" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-819db6cd818e9e8d5c81db94051547db-e-2" label="Y. Zhang">
        <attvalues>
          <attvalue for="0" value="Y. Zhang" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="Y. Zhang是一位研究人员，作为作者之一发表了学术论文《Effect of Pt incorporation on the isothermal oxidation behaviour of chemical vapour deposition aluminide coatings》。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-819db6cd818e9e8d5c81db94051547db" />
