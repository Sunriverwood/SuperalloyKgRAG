        <attvalues>
          <attvalue for="11" value="DEPENDS_ON" />
          <attvalue for="12" value="The calculation of compressive stress (σc) depends on the blister width (2b, via the half-width 'b') as per Equation 5.3." />
          <attvalue for="13" value="σc = (π² / 12) * (E|| / (1 - ν²)) * (h/b)² (5.3)" />
