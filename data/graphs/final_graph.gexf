      </node>
      <node id="chunk-c026408b0eb125d3c56d1ed05d0a0f15-e-6" label="r¹/² dependence">
        <attvalues>
          <attvalue for="0" value="r¹/² dependence" />
          <attvalue for="1" value="Physical Law" />
          <attvalue for="2" value="r¹/² 依赖关系是一种物理定律，指材料的临界剪切应力(τc)与强化相颗粒半径(r)的平方根成线性正比关系。该定律通常用于描述位错切过小颗粒的强化机制，在单晶镍铝合金等材料中被观察到，但对于大尺寸颗粒则不再适用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c026408b0eb125d3c56d1ed05d0a0f15" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
