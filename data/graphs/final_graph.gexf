          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5b143324ae92718a4dde1cd69bd72bd2-e-10" label="Nickel-64">
        <attvalues>
          <attvalue for="0" value="Nickel-64" />
          <attvalue for="1" value="Isotope" />
          <attvalue for="2" value="镍-64（符号：⁶⁴Ni）是元素镍的一种稳定同位素，其原子核由28个质子和36个中子构成。它是镍的五种稳定同位素之一，在自然界的丰度约为0.93%。" />
          <attvalue for="3" value="{&quot;probability&quot;: &quot;1.16%&quot;}" />
          <attvalue for="4" value="e-10" />
