      <node id="chunk-b740c8122a3674caed65056e75488d1f-e-2" label="R. G. Wing">
        <attvalues>
          <attvalue for="0" value="R. G. Wing" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="R. G. Wing 是一位作者与研究人员，其专业领域涉及材料科学或工程。他因合著出版物《燃气轮机叶片的保护：一种铂铝化物扩散涂层》(The protection of gas turbine blades: a platinum aluminide diffusion coating) 而知名，该著作专注于研究用于保护高温涡轮部件的先进涂层技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
