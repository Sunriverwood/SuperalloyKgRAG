        <attvalues>
          <attvalue for="0" value="n_i" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="变量 n_i，是在特定数学表达式中，用于计算另一参数 p4 的一个组成部分或输入值。" />
