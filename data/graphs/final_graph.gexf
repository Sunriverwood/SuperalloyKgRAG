        <attvalues>
          <attvalue for="11" value="USED_IN" />
          <attvalue for="12" value="Nickel-based superalloys are used in the combustor section of the engine." />
          <attvalue for="13" value="However, in the combustor and turbine arrangements, the nickel-based superalloys are used almost exclusively." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-c1f941cda4f8b36efca8168f378f1be7" />
          <attvalue for="17" value="0.4" />
