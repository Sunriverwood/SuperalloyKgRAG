          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6dac0a4c73567f8946fa9c50957af9ca-e-13" label="thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="thermal barrier coatings" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="热障涂层是一种应用于金属部件表面的先进陶瓷材料系统。它通过提供优异的隔热效果，保护基体免受高温、氧化和腐蚀的损害，从而显著提高航空发动机、燃气轮机等高温部件的工作温度与服役寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-6dac0a4c73567f8946fa9c50957af9ca" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6dac0a4c73567f8946fa9c50957af9ca-e-15" label="D. E. Wolfe">
        <attvalues>
          <attvalue for="0" value="D. E. Wolfe" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. E. Wolfe是一位学者，研究领域为热障涂层。他是关于电子束物理气相沉积（EB-PVD）8YSZ热障涂层微观结构设计的论文《Tailored microstructure of EB-PVD 8YSZ thermal barrier coatings》的作者之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-6dac0a4c73567f8946fa9c50957af9ca" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6dac0a4c73567f8946fa9c50957af9ca-e-16" label="J. Singh">
        <attvalues>
          <attvalue for="0" value="J. Singh" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="J. Singh是一位材料科学领域的研究者。他是学术论文《Tailored microstructure of EB-PVD 8YSZ thermal barrier coatings》的作者之一，该论文主要研究电子束物理气相沉积（EB-PVD）制备的8YSZ热障涂层的定制化微观结构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-6dac0a4c73567f8946fa9c50957af9ca" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6dac0a4c73567f8946fa9c50957af9ca-e-17" label="R. A. Miller">
        <attvalues>
          <attvalue for="0" value="R. A. Miller" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="R. A. Miller是一位研究人员，他与J. L. Smialek及R. G. Garlik合作，共同研究并发表了关于“等离子喷涂部分稳定氧化锆-氧化钇” (plasma-sprayed partially stabilised zirconia-yttria) 中相稳定性的论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-17" />
          <attvalue for="5" value="chunk-6dac0a4c73567f8946fa9c50957af9ca" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6dac0a4c73567f8946fa9c50957af9ca-e-17&quot;, &quot;chunk-e215022d1d6f514980641a512c1ab4f3-e-11&quot;, &quot;chunk-fc5aa264fb28225ff63c38a7e3698291-e-2&quot;, &quot;chunk-27fe0e6f1cc64567c0f71ef94ca1d008-e-7&quot;, &quot;chunk-67429b99cdb3121ddbb638d5930365e4-e-4&quot;, &quot;chunk-5e278081cfff8673fd80e9618e358fc2-e-1&quot;]}]" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-6dac0a4c73567f8946fa9c50957af9ca-e-18" label="J. I. Eldridge">
        <attvalues>
          <attvalue for="0" value="J. I. Eldridge" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="一位材料科学领域的研究人员，其研究方向为热障涂层。他是科学论文《Tailored microstructure of EB-PVD 8YSZ thermal barrier coatings》的作者，该论文探讨了通过电子束物理气相沉积技术制备的特定涂层的微观结构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-18" />
          <attvalue for="5" value="chunk-6dac0a4c73567f8946fa9c50957af9ca" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6dac0a4c73567f8946fa9c50957af9ca-e-20" label="EB-PVD 8YSZ thermal barrier coating">
        <attvalues>
          <attvalue for="0" value="EB-PVD 8YSZ thermal barrier coating" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="一种采用电子束物理气相沉积(EB-PVD)技术，以8mol%氧化钇稳定氧化锆(8YSZ)为材料制备的先进陶瓷涂层。其独特的柱状晶微观结构是其关键特征，可为航空发动机涡轮叶片等高温部件提供优异的隔热保护和应变容限。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-20" />
          <attvalue for="5" value="chunk-6dac0a4c73567f8946fa9c50957af9ca" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;EB-PVD 8YSZ thermal barrier coatings&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6dac0a4c73567f8946fa9c50957af9ca-e-20&quot;, &quot;chunk-2b7a9fe88ca8d6ac202cedf8f0e4d421-e-3&quot;]}]" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6dac0a4c73567f8946fa9c50957af9ca-e-21" label="Mechanisms controlling the durability of thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="Mechanisms controlling the durability of thermal barrier coatings" />
          <attvalue for="1" value="Academic Work" />
          <attvalue for="2" value="一篇由A. G. Evans等人撰写并发表在《材料科学进展》期刊的学术论文。该文作为该领域的经典综述，系统性地探讨了控制热障涂层（TBCs）在高温下长期服役时耐久性的关键物理与化学机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-21" />
          <attvalue for="5" value="chunk-6dac0a4c73567f8946fa9c50957af9ca" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
