        <attvalues>
          <attvalue for="11" value="HAS_CONCERN" />
          <attvalue for="12" value="A principal concern during the production of the disc is to avoid promoting excessive grain growth." />
          <attvalue for="13" value="The principal concern at this stage is not to promote excessive grain growth." />
