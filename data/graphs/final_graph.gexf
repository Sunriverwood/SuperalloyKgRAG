      <node id="chunk-491e59c42061a40a1fe533ef4ec8d245-e-8" label="Y. Itoh">
        <attvalues>
          <attvalue for="0" value="Y. Itoh" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="Y. Itoh是一名材料科学领域的学者。根据其发表的论文，其研究专长在于氧化铪基热障涂层的电子束物理气相沉积（EB-PVD）工艺及其热性能分析。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
