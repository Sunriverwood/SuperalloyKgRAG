        <attvalues>
          <attvalue for="11" value="USES_TERM" />
          <attvalue for="12" value="Equation (A5b) for S'11 uses the compliance constant S12." />
          <attvalue for="13" value="S'11 = S11(l1^4 + l2^4 + l3^4) + 2S12(l1^2l2^2 + l1^2l3^2 + l2^2l3^2) + S44(l2^2l3^2 + l1^2l3^2 + l1^2l2^2) (A5b)" />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-04d8e878969e6a9500600ef092423800" />
          <attvalue for="16" value="0.0020242914979757085" />
          <attvalue for="17" value="0.4012145748987854" />
        </attvalues>
      </edge>
      <edge source="chunk-04d8e878969e6a9500600ef092423800-e-9" target="chunk-04d8e878969e6a9500600ef092423800-e-5" id="chunk-04d8e878969e6a9500600ef092423800-r-9" weight="5.0">
        <attvalues>
          <attvalue for="11" value="USES_TERM" />
          <attvalue for="12" value="Equation (A5b) for S'11 uses the compliance constant S44." />
          <attvalue for="13" value="S'11 = S11(l1^4 + l2^4 + l3^4) + 2S12(l1^2l2^2 + l1^2l3^2 + l2^2l3^2) + S44(l2^2l3^2 + l1^2l3^2 + l1^2l2^2) (A5b)" />
          <attvalue for="14" value="r-9" />
