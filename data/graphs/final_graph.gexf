          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b9dbde7895f392734e33f1d55d95cc73-e-9&quot;, &quot;chunk-413a7900ebed3c0bb042bc07c13cf29f-e-2&quot;]}]" />
          <attvalue for="9" value="35" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b9dbde7895f392734e33f1d55d95cc73-e-10" label="N. G. Bychkov">
        <attvalues>
          <attvalue for="0" value="N. G. Bychkov" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="N. G. Bychkov是一位作者，以其在材料科学领域的出版物《涂层的热机械疲劳试验》（'Thermo-mechanical fatigue tests of coatings'）而闻名。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
