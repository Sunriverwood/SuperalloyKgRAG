          <attvalue for="11" value="DEFINED_BY" />
          <attvalue for="12" value="The variable for cutting stress, τc, is defined by Equation (2.29)." />
          <attvalue for="13" value="τc = (γAPB / 2b) * [((6γAPBrf) / (πT))¹/² − f] (2.29)" />
