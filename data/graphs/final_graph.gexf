        <attvalues>
          <attvalue for="11" value="INFLUENCES" />
          <attvalue for="12" value="The text states that in practice, TET has a stronger influence on turbine engine performance than predicted by calculations." />
          <attvalue for="13" value="Why, in practice, is there a stronger influence from the TET than predicted by the calculations?" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-5ef6f14d86770095e6f2e178382f2c4c" />
