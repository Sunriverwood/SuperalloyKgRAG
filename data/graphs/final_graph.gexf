      </node>
      <node id="chunk-54db0fe1dd89cd8e8ede6b8d3623ba34-e-1" label="L">
        <attvalues>
          <attvalue for="0" value="L" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="一个由变量Nv和r₁所决定的物理或数学量。该变量与λ₁存在特定的方程关系，其具体数值由上下文中的两个不同方程定义和计算。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-54db0fe1dd89cd8e8ede6b8d3623ba34" />
