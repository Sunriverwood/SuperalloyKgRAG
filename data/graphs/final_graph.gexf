      <node id="chunk-e3a2ad2f86c91d0494cd03450bd94ade-e-8" label="TMS-82+">
        <attvalues>
          <attvalue for="0" value="TMS-82+" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="TMS-82+是一种由日本国立材料科学研究所(NIMS)研发的第三代单晶镍基高温合金。该合金通过添加铼(Re)等元素，获得了卓越的高温强度、抗蠕变和抗氧化性能，是制造先进航空发动机和燃气轮机涡轮叶片等关键热端部件的核心材料。" />
          <attvalue for="3" value="{&quot;references&quot;: &quot;167, 178, 179&quot;}" />
