      <node id="chunk-54db0fe1dd89cd8e8ede6b8d3623ba34-e-6" label="A">
        <attvalues>
          <attvalue for="0" value="A" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="变量A是一个其值可由另两个变量h与λ₁的乘积来近似计算的物理或数学量。其数学关系表达式为 A ≈ h·λ₁。" />
          <attvalue for="3" value="{}" />
