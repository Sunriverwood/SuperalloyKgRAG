          <attvalue for="11" value="DEFINED_BY" />
          <attvalue for="12" value="Thermal efficiency is defined as the ratio of useful work to the work of combustion." />
          <attvalue for="13" value="The thermal efficiency is defined as the ratio of useful work to the work of combustion" />
