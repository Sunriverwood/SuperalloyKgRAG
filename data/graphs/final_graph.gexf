          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-fd08a4d01f900e8f06f5ce2b9d625965-e-11" label="[(6γAPBfr/(πT))¹/² − f]">
        <attvalues>
          <attvalue for="0" value="[(6γAPBfr/(πT))¹/² − f]" />
          <attvalue for="1" value="Expression" />
          <attvalue for="2" value="一个用于修正切割应力初始估算值（γAPB/b）的数学因子。在材料科学中，该表达式通过考虑额外的物理效应（如温度、应变率等），对初始应力进行调整，以获得更精确的计算结果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-fd08a4d01f900e8f06f5ce2b9d625965" />
