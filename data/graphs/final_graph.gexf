      </node>
      <node id="chunk-f23caa328479b9d419f0d855b9335eb4-e-20" label="Nimonic 80A">
        <attvalues>
          <attvalue for="0" value="Nimonic 80A" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="Nimonic 80A是一种钛、铝强化的时效硬化型镍铬基高温合金。它以其在高达815°C时仍具备的卓越高温强度、抗蠕变性和抗氧化性而著称。主要用于制造燃气轮机叶片、高性能发动机阀门、紧固件等在高温高应力环境下工作的关键部件。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;48, 99, 101, 1&quot;}" />
          <attvalue for="4" value="e-20" />
          <attvalue for="5" value="chunk-f23caa328479b9d419f0d855b9335eb4" />
          <attvalue for="6" value="true" />
