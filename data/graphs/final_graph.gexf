      </node>
      <node id="chunk-833b212eb3a569521f9a95be24874ec1-e-4" label="M. F. Ashby">
        <attvalues>
          <attvalue for="0" value="M. F. Ashby" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="迈克尔·F·阿什比 (Michael F. Ashby)，英国著名材料科学家，剑桥大学教授。他在材料科学与选择领域做出开创性贡献，以其创建的“阿什比图”闻名。他是学术文章《扩散系数的相关性》的作者。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-833b212eb3a569521f9a95be24874ec1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="91" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-833b212eb3a569521f9a95be24874ec1-e-5" label="Correlations for diffusion coefficients">
        <attvalues>
          <attvalue for="0" value="Correlations for diffusion coefficients" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由A. M. Brown与M. F. Ashby合著的学术论文。该论文于1980年发表在冶金学领域的科学期刊《Acta Metallurgica》上。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1980&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-833b212eb3a569521f9a95be24874ec1" />
