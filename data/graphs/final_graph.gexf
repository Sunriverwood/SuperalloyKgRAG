          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7f5d267485eb6b44a173a04ba9a301e4-e-9&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7f5d267485eb6b44a173a04ba9a301e4-e-10" label="ASTM 11">
        <attvalues>
          <attvalue for="0" value="ASTM 11" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种根据ASTM标准（如E112）评定，晶粒度等级为11的细晶粒材料。这种精细的微观结构赋予材料优异的机械性能，尤其是在特定高温条件下（如425°C），其抗疲劳寿命（Fatigue life）得到显著改善。" />
          <attvalue for="3" value="{&quot;parameter&quot;: &quot;grain size&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-7f5d267485eb6b44a173a04ba9a301e4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Fine-grained material (ASTM 11)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7f5d267485eb6b44a173a04ba9a301e4-e-10&quot;, &quot;chunk-9c7953b64a6a98e79dd79734f10a7c02-e-3&quot;, &quot;chunk-1d594ec5fbaf685c293ac798de95c065-e-2&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7f5d267485eb6b44a173a04ba9a301e4-e-11" label="ASTM 9">
        <attvalues>
          <attvalue for="0" value="ASTM 9" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="ASTM 9是依据美国材料与试验协会（ASTM）E112标准定义的晶粒度等级。该数值用于量化材料的平均晶粒尺寸，数值越大代表晶粒越细小，9级属于细晶粒范畴，是影响材料（如Udimet 720Li）力学性能的关键指标。" />
          <attvalue for="3" value="{&quot;parameter&quot;: &quot;grain size&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-7f5d267485eb6b44a173a04ba9a301e4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7f5d267485eb6b44a173a04ba9a301e4-e-11&quot;, &quot;chunk-9c7953b64a6a98e79dd79734f10a7c02-e-4&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9c7953b64a6a98e79dd79734f10a7c02-e-1" label="425 °C">
        <attvalues>
          <attvalue for="0" value="425 °C" />
          <attvalue for="1" value="Temperature" />
          <attvalue for="2" value="425 °C 是一个基于摄氏温标的温度测量值。该值等同于热力学温标（绝对温标）下的 698.15 K，或华氏温标下的 797 °F。它常被用作描述材料热处理、化学反应等过程中的特定工艺条件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-9c7953b64a6a98e79dd79734f10a7c02" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;425°C&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8827e315f10ef4c6612df3e85c9f593c-e-8&quot;, &quot;chunk-9c7953b64a6a98e79dd79734f10a7c02-e-1&quot;, &quot;chunk-1d594ec5fbaf685c293ac798de95c065-e-3&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-9c7953b64a6a98e79dd79734f10a7c02-e-2" label="650 °C">
        <attvalues>
          <attvalue for="0" value="650 °C" />
          <attvalue for="1" value="Temperature" />
          <attvalue for="2" value="650 °C (摄氏度) 是一个基于摄氏温标的特定温度点，属于高温范畴。该值约等于1202华氏度(°F)或923.15开尔文(K)，常作为材料科学、冶金和化学合成等领域的工业生产或科学实验条件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-9c7953b64a6a98e79dd79734f10a7c02" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="295" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-9c7953b64a6a98e79dd79734f10a7c02-e-7" label="Un-doped Udimet 720Li">
        <attvalues>
          <attvalue for="0" value="Un-doped Udimet 720Li" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种镍基高温合金，是Udimet 720的低间隙元素(Li)改性牌号。此为未掺杂版本，常在实验中用作基体或对照材料，以评估掺杂元素对合金高温强度、抗蠕变等性能的影响。" />
          <attvalue for="3" value="{&quot;condition&quot;: &quot;cast-and-wrought&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-9c7953b64a6a98e79dd79734f10a7c02" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9c7953b64a6a98e79dd79734f10a7c02-e-7&quot;]}]" />
          <attvalue for="9" value="296" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-9c7953b64a6a98e79dd79734f10a7c02-e-8" label="Grain-boundary elements">
        <attvalues>
          <attvalue for="0" value="Grain-boundary elements" />
          <attvalue for="1" value="Material Additive" />
          <attvalue for="2" value="一种材料添加剂，通常偏聚于材料的晶界处。它通过强化或净化晶界等机制，有效抑制裂纹的萌生与扩展，从而显著改善和提高材料的低周疲劳（LCF）寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-9c7953b64a6a98e79dd79734f10a7c02" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1d594ec5fbaf685c293ac798de95c065-e-4" label="Coarse-grained material">
        <attvalues>
          <attvalue for="0" value="Coarse-grained material" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="粗晶材料是一种晶粒尺寸相对较大的材料。在特定高温环境（如650°C）下，其粗大的晶粒结构有助于减少晶界，抑制晶界滑移等蠕变机制，从而有效提升材料的抗疲劳性能和使用寿命。" />
          <attvalue for="3" value="{&quot;grain_size&quot;: &quot;coarse&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1d594ec5fbaf685c293ac798de95c065" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;coarse-grained material&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1d594ec5fbaf685c293ac798de95c065-e-4&quot;, &quot;chunk-ecbdb2f69e15219fedba1f6f77faf2ed-e-8&quot;]}]" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1d594ec5fbaf685c293ac798de95c065-e-5" label="650 °C">
        <attvalues>
          <attvalue for="0" value="650 °C" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="650°C是指一个特定的试验温度。在此温度条件下，对材料的疲劳裂纹扩展速率进行测量和研究，它是评估材料在高温环境下力学性能和寿命的一个关键测试参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1d594ec5fbaf685c293ac798de95c065" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;649 °C&quot;, &quot;650°C&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0-e-8&quot;, &quot;chunk-8827e315f10ef4c6612df3e85c9f593c-e-4&quot;, &quot;chunk-28369a1f48e0d9ccd0e560147c06b368-e-2&quot;, &quot;chunk-1d594ec5fbaf685c293ac798de95c065-e-5&quot;, &quot;chunk-198cb71263c64f896cad9847f29b39cf-e-2&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-1d594ec5fbaf685c293ac798de95c065-e-6" label="Tensile properties">
        <attvalues>
          <attvalue for="0" value="Tensile properties" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="拉伸性能是材料在承受轴向拉伸载荷时所表现出的一系列力学性能指标。它主要通过拉伸试验测定，关键指标包括抗拉强度、屈服强度、伸长率和断面收缩率，是评价材料强度和塑性的基本依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-1d594ec5fbaf685c293ac798de95c065" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1d594ec5fbaf685c293ac798de95c065-e-6&quot;]}]" />
          <attvalue for="9" value="178" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1d594ec5fbaf685c293ac798de95c065-e-7" label="Grain-boundary strengtheners">
        <attvalues>
          <attvalue for="0" value="Grain-boundary strengtheners" />
          <attvalue for="1" value="Material Additive" />
          <attvalue for="2" value="一种材料添加剂，通常偏聚于多晶材料的晶界处。其主要作用是增加晶界的结合强度，抑制晶界滑移或开裂，从而提高材料的整体强度、韧性、或高温抗蠕变等机械性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-1d594ec5fbaf685c293ac798de95c065" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1d594ec5fbaf685c293ac798de95c065-e-7&quot;]}]" />
          <attvalue for="9" value="178" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-61584d620a7ea3197cac715cb4ce2e82-e-1" label="Blavette and co-workers">
        <attvalues>
          <attvalue for="0" value="Blavette and co-workers" />
          <attvalue for="1" value="Research Group" />
          <attvalue for="2" value="一个致力于揭示晶界元素效应科学原理的研究团队。该团队利用场离子显微镜与原子探针断层扫描技术，对N18等材料进行了深入研究。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-61584d620a7ea3197cac715cb4ce2e82" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-61584d620a7ea3197cac715cb4ce2e82-e-3" label="Field-ion microscopy">
        <attvalues>
          <attvalue for="0" value="Field-ion microscopy" />
          <attvalue for="1" value="Analytical Technique" />
          <attvalue for="2" value="场离子显微镜（FIM）是一种表面分析技术。它利用置于强电场中的针尖样品，使其顶端附近的成像气体电离并投射到探测器上，从而获得具有原子级分辨率的表面图像，是首个能够直接观察到单个原子的技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-61584d620a7ea3197cac715cb4ce2e82" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-61584d620a7ea3197cac715cb4ce2e82-e-4" label="Atom probe tomography">
        <attvalues>
          <attvalue for="0" value="Atom probe tomography" />
          <attvalue for="1" value="Analysis Technique" />
          <attvalue for="2" value="原子探针层析技术（Atom Probe Tomography, APT）是一种材料表征技术，也是唯一能够在三维空间内提供近原子级分辨率成像和高精度化学成分分析的方法。它通过逐个场致蒸发样品针尖表面的原子，来重构材料内部原子尺度的三维图像，从而精确揭示其微观结构和元素分布。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-61584d620a7ea3197cac715cb4ce2e82" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;atom probe&quot;, &quot;atom probe analysis&quot;, &quot;atom probe tomography&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-61584d620a7ea3197cac715cb4ce2e82-e-4&quot;, &quot;chunk-264495632c5fce243bda26582e560253-e-11&quot;, &quot;chunk-0ba22e2612dbc225416101c15d4cb857-e-2&quot;, &quot;chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-14&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-61584d620a7ea3197cac715cb4ce2e82-e-8" label="N18">
        <attvalues>
          <attvalue for="0" value="N18" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="P/M alloy N18是一种采用粉末冶金（Powder Metallurgy）工艺制造的合金，通常指一种镍基高温合金。其化学成分中包含硼（B）、碳（C）和锆（Zr）等关键元素，并因其特定的元素构成而展现出独特的晶界偏析行为。" />
          <attvalue for="3" value="{&quot;type&quot;: &quot;P/M alloy&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-61584d620a7ea3197cac715cb4ce2e82" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;P/M alloy N18&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-61584d620a7ea3197cac715cb4ce2e82-e-8&quot;, &quot;chunk-a8e2ede64fab8f44656d400d86989bf1-e-1&quot;, &quot;chunk-972c0e045da978a7171f69472773ae6a-e-6&quot;, &quot;chunk-2457bc4af0771717326f8f8489539e06-e-1&quot;, &quot;chunk-11fd3f8dd428533f2dacdd280d5458c0-e-1&quot;, &quot;chunk-f23caa328479b9d419f0d855b9335eb4-e-19&quot;, &quot;chunk-ae682ac4e4eb339bd48233482011cdd1-e-6&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-a8e2ede64fab8f44656d400d86989bf1-e-3" label="C">
        <attvalues>
          <attvalue for="0" value="C" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="碳（C）是P/M N18合金的一种组成元素。其主要特征是在该合金的γ/γ'晶界处不发生元素偏析（segregation）现象。" />
          <attvalue for="3" value="{&quot;bulk_composition&quot;: &quot;0.075 at%&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a8e2ede64fab8f44656d400d86989bf1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a8e2ede64fab8f44656d400d86989bf1-e-6" label="γ/γ grain boundaries">
        <attvalues>
          <attvalue for="0" value="γ/γ grain boundaries" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="y/y晶界是一种存在于镍基高温合金（如N18）中的微观结构特征，指γ相晶粒间的界面。其主要特点是特定元素的显著选择性偏聚：研究表明，硼（B）和钼（Mo）会在此处富集，而碳（C）则不会。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a8e2ede64fab8f44656d400d86989bf1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;y-grain boundaries&quot;, &quot;y/y grain boundaries&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-234c3eebb3d42a0daf6e298133c20255-e-4&quot;, &quot;chunk-6007146f18f54e1531784eefc3822dae-e-3&quot;, &quot;chunk-a8e2ede64fab8f44656d400d86989bf1-e-6&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-a8e2ede64fab8f44656d400d86989bf1-e-7" label="Incoherent γ/γ' boundaries">
        <attvalues>
          <attvalue for="0" value="Incoherent γ/γ' boundaries" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="一种存在于镍基高温合金（如N18）中的显微组织特征，特指γ基体相与γ'强化相之间晶格不匹配的非共格界面。与y/y晶界相似，该界面易于发生元素偏析，从而影响材料性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a8e2ede64fab8f44656d400d86989bf1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a8e2ede64fab8f44656d400d86989bf1-e-7&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b674e36d570cafb7928d33912e7c1b02-e-1" label="C">
        <attvalues>
          <attvalue for="0" value="C" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="化学元素碳(C)。在特定合金（如Astroloy）的语境下，它是一种以M23C6型碳化物形式存在的合金元素，且未发现有偏析现象，表明其在微观结构中分布相对均匀。" />
          <attvalue for="3" value="{&quot;chemical_symbol&quot;: &quot;C&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-b674e36d570cafb7928d33912e7c1b02" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b674e36d570cafb7928d33912e7c1b02-e-2" label="M23C6 carbides">
        <attvalues>
          <attvalue for="0" value="M23C6 carbides" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="M23C6碳化物是一种富铬的金属碳化物材料相，化学式中M主要为铬(Cr)原子。它具有复杂的立方晶体结构，通常在不锈钢及高温合金中作为第二相析出，对材料的力学性能和耐腐蚀性有重要影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-b674e36d570cafb7928d33912e7c1b02" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b674e36d570cafb7928d33912e7c1b02-e-6" label="Turbine disc superalloys">
        <attvalues>
          <attvalue for="0" value="Turbine disc superalloys" />
          <attvalue for="1" value="Alloy Class" />
          <attvalue for="2" value="涡轮盘高温合金是专为制造燃气轮机涡轮盘而开发的一类高性能合金，通常为镍基。为在高温下承受高转速带来的离心应力和热循环载荷，该类合金被优化设计，具有极高的强度、优异的抗疲劳和抗蠕变性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-b674e36d570cafb7928d33912e7c1b02" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="297" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-972c0e045da978a7171f69472773ae6a-e-3" label="Pratt &amp; Whitney">
        <attvalues>
          <attvalue for="0" value="Pratt &amp; Whitney" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="普拉特·惠特尼（Pratt &amp; Whitney）是一家美国航空航天制造商，主要设计、制造和维修飞机发动机。该公司在材料科学研究中，曾指出金属元素钽（Ta）对材料的驻留疲劳裂纹扩展（dwell FCP）速率具有影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-972c0e045da978a7171f69472773ae6a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-972c0e045da978a7171f69472773ae6a-e-3&quot;, &quot;chunk-58a0b5872320286acd36be7afd8ed1ba-e-9&quot;, &quot;chunk-03e3f6f2736d579e9767469fc63d46a3-e-1&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-972c0e045da978a7171f69472773ae6a-e-4" label="SNECMA">
        <attvalues>
          <attvalue for="0" value="SNECMA" />
          <attvalue for="1" value="Company" />
          <attvalue for="2" value="SNECMA（斯奈克玛）是一家法国航空航天发动机制造商，现为赛峰飞机发动机公司(Safran Aircraft Engines)。该公司在航空动力和先进材料领域拥有领先的研发能力，其著名成就之一是设计了用于高性能喷气发动机的N18镍基超级合金。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-972c0e045da978a7171f69472773ae6a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-972c0e045da978a7171f69472773ae6a-e-4&quot;, &quot;chunk-2457bc4af0771717326f8f8489539e06-e-2&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2457bc4af0771717326f8f8489539e06-e-4" label="Fatigue Crack Propagation (FCP)">
        <attvalues>
          <attvalue for="0" value="Fatigue Crack Propagation (FCP)" />
          <attvalue for="1" value="Material Behavior" />
          <attvalue for="2" value="疲劳裂纹扩展（FCP）指材料在循环载荷作用下，其内部裂纹发生渐进式、稳定增长的现象。其扩展速率是评估材料损伤容限和服役寿命的关键性能指标，与材料的屈服强度等力学性能密切相关。在高性能合金（如N18）的设计中，获得尽可能低的扩展速率是一个核心目标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-2457bc4af0771717326f8f8489539e06" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2457bc4af0771717326f8f8489539e06-e-4&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2457bc4af0771717326f8f8489539e06-e-5" label="Rene 95">
        <attvalues>
          <attvalue for="0" value="Rene 95" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="Rene 95是一种镍基高温合金，其关键微观结构特征为50%的γ'相体积分数和0.7的钛铝（Ti/Al）比。由于其确定的性能参数，该合金常被用作一种基准材料，与Rene 88DT等其他先进合金进行性能对比。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2457bc4af0771717326f8f8489539e06" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2457bc4af0771717326f8f8489539e06-e-5&quot;, &quot;chunk-12abccc567e86807dfdcf4f2bea50424-e-1&quot;, &quot;chunk-984b31532b15eb77f69439c6359615d7-e-5&quot;, &quot;chunk-edc468109902c1fff7b3577a4b609989-e-3&quot;, &quot;chunk-a5ab94c496162dae08a6cf75a408debb-e-2&quot;, &quot;chunk-198cb71263c64f896cad9847f29b39cf-e-11&quot;, &quot;chunk-fd63d9cd61eb501106c8b03551043c54-e-4&quot;, &quot;chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec-e-3&quot;, &quot;chunk-bd5710a1dc51c42dffb282b63e6aaa4f-e-3&quot;, &quot;chunk-ae682ac4e4eb339bd48233482011cdd1-e-17&quot;, &quot;chunk-e29ab0c1999b2fd0630fcd1c30c3554b-e-4&quot;, &quot;chunk-6656e9c896783e532db09028bd4f742e-e-5&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="13" />
        </attvalues>
      </node>
      <node id="chunk-2457bc4af0771717326f8f8489539e06-e-10" label="Crack Growth Rate-Yield Stress Correlation">
        <attvalues>
          <attvalue for="0" value="Crack Growth Rate-Yield Stress Correlation" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="裂纹扩展速率-屈服强度关联性是一种材料力学现象，指材料的裂纹扩展速率与其屈服强度成正比关系。该现象常见于Rene 95、IN100等粉末冶金高温合金。而某些先进合金（如N18）在设计上则旨在打破此关联，以获得更优的抗疲劳性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-2457bc4af0771717326f8f8489539e06" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-11fd3f8dd428533f2dacdd280d5458c0-e-7" label="W">
        <attvalues>
          <attvalue for="0" value="W" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="W，化学元素钨（Tungsten）的符号。在N18合金中，它是一种与钼(Mo)相比不被优先选用的元素，表明其在该特定应用中的性能或效果相对较差。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-11fd3f8dd428533f2dacdd280d5458c0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-11fd3f8dd428533f2dacdd280d5458c0-e-7&quot;, &quot;chunk-2fd5876b35a11cace4a36b2cc1865696-e-4&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-11fd3f8dd428533f2dacdd280d5458c0-e-8" label="Notch sensitivity">
        <attvalues>
          <attvalue for="0" value="Notch sensitivity" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**缺口敏感性**是一种材料属性，用于衡量材料因缺口、裂纹等几何不连续性造成的应力集中，而导致其强度或韧性降低的程度。它是评估材料，尤其是在高温蠕变等工况下，其结构可靠性的重要力学性能指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-11fd3f8dd428533f2dacdd280d5458c0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Notch Sensitivity&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-11fd3f8dd428533f2dacdd280d5458c0-e-8&quot;, &quot;chunk-12abccc567e86807dfdcf4f2bea50424-e-5&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-12abccc567e86807dfdcf4f2bea50424-e-2" label="Rene 88DT">
        <attvalues>
          <attvalue for="0" value="Rene 88DT" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="Rene 88DT是一种镍基高温合金，属于Rene合金家族。其名称中的“DT”代表损伤容限（Damage Tolerant），通过专门的热处理工艺获得优异的抗疲劳和裂纹扩展性能。该合金主要用于制造航空航天燃气涡轮发动机的涡轮盘等关键高温承力部件。" />
          <attvalue for="3" value="{&quot;designation_meaning&quot;: &quot;DT refers to damage tolerant&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-12abccc567e86807dfdcf4f2bea50424" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-12abccc567e86807dfdcf4f2bea50424-e-2&quot;, &quot;chunk-a5ab94c496162dae08a6cf75a408debb-e-7&quot;, &quot;chunk-198cb71263c64f896cad9847f29b39cf-e-12&quot;, &quot;chunk-ae682ac4e4eb339bd48233482011cdd1-e-16&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-12abccc567e86807dfdcf4f2bea50424-e-4" label="Damage Tolerance">
        <attvalues>
          <attvalue for="0" value="Damage Tolerance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="损伤容限是一种材料属性，指结构或材料在含有裂纹等初始缺陷的情况下，仍能抑制裂纹扩展、在规定期限内安全服役而不会发生灾难性断裂的能力。它是确保关键结构件可靠性的重要设计准则。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-12abccc567e86807dfdcf4f2bea50424" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-12abccc567e86807dfdcf4f2bea50424-e-4&quot;, &quot;chunk-2457bc4af0771717326f8f8489539e06-e-3&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-12abccc567e86807dfdcf4f2bea50424-e-8" label="Dwell fatigue crack propagation rates">
        <attvalues>
          <attvalue for="0" value="Dwell fatigue crack propagation rates" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种材料性能，用于衡量材料在含有峰值载荷保载（驻留）阶段的循环应力作用下，疲劳裂纹扩展的速度。该速率是评估高温合金等材料在高温、蠕变-疲劳交互作用下服役寿命和可靠性的关键参数。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;650°C&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-12abccc567e86807dfdcf4f2bea50424" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-12abccc567e86807dfdcf4f2bea50424-e-8&quot;]}]" />
          <attvalue for="9" value="179" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-12abccc567e86807dfdcf4f2bea50424-e-9" label="γ' (gamma prime)">
        <attvalues>
          <attvalue for="0" value="γ' (gamma prime)" />
          <attvalue for="1" value="Microstructural Phase" />
          <attvalue for="2" value="γ'相是存在于高温合金中的一种关键显微结构相，也是其主要强化相。增加其体积分数和尺寸，可以显著提升合金的整体疲劳性能，并增强其对驻留疲劳裂纹扩展的抗力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-12abccc567e86807dfdcf4f2bea50424" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="179" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-198cb71263c64f896cad9847f29b39cf-e-1" label="Fatigue Crack Propagation Rates">
        <attvalues>
          <attvalue for="0" value="Fatigue Crack Propagation Rates" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="疲劳裂纹扩展速率指材料在循环载荷下裂纹增长的速度，是评估其疲劳寿命的关键力学性能。较低的速率意味着更高的抗疲劳断裂性能。该性能对材料的微观结构（如γ'相的体积分数与尺寸）和合金成分（如Ti/Al比）高度敏感。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-198cb71263c64f896cad9847f29b39cf" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-198cb71263c64f896cad9847f29b39cf-e-1&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-198cb71263c64f896cad9847f29b39cf-e-6" label="Ta substitution for W">
        <attvalues>
          <attvalue for="0" value="Ta substitution for W" />
          <attvalue for="1" value="Compositional Modification" />
          <attvalue for="2" value="一种成分改性方法，指在材料中使用钽（Ta）原子替代钨（W）原子。该方法旨在降低材料在650°C高温下的疲劳裂纹扩展速率，从而提升其高温抗疲劳性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-198cb71263c64f896cad9847f29b39cf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-198cb71263c64f896cad9847f29b39cf-e-7" label="High-volume-fraction γ' alloys">
        <attvalues>
          <attvalue for="0" value="High-volume-fraction γ' alloys" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="一类以高体积分数γ'相为主要强化相的合金。该类合金的特点是在650°C高温下表现出优异的抗驻留疲劳裂纹扩展性能，但在400°C中温无驻留期条件下的常规疲劳裂纹扩展抗力则相对较差。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-198cb71263c64f896cad9847f29b39cf" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;High y' volume fractions&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7fe022ba8cc7632d553ef231b0a1a4ea-e-7&quot;, &quot;chunk-198cb71263c64f896cad9847f29b39cf-e-7&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-198cb71263c64f896cad9847f29b39cf-e-8" label="Dwell FCP rates">
        <attvalues>
          <attvalue for="0" value="Dwell FCP rates" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**Dwell FCP rates**&#10;&#10;一种材料性能，用于衡量在包含恒定载荷保持时间（驻留期）的循环载荷作用下，材料疲劳裂纹的扩展速度。该性能是评估高温材料（如高体积分数γ'合金）在蠕变-疲劳交互作用下服役寿命的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-198cb71263c64f896cad9847f29b39cf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-198cb71263c64f896cad9847f29b39cf-e-9" label="400°C">
        <attvalues>
          <attvalue for="0" value="400°C" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="一个特定的测试温度条件。在此温度下，高体积分数γ'合金的性能会显著下降，因此该温度是评估此类高温合金材料性能的一个重要参考基准。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;400&quot;, &quot;unit&quot;: &quot;Celsius&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-198cb71263c64f896cad9847f29b39cf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="298" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-58a0b5872320286acd36be7afd8ed1ba-e-1" label="Smaller γ' fraction">
        <attvalues>
          <attvalue for="0" value="Smaller γ' fraction" />
          <attvalue for="1" value="Material State" />
          <attvalue for="2" value="一种目标材料状态，指其微观结构中γ'强化相的体积分数较低（如40%）。此状态通常通过调整合金成分（例如提高Ti/Al比、Cr或Co含量）以获得特定的材料性能。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;40% rather than 50%&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-58a0b5872320286acd36be7afd8ed1ba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="82" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-58a0b5872320286acd36be7afd8ed1ba-e-2" label="Higher Ti/Al ratio">
        <attvalues>
          <attvalue for="0" value="Higher Ti/Al ratio" />
          <attvalue for="1" value="Material Composition" />
          <attvalue for="2" value="**较高的钛铝比 (Higher Ti/Al ratio)**&#10;&#10;一种材料成分状态，指其组成中钛（Ti）与铝（Al）的重量百分比（wt%）值较高。例如，当该比值从0.7增加到1.8时，会改变材料的微观结构，导致其γ'相（伽马撇相）的体积分数减小，从而影响材料的机械性能。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;1.8 rather than 0.7 on a wt% basis&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-58a0b5872320286acd36be7afd8ed1ba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-58a0b5872320286acd36be7afd8ed1ba-e-2&quot;]}]" />
          <attvalue for="9" value="82" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-58a0b5872320286acd36be7afd8ed1ba-e-3" label="Higher Cr content">
        <attvalues>
          <attvalue for="0" value="Higher Cr content" />
          <attvalue for="1" value="Material Composition" />
          <attvalue for="2" value="一种材料成分的特定调整，指将铬（Cr）的重量百分比从13%提升至16%。这种成分变化会导致材料中γ'（伽马撇）相的析出分数减小，从而影响其微观结构与性能。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;16 wt% rather than 13 wt%&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-58a0b5872320286acd36be7afd8ed1ba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="82" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-58a0b5872320286acd36be7afd8ed1ba-e-4" label="Higher Co content">
        <attvalues>
          <attvalue for="0" value="Higher Co content" />
          <attvalue for="1" value="Material Composition" />
          <attvalue for="2" value="一种材料成分的特定调整，指将钴(Co)的质量百分比从8%提升至13%。这种成分变化会直接影响材料（尤指高温合金）的相平衡与微观结构，并导致其γ'相的体积分数减小。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;13 wt% rather than 8 wt%&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-58a0b5872320286acd36be7afd8ed1ba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="82" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-58a0b5872320286acd36be7afd8ed1ba-e-7" label="Dwell-time fatigue crack growth rate">
        <attvalues>
          <attvalue for="0" value="Dwell-time fatigue crack growth rate" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="一项材料性能指标，用于衡量在包含恒定载荷保持（驻留）的循环加载下，材料疲劳裂纹的扩展速度。添加钽（Ta）可降低该速率以提升材料性能，而钴（Co）和铬（Cr）的替代则无显著影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-58a0b5872320286acd36be7afd8ed1ba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-58a0b5872320286acd36be7afd8ed1ba-e-7&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-58a0b5872320286acd36be7afd8ed1ba-e-8" label="Tantalum (Ta)">
        <attvalues>
          <attvalue for="0" value="Tantalum (Ta)" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="钽（Tantalum）是一种化学元素，符号为Ta，原子序数73。它是一种坚硬、蓝灰色的稀有过渡金属，以极强的抗腐蚀能力、高熔点和优良的延展性著称。因其稳定的化学性质和生物相容性，被广泛用于制造电子设备中的电容器、高温合金以及外科医疗植入物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-58a0b5872320286acd36be7afd8ed1ba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Ta&quot;, &quot;tantalum&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8cc148c1ca974c554ee456036519b0b3-e-8&quot;, &quot;chunk-ed24a575ccc7da550855ce4a7d4ebb9f-e-7&quot;, &quot;chunk-a4d65971a0e96c0f576b576adadc50ce-e-7&quot;, &quot;chunk-0d8b8971d722c099aa85646d423e67e5-e-1&quot;, &quot;chunk-e1a389bc8645b3e7fa58f05c1e0a798f-e-10&quot;, &quot;chunk-a00605aad03a48315b6372d73ae11d54-e-7&quot;, &quot;chunk-58a0b5872320286acd36be7afd8ed1ba-e-8&quot;, &quot;chunk-3031ff2205f827feea0affe73ca7d2ae-e-8&quot;, &quot;chunk-a921a108c7811dc9a541483523b2c983-e-6&quot;, &quot;chunk-d55298f42964ce23c30b0bcafa72ab6c-e-5&quot;, &quot;chunk-2fd5876b35a11cace4a36b2cc1865696-e-3&quot;, &quot;chunk-9f8adabfb1010fa4a4528e361c3f5223-e-7&quot;, &quot;chunk-8c75d16dc148897cf486c21cbe30e4be-e-10&quot;, &quot;chunk-0625d83d7200f989528119d9ba61865a-e-16&quot;, &quot;chunk-3b4422ce09cd66eaf6abd58690d6f8ef-e-2&quot;, &quot;chunk-23893d297564190aa46fd314ec1e6f0e-e-3&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="12" />
        </attvalues>
      </node>
      <node id="chunk-03e3f6f2736d579e9767469fc63d46a3-e-4" label="High Speed Civil Transport (HSCT) aeroplane">
        <attvalues>
          <attvalue for="0" value="High Speed Civil Transport (HSCT) aeroplane" />
          <attvalue for="1" value="Project" />
          <attvalue for="2" value="高速民用运输机（HSCT）是美国宇航局（NASA）在20世纪90年代开展的一项研究项目。该项目旨在为开发出环保且经济可行的下一代超音速客机奠定技术基础，其中包括研发ME3等先进高温合金材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-03e3f6f2736d579e9767469fc63d46a3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-03e3f6f2736d579e9767469fc63d46a3-e-5" label="ME3">
        <attvalues>
          <attvalue for="0" value="ME3" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="ME3是一种为高速民用运输机（HSCT）项目开发的富含钴（Co）的合金。该合金的一大特点是，可通过超固溶热处理或双重微观结构热处理工艺进行加工，以优化其最终性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-03e3f6f2736d579e9767469fc63d46a3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-03e3f6f2736d579e9767469fc63d46a3-e-8" label="thermally induced porosity (TIP)">
        <attvalues>
          <attvalue for="0" value="thermally induced porosity (TIP)" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="热致孔隙（TIP）是一种材料缺陷，特指金属（尤其是高温合金）在高温热处理或服役期间，因原子扩散速率差异（柯肯达尔效应）等因素导致的内部微观孔洞的形成。这种缺陷会严重损害材料的力学性能，可通过优化合金成分（如添加Co）或热处理工艺来抑制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-03e3f6f2736d579e9767469fc63d46a3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-03e3f6f2736d579e9767469fc63d46a3-e-10" label="Dual Microstructure Heat Treatment">
        <attvalues>
          <attvalue for="0" value="Dual Microstructure Heat Treatment" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="双重微观结构热处理（Dual Microstructure Heat Treatment）是由NASA设计并拥有专利的一种热处理技术。它对单一构件的不同部位分别施加不同的热处理工艺（如亚固溶与超固溶热处理），从而在构件内形成两种不同的微观组织，以优化各部位的综合性能，满足特定的服役要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-03e3f6f2736d579e9767469fc63d46a3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Dual microstructure heat treatment technology (DMHT)&quot;, &quot;dual microstructure heat treatment&quot;, &quot;dual microstructure heat treatment process&quot;, &quot;dual microstructure heat treatments&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-03e3f6f2736d579e9767469fc63d46a3-e-10&quot;, &quot;chunk-3031ff2205f827feea0affe73ca7d2ae-e-3&quot;, &quot;chunk-a1650d74269b8238062c417df547e98e-e-8&quot;, &quot;chunk-d89de553b45749db88cca84e98f06178-e-1&quot;, &quot;chunk-eb23a1fa1bb857c2e5b4e84047321caa-e-9&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-3031ff2205f827feea0affe73ca7d2ae-e-1" label="treatment window">
        <attvalues>
          <attvalue for="0" value="treatment window" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="一种工艺参数，指在热处理中为获得特定组织与性能，所允许的关键参数（如温度、时间）的组合范围。扩大该窗口是实现如超固溶体热处理和双重组织热处理等先进工艺的前提。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-3031ff2205f827feea0affe73ca7d2ae" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3031ff2205f827feea0affe73ca7d2ae-e-4" label="Alloy ME3">
        <attvalues>
          <attvalue for="0" value="Alloy ME3" />
          <attvalue for="1" value="Superalloy" />
          <attvalue for="2" value="Alloy ME3是一种高温合金，与Rene 104类似。其关键特征是在成分中添加了钽(Ta)元素，旨在对合金进行改性以提升其高温性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-3031ff2205f827feea0affe73ca7d2ae" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-84e66d4c5b0aa04871a2cf1b578e46dd-e-3" label="o phase">
        <attvalues>
          <attvalue for="0" value="o phase" />
          <attvalue for="1" value="Metallurgical Phase" />
          <attvalue for="2" value="o相是一种金相相，其沉淀析出受铬元素促进，该效应在700°C以上的温度环境中尤为显著。" />
          <attvalue for="3" value="{&quot;precipitation_temperature_threshold&quot;: &quot;&gt; 700°C&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-84e66d4c5b0aa04871a2cf1b578e46dd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-44a103d3439804fea5910e3206b26742-e-2" label="Original Compositional Variant">
        <attvalues>
          <attvalue for="0" value="Original Compositional Variant" />
          <attvalue for="1" value="Superalloy" />
          <attvalue for="2" value="一种含铬的镍基高温合金，作为知名高温合金Udimet 720Li的前驱体。Udimet 720Li是在这种原始成分变体的基础上开发而成的。" />
          <attvalue for="3" value="{&quot;Chromium (Cr)&quot;: &quot;18 wt%&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-44a103d3439804fea5910e3206b26742" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-44a103d3439804fea5910e3206b26742-e-2&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-44a103d3439804fea5910e3206b26742-e-6" label="Carbon">
        <attvalues>
          <attvalue for="0" value="Carbon" />
          <attvalue for="1" value="Alloying Element" />
          <attvalue for="2" value="碳（Carbon）是一种重要的间隙合金元素，其含量对材料性能有关键影响。它以间隙原子形式存在于金属基体中。在Udimet 720Li这类高温合金中，其浓度被刻意降低，以优化和改善材料的综合性能。" />
          <attvalue for="3" value="{&quot;concentration&quot;: &quot;about 0.018 wt%&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-44a103d3439804fea5910e3206b26742" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-35f68dab755d8efb78530fe9fc2cf841-e-2" label="LSHR">
        <attvalues>
          <attvalue for="0" value="LSHR" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="LSHR是一种粉末冶金镍基高温合金，其名称为“低固溶、高难熔”(Low Solvus, High Refractory)的缩写。该合金具有优异的高温力学性能和组织稳定性，由美国NASA开发，主要用于制造先进航空发动机的涡轮盘等关键热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-35f68dab755d8efb78530fe9fc2cf841" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-35f68dab755d8efb78530fe9fc2cf841-e-2&quot;, &quot;chunk-7fe022ba8cc7632d553ef231b0a1a4ea-e-6&quot;, &quot;chunk-f23caa328479b9d419f0d855b9335eb4-e-13&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-35f68dab755d8efb78530fe9fc2cf841-e-4" label="Alloy 10">
        <attvalues>
          <attvalue for="0" value="Alloy 10" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="Alloy 10是由霍尼韦尔（Honeywell）设计的一种LSHR（低固溶、高难熔）高温合金。该合金拥有高难熔金属含量，具备卓越的拉伸强度和抗蠕变性能，专为辅助动力单元（APU）应用而开发。" />
          <attvalue for="3" value="{&quot;refractory content&quot;: &quot;higher&quot;, &quot;capability&quot;: &quot;superior tensile and creep&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-35f68dab755d8efb78530fe9fc2cf841" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-35f68dab755d8efb78530fe9fc2cf841-e-5" label="Honeywell Engines and Systems">
        <attvalues>
          <attvalue for="0" value="Honeywell Engines and Systems" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="霍尼韦尔公司（Honeywell）旗下的业务部门，专注于航空航天领域的发动机和动力系统。该部门是特种金属材料Alloy 10的设计者。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-35f68dab755d8efb78530fe9fc2cf841" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-35f68dab755d8efb78530fe9fc2cf841-e-6" label="Auxiliary Power Unit (APU)">
        <attvalues>
          <attvalue for="0" value="Auxiliary Power Unit (APU)" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="辅助动力单元（APU）是飞机等运载工具上的小型动力装置，用于在主发动机关闭时提供电力和压缩空气。因其在高温下工作，其关键部件需采用含有高含量难熔元素的耐热材料制造，以确保可靠运行。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-35f68dab755d8efb78530fe9fc2cf841" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Auxiliary Power Unit&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-35f68dab755d8efb78530fe9fc2cf841-e-6&quot;, &quot;chunk-698d77389e974f77703857501a37006f-e-1&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-698d77389e974f77703857501a37006f-e-2" label="High Refractory Element Content">
        <attvalues>
          <attvalue for="0" value="High Refractory Element Content" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种材料属性，指材料组分中含有高比例的耐火元素（如钨）。这些元素熔点极高，能赋予材料优异的高温强度、抗热腐蚀和耐磨损能力，是其适用于辅助动力单元（APU）等高温应用的关键特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-698d77389e974f77703857501a37006f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-698d77389e974f77703857501a37006f-e-3" label="Tungsten">
        <attvalues>
          <attvalue for="0" value="Tungsten" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="钨（Tungsten），化学符号为W，原子序数74，是一种钢灰色过渡金属。它以其极高的硬度、密度和所有元素中最高的熔点（3422 °C）而闻名。由于其强大的原子键合和高熔点特性，钨是一种典型的慢扩散元素，在高温合金、电极和白炽灯灯丝等需要极端热稳定性的应用中至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-698d77389e974f77703857501a37006f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;W&quot;, &quot;tungsten&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-698d77389e974f77703857501a37006f-e-3&quot;, &quot;chunk-a4fbcaedb1a3455b29f18439a3d53ae7-e-6&quot;, &quot;chunk-78c519f8cce4113c48c714a60ca273ce-e-2&quot;, &quot;chunk-8c75d16dc148897cf486c21cbe30e4be-e-11&quot;, &quot;chunk-3d0590efade07af78fea353ef909c7ec-e-1&quot;, &quot;chunk-0440023a44a202881a859e66f23ec3de-e-8&quot;, &quot;chunk-1410988dfcbd0392c9d01a4bc32fcff9-e-9&quot;, &quot;chunk-951c3bbe670e3cf4f0dc7a8bc55e7730-e-4&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-698d77389e974f77703857501a37006f-e-5" label="Turbine Blading">
        <attvalues>
          <attvalue for="0" value="Turbine Blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="安装在涡轮盘轮缘上的一组成排的翼型部件。其核心功能是从高温高压气流等工作流体中提取能量，并将其转化为转动机械功，驱动整个涡轮转子高速旋转。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-698d77389e974f77703857501a37006f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-698d77389e974f77703857501a37006f-e-6" label="Drive Arms">
        <attvalues>
          <attvalue for="0" value="Drive Arms" />
          <attvalue for="1" value="Component Feature" />
          <attvalue for="2" value="一种机械部件，其核心功能是将负载（如力或扭矩）传递到一个轴上，从而驱动其旋转。作为传动系统中的关键元件，它确保动力被有效地施加于目标轴件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-698d77389e974f77703857501a37006f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Drive arms&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-698d77389e974f77703857501a37006f-e-6&quot;, &quot;chunk-ca9e8043d267b5456310acc3e6414a07-e-3&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-698d77389e974f77703857501a37006f-e-7" label="Loads">
        <attvalues>
          <attvalue for="0" value="Loads" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="指由驱动臂传递并作用于轴上的一种物理力。该定义明确了力的来源（驱动臂）和承受对象（轴），是描述特定机械传动系统中所传递作用力的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-698d77389e974f77703857501a37006f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-698d77389e974f77703857501a37006f-e-7&quot;, &quot;chunk-ca9e8043d267b5456310acc3e6414a07-e-4&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ca9e8043d267b5456310acc3e6414a07-e-1" label="Fixturing">
        <attvalues>
          <attvalue for="0" value="Fixturing" />
          <attvalue for="1" value="Component Requirement" />
          <attvalue for="2" value="一项关于装夹工艺的组件要求，旨在通过特定的夹具或工装，在加工、检测或装配等工序中对涡轮叶片进行可靠的定位、支撑与固定。该要求确保工件姿态的稳定性和操作的精确性，是保障最终产品质量的关键规范。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-ca9e8043d267b5456310acc3e6414a07" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="180" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ca9e8043d267b5456310acc3e6414a07-e-2" label="Turbine blading">
        <attvalues>
          <attvalue for="0" value="Turbine blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮叶片是涡轮发动机的核心旋转部件，通常由一组按特定规律排列的翼型叶片构成。它的主要功能是将高温高压燃气或蒸汽等工质的能量，转化为驱动涡轮转子高速旋转的机械能，是决定发动机性能、效率及可靠性的关键元件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-ca9e8043d267b5456310acc3e6414a07" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="180" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ca9e8043d267b5456310acc3e6414a07-e-5" label="Shaft">
        <attvalues>
          <attvalue for="0" value="Shaft" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="轴（Shaft）是一种传递扭矩和承受弯矩的旋转机械元件。它通常呈圆杆状，用于支撑齿轮、皮带轮等旋转零件，并将动力从驱动源传递给机器的其他部分，是构成各类机器和设备的基本部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ca9e8043d267b5456310acc3e6414a07" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ca9e8043d267b5456310acc3e6414a07-e-5&quot;, &quot;chunk-d4872d4d3fa3d8ec025e5fc82bfd4fba-e-12&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ca9e8043d267b5456310acc3e6414a07-e-6" label="Cover plates">
        <attvalues>
          <attvalue for="0" value="Cover plates" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种通过引导、覆盖或密封方式来管理冷却空气流动的部件。其作用是优化气流路径，确保对特定设备或区域进行有效的散热和温度控制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-ca9e8043d267b5456310acc3e6414a07" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="181" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ca9e8043d267b5456310acc3e6414a07-e-7" label="Cooling air">
        <attvalues>
          <attvalue for="0" value="Cooling air" />
          <attvalue for="1" value="Medium" />
          <attvalue for="2" value="作为一种冷却介质的空气流体。在特定设备中，其流动路径和速率由盖板等部件进行引导和控制，以对目标组件进行有效的强制对流散热。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ca9e8043d267b5456310acc3e6414a07" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="181" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ca9e8043d267b5456310acc3e6414a07-e-8" label="Flanges">
        <attvalues>
          <attvalue for="0" value="Flanges" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="法兰是一种盘状零件，用于连接管道、阀门或设备。它带有螺栓孔，通常成对使用，通过螺栓固定，形成一个可拆卸的密封连接。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-ca9e8043d267b5456310acc3e6414a07" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="182" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ca9e8043d267b5456310acc3e6414a07-e-9" label="Neighbouring discs">
        <attvalues>
          <attvalue for="0" value="Neighbouring discs" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="指通过法兰和螺栓紧固连接的两个或多个相邻盘状组件。这种结构常用于旋转机械中，用以传递扭矩、承受轴向载荷或形成密封。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-ca9e8043d267b5456310acc3e6414a07" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="182" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ca9e8043d267b5456310acc3e6414a07-e-10" label="Disc">
        <attvalues>
          <attvalue for="0" value="Disc" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种机械部件，其外形通常设计成锥形，用以优化中心孔（bore）周围的应力分布，从而限制或减小该区域的应力集中。" />
          <attvalue for="3" value="{&quot;shape&quot;: &quot;tapered&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-ca9e8043d267b5456310acc3e6414a07" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ca9e8043d267b5456310acc3e6414a07-e-11" label="Stress field">
        <attvalues>
          <attvalue for="0" value="Stress field" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="一种物理现象，指在盘（Disc）的孔（Bore）处存在的应力分布。该应力场的大小和形态受到盘体几何结构的约束，其数值被主动控制在材料可承受的安全水平内，以防止因应力过高而导致部件损坏或失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-ca9e8043d267b5456310acc3e6414a07" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;stress field&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ca9e8043d267b5456310acc3e6414a07-e-11&quot;, &quot;chunk-0920db8a31292a7462cf7bd1b0371baa-e-3&quot;, &quot;chunk-bd60b7156cd23c0b756c44e832fda30b-e-1&quot;, &quot;chunk-150175465cd3482592c4a1c003a558af-e-3&quot;, &quot;chunk-63b965a50bbef46a7e7134449d064762-e-3&quot;, &quot;chunk-2863217e233dc47e4fc60478978f8746-e-5&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-ca9e8043d267b5456310acc3e6414a07-e-13" label="Cylindrical component">
        <attvalues>
          <attvalue for="0" value="Cylindrical component" />
          <attvalue for="1" value="Analytical Model" />
          <attvalue for="2" value="一种中空的圆柱形旋转构件，设计用于承受高应力。其几何与工况决定了内部的应力场，在力学分析中常被视为厚壁圆筒，在特定条件下（如轴向长度较短时）可简化为圆盘模型进行分析。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-ca9e8043d267b5456310acc3e6414a07" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ca9e8043d267b5456310acc3e6414a07-e-13&quot;, &quot;chunk-0920db8a31292a7462cf7bd1b0371baa-e-1&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-0920db8a31292a7462cf7bd1b0371baa-e-2" label="Hole">
        <attvalues>
          <attvalue for="0" value="Hole" />
          <attvalue for="1" value="Component Feature" />
          <attvalue for="2" value="一种零件的几何特征，指位于一个圆柱形零件内部的孔洞，其关键尺寸由内半径'a'定义。" />
          <attvalue for="3" value="{&quot;inner radius&quot;: &quot;a&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-0920db8a31292a7462cf7bd1b0371baa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0920db8a31292a7462cf7bd1b0371baa-e-4" label="Disc">
        <attvalues>
          <attvalue for="0" value="Disc" />
          <attvalue for="1" value="Component Type" />
          <attvalue for="2" value="一种对薄壁圆柱形元件的近似模型，其力学行为通常在平面应力条件下进行分析。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0920db8a31292a7462cf7bd1b0371baa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0920db8a31292a7462cf7bd1b0371baa-e-5" label="Cylinder">
        <attvalues>
          <attvalue for="0" value="Cylinder" />
          <attvalue for="1" value="Component Type" />
          <attvalue for="2" value="一种实体或厚壁的圆柱形组件，通常直径相对于长度较大。它常被用作形成腔体以容纳工作介质（如气缸），或作为主要的承重和结构部件，区别于细长的杆或轴。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-0920db8a31292a7462cf7bd1b0371baa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0920db8a31292a7462cf7bd1b0371baa-e-6" label="Plane stress conditions">
        <attvalues>
          <attvalue for="0" value="Plane stress conditions" />
          <attvalue for="1" value="Analysis Condition" />
          <attvalue for="2" value="平面应力条件是固体力学中的一种简化分析假设。它适用于一个维度（厚度）远小于另外两个维度的薄板或薄壳结构，例如圆盘。该假设认为，垂直于该平面的应力分量可以忽略不计（即为零），从而将三维应力问题简化为二维问题进行求解。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0920db8a31292a7462cf7bd1b0371baa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bd60b7156cd23c0b756c44e832fda30b-e-2" label="Radial stress component (σr)">
        <attvalues>
          <attvalue for="0" value="Radial stress component (σr)" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="径向应力分量 (στ) 是指应力场在径向上的分量，常记作σr。它描述了旋转体（如圆盘或圆筒）内部，因离心力作用而产生的径向拉伸或压缩应力。其值取决于材料属性（密度、泊松比）、几何尺寸（内外半径）、角速度及径向位置。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;(3 + ν/8)ρω²(b² + a² - a²b²/r² - r²)&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-bd60b7156cd23c0b756c44e832fda30b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Radial component of stress&quot;, &quot;Radial stress component (στ)&quot;, &quot;στ&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0920db8a31292a7462cf7bd1b0371baa-e-7&quot;, &quot;chunk-bd60b7156cd23c0b756c44e832fda30b-e-2&quot;, &quot;chunk-717d24299fbce8d4fb4707450c5ac643-e-3&quot;, &quot;chunk-e8782374074efdfc5b7bd36ebce09647-e-3&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="11" />
        </attvalues>
      </node>
      <node id="chunk-bd60b7156cd23c0b756c44e832fda30b-e-3" label="Hoop stress component (σθ)">
        <attvalues>
          <attvalue for="0" value="Hoop stress component (σθ)" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="环向应力分量 (σθ) 是应力场的一个分量，沿物体圆周的切线方向作用，用以抵抗物体因旋转离心力或内部压力导致的径向膨胀。其大小与材料的密度(ρ)和泊松比(ν)、物体的内外半径(a,b)、角速度(ω)以及具体的径向位置(r)有关。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;(3 + ν/8)ρω²(b² + a² + a²b²/r² - [1 + 3ν/3 + ν]r²)&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-bd60b7156cd23c0b756c44e832fda30b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Hoop component of stress&quot;, &quot;hoop stress&quot;, &quot;σθ&quot;, &quot;σο (Hoop Stress)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0920db8a31292a7462cf7bd1b0371baa-e-8&quot;, &quot;chunk-bd60b7156cd23c0b756c44e832fda30b-e-3&quot;, &quot;chunk-150175465cd3482592c4a1c003a558af-e-4&quot;, &quot;chunk-e8782374074efdfc5b7bd36ebce09647-e-7&quot;, &quot;chunk-7a1f5be456518061b87546ca7f9d9812-e-8&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="13" />
        </attvalues>
      </node>
      <node id="chunk-bd60b7156cd23c0b756c44e832fda30b-e-5" label="Density (ρ)">
        <attvalues>
          <attvalue for="0" value="Density (ρ)" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="在物理学和工程学中，变量ρ（Rho）通常指材料的密度。在计算旋转体（如飞轮或圆筒）的最大环向应力时，它是一个关键参数，因为材料密度直接影响离心力的大小，进而决定了应力的最终数值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-bd60b7156cd23c0b756c44e832fda30b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;p&quot;, &quot;ρ&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bd60b7156cd23c0b756c44e832fda30b-e-5&quot;, &quot;chunk-150175465cd3482592c4a1c003a558af-e-9&quot;, &quot;chunk-e8782374074efdfc5b7bd36ebce09647-e-15&quot;, &quot;chunk-7a1f5be456518061b87546ca7f9d9812-e-6&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-bd60b7156cd23c0b756c44e832fda30b-e-6" label="Angular velocity (ω)">
        <attvalues>
          <attvalue for="0" value="Angular velocity (ω)" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="角速度是一个物理量，表示物体绕某一点或某一轴转动的快慢。它被定义为角位移对时间的变化率，是描述旋转运动的关键参数。其国际单位制单位为弧度/秒（rad/s），并被用于计算轴功率等重要的工程量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-bd60b7156cd23c0b756c44e832fda30b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Angular speed&quot;, &quot;ω&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bd60b7156cd23c0b756c44e832fda30b-e-6&quot;, &quot;chunk-150175465cd3482592c4a1c003a558af-e-10&quot;, &quot;chunk-0f24474e96c9ef42ab24560f2ccf918e-e-9&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-bd60b7156cd23c0b756c44e832fda30b-e-7" label="Outer radius (b)">
        <attvalues>
          <attvalue for="0" value="Outer radius (b)" />
          <attvalue for="1" value="Geometric Parameter" />
          <attvalue for="2" value="**外半径 (b)**&#10;&#10;一个几何参数，指中空圆柱体、圆盘等物体外部边界到中心的距离。在力学分析中，它是计算径向应力(στ)与环向应力(σθ)等应力分量的关键输入变量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-bd60b7156cd23c0b756c44e832fda30b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-bd60b7156cd23c0b756c44e832fda30b-e-8" label="Inner radius (a)">
        <attvalues>
          <attvalue for="0" value="Inner radius (a)" />
          <attvalue for="1" value="Geometric Parameter" />
          <attvalue for="2" value="内径(a)是在力学分析中，定义空心圆筒、管道或压力容器等结构内部边界的关键几何参数。它直接用于确定材料在内外压力作用下的径向应力(στ)和环向应力(σθ)的分布与大小。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-bd60b7156cd23c0b756c44e832fda30b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-bd60b7156cd23c0b756c44e832fda30b-e-9" label="Radial distance (r)">
        <attvalues>
          <attvalue for="0" value="Radial distance (r)" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="一个几何变量（r），指在柱坐标或极坐标系中，某点到中心轴的垂直距离。它是一个关键的独立变量，用于计算和描述物体内部的径向应力（στ）和环向应力（σθ）等物理量随位置变化的分布情况。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-bd60b7156cd23c0b756c44e832fda30b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;r&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bd60b7156cd23c0b756c44e832fda30b-e-9&quot;, &quot;chunk-150175465cd3482592c4a1c003a558af-e-1&quot;, &quot;chunk-e8782374074efdfc5b7bd36ebce09647-e-12&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-bd60b7156cd23c0b756c44e832fda30b-e-10" label="Axis">
        <attvalues>
          <attvalue for="0" value="Axis" />
          <attvalue for="1" value="Geometric Reference" />
          <attvalue for="2" value="在几何坐标系中，作为径向距离（r）测量起点的中心参考直线。在极坐标、柱坐标或球坐标等系统中，所有点的径向位置都是相对于该轴线来定义的，是构成这些坐标系的基本元素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-bd60b7156cd23c0b756c44e832fda30b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-150175465cd3482592c4a1c003a558af-e-2" label="axis of symmetry">
        <attvalues>
          <attvalue for="0" value="axis of symmetry" />
          <attvalue for="1" value="Geometric Feature" />
          <attvalue for="2" value="在几何学中，对称轴是一条直线，物体或图形可围绕其旋转或以其为基准进行反射后，仍能与自身完全重合。它定义了物体的旋转对称性或反射对称性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-150175465cd3482592c4a1c003a558af" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-150175465cd3482592c4a1c003a558af-e-6" label="a">
        <attvalues>
          <attvalue for="0" value="a" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="参数`a`，指内孔半径（Bore Radius）。它是一个关键的几何变量，在工程力学中用于计算承压圆筒等结构的环向应力(σο)。在此特定上下文中，其值为7.5厘米。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-150175465cd3482592c4a1c003a558af" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-150175465cd3482592c4a1c003a558af-e-6&quot;, &quot;chunk-717d24299fbce8d4fb4707450c5ac643-e-5&quot;, &quot;chunk-7a1f5be456518061b87546ca7f9d9812-e-4&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-150175465cd3482592c4a1c003a558af-e-7" label="Maximum hoop stress">
        <attvalues>
          <attvalue for="0" value="Maximum hoop stress" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="一种力学性能，指旋转空心体（如圆筒或圆盘）在内孔处所承受的环向应力峰值。其数值是材料泊松比(ν)、密度(ρ)、物体角速度(ω)及内外半径(a, b)的函数。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;(σε)max&quot;, &quot;formula&quot;: &quot;[(3 + ν)/4]ρω²b² + [(1 - ν)/4]ρω²a²&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-150175465cd3482592c4a1c003a558af" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;maximum hoop stress&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-150175465cd3482592c4a1c003a558af-e-7&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-150175465cd3482592c4a1c003a558af-e-11" label="b">
        <attvalues>
          <attvalue for="0" value="b" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="在机械工程和应力分析中，变量`b`是一个关键几何参数，通常指代厚壁圆筒、压力容器或旋转盘等物体的外半径。它是计算这些构件所承受的最大环向应力的公式中的一个决定性变量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-150175465cd3482592c4a1c003a558af" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-150175465cd3482592c4a1c003a558af-e-11&quot;, &quot;chunk-717d24299fbce8d4fb4707450c5ac643-e-6&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-717d24299fbce8d4fb4707450c5ac643-e-1" label="σε (Hoop Stress)">
        <attvalues>
          <attvalue for="0" value="σε (Hoop Stress)" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="σε是一种物理量，特指环向应力（Hoop Stress）。它是在圆柱或球形壳体中承受压力时，沿圆周方向作用的应力。其大小与作用点的半径'r'成反比关系，即半径越小，应力越大。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-717d24299fbce8d4fb4707450c5ac643" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;σε&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-717d24299fbce8d4fb4707450c5ac643-e-1&quot;]}]" />
          <attvalue for="9" value="183" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-717d24299fbce8d4fb4707450c5ac643-e-2" label="r">
        <attvalues>
          <attvalue for="0" value="r" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="一个代表半径的变量（r）。在物理或工程学模型中，它通常指孔洞、圆角或颗粒的曲率半径。该值与另一物理量σε（如应力）成反比，即r减小会导致σε增大。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-717d24299fbce8d4fb4707450c5ac643" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="183" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-717d24299fbce8d4fb4707450c5ac643-e-4" label="Free Surfaces">
        <attvalues>
          <attvalue for="0" value="Free Surfaces" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="在力学分析中，指物体上不受外部法向力作用的表面，其径向应力（στ）为零。在旋转圆盘或受压圆筒等模型中，这通常对应其内孔（Bore）和外缘（Rim）表面，是应力计算中的重要边界条件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-717d24299fbce8d4fb4707450c5ac643" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-717d24299fbce8d4fb4707450c5ac643-e-8" label="Rim">
        <attvalues>
          <attvalue for="0" value="Rim" />
          <attvalue for="1" value="Component Part" />
          <attvalue for="2" value="Rim 是一个部件，特指位于恒定半径r=b处的外部自由表面。该表面是物体最外层的、不受约束的边界。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-717d24299fbce8d4fb4707450c5ac643" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-717d24299fbce8d4fb4707450c5ac643-e-9" label="Hole">
        <attvalues>
          <attvalue for="0" value="Hole" />
          <attvalue for="1" value="Feature" />
          <attvalue for="2" value="在力学和材料科学领域，孔是一种常见的物理特征，指构件上的开口或空洞。它的存在会造成几何不连续，从而在其边缘附近引起应力集中，是影响结构强度的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-717d24299fbce8d4fb4707450c5ac643" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-717d24299fbce8d4fb4707450c5ac643-e-9&quot;, &quot;chunk-e8782374074efdfc5b7bd36ebce09647-e-4&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-717d24299fbce8d4fb4707450c5ac643-e-10" label="Stress Concentration Factor">
        <attvalues>
          <attvalue for="0" value="Stress Concentration Factor" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="应力集中系数（Stress Concentration Factor）是力学中的一个无量纲因子，用于量化构件因孔洞、缺口等几何不连续性而导致的局部应力增加程度。其值定义为几何不连续处的最大应力与名义应力之比。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-717d24299fbce8d4fb4707450c5ac643" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-717d24299fbce8d4fb4707450c5ac643-e-10&quot;, &quot;chunk-e8782374074efdfc5b7bd36ebce09647-e-1&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e8782374074efdfc5b7bd36ebce09647-e-2" label="σε (Tangential Stress)">
        <attvalues>
          <attvalue for="0" value="σε (Tangential Stress)" />
          <attvalue for="1" value="Tangential Stress" />
          <attvalue for="2" value="σε是一种切向应力，其数值可通过参数a、b、p、w估算得出。在特定条件下，该应力在数值上等同于另一切向应力στ。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-e8782374074efdfc5b7bd36ebce09647" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;σε&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e8782374074efdfc5b7bd36ebce09647-e-2&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-e8782374074efdfc5b7bd36ebce09647-e-5" label="Equation (4.4)">
        <attvalues>
          <attvalue for="0" value="Equation (4.4)" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="公式(4.4)是一个数学方程式，通过将相关数值与之进行比较，从而确定应力集中系数。它在此过程中充当一个判断基准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e8782374074efdfc5b7bd36ebce09647" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e8782374074efdfc5b7bd36ebce09647-e-5&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e8782374074efdfc5b7bd36ebce09647-e-6" label="σ₁ (First principal stress at center of rotating disk)">
        <attvalues>
          <attvalue for="0" value="σ₁ (First principal stress at center of rotating disk)" />
          <attvalue for="1" value="Stress Component" />
          <attvalue for="2" value="一个应力分量，通常指旋转实心圆盘中心(r=0)处的应力。在该点，它与切向应力σθ相等，其值为(3 + ν)ρω²b²/8。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e8782374074efdfc5b7bd36ebce09647" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;σ₁&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e8782374074efdfc5b7bd36ebce09647-e-6&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e8782374074efdfc5b7bd36ebce09647-e-8" label="(3 + ν)ρω²b²/8">
        <attvalues>
          <attvalue for="0" value="(3 + ν)ρω²b²/8" />
          <attvalue for="1" value="Formula" />
          <attvalue for="2" value="该公式为固体力学中计算匀速旋转实心圆盘中心（r=0）应力的公式。它代表该点的径向应力(σr)与切向应力(σθ)大小，二者在此处相等且为最大主应力。式中ν为泊松比，ρ为材料密度，ω为角速度，b为圆盘外半径。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-e8782374074efdfc5b7bd36ebce09647" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e8782374074efdfc5b7bd36ebce09647-e-9" label="Equation (4.2)">
        <attvalues>
          <attvalue for="0" value="Equation (4.2)" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="方程(4.2)是一个用于分析应力集中系数的数学公式。在该公式中，通过将变量'a'设为0，来研究特定条件下的应力集中效应。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-e8782374074efdfc5b7bd36ebce09647" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e8782374074efdfc5b7bd36ebce09647-e-9&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e8782374074efdfc5b7bd36ebce09647-e-10" label="Equation (4.3)">
        <attvalues>
          <attvalue for="0" value="Equation (4.3)" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="公式(4.3)是一个用于分析应力集中系数的数学表达式。在该公式的应用中，通过将变量'a'的值设定为0，来研究特定条件下的应力变化情况。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
