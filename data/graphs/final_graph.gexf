          <attvalue for="9" value="10" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-819db6cd818e9e8d5c81db94051547db-e-3" label="J. A. Haynes">
        <attvalues>
          <attvalue for="0" value="J. A. Haynes" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="J. A. Haynes是一名学者，作为作者之一撰写了题为《Effect of Pt incorporation on the isothermal oxidation behaviour of chemical vapour deposition aluminide coatings》的学术论文，该研究探讨了铂(Pt)对铝化物涂层氧化行为的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
