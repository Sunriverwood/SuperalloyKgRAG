        <attvalues>
          <attvalue for="11" value="CAN_BE_FABRICATED_WITH" />
          <attvalue for="12" value="Functionally graded discs can be fabricated with methods that result in features like a dual grain structure." />
          <attvalue for="13" value="Other propriety (and subtly different) methods are available to fabricate such 'functionally graded' discs" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-f942fb543f3ac01d63fdbc3537940608" />
          <attvalue for="16" value="7.496251874062968e-05" />
