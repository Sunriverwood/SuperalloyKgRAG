        <attvalues>
          <attvalue for="11" value="USES" />
          <attvalue for="12" value="Turbine engineers select single-crystal superalloys when the best creep properties are required." />
          <attvalue for="13" value="if the very best creep properties are required, then the turbine engineers turn to them" />
