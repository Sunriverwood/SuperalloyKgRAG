        <attvalues>
          <attvalue for="11" value="DESCRIBES_POTENCY_OF" />
          <attvalue for="12" value="The harmfulness criterion is used to acknowledge the potency of an inclusion." />
          <attvalue for="13" value="The term (D – d)/D should be considered to be a 'harmfulness criterion', which acknowledges that, when d = D, the inclusion is at its most potent" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0" />
