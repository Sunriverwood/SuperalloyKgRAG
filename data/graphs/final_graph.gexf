      <node id="chunk-92b406eccca67ea13b9ebc2a390eadd2-e-2" label="A. Kempster">
        <attvalues>
          <attvalue for="0" value="A. Kempster" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="A. Kempster是一位研究人员，是科技出版物《涡轮叶片和导叶内部冷却通道的蒸气渗铝涂层》的作者之一。其研究领域主要为材料科学，特别是应用于涡轮发动机部件的高温防护涂层技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
