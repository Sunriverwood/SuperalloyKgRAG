      <node id="chunk-ae682ac4e4eb339bd48233482011cdd1-e-12" label="PE16">
        <attvalues>
          <attvalue for="0" value="PE16" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="PE16是一种镍铁铬基沉淀硬化高温合金，通常也称为Nimonic PE16。它通过铝和钛的析出相进行强化，具有出色的高温强度、抗蠕变性和良好的加工性能，广泛应用于航空发动机、燃气轮机和核反应堆等领域。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;81&quot;}" />
          <attvalue for="4" value="e-12" />
