      <edge source="chunk-28445053586870da241f4ba6806f06eb-e-6" target="chunk-04d8e878969e6a9500600ef092423800-e-9" id="chunk-04d8e878969e6a9500600ef092423800-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_DEFINED_BY" />
          <attvalue for="12" value="The transformed compliance constant S'11 is defined by Equation (A5b)." />
          <attvalue for="13" value="S'11 = S11(l1^4 + l2^4 + l3^4) + 2S12(l1^2l2^2 + l1^2l3^2 + l2^2l3^2) + S44(l2^2l3^2 + l1^2l3^2 + l1^2l2^2) (A5b)" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-04d8e878969e6a9500600ef092423800" />
          <attvalue for="16" value="0.0033738191632928472" />
