        <attvalues>
          <attvalue for="11" value="INFLUENCES" />
          <attvalue for="12" value="The incomplete understanding of creep degradation processes ('these effects') has caused superalloy development work to be highly empirical." />
          <attvalue for="13" value="With our understanding of these effects incomplete, it is unsurprising that most superalloy development work has tended to be highly empirical." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-3f4dbcf9aa48b85d20f3fbb2f49b430c" />
          <attvalue for="16" value="0.0033707865168539327" />
