        <attvalues>
          <attvalue for="11" value="ENABLES" />
          <attvalue for="12" value="A smaller γ' fraction makes weak coupling possible." />
          <attvalue for="13" value="When the γ' fraction is smaller, so-called 'weak coupling' becomes possible." />
