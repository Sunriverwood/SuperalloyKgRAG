      <node id="chunk-6f4f79d57f35ab3e77324ff6707d70bf-e-9" label="T. Yokokawa">
        <attvalues>
          <attvalue for="0" value="T. Yokokawa" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="T. Yokokawa是一位学者、研究人员。其作为合著者，参与撰写了题为《Degradation mechanisms of an advanced jet engine service-retired TBC component》的学术论文，该研究聚焦于先进航空发动机中热障涂层部件的降解机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
