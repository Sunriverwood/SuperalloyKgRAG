      <node id="chunk-413a7900ebed3c0bb042bc07c13cf29f-e-12" label="Thermomechanical fatigue of coated superalloys">
        <attvalues>
          <attvalue for="0" value="Thermomechanical fatigue of coated superalloys" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由M. I. Wood、D. Raynor与R. M. Cotgrove合著的科学文章。该文探讨了涂层高温合金的热机械疲劳问题，并被收录于出版物《燃气轮机热端部件寿命评估》（Life Assessment of Hot Section Gas Turbine Components）中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-413a7900ebed3c0bb042bc07c13cf29f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="35" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-413a7900ebed3c0bb042bc07c13cf29f-e-13" label="R. Townsend">
        <attvalues>
          <attvalue for="0" value="R. Townsend" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="R. Townsend是一位编辑，以其在技术出版物《燃气轮机热端部件的寿命评估》(Life Assessment of Hot Section Gas Turbine Components) 中的编辑工作而闻名。该著作是燃气轮机工程领域的重要参考文献。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-413a7900ebed3c0bb042bc07c13cf29f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="35" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-413a7900ebed3c0bb042bc07c13cf29f-e-14" label="Life Assessment of Hot Section Gas Turbine Components">
        <attvalues>
          <attvalue for="0" value="Life Assessment of Hot Section Gas Turbine Components" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="这是一部关于燃气轮机热端部件寿命评估的论文集，由R. Townsend编辑，材料学会 (The Institute of Material) 出版。该书汇集了多篇学术著作，深入探讨了高温合金涂层的热机械疲劳等影响燃气轮机关键部件寿命的技术问题。" />
          <attvalue for="3" value="{&quot;location&quot;: &quot;London&quot;}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-413a7900ebed3c0bb042bc07c13cf29f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-413a7900ebed3c0bb042bc07c13cf29f-e-14&quot;, &quot;chunk-67429b99cdb3121ddbb638d5930365e4-e-1&quot;]}]" />
          <attvalue for="9" value="35" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-67429b99cdb3121ddbb638d5930365e4-e-3" label="W. J. Brindley">
        <attvalues>
          <attvalue for="0" value="W. J. Brindley" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="W. J. Brindley是一位研究人员，主要研究热障涂层。他曾作为合著者，在《表面与涂层技术》期刊上发表了关于热障涂层寿命及等温氧化的研究论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-67429b99cdb3121ddbb638d5930365e4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-67429b99cdb3121ddbb638d5930365e4-e-5" label="Thermal barrier coating">
        <attvalues>
          <attvalue for="0" value="Thermal barrier coating" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="热障涂层是一种先进的陶瓷基涂层材料体系，通常应用于航空发动机、燃气轮机等高温部件的金属表面。它能为基体提供优异的热绝缘保护，使其承受更高的工作温度，从而显著提升发动机的效率、性能与使用寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-67429b99cdb3121ddbb638d5930365e4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-67429b99cdb3121ddbb638d5930365e4-e-7" label="low-pressure plasma-sprayed bond coat alloys">
        <attvalues>
          <attvalue for="0" value="low-pressure plasma-sprayed bond coat alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种采用低压等离子喷涂技术制备的合金材料，通常用作热障涂层系统中的粘结层。其主要功能是为基体提供高温抗氧化保护，并改善陶瓷面层与基体之间的附着力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-67429b99cdb3121ddbb638d5930365e4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-67429b99cdb3121ddbb638d5930365e4-e-9" label="S. Stecura">
        <attvalues>
          <attvalue for="0" value="S. Stecura" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="S. Stecura 是一位研究人员，其学术著作涉及对金属元素钇 (yttrium) 相关效应的研究。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-67429b99cdb3121ddbb638d5930365e4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d1f2b714ead29d747fbffc907324606e-e-2" label="Effects of yttrium, aluminum and chromium concentrations in bond coatings on the performance of zirconia-yttria thermal barriers">
        <attvalues>
          <attvalue for="0" value="Effects of yttrium, aluminum and chromium concentrations in bond coatings on the performance of zirconia-yttria thermal barriers" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由S. Stecura撰写的科学论文，于1980年发表在期刊《Thin Solid Films》上。该论文研究了粘结涂层中钇、铝和铬的浓度对氧化锆-氧化钇热障涂层性能的影响。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1980&quot;, &quot;volume&quot;: &quot;73&quot;, &quot;pages&quot;: &quot;481–489&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-d1f2b714ead29d747fbffc907324606e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d1f2b714ead29d747fbffc907324606e-e-4" label="Two-layer thermal barrier coatings i: Effects of composition and temperature on oxidation behaviour and failure">
        <attvalues>
          <attvalue for="0" value="Two-layer thermal barrier coatings i: Effects of composition and temperature on oxidation behaviour and failure" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由S. Stecura撰写的科学论文，1989年发表于《薄膜》(Thin Solid Films)期刊。该论文研究了成分和温度对双层热障涂层的氧化行为及失效的影响。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1989&quot;, &quot;volume&quot;: &quot;182&quot;, &quot;pages&quot;: &quot;121-139&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d1f2b714ead29d747fbffc907324606e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-50f39f54006f612a0e1ae1be19a6ae87-e-3" label="K. J. T. Livi">
        <attvalues>
          <attvalue for="0" value="K. J. T. Livi" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="K. J. T. Livi是一位作者与研究人员，以其在材料科学领域的著述而知名。他是学术出版物《热障涂层用铂改性扩散粘结层的微观结构表征》(Microstructural characterisation of a platinum-modified diffusion bond coat for thermal barrier coatings)的作者之一。" />
