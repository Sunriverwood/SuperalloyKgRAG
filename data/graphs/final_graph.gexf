      <edge source="chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-7" target="chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-6" id="chunk-e0ff1a8ba2325330670b26bb64b4b73d-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_USED_TO_SHAPE" />
          <attvalue for="12" value="Open/closed-die forming is a method used to shape a superalloy billet." />
          <attvalue for="13" value="...using a series of open/closed-die forming and machining operations..." />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-e0ff1a8ba2325330670b26bb64b4b73d" />
          <attvalue for="16" value="0.0017751479289940828" />
