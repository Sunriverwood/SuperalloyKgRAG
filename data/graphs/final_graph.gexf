        <attvalues>
          <attvalue for="11" value="IS_DEFINED_BY" />
          <attvalue for="12" value="The square of λ₁ is defined as 2Rh under the condition that h is much smaller than R." />
          <attvalue for="13" value="if h ≪ R, then λ₁² = 2Rh." />
          <attvalue for="14" value="r-1" />
