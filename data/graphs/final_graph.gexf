        <attvalues>
          <attvalue for="11" value="PROVIDES" />
          <attvalue for="12" value="The useful working (or specific power) is the energy available to provide a propulsive force." />
          <attvalue for="13" value="determine the rate of useful working (or specific power) available to provide a propulsive force." />
          <attvalue for="14" value="r-5" />
