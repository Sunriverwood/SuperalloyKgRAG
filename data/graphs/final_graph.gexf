        <attvalues>
          <attvalue for="11" value="DESIGNED_FOR_LOW_RATE_OF" />
          <attvalue for="12" value="N18 was designed with a preference for low-dwell fatigue crack propagation (FCP) rates." />
          <attvalue for="13" value="...so that alloys with low-dwell fatigue crack propagation (FCP) rates were preferred." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-2457bc4af0771717326f8f8489539e06" />
          <attvalue for="17" value="0.26666666666666666" />
        </attvalues>
      </edge>
      <edge source="chunk-61584d620a7ea3197cac715cb4ce2e82-e-8" target="chunk-2457bc4af0771717326f8f8489539e06-e-10" id="chunk-2457bc4af0771717326f8f8489539e06-r-9" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DESIGNED_TO_DEVIATE_FROM" />
          <attvalue for="12" value="N18 was specifically designed to not follow the correlation where crack growth rates scale with yield stress." />
          <attvalue for="13" value="N18 was designed to fall away from this correlation, an order of magni" />
          <attvalue for="14" value="r-9" />
          <attvalue for="15" value="chunk-2457bc4af0771717326f8f8489539e06" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-61584d620a7ea3197cac715cb4ce2e82-e-8" target="chunk-1af21239034eac9b97020a65cbbdcded-e-3" id="chunk-11fd3f8dd428533f2dacdd280d5458c0-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IMPROVES" />
          <attvalue for="12" value="N18 was designed to achieve an order of magnitude improvement in FCP rates." />
          <attvalue for="13" value="N18 was designed to fall away from this correlation, an order of magnitude improvement in FCP rates being desired." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-11fd3f8dd428533f2dacdd280d5458c0" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
