      <node id="chunk-fb8636aebcb8b8d854ebe34fb885b102-e-11" label="John Wiley &amp; Sons">
        <attvalues>
          <attvalue for="0" value="John Wiley &amp; Sons" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="John Wiley and Sons（通常简称为Wiley）是一家全球性的出版公司。该公司专注于学术出版和专业/教育材料，其出版物涵盖科学、技术、医学以及人文社科等多个领域，是全球领先的学术和专业内容提供商之一。" />
          <attvalue for="3" value="{&quot;location&quot;: &quot;New York&quot;}" />
