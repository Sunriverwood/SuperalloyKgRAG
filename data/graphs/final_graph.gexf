        <attvalues>
          <attvalue for="11" value="IS_CLOSE_TO" />
          <attvalue for="12" value="The determined value of G for nickel (82 GPa) is not far from the numerical average of the values at θ=0 and θ=π/4." />
          <attvalue for="13" value="For isotropic, polycrystalline nickel, the value of G has been determined to be about 82 GPa, not far from the numerical average of 119 GPa and 26 GPa." />
