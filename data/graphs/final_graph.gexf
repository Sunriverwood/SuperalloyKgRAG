        <attvalues>
          <attvalue for="11" value="IS_USED_TO_DOPE" />
          <attvalue for="12" value="Different elements are used to dope the 'model' NiAl-based alloys to study their effects." />
          <attvalue for="13" value="...and the effects of doping them with different elements [93]." />
