          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3219701e460dd07570bedda4067e6548-e-7" label="Compositions of single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="Compositions of single-crystal superalloys" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="单晶高温合金的化学成分，特指构成该类合金的各化学元素及其具体含量配比。它通常以镍为基体，并添加铬、钴、钨、铼等多种合金元素，其精确配比是决定合金高温强度、抗蠕变和抗氧化等关键性能的基础。" />
          <attvalue for="3" value="{&quot;evolution&quot;: &quot;significant&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-3219701e460dd07570bedda4067e6548" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f14b0074e13363327f2213611a99c96e-e-2" label="first-generation single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="first-generation single-crystal superalloys" />
          <attvalue for="1" value="Material Generation" />
          <attvalue for="2" value="第一代单晶高温合金是单晶高温合金发展的第一个技术阶段。其主要特征是去除了碳、硼等晶界强化元素，以优化高温蠕变性能。它们被广泛应用于制造航空发动机和工业燃气轮机的高温涡轮叶片。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-f14b0074e13363327f2213611a99c96e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f14b0074e13363327f2213611a99c96e-e-3" label="second-generation single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="second-generation single-crystal superalloys" />
          <attvalue for="1" value="Material Generation" />
          <attvalue for="2" value="第二代单晶高温合金是一种通过在第一代合金成分中添加约3%重量的铼(Re)元素而开发的镍基高温合金。这种成分改良显著提高了材料的高温蠕变强度和组织稳定性，使其能够承受更高的工作温度，主要用于制造先进航空发动机和工业燃气轮机的高压涡轮叶片。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-f14b0074e13363327f2213611a99c96e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="283" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-f14b0074e13363327f2213611a99c96e-e-4" label="third-generation single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="third-generation single-crystal superalloys" />
          <attvalue for="1" value="Material Generation" />
          <attvalue for="2" value="第三代单晶高温合金是一种镍基高温合金，其特征是含有高含量（约5-6%）的铼（Re），并常添加钌（Ru）以提高组织稳定性。它们拥有比前代产品更卓越的高温蠕变强度和持久性能，主要用于制造先进航空发动机及工业燃气轮机中的涡轮叶片等热端关键部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f14b0074e13363327f2213611a99c96e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="284" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-f14b0074e13363327f2213611a99c96e-e-5" label="fourth-generation single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="fourth-generation single-crystal superalloys" />
          <attvalue for="1" value="Material Generation" />
          <attvalue for="2" value="第四代单晶高温合金是一种先进的镍基高温合金。它通过在第三代合金基础上添加钌(Ru)等元素，显著提升了材料的高温强度、抗蠕变性能和组织稳定性，主要用于制造航空发动机和燃气轮机中的涡轮叶片等核心热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-f14b0074e13363327f2213611a99c96e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="285" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-f14b0074e13363327f2213611a99c96e-e-6" label="Tables 3.2, 3.3, 3.4 and 3.5">
        <attvalues>
          <attvalue for="0" value="Tables 3.2, 3.3, 3.4 and 3.5" />
          <attvalue for="1" value="Data Source" />
          <attvalue for="2" value="由表3.2、3.3、3.4和3.5组成的数据源，以表格形式详细记录并提供了第一代至第四代单晶高温合金的化学成分信息。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-f14b0074e13363327f2213611a99c96e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f14b0074e13363327f2213611a99c96e-e-10" label="refs. [24] and [25]">
        <attvalues>
          <attvalue for="0" value="refs. [24] and [25]" />
          <attvalue for="1" value="Reference" />
          <attvalue for="2" value="指参考文献[24]和[25]。这两篇文献阐述了单晶高温合金的早期发展历程，为理解该类合金的初期研究和演变提供了重要见解。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-f14b0074e13363327f2213611a99c96e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ed24a575ccc7da550855ce4a7d4ebb9f-e-1" label="Performance Improvements">
        <attvalues>
          <attvalue for="0" value="Performance Improvements" />
          <attvalue for="1" value="Outcome" />
          <attvalue for="2" value="指遵循“四项指南”（Four Guidelines）后所达成的具体性能提升。作为一种实践成果（Outcome），它直接体现并验证了该指南的有效性与价值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-ed24a575ccc7da550855ce4a7d4ebb9f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ed24a575ccc7da550855ce4a7d4ebb9f-e-2" label="Four Guidelines">
        <attvalues>
          <attvalue for="0" value="Four Guidelines" />
          <attvalue for="1" value="Design Guideline Set" />
          <attvalue for="2" value="Four Guidelines 是一个由四项具体准则组成的设计指南集合。该指南集为设计过程提供明确指导，其核心目标是通过遵循这些准则，实现并提升系统或应用的性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-ed24a575ccc7da550855ce4a7d4ebb9f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ed24a575ccc7da550855ce4a7d4ebb9f-e-4" label="γ'-forming elements">
        <attvalues>
          <attvalue for="0" value="γ'-forming elements" />
          <attvalue for="1" value="Element Group" />
          <attvalue for="2" value="γ'-形成元素是一类合金元素，例如铝(Al)、钛(Ti)和钽(Ta)。它们是形成具有强化作用的γ'相（伽马撇相）的关键组分，其含量直接决定了合金中γ'相的体积分数、稳定性与性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-ed24a575ccc7da550855ce4a7d4ebb9f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-ed24a575ccc7da550855ce4a7d4ebb9f-e-8" label="γ' fraction">
        <attvalues>
          <attvalue for="0" value="γ' fraction" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="γ'相体积分数是镍基高温合金（如Rene 95和Rene 88DT）中的一个关键微观结构参数，指γ'强化相的体积占比。它的增加能够显著降低材料在650°C等高温下的疲劳裂纹扩展速率，是决定合金高温性能的重要指标。" />
          <attvalue for="3" value="{&quot;target_value&quot;: &quot;~70%&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-ed24a575ccc7da550855ce4a7d4ebb9f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;y' content&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ed24a575ccc7da550855ce4a7d4ebb9f-e-8&quot;, &quot;chunk-ee27b5b0461f20c87cc65a6eed743e2e-e-2&quot;, &quot;chunk-198cb71263c64f896cad9847f29b39cf-e-3&quot;, &quot;chunk-f263635cd44ee57c5a9142ff0e73030b-e-5&quot;, &quot;chunk-471c3b3783689510c8ddf1dbb87d4b46-e-7&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-369e1699258e2ec0c85dd739d4083ccc-e-2" label="Single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="Single-crystal superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="单晶高温合金是一种整体由单一晶体构成的金属材料。它通过消除晶界，在高温下获得了卓越的强度、抗蠕变和抗疲劳性能，是制造航空发动机、燃气轮机涡轮叶片等关键热端部件的核心材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-369e1699258e2ec0c85dd739d4083ccc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-369e1699258e2ec0c85dd739d4083ccc-e-3" label="γ channels">
        <attvalues>
          <attvalue for="0" value="γ channels" />
          <attvalue for="1" value="Material Microstructure" />
          <attvalue for="2" value="γ通道 (γ channels) 是一种材料微观结构，特指镍基高温合金中γ'相之间的狭窄γ基体区域。在高温低应力条件下，位错的滑移运动被严格限制在这些通道内，是主导材料蠕变变形的关键特征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-369e1699258e2ec0c85dd739d4083ccc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;y channels&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-da09b64f941acad7c5dafb6cd99e1895-e-8&quot;, &quot;chunk-369e1699258e2ec0c85dd739d4083ccc-e-3&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-369e1699258e2ec0c85dd739d4083ccc-e-4" label="γ' precipitates">
        <attvalues>
          <attvalue for="0" value="γ' precipitates" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="γ'析出相是一种关键的强化相，主要存在于镍基高温合金中。它通过热处理（固溶与时效）形成并调控，是一种具有有序晶体结构（如L1₂型）的金属间化合物。该相在基体中呈共格、弥散分布，能有效阻碍位错运动，从而赋予材料卓越的高温强度和抗蠕变性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-369e1699258e2ec0c85dd739d4083ccc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-369e1699258e2ec0c85dd739d4083ccc-e-4&quot;, &quot;chunk-5b9a3c27ff490c221f01663699f4563f-e-2&quot;, &quot;chunk-ada80b922694fd6450f48225d9ee63bb-e-4&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-369e1699258e2ec0c85dd739d4083ccc-e-5" label="Creep dislocations">
        <attvalues>
          <attvalue for="0" value="Creep dislocations" />
          <attvalue for="1" value="Microstructural Defect" />
          <attvalue for="2" value="蠕变位错（Creep Dislocations）是在特定晶体（如{111}型）面上形成的一种线状晶体缺陷。这些位错的运动与增殖是材料发生蠕变变形的微观基础，并且它们通过相互作用，最终排列形成能量更低的稳定平衡位错网络。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-369e1699258e2ec0c85dd739d4083ccc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Dislocations in γ&quot;, &quot;creep dislocations&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-369e1699258e2ec0c85dd739d4083ccc-e-5&quot;, &quot;chunk-5b9a3c27ff490c221f01663699f4563f-e-1&quot;, &quot;chunk-06552db6ca6c8a18f5c48e13e0d28d19-e-3&quot;, &quot;chunk-c44bc316af8bfbfde3c05fd247258d3c-e-6&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-5b9a3c27ff490c221f01663699f4563f-e-4" label="optimum microstructure">
        <attvalues>
          <attvalue for="0" value="optimum microstructure" />
          <attvalue for="1" value="Material State" />
          <attvalue for="2" value="一种理想的材料状态，其微观结构由大量细小的γ'析出相均匀弥散于纤薄的γ基体中构成，γ'相被γ基体层有效分隔。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-5b9a3c27ff490c221f01663699f4563f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-5b9a3c27ff490c221f01663699f4563f-e-5" label="Orowan stress">
        <attvalues>
          <attvalue for="0" value="Orowan stress" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="奥罗万应力（Orowan stress）是在材料科学中，位错线绕过不可变形的第二相粒子或析出物时，所必须克服的临界剪切应力。该应力值的大小与材料的剪切模量、伯格斯矢量以及粒子间距有关，是粒子弥散强化机制的关键物理量。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;Gb/l&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-5b9a3c27ff490c221f01663699f4563f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-5b9a3c27ff490c221f01663699f4563f-e-7" label="Burgers vector">
        <attvalues>
          <attvalue for="0" value="Burgers vector" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="伯格斯矢量（Burgers vector）是材料科学中描述晶体位错的重要物理量，用矢量'b'表示。它量化了位错线周围晶格畸变的大小与方向，是决定材料强度（如粒子切割应力）等力学性能的关键本征参数。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;b&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-5b9a3c27ff490c221f01663699f4563f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;b&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5b9a3c27ff490c221f01663699f4563f-e-7&quot;, &quot;chunk-3592621846181c3ac65f3ee4259b4898-e-3&quot;, &quot;chunk-2ea107a54755373c4c649a5b4b0b14ad-e-7&quot;, &quot;chunk-4f41447104e1101d06dfe6066a69e83c-e-3&quot;, &quot;chunk-c026408b0eb125d3c56d1ed05d0a0f15-e-12&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-5b9a3c27ff490c221f01663699f4563f-e-8" label="improved properties">
        <attvalues>
          <attvalue for="0" value="improved properties" />
          <attvalue for="1" value="Material Condition" />
          <attvalue for="2" value="一种材料性能得到优化的理想状态。该状态是通过特定的微观结构调控，即降低材料中γ相（gamma phase）的体积分数来实现的，从而使材料的整体特性获得提升。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-5b9a3c27ff490c221f01663699f4563f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3592621846181c3ac65f3ee4259b4898-e-1" label="Gb/l">
        <attvalues>
          <attvalue for="0" value="Gb/l" />
          <attvalue for="1" value="Formula" />
          <attvalue for="2" value="一个材料科学公式，用于估算奥罗万应力（Orowan stress），即位错线在沉淀相之间弓弯时所需的临界应力。G、b、l分别代表材料的剪切模量、伯格斯矢量大小和粒子间距。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-3592621846181c3ac65f3ee4259b4898" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-3592621846181c3ac65f3ee4259b4898-e-4" label="l">
        <attvalues>
          <attvalue for="0" value="l" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="`l`是一个关键的微观结构参数，指在镍基高温合金等材料中，块状γ'（伽马撇）强化相之间的γ（伽马）基体通道的宽度。该尺寸是决定和预测材料蠕变、疲劳等高温力学性能的重要物理量。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;100 nm&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-3592621846181c3ac65f3ee4259b4898" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3592621846181c3ac65f3ee4259b4898-e-5" label="125 MPa">
        <attvalues>
          <attvalue for="0" value="125 MPa" />
          <attvalue for="1" value="Calculated Stress" />
          <attvalue for="2" value="一个通过Gb/l公式计算得出的应力值，其数值为125兆帕（MPa）。该值是推导“位错弯曲所需应用应力”（Applied stress for bowing）的计算基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3592621846181c3ac65f3ee4259b4898" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3592621846181c3ac65f3ee4259b4898-e-6" label="Uniaxial loading along (100)">
        <attvalues>
          <attvalue for="0" value="Uniaxial loading along (100)" />
          <attvalue for="1" value="Loading Condition" />
          <attvalue for="2" value="一种材料力学加载条件，指沿晶体学的(100)方向对材料施加单轴拉伸或压缩应力。该条件常用于研究晶体的各向异性力学行为和塑性变形，是分析滑移启动和计算施密特因子的重要前提。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-3592621846181c3ac65f3ee4259b4898" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3592621846181c3ac65f3ee4259b4898-e-7" label="Schmid factor">
        <attvalues>
          <attvalue for="0" value="Schmid factor" />
          <attvalue for="1" value="Crystallographic Parameter" />
          <attvalue for="2" value="在晶体塑性力学中，施密特因子是一个无量纲的几何因子，它将单轴外加应力分解到特定滑移系上，得到分切应力。其值由加载方向与滑移面法向及滑移方向间的夹角决定，值越大代表该滑移系越容易启动。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;1/√6&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-3592621846181c3ac65f3ee4259b4898" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-3592621846181c3ac65f3ee4259b4898-e-9" label="Applied stress for bowing">
        <attvalues>
          <attvalue for="0" value="Applied stress for bowing" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="一种力学性能，指在考虑施密特因子的情况下，驱动位错发生弯曲所需的外加应力。该属性是评估和解释单晶高温合金等先进材料力学性能的关键指标。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;306 MPa&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-3592621846181c3ac65f3ee4259b4898" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3592621846181c3ac65f3ee4259b4898-e-9&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-3592621846181c3ac65f3ee4259b4898-e-10" label="Single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="Single-crystal superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="单晶高温合金是由单一晶体构成的金属材料。由于完全消除了作为高温下薄弱环节的晶界，它们在接近熔点的温度和应力作用下，仍具备卓越的强度、抗蠕变和抗疲劳性能，是制造航空发动机涡轮叶片等核心热端部件的关键材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-3592621846181c3ac65f3ee4259b4898" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ee27b5b0461f20c87cc65a6eed743e2e-e-3" label="γ/γ' interfaces">
        <attvalues>
          <attvalue for="0" value="γ/γ' interfaces" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="γ/γ'界面是一种材料微观结构，指γ相与γ'相之间的晶体学边界。它是界面错配（interfacial misfit）现象发生的特定位置，该现象由两相的晶格常数差异引起，对材料性能有重要影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-ee27b5b0461f20c87cc65a6eed743e2e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;γ / γ' interfaces&quot;, &quot;γ/y interfaces&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ee27b5b0461f20c87cc65a6eed743e2e-e-3&quot;, &quot;chunk-c44bc316af8bfbfde3c05fd247258d3c-e-8&quot;, &quot;chunk-e1a389bc8645b3e7fa58f05c1e0a798f-e-2&quot;, &quot;chunk-4fd900e79f8eed0adbe03897dc24fda9-e-6&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ee27b5b0461f20c87cc65a6eed743e2e-e-5" label="Strengthening effect">
        <attvalues>
          <attvalue for="0" value="Strengthening effect" />
          <attvalue for="1" value="Material Phenomenon" />
          <attvalue for="2" value="一种源于γ/γ'界面的材料强化机制。该机制通过提高材料抵抗变形的能力，从而显著延长其蠕变断裂寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ee27b5b0461f20c87cc65a6eed743e2e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ee27b5b0461f20c87cc65a6eed743e2e-e-5&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ee27b5b0461f20c87cc65a6eed743e2e-e-6" label="Creep rupture lives">
        <attvalues>
          <attvalue for="0" value="Creep rupture lives" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="蠕变断裂寿命是一种材料属性，指材料在特定的恒定应力（或载荷）和高温条件下，从开始受力到最终发生断裂所持续的时间。它是衡量材料在高温下长期承载能力的关键性能指标，对于航空发动机、核反应堆等高温部件的设计和安全评估至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-ee27b5b0461f20c87cc65a6eed743e2e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ee27b5b0461f20c87cc65a6eed743e2e-e-6&quot;, &quot;chunk-3ca811c71b95902808fa11b006721fe2-e-1&quot;, &quot;chunk-bf4f5a9c3c730bf3e4d0cca1e80be672-e-6&quot;, &quot;chunk-023a8b25fea34ca6c8a3ebfc0f239288-e-1&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3ca811c71b95902808fa11b006721fe2-e-2" label="A series of alloys">
        <attvalues>
          <attvalue for="0" value="A series of alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一族为研究蠕变断裂寿命而开发的实验性合金。其特点是γ基体相与γ'强化相的化学成分在系列内保持不变，仅γ'相的体积分数系统性变化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-3ca811c71b95902808fa11b006721fe2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3ca811c71b95902808fa11b006721fe2-e-4" label="y (gamma)">
        <attvalues>
          <attvalue for="0" value="y (gamma)" />
          <attvalue for="1" value="Microstructural Phase" />
          <attvalue for="2" value="γ (gamma) 相是单晶高温合金中的基体相，与γ'强化相共存。其关键特征是热膨胀系数高于γ'相，这两种相的热力学性能失配是该类合金具有优异高温强度的基础。" />
          <attvalue for="3" value="{&quot;composition&quot;: &quot;identical&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-3ca811c71b95902808fa11b006721fe2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3ca811c71b95902808fa11b006721fe2-e-4&quot;, &quot;chunk-0d8b8971d722c099aa85646d423e67e5-e-5&quot;, &quot;chunk-807030ab9eb9ee85e606b0c18c1d17af-e-2&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-3ca811c71b95902808fa11b006721fe2-e-5" label="Tie-lines">
        <attvalues>
          <attvalue for="0" value="Tie-lines" />
          <attvalue for="1" value="Thermodynamic Concept" />
          <attvalue for="2" value="连接线（Tie-lines），又称系线，是热力学相图中两相区内的一条等温直线。其端点精确表示了平衡共存两相的化学成分，并可通过杠杆定律计算出两相的相对质量分数，是表征多组分合金相平衡的关键工具。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3ca811c71b95902808fa11b006721fe2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="165" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3ca811c71b95902808fa11b006721fe2-e-6" label="Multicomponent alloy">
        <attvalues>
          <attvalue for="0" value="Multicomponent alloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="由多种主量元素构成的合金材料。在特定温度下达到热力学平衡时，其多相区内共存相的成分由相图中的连接线（tie-lines）确定，连接线是表征其相平衡关系的关键数据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-3ca811c71b95902808fa11b006721fe2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="165" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3ca811c71b95902808fa11b006721fe2-e-7" label="Figure 3.29">
        <attvalues>
          <attvalue for="0" value="Figure 3.29" />
          <attvalue for="1" value="Data Visualization" />
          <attvalue for="2" value="图3.29是一幅数据可视化图表，以图形方式呈现了关于材料蠕变断裂寿命的实验测量结果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-3ca811c71b95902808fa11b006721fe2" />
