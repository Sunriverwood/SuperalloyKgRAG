        <attvalues>
          <attvalue for="11" value="HAS_PROPERTY" />
          <attvalue for="12" value="Nickel-based superalloys possess superior mechanical properties that are maintained at high temperatures." />
          <attvalue for="13" value="This is due to their superior mechanical properties that are maintained to elevated temperatures." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-562ab8120c986d32d5b96c3da5071063" />
          <attvalue for="16" value="0.0003491398463784676" />
          <attvalue for="17" value="0.4002094839078271" />
