      <node id="chunk-cd90df188efe63a1aba2d62ab225c3ae-e-13" label="Corrosion Science">
        <attvalues>
          <attvalue for="0" value="Corrosion Science" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《腐蚀科学》(Corrosion Science)是由爱思唯尔(Elsevier)出版的国际权威学术期刊，专注于发表金属及其他材料的腐蚀与降解现象背后的物理化学机理和基础科学方面的原创研究。" />
