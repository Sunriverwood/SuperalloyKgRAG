        <attvalues>
          <attvalue for="11" value="USES" />
          <attvalue for="12" value="Non-destructive evaluation is conducted using ultrasonic testing." />
          <attvalue for="13" value="...non-destructive evaluation (NDE) of the forging via ultrasonic testing." />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-93160044ac8bb07b73d5b072ebae265b" />
          <attvalue for="16" value="0.007618283881315156" />
