        <attvalues>
          <attvalue for="11" value="USED_IN" />
          <attvalue for="12" value="The use of columnar castings is still practiced in applications like gas turbines." />
          <attvalue for="13" value="it should be recognised that the use of castings in the columnar and equiaxed forms is still practised in many instances." />
