        <attvalues>
          <attvalue for="11" value="PRODUCES_WORK" />
          <attvalue for="12" value="During the adiabatic process BC, the gas performs work WBC." />
          <attvalue for="13" value="The work done by the gas, WBC, is given by" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-40c0e393b62f65182f74ede2f3638558" />
          <attvalue for="16" value="0.0026764951077179588" />
          <attvalue for="17" value="0.4016058970646308" />
        </attvalues>
      </edge>
      <edge source="chunk-40c0e393b62f65182f74ede2f3638558-e-4" target="chunk-8b3b1764bb264c55b0e58ee44dab55cb-e-8" id="chunk-40c0e393b62f65182f74ede2f3638558-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_PROPERTY" />
          <attvalue for="12" value="The gas is characterized by γ, the ratio of its specific heats." />
          <attvalue for="13" value="where γ is the ratio of specific heats at constant pressure and volume." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-40c0e393b62f65182f74ede2f3638558" />
          <attvalue for="16" value="3.29077267342372e-05" />
          <attvalue for="17" value="0.40001974463604056" />
        </attvalues>
      </edge>
      <edge source="chunk-40c0e393b62f65182f74ede2f3638558-e-4" target="chunk-40c0e393b62f65182f74ede2f3638558-e-5" id="chunk-40c0e393b62f65182f74ede2f3638558-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CAUSES" />
          <attvalue for="12" value="The isolated state of the gas results in zero heat transfer (QBC = 0)." />
          <attvalue for="13" value="Since the gas is isolated, QBC = 0." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-40c0e393b62f65182f74ede2f3638558" />
          <attvalue for="16" value="4.387696897898293e-05" />
          <attvalue for="17" value="0.4000263261813874" />
        </attvalues>
      </edge>
      <edge source="chunk-40c0e393b62f65182f74ede2f3638558-e-6" target="chunk-40c0e393b62f65182f74ede2f3638558-e-7" id="chunk-40c0e393b62f65182f74ede2f3638558-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_CALCULATED_BY" />
          <attvalue for="12" value="The work done, WBC, can be calculated using the expression nR(T₁ - T₂)/(γ-1)." />
          <attvalue for="13" value="WBC = ... = nR(T₁ - T₂)/(γ-1) (1.2)" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-40c0e393b62f65182f74ede2f3638558" />
          <attvalue for="16" value="0.008029485323153876" />
          <attvalue for="17" value="0.4048176911938923" />
        </attvalues>
      </edge>
      <edge source="chunk-40c0e393b62f65182f74ede2f3638558-e-7" target="chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-11" id="chunk-40c0e393b62f65182f74ede2f3638558-r-7" weight="5.0">
        <attvalues>
          <attvalue for="11" value="USES_VARIABLE" />
          <attvalue for="12" value="The work equation uses the initial temperature, T₁." />
          <attvalue for="13" value="where T₁ and T₂ are the initial and final temperatures, respectively." />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-40c0e393b62f65182f74ede2f3638558" />
          <attvalue for="16" value="0.005254267035233206" />
          <attvalue for="17" value="0.40315256022113993" />
        </attvalues>
      </edge>
      <edge source="chunk-40c0e393b62f65182f74ede2f3638558-e-7" target="chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-12" id="chunk-40c0e393b62f65182f74ede2f3638558-r-8" weight="5.0">
        <attvalues>
          <attvalue for="11" value="USES_VARIABLE" />
          <attvalue for="12" value="The work equation uses the final temperature, T₂." />
          <attvalue for="13" value="where T₁ and T₂ are the initial and final temperatures, respectively." />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-40c0e393b62f65182f74ede2f3638558" />
          <attvalue for="16" value="0.005254267035233206" />
          <attvalue for="17" value="0.40315256022113993" />
        </attvalues>
      </edge>
      <edge source="chunk-40c0e393b62f65182f74ede2f3638558-e-7" target="chunk-8b3b1764bb264c55b0e58ee44dab55cb-e-8" id="chunk-40c0e393b62f65182f74ede2f3638558-r-9" weight="5.0">
        <attvalues>
          <attvalue for="11" value="USES_VARIABLE" />
          <attvalue for="12" value="The work equation uses the ratio of specific heats, γ." />
          <attvalue for="13" value="WBC = ... = nR(T₁ - T₂)/(γ-1) (1.2)" />
          <attvalue for="14" value="r-9" />
          <attvalue for="15" value="chunk-40c0e393b62f65182f74ede2f3638558" />
          <attvalue for="16" value="8.775393795796587e-05" />
          <attvalue for="17" value="0.4000526523627748" />
        </attvalues>
      </edge>
      <edge source="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-1" target="chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-8" id="chunk-66d0225c1c0d4eadbd8c6655548b3d21-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="OCCURS_IN_CONTACT_WITH" />
          <attvalue for="12" value="The isothermal compression occurs while the gas is in contact with the cold reservoir." />
          <attvalue for="13" value="the gas, in contact with the cold reservoir at temperature T₂, undergoes an isothermal compression from VC to VD." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-66d0225c1c0d4eadbd8c6655548b3d21" />
          <attvalue for="16" value="0.010640164977403362" />
          <attvalue for="17" value="0.40638409898644207" />
        </attvalues>
      </edge>
      <edge source="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-1" target="chunk-8b3b1764bb264c55b0e58ee44dab55cb-e-6" id="chunk-66d0225c1c0d4eadbd8c6655548b3d21-r-8" weight="4.0">
        <attvalues>
          <attvalue for="11" value="STARTS_FROM" />
          <attvalue for="12" value="The isothermal compression starts from a state with volume VC." />
          <attvalue for="13" value="the gas... undergoes an isothermal compression from VC to VD." />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-66d0225c1c0d4eadbd8c6655548b3d21" />
          <attvalue for="16" value="0.00015356939142644027" />
          <attvalue for="17" value="0.26675880830152254" />
        </attvalues>
      </edge>
      <edge source="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-1" target="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-7" id="chunk-66d0225c1c0d4eadbd8c6655548b3d21-r-9" weight="4.0">
        <attvalues>
          <attvalue for="11" value="ENDS_AT" />
          <attvalue for="12" value="The isothermal compression ends at a state with volume VD." />
          <attvalue for="13" value="the gas... undergoes an isothermal compression from VC to VD." />
          <attvalue for="14" value="r-9" />
          <attvalue for="15" value="chunk-66d0225c1c0d4eadbd8c6655548b3d21" />
          <attvalue for="16" value="6.58154534684744e-05" />
          <attvalue for="17" value="0.26670615593874775" />
        </attvalues>
      </edge>
      <edge source="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-2" target="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-1" id="chunk-66d0225c1c0d4eadbd8c6655548b3d21-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="UNDERGOES" />
          <attvalue for="12" value="The gas undergoes an isothermal compression from volume VC to VD." />
          <attvalue for="13" value="the gas, in contact with the cold reservoir at temperature T₂, undergoes an isothermal compression from VC to VD." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-66d0225c1c0d4eadbd8c6655548b3d21" />
          <attvalue for="16" value="0.008292747137027774" />
          <attvalue for="17" value="0.40497564828221666" />
        </attvalues>
      </edge>
      <edge source="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-4" target="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-2" id="chunk-66d0225c1c0d4eadbd8c6655548b3d21-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_DONE_ON" />
          <attvalue for="12" value="Work (WCD) is done on the gas during the isothermal compression." />
          <attvalue for="13" value="Work is done on the gas such that WCD = ∫(from VC to VD) p dV = ∫(from VC to VD) (nRT₂/V) dV = nRT₂ ln{VD/VC} = QCD (1.3)" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-66d0225c1c0d4eadbd8c6655548b3d21" />
          <attvalue for="16" value="8.775393795796587e-05" />
          <attvalue for="17" value="0.4000526523627748" />
        </attvalues>
      </edge>
      <edge source="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-4" target="chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-10" id="chunk-66d0225c1c0d4eadbd8c6655548b3d21-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_EQUAL_TO" />
          <attvalue for="12" value="The work done during the isothermal compression (WCD) is equal to the heat transferred (QCD)." />
          <attvalue for="13" value="WCD = ∫(from VC to VD) p dV = ∫(from VC to VD) (nRT₂/V) dV = nRT₂ ln{VD/VC} = QCD (1.3)" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-66d0225c1c0d4eadbd8c6655548b3d21" />
          <attvalue for="16" value="0.0026545566232284673" />
          <attvalue for="17" value="0.4015927339739371" />
        </attvalues>
      </edge>
      <edge source="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-6" target="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-2" id="chunk-66d0225c1c0d4eadbd8c6655548b3d21-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="ACTS_ON" />
          <attvalue for="12" value="The adiabatic compression takes the gas from state D to state A." />
          <attvalue for="13" value="In the final step, an adiabatic compression takes the gas from state D to its initial state A." />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-66d0225c1c0d4eadbd8c6655548b3d21" />
          <attvalue for="16" value="0.005594313544820324" />
          <attvalue for="17" value="0.40335658812689223" />
        </attvalues>
      </edge>
      <edge source="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-6" target="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-7" id="chunk-66d0225c1c0d4eadbd8c6655548b3d21-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="STARTS_FROM" />
          <attvalue for="12" value="The adiabatic compression process starts from state D." />
          <attvalue for="13" value="In the final step, an adiabatic compression takes the gas from state D to its initial state A." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-66d0225c1c0d4eadbd8c6655548b3d21" />
          <attvalue for="16" value="8.775393795796587e-05" />
          <attvalue for="17" value="0.4000526523627748" />
        </attvalues>
      </edge>
      <edge source="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-6" target="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-8" id="chunk-66d0225c1c0d4eadbd8c6655548b3d21-r-7" weight="5.0">
        <attvalues>
          <attvalue for="11" value="ENDS_AT" />
          <attvalue for="12" value="The adiabatic compression process ends at the initial state A." />
          <attvalue for="13" value="In the final step, an adiabatic compression takes the gas from state D to its initial state A." />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-66d0225c1c0d4eadbd8c6655548b3d21" />
          <attvalue for="16" value="8.775393795796587e-05" />
          <attvalue for="17" value="0.4000526523627748" />
        </attvalues>
      </edge>
      <edge source="chunk-2f21206d7404a291608cd3acb39afcf6-e-4" target="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-6" id="chunk-2f21206d7404a291608cd3acb39afcf6-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_WORK_DONE_DURING" />
          <attvalue for="12" value="WDA is the work done on the gas during the adiabatic compression." />
          <attvalue for="13" value="Appealing to the result of step 2, the work done on the gas is given by WDA = nR(T₂ - T₁)/(γ-1) (1.4)" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-2f21206d7404a291608cd3acb39afcf6" />
          <attvalue for="16" value="0.00028520029836338906" />
          <attvalue for="17" value="0.40017112017901807" />
        </attvalues>
      </edge>
      <edge source="chunk-2f21206d7404a291608cd3acb39afcf6-e-4" target="chunk-40c0e393b62f65182f74ede2f3638558-e-6" id="chunk-2f21206d7404a291608cd3acb39afcf6-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_NEGATIVE_OF" />
          <attvalue for="12" value="The work done from D to A (WDA) is the negative of the work done from B to C (WBC)." />
          <attvalue for="13" value="Note that WDA = -WBC." />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-2f21206d7404a291608cd3acb39afcf6" />
          <attvalue for="16" value="0.0027423105611864332" />
          <attvalue for="17" value="0.4016453863367119" />
        </attvalues>
      </edge>
      <edge source="chunk-2f21206d7404a291608cd3acb39afcf6-e-5" target="chunk-66d0225c1c0d4eadbd8c6655548b3d21-e-6" id="chunk-2f21206d7404a291608cd3acb39afcf6-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_HEAT_TRANSFER_DURING" />
          <attvalue for="12" value="QDA is the heat transfer during the adiabatic compression, which is zero." />
          <attvalue for="13" value="Since the gas is isolated, QDA = 0." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-2f21206d7404a291608cd3acb39afcf6" />
          <attvalue for="16" value="0.002786187530165416" />
          <attvalue for="17" value="0.40167171251809924" />
        </attvalues>
      </edge>
      <edge source="chunk-2f21206d7404a291608cd3acb39afcf6-e-7" target="chunk-2f21206d7404a291608cd3acb39afcf6-e-4" id="chunk-2f21206d7404a291608cd3acb39afcf6-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_COMPOSED_OF" />
          <attvalue for="12" value="The total work (W) is the sum of work from all steps, including WDA." />
          <attvalue for="13" value="The total work, W, obtained in the cycle is given by W = WAB + WBC + WCD + WDA" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-2f21206d7404a291608cd3acb39afcf6" />
          <attvalue for="16" value="0.00021938484489491465" />
          <attvalue for="17" value="0.400131630906937" />
        </attvalues>
      </edge>
      <edge source="chunk-2f21206d7404a291608cd3acb39afcf6-e-7" target="chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-9" id="chunk-2f21206d7404a291608cd3acb39afcf6-r-7" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_EQUAL_TO_SUM_OF" />
          <attvalue for="12" value="The total work (W) is equal to the sum of heat transfers QAB and QCD." />
          <attvalue for="13" value="W = WAB + WBC + WCD + WDA = QAB + QCD" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-2f21206d7404a291608cd3acb39afcf6" />
          <attvalue for="16" value="0.001316309069369488" />
          <attvalue for="17" value="0.4007897854416217" />
        </attvalues>
      </edge>
      <edge source="chunk-2f21206d7404a291608cd3acb39afcf6-e-7" target="chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-10" id="chunk-2f21206d7404a291608cd3acb39afcf6-r-8" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_EQUAL_TO_SUM_OF" />
          <attvalue for="12" value="The total work (W) is equal to the sum of heat transfers QAB and QCD." />
          <attvalue for="13" value="W = WAB + WBC + WCD + WDA = QAB + QCD" />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-2f21206d7404a291608cd3acb39afcf6" />
          <attvalue for="16" value="0.001316309069369488" />
          <attvalue for="17" value="0.4007897854416217" />
        </attvalues>
      </edge>
      <edge source="chunk-c7e7be1b79841f37e4aee97dd32c3432-e-6" target="chunk-35e59a51ed8121212e1426f0053ba534-e-8" id="chunk-c7e7be1b79841f37e4aee97dd32c3432-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DEFINES" />
          <attvalue for="12" value="Equation 1.6 provides the mathematical formula for efficiency (η)." />
          <attvalue for="13" value="The efficiency, η... is given by η = W/QAB = 1 - T₂ ln{Vc/VD} / T₁ ln{VB/VA} = 1 - T₂/T₁ (1.6)" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-c7e7be1b79841f37e4aee97dd32c3432" />
          <attvalue for="16" value="0.0025668026852705018" />
          <attvalue for="17" value="0.40154008161116234" />
        </attvalues>
      </edge>
      <edge source="chunk-c7e7be1b79841f37e4aee97dd32c3432-e-6" target="chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-11" id="chunk-c7e7be1b79841f37e4aee97dd32c3432-r-4" weight="4.0">
        <attvalues>
          <attvalue for="11" value="INCLUDES" />
          <attvalue for="12" value="The efficiency formula (Equation 1.6) includes the temperature T₁." />
          <attvalue for="13" value="η = W/QAB = 1 - T₂ ln{Vc/VD} / T₁ ln{VB/VA} = 1 - T₂/T₁ (1.6)" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-c7e7be1b79841f37e4aee97dd32c3432" />
          <attvalue for="16" value="4.387696897898293e-05" />
          <attvalue for="17" value="0.26669299284805403" />
        </attvalues>
      </edge>
      <edge source="chunk-c7e7be1b79841f37e4aee97dd32c3432-e-6" target="chunk-fde6ea024225fb3f2b1ed1373ce39c8f-e-12" id="chunk-c7e7be1b79841f37e4aee97dd32c3432-r-5" weight="4.0">
        <attvalues>
          <attvalue for="11" value="INCLUDES" />
          <attvalue for="12" value="The efficiency formula (Equation 1.6) includes the temperature T₂." />
          <attvalue for="13" value="η = W/QAB = 1 - T₂ ln{Vc/VD} / T₁ ln{VB/VA} = 1 - T₂/T₁ (1.6)" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-c7e7be1b79841f37e4aee97dd32c3432" />
          <attvalue for="16" value="4.387696897898293e-05" />
          <attvalue for="17" value="0.26669299284805403" />
        </attvalues>
      </edge>
      <edge source="chunk-c7e7be1b79841f37e4aee97dd32c3432-e-6" target="chunk-c7e7be1b79841f37e4aee97dd32c3432-e-7" id="chunk-c7e7be1b79841f37e4aee97dd32c3432-r-6" weight="3.0">
        <attvalues>
          <attvalue for="11" value="DERIVED_USING" />
          <attvalue for="12" value="The derivation of Equation 1.6 makes use of relationships such as the Isothermal Process Relationship (pAVA = pBVB)." />
          <attvalue for="13" value="where use has been made of relationships such as pAVA = pBVB and pBVB^γ = pCVC^γ, etc." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-c7e7be1b79841f37e4aee97dd32c3432" />
          <attvalue for="16" value="2.1938484489491466e-05" />
          <attvalue for="17" value="0.13334649642402702" />
        </attvalues>
      </edge>
      <edge source="chunk-c7e7be1b79841f37e4aee97dd32c3432-e-6" target="chunk-c7e7be1b79841f37e4aee97dd32c3432-e-8" id="chunk-c7e7be1b79841f37e4aee97dd32c3432-r-7" weight="3.0">
        <attvalues>
          <attvalue for="11" value="DERIVED_USING" />
          <attvalue for="12" value="The derivation of Equation 1.6 makes use of relationships such as the Adiabatic Process Relationship (pBVB^γ = pCVC^γ)." />
          <attvalue for="13" value="where use has been made of relationships such as pAVA = pBVB and pBVB^γ = pCVC^γ, etc." />
          <attvalue for="14" value="r-7" />
