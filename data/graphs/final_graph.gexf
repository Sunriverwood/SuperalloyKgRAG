        <attvalues>
          <attvalue for="11" value="FORMS_FIRST_ON" />
          <attvalue for="12" value="In the oxidation process of Group III alloys, a NiO/Ni(Al, Cr)2O4 external scale arises first." />
          <attvalue for="13" value="Once again, a NiO/Ni(Al, Cr)2O4 external scale arises first, but an internal and continuous sub-sca" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-bb636c80a00702ec9bbe14461e908287" />
          <attvalue for="16" value="0.005541955664354685" />
          <attvalue for="17" value="0.2699918400652795" />
        </attvalues>
      </edge>
      <edge source="chunk-fda27af1d78f24b216020258d3d0926f-e-6" target="chunk-aae63be5befb53cbb763740fd894bee5-e-2" id="chunk-aae63be5befb53cbb763740fd894bee5-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="PRECEDES_FORMATION_OF" />
          <attvalue for="12" value="The NiO/Ni(Al, Cr)2O4 external scale arises first, before the Al2O3 sub-scale forms soon afterwards." />
          <attvalue for="13" value="Once again, a NiO/Ni(Al, Cr)2O4 external scale arises first, but an internal and continuous sub-scale of Al2O3 forms soon afterwards" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-aae63be5befb53cbb763740fd894bee5" />
          <attvalue for="16" value="0.0003399972800217598" />
          <attvalue for="17" value="0.40020399836801307" />
        </attvalues>
      </edge>
      <edge source="chunk-bb636c80a00702ec9bbe14461e908287-e-1" target="chunk-fda27af1d78f24b216020258d3d0926f-e-6" id="chunk-fda27af1d78f24b216020258d3d0926f-r-8" weight="5.0">
        <attvalues>
          <attvalue for="11" value="REPLACES" />
          <attvalue for="12" value="The continuous Cr2O3 sub-scale replaces the transient NiO/Ni(Al, Cr)2O4 scale over time." />
          <attvalue for="13" value="which, after time, replaces the NiO/Ni(Al, Cr)2O4" />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-fda27af1d78f24b216020258d3d0926f" />
          <attvalue for="16" value="0.0003399972800217598" />
          <attvalue for="17" value="0.40020399836801307" />
