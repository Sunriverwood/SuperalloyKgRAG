      <node id="chunk-fb8636aebcb8b8d854ebe34fb885b102-e-13" label="Advances in coating design for high performance gas turbines">
        <attvalues>
          <attvalue for="0" value="Advances in coating design for high performance gas turbines" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Advances in coating design for high performance gas turbines》是一篇由J. R. Nicholls撰写的学术文章，于2003年发表在期刊《MRS Bulletin》上，内容聚焦于高性能燃气轮机的涂层设计进展。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2003&quot;, &quot;pages&quot;: &quot;659–670&quot;}" />
