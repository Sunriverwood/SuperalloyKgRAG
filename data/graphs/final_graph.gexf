      <node id="chunk-5e278081cfff8673fd80e9618e358fc2-e-8" label="Mechanics of Materials">
        <attvalues>
          <attvalue for="0" value="Mechanics of Materials" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《Mechanics of Materials》是由爱思唯尔(Elsevier)出版的国际学术期刊。该刊专注于固体材料的力学行为研究，发表相关原创论文，内容涵盖材料在不同尺度下的变形、损伤、断裂机理以及其力学性能与微观结构的关系。" />
          <attvalue for="3" value="{}" />
