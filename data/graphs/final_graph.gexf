      <edge source="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-e-13" target="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-e-1" id="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DEFINES" />
          <attvalue for="12" value="Equation (2.28d) provides an alternative formula for λ₁." />
          <attvalue for="13" value="λ₁ = (2T/F)¹/² × (2π/(3f))¹/² × r₁ (2.28d)" />
          <attvalue for="14" value="r-6" />
