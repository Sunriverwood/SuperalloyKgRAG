      <node id="chunk-5e5643debeb7f102ea0f25bf148176a8-e-11" label="Siemens Westinghouse">
        <attvalues>
          <attvalue for="0" value="Siemens Westinghouse" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="西门子西屋（Siemens Westinghouse）是一家专注于电力能源领域的公司，由德国西门子在1998年收购美国西屋电气公司非核能发电业务后成立。其核心业务为燃气轮机和蒸汽轮机等发电设备的设计、制造与服务，后被完全整合入西门子能源部门。" />
          <attvalue for="3" value="{}" />
