      <node id="chunk-e973968dedf4b6408be8c39762f554b7-e-3" label="No (reference lifetime variable)">
        <attvalues>
          <attvalue for="0" value="No (reference lifetime variable)" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="一个表示参考寿命的变量，用作与实际寿命Np进行比较的基准值。在特定条件下，No与Np相等，该关系常用于设定或判断是否达到设计寿命目标或极限。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
