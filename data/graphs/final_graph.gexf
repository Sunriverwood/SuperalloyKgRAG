        <attvalues>
          <attvalue for="11" value="IS_DEFINED_AS" />
          <attvalue for="12" value="The homologous temperature is explicitly defined as the ratio T/Tm." />
          <attvalue for="13" value="One can see that the most important dimen- sionless groups are the homologous temperature, T/Tm" />
