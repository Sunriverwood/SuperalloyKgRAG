        <attvalues>
          <attvalue for="11" value="DEFINED_BY" />
          <attvalue for="12" value="The compliance component S12 is defined by Poisson's ratio (v) and Young's modulus (E)." />
          <attvalue for="13" value="S12 = -ν/E" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-59efde3cc28eec2ad611a5941651c5d8" />
          <attvalue for="16" value="0.003315467601181887" />
