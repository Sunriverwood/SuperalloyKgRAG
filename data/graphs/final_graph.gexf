          <attvalue for="11" value="APPLIED_TO" />
          <attvalue for="12" value="Overlay coatings are placed on superalloys." />
          <attvalue for="13" value="Overlay coatings placed on the superalloys are generally of MCrAlX type, where M is either nickel" />
          <attvalue for="14" value="r-5" />
