        <attvalues>
          <attvalue for="11" value="NAMED_BY_ANALOGY_WITH" />
          <attvalue for="12" value="The superlattice intrinsic stacking fault is named by analogy with the intrinsic stacking fault in γ." />
          <attvalue for="13" value="...hence, by analogy with the intrinsic stacking fault in γ, this is referred to as a superlattice intrinsic stacking fault (SISF)." />
