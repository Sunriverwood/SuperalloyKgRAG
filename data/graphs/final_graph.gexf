      <node id="chunk-311ad4452372c744328957f626b3057d-e-2" label="D. U. Furrer">
        <attvalues>
          <attvalue for="0" value="D. U. Furrer" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. U. Furrer是一位材料科学领域的学者。他撰写了《锻造未来》与《镍基高温合金涡轮盘热处理的优化》等出版物，其研究主要聚焦于锻造技术及高温合金的热处理工艺。" />
