      <edge source="chunk-97a0a28a657f3432d5d667cd779eea4b-e-5" target="chunk-dc7beb2c110a0e2f253f174dddd75d00-e-3" id="chunk-97a0a28a657f3432d5d667cd779eea4b-r-4" weight="4.0">
        <attvalues>
          <attvalue for="11" value="REQUIRES_IMPROVED" />
          <attvalue for="12" value="The engines for the Boeing 787 Dreamliner require superalloys with improved temperature capability." />
          <attvalue for="13" value="Further improvements in temperature capability are now being actively sought, for example for the engines to power the two-decked Airbus A380 and the Boeing 787 Dreamliner." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-97a0a28a657f3432d5d667cd779eea4b" />
          <attvalue for="16" value="0.0072049768298101955" />
          <attvalue for="17" value="0.2709896527645528" />
        </attvalues>
      </edge>
      <edge source="chunk-86d807c2e09f9a36246a74f6393dba7c-e-4" target="chunk-f23239a1bb5839c40c8b54140289d1ce-e-4" id="chunk-f23239a1bb5839c40c8b54140289d1ce-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_LIMITED_BY" />
          <attvalue for="12" value="The fuel economy of a modern aeroengine is limited by the high-temperature strength of its materials." />
          <attvalue for="13" value="For example, the thrust and fuel economy displayed by the modern aeroengine is strongly dependent upon, and limited by, the high-temperature strength of the nickel-based superalloys used for its hottest sections." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-f23239a1bb5839c40c8b54140289d1ce" />
          <attvalue for="16" value="0.001999619120167587" />
