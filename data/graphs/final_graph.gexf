        </attvalues>
      </node>
      <node id="chunk-e408a73fcde801378877f777a7391169-e-7" label="J. F. Radavich">
        <attvalues>
          <attvalue for="0" value="J. F. Radavich" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="J. F. Radavich 是一位编辑，他曾担任《Superalloys 1984》这一出版物的编辑工作。该书是关于高温合金领域的专业出版物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
