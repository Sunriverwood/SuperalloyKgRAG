      <node id="chunk-0bff8302b00567f9758ab71ce974ace7-e-10" label="W. S. Walston">
        <attvalues>
          <attvalue for="0" value="W. S. Walston" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="W. S. Walston是一位作者，因撰写出版物《涡轮翼型涂层与表面技术》（Coating and surface technologies for turbine aerofoils）而知名。该著作表明其在工程或材料科学领域拥有专业知识，专注于应用于涡轮机翼型等关键部件的先进涂层及表面处理技术。" />
          <attvalue for="3" value="{}" />
