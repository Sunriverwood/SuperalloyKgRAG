        <attvalues>
          <attvalue for="11" value="DAMAGED" />
          <attvalue for="12" value="A fragment from the failed HP turbine blade passed into and damaged the low-pressure turbine stages." />
          <attvalue for="13" value="This passed into the low-pressure turbine stages, where it caused overloading and collapse of the entire blade array." />
