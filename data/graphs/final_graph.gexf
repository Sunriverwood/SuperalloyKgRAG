          <attvalue for="9" value="31" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c026408b0eb125d3c56d1ed05d0a0f15-e-2" label="Large Particles">
        <attvalues>
          <attvalue for="0" value="Large Particles" />
          <attvalue for="1" value="Material Condition" />
          <attvalue for="2" value="一种材料学状态，指材料中颗粒的半径'r'较大。该状态会促进材料硬化，但会导致材料强度不再遵循传统的r¹/²依赖关系，这标志着其硬化机制不同于小颗粒区。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c026408b0eb125d3c56d1ed05d0a0f15" />
