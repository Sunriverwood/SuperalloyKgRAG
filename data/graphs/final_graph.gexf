      <node id="chunk-6f4f79d57f35ab3e77324ff6707d70bf-e-11" label="R. C. Reed">
        <attvalues>
          <attvalue for="0" value="R. C. Reed" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="R. C. Reed是一位学者，作为合著者发表了关于先进航空发动机热障涂层降解机理的科学论文《Degradation mechanisms of an advanced jet engine service-retired TBC component》。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
