      <edge source="chunk-f5c07b55f3d29bb402b546962b69a445-e-7" target="chunk-6ab819da0d17d27985ac5f6eebc6d38b-e-6" id="chunk-ee6f1e6770197cb40d6002c5cd9212fd-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_EXAMPLE_OF" />
          <attvalue for="12" value="Waspaloy is cited as an example of a cast-and-wrought superalloy billet." />
          <attvalue for="13" value="For cast-and-wrought superalloy billets such as IN718 and Waspaloy, the possible presence of random melt-related defects will continue to prevent these being used to their full fatigue potential." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-ee6f1e6770197cb40d6002c5cd9212fd" />
          <attvalue for="16" value="9.521995810321844e-05" />
          <attvalue for="17" value="0.400057131974862" />
        </attvalues>
      </edge>
      <edge source="chunk-f5c07b55f3d29bb402b546962b69a445-e-8" target="chunk-23956e10c58e231fcc8e8072af07e6f4-e-7" id="chunk-f5c07b55f3d29bb402b546962b69a445-r-8" weight="4.0">
        <attvalues>
          <attvalue for="11" value="HOUSES" />
          <attvalue for="12" value="Turbine discs are required to house the blading (turbine blades)." />
          <attvalue for="13" value="turbine discs required to house the blading." />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-f5c07b55f3d29bb402b546962b69a445" />
          <attvalue for="17" value="0.26666666666666666" />
