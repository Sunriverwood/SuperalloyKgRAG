      <edge source="chunk-44ba0b547d89e889a875ab5cd81995c8-e-4" target="chunk-44ba0b547d89e889a875ab5cd81995c8-e-1" id="chunk-44ba0b547d89e889a875ab5cd81995c8-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CLASSIFIED_BY" />
          <attvalue for="12" value="A material is classified as a high-temperature material if its homologous temperature is greater than about 0.6." />
          <attvalue for="13" value="this should be greater than about 0.6." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-44ba0b547d89e889a875ab5cd81995c8" />
          <attvalue for="16" value="0.0036075036075036075" />
          <attvalue for="17" value="0.40216450216450217" />
        </attvalues>
      </edge>
      <edge source="chunk-44ba0b547d89e889a875ab5cd81995c8-e-7" target="chunk-44ba0b547d89e889a875ab5cd81995c8-e-4" id="chunk-44ba0b547d89e889a875ab5cd81995c8-r-6" weight="3.0">
        <attvalues>
          <attvalue for="11" value="IS_A" />
          <attvalue for="12" value="Ice is also mentioned as being classifiable as a high-temperature material." />
          <attvalue for="13" value="But so is ice moving i" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-44ba0b547d89e889a875ab5cd81995c8" />
          <attvalue for="16" value="0.0011337868480725624" />
          <attvalue for="17" value="0.13401360544217686" />
        </attvalues>
      </edge>
      <edge source="chunk-44ba0b547d89e889a875ab5cd81995c8-e-7" target="chunk-3830758e4d7db91f7cb5dcf87141ced7-e-3" id="chunk-966af38b21cd6fefe9490e0dc9e97393-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_A" />
          <attvalue for="12" value="Ice at -10°C in a glacier is classified as a high-temperature material because its homologous temperature (τ) is high (~0.96)." />
          <attvalue for="13" value="But so is ice moving in a glacier field at -10°C, since τ is 263/273 ~ 0.96, although its temperature is substantially lower." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-966af38b21cd6fefe9490e0dc9e97393" />
          <attvalue for="16" value="0.001546072974644403" />
          <attvalue for="17" value="0.4009276437847867" />
        </attvalues>
      </edge>
      <edge source="chunk-966af38b21cd6fefe9490e0dc9e97393-e-5" target="chunk-3830758e4d7db91f7cb5dcf87141ced7-e-3" id="chunk-966af38b21cd6fefe9490e0dc9e97393-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_A_CONSIDERATION_FOR" />
          <attvalue for="12" value="Creep is a type of deformation that must be considered for high-temperature applications." />
          <attvalue for="13" value="For high-temperature applications, a time-dependent, inelastic and irrecoverable deformation known as creep must be considered" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-966af38b21cd6fefe9490e0dc9e97393" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-966af38b21cd6fefe9490e0dc9e97393-e-5" target="chunk-dc7beb2c110a0e2f253f174dddd75d00-e-3" id="chunk-c66ff8a529b9512996f0b3af456f00ce-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_PROPERTY_OF" />
          <attvalue for="12" value="Creep is a critical property of the superalloys." />
          <attvalue for="13" value="As the composi- tions of the alloys have evolved, the critical properties in creep and fatigue have impro" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-c66ff8a529b9512996f0b3af456f00ce" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-966af38b21cd6fefe9490e0dc9e97393-e-5" target="chunk-8debf02eecb6d1c5cb6982c6f0228498-e-2" id="chunk-f1dbde91fa2668ef8c190d0d43e91e27-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IMPROVEMENT_ALLOWED_INCREASE_IN" />
          <attvalue for="12" value="The improvement in creep properties allowed the turbine entry temperature to be increased." />
          <attvalue for="13" value="the critical properties in creep and fatigue have improved markedly – and this has allowed the turbine entry temperature to be increased beyond 1700 K" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-f1dbde91fa2668ef8c190d0d43e91e27" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-966af38b21cd6fefe9490e0dc9e97393-e-5" target="chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-3" id="chunk-e0ff1a8ba2325330670b26bb64b4b73d-r-2" weight="4.0">
        <attvalues>
          <attvalue for="11" value="INFLUENCES" />
          <attvalue for="12" value="The increasing importance of creep leads to more stringent requirements for processing steps." />
          <attvalue for="13" value="high-temperature ‘dwell' crack propagation and creep is assuming greater importance. A corollary is that the requirements placed on the various processing steps required for component fabrication are becoming more stringent." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-e0ff1a8ba2325330670b26bb64b4b73d" />
          <attvalue for="16" value="0.0021397177885727502" />
          <attvalue for="17" value="0.2679504973398103" />
        </attvalues>
      </edge>
      <edge source="chunk-966af38b21cd6fefe9490e0dc9e97393-e-6" target="chunk-966af38b21cd6fefe9490e0dc9e97393-e-5" id="chunk-dedf3a2aead3b83be780a9b424cfc9e5-r-2" weight="4.0">
        <attvalues>
          <attvalue for="11" value="CAUSES" />
          <attvalue for="12" value="Thermally activated processes are the reason creep must be considered." />
          <attvalue for="13" value="creep must be considered – due to the promotion of thermally activated processes at high τ." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-dedf3a2aead3b83be780a9b424cfc9e5" />
          <attvalue for="16" value="0.00034698126301179735" />
          <attvalue for="17" value="0.26687485542447376" />
        </attvalues>
      </edge>
      <edge source="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-3" target="chunk-966af38b21cd6fefe9490e0dc9e97393-e-6" id="chunk-dedf3a2aead3b83be780a9b424cfc9e5-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="PROMOTES" />
          <attvalue for="12" value="High τ promotes thermally activated processes." />
          <attvalue for="13" value="due to the promotion of thermally activated processes at high τ." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-dedf3a2aead3b83be780a9b424cfc9e5" />
          <attvalue for="16" value="0.0002313208420078649" />
          <attvalue for="17" value="0.40013879250520473" />
        </attvalues>
      </edge>
      <edge source="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-6" target="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-7" id="chunk-dedf3a2aead3b83be780a9b424cfc9e5-r-7" weight="4.0">
        <attvalues>
          <attvalue for="11" value="HAS_PROPERTY" />
          <attvalue for="12" value="Structural materials possess static properties that are important." />
          <attvalue for="13" value="In common with other structural materials, the static properties of yield stress, ultimate tensile strength and fracture toughness are also important" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-dedf3a2aead3b83be780a9b424cfc9e5" />
          <attvalue for="16" value="4.224043254202923e-05" />
          <attvalue for="17" value="0.2666920109261919" />
        </attvalues>
      </edge>
      <edge source="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-7" target="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-11" id="chunk-dedf3a2aead3b83be780a9b424cfc9e5-r-8" weight="5.0">
        <attvalues>
          <attvalue for="11" value="MUST_BE_MAINTAINED_OVER" />
          <attvalue for="12" value="Static properties must be maintained over time." />
          <attvalue for="13" value="and these must be maintained over time." />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-dedf3a2aead3b83be780a9b424cfc9e5" />
          <attvalue for="16" value="0.00011264115344541128" />
          <attvalue for="17" value="0.40006758469206727" />
        </attvalues>
      </edge>
      <edge source="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-8" target="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-7" id="chunk-dedf3a2aead3b83be780a9b424cfc9e5-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_A" />
          <attvalue for="12" value="Yield stress is a type of static property." />
          <attvalue for="13" value="In common with other structural materials, the static properties of yield stress, ultimate tensile strength and fracture toughness are also important" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-dedf3a2aead3b83be780a9b424cfc9e5" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-8" target="chunk-9b0d001712f3c9617fcf101c325d1706-e-4" id="chunk-b90feda161b295cfb50134cb85d41526-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_STABLE_WITH" />
          <attvalue for="12" value="For γ/γ' alloys, the yield stress remains relatively stable with increasing temperature below approximately 700 °C." />
          <attvalue for="13" value="For γ/γ' alloys, the yield stress does not decrease strongly as the temperature increases, provided that one stays below about 700 °C" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-b90feda161b295cfb50134cb85d41526" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-8" target="chunk-18e706cf8ca843db25be30e8eb057f20-e-3" id="chunk-0659b62691281fc5f1e0a0636a9eb57b-r-4" weight="3.0">
        <attvalues>
          <attvalue for="11" value="IS_ASSUMED_IN" />
          <attvalue for="12" value="The yield stress is assumed to exist in the (001) direction for the purpose of an argument." />
          <attvalue for="13" value="Assuming for one moment that the yield stresses in the (001) and (111) directions are equal" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-0659b62691281fc5f1e0a0636a9eb57b" />
          <attvalue for="16" value="0.007918552036199093" />
          <attvalue for="17" value="0.1380844645550528" />
        </attvalues>
      </edge>
      <edge source="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-8" target="chunk-18e706cf8ca843db25be30e8eb057f20-e-4" id="chunk-0659b62691281fc5f1e0a0636a9eb57b-r-5" weight="3.0">
        <attvalues>
          <attvalue for="11" value="IS_ASSUMED_IN" />
          <attvalue for="12" value="The yield stress is assumed to exist in the (111) direction for the purpose of an argument." />
          <attvalue for="13" value="Assuming for one moment that the yield stresses in the (001) and (111) directions are equal" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-0659b62691281fc5f1e0a0636a9eb57b" />
          <attvalue for="16" value="0.02262443438914027" />
          <attvalue for="17" value="0.1469079939668175" />
        </attvalues>
      </edge>
      <edge source="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-8" target="chunk-738d5a08a05f18670227192d3b2434f7-e-10" id="chunk-740f6c1fef49d66e9d25ef0e2de914da-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="EXHIBITED_BY" />
          <attvalue for="12" value="The PWA1480 single-crystal superalloy exhibits a fair degree of anisotropy in its yield stress." />
          <attvalue for="13" value="In fact, the yield stress shows a fair degree of anisotropy; see, for example, the data of ref. [72] for the PWA1480 single-crystal superalloy (Figure 3.72)." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-740f6c1fef49d66e9d25ef0e2de914da" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-8" target="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-6" id="chunk-6b0fd58b99d0490b98efe29e49c3ef5d-r-3" weight="4.0">
        <attvalues>
          <attvalue for="11" value="CORRELATES_WITH" />
          <attvalue for="12" value="Plotting yield stress against the root of the sum of the strengthening phases results in a reasonably straight line." />
          <attvalue for="13" value="if one plots the yield stress against the root of the sum of the strengthening phases, a reasonably straight line is found" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-6b0fd58b99d0490b98efe29e49c3ef5d" />
          <attvalue for="17" value="0.26666666666666666" />
        </attvalues>
      </edge>
      <edge source="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-8" target="chunk-6b0fd58b99d0490b98efe29e49c3ef5d-e-7" id="chunk-6b0fd58b99d0490b98efe29e49c3ef5d-r-4" weight="4.0">
        <attvalues>
          <attvalue for="11" value="CONSISTENT_WITH" />
          <attvalue for="12" value="The linear relationship between yield stress and strengthening phases is consistent with the hardening theories of Chapter 2." />
          <attvalue for="13" value="a reasonably straight line is found, consistent with the hardening theories of Chapter 2" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-6b0fd58b99d0490b98efe29e49c3ef5d" />
          <attvalue for="16" value="0.003393665158371041" />
          <attvalue for="17" value="0.2687028657616893" />
        </attvalues>
      </edge>
      <edge source="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-8" target="chunk-f5c07b55f3d29bb402b546962b69a445-e-8" id="chunk-d9d4e9c6bdfb7df170a8302da4a9bf0c-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_PROPERTY_OF" />
          <attvalue for="12" value="Yield stress is a property of a turbine disc alloy." />
          <attvalue for="13" value="In practice, the yield stress of a turbine disc alloy has been found to depend critically on the heat treatment applied to it" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-d9d4e9c6bdfb7df170a8302da4a9bf0c" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-8" target="chunk-0d8b8971d722c099aa85646d423e67e5-e-9" id="chunk-d9d4e9c6bdfb7df170a8302da4a9bf0c-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DEPENDS_ON" />
          <attvalue for="12" value="The yield stress of a turbine disc alloy is critically dependent on the heat treatment applied to it." />
          <attvalue for="13" value="In practice, the yield stress of a turbine disc alloy has been found to depend critically on the heat treatment applied to it" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-d9d4e9c6bdfb7df170a8302da4a9bf0c" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-8" target="chunk-b90feda161b295cfb50134cb85d41526-e-10" id="chunk-c2b78e8b376569da6104df59fa66c5ca-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_FUNCTION_OF" />
          <attvalue for="12" value="The yield stress is described as a sensitive function of the distribution of the γ' phase." />
          <attvalue for="13" value="This is particularly the case for properties such as the yield stress, which is a sensitive function of the distribution of the γ' phase" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-c2b78e8b376569da6104df59fa66c5ca" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-10" target="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-7" id="chunk-dedf3a2aead3b83be780a9b424cfc9e5-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_A" />
          <attvalue for="12" value="Fracture toughness is a type of static property." />
          <attvalue for="13" value="In common with other structural materials, the static properties of yield stress, ultimate tensile strength and fracture toughness are also important" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-dedf3a2aead3b83be780a9b424cfc9e5" />
          <attvalue for="16" value="8.448086508405846e-05" />
          <attvalue for="17" value="0.40005068851905046" />
        </attvalues>
      </edge>
      <edge source="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-10" target="chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-11" id="chunk-84f8e7f39bc8df67a9604e9a01eac9a9-r-11" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IMPARTS_TOLERANCE_TO" />
          <attvalue for="12" value="Fracture toughness imparts tolerance to defects." />
          <attvalue for="13" value="...ductility and fracture toughness, to impart tolerance to defects" />
