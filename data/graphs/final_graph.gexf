        <attvalues>
          <attvalue for="11" value="IS_TRANSFORMATION_OF" />
          <attvalue for="12" value="S'11 is the new, transformed value of the original S11 component." />
          <attvalue for="13" value="...the new value of S11, denoted S'11, is given by" />
