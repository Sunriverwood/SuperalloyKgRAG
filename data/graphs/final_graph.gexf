          <attvalue for="9" value="308" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-d6790fb9c1169445a5d3fb409c8aba9c-e-4" label="Np (fatigue/design life variable)">
        <attvalues>
          <attvalue for="0" value="Np (fatigue/design life variable)" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="变量Np，也记为No，是用于表示寿命的物理量。其数值与比率d/D成反相关，即当d/D趋于零时，Np的值趋于无穷大，这一关系在图4.46中得到了展示。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d6790fb9c1169445a5d3fb409c8aba9c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Np&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0-e-2&quot;, &quot;chunk-d6790fb9c1169445a5d3fb409c8aba9c-e-4&quot;, &quot;chunk-98004d55693f7f9432c5daf0464e7353-e-9&quot;]}]" />
          <attvalue for="9" value="34" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-d6790fb9c1169445a5d3fb409c8aba9c-e-5" label="No">
        <attvalues>
          <attvalue for="0" value="No" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="一个变量，其值被定义为另一变量 Np 在特定条件 d=D 时的取值。它通常代表系统在某个基准、临界或初始状态下的一个关键参数或数量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d6790fb9c1169445a5d3fb409c8aba9c" />
          <attvalue for="6" value="true" />
