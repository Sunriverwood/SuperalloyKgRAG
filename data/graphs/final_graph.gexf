        <attvalues>
          <attvalue for="0" value="Figure 2.45" />
          <attvalue for="1" value="Figure" />
          <attvalue for="2" value="图2.45是一幅示意图，用于图解和阐明控制颗粒剪切（particle shearing）现象起始的内在机制与原理。" />
          <attvalue for="3" value="{}" />
