      <node id="chunk-d5ce586afcf8fd710ae4779854d26909-e-9" label="Mo-41Re">
        <attvalues>
          <attvalue for="0" value="Mo-41Re" />
          <attvalue for="1" value="Exotic Alloy" />
          <attvalue for="2" value="Mo-41Re是一种钼铼（Molybdenum-Rhenium）异种合金。它被认为是一种极具潜力的高温材料，展现出优异的高温性能前景，但目前尚未在燃气轮机中获得实际应用。" />
