        <attvalues>
          <attvalue for="11" value="MODIFIES" />
          <attvalue for="12" value="Heat treatment puts γ' precipitates into solution and allows them to re-develop with a uniform microstructure." />
          <attvalue for="13" value="This puts the y' precipitates into solution; during subsequent exposure to lower temperatures, the y' develops a uniform microstructure with an optimum precipitate size." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-ada80b922694fd6450f48225d9ee63bb" />
