        <attvalues>
          <attvalue for="11" value="USED_FOR" />
          <attvalue for="12" value="Polycrystalline nickel-based superalloys are used for turbine disc applications." />
          <attvalue for="13" value="For many of the polycrystalline nickel-based superalloys used for turbine disc applications, the Paris relationship is of the form" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-8f26cf45a6fdac28f68b7d1e6d3677ff" />
