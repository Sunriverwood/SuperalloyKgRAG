      <node id="chunk-d5ce586afcf8fd710ae4779854d26909-e-5" label="TiAl">
        <attvalues>
          <attvalue for="0" value="TiAl" />
          <attvalue for="1" value="Intermetallic Compound" />
          <attvalue for="2" value="钛铝化合物（TiAl）是一种金属间化合物。它因具备优异的高温性能而被视为一种极具潜力的新型高温结构材料，但根据上下文信息，它尚未在燃气轮机中获得实际应用。" />
          <attvalue for="3" value="{}" />
