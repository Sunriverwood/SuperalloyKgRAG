      <edge source="chunk-ac23817ca85b5e2cba9cb1da3a1960fc-e-7" target="chunk-64f0b642dc984a92646a132ee856bc18-e-5" id="chunk-ac23817ca85b5e2cba9cb1da3a1960fc-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DRIVES" />
          <attvalue for="12" value="The forces τbλᵢ are described as driving the particle-shearing process." />
          <attvalue for="13" value="the forces τbλᵢ (i = 1, 2) driving the particle-shearing process" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-ac23817ca85b5e2cba9cb1da3a1960fc" />
          <attvalue for="16" value="0.0001408014418067641" />
