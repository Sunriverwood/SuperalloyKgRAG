          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d246d51e161275b250bc309214ccd241-e-9&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d246d51e161275b250bc309214ccd241-e-11" label="binary Ni alloy">
        <attvalues>
          <attvalue for="0" value="binary Ni alloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="二元镍合金是一种仅由两种化学元素组成的金属材料，其中镍（Ni）是主要基体金属。通过添加单一的第二种元素（如铜、铁或铬），可以系统地调整和优化该合金的物理、化学或机械性能，常用于材料科学的基础研究和特定工业应用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-d246d51e161275b250bc309214ccd241" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-62f2a69b28a3f59402f17b59e67f8707-e-2" label="Grain boundary segregation in Ni and binary Ni alloys doped with sulphur">
        <attvalues>
          <attvalue for="0" value="Grain boundary segregation in Ni and binary Ni alloys doped with sulphur" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由R. A. Mulford撰写的一篇科学论文，于1983年发表在《冶金汇刊》(Metallurgical Transactions)上。该论文主要研究了以硫(sulphur)为掺杂剂时，镍(Ni)和二元镍合金内部发生的晶界偏析现象。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1983&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-62f2a69b28a3f59402f17b59e67f8707" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-62f2a69b28a3f59402f17b59e67f8707-e-2&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-62f2a69b28a3f59402f17b59e67f8707-e-4" label="Ni">
        <attvalues>
          <attvalue for="0" value="Ni" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍（Ni），一种金属材料。在材料科学领域，其晶界偏析现象是一个研究课题，相关研究关注其在纯净形态以及掺杂硫的二元合金中的表现。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-62f2a69b28a3f59402f17b59e67f8707" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-62f2a69b28a3f59402f17b59e67f8707-e-5" label="binary Ni alloys">
        <attvalues>
          <attvalue for="0" value="binary Ni alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="二元镍合金（Binary Ni alloys）是一种由金属镍与另一种主要元素组成的合金。这类材料因其组元和配比的多样性而展现出不同的物理化学性质，在材料科学领域常作为研究模型，用于探究晶界偏析、腐蚀、催化等基本现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-62f2a69b28a3f59402f17b59e67f8707" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-62f2a69b28a3f59402f17b59e67f8707-e-7" label="D. McLean">
        <attvalues>
          <attvalue for="0" value="D. McLean" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="D. McLean是一位金属学家与作者，其撰写的专著《金属中的晶界》(Grain Boundaries in Metals)是材料科学领域的经典作品之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-62f2a69b28a3f59402f17b59e67f8707" />
