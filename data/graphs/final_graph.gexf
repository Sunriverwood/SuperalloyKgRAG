      <edge source="chunk-9b96433e844031d4f15964cb1b24320d-e-4" target="chunk-9b96433e844031d4f15964cb1b24320d-e-3" id="chunk-9b96433e844031d4f15964cb1b24320d-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DEPENDS_ON" />
          <attvalue for="12" value="The degree of anisotropy is directly dependent on the value of the mathematical term [l1^2l2^2 + l2^2l3^2 + l3^2l1^2]." />
          <attvalue for="13" value="Thus, the degree of anisotropy depends upon the term [l1^2l2^2 + l2^2l3^2 + l3^2l1^2]" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-9b96433e844031d4f15964cb1b24320d" />
          <attvalue for="16" value="0.0020242914979757085" />
          <attvalue for="17" value="0.4012145748987854" />
        </attvalues>
      </edge>
      <edge source="chunk-7468b5a535de86347797d4977b885a9e-e-3" target="chunk-7468b5a535de86347797d4977b885a9e-e-6" id="chunk-7468b5a535de86347797d4977b885a9e-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_CONTROLLED_BY" />
          <attvalue for="12" value="The resistance to shearing is largely controlled by the value of S44, as seen from the elasticity equations." />
          <attvalue for="13" value="From the elasticity equations, one can see that this is largely controlled by the value of S44" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-7468b5a535de86347797d4977b885a9e" />
          <attvalue for="16" value="0.002989074417645846" />
