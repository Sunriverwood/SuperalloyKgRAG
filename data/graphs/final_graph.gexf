      <node id="chunk-cb57093a6357773efc0ab02b57f76fa1-e-22" label="ONERA">
        <attvalues>
          <attvalue for="0" value="ONERA" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="ONERA，全称“法国国家航空航天研究中心”（Office National d'Études et de Recherches Aérospatiales），是法国在航空航天领域的国家级核心研究机构。作为一家具有工商企业性质的公立机构，它致力于发展和引导法国在航空、航天及国防领域的研究，为政府决策和产业发展提供关键技术支持。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-22" />
          <attvalue for="5" value="chunk-cb57093a6357773efc0ab02b57f76fa1" />
