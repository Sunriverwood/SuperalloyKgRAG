        <attvalues>
          <attvalue for="11" value="HAS_CONSTANT_CONCENTRATION_IN" />
          <attvalue for="12" value="The study on Udimet 720Li was conducted with a constant Carbon concentration of 0.025 wt%." />
          <attvalue for="13" value="...at a constant concentration of 0.025 wt%C;" />
