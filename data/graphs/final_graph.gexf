          <attvalue for="9" value="59" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b18667fadfdf7cfdf2bd35cc10bf1f84-e-10" label="D. A. Cooper">
        <attvalues>
          <attvalue for="0" value="D. A. Cooper" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. A. Cooper，与D. F. King共同撰写了一份关于某次事故的报告的作者。该描述基于其作为报告合著者的身份及其与合作伙伴的关系。" />
