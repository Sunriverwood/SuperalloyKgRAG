      <node id="chunk-50f39f54006f612a0e1ae1be19a6ae87-e-4" label="P. K. Wright">
        <attvalues>
          <attvalue for="0" value="P. K. Wright" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="P. K. Wright是一位学者或研究人员，专注于材料科学领域，特别是热障涂层技术。他是科学出版物《铂改性扩散粘结涂层的微观结构表征》(Microstructural characterisation of a platinum-modified diffusion bond coat for thermal barrier coatings) 的作者之一。" />
          <attvalue for="3" value="{}" />
