        <attvalues>
          <attvalue for="11" value="NOTED_EFFECT_OF" />
          <attvalue for="12" value="Pratt &amp; Whitney noted the significant effect of Tantalum in reducing dwell FCP rates." />
          <attvalue for="13" value="The significant effect of Ta in reducing dwell FCP rates has been noted in collaborative work by Pratt &amp; Whitney" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-58a0b5872320286acd36be7afd8ed1ba" />
          <attvalue for="17" value="0.26666666666666666" />
