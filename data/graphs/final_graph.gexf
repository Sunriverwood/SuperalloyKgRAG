      <node id="chunk-3b7190e1fe7c8f3dcc05817f989e004f-e-1" label="Rocket">
        <attvalues>
          <attvalue for="0" value="Rocket" />
          <attvalue for="1" value="Vehicle" />
          <attvalue for="2" value="一种用于探月的巨型运载火箭。它由新型金属合金制成，其尺寸巨大，长度与一个足球场相当，旨在执行前往月球的太空任务。" />
          <attvalue for="3" value="{&quot;height&quot;: &quot;more than three hundred feet tall&quot;, &quot;length&quot;: &quot;the length of this football field&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-3b7190e1fe7c8f3dcc05817f989e004f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="41" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-3b7190e1fe7c8f3dcc05817f989e004f-e-2" label="Moon">
        <attvalues>
          <attvalue for="0" value="Moon" />
          <attvalue for="1" value="Celestial Body" />
          <attvalue for="2" value="月球是地球唯一的天然卫星，也是距离地球最近的天体。作为人类太空探索（如火箭发射任务）的重要目的地，它围绕地球运行，并对地球的潮汐和自转产生显著影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-3b7190e1fe7c8f3dcc05817f989e004f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="41" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3b7190e1fe7c8f3dcc05817f989e004f-e-3" label="Control Station in Houston">
        <attvalues>
          <attvalue for="0" value="Control Station in Houston" />
          <attvalue for="1" value="Facility" />
          <attvalue for="2" value="位于休斯顿的任务控制中心，是负责指挥与监控太空火箭任务的地面设施。在探月任务中，它与远在约24万英里外的月球进行远程通信与控制，是整个任务的神经中枢。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-3b7190e1fe7c8f3dcc05817f989e004f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="41" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3b7190e1fe7c8f3dcc05817f989e004f-e-4" label="New Metal Alloys">
        <attvalues>
          <attvalue for="0" value="New Metal Alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="**新型金属合金 (New Metal Alloys)** 是一类先进的、部分尚处设想阶段的金属材料。它们被专门设计用于建造火箭等航天器，其核心特性是具备卓越的性能，能够承受太空飞行中所遇到的极端高温和巨大机械应力，以确保结构完整性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-3b7190e1fe7c8f3dcc05817f989e004f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="41" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3b7190e1fe7c8f3dcc05817f989e004f-e-5" label="Heat and Stresses">
        <attvalues>
          <attvalue for="0" value="Heat and Stresses" />
          <attvalue for="1" value="Physical Condition" />
          <attvalue for="2" value="一种物理条件，特指火箭等航天器材料在发射或再入大气层等极端工况下，必须承受的极高温度和巨大机械应力的总称。这些条件对材料的耐热性和结构强度提出了严峻挑战。" />
          <attvalue for="3" value="{&quot;level&quot;: &quot;several times more than have ever been experienced&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3b7190e1fe7c8f3dcc05817f989e004f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3b7190e1fe7c8f3dcc05817f989e004f-e-5&quot;, &quot;chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-1&quot;]}]" />
          <attvalue for="9" value="41" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3b7190e1fe7c8f3dcc05817f989e004f-e-6" label="Football Field">
        <attvalues>
          <attvalue for="0" value="Football Field" />
          <attvalue for="1" value="Reference Object" />
          <attvalue for="2" value="一种标准化的美式橄榄球比赛场地。因其端区之间100码（约91.44米）的长度广为人知，常被用作一个通俗的参照物，以帮助直观地描述和比较大型物体（如火箭）的尺寸规模。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-3b7190e1fe7c8f3dcc05817f989e004f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="41" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-2" label="Mission Equipment">
        <attvalues>
          <attvalue for="0" value="Mission Equipment" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="指为特定任务而配置的全套设备构成的集成系统。其所有组件都经过高精度组装，作为任务的核心载荷，旨在确保任务目标的顺利实现。" />
          <attvalue for="3" value="{&quot;components&quot;: [&quot;propulsion&quot;, &quot;guidance&quot;, &quot;control&quot;, &quot;communications&quot;, &quot;food&quot;, &quot;survival&quot;]}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-08e3f5162aec4977b5f7bdcccbd3e160" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="41" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-3" label="Untried Mission">
        <attvalues>
          <attvalue for="0" value="Untried Mission" />
          <attvalue for="1" value="Event" />
          <attvalue for="2" value="Untried Mission是一种太空探索事件，目标是前往未知天体并安全返回地球。该任务的关键挑战在于，其携带的设备必须在重返大气层时，成功经受住由此产生的极端高温和应力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-08e3f5162aec4977b5f7bdcccbd3e160" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="41" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-4" label="Unknown Celestial Body">
        <attvalues>
          <attvalue for="0" value="Unknown Celestial Body" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="一个身份和性质尚不明确的天体。在特定语境下，它是一项尚未尝试或执行的太空探索任务所计划前往的目的地或目标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-08e3f5162aec4977b5f7bdcccbd3e160" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="41" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-5" label="Earth">
        <attvalues>
          <attvalue for="0" value="Earth" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="地球是太阳系从内到外的第三颗行星，是目前宇宙中唯一已知存在生命的星球，也是人类赖以生存和发展的家园。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-08e3f5162aec4977b5f7bdcccbd3e160" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="41" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-6" label="Atmosphere">
        <attvalues>
          <attvalue for="0" value="Atmosphere" />
          <attvalue for="1" value="Geographical Feature" />
          <attvalue for="2" value="地球大气层是由地球引力维系、环绕地球的混合气体层。它主要由氮气和氧气组成，通过吸收太阳辐射和调节温度来保护生命。对于航天任务而言，它是航天器在返航时必须高速再入的介质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-08e3f5162aec4977b5f7bdcccbd3e160" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="41" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-7" label="Re-entry Heat">
        <attvalues>
          <attvalue for="0" value="Re-entry Heat" />
          <attvalue for="1" value="Physical Condition" />
          <attvalue for="2" value="再入热是一种物理现象，指航天器等物体高速进入行星大气层时，因前方空气被剧烈压缩和摩擦所产生的极端高温。其温度极高，有时可与太阳表面相比，是航天任务（尤其是未经尝试的任务）在返回阶段必须克服的关键挑战。" />
          <attvalue for="3" value="{&quot;speed&quot;: &quot;over 25 000 miles per hour&quot;, &quot;temperature_comparison&quot;: &quot;about half that of the temperature of the sun&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-08e3f5162aec4977b5f7bdcccbd3e160" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="41" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-8" label="Sun">
        <attvalues>
          <attvalue for="0" value="Sun" />
          <attvalue for="1" value="Celestial Body" />
          <attvalue for="2" value="太阳是位于太阳系中心的恒星，一颗G型主序星（黄矮星）。它占据了太阳系总质量的99.8%以上，通过其核心的核聚变反应产生巨大能量，以光和热的形式向外辐射。太阳是地球最重要的能量来源，其引力维系着行星、小行星等天体的运行轨道。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-08e3f5162aec4977b5f7bdcccbd3e160" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;The Sun&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-08e3f5162aec4977b5f7bdcccbd3e160-e-8&quot;, &quot;chunk-caf10e1ff2600a4e9c7b7b30e4ee750a-e-2&quot;]}]" />
          <attvalue for="9" value="41" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-caf10e1ff2600a4e9c7b7b30e4ee750a-e-1" label="John F. Kennedy">
        <attvalues>
          <attvalue for="0" value="John F. Kennedy" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="约翰·F·肯尼迪（John F. Kennedy, 1917-1963），美国政治家，美国第35任总统。他于1962年9月12日在莱斯大学发表了著名的“我们选择登月”演说，阐明了美国在60年代末前将宇航员送上月球的国家目标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-caf10e1ff2600a4e9c7b7b30e4ee750a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="70" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-caf10e1ff2600a4e9c7b7b30e4ee750a-e-3" label="Rice University">
        <attvalues>
          <attvalue for="0" value="Rice University" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="莱斯大学（Rice University）是一所位于美国德克萨斯州休斯顿的私立研究型大学。该校因美国前总统约翰·肯尼迪于1962年在此发表了关于美国太空计划的“我们选择登月”著名演讲而广为人知。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-caf10e1ff2600a4e9c7b7b30e4ee750a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="70" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-caf10e1ff2600a4e9c7b7b30e4ee750a-e-4" label="Houston, Texas">
        <attvalues>
          <attvalue for="0" value="Houston, Texas" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="休斯顿是美国德克萨斯州的第一大城市，也是全美第四大城市。它以其能源（特别是石油）、航空航天（NASA）及医疗产业闻名于世，是美国南部重要的经济和文化中心。著名学府莱斯大学坐落于此。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-caf10e1ff2600a4e9c7b7b30e4ee750a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="70" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-caf10e1ff2600a4e9c7b7b30e4ee750a-e-5" label="12 September 1962">
        <attvalues>
          <attvalue for="0" value="12 September 1962" />
          <attvalue for="1" value="Date" />
          <attvalue for="2" value="1962年9月12日，美国总统约翰·肯尼迪在莱斯大学发表了著名的“我们选择登月”演说。该演讲为美国的太空探索设定了宏伟目标，即在十年内将人类送上月球，成为阿波罗计划的里程碑。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-caf10e1ff2600a4e9c7b7b30e4ee750a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="70" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-caf10e1ff2600a4e9c7b7b30e4ee750a-e-6" label="Dr Mike Hicks">
        <attvalues>
          <attvalue for="0" value="Dr Mike Hicks" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="迈克·希克斯博士（Dr. Mike Hicks）是为特定出版物撰写前言部分的作者。作为前言的创作者，他的角色通常是为该作品提供权威性的介绍、背景或推荐。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-caf10e1ff2600a4e9c7b7b30e4ee750a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="137" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-caf10e1ff2600a4e9c7b7b30e4ee750a-e-7" label="Foreword">
        <attvalues>
          <attvalue for="0" value="Foreword" />
          <attvalue for="1" value="Document Section" />
          <attvalue for="2" value="一篇置于文档正文前的介绍性文字，通常由主作者以外的第三方（此处为迈克·希克斯博士）撰写，旨在介绍、评论或推荐该作品。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-caf10e1ff2600a4e9c7b7b30e4ee750a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="137" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8c60d2526947a5ab3509fae533f5e115-e-1" label="Dr Mike Hicks">
        <attvalues>
          <attvalue for="0" value="Dr Mike Hicks" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="为罗杰·里德（Roger Reed）的教科书《高温合金》（The Superalloys）撰写前言的作者。通过这篇前言，他为该学术著作提供了专业的评述与引介。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-8c60d2526947a5ab3509fae533f5e115" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8c60d2526947a5ab3509fae533f5e115-e-2" label="Foreword">
        <attvalues>
          <attvalue for="0" value="Foreword" />
          <attvalue for="1" value="Document Section" />
          <attvalue for="2" value="前言（Foreword）是位于书籍等文档开头的独立章节。其显著特点是由作品作者以外的人士（如专家、名人）撰写，旨在向读者引荐该作品或作者，评论其价值与意义，并为作品赋予权威性或提供一个外部视角。它区别于通常由作者本人撰写的“序言”（Preface）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-8c60d2526947a5ab3509fae533f5e115" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-562ab8120c986d32d5b96c3da5071063-e-3" label="Nickel-based superalloys">
        <attvalues>
          <attvalue for="0" value="Nickel-based superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍基合金是以镍为基体，加入其他元素所构成的一类合金，常因其优异的高温强度和抗腐蚀性而被称为“超级合金”。规定强度是其关键力学性能指标，使其广泛应用于航空发动机等对安全裕度要求极高的领域。Waspaloy是其典型牌号之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-562ab8120c986d32d5b96c3da5071063" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;gas turbine&quot;, &quot;nickel-based alloys&quot;, &quot;nickel-based superalloys&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-562ab8120c986d32d5b96c3da5071063-e-3&quot;, &quot;chunk-2f58aaf4e11b140e948152f6a58bcf03-e-1&quot;, &quot;chunk-c1f941cda4f8b36efca8168f378f1be7-e-5&quot;, &quot;chunk-8debf02eecb6d1c5cb6982c6f0228498-e-7&quot;, &quot;chunk-97c05a1094ea39aa5f2616ca79a05f13-e-1&quot;, &quot;chunk-f6159d3dd840711c5298adf7f057d3b6-e-9&quot;, &quot;chunk-e77911125f8830a7b4bf67b20165ed0e-e-6&quot;, &quot;chunk-095e7b19e19ba75f3f37b75ed9ca8622-e-2&quot;, &quot;chunk-fdfde6e5e53ab8b0bee7b6e14d3acdef-e-1&quot;, &quot;chunk-1ad3d9def6416eb2826a0448d6287c6f-e-10&quot;, &quot;chunk-466225ab73e7ea49ac0af36e5725c4c1-e-7&quot;, &quot;chunk-995a2b9cc489b030d64e320f8fc16f28-e-10&quot;, &quot;chunk-b505bbe1d912bcde398fe7f44b786cf0-e-1&quot;, &quot;chunk-3ca8a51d3be3a429f4f741571769150f-e-1&quot;, &quot;chunk-0ba22e2612dbc225416101c15d4cb857-e-6&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="24" />
        </attvalues>
      </node>
      <node id="chunk-562ab8120c986d32d5b96c3da5071063-e-5" label="Jet propulsion">
        <attvalues>
          <attvalue for="0" value="Jet propulsion" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="一种推进技术。它通过高速向后喷射流体（射流），依据牛顿第三定律产生反作用力（推力）来驱动载具前进。燃气涡轮发动机是实现喷气推进的核心动力装置，该技术广泛应用于现代喷气式飞机。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-562ab8120c986d32d5b96c3da5071063" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Jet Propulsion&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-562ab8120c986d32d5b96c3da5071063-e-5&quot;, &quot;chunk-8d8d506b8935eb12c19a6c9ce4ae735c-e-5&quot;, &quot;chunk-f7802da45487754a86d28619b81d1a73-e-7&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-562ab8120c986d32d5b96c3da5071063-e-6" label="Electricity generation">
        <attvalues>
          <attvalue for="0" value="Electricity generation" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="发电，即电力生产，是指将其他形式的能源（如化学能、核能、动能、热能等）转换成电能的过程。它主要通过发电机实现，例如利用燃气轮机、蒸汽轮机或水轮机等原动机驱动发电机旋转；也包括利用光伏效应、化学反应等方式直接将能量转换为电能。发电是电力系统的首要环节。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-562ab8120c986d32d5b96c3da5071063" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Electricity Generation&quot;, &quot;electricity generation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-562ab8120c986d32d5b96c3da5071063-e-6&quot;, &quot;chunk-ca80bee312e1ad9a585f4b4507e9de12-e-8&quot;, &quot;chunk-f7802da45487754a86d28619b81d1a73-e-8&quot;, &quot;chunk-d0bef0969eda4d511c2167bafe9aeae0-e-10&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-562ab8120c986d32d5b96c3da5071063-e-7" label="Superior mechanical properties">
        <attvalues>
          <attvalue for="0" value="Superior mechanical properties" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="指镍基高温合金所拥有的一系列卓越的力学特性。其核心特征是在极端高温环境下，依然能保持极高的强度、韧性、抗蠕变和抗疲劳性能，这使其成为航空发动机等关键热端部件的核心材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-562ab8120c986d32d5b96c3da5071063" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-562ab8120c986d32d5b96c3da5071063-e-8" label="Engineering material">
        <attvalues>
          <attvalue for="0" value="Engineering material" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="工程材料是用于制造机器、构件、设备或结构的材料。它们因其特定的力学、物理或化学性能被选用，以满足工程设计和应用的需求。该类别涵盖金属、陶瓷、聚合物及复合材料，镍基高温合金即属此类。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-562ab8120c986d32d5b96c3da5071063" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;engineering materials&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-562ab8120c986d32d5b96c3da5071063-e-8&quot;, &quot;chunk-bf906ca2cbc8d790d36fdc40a9295b24-e-3&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-43df518934138ca7d680747b9c908d8b-e-2" label="Elevated temperatures">
        <attvalues>
          <attvalue for="0" value="Elevated temperatures" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="高温（Elevated temperatures）是一种远高于常温的物理工作条件。在此环境下，单晶高温合金等先进材料能够有效保持其结构完整性与优异的力学性能，是其关键的应用环境。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-43df518934138ca7d680747b9c908d8b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-43df518934138ca7d680747b9c908d8b-e-2&quot;, &quot;chunk-a7dd82186838be32042dd4be6ec7b385-e-2&quot;, &quot;chunk-3592621846181c3ac65f3ee4259b4898-e-11&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-43df518934138ca7d680747b9c908d8b-e-3" label="Gas turbine manufacturers">
        <attvalues>
          <attvalue for="0" value="Gas turbine manufacturers" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="从事燃气轮机设计、制造和销售的组织。为提升发动机的性能、效率和可靠性，这类制造商持续寻求并应用如高温合金等先进材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-43df518934138ca7d680747b9c908d8b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-43df518934138ca7d680747b9c908d8b-e-5" label="Engine efficiency">
        <attvalues>
          <attvalue for="0" value="Engine efficiency" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="发动机效率是一项衡量发动机性能的指标，用于量化其将燃料化学能转化为有用机械功的有效程度。效率越高，燃油消耗就越低。该指标可通过提高发动机工作温度等因素得到改善。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-43df518934138ca7d680747b9c908d8b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-43df518934138ca7d680747b9c908d8b-e-6" label="Fuel burn">
        <attvalues>
          <attvalue for="0" value="Fuel burn" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="燃油消耗（Fuel Burn）是一项关键性能指标，指发动机在特定工况下所消耗的燃油量。该数值与发动机效率成反比，是评估其运行经济性的核心参数，效率越高则燃油消耗越低。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-43df518934138ca7d680747b9c908d8b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-43df518934138ca7d680747b9c908d8b-e-6&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-43df518934138ca7d680747b9c908d8b-e-7" label="Engine performance">
        <attvalues>
          <attvalue for="0" value="Engine performance" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="发动机性能是一个衡量发动机工作能力的综合概念，通过功率、燃油效率、可靠性、排放等关键指标进行量化。它是评估发动机优劣的核心依据，也是发动机制造商（如燃气轮机制造商）在市场中获取竞争优势的决定性因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-43df518934138ca7d680747b9c908d8b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e3406875015337a54f658be7249d021b-e-1" label="power plant competition">
        <attvalues>
          <attvalue for="0" value="power plant competition" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="指发动机（或动力装置）制造商之间为获得市场优势而展开的激烈竞争。该竞争是推动企业研发新型高温合金等先进材料，以提升产品性能、效率与可靠性的关键驱动力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-e3406875015337a54f658be7249d021b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="44" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e3406875015337a54f658be7249d021b-e-2" label="engine manufacturers">
        <attvalues>
          <attvalue for="0" value="engine manufacturers" />
          <attvalue for="1" value="Organization Type" />
          <attvalue for="2" value="专门从事发动机研发、制造和销售的组织。其产品涵盖内燃机、喷气发动机、电动机等多种动力装置。为保持竞争优势，这类组织常利用专有的化学技术（如特种材料或燃料配方）来提升产品性能与效率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-e3406875015337a54f658be7249d021b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Engine manufacturers&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e3406875015337a54f658be7249d021b-e-2&quot;, &quot;chunk-738d5a08a05f18670227192d3b2434f7-e-2&quot;, &quot;chunk-3219701e460dd07570bedda4067e6548-e-3&quot;]}]" />
          <attvalue for="9" value="44" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-e3406875015337a54f658be7249d021b-e-3" label="future generations of superalloys">
        <attvalues>
          <attvalue for="0" value="future generations of superalloys" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="由发动机制造商研发的新一代高温合金材料。该材料类别旨在拥有更高的工作温度极限和更优异的综合性能，以满足未来航空发动机对更高推力、燃油效率和可靠性的要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-e3406875015337a54f658be7249d021b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="44" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e3406875015337a54f658be7249d021b-e-4" label="textbook">
        <attvalues>
          <attvalue for="0" value="textbook" />
          <attvalue for="1" value="Document" />
          <attvalue for="2" value="一部系统阐述高温合金技术的教科书。该书通过分章节的方式，全面介绍了该技术的基础理论、核心原理及工程应用，为读者提供了关于这一先进材料领域的完整知识体系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-e3406875015337a54f658be7249d021b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="71" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e3406875015337a54f658be7249d021b-e-5" label="superalloy technology">
        <attvalues>
          <attvalue for="0" value="superalloy technology" />
          <attvalue for="1" value="Technology Field" />
          <attvalue for="2" value="高温合金技术是一门材料科学与工程领域，专注于开发、加工和应用在高温下仍能保持优异机械强度、热稳定性和抗腐蚀性的高性能合金。该技术是航空发动机、燃气轮机等尖端设备制造的核心。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e3406875015337a54f658be7249d021b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="71" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e3406875015337a54f658be7249d021b-e-6" label="Chapter 1">
        <attvalues>
          <attvalue for="0" value="Chapter 1" />
          <attvalue for="1" value="Document Section" />
          <attvalue for="2" value="教科书的第一章，作为一个文档章节，主要论述了能够在高温环境下工作的材料及其相关性能要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e3406875015337a54f658be7249d021b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="71" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e3406875015337a54f658be7249d021b-e-7" label="materials capable of operating at elevated temperatures">
        <attvalues>
          <attvalue for="0" value="materials capable of operating at elevated temperatures" />
          <attvalue for="1" value="Material Requirement" />
          <attvalue for="2" value="指对材料在高温环境中正常工作的性能要求。材料需在该条件下保持稳定的物理、化学及力学性能，以维持其结构完整性和使用寿命，通常涉及高温合金、陶瓷或复合材料等。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-e3406875015337a54f658be7249d021b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e3406875015337a54f658be7249d021b-e-7&quot;]}]" />
          <attvalue for="9" value="71" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2f58aaf4e11b140e948152f6a58bcf03-e-4" label="engineering alloys">
        <attvalues>
          <attvalue for="0" value="engineering alloys" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="工程合金是为满足高温、高压等特定工程需求而开发的金属材料。它们通过颗粒强化（如γ'相）等机制优化微观结构，以获得高强度、优异的抗蠕变性等性能，并可表现出反常屈服效应等独特的力学行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-2f58aaf4e11b140e948152f6a58bcf03" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2f58aaf4e11b140e948152f6a58bcf03-e-4&quot;, &quot;chunk-542eb38b71ebf203cb6df08f03ceb063-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2f58aaf4e11b140e948152f6a58bcf03-e-6" label="defects">
        <attvalues>
          <attvalue for="0" value="defects" />
          <attvalue for="1" value="Material Feature" />
          <attvalue for="2" value="缺陷是指镍基超合金等材料内部的晶体结构不完美之处。这些结构上的不规则性及其演化是超合金物理冶金学中的关键研究对象，直接影响材料的宏观力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-2f58aaf4e11b140e948152f6a58bcf03" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2f58aaf4e11b140e948152f6a58bcf03-e-6&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-542eb38b71ebf203cb6df08f03ceb063-e-7" label="creep deformation behaviour">
        <attvalues>
          <attvalue for="0" value="creep deformation behaviour" />
          <attvalue for="1" value="Material Behavior" />
          <attvalue for="2" value="蠕变变形行为指固体材料在恒定应力（通常低于其屈服强度）和高温作用下，其塑性变形随时间缓慢且持续增长的现象。这种与时间相关的变形是工程合金在高温环境下设计和评估寿命时必须考虑的关键失效机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-542eb38b71ebf203cb6df08f03ceb063" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-542eb38b71ebf203cb6df08f03ceb063-e-7&quot;, &quot;chunk-44a9440aa3e5fad0c388f77698c519bf-e-10&quot;, &quot;chunk-5518f1c4ab4a7b4e100f841b3b90e572-e-12&quot;, &quot;chunk-f0829bcd269a8d2dfa4641c4b0e70d30-e-2&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-542eb38b71ebf203cb6df08f03ceb063-e-8" label="superalloy technology">
        <attvalues>
          <attvalue for="0" value="superalloy technology" />
          <attvalue for="1" value="Technology Field" />
          <attvalue for="2" value="高温合金技术是专注于开发可在高温高应力下工作的金属材料的工程技术领域。它涵盖了合金设计、加工工艺以及微观结构与性能关系的研究，其产品主要应用于制造燃气轮机等尖端装备的关键热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-542eb38b71ebf203cb6df08f03ceb063" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="37" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-542eb38b71ebf203cb6df08f03ceb063-e-9" label="gas turbine components">
        <attvalues>
          <attvalue for="0" value="gas turbine components" />
          <attvalue for="1" value="Component Category" />
          <attvalue for="2" value="燃气轮机部件是构成燃气轮机的关键零件的统称。由于需在高温高压的极端环境下工作，这类部件是高温合金技术的核心应用领域，典型代表包括涡轮叶片和涡轮盘。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-542eb38b71ebf203cb6df08f03ceb063" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="37" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-542eb38b71ebf203cb6df08f03ceb063-e-12" label="Processing">
        <attvalues>
          <attvalue for="0" value="Processing" />
          <attvalue for="1" value="Technical Field" />
          <attvalue for="2" value="**标准化描述：**&#10;&#10;指制造高温合金部件的特定工艺流程。该过程直接影响部件的微观结构、机械与化学性能，并与其设计紧密关联，是决定其最终质量与服役表现的关键环节。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-542eb38b71ebf203cb6df08f03ceb063" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;processing&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-542eb38b71ebf203cb6df08f03ceb063-e-12&quot;, &quot;chunk-30207adabf4599d8a652adb7ed7362dc-e-4&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-542eb38b71ebf203cb6df08f03ceb063-e-14" label="microstructure/property relationships">
        <attvalues>
          <attvalue for="0" value="microstructure/property relationships" />
          <attvalue for="1" value="Scientific Concept" />
          <attvalue for="2" value="材料科学中的基本原理，阐述材料的微观组织结构（如晶粒、相、缺陷）与其宏观物理、力学性能之间的决定性关系。这一原理是设计和优化包括高温合金在内的高性能材料的核心基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-542eb38b71ebf203cb6df08f03ceb063" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-542eb38b71ebf203cb6df08f03ceb063-e-14&quot;]}]" />
          <attvalue for="9" value="37" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c00332837c903107811c26a0dceec5be-e-1" label="Chapter 5">
        <attvalues>
          <attvalue for="0" value="Chapter 5" />
          <attvalue for="1" value="Document Section" />
          <attvalue for="2" value="第五章是一个文献章节，其内容主要论述和介绍针对高温合金的表面涂层技术，涵盖该领域的相关原理、工艺与应用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-c00332837c903107811c26a0dceec5be" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c00332837c903107811c26a0dceec5be-e-2" label="Surface coatings technologies">
        <attvalues>
          <attvalue for="0" value="Surface coatings technologies" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="表面涂层技术（Surface coatings technologies）是一类在基材表面施加特定材料层的工艺。随着设备工作温度的不断升高，该技术对于保障部件在高温环境下的性能、耐用性与可靠性变得至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c00332837c903107811c26a0dceec5be" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c00332837c903107811c26a0dceec5be-e-4" label="Chapter 6">
        <attvalues>
          <attvalue for="0" value="Chapter 6" />
          <attvalue for="1" value="Document Section" />
          <attvalue for="2" value="第六章是一个文档章节，其核心内容是对高温合金技术的未来发展方向、应用前景和技术趋势进行预测与分析。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c00332837c903107811c26a0dceec5be" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="138" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c00332837c903107811c26a0dceec5be-e-5" label="Superalloy technology">
        <attvalues>
          <attvalue for="0" value="Superalloy technology" />
          <attvalue for="1" value="Field of Technology" />
          <attvalue for="2" value="高温合金技术是关于高温合金的研发、生产、加工及应用的工程技术领域。高温合金指能在高温和严酷环境下长期工作，并保持优异机械强度、抗蠕变和抗腐蚀性能的金属材料。该技术是航空航天、能源和化工等尖端工业的核心。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c00332837c903107811c26a0dceec5be" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="138" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-03cfea53fa6d7edca4135b4a86169a55-e-1" label="Definitive Textbook">
        <attvalues>
          <attvalue for="0" value="Definitive Textbook" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="`Definitive Textbook`是一本关于高温材料的权威教科书。该书被誉为典范之作，是该领域的决定性著作。它主要推荐给攻读高等学位的学生及研究者，并适用于燃气轮机技术等相关应用领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-03cfea53fa6d7edca4135b4a86169a55" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-03cfea53fa6d7edca4135b4a86169a55-e-2" label="High-temperature materials">
        <attvalues>
          <attvalue for="0" value="High-temperature materials" />
          <attvalue for="1" value="Field of Study" />
          <attvalue for="2" value="高温材料是一门研究在高温环境下仍能保持结构稳定和优异性能的材料科学分支。该领域重点关注高温合金（如超合金）、特种陶瓷和复合材料的开发与应用，对航空航天、能源动力等尖端技术领域至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-03cfea53fa6d7edca4135b4a86169a55" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-03cfea53fa6d7edca4135b4a86169a55-e-2&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-03cfea53fa6d7edca4135b4a86169a55-e-3" label="Gas turbine technology">
        <attvalues>
          <attvalue for="0" value="Gas turbine technology" />
          <attvalue for="1" value="Technology Field" />
          <attvalue for="2" value="燃气轮机技术是关于设计、制造和应用燃气轮机的工程领域。它利用燃烧产生的高温高压燃气驱动涡轮旋转，将燃料的化学能高效转化为机械功，是现代航空发动机、发电站和工业驱动装置的核心技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-03cfea53fa6d7edca4135b4a86169a55" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-03cfea53fa6d7edca4135b4a86169a55-e-4" label="Higher degree">
        <attvalues>
          <attvalue for="0" value="Higher degree" />
          <attvalue for="1" value="Educational Program" />
          <attvalue for="2" value="高等学位指在完成学士学位后攻读的更高层次学术资格，属于研究生教育阶段。它通常包括硕士学位和博士学位，要求完成指定的课程学习、研究项目或毕业论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-03cfea53fa6d7edca4135b4a86169a55" />
