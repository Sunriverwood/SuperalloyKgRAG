        <attvalues>
          <attvalue for="11" value="DIFFICULT_TO_REPRODUCE_IN" />
          <attvalue for="12" value="It is difficult to reproduce the failure conditions of a gas turbine in a laboratory setting." />
          <attvalue for="13" value="possibly due to the difficulty in reproducing the failure conditions (for example, temperature gradients, cycling times) pertinent to the gas turbine in the laboratory" />
          <attvalue for="14" value="r-6" />
