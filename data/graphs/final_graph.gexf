        <attvalues>
          <attvalue for="11" value="ACTS_ON" />
          <attvalue for="12" value="The repulsive force R acts on the dislocation pair to keep them separated." />
          <attvalue for="13" value="repulsive in sign since the dislocations are of the same sense, acting to keep the pair separated" />
          <attvalue for="14" value="r-1" />
