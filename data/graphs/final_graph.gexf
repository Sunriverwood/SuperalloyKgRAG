          <attvalue for="9" value="10" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-1abe15e2f2db1602f97ac75bb847ef30-e-11" label="Y. Zhang">
        <attvalues>
          <attvalue for="0" value="Y. Zhang" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="Y. Zhang是一位学者或研究员，其研究领域涉及材料科学，曾发表关于使用化学气相沉积（CVD）技术制备镍铝（NiAl）结合层的学术论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
