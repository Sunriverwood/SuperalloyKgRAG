        <attvalues>
          <attvalue for="11" value="IMPROVES_PERFORMANCE_OF" />
          <attvalue for="12" value="The performance of the engine is greatly improved if the TET can be raised." />
          <attvalue for="13" value="the performance of the engine is greatly improved if the TET can be raised" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-97c05a1094ea39aa5f2616ca79a05f13" />
          <attvalue for="17" value="0.4" />
