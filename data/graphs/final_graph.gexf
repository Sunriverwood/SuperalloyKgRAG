          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-943094a66cbac0e2815f19cb92f9100a-e-2&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-943094a66cbac0e2815f19cb92f9100a-e-3" label="{111}&lt;110&gt; slip">
        <attvalues>
          <attvalue for="0" value="{111}&lt;110&gt; slip" />
          <attvalue for="1" value="Deformation Process" />
          <attvalue for="2" value="一种晶体塑性变形机制，指位错在{111}晶面上沿&lt;110&gt;晶向的滑移。它是面心立方(FCC)金属（如铜、铝）中最主要的滑移系统，其在特定载荷下的激活与否，通常通过计算施密特因子来判断。" />
          <attvalue for="3" value="{&quot;plane&quot;: &quot;(111)&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-943094a66cbac0e2815f19cb92f9100a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;slip on (111)&quot;, &quot;slip on (11ī)&quot;, &quot;{111}(110) slip&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-943094a66cbac0e2815f19cb92f9100a-e-3&quot;, &quot;chunk-943094a66cbac0e2815f19cb92f9100a-e-4&quot;, &quot;chunk-3592621846181c3ac65f3ee4259b4898-e-8&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-943094a66cbac0e2815f19cb92f9100a-e-5" label="a single set with average line vector [100]">
        <attvalues>
          <attvalue for="0" value="a single set with average line vector [100]" />
          <attvalue for="1" value="Dislocation Structure" />
          <attvalue for="2" value="一种平均位错线矢量为[100]的位错结构。它由两组相互垂直的a/2[011]型位错发生反应而形成，是材料中一种次生的晶体缺陷形态。" />
          <attvalue for="3" value="{&quot;average_line_vector&quot;: &quot;[100]&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-943094a66cbac0e2815f19cb92f9100a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-943094a66cbac0e2815f19cb92f9100a-e-6" label="a/2(110) dislocations">
        <attvalues>
          <attvalue for="0" value="a/2(110) dislocations" />
          <attvalue for="1" value="Crystallographic Defect" />
          <attvalue for="2" value="一种伯格斯矢量为a/2&lt;110&gt;的晶体位错。它通常由两个相交的{111}八面体滑移面上（如(ī11)和(ī1ī)面）的位错发生反应而形成。这类位错是构成稳定位错网络的基础，对材料的加工硬化起着关键作用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-943094a66cbac0e2815f19cb92f9100a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-943094a66cbac0e2815f19cb92f9100a-e-6&quot;]}]" />
          <attvalue for="9" value="103" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-943094a66cbac0e2815f19cb92f9100a-e-7" label="slip on the other two octahedral planes">
        <attvalues>
          <attvalue for="0" value="slip on the other two octahedral planes" />
          <attvalue for="1" value="Deformation Process" />
          <attvalue for="2" value="一种晶体塑性变形机制，指在(ī11)和(ī1ī)八面体晶面上发生的滑移过程。该过程会产生柏氏矢量为a/2(110)的位错，是材料发生形变的一种基本方式。" />
          <attvalue for="3" value="{&quot;planes&quot;: [&quot;(ī11)&quot;, &quot;(ī1ī)&quot;]}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-943094a66cbac0e2815f19cb92f9100a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="103" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-943094a66cbac0e2815f19cb92f9100a-e-8" label="the net">
        <attvalues>
          <attvalue for="0" value="the net" />
          <attvalue for="1" value="Dislocation Structure" />
          <attvalue for="2" value="一种位错结构，特指由 a/2(110) 型位错并入或交织而形成的最终位错网络。它是晶体材料中一种稳定的缺陷形态。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-943094a66cbac0e2815f19cb92f9100a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-943094a66cbac0e2815f19cb92f9100a-e-8&quot;]}]" />
          <attvalue for="9" value="103" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cc47748978457509471e3842086662ee-e-1" label="Octahedral planes">
        <attvalues>
          <attvalue for="0" value="Octahedral planes" />
          <attvalue for="1" value="Crystallographic Plane" />
          <attvalue for="2" value="八面体晶面 (Octahedral planes) 是一类晶体学平面，在立方晶系中特指密勒指数为{111}的晶面族。它们是面心立方结构中的密排面。特定的八面体晶面，如(111)和(111)，可以相互交织形成网状结构。" />
          <attvalue for="3" value="{&quot;planes&quot;: [&quot;(111)&quot;, &quot;(111)&quot;]}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-cc47748978457509471e3842086662ee" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="66" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cc47748978457509471e3842086662ee-e-2" label="Net">
        <attvalues>
          <attvalue for="0" value="Net" />
          <attvalue for="1" value="Crystallographic Structure" />
          <attvalue for="2" value="Net是一种晶体结构，指八面体平面通过特定的位错反应（如Dislocation Reaction 3.34a-c）相互编织而形成的结构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-cc47748978457509471e3842086662ee" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cc47748978457509471e3842086662ee-e-2&quot;]}]" />
          <attvalue for="9" value="66" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-cc47748978457509471e3842086662ee-e-3" label="Dislocation Reaction (3.34a)">
        <attvalues>
          <attvalue for="0" value="Dislocation Reaction (3.34a)" />
          <attvalue for="1" value="Dislocation Reaction" />
          <attvalue for="2" value="一种晶体材料中的特定位错反应，其伯氏矢量关系为 a/2[101] - a/2[011] → a/2[110]。此反应通过合并位错形成节点，是构成位错网络和导致材料强化的基本过程。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;a/2[101] - a/2[011] → a/2[110]&quot;, &quot;label&quot;: &quot;3.34a&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-cc47748978457509471e3842086662ee" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cc47748978457509471e3842086662ee-e-3&quot;]}]" />
          <attvalue for="9" value="66" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cc47748978457509471e3842086662ee-e-4" label="Dislocation Reaction (3.34b)">
        <attvalues>
          <attvalue for="0" value="Dislocation Reaction (3.34b)" />
          <attvalue for="1" value="Dislocation Reaction" />
          <attvalue for="2" value="晶体材料中，两条或多条位错线相互作用形成新位错的过程。此过程遵循伯格斯矢量守恒，并趋向于降低系统总能量。该实体特指一个具体反应，其矢量方程为：a/2[101] - a/2[110] → a/2[011]。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;a/2[101] - a/2[110] → a/2[011]&quot;, &quot;label&quot;: &quot;3.34b&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-cc47748978457509471e3842086662ee" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cc47748978457509471e3842086662ee-e-4&quot;]}]" />
          <attvalue for="9" value="66" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cc47748978457509471e3842086662ee-e-5" label="Dislocation Reaction (3.34c)">
        <attvalues>
          <attvalue for="0" value="Dislocation Reaction (3.34c)" />
          <attvalue for="1" value="Dislocation Reaction" />
          <attvalue for="2" value="一种晶体材料学中的位错反应，指两个伯格斯矢量为 a/2[101] 的位错相互作用，结合形成一个伯格斯矢量为 a[100] 的新位错。根据弗兰克能量准则(b²)，该反应前后位错的总能量守恒，因此在能量上是可能的。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;a/2[101] + a/2[101] → a[100]&quot;, &quot;label&quot;: &quot;3.34c&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-cc47748978457509471e3842086662ee" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cc47748978457509471e3842086662ee-e-5&quot;]}]" />
          <attvalue for="9" value="66" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-06552db6ca6c8a18f5c48e13e0d28d19-e-1" label="a/2[101] + a/2[101] → a[100]">
        <attvalues>
          <attvalue for="0" value="a/2[101] + a/2[101] → a[100]" />
          <attvalue for="1" value="Dislocation Reaction" />
          <attvalue for="2" value="晶体材料中的一种位错反应。两条伯氏矢量为a/2[101]的可滑移位错相互作用，结合形成一条伯氏矢量为a[100]的固着位错。该产物作为障碍物会阻碍其他位错运动，是材料加工硬化的重要机制。" />
          <attvalue for="3" value="{&quot;equation_id&quot;: &quot;3.34c&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-06552db6ca6c8a18f5c48e13e0d28d19" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-06552db6ca6c8a18f5c48e13e0d28d19-e-1&quot;]}]" />
          <attvalue for="9" value="286" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-06552db6ca6c8a18f5c48e13e0d28d19-e-2" label="equilibrium network">
        <attvalues>
          <attvalue for="0" value="equilibrium network" />
          <attvalue for="1" value="Dislocation Structure" />
          <attvalue for="2" value="平衡网络是一种稳定的低能位错结构。它在蠕变过程中由足够多的蠕变位错相互作用并重新排列而成，代表了体系应变能趋于最小化的状态，其物理性质之一是具有特定的位错密度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-06552db6ca6c8a18f5c48e13e0d28d19" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-06552db6ca6c8a18f5c48e13e0d28d19-e-5" label="Harada and co-workers">
        <attvalues>
          <attvalue for="0" value="Harada and co-workers" />
          <attvalue for="1" value="Research Group" />
          <attvalue for="2" value="Harada及其合作者 (Harada and co-workers) 是一个在高温合金材料科学领域做出重要贡献的科研团队。该团队的关键发现是，通过研究明确揭示并证实了高温合金中的位错密度与材料的蠕变性能之间存在着强相关性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-06552db6ca6c8a18f5c48e13e0d28d19" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-06552db6ca6c8a18f5c48e13e0d28d19-e-6" label="dislocation density">
        <attvalues>
          <attvalue for="0" value="dislocation density" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="位错密度（Dislocation Density）是表征晶体材料缺陷程度的物理量，定义为单位体积内位错线的总长度。在单晶高温合金中，其平衡网络的位错密度是影响材料蠕变性能的关键指标，两者之间存在强相关性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-06552db6ca6c8a18f5c48e13e0d28d19" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-06552db6ca6c8a18f5c48e13e0d28d19-e-9" label="1100 °C">
        <attvalues>
          <attvalue for="0" value="1100 °C" />
          <attvalue for="1" value="Temperature" />
          <attvalue for="2" value="1100 °C 是一个特定的实验温度，在该上下文中，它被设定为评估材料蠕变性能的测量条件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-06552db6ca6c8a18f5c48e13e0d28d19" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-06552db6ca6c8a18f5c48e13e0d28d19-e-11" label="strong correlation">
        <attvalues>
          <attvalue for="0" value="strong correlation" />
          <attvalue for="1" value="Scientific Finding" />
          <attvalue for="2" value="一项科学发现，指材料的位错密度与蠕变性能之间存在一种显著的统计关联。这种关系揭示了微观结构缺陷（位错）如何影响材料在高温和应力下的宏观力学行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-06552db6ca6c8a18f5c48e13e0d28d19" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-aad5a5786d03a03d8f644b4cda7a85fb-e-3" label="dislocation spacing">
        <attvalues>
          <attvalue for="0" value="dislocation spacing" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="位错间距（Dislocation Spacing）是一种材料微观结构特征，指晶体内部位错之间的平均距离。该参数与材料的蠕变行为密切相关，其数值与最小蠕变速率的对数成正比。它是评估并指导如TMS-162等高温合金性能设计的关键依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-aad5a5786d03a03d8f644b4cda7a85fb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-aad5a5786d03a03d8f644b4cda7a85fb-e-4" label="minimum creep rate">
        <attvalues>
          <attvalue for="0" value="minimum creep rate" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;最小蠕变速率是一种材料属性，指材料在恒定温度和应力下进入稳态蠕变阶段时的最低变形速率。它是衡量材料长期抗蠕变性能的关键指标，其数值会受材料微观结构（如晶粒尺寸）的显著影响，通常粗晶组织具有更低的最小蠕变速率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-aad5a5786d03a03d8f644b4cda7a85fb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Minimum creep rate&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-aad5a5786d03a03d8f644b4cda7a85fb-e-4&quot;, &quot;chunk-c0d12490c7b814ce8a1cab25a00073a6-e-4&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-60c0ee3413a86135d14081dd80f51aaf-e-4" label="Rafting">
        <attvalues>
          <attvalue for="0" value="Rafting" />
          <attvalue for="1" value="Metallurgical Process" />
          <attvalue for="2" value="**筏排（Rafting）**：一种高温冶金过程。指材料（常为高温合金）的微观强化相在高温和应力共同作用下，发生定向粗化，形成垂直于应力方向的层状“筏状”结构。此过程是蠕变硬化效应及蠕变平台期的主要原因，能提高材料的高温性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-60c0ee3413a86135d14081dd80f51aaf" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;rafting&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-60c0ee3413a86135d14081dd80f51aaf-e-4&quot;, &quot;chunk-c44bc316af8bfbfde3c05fd247258d3c-e-2&quot;, &quot;chunk-dae9be5eb4b7208070b473c392dd0478-e-14&quot;, &quot;chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-1&quot;, &quot;chunk-e1a389bc8645b3e7fa58f05c1e0a798f-e-3&quot;, &quot;chunk-810fb1ebfd1f2112fedd829e635a8739-e-1&quot;, &quot;chunk-c8a13933656ed9f144b18b40f2e9861e-e-12&quot;, &quot;chunk-bf4f5a9c3c730bf3e4d0cca1e80be672-e-1&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-60c0ee3413a86135d14081dd80f51aaf-e-5" label="interfacial misfit">
        <attvalues>
          <attvalue for="0" value="interfacial misfit" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;界面失配(Interfacial misfit)是一种材料属性，指在多相材料的相界面上，因各相晶格常数或取向不同而导致的晶格不匹配。这种失配会产生界面应变，其应力的松弛是驱动“筏排结构”(Rafting)等微观结构演化的关键前提。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-60c0ee3413a86135d14081dd80f51aaf" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Interfacial Misfit&quot;, &quot;Interfacial misfit&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-60c0ee3413a86135d14081dd80f51aaf-e-5&quot;, &quot;chunk-e1a389bc8645b3e7fa58f05c1e0a798f-e-1&quot;, &quot;chunk-c44bc316af8bfbfde3c05fd247258d3c-e-1&quot;, &quot;chunk-810fb1ebfd1f2112fedd829e635a8739-e-6&quot;, &quot;chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-6&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c44bc316af8bfbfde3c05fd247258d3c-e-5" label="Tertiary Creep Regime">
        <attvalues>
          <attvalue for="0" value="Tertiary Creep Regime" />
          <attvalue for="1" value="Process Stage" />
          <attvalue for="2" value="蠕变变形过程的第三个也是最后一个阶段，又称加速蠕变阶段。其特征是应变速率随时间急剧增加，直至材料最终断裂。这通常是由于材料内部形成空洞、微裂纹等微观结构损伤并不断累积所导致的。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c44bc316af8bfbfde3c05fd247258d3c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c44bc316af8bfbfde3c05fd247258d3c-e-5&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c44bc316af8bfbfde3c05fd247258d3c-e-7" label="Horizontal Channels">
        <attvalues>
          <attvalue for="0" value="Horizontal Channels" />
          <attvalue for="1" value="Microstructural Location" />
          <attvalue for="2" value="水平通道 (Horizontal Channels) 是一种存在于材料伽马(γ)相中的微观结构。它在材料变形过程中，充当位错增殖过程被激活的初始萌生位置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c44bc316af8bfbfde3c05fd247258d3c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e1a389bc8645b3e7fa58f05c1e0a798f-e-4" label="Diffusion">
        <attvalues>
          <attvalue for="0" value="Diffusion" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="扩散（Diffusion）是一种元素移动的过程。作为“筏移”（Rafting）现象的关键机制，该过程主要发生在弛豫界面（relaxed interfaces）附近。“管扩散”（pipe diffusion）是其具体类型之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-e1a389bc8645b3e7fa58f05c1e0a798f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;diffusion&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e1a389bc8645b3e7fa58f05c1e0a798f-e-4&quot;, &quot;chunk-66a58911605d115d5d1e50b6bc245d4f-e-1&quot;, &quot;chunk-b5c5988ef25b1d82cffcb2320a89119f-e-5&quot;, &quot;chunk-070dbf53e1878b9845a3e7782a58ad66-e-3&quot;, &quot;chunk-52c2368c38f01bd3aedce678a81a8dc2-e-3&quot;, &quot;chunk-b38b75a018fa569ff580b1d94d62395d-e-7&quot;, &quot;chunk-dc4fc8b9731ff54ceedadcde2ec92655-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-e1a389bc8645b3e7fa58f05c1e0a798f-e-5" label="y-partitioning elements">
        <attvalues>
          <attvalue for="0" value="y-partitioning elements" />
          <attvalue for="1" value="Element Category" />
          <attvalue for="2" value="一类以铬(Cr)、铼(Re)为代表的合金元素。在高温合金的筏排化(rafting)过程中，其核心特征是倾向于从垂直通道（通常为γ相）中扩散出来，进入周围的基体相。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e1a389bc8645b3e7fa58f05c1e0a798f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-e1a389bc8645b3e7fa58f05c1e0a798f-e-8" label="γ'-partitioning elements">
        <attvalues>
          <attvalue for="0" value="γ'-partitioning elements" />
          <attvalue for="1" value="Element Category" />
          <attvalue for="2" value="一类优先分配于高温合金γ'相并起到稳定作用的合金元素，如铝(Al)、钽(Ta)等。在高温蠕变导致的“筏化”现象中，它们会发生定向扩散，进入由γ基体相形成的垂直通道中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-e1a389bc8645b3e7fa58f05c1e0a798f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-e1a389bc8645b3e7fa58f05c1e0a798f-e-11" label="vertical channels">
        <attvalues>
          <attvalue for="0" value="vertical channels" />
          <attvalue for="1" value="Material Structure" />
          <attvalue for="2" value="**垂直通道 (Vertical Channels)**&#10;&#10;一种材料微观结构，特指镍基高温合金中的γ相基体区域。它作为原子扩散的通道，其特征表现为：γ相分区元素（如Co, Cr）从中扩散出，而γ'相分区元素（如Al, Ti）则扩散进入。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-e1a389bc8645b3e7fa58f05c1e0a798f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e1a389bc8645b3e7fa58f05c1e0a798f-e-14" label="relaxed interfaces">
        <attvalues>
          <attvalue for="0" value="relaxed interfaces" />
          <attvalue for="1" value="Material Structure" />
          <attvalue for="2" value="弛豫界面 (Relaxed Interface) 是一种材料内部的界面结构。它是在两种不同晶体的晶格失配所产生的应变得到释放（或弛豫）后形成的。由于其能量较低且结构相对稳定，该区域成为原子扩散等传质现象发生的主要位置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-e1a389bc8645b3e7fa58f05c1e0a798f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Relaxed interfaces&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e1a389bc8645b3e7fa58f05c1e0a798f-e-14&quot;, &quot;chunk-66a58911605d115d5d1e50b6bc245d4f-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e1a389bc8645b3e7fa58f05c1e0a798f-e-15" label="Pipe diffusion">
        <attvalues>
          <attvalue for="0" value="Pipe diffusion" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="管扩散（Pipe Diffusion）是晶体材料中的一种快速扩散机制。它指原子优先沿着位错线（Dislocation Line）迁移的过程。由于位错核心区域的原子排列疏松，为原子移动提供了低能垒的“管道”，因此其扩散速率远快于晶格中的体扩散（Lattice Diffusion），是一种重要的短路扩散形式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-e1a389bc8645b3e7fa58f05c1e0a798f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;pipe diffusion&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e1a389bc8645b3e7fa58f05c1e0a798f-e-15&quot;, &quot;chunk-66a58911605d115d5d1e50b6bc245d4f-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-66a58911605d115d5d1e50b6bc245d4f-e-4" label="Solutes">
        <attvalues>
          <attvalue for="0" value="Solutes" />
          <attvalue for="1" value="Substance" />
          <attvalue for="2" value="在材料科学中，溶质指固溶体中的杂质或合金原子。它们可以沿位错线等晶体缺陷进行一种称为“管扩散”的快速迁移。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-66a58911605d115d5d1e50b6bc245d4f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-66a58911605d115d5d1e50b6bc245d4f-e-5" label="Dislocation networks">
        <attvalues>
          <attvalue for="0" value="Dislocation networks" />
          <attvalue for="1" value="Material Structure" />
          <attvalue for="2" value="位错网络是晶体材料中的一种三维缺陷结构，由大量相互交织的位错线构成。由于位错线是原子快速扩散的通道，该网络是溶质发生管扩散的主要场所，对材料的力学和物理性能有重要影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-66a58911605d115d5d1e50b6bc245d4f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-66a58911605d115d5d1e50b6bc245d4f-e-6" label="Interfacial misfit relaxation">
        <attvalues>
          <attvalue for="0" value="Interfacial misfit relaxation" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="界面错配松弛是一种物理现象，指在两相材料界面处，为缓解因晶格失配产生的应变能，系统通过形成界面位错等方式来降低能量的过程。它是高温合金中“筏排现象”等组织演化的关键驱动机制之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-66a58911605d115d5d1e50b6bc245d4f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-66a58911605d115d5d1e50b6bc245d4f-e-6&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-66a58911605d115d5d1e50b6bc245d4f-e-7" label="Rafting phenomenon">
        <attvalues>
          <attvalue for="0" value="Rafting phenomenon" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="筏排现象（Rafting phenomenon）是在部分蠕变的单晶中发生的一种微观结构演化。该过程与界面错配松弛有关，其显著特征是，即使在外部施加的载荷被移除后，筏排过程仍会持续进行。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-66a58911605d115d5d1e50b6bc245d4f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-66a58911605d115d5d1e50b6bc245d4f-e-7&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-66a58911605d115d5d1e50b6bc245d4f-e-8" label="Partially crept single crystals">
        <attvalues>
          <attvalue for="0" value="Partially crept single crystals" />
          <attvalue for="1" value="Material State" />
          <attvalue for="2" value="部分蠕变单晶是一种材料状态，指单晶在经历不完全的高温蠕变后所处的中间态。其核心特征为：即使在移除外部载荷后，其内部的筏排微观结构演化仍会自发进行，直至达到更稳定的低能状态。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-66a58911605d115d5d1e50b6bc245d4f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-66a58911605d115d5d1e50b6bc245d4f-e-9" label="Externally applied load">
        <attvalues>
          <attvalue for="0" value="Externally applied load" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="指从外部施加于材料上的力或应力，是研究筏排现象的一种关键实验条件。在相关实验中，即使该载荷被移除，已启动的筏排过程仍会持续进行，这表明它主要作用于现象的诱发或加速阶段。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-66a58911605d115d5d1e50b6bc245d4f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Externally Applied Load&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-66a58911605d115d5d1e50b6bc245d4f-e-9&quot;, &quot;chunk-810fb1ebfd1f2112fedd829e635a8739-e-2&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-810fb1ebfd1f2112fedd829e635a8739-e-4" label="Deformation">
        <attvalues>
          <attvalue for="0" value="Deformation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="形变（Deformation）指物体在外力作用下形状或尺寸发生改变的机械过程。在晶体材料中，塑性形变会引入储存能和晶体缺陷，是后续热处理（如退火）中发生再结晶与晶粒长大过程的先决条件。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;950 °C&quot;, &quot;stress&quot;: &quot;185 MPa&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-810fb1ebfd1f2112fedd829e635a8739" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-810fb1ebfd1f2112fedd829e635a8739-e-4&quot;, &quot;chunk-ef56fb2a5c4451551a2024d8490545ff-e-2&quot;, &quot;chunk-0b79cef081fe645143c11d92068c62ab-e-4&quot;, &quot;chunk-6c1e5f01b68b0193af6f52382cd9e355-e-8&quot;, &quot;chunk-708b4323c9399297153036f203acb264-e-8&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-810fb1ebfd1f2112fedd829e635a8739-e-5" label="Accumulated Strain">
        <attvalues>
          <attvalue for="0" value="Accumulated Strain" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="**累积应变 (Accumulated Strain)**&#10;&#10;一种力学性能，指材料因塑性变形而逐渐产生的内部应变。当其量值足够大时，能够通过位错运动等机制来有效弛豫（或补偿）材料内部的界面错配，从而降低系统能量。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;about 0.1%&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-810fb1ebfd1f2112fedd829e635a8739" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-25da441a3869f94baa3fcc9048297be3-e-2" label="Creep capability">
        <attvalues>
          <attvalue for="0" value="Creep capability" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="蠕变性能（Creep capability）指材料（特别是单晶高温合金）在高温和恒定应力作用下，抵抗缓慢塑性变形的能力。它是衡量材料长期热稳定性的关键指标，其性能会受到筏化效应等微观结构演化的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-25da441a3869f94baa3fcc9048297be3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-25da441a3869f94baa3fcc9048297be3-e-2&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-25da441a3869f94baa3fcc9048297be3-e-4" label="y' precipitates">
        <attvalues>
          <attvalue for="0" value="y' precipitates" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="y'沉淀物是一种微观结构特征。指多个独立的沉淀物颗粒沿横向发生聚结、合并，从而形成被称为“筏”(Raft)的更大、更连续的层状结构。这个过程通常涉及数十至上百个沉淀物颗粒的连接。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-25da441a3869f94baa3fcc9048297be3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="166" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-25da441a3869f94baa3fcc9048297be3-e-5" label="Raft">
        <attvalues>
          <attvalue for="0" value="Raft" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="一种微观结构特征，指100个及以上的y'析出相通过聚集合并，从而形成的一种充分发展的结构。" />
          <attvalue for="3" value="{&quot;composition&quot;: &quot;100 or more precipitates&quot;, &quot;cross-sectional_area&quot;: &quot;several hundreds of square&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-25da441a3869f94baa3fcc9048297be3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="166" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9a94346ed73c8bcf6797ad71ded00b42-e-3" label="Rafts">
        <attvalues>
          <attvalue for="0" value="Rafts" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="**筏排 (Rafts)**：一种显微结构特征，其厚度通常等于一个γ'相颗粒。大量筏排会导致γ/γ'结构发生拓扑反转，并能降低a/2(110){111}位错的活动性。" />
          <attvalue for="3" value="{&quot;thickness&quot;: &quot;one γ' particle&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-9a94346ed73c8bcf6797ad71ded00b42" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9a94346ed73c8bcf6797ad71ded00b42-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-4e2080b39d531470813c664fcc6dedf9-e-3" label="tertiary creep law">
        <attvalues>
          <attvalue for="0" value="tertiary creep law" />
          <attvalue for="1" value="Scientific Model" />
          <attvalue for="2" value="一个用于描述材料蠕变第三阶段（加速蠕变期）的科学模型。当该模型被外推至材料微观结构会发生“筏化”的高温工况时，它会低估材料的实际蠕变性能，通常表现为预测的蠕变寿命比实际值更短。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-4e2080b39d531470813c664fcc6dedf9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4e2080b39d531470813c664fcc6dedf9-e-3&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4e2080b39d531470813c664fcc6dedf9-e-5" label="fully developed rafts">
        <attvalues>
          <attvalue for="0" value="fully developed rafts" />
          <attvalue for="1" value="Microstructure" />
          <attvalue for="2" value="一种在筏排化（rafting）机制中形成的显微组织，代表筏状结构已发展到成熟、稳定的后期阶段。它的出现通常标志着材料某个后续性能演化时期（如蠕变后期）的开始。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-4e2080b39d531470813c664fcc6dedf9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Fully developed rafts&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bf4f5a9c3c730bf3e4d0cca1e80be672-e-2&quot;, &quot;chunk-4e2080b39d531470813c664fcc6dedf9-e-5&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-bf4f5a9c3c730bf3e4d0cca1e80be672-e-4" label="Plateau">
        <attvalues>
          <attvalue for="0" value="Plateau" />
          <attvalue for="1" value="Data Representation" />
          <attvalue for="2" value="蠕变曲线（Creep curves）是在恒定应力和温度下，表征材料应变随时间变化的图形化数据。曲线中的平台区（plateau）代表恒速蠕变阶段，是其关键特征，此特征在高温条件下尤为显著。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-bf4f5a9c3c730bf3e4d0cca1e80be672" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Creep curves&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bf4f5a9c3c730bf3e4d0cca1e80be672-e-4&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-023a8b25fea34ca6c8a3ebfc0f239288-e-3" label="Creep plateau">
        <attvalues>
          <attvalue for="0" value="Creep plateau" />
          <attvalue for="1" value="Feature of Creep Curve" />
          <attvalue for="2" value="蠕变平台 (Creep Plateau) 是指材料在蠕变过程中，其应变速率（变形速度）保持近乎恒定的一个特定阶段。该现象在应变-时间曲线上表现为一段斜率稳定、接近线性的区域，通常对应于稳态蠕变阶段，反映了材料内部硬化与软化机制的动态平衡。" />
          <attvalue for="3" value="{&quot;reproducibility&quot;: &quot;very reproducible&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-023a8b25fea34ca6c8a3ebfc0f239288" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Plateau&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bf4f5a9c3c730bf3e4d0cca1e80be672-e-3&quot;, &quot;chunk-023a8b25fea34ca6c8a3ebfc0f239288-e-3&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-023a8b25fea34ca6c8a3ebfc0f239288-e-4" label="Final rupture">
        <attvalues>
          <attvalue for="0" value="Final rupture" />
          <attvalue for="1" value="Event" />
          <attvalue for="2" value="指材料在高温和持续应力作用下，因蠕变导致内部微孔洞形成、长大并汇合，最终引发的宏观断裂现象。它是蠕变过程的最终阶段，与蠕变孔洞密切相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-023a8b25fea34ca6c8a3ebfc0f239288" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-023a8b25fea34ca6c8a3ebfc0f239288-e-6" label="Porosity">
        <attvalues>
          <attvalue for="0" value="Porosity" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="一种冶金缺陷，指在多晶氧化皮（Polycrystalline scale）内部存在的微小孔洞或空隙。它破坏了材料的致密性和连续性，会显著降低其机械强度和保护性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-023a8b25fea34ca6c8a3ebfc0f239288" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;porosity&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-023a8b25fea34ca6c8a3ebfc0f239288-e-6&quot;, &quot;chunk-e3fb38d02a415446b1548e163c6a6dda-e-7&quot;, &quot;chunk-455a426fd56bc0498536fbbc0427ca38-e-8&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-023a8b25fea34ca6c8a3ebfc0f239288-e-8" label="Interdendritic regions">
        <attvalues>
          <attvalue for="0" value="Interdendritic regions" />
          <attvalue for="1" value="Microstructural Location" />
          <attvalue for="2" value="**标准化描述:**&#10;在金属凝固过程中，树枝状晶体（枝晶）之间存在的微观区域。该区域是最后凝固的部分，常富集气体和杂质，因此是气孔、缩松等铸造缺陷的优先形成位置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-023a8b25fea34ca6c8a3ebfc0f239288" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Interdendritic Regions&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-023a8b25fea34ca6c8a3ebfc0f239288-e-8&quot;, &quot;chunk-f67fa6f044c8ebf471779ebaa3315c84-e-5&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-023a8b25fea34ca6c8a3ebfc0f239288-e-9" label="Pores">
        <attvalues>
          <attvalue for="0" value="Pores" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="一种在拓扑密排(TCP)相周围形成的空洞类缺陷。它通常作为蠕变空化的优先形核位置，是引起材料在高温下损伤、性能退化并最终导致断裂的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-023a8b25fea34ca6c8a3ebfc0f239288" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-023a8b25fea34ca6c8a3ebfc0f239288-e-9&quot;, &quot;chunk-561d2449c805db1de389831a67f53313-e-2&quot;, &quot;chunk-24dc73bed55f1ae6b213e521e6e11919-e-2&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-023a8b25fea34ca6c8a3ebfc0f239288-e-11" label="Fracture surface">
        <attvalues>
          <attvalue for="0" value="Fracture surface" />
          <attvalue for="1" value="Material Feature" />
          <attvalue for="2" value="断口（Fracture Surfaces），材料断裂时形成的内部表面。作为一种材料特征，它在此特指疲劳裂纹扩展阈值区所形成的、具有穿晶（transgranular）和多面状（faceted）微观形貌的断裂面，是分析材料失效模式的重要依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-023a8b25fea34ca6c8a3ebfc0f239288" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Fracture Surfaces&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-023a8b25fea34ca6c8a3ebfc0f239288-e-11&quot;, &quot;chunk-561d2449c805db1de389831a67f53313-e-3&quot;, &quot;chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-3&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-561d2449c805db1de389831a67f53313-e-1" label="Cavitation">
        <attvalues>
          <attvalue for="0" value="Cavitation" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="空化（Cavitation）是一种与幂律蠕变相关的材料失效机制。它指在高温和应力作用下，材料内部（通常在晶界处）形成、长大并合并微观空洞，最终导致沿晶断裂的过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-561d2449c805db1de389831a67f53313" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;cavitation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-561d2449c805db1de389831a67f53313-e-1&quot;, &quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-20&quot;, &quot;chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-2&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-561d2449c805db1de389831a67f53313-e-8" label="Rupture">
        <attvalues>
          <attvalue for="0" value="Rupture" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="一种材料失效模式，特指蠕变过程的最终阶段。由于空洞形核长大等微观变形和损伤的累积，导致蠕变应变速率急剧加速，并最终引发材料的宏观断裂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-561d2449c805db1de389831a67f53313" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-561d2449c805db1de389831a67f53313-e-8&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-561d2449c805db1de389831a67f53313-e-9" label="Micromechanical deformation modes">
        <attvalues>
          <attvalue for="0" value="Micromechanical deformation modes" />
          <attvalue for="1" value="Deformation Mechanism" />
          <attvalue for="2" value="微观力学变形模式是一种在微观尺度上描述材料如何响应外力的局部变形机制。它是材料内部损伤累积的物理过程，其演化与发展将最终导致材料发生宏观断裂（Rupture）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-561d2449c805db1de389831a67f53313" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-54201ad9eae0d02b418a034d58136abe-e-2" label="Fatigue failure">
        <attvalues>
          <attvalue for="0" value="Fatigue failure" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="疲劳失效是一种材料在循环载荷或交变应力作用下发生的断裂现象，其应力值远低于材料的静态强度极限。该过程通常涉及微观裂纹的萌生、扩展，并最终导致结构性断裂。低周疲劳（LCF）是其具体类型之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-54201ad9eae0d02b418a034d58136abe" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-54201ad9eae0d02b418a034d58136abe-e-2&quot;, &quot;chunk-89d564ce28954cbb960fc223c6f28b17-e-1&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-54201ad9eae0d02b418a034d58136abe-e-3" label="Oscillating loads">
        <attvalues>
          <attvalue for="0" value="Oscillating loads" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="指大小或方向随时间发生周期性变化的载荷。这种重复施加的应力会造成材料的累积损伤，即使其峰值远低于材料的静态强度极限，也最终会导致结构发生疲劳失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-54201ad9eae0d02b418a034d58136abe" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-54201ad9eae0d02b418a034d58136abe-e-3&quot;, &quot;chunk-8b5f0089753028d4f74bf5d1c1d40143-e-2&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-54201ad9eae0d02b418a034d58136abe-e-4" label="Nominally elastic stresses">
        <attvalues>
          <attvalue for="0" value="Nominally elastic stresses" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="在循环载荷下导致疲劳失效的一种应力状态。其宏观应力值低于材料的屈服强度，处于名义上的弹性范围内，但局部应力集中会引发微观塑性变形，从而导致裂纹萌生与扩展。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-54201ad9eae0d02b418a034d58136abe" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-54201ad9eae0d02b418a034d58136abe-e-4&quot;, &quot;chunk-8b5f0089753028d4f74bf5d1c1d40143-e-3&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-54201ad9eae0d02b418a034d58136abe-e-5" label="Metallic materials">
        <attvalues>
          <attvalue for="0" value="Metallic materials" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="金属材料是由金属元素或以其为主构成的材料统称，通常具备金属光泽、良好的导电导热性和延展性。该类别涵盖范围广泛，例如单晶高温合金。其在循环载荷作用下易于发生疲劳失效，是其关键的力学特性之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-54201ad9eae0d02b418a034d58136abe" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-1" label="Failure">
        <attvalues>
          <attvalue for="0" value="Failure" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="失效是一种现象，指构件或系统因材料退化、过载或磨损等因素，而丧失其预定功能的状态。例如，半导体器件中热生长氧化物（Thermally Grown Oxide）的形成就是一种可能促成失效的材料退化过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;failure&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8b5f0089753028d4f74bf5d1c1d40143-e-1&quot;, &quot;chunk-ae58c0f988aba111d22bb6ff5c500655-e-1&quot;, &quot;chunk-9e77a589c8fe70a5a486a0c63c76551f-e-2&quot;, &quot;chunk-6b3f56bd4325c1b8abc874fe75903d49-e-3&quot;, &quot;chunk-3ef3a46d5883ceba55b19f3ce086fd54-e-14&quot;, &quot;chunk-8a91b63add4adbc77d4752d41b7c75aa-e-3&quot;, &quot;chunk-23df60e783372fb64b1a5a9966ec4edc-e-2&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-4" label="Plastic deformation">
        <attvalues>
          <attvalue for="0" value="Plastic deformation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="塑性变形是指固体材料在应力作用下发生的永久、不可逆的形状改变。该过程通常局部发生于应力集中点附近，是导致材料失效的一个关键机制，其累积效应可引发疲劳损伤。" />
          <attvalue for="3" value="{&quot;locality&quot;: &quot;localised&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Plastic Strain&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8b5f0089753028d4f74bf5d1c1d40143-e-4&quot;, &quot;chunk-740f6c1fef49d66e9d25ef0e2de914da-e-2&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-5" label="Stress concentration sites">
        <attvalues>
          <attvalue for="0" value="Stress concentration sites" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="应力集中点是指由于铸造气孔、机加工痕迹等几何或材料不连续性，导致构件局部应力显著增高的特定位置。这些位置是材料在循环载荷下发生疲劳损伤和裂纹萌生的主要起源点。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8b5f0089753028d4f74bf5d1c1d40143-e-5&quot;, &quot;chunk-da09b64f941acad7c5dafb6cd99e1895-e-4&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-6" label="Fatigue damage">
        <attvalues>
          <attvalue for="0" value="Fatigue damage" />
          <attvalue for="1" value="Damage Type" />
          <attvalue for="2" value="疲劳损伤是一种由循环载荷引起的材料损伤。其微观机制涉及位错活动，宏观上表现为循环塑性变形导致的强烈、局部化的滑移，这一过程也称为循环滑移局部化，是疲劳裂纹萌生的前兆。" />
          <attvalue for="3" value="{&quot;form&quot;: &quot;intense, localised slip&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8b5f0089753028d4f74bf5d1c1d40143-e-6&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-7" label="Dislocation activity">
        <attvalues>
          <attvalue for="0" value="Dislocation activity" />
          <attvalue for="1" value="Microstructural Process" />
          <attvalue for="2" value="位错活动是一种微观结构过程，指晶体中位错的运动。它作为局部塑性滑移的基本机制，其运动被限制在特定的晶格面上，是导致材料发生塑性变形及疲劳损伤等现象的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8b5f0089753028d4f74bf5d1c1d40143-e-7&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-8" label="Lattice planes">
        <attvalues>
          <attvalue for="0" value="Lattice planes" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="材料晶体结构中的特定原子平面。在塑性变形过程中，位错的运动被局限在这些平面上，因此它们作为滑移面，决定了材料的强度和延展性等关键力学行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-9" label="Cyclic slip localisation">
        <attvalues>
          <attvalue for="0" value="Cyclic slip localisation" />
          <attvalue for="1" value="Deformation Mechanism" />
          <attvalue for="2" value="循环滑移局部化是一种在循环加载下发生的塑性变形机制。该现象指位错滑移高度集中于材料内部的持久滑移带等特定微观区域，造成不均匀的局部变形，是导致材料疲劳裂纹萌生的关键前兆。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;cyclic slip localisation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8b5f0089753028d4f74bf5d1c1d40143-e-9&quot;, &quot;chunk-8a91b63add4adbc77d4752d41b7c75aa-e-8&quot;, &quot;chunk-da09b64f941acad7c5dafb6cd99e1895-e-9&quot;, &quot;chunk-ef56fb2a5c4451551a2024d8490545ff-e-1&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-10" label="High Temperature">
        <attvalues>
          <attvalue for="0" value="High Temperature" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="高温是一种物理条件，指足以促进材料内部发生循环滑移局部化的温度环境。这种现象会导致塑性变形高度集中，是加速材料在循环载荷作用下萌生疲劳裂纹、最终导致失效的重要因素。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;around 700 °C&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;High temperatures&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-023a8b25fea34ca6c8a3ebfc0f239288-e-2&quot;, &quot;chunk-8b5f0089753028d4f74bf5d1c1d40143-e-10&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-11" label="High Stresses">
        <attvalues>
          <attvalue for="0" value="High Stresses" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="在材料科学中，指材料内部机械应力达到较高水平的一种状态。该状态是促进循环滑移局部化的关键驱动因素，导致塑性变形在循环载荷下集中于特定区域，通常是疲劳裂纹萌生的前兆。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-da09b64f941acad7c5dafb6cd99e1895-e-1" label="Persistent Slip Bands">
        <attvalues>
          <attvalue for="0" value="Persistent Slip Bands" />
          <attvalue for="1" value="Deformation Mechanism" />
          <attvalue for="2" value="持久滑移带是金属等晶体材料在循环载荷下形成的一种微观结构。它是局部塑性应变高度集中的窄带，在材料表面形成挤出和侵入的微观台阶。因其在表面抛光后仍会在原处重现而得名“持久”。该结构是疲劳裂纹萌生的主要位置，是决定材料疲劳寿命的关键因素。" />
          <attvalue for="3" value="{&quot;abbreviation&quot;: &quot;PSBs&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-da09b64f941acad7c5dafb6cd99e1895" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;persistent slip bands&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-da09b64f941acad7c5dafb6cd99e1895-e-1&quot;, &quot;chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-9&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-da09b64f941acad7c5dafb6cd99e1895-e-2" label="γ' particles">
        <attvalues>
          <attvalue for="0" value="γ' particles" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="γ'相（γ' particle）是镍基高温合金中的一种关键强化相沉淀物，通常为Ni₃(Al, Ti)化学计量，具有L1₂有序结构。它通过阻碍位错运动来提供高温强度。在高温蠕变过程中，其颗粒会连接形成筏状结构（rafts），其尺寸决定了筏的厚度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-da09b64f941acad7c5dafb6cd99e1895" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;γ' particle&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-78b756dd65fb78d8b34a959b45292e60-e-4&quot;, &quot;chunk-da09b64f941acad7c5dafb6cd99e1895-e-2&quot;, &quot;chunk-0dac1108ee01fd25c7f627485d2972e6-e-3&quot;, &quot;chunk-6c8bf2ccc7af91368e39bedeb76382ef-e-1&quot;, &quot;chunk-0fc62816353bfe4473c22a2bef9a696b-e-5&quot;, &quot;chunk-26ae1c8b32c505920e532d6304655e87-e-4&quot;, &quot;chunk-2a630be2b8090ec92842cc9c1737eb42-e-2&quot;, &quot;chunk-9a94346ed73c8bcf6797ad71ded00b42-e-4&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="11" />
        </attvalues>
      </node>
      <node id="chunk-da09b64f941acad7c5dafb6cd99e1895-e-3" label="Fatigue initiation">
        <attvalues>
          <attvalue for="0" value="Fatigue initiation" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="疲劳萌生（Fatigue initiation）是一种失效机理，指材料在循环载荷作用下，因局部塑性应变累积而形成微观裂纹的初始过程。这个阶段是决定材料寿命的关键环节，尤其在低周疲劳（LCF）中起主导控制作用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-da09b64f941acad7c5dafb6cd99e1895" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Fatigue Initiation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-da09b64f941acad7c5dafb6cd99e1895-e-3&quot;, &quot;chunk-ef56fb2a5c4451551a2024d8490545ff-e-4&quot;, &quot;chunk-97f22587e687782a5433110f85b94c9e-e-8&quot;, &quot;chunk-e15d40b719932710977e7301c85e011b-e-3&quot;, &quot;chunk-0c0cb15f0b332db0e8b9015221af9b16-e-7&quot;, &quot;chunk-b286a29cb9e3f3bd1cd45617831e303b-e-1&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-da09b64f941acad7c5dafb6cd99e1895-e-5" label="Casting pores">
        <attvalues>
          <attvalue for="0" value="Casting pores" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="铸造气孔是在金属铸造过程中，因气体未及时逸出或材料收缩而形成的内部或表面孔穴类缺陷。它作为一种典型的应力集中点，会破坏材料的连续性，显著降低铸件的强度、韧性和疲劳寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-da09b64f941acad7c5dafb6cd99e1895" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-da09b64f941acad7c5dafb6cd99e1895-e-6" label="Machining marks">
        <attvalues>
          <attvalue for="0" value="Machining marks" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="加工痕迹是在机械加工过程中，刀具等在工件表面留下的划痕或沟槽。作为一种表面缺陷，这些微观的几何不连续性会形成应力集中点，显著降低材料的疲劳强度，并可能成为裂纹的起源。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-da09b64f941acad7c5dafb6cd99e1895" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-da09b64f941acad7c5dafb6cd99e1895-e-7" label="Dislocation activity">
        <attvalues>
          <attvalue for="0" value="Dislocation activity" />
          <attvalue for="1" value="Deformation Mechanism" />
          <attvalue for="2" value="一种变形机制，指在高温和低应力条件下，材料内部的位错运动被限制在γ通道（y channels）内的现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-da09b64f941acad7c5dafb6cd99e1895" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-da09b64f941acad7c5dafb6cd99e1895-e-10" label="High Stress and ~700 °C Temperature">
        <attvalues>
          <attvalue for="0" value="High Stress and ~700 °C Temperature" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="一种材料在约700°C高温下承受高应力的极端物理环境。该条件是诱发持久滑移带（Persistent Slip Bands）形成的关键因素，通常在金属材料的疲劳和蠕变研究中出现，与材料的微观损伤和最终失效密切相关。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;around 700 °C&quot;, &quot;stress&quot;: &quot;high&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-da09b64f941acad7c5dafb6cd99e1895" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-da09b64f941acad7c5dafb6cd99e1895-e-11" label="High Temperature and Low Stress">
        <attvalues>
          <attvalue for="0" value="High Temperature and Low Stress" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="高温低应力是一种特定的材料物理条件。其特征在于，材料内部的位错活动被限制在γ通道中，同时循环滑移的局部化现象强度也随之减弱。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;higher&quot;, &quot;stress&quot;: &quot;low&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-da09b64f941acad7c5dafb6cd99e1895" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ef56fb2a5c4451551a2024d8490545ff-e-5" label="Surface pits">
        <attvalues>
          <attvalue for="0" value="Surface pits" />
          <attvalue for="1" value="Surface Defect" />
          <attvalue for="2" value="一种常见的材料表面缺陷，表现为局部的微小凹陷。由于会造成应力集中，它通常是疲劳裂纹的起始点，即疲劳萌生的位置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ef56fb2a5c4451551a2024d8490545ff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ef56fb2a5c4451551a2024d8490545ff-e-6" label="Cracks in the oxide films">
        <attvalues>
          <attvalue for="0" value="Cracks in the oxide films" />
          <attvalue for="1" value="Surface Defect" />
          <attvalue for="2" value="指存在于氧化膜中的一种表面缺陷。这种裂纹是应力集中的区域，通常作为材料疲劳开始萌生的起始位置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-ef56fb2a5c4451551a2024d8490545ff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ef56fb2a5c4451551a2024d8490545ff-e-7" label="Oxide films">
        <attvalues>
          <attvalue for="0" value="Oxide films" />
          <attvalue for="1" value="Surface Layer" />
          <attvalue for="2" value="氧化膜是覆盖在材料（通常是金属或半导体）表面，通过其与氧化剂反应或经电化学处理而形成的氧化物薄层。它能改变材料的表面特性，起到防腐蚀、钝化保护等作用，或作为功能层应用于电子器件中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ef56fb2a5c4451551a2024d8490545ff" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ef56fb2a5c4451551a2024d8490545ff-e-7&quot;, &quot;chunk-00040f62aa8af89625402875bec28b94-e-9&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-bec9ddac9ea109abb615ddd436849b16-e-1" label="Blading">
        <attvalues>
          <attvalue for="0" value="Blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="Blading（叶片）是燃气轮机或航空发动机中的关键旋转部件。它在服役时承受高温、高压和高离心力等极端工况，因此通常采用单晶高温合金等先进耐热材料制造，以确保其性能与可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-bec9ddac9ea109abb615ddd436849b16" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bec9ddac9ea109abb615ddd436849b16-e-2" label="Service Environment">
        <attvalues>
          <attvalue for="0" value="Service Environment" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="**服役环境 (service environment)**&#10;&#10;指材料、部件或系统在其实际使用寿命中所经受的真实物理、化学和力学等条件的综合。它代表了产品在最终应用中的实际工况，通常与实验室中用于性能评估的简化或加速的测试条件相对。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-bec9ddac9ea109abb615ddd436849b16" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;service environment&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bec9ddac9ea109abb615ddd436849b16-e-2&quot;, &quot;chunk-e3527c9f74d686641ceba7afb52a8ef3-e-8&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-bec9ddac9ea109abb615ddd436849b16-e-3" label="Laboratory">
        <attvalues>
          <attvalue for="0" value="Laboratory" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="实验室 (Laboratory): 一个配备专门设备，用于在受控条件下进行科学研究、实验、测试或测量的场所。由于其环境的高度可控性，它在精确复现某些复杂多变的真实世界服务环境时可能存在固有限制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-bec9ddac9ea109abb615ddd436849b16" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bec9ddac9ea109abb615ddd436849b16-e-3&quot;, &quot;chunk-86085af24c3d22aa7ef748be1713da2e-e-7&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-bec9ddac9ea109abb615ddd436849b16-e-5" label="Fatigue performance">
        <attvalues>
          <attvalue for="0" value="Fatigue performance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="疲劳性能是一种材料属性，指材料在循环载荷作用下抵抗断裂或失效的能力。该性能具有显著的概率性特征，必须采用统计学方法进行评估。它受材料的体积和表面积影响，通常随着体积和表面积的增大，由于存在缺陷的概率增加，其疲劳性能会相应降低。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-bec9ddac9ea109abb615ddd436849b16" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;fatigue performance&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bec9ddac9ea109abb615ddd436849b16-e-5&quot;, &quot;chunk-dbeae8c905eb9660d64dd5fc3e317235-e-5&quot;, &quot;chunk-4e8463ac395e2b30702e7ef75baf5b7a-e-2&quot;, &quot;chunk-3f9080fcd7c49e23baf06d3cf81ed207-e-2&quot;, &quot;chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-16&quot;, &quot;chunk-0625d83d7200f989528119d9ba61865a-e-3&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-bec9ddac9ea109abb615ddd436849b16-e-7" label="Uniaxial load control">
        <attvalues>
          <attvalue for="0" value="Uniaxial load control" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="单轴载荷控制是一种力学测试的控制模式。在该模式下，试验机沿单一轴向（如拉伸或压缩）对试样施加并控制载荷（力或应力）作为独立变量，同时测量其产生的变形（应变）。这种方法常用于在等温条件下进行材料的拉伸、压缩及疲劳性能测试。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-bec9ddac9ea109abb615ddd436849b16" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bec9ddac9ea109abb615ddd436849b16-e-7&quot;, &quot;chunk-a5192ee579410694b4542905f037961f-e-2&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bec9ddac9ea109abb615ddd436849b16-e-8" label="Strain control">
        <attvalues>
          <attvalue for="0" value="Strain control" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="应变控制是一种材料力学试验的控制模式。它通过主动控制施加于试样的应变或应变速率作为独立变量，并测量由此产生的应力响应，以研究材料的力学性能。该方法与应力控制相对，常用于拉伸、压缩及疲劳等试验中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-bec9ddac9ea109abb615ddd436849b16" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;strain-controlled fatigue&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bec9ddac9ea109abb615ddd436849b16-e-8&quot;, &quot;chunk-a5192ee579410694b4542905f037961f-e-3&quot;, &quot;chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-6&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a5192ee579410694b4542905f037961f-e-4" label="Cyclic stress range">
        <attvalues>
          <attvalue for="0" value="Cyclic stress range" />
          <attvalue for="1" value="Mechanical Parameter" />
          <attvalue for="2" value="循环应力范围是一个核心力学参数，指材料在单个应力循环中所承受的最大应力(σmax)与最小应力(σmin)的代数差值。它是评估和预测材料疲劳寿命的关键指标。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;Ar&quot;, &quot;definition&quot;: &quot;omax - omin&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a5192ee579410694b4542905f037961f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a5192ee579410694b4542905f037961f-e-5" label="omax">
        <attvalues>
          <attvalue for="0" value="omax" />
          <attvalue for="1" value="Mechanical Parameter" />
          <attvalue for="2" value="omax (最大应力) 是一个力学参数，指材料在循环加载过程中，单个周期内所承受的代数最大应力值。它是定义循环应力范围、平均应力及应力比等关键疲劳特性的基本变量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a5192ee579410694b4542905f037961f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-a5192ee579410694b4542905f037961f-e-6" label="omin">
        <attvalues>
          <attvalue for="0" value="omin" />
          <attvalue for="1" value="Mechanical Parameter" />
          <attvalue for="2" value="最小应力（σ_min）是一个机械参数，指材料在循环加载的一个周期内所承受的最低应力值。它与最大应力共同定义了平均应力、循环应力范围及应力比（R-ratio）等描述材料疲劳行为的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a5192ee579410694b4542905f037961f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a5192ee579410694b4542905f037961f-e-7" label="Mean stress">
        <attvalues>
          <attvalue for="0" value="Mean stress" />
          <attvalue for="1" value="Mechanical Parameter" />
          <attvalue for="2" value="平均应力（Mean stress）是一个力学参数，指在循环载荷作用下，一个应力周期内最大应力（σmax）与最小应力（σmin）的代数平均值。它显著影响材料的疲劳寿命，其计算公式为 (σmax + σmin)/2。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;mean&quot;, &quot;definition&quot;: &quot;(max + 5min)&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a5192ee579410694b4542905f037961f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a5192ee579410694b4542905f037961f-e-9" label="Fully reversed loading">
        <attvalues>
          <attvalue for="0" value="Fully reversed loading" />
          <attvalue for="1" value="Loading Condition" />
          <attvalue for="2" value="全反向加载是一种循环加载工况，其应力比（R值）为-1。该工况的特征是，在一个加载周期内，最大拉应力与最大压应力的大小相等、符号相反，因此平均应力为零。" />
          <attvalue for="3" value="{&quot;condition&quot;: &quot;omax = -5min&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-a5192ee579410694b4542905f037961f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-89d564ce28954cbb960fc223c6f28b17-e-2" label="Low-cycle fatigue (LCF)">
        <attvalues>
          <attvalue for="0" value="Low-cycle fatigue (LCF)" />
          <attvalue for="1" value="Fatigue Type" />
          <attvalue for="2" value="低周疲劳（Low Cycle Fatigue, LCF）是一种机械现象，指材料在足以引起循环塑性变形的高应力或应变作用下，经历较少循环次数后发生的失效。其典型特征为应力-应变曲线中出现滞后回线，是评估单晶高温合金等材料在严苛工况下寿命的关键指标。" />
          <attvalue for="3" value="{&quot;failure_cycles&quot;: &quot;within 10^5 cycles&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-89d564ce28954cbb960fc223c6f28b17" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Low Cycle Fatigue (LCF)&quot;, &quot;Low-Cycle Fatigue (LCF)&quot;, &quot;Low-cycle fatigue&quot;, &quot;low-cycle fatigue&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-89d564ce28954cbb960fc223c6f28b17-e-2&quot;, &quot;chunk-cdded3befa5ee7c187ddd24acee4b703-e-1&quot;, &quot;chunk-dbeae8c905eb9660d64dd5fc3e317235-e-2&quot;, &quot;chunk-ed84e701f59ede6b9d64fc542ae54ff7-e-6&quot;, &quot;chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-4&quot;, &quot;chunk-d9d581e86b96c92ccf2b9c353b4e4e11-e-9&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-89d564ce28954cbb960fc223c6f28b17-e-3" label="Stress amplitude">
        <attvalues>
          <attvalue for="0" value="Stress amplitude" />
          <attvalue for="1" value="Mechanical Condition" />
          <attvalue for="2" value="应力幅是在循环载荷下，材料所受最大应力与最小应力之差的一半。它是一种关键的机械条件，当其数值超过材料的弹性极限时，会引起塑性变形，是导致低周疲劳（LCF）并使构件在少量循环后失效的主要原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-89d564ce28954cbb960fc223c6f28b17" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-89d564ce28954cbb960fc223c6f28b17-e-4" label="Elastic limit">
        <attvalues>
          <attvalue for="0" value="Elastic limit" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="弹性极限是一种材料力学性能，指材料不产生永久（塑性）变形所能承受的最大应力。在循环载荷下，若应力幅值超过此极限，将引起材料的塑性变形累积，从而导致低周疲劳。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-89d564ce28954cbb960fc223c6f28b17" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-89d564ce28954cbb960fc223c6f28b17-e-5" label="Propagation stage">
        <attvalues>
          <attvalue for="0" value="Propagation stage" />
          <attvalue for="1" value="Fatigue Stage" />
          <attvalue for="2" value="材料疲劳过程的核心阶段，指在裂纹萌生后，宏观裂纹持续、稳定扩展的过程。在低周疲劳（LCF）中，该阶段消耗了绝大部分寿命，与其之前的萌生阶段（Initiation stage）形成对比，是LCF的主要特征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-89d564ce28954cbb960fc223c6f28b17" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Propagation Stage&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-89d564ce28954cbb960fc223c6f28b17-e-5&quot;, &quot;chunk-cdded3befa5ee7c187ddd24acee4b703-e-2&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-89d564ce28954cbb960fc223c6f28b17-e-6" label="Initiation stage">
        <attvalues>
          <attvalue for="0" value="Initiation stage" />
          <attvalue for="1" value="Fatigue Stage" />
          <attvalue for="2" value="疲劳寿命的初始阶段，指材料在循环载荷作用下萌生微观裂纹的过程。它发生在裂纹扩展阶段之前，是疲劳失效过程的起点。在低周疲劳（LCF）中，此阶段所占寿命的比例通常比扩展阶段短。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-89d564ce28954cbb960fc223c6f28b17" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Initiation Stage&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-89d564ce28954cbb960fc223c6f28b17-e-6&quot;, &quot;chunk-cdded3befa5ee7c187ddd24acee4b703-e-9&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cdded3befa5ee7c187ddd24acee4b703-e-3" label="Engine Start-up and Stopping">
        <attvalues>
          <attvalue for="0" value="Engine Start-up and Stopping" />
          <attvalue for="1" value="Loading Condition" />
          <attvalue for="2" value="一种典型的载荷工况，指发动机从启动到停止的完整工作循环。该过程会产生剧烈的热机载荷交变，是导致关键部件发生低周疲劳（LCF）损伤的主要驱动力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-cdded3befa5ee7c187ddd24acee4b703" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cdded3befa5ee7c187ddd24acee4b703-e-4" label="High-Cycle Fatigue (HCF)">
        <attvalues>
          <attvalue for="0" value="High-Cycle Fatigue (HCF)" />
          <attvalue for="1" value="Mechanical Phenomenon" />
          <attvalue for="2" value="高周疲劳 (High Cycle Fatigue, HCF) 是一种材料疲劳失效形式，指材料在低于屈服强度的循环应力作用下，经历大量周期（通常&gt;10⁴次）后发生的突然断裂。它是单晶高温合金等航空发动机关键部件在服役中面临的主要失效机制之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-cdded3befa5ee7c187ddd24acee4b703" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;high cycle fatigue&quot;, &quot;high cycle fatigue (HCF)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cdded3befa5ee7c187ddd24acee4b703-e-4&quot;, &quot;chunk-8a91b63add4adbc77d4752d41b7c75aa-e-12&quot;, &quot;chunk-569a3d8aec20d9df6a256b4cf4b263a7-e-16&quot;, &quot;chunk-86425bad56c0d52ed7246eff0fe06dd8-e-1&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-cdded3befa5ee7c187ddd24acee4b703-e-5" label="Smaller Stress Amplitudes">
        <attvalues>
          <attvalue for="0" value="Smaller Stress Amplitudes" />
          <attvalue for="1" value="Stress Condition" />
          <attvalue for="2" value="一种以幅度较小为特征的循环应力状态，是高周疲劳（HCF）的典型成因。这种应力通常由机械振动或共振等物理现象所引发，会导致材料在经历大量加载循环后发生失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-cdded3befa5ee7c187ddd24acee4b703" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cdded3befa5ee7c187ddd24acee4b703-e-6" label="Blading">
        <attvalues>
          <attvalue for="0" value="Blading" />
          <attvalue for="1" value="Engine Component" />
          <attvalue for="2" value="一种发动机的关键旋转部件。它在运行中会因振动或共振承受周期性的较小应力，这种高频循环作用是导致其发生高周疲劳（High-Cycle Fatigue, HCF）失效的主要原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-cdded3befa5ee7c187ddd24acee4b703" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="167" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cdded3befa5ee7c187ddd24acee4b703-e-7" label="Vibrations or Resonance">
        <attvalues>
          <attvalue for="0" value="Vibrations or Resonance" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="振动或共振是一种物理现象。当外部激励频率与物体固有频率相近时发生共振，使振幅急剧增大。它作为一种载荷源，通过对叶片等构件施加大量、低幅值的应力循环，是导致高周疲劳（HCF）并最终引发结构失效的关键原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-cdded3befa5ee7c187ddd24acee4b703" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="167" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cdded3befa5ee7c187ddd24acee4b703-e-8" label="Elastic Regime">
        <attvalues>
          <attvalue for="0" value="Elastic Regime" />
          <attvalue for="1" value="Material State" />
          <attvalue for="2" value="**完全弹性区 (fully elastic regime)**&#10;&#10;一种材料的机械状态，指其变形主要为弹性变形。该状态消耗了材料绝大部分的疲劳寿命，其微观结构特征是滑移带密度极低，表明局部塑性变形非常有限。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-cdded3befa5ee7c187ddd24acee4b703" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;fully elastic regime&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cdded3befa5ee7c187ddd24acee4b703-e-8&quot;, &quot;chunk-e3527c9f74d686641ceba7afb52a8ef3-e-5&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-dbeae8c905eb9660d64dd5fc3e317235-e-1" label="Elastic Regime Fatigue">
        <attvalues>
          <attvalue for="0" value="Elastic Regime Fatigue" />
          <attvalue for="1" value="Fatigue Type" />
          <attvalue for="2" value="弹性区域疲劳（Elastic Regime Fatigue），又称高周疲劳（High-Cycle Fatigue），是一种材料疲劳失效模式。其核心特征是循环应力始终低于材料的屈服强度，使宏观变形处于弹性范围内。该模式下，裂纹萌生阶段占据寿命的绝大部分，因此断裂通常在经历极高次数（如超过十万次）的应力循环后才会发生。" />
          <attvalue for="3" value="{&quot;dominant_stage&quot;: &quot;initiation&quot;, &quot;failure_cycles&quot;: &quot;in excess of 10^5 cycles&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-dbeae8c905eb9660d64dd5fc3e317235" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="287" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-dbeae8c905eb9660d64dd5fc3e317235-e-3" label="LCF testing conditions">
        <attvalues>
          <attvalue for="0" value="LCF testing conditions" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="LCF测试条件是指进行低周疲劳（LCF）试验时所设定的一组特定参数。该试验的显著特征是在总应变控制模式下进行，其关键参数通常包括应变幅、应变速率、温度和加载波形。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-dbeae8c905eb9660d64dd5fc3e317235" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dbeae8c905eb9660d64dd5fc3e317235-e-3&quot;]}]" />
          <attvalue for="9" value="54" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dbeae8c905eb9660d64dd5fc3e317235-e-4" label="Total strain control">
        <attvalues>
          <attvalue for="0" value="Total strain control" />
          <attvalue for="1" value="Test Method" />
          <attvalue for="2" value="总应变控制是一种材料力学测试的加载方式。在此条件下，控制施加于试样的总应变（弹性应变与塑性应变之和）保持恒定或按预定速率变化，用以研究材料的应力松弛、低周疲劳及塑性变形等力学行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-dbeae8c905eb9660d64dd5fc3e317235" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Total Strain Control&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dbeae8c905eb9660d64dd5fc3e317235-e-4&quot;, &quot;chunk-37d0dc95528fe9478158b1b68eba312f-e-4&quot;]}]" />
          <attvalue for="9" value="54" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d3a53a265ee93c6aee58baa1a1638be0-e-1" label="Dalal, Thomas and Dardi [71]">
        <attvalues>
          <attvalue for="0" value="Dalal, Thomas and Dardi [71]" />
          <attvalue for="1" value="Researcher" />
          <attvalue for="2" value="Dalal, Thomas 和 Dardi 是一组研究人员，他们在文献[71]中报告了对一种实验性合金的低周疲劳（LCF）响应的测量结果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-d3a53a265ee93c6aee58baa1a1638be0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d3a53a265ee93c6aee58baa1a1638be0-e-2" label="Experimental Alloy">
        <attvalues>
          <attvalue for="0" value="Experimental Alloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种成分以重量百分比（wt%）计的实验性合金材料。该材料在980°C的高温下进行测试，展现出各向异性特征，其性能通过低周疲劳（LCF）响应进行表征。" />
          <attvalue for="3" value="{&quot;composition&quot;: &quot;Ni-6.8Al-13.8Mo–6W&quot;, &quot;specimen_form&quot;: &quot;smooth, polished&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-d3a53a265ee93c6aee58baa1a1638be0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d3a53a265ee93c6aee58baa1a1638be0-e-3" label="LCF response">
        <attvalues>
          <attvalue for="0" value="LCF response" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="低周疲劳响应（LCF response）是一种机械性能，指材料在总应变控制下，承受循环塑性变形时的行为及抗失效能力，常用于表征实验合金等材料的疲劳寿命。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;980 °C&quot;, &quot;control_method&quot;: &quot;total strain control&quot;, &quot;R_ratio&quot;: &quot;0&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d3a53a265ee93c6aee58baa1a1638be0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d3a53a265ee93c6aee58baa1a1638be0-e-3&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d3a53a265ee93c6aee58baa1a1638be0-e-4" label="Total strain range (Δε_total)">
        <attvalues>
          <attvalue for="0" value="Total strain range (Δε_total)" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="总应变范围 (Δε_total) 是材料疲劳分析中的一个关键参数，指材料在循环载荷下每个周期内经历的总应变（弹性应变与塑性应变之和）的变化幅度。根据Coffin-Manson关系，其对数与疲劳寿命的对数成反比，是预测材料疲劳寿命的核心指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d3a53a265ee93c6aee58baa1a1638be0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Total strain range (Δ∈total)&quot;, &quot;Total strain ranges&quot;, &quot;Δ∈total&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d3a53a265ee93c6aee58baa1a1638be0-e-4&quot;, &quot;chunk-d18410100c72f222901949093ef379ca-e-1&quot;, &quot;chunk-0c0cb15f0b332db0e8b9015221af9b16-e-4&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d3a53a265ee93c6aee58baa1a1638be0-e-5" label="Fatigue life (Nf)">
        <attvalues>
          <attvalue for="0" value="Fatigue life (Nf)" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="Nf，即疲劳寿命（Fatigue Life），是一种材料属性，指材料在发生疲劳失效前所能承受的载荷循环次数。它是一个衡量材料耐久性的关键指标，在应变疲劳分析中，其数值与每个循环中施加的总应变范围（Δ∈total）成反比关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d3a53a265ee93c6aee58baa1a1638be0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Nf&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d3a53a265ee93c6aee58baa1a1638be0-e-5&quot;, &quot;chunk-d18410100c72f222901949093ef379ca-e-2&quot;, &quot;chunk-18e706cf8ca843db25be30e8eb057f20-e-6&quot;, &quot;chunk-0659b62691281fc5f1e0a0636a9eb57b-e-3&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d3a53a265ee93c6aee58baa1a1638be0-e-7" label="Loading axis orientation">
        <attvalues>
          <attvalue for="0" value="Loading axis orientation" />
          <attvalue for="1" value="Physical Parameter" />
          <attvalue for="2" value="加载轴方向是一个材料力学参数，指施加于材料上的载荷主轴的空间方向。它与材料内部晶体取向的相对关系，是决定和分析材料各向异性力学行为（如强度、变形）的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d3a53a265ee93c6aee58baa1a1638be0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Orientation of the loading axis&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dbeae8c905eb9660d64dd5fc3e317235-e-6&quot;, &quot;chunk-d3a53a265ee93c6aee58baa1a1638be0-e-7&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d18410100c72f222901949093ef379ca-e-3" label="(001) orientation">
        <attvalues>
          <attvalue for="0" value="(001) orientation" />
          <attvalue for="1" value="Crystallographic Orientation" />
          <attvalue for="2" value="(001)取向是单晶高温合金的一种关键晶体学取向。与(011)和(111)等其他取向相比，该取向因具有最优越的综合高温力学性能而被广泛应用于航空航天等领域。" />
          <attvalue for="3" value="{&quot;performance&quot;: &quot;best&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d18410100c72f222901949093ef379ca" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d18410100c72f222901949093ef379ca-e-3&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-d18410100c72f222901949093ef379ca-e-4" label="(011) orientation">
        <attvalues>
          <attvalue for="0" value="(011) orientation" />
          <attvalue for="1" value="Crystallographic Orientation" />
          <attvalue for="2" value="(011)取向是一种晶体学取向。根据上下文，其性能表现优于(111)取向，但劣于(001)取向，是一种性能居中的晶体排列方式。" />
          <attvalue for="3" value="{&quot;performance&quot;: &quot;intermediate&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d18410100c72f222901949093ef379ca" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d18410100c72f222901949093ef379ca-e-4&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d18410100c72f222901949093ef379ca-e-5" label="(111) orientation">
        <attvalues>
          <attvalue for="0" value="(111) orientation" />
          <attvalue for="1" value="Crystallographic Orientation" />
          <attvalue for="2" value="一种由米勒指数(111)表示的晶体取向。在与(001)和(011)取向的对比测试中，其性能表现最差。" />
          <attvalue for="3" value="{&quot;performance&quot;: &quot;worst&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d18410100c72f222901949093ef379ca" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d18410100c72f222901949093ef379ca-e-5&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-18e706cf8ca843db25be30e8eb057f20-e-1" label="Fatigue Strength">
        <attvalues>
          <attvalue for="0" value="Fatigue Strength" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="疲劳强度（Fatigue Strength）是一种关键的力学性能。在单晶高温合金中，其大小与加载方向的弹性模量强相关，并表现出显著的各向异性：在(001)晶向上性能优越，而在(111)晶向上则相对较差。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-18e706cf8ca843db25be30e8eb057f20" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-18e706cf8ca843db25be30e8eb057f20-e-3" label="(001) direction">
        <attvalues>
          <attvalue for="0" value="(001) direction" />
          <attvalue for="1" value="Crystallographic Direction" />
          <attvalue for="2" value="由密勒指数(001)定义的晶体学方向（晶向）。在立方晶系中，它通常指沿晶格坐标轴的方向。在此上下文中，它是定义和测量材料屈服强度时所依据的特定晶体取向。" />
          <attvalue for="3" value="{&quot;elastic_property&quot;: &quot;soft&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-18e706cf8ca843db25be30e8eb057f20" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-18e706cf8ca843db25be30e8eb057f20-e-3&quot;, &quot;chunk-0659b62691281fc5f1e0a0636a9eb57b-e-7&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-18e706cf8ca843db25be30e8eb057f20-e-4" label="(111) direction">
        <attvalues>
          <attvalue for="0" value="(111) direction" />
          <attvalue for="1" value="Crystallographic Direction" />
          <attvalue for="2" value="(111)方向是纯镍晶体中一个特定的晶体学方向。沿此方向，纯镍的刚度最大，即拥有最高的杨氏模量，代表了其抵抗弹性形变的能力最强，性能优于(100)等其他晶向。" />
          <attvalue for="3" value="{&quot;elastic_property&quot;: &quot;stiff&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-18e706cf8ca843db25be30e8eb057f20" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-18e706cf8ca843db25be30e8eb057f20-e-4&quot;, &quot;chunk-0659b62691281fc5f1e0a0636a9eb57b-e-8&quot;, &quot;chunk-d4ec865719f1815d38483ef812cf9ed2-e-3&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-18e706cf8ca843db25be30e8eb057f20-e-5" label="∆etotal Ehkl">
        <attvalues>
          <attvalue for="0" value="∆etotal Ehkl" />
          <attvalue for="1" value="Calculated Parameter" />
          <attvalue for="2" value="一个计算参数，其值为总应变范围(∆etotal)与特定hkl晶向弹性模量(Ehkl)的乘积。该参数具有应力量纲，在材料科学中常与疲劳寿命(Nf)绘制关系曲线，用以评估材料的疲劳性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-18e706cf8ca843db25be30e8eb057f20" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0659b62691281fc5f1e0a0636a9eb57b-e-1" label="Ehkl">
        <attvalues>
          <attvalue for="0" value="Ehkl" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="Ehkl是一种材料属性，指沿加载轴方向测量的、特定晶面（hkl）的弹性模量。该参数主要用于材料的疲劳数据分析。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-0659b62691281fc5f1e0a0636a9eb57b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-0659b62691281fc5f1e0a0636a9eb57b-e-2" label="Aetotal">
        <attvalues>
          <attvalue for="0" value="Aetotal" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="Aetotal是疲劳分析中的一个参数，用于表征材料的疲劳性能。它常与疲劳寿命（Nf）绘制成曲线，以评估材料的耐久性。在特定应用中，可被参数Ehkl替代。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-0659b62691281fc5f1e0a0636a9eb57b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0659b62691281fc5f1e0a0636a9eb57b-e-4" label="Fatigue data">
        <attvalues>
          <attvalue for="0" value="Fatigue data" />
          <attvalue for="1" value="Data" />
          <attvalue for="2" value="疲劳数据 (Fatigue data) 是一类描述材料在循环载荷下性能的实验数据。其关键特征是，在使用特定分析模型（如Ehkl）处理时，数据点可以收敛成一条直线，从而简化对材料疲劳寿命的分析与预测。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0659b62691281fc5f1e0a0636a9eb57b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0659b62691281fc5f1e0a0636a9eb57b-e-4&quot;, &quot;chunk-6656e9c896783e532db09028bd4f742e-e-2&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0659b62691281fc5f1e0a0636a9eb57b-e-5" label="Loading axis">
        <attvalues>
          <attvalue for="0" value="Loading axis" />
          <attvalue for="1" value="Reference Direction" />
          <attvalue for="2" value="在材料科学中，指定义特定晶面弹性模量（Ehkl）时所依据的参考方向。该模量表征了材料沿此轴线方向的刚度或弹性性能，是分析材料各向异性力学行为的关键基准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-0659b62691281fc5f1e0a0636a9eb57b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0659b62691281fc5f1e0a0636a9eb57b-e-5&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0659b62691281fc5f1e0a0636a9eb57b-e-9" label="Elastic strain at yield">
        <attvalues>
          <attvalue for="0" value="Elastic strain at yield" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="作为一种材料属性，指材料在屈服点所能承受的最大弹性应变，是弹性变形与塑性变形的临界点。该值与材料刚度（Stiffness）成反比，并会因晶体取向（如(111)方向）不同而变化，表现出各向异性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-0659b62691281fc5f1e0a0636a9eb57b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-740f6c1fef49d66e9d25ef0e2de914da-e-1" label="Specimen tested along (111)">
        <attvalues>
          <attvalue for="0" value="Specimen tested along (111)" />
          <attvalue for="1" value="Material Specimen" />
          <attvalue for="2" value="沿(111)晶向进行力学性能测试的材料试样。其通常表现出较高的刚度，并能承受或展现出更大的塑性应变。" />
          <attvalue for="3" value="{&quot;crystallographic_direction&quot;: &quot;(111)&quot;, &quot;stiffness&quot;: &quot;greater&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-740f6c1fef49d66e9d25ef0e2de914da" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-740f6c1fef49d66e9d25ef0e2de914da-e-3" label="Fatigue Process">
        <attvalues>
          <attvalue for="0" value="Fatigue Process" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="一种典型的材料失效机制。指材料在循环载荷作用下，因局部塑性应变的累积而引发微观裂纹的萌生与扩展，并最终导致结构宏观断裂的渐进性损伤过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-740f6c1fef49d66e9d25ef0e2de914da" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-740f6c1fef49d66e9d25ef0e2de914da-e-3&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-740f6c1fef49d66e9d25ef0e2de914da-e-4" label="Poorer Properties">
        <attvalues>
          <attvalue for="0" value="Poorer Properties" />
          <attvalue for="1" value="Material Characteristic" />
          <attvalue for="2" value="一种由较大塑性应变引起的材料特性。它描述了材料在经历显著的塑性变形后，其一种或多种关键性能指标发生退化或劣化的状态。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-740f6c1fef49d66e9d25ef0e2de914da" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-740f6c1fef49d66e9d25ef0e2de914da-e-7" label="Yield stress along (001)">
        <attvalues>
          <attvalue for="0" value="Yield stress along (001)" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种材料力学性能，指晶体材料在沿[001]晶体学方向受力时，发生塑性变形所需的临界应力。由于晶体的各向异性，该值通常与沿其他晶向（如[111]）测得的屈服应力存在差异。" />
          <attvalue for="3" value="{&quot;crystallographic_direction&quot;: &quot;(001)&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-740f6c1fef49d66e9d25ef0e2de914da" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Yield Stress along (001)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-740f6c1fef49d66e9d25ef0e2de914da-e-7&quot;, &quot;chunk-37d0dc95528fe9478158b1b68eba312f-e-1&quot;]}]" />
          <attvalue for="9" value="104" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-740f6c1fef49d66e9d25ef0e2de914da-e-8" label="Yield stress along (111)">
        <attvalues>
          <attvalue for="0" value="Yield stress along (111)" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="指晶体材料沿(111)晶体学方向发生塑性变形所需的临界应力。该属性是表征材料力学性能各向异性的关键参数，其值随测量方向变化。例如，该方向的屈服应力通常低于(001)方向，表明材料在此方向上更容易屈服。" />
          <attvalue for="3" value="{&quot;crystallographic_direction&quot;: &quot;(111)&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-740f6c1fef49d66e9d25ef0e2de914da" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Yield Stress along (111)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-740f6c1fef49d66e9d25ef0e2de914da-e-8&quot;, &quot;chunk-37d0dc95528fe9478158b1b68eba312f-e-2&quot;]}]" />
          <attvalue for="9" value="104" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-37d0dc95528fe9478158b1b68eba312f-e-3" label="Increment Aoy">
        <attvalues>
          <attvalue for="0" value="Increment Aoy" />
          <attvalue for="1" value="Value" />
          <attvalue for="2" value="Increment Aoy指晶体材料在(001)和(111)两个晶向上的屈服应力之差。它是一个关键参数，用于量化材料的力学性能各向异性，即材料强度在不同方向上的差异。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;in excess of 200 MPa&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-37d0dc95528fe9478158b1b68eba312f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="104" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-37d0dc95528fe9478158b1b68eba312f-e-5" label="Plastic Strain along (001)">
        <attvalues>
          <attvalue for="0" value="Plastic Strain along (001)" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="一种力学性能，指材料沿(001)晶向产生的塑性应变。在总应变控制的条件下，该应变会减小。这一特性是材料在该方向上具备优越性能的直接体现，其减小程度受Δσy/E001因子影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-37d0dc95528fe9478158b1b68eba312f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="54" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-37d0dc95528fe9478158b1b68eba312f-e-6" label="Factor Δσy/E001">
        <attvalues>
          <attvalue for="0" value="Factor Δσy/E001" />
          <attvalue for="1" value="Factor" />
          <attvalue for="2" value="一个无量纲因子，定义为屈服应力变化量(Δσy)与[001]方向杨氏模量(E001)的比值。该因子用于量化沿[001]晶向的塑性应变所减少的程度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-37d0dc95528fe9478158b1b68eba312f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="54" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-37d0dc95528fe9478158b1b68eba312f-e-7" label="Superior Properties along (001)">
        <attvalues>
          <attvalue for="0" value="Superior Properties along (001)" />
          <attvalue for="1" value="Material Characteristic" />
          <attvalue for="2" value="一种材料特性，指晶体材料沿[001]晶向测得的综合力学性能（如塑性应变能力）显著优于其他方向。该特性是材料力学各向异性的具体表现。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-37d0dc95528fe9478158b1b68eba312f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="54" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-37d0dc95528fe9478158b1b68eba312f-e-8" label="Load Control">
        <attvalues>
          <attvalue for="0" value="Load Control" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="一种力学测试的控制模式，指将施加于材料的载荷（力）作为独立控制变量，并使其按预设速率或程序变化。该模式用于测定材料在特定加载条件下的应力-应变关系、强度及弹性模量等力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-37d0dc95528fe9478158b1b68eba312f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Load-controlled conditions&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-37d0dc95528fe9478158b1b68eba312f-e-8&quot;, &quot;chunk-758fdf43c1ef8b578d580aebaef12e05-e-3&quot;]}]" />
          <attvalue for="9" value="55" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-37d0dc95528fe9478158b1b68eba312f-e-9" label="Low Modulus along (001)">
        <attvalues>
          <attvalue for="0" value="Low Modulus along (001)" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="指各向异性材料沿(001)晶向具有较低弹性模量的一种力学特性。在载荷控制条件下，该特性会导致材料在给定应力下产生大应变，进而可能造成较差的疲劳寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-37d0dc95528fe9478158b1b68eba312f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="55" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-37d0dc95528fe9478158b1b68eba312f-e-10" label="Large Strains">
        <attvalues>
          <attvalue for="0" value="Large Strains" />
          <attvalue for="1" value="Mechanical Response" />
          <attvalue for="2" value="一种显著的材料力学形变。在此特指因材料沿(001)方向具有低弹性模量，在载荷控制条件下预期会发生的一种潜在响应，但该响应在实验或模拟中未被实际观测到。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-37d0dc95528fe9478158b1b68eba312f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Large strains&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-37d0dc95528fe9478158b1b68eba312f-e-10&quot;, &quot;chunk-758fdf43c1ef8b578d580aebaef12e05-e-1&quot;]}]" />
          <attvalue for="9" value="55" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-37d0dc95528fe9478158b1b68eba312f-e-11" label="Poor Fatigue Life">
        <attvalues>
          <attvalue for="0" value="Poor Fatigue Life" />
          <attvalue for="1" value="Material Failure Mode" />
          <attvalue for="2" value="一种材料属性，指材料在循环载荷作用下抵抗疲劳破坏的能力较低。在特定条件下，它被视为由大应变引起的预期后果，但这一因果关系尚未得到实际观察的证实。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-37d0dc95528fe9478158b1b68eba312f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Poor fatigue life&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-37d0dc95528fe9478158b1b68eba312f-e-11&quot;, &quot;chunk-758fdf43c1ef8b578d580aebaef12e05-e-2&quot;]}]" />
          <attvalue for="9" value="55" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-758fdf43c1ef8b578d580aebaef12e05-e-4" label="Larger flow stress">
        <attvalues>
          <attvalue for="0" value="Larger flow stress" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="流动应力是一种材料属性，指维持材料持续发生塑性变形所需的应力。它表征了材料抵抗塑性变形的能力，是在载荷控制条件下进行材料设计与失效分析时所依赖的关键性能指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-758fdf43c1ef8b578d580aebaef12e05" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="55" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-758fdf43c1ef8b578d580aebaef12e05-e-5" label="Stress concentrations">
        <attvalues>
          <attvalue for="0" value="Stress concentrations" />
          <attvalue for="1" value="Mechanical Phenomenon" />
          <attvalue for="2" value="一种力学现象，指构件在孔洞、缺口等几何不连续处，产生局部应力远高于名义应力的现象。该区域的行为呈应变控制特征，是材料疲劳和断裂的常见诱因，从而限制了构件的使用寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-758fdf43c1ef8b578d580aebaef12e05" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-758fdf43c1ef8b578d580aebaef12e05-e-5&quot;]}]" />
          <attvalue for="9" value="168" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-758fdf43c1ef8b578d580aebaef12e05-e-6" label="Strain-controlled manner">
        <attvalues>
          <attvalue for="0" value="Strain-controlled manner" />
          <attvalue for="1" value="Behavior Mode" />
          <attvalue for="2" value="一种材料行为模式，常见于应力集中区域。其核心特征是材料的响应（如疲劳、断裂）主要由局部应变而非名义应力所主导和控制。在这种模式下，应变是决定材料行为的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-758fdf43c1ef8b578d580aebaef12e05" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="168" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-758fdf43c1ef8b578d580aebaef12e05-e-7" label="LCF conditions">
        <attvalues>
          <attvalue for="0" value="LCF conditions" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="LCF conditions（低周疲劳条件）指用于研究材料在低循环次数下疲劳行为的一系列特定实验参数。这些参数通常包括应力或应变幅、温度、加载频率及环境介质。它们旨在模拟构件在服役中承受高应力、导致塑性变形的工况，以评估材料的疲劳寿命和失效机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-758fdf43c1ef8b578d580aebaef12e05" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-758fdf43c1ef8b578d580aebaef12e05-e-7&quot;, &quot;chunk-d8d142dae6b416fb1b1609254612e5f8-e-9&quot;, &quot;chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd-e-2&quot;, &quot;chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6-e-4&quot;, &quot;chunk-8a91b63add4adbc77d4752d41b7c75aa-e-15&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-758fdf43c1ef8b578d580aebaef12e05-e-8" label="Cyclic stress-strain hysteresis loops">
        <attvalues>
          <attvalue for="0" value="Cyclic stress-strain hysteresis loops" />
          <attvalue for="1" value="Analysis Tool" />
          <attvalue for="2" value="循环应力-应变滞回环是一种描述材料在循环加载下应力与应变关系的闭合曲线。它直观地展示了材料的塑性变形、循环硬化/软化和能量耗散等特性，是进行低周疲劳（LCF）分析和寿命预测的关键分析工具。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-758fdf43c1ef8b578d580aebaef12e05" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;clic stress-strain hysteresis loops&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-758fdf43c1ef8b578d580aebaef12e05-e-8&quot;, &quot;chunk-cb879cea8d9305d2839ed19ac4d974e2-e-1&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-cb879cea8d9305d2839ed19ac4d974e2-e-2" label="inelastic strains">
        <attvalues>
          <attvalue for="0" value="inelastic strains" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="非弹性应变是一种力学性能，指材料在外力移除后无法恢复的永久变形。它是导致循环应力-应变滞后回线和能量耗散的根本原因。当材料（尤其是在其最刚硬的取向）承受高负载时，会产生显著的非弹性应变。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-cb879cea8d9305d2839ed19ac4d974e2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cb879cea8d9305d2839ed19ac4d974e2-e-2&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cb879cea8d9305d2839ed19ac4d974e2-e-3" label="stiffest orientations">
        <attvalues>
          <attvalue for="0" value="stiffest orientations" />
          <attvalue for="1" value="Material Condition" />
          <attvalue for="2" value="一种材料状态，指材料内部因加工过程中经受了大的非弹性应变，从而形成特定晶体学取向（织构），使其在这些方向上表现出最高的刚度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-cb879cea8d9305d2839ed19ac4d974e2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cb879cea8d9305d2839ed19ac4d974e2-e-4" label="tension-compression yield stress">
        <attvalues>
          <attvalue for="0" value="tension-compression yield stress" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="一种力学性能，指材料在循环拉伸-压缩加载过程中，开始发生塑性变形的临界应力值。该值通常从应力-应变滞回环中确定，其在拉伸与压缩方向的数值可能因包辛格效应等而不同。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-cb879cea8d9305d2839ed19ac4d974e2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cb879cea8d9305d2839ed19ac4d974e2-e-5" label="Figure 3.73 [71]">
        <attvalues>
          <attvalue for="0" value="Figure 3.73 [71]" />
          <attvalue for="1" value="Reference" />
          <attvalue for="2" value="来源于参考文献[71]的图3.73。该图作为一个示例，图示了在应力比R=0的特定条件下，材料所表现出的循环应力-应变滞回环形态。" />
          <attvalue for="3" value="{&quot;case&quot;: &quot;R = 0&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-cb879cea8d9305d2839ed19ac4d974e2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a9ad9aeb95679c1b6ce38d6cb0b1220f-e-1" label="turbine disc alloys">
        <attvalues>
          <attvalue for="0" value="turbine disc alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="涡轮盘合金是用于制造燃气轮机等发动机核心旋转部件（涡轮盘）的一类高性能材料。它们通常是镍基或钛基高温合金，需经过复杂的加工工艺，以获得在极端高温和应力下所需的高强度、抗蠕变和抗疲劳性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-a9ad9aeb95679c1b6ce38d6cb0b1220f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a9ad9aeb95679c1b6ce38d6cb0b1220f-e-2" label="Processing">
        <attvalues>
          <attvalue for="0" value="Processing" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种在加工过程中维持液态熔池（molten zone）尺寸与形状恒定的制造或处理工艺。该工艺主要应用于涡轮盘合金等先进材料的生产与改性，通过精确控制熔融状态来确保材料的均匀性和最终性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a9ad9aeb95679c1b6ce38d6cb0b1220f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a9ad9aeb95679c1b6ce38d6cb0b1220f-e-3" label="computerised control">
        <attvalues>
          <attvalue for="0" value="computerised control" />
          <attvalue for="1" value="Control System" />
          <attvalue for="2" value="一种基于计算机的自动化控制系统。它通过执行预设程序和处理实时数据，对特定工业过程或参数（如熔化速率）进行精确监控和调节，以实现高效、稳定的自动化管理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a9ad9aeb95679c1b6ce38d6cb0b1220f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="169" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a9ad9aeb95679c1b6ce38d6cb0b1220f-e-4" label="melt rate">
        <attvalues>
          <attvalue for="0" value="melt rate" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="一项关键工艺参数，指单位时间内电极熔化的速率。该速率通常由计算机化系统进行精确控制，对于保障焊接、增材制造等过程的稳定性与最终产品质量至关重要。" />
          <attvalue for="3" value="{&quot;typical_range&quot;: &quot;2-6 kg/min&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a9ad9aeb95679c1b6ce38d6cb0b1220f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="169" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a9ad9aeb95679c1b6ce38d6cb0b1220f-e-5" label="electrode">
        <attvalues>
          <attvalue for="0" value="electrode" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="在特种冶金（如电渣重熔）工艺中，作为可消耗原材料的一种金属或合金部件。它既是导电体，又是在熔炼过程中被逐渐熔化，并最终凝固形成高纯度铸锭的材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a9ad9aeb95679c1b6ce38d6cb0b1220f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a9ad9aeb95679c1b6ce38d6cb0b1220f-e-5&quot;, &quot;chunk-914e8f4139d78791da0d0b73531cfbc5-e-5&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a9ad9aeb95679c1b6ce38d6cb0b1220f-e-6" label="liquid pool">
        <attvalues>
          <attvalue for="0" value="liquid pool" />
          <attvalue for="1" value="Material Zone" />
          <attvalue for="2" value="由电极熔化产生、并位于已凝固材料之上的熔融区域。在加工过程中，其尺寸和形状近似保持恒定，形成一个动态稳定的熔池。" />
          <attvalue for="3" value="{&quot;size_and_shape_stability&quot;: &quot;approximately constant during processing&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a9ad9aeb95679c1b6ce38d6cb0b1220f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a9ad9aeb95679c1b6ce38d6cb0b1220f-e-7" label="solidified material">
        <attvalues>
          <attvalue for="0" value="solidified material" />
          <attvalue for="1" value="Material Zone" />
          <attvalue for="2" value="指在熔化与凝固过程中，位于液态熔池（liquid pool）下方并为其提供支撑的、已经完成凝固的固态材料区域。它通常是先前凝固的同种或异种材料，作为后续工艺的基底。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a9ad9aeb95679c1b6ce38d6cb0b1220f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6d1754ebfc8f173c80a066a37489efe5-e-2" label="Processing">
        <attvalues>
          <attvalue for="0" value="Processing" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="指在特定上下文中，为达到系统稳定运行状态（稳态）而执行的一系列相互关联的制造步骤或操作。该过程确保了生产的连续性和产品质量的一致性。" />
          <attvalue for="3" value="{&quot;efficiency&quot;: &quot;50-75%&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-6d1754ebfc8f173c80a066a37489efe5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6d1754ebfc8f173c80a066a37489efe5-e-3" label="Steady-state">
        <attvalues>
          <attvalue for="0" value="Steady-state" />
          <attvalue for="1" value="Process Condition" />
          <attvalue for="2" value="稳态是一种工艺条件，指在加工过程中，系统的关键参数（如熔融区的尺寸和形状）不再随时间变化，从而达到一种动态平衡的稳定状态。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-6d1754ebfc8f173c80a066a37489efe5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6d1754ebfc8f173c80a066a37489efe5-e-4" label="Electrode">
        <attvalues>
          <attvalue for="0" value="Electrode" />
          <attvalue for="1" value="Equipment Component" />
          <attvalue for="2" value="一种设备部件，其直径是熔炼或焊接等工艺中的一个关键给定参数。它通常作为消耗性材料，为熔融区提供能量或物质，其消耗或位置直接关联并影响熔融区的深度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-6d1754ebfc8f173c80a066a37489efe5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6d1754ebfc8f173c80a066a37489efe5-e-5" label="Power Input">
        <attvalues>
          <attvalue for="0" value="Power Input" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="功率输入（Power Input）是一个工艺参数，指电流与施加电压的乘积。作为决定能量大小的关键因素，该参数值直接影响并增加熔融区的深度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-6d1754ebfc8f173c80a066a37489efe5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6d1754ebfc8f173c80a066a37489efe5-e-5&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-6d1754ebfc8f173c80a066a37489efe5-e-6" label="Current">
        <attvalues>
          <attvalue for="0" value="Current" />
          <attvalue for="1" value="Electrical Parameter" />
          <attvalue for="2" value="一项基础电学参数，指在特定位置进入铸锭的电荷流。作为输入功率的关键因子，其大小直接影响铸锭的加热、熔化状态及最终质量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-6d1754ebfc8f173c80a066a37489efe5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6d1754ebfc8f173c80a066a37489efe5-e-7" label="Applied Voltage">
        <attvalues>
          <attvalue for="0" value="Applied Voltage" />
          <attvalue for="1" value="Electrical Parameter" />
          <attvalue for="2" value="一个关键电气参数，指施加于电路、设备或组件两端的电势差。它与电流共同构成输入功率的基本要素，其乘积决定了电路的输入功率大小。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-6d1754ebfc8f173c80a066a37489efe5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6d1754ebfc8f173c80a066a37489efe5-e-8" label="Ingot">
        <attvalues>
          <attvalue for="0" value="Ingot" />
          <attvalue for="1" value="Workpiece" />
          <attvalue for="2" value="一种工件，在加工过程中由模具(Dies)对其施加反复的形变，以获得八角形横截面。此过程包含一个关键步骤，即工件会被送回熔炉(Furnace)中进行再加热，以利于后续的变形处理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-6d1754ebfc8f173c80a066a37489efe5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;ingot&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6d1754ebfc8f173c80a066a37489efe5-e-8&quot;, &quot;chunk-3462692c1f56ef713abc917f570c8aff-e-3&quot;, &quot;chunk-1b93b31e9bac3b7ed440734e8e9845f7-e-1&quot;, &quot;chunk-0b79cef081fe645143c11d92068c62ab-e-1&quot;, &quot;chunk-6c1e5f01b68b0193af6f52382cd9e355-e-1&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="11" />
        </attvalues>
      </node>
      <node id="chunk-6d1754ebfc8f173c80a066a37489efe5-e-9" label="Meniscus">
        <attvalues>
          <attvalue for="0" value="Meniscus" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="在材料熔炼或精炼工艺中，特指铸锭顶部固液两相间的弧形交界面。该界面是电流进入铸锭的通道，其形态对熔池稳定和凝固过程至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-6d1754ebfc8f173c80a066a37489efe5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6d1754ebfc8f173c80a066a37489efe5-e-10" label="Stool">
        <attvalues>
          <attvalue for="0" value="Stool" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="Stool是指在铸锭(Ingot)的冶金或生长过程中，作为电流入口的特定位置。它通常是承载铸锭并为其导入电流的导电基座或底部接触点。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-6d1754ebfc8f173c80a066a37489efe5" />
