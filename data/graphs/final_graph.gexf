        <attvalues>
          <attvalue for="11" value="IS_DEFINED_BY" />
          <attvalue for="12" value="The probability P1 is given by the equation p₁{D} = 1 - (1 - DS/V)^(n_v V)." />
          <attvalue for="13" value="It follows that the probability, P1, of any one inclusion intersecting the free surface is given by&#10;&#10;p₁{D} = 1 - (1 - DS/V)^(n_v V) (4.10)" />
          <attvalue for="14" value="r-4" />
