        <attvalues>
          <attvalue for="11" value="CAN_BURST" />
          <attvalue for="12" value="A surface crack with a length likely in excess of 0.75 mm will burst the disc." />
          <attvalue for="13" value="the length of a surface crack which will burst the disc is usually likely to be in excess of 0.75 mm." />
          <attvalue for="14" value="r-4" />
