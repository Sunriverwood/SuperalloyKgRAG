      <node id="chunk-943094a66cbac0e2815f19cb92f9100a-e-1" label="slip-deposited dislocations">
        <attvalues>
          <attvalue for="0" value="slip-deposited dislocations" />
          <attvalue for="1" value="Crystallographic Defect" />
          <attvalue for="2" value="滑移沉积位错是一种晶体学缺陷，指位错在晶体滑移过程中被沉积下来，并排列成特定的几何结构，通常是相互垂直的位错组。这种通过滑移形成的、有序的位错阵列是其区别于其他位错的关键特征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-943094a66cbac0e2815f19cb92f9100a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-943094a66cbac0e2815f19cb92f9100a-e-2" label="two perpendicular sets of a/2[011] dislocations">
        <attvalues>
          <attvalue for="0" value="two perpendicular sets of a/2[011] dislocations" />
          <attvalue for="1" value="Dislocation Structure" />
          <attvalue for="2" value="一种位错结构，由两组伯格斯矢量为a/2[011]的垂直位错构成。它们由(111)和(11ī)面上的滑移沉积形成，并可相互反应形成沿[100]方向的单一组位错。" />
          <attvalue for="3" value="{&quot;composition&quot;: &quot;a/2[011] dislocations&quot;}" />
          <attvalue for="4" value="e-2" />
