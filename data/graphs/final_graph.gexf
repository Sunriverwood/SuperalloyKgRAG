      <edge source="chunk-8f26cf45a6fdac28f68b7d1e6d3677ff-e-2" target="chunk-8f26cf45a6fdac28f68b7d1e6d3677ff-e-1" id="chunk-8f26cf45a6fdac28f68b7d1e6d3677ff-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CALCULATES" />
          <attvalue for="12" value="The Failure Cycle Equation is provided to calculate No, which is defined as the number of cycles for failure." />
          <attvalue for="13" value="No = 1 / (A(m/2 – 1)Y^m Δσ^m π^(m/2)) * [1 / a_NDI^(m/2-1) - 1 / a_crit^(m/2-1)] where No is the number of cycles for failure." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-8f26cf45a6fdac28f68b7d1e6d3677ff" />
