      <node id="chunk-98004d55693f7f9432c5daf0464e7353-e-1" label="No">
        <attvalues>
          <attvalue for="0" value="No" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="在损伤容限设计领域中，一个代表规定使用寿命（Prescribed Life）的变量。其具体数值由“损伤容限方法”确定，并用以定义一个相关的损伤参数d。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
