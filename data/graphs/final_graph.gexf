        <attvalues>
          <attvalue for="11" value="EXHIBITS" />
          <attvalue for="12" value="The Ni3Al compound exhibits non-stoichiometry, as indicated by its formula Ni3+xAl1-x." />
          <attvalue for="13" value="Studies have indicated that the Ni3Al compound might more accurately be written as Ni3+xAl1-x since non-stoichiometry is always accommodated by anti-site defects..." />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-c8291b746df8607dee394ae506322bb2" />
          <attvalue for="16" value="0.009935710111046171" />
          <attvalue for="17" value="0.27262809273329436" />
        </attvalues>
      </edge>
      <edge source="chunk-1a5bdd6114d60338a6db59595a5e76c4-e-4" target="chunk-2fb89ce2ee9a1401de467999142656eb-e-1" id="chunk-2fb89ce2ee9a1401de467999142656eb-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CAN_BE_WRITTEN_AS" />
          <attvalue for="12" value="The Ni3Al compound can be written with the formula Ni3+xAl1-x to represent its non-stoichiometry." />
          <attvalue for="13" value="y be written as Ni3+xAl1-x since non-stoichiometry is always accommodated by anti-site defects" />
          <attvalue for="14" value="r-1" />
