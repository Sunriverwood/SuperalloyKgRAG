        <attvalues>
          <attvalue for="0" value="Quantitative Calculations" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种基于特定模型的定量计算过程。该过程以确定参数“No”随缺陷尺寸的变化关系为起点，并以此为基础利用该模型执行后续的量化分析与计算。" />
          <attvalue for="3" value="{}" />
