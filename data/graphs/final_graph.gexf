        <attvalues>
          <attvalue for="11" value="DOES_NOT_PREVENT" />
          <attvalue for="12" value="The use of platinum-diffused coatings does not prevent TCP formation from being possible in the bulk material." />
          <attvalue for="13" value="although TCP formation is still possible in the bulk." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-480d57aecb221d6739d918eba055fa57" />
          <attvalue for="16" value="0.00012303149606299212" />
