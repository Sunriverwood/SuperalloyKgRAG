          <attvalue for="12" value="Rhenium (Re) is identified as a PGM." />
          <attvalue for="13" value="Re and Ru are PGMs and are therefore expensive" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-1ad3d9def6416eb2826a0448d6287c6f" />
          <attvalue for="16" value="0.0021426466254052465" />
          <attvalue for="17" value="0.40128558797524316" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-4" target="chunk-070dbf53e1878b9845a3e7782a58ad66-e-9" id="chunk-3d0590efade07af78fea353ef909c7ec-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_USED_AS" />
          <attvalue for="12" value="Rhenium is explicitly identified as an alloying addition." />
          <attvalue for="13" value="rhenium as alloying addition" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-3d0590efade07af78fea353ef909c7ec" />
          <attvalue for="16" value="0.014343255722566063" />
          <attvalue for="17" value="0.40860595343353967" />
