        <attvalues>
          <attvalue for="11" value="CAUSES" />
          <attvalue for="12" value="Thermal gradients are responsible for creating the residual stress field." />
          <attvalue for="13" value="...the thermal gradients responsible for the residual stress field are reduced;" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-523637843506c3574fe003659e8f0b3e" />
          <attvalue for="16" value="0.0003132613992342499" />
