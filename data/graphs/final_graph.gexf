          <attvalue for="6" value="true" />
          <attvalue for="9" value="49" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ab782043d3ae1a90c5f1e5036270c1d8-e-4" label="G. Marijnissen">
        <attvalues>
          <attvalue for="0" value="G. Marijnissen" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="G. Marijnissen是一位研究人员，作为作者之一发表了题为《人字形EB-PVD热障涂层的燃烧器试验台测试》的科学著作。该研究聚焦于材料科学领域中，关于热障涂层的特定测试与评估技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-ab782043d3ae1a90c5f1e5036270c1d8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="49" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ab782043d3ae1a90c5f1e5036270c1d8-e-5" label="Burner rig testing of herringbone EB-PVD thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="Burner rig testing of herringbone EB-PVD thermal barrier coatings" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由 M. F. J. Koolloos 和 G. Marijnissen 合著的学术出版物，发表于《TurboMat会议论文集》。该文研究了采用燃烧器试验台对具有人字形结构、通过电子束物理气相沉积（EB-PVD）方法制备的热障涂层进行的性能测试。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2002&quot;, &quot;pages&quot;: &quot;18–21&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ab782043d3ae1a90c5f1e5036270c1d8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="49" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-ab782043d3ae1a90c5f1e5036270c1d8-e-6" label="Proceedings of TurboMat: International Symposium on Thermal Barrier Coatings and Titanium Aluminides">
        <attvalues>
          <attvalue for="0" value="Proceedings of TurboMat: International Symposium on Thermal Barrier Coatings and Titanium Aluminides" />
          <attvalue for="1" value="Conference Proceeding" />
          <attvalue for="2" value="《TurboMat：热障涂层与钛铝合金国际研讨会论文集》是收录同名国际研讨会学术论文的合集。该论文集专注于热障涂层与钛铝合金领域的研究成果，由德国航空航天中心材料研究所在德国科隆出版。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-ab782043d3ae1a90c5f1e5036270c1d8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="49" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-ab782043d3ae1a90c5f1e5036270c1d8-e-7" label="German Aerospace Center, Institute of Materials Research">
        <attvalues>
          <attvalue for="0" value="German Aerospace Center, Institute of Materials Research" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="德国航空航天中心（DLR）的下属研究所，是德国领先的材料科学研究机构。其研究重点是为航空、航天、能源和交通领域开发高性能材料，如热障涂层和钛铝化物等。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ab782043d3ae1a90c5f1e5036270c1d8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="49" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ab782043d3ae1a90c5f1e5036270c1d8-e-8" label="Cologne">
        <attvalues>
          <attvalue for="0" value="Cologne" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="科隆（德语：Köln）是德国北莱茵-威斯特法伦州最大的城市，坐落于莱茵河畔。它是德国西部重要的历史文化名城、交通枢纽和经济中心，以其哥特式的科隆大教堂闻名于世，该建筑是世界文化遗产。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-ab782043d3ae1a90c5f1e5036270c1d8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="49" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-df56dbe04dca860f9b208ab9b4878418-e-1" label="D. D. Hass">
        <attvalues>
          <attvalue for="0" value="D. D. Hass" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. D. Hass是一位研究人员，作为科学出版物《低热导率气相沉积氧化锆微观结构》的作者之一而知名。该研究主要探讨材料科学领域中，通过气相沉积法制备的氧化锆涂层的热导性能与微观结构的关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-df56dbe04dca860f9b208ab9b4878418" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-df56dbe04dca860f9b208ab9b4878418-e-2" label="A. J. Slifka">
        <attvalues>
          <attvalue for="0" value="A. J. Slifka" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="A. J. Slifka是一位研究人员，作为作者之一撰写了科学论文《低热导率气相沉积氧化锆微观结构》(Low thermal conductivity vapor-deposited zirconia microstructures)，该论文主要研究材料科学领域中氧化锆的导热性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-df56dbe04dca860f9b208ab9b4878418" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-df56dbe04dca860f9b208ab9b4878418-e-3" label="H. N. G. Wadley">
        <attvalues>
          <attvalue for="0" value="H. N. G. Wadley" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="H. N. G. Wadley是一位研究人员，他是学术出版物《Low thermal conductivity vapor-deposited zirconia microstructures》的作者之一。该著作研究了气相沉积氧化锆微结构的低热导率特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-df56dbe04dca860f9b208ab9b4878418" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-df56dbe04dca860f9b208ab9b4878418-e-4" label="Low thermal conductivity vapor-deposited zirconia microstructures">
        <attvalues>
          <attvalue for="0" value="Low thermal conductivity vapor-deposited zirconia microstructures" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由D. D. Hass、A. J. Slifka和H. N. G. Wadley合著的科学论文，发表于《Acta Materialia》期刊。该文研究了通过气相沉积法制备的、具有低热导率特性的氧化锆微观结构。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2001&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-df56dbe04dca860f9b208ab9b4878418" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-df56dbe04dca860f9b208ab9b4878418-e-6" label="Zirconia microstructures">
        <attvalues>
          <attvalue for="0" value="Zirconia microstructures" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种通过气相沉积工艺制备的氧化锆材料。其特殊的微观结构赋予了材料低热导率的特性，使其成为一种优良的隔热材料，常被用作热障涂层。" />
          <attvalue for="3" value="{&quot;property&quot;: &quot;Low thermal conductivity&quot;, &quot;fabrication_method&quot;: &quot;vapor-deposited&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-df56dbe04dca860f9b208ab9b4878418" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-df56dbe04dca860f9b208ab9b4878418-e-7" label="D. K. Gupta">
        <attvalues>
          <attvalue for="0" value="D. K. Gupta" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. K. Gupta是一位材料科学领域的研究者。他作为作者之一，发表了关于“用于单晶高温合金的硅铪改性等离子喷涂MCrAlY涂层”的学术论文，其研究涉及先进防护涂层技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-df56dbe04dca860f9b208ab9b4878418" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-df56dbe04dca860f9b208ab9b4878418-e-8" label="D. S. Duvall">
        <attvalues>
          <attvalue for="0" value="D. S. Duvall" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. S. Duvall 是一名研究人员，他是科学论文《A silicon and hafnium modified plasma sprayed MCrAlY coating for single crystal superalloys》的作者之一，该论文主要研究用于单晶高温合金的涂层技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-df56dbe04dca860f9b208ab9b4878418" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-df56dbe04dca860f9b208ab9b4878418-e-9" label="A silicon and hafnium modified plasma sprayed MCrAlY coating for single crystal superalloys">
        <attvalues>
          <attvalue for="0" value="A silicon and hafnium modified plasma sprayed MCrAlY coating for single crystal superalloys" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由D. K. Gupta与D. S. Duvall合著的科学出版物，发表于《Superalloys》。该文研究了一种经硅和铪改性的等离子喷涂MCrAlY涂层，旨在为单晶高温合金提供高温防护。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-df56dbe04dca860f9b208ab9b4878418" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-df56dbe04dca860f9b208ab9b4878418-e-14" label="Superalloys">
        <attvalues>
          <attvalue for="0" value="Superalloys" />
          <attvalue for="1" value="Book" />
          <attvalue for="2" value="《Superalloys》是一部由M. Gell、C.S. Kortovich、R.H. Bricknell等人共同编辑的学术著作或会议论文集。该书收录了关于高温合金材料（如MCrAlY涂层）的专业研究论文，应与“高温合金”这一材料类别相区分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-df56dbe04dca860f9b208ab9b4878418" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-6eb9964e0070cc2b73d942919084bb21-e-8" label="Development of alloyed and dispersion-strengthened MCrAlY Coatings">
        <attvalues>
          <attvalue for="0" value="Development of alloyed and dispersion-strengthened MCrAlY Coatings" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由T. A. Taylor与D. F. Bettridge合著的科学论文，发表于《Surface and Coatings Technology》期刊。该文主要研究并阐述了合金化与弥散强化MCrAlY涂层的开发技术与过程。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1996&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-6eb9964e0070cc2b73d942919084bb21" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-6eb9964e0070cc2b73d942919084bb21-e-9" label="T. A. Taylor">
        <attvalues>
          <attvalue for="0" value="T. A. Taylor" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="T. A. Taylor是一位材料科学领域的研究人员。其以作者身份发表了科学论文《合金化和弥散强化MCrAlY涂层的开发》(Development of alloyed and dispersion-strengthened MCrAlY Coatings)，该论文专注于研究和改进用于高温防护的MCrAlY（金属-铬-铝-钇）合金涂层技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-6eb9964e0070cc2b73d942919084bb21" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6eb9964e0070cc2b73d942919084bb21-e-10" label="D. F. Bettridge">
        <attvalues>
          <attvalue for="0" value="D. F. Bettridge" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. F. Bettridge是一位研究人员，他是关于合金化与弥散强化MCrAlY涂层开发的学术论文《Development of alloyed and dispersion-strengthened MCrAlY Coatings》的作者。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-6eb9964e0070cc2b73d942919084bb21" />
