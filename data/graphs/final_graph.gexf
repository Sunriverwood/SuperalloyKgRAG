      <edge source="chunk-bf602d6d22c552a1206d1179123ca1f7-e-5" target="chunk-bf602d6d22c552a1206d1179123ca1f7-e-8" id="chunk-bf602d6d22c552a1206d1179123ca1f7-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_DEFINED_BY" />
          <attvalue for="12" value="The misfit stress (σ₀) is calculated using the misfit strain (εT) as per equation 5.2." />
          <attvalue for="13" value="σ₀ = E||εT/(1 − ν²)" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-bf602d6d22c552a1206d1179123ca1f7" />
