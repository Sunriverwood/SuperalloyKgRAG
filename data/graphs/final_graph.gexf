        <attvalues>
          <attvalue for="11" value="EVALUATES" />
          <attvalue for="12" value="Quantum-mechanical modelling allowed for the evaluation of the activation energies for solute-vacancy exchange (E♭)." />
          <attvalue for="13" value="this has allowed an evaluation of the activation energies for solute-vacancy exchange, denoted E♭, and the vacancy formation energy for a solute-vacancy complex, denoted E(f)X-Va." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-7e95d744723775d720f898b62dc67090" />
          <attvalue for="16" value="1.4736221632773356e-05" />
