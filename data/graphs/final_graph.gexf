      </node>
      <node id="chunk-6f4f79d57f35ab3e77324ff6707d70bf-e-6" label="R. T. Wu">
        <attvalues>
          <attvalue for="0" value="R. T. Wu" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="R. T. Wu是一名学者、研究人员。他作为合著者之一，发表了题为《先进喷气发动机服役后热障涂层部件的降解机理》的学术论文，该研究主要关注航空发动机关键部件的材料失效机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
