        <attvalues>
          <attvalue for="11" value="ARE_PRECURSORS_TO" />
          <attvalue for="12" value="Mechanical factors are precursors to failure." />
          <attvalue for="13" value="there is a need to identify and quantify the chemical and mechanical factors which are the precursors to failure." />
