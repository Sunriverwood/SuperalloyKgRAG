        <attvalues>
          <attvalue for="11" value="IS_A_FACTOR_IN" />
          <attvalue for="12" value="The fatigue crack propagation rate is an important factor when using the damage-tolerant method for life assessment." />
          <attvalue for="13" value="this is important if the damage-tolerant method for life assessment is being used (see Section 4.3)" />
          <attvalue for="14" value="r-3" />
