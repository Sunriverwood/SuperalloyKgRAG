          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ae682ac4e4eb339bd48233482011cdd1-e-10" label="Nimonic 115">
        <attvalues>
          <attvalue for="0" value="Nimonic 115" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="Nimonic 115 是一种镍基高温合金，为 Nimonic 合金家族的成员。它以优异的高温强度、抗蠕变和耐腐蚀性能而著称，通常通过时效硬化处理以增强性能，主要用于制造航空发动机和燃气轮机中的涡轮叶片等关键高温部件。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;48, 99, 101, 161, 239&quot;}" />
