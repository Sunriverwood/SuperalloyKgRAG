          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="一个特定的测试条件，指用于评估镍基高温合金‘Udimet 720Li’性能表现的实验温度。" />
          <attvalue for="3" value="{&quot;parameter&quot;: &quot;temperature&quot;}" />
