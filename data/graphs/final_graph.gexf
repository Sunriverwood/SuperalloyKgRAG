        <attvalues>
          <attvalue for="0" value="Kevin Hemker" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="凯文·J·亨克（Kevin J. Hemker），美国材料科学家，现任约翰斯·霍普金斯大学机械工程系Alonzo G. Decker讲席教授。他的研究聚焦于先进材料在极端环境下的力学行为、微观结构表征与性能优化，是该领域的重要学者。" />
          <attvalue for="3" value="{&quot;title&quot;: &quot;Professor&quot;}" />
          <attvalue for="4" value="e-5" />
