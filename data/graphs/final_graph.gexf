        <attvalues>
          <attvalue for="11" value="CALCULATED_FROM" />
          <attvalue for="12" value="Useful work (W) is calculated as the difference between absorbed heat (QAB) and transferred heat (QCD)." />
          <attvalue for="13" value="W = QAB - QCD" />
