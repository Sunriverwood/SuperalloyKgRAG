      <node id="chunk-af1f9e9d18ac9effde532d2b56262cf6-e-1" label="r¹/²">
        <attvalues>
          <attvalue for="0" value="r¹/²" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="r¹/²是一个参数，其数值的增大会导致线性相关性（Linear Dependence）的破坏。一个较大的r¹/²值通常标志着系统或变量间的线性关系趋于瓦解或失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-af1f9e9d18ac9effde532d2b56262cf6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-af1f9e9d18ac9effde532d2b56262cf6-e-2" label="Linear dependence">
        <attvalues>
          <attvalue for="0" value="Linear dependence" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="在材料科学中，指材料的屈服强度与障碍物浓度的平方根（c¹/²）之间存在的线性关系。这种关系在点障碍物近似等简化模型下成立，但在强位错耦合等更复杂的相互作用下会失效或偏离线性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-af1f9e9d18ac9effde532d2b56262cf6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-af1f9e9d18ac9effde532d2b56262cf6-e-3" label="Point obstacle approximation">
        <attvalues>
          <attvalue for="0" value="Point obstacle approximation" />
          <attvalue for="1" value="Model" />
          <attvalue for="2" value="点障碍近似 (Point obstacle approximation) 是一种理论模型，用于描述强化相（如γ'）对位错运动的阻碍作用。该模型将障碍物视为无尺寸的点，并预测出一种线性依赖关系。当γ'相的体积分数过高时，该近似失效，所预测的线性关系也随之破裂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-af1f9e9d18ac9effde532d2b56262cf6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-af1f9e9d18ac9effde532d2b56262cf6-e-4" label="Volume fraction, f, of γ'">
        <attvalues>
          <attvalue for="0" value="Volume fraction, f, of γ'" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="γ'相的关键物理参数，指其在材料总体积中所占的比例，符号为f。该参数的数值是决定“点障碍近似”模型是否适用的重要依据，当其数值较高时，该近似模型不再有效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-af1f9e9d18ac9effde532d2b56262cf6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-2a630be2b8090ec92842cc9c1737eb42-e-3" label="Over-aged condition">
        <attvalues>
          <attvalue for="0" value="Over-aged condition" />
          <attvalue for="1" value="Material State" />
          <attvalue for="2" value="过时效状态（Over-aged condition）是一种材料状态，指在时效热处理过程中，因保温时间过长或温度过高，导致γ'相等强化相粒子发生粗化，从而使材料的强度和硬度从峰值下降的现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-2a630be2b8090ec92842cc9c1737eb42" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Over-aged structures&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-78b756dd65fb78d8b34a959b45292e60-e-6&quot;, &quot;chunk-2a630be2b8090ec92842cc9c1737eb42-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-2a630be2b8090ec92842cc9c1737eb42-e-5" label="Elastic repulsive force (R)">
        <attvalues>
          <attvalue for="0" value="Elastic repulsive force (R)" />
          <attvalue for="1" value="Force" />
          <attvalue for="2" value="弹性排斥力（R）是在材料科学中，由晶体中位错（dislocations）各自的弹性应力场相互作用而产生的一种物理力。该力阻碍位错彼此靠近，形成运动势垒，其大小是决定强耦合位错行为的关键因素，必须被克服才能使位错继续运动。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2a630be2b8090ec92842cc9c1737eb42" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Elastic force, R&quot;, &quot;Repulsive Force (R)&quot;, &quot;elastic repulsive force&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ac23817ca85b5e2cba9cb1da3a1960fc-e-9&quot;, &quot;chunk-a478184a271f81c44b621f35badc5f0a-e-2&quot;, &quot;chunk-2a630be2b8090ec92842cc9c1737eb42-e-5&quot;, &quot;chunk-02948169a54de26c861e1fa5741b30de-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-02948169a54de26c861e1fa5741b30de-e-6" label="Equations (2.23a) and (2.23b)">
        <attvalues>
          <attvalue for="0" value="Equations (2.23a) and (2.23b)" />
          <attvalue for="1" value="Mathematical Equation" />
          <attvalue for="2" value="一个编号为(2.23a)和(2.23b)的数学方程组。在特定理论或计算框架下，通过数学变换与推导，该方程组可以得出方程(2.30a)的结果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-02948169a54de26c861e1fa5741b30de" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="254" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-02948169a54de26c861e1fa5741b30de-e-7" label="Equation (2.30a)">
        <attvalues>
          <attvalue for="0" value="Equation (2.30a)" />
          <attvalue for="1" value="Mathematical Equation" />
          <attvalue for="2" value="一个记为(2.30a)的数学方程，其表达式为 2τbL + (F₁ + F₂) = 0。该方程由方程(2.23a)和(2.23b)推导得出。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;2τbL + (F₁ + F₂) = 0&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-02948169a54de26c861e1fa5741b30de" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-02948169a54de26c861e1fa5741b30de-e-7&quot;]}]" />
          <attvalue for="9" value="254" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-171c1deb2bffaad5a637104b101eb41f-e-1" label="τ">
        <attvalues>
          <attvalue for="0" value="τ" />
          <attvalue for="1" value="Shear Stress" />
          <attvalue for="2" value="τ是一种剪应力，其值由公式 τ = −½(F₁ + F₂)/(bL) 计算得出。它是一个派生物理量，其大小是综合了变量 F₁、F₂、b 和 L 的一个函数。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;−½(F₁ + F₂)/(bL)&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-171c1deb2bffaad5a637104b101eb41f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-171c1deb2bffaad5a637104b101eb41f-e-2" label="F₁ (pinning force on first dislocation)">
        <attvalues>
          <attvalue for="0" value="F₁ (pinning force on first dislocation)" />
          <attvalue for="1" value="Force" />
          <attvalue for="2" value="F₁ (力): 材料科学中，指位错线因绕过颗粒障碍物发生弯曲而产生的线张力。该力的大小与位错线长度(l{x})和颗粒半径(R)相关，是计算材料临界剪切应力(τ)以评估颗粒强化效应的关键物理量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-171c1deb2bffaad5a637104b101eb41f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;F₁&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a478184a271f81c44b621f35badc5f0a-e-9&quot;, &quot;chunk-171c1deb2bffaad5a637104b101eb41f-e-2&quot;, &quot;chunk-bc7ac356d3b96aa45f10f8864536d6bf-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-171c1deb2bffaad5a637104b101eb41f-e-3" label="F₂ (pinning force on second dislocation)">
        <attvalues>
          <attvalue for="0" value="F₂ (pinning force on second dislocation)" />
          <attvalue for="1" value="Force" />
          <attvalue for="2" value="F₂是一种与材料微观结构相关的力，其大小取决于颗粒内部位错线的长度l{x}。它被用于计算剪切应力τ，并通过特定方程与另一作用力F₁及变量R（如颗粒半径）相关联，是描述位错与颗粒相互作用的关键物理量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-171c1deb2bffaad5a637104b101eb41f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;F₂&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a478184a271f81c44b621f35badc5f0a-e-10&quot;, &quot;chunk-171c1deb2bffaad5a637104b101eb41f-e-3&quot;, &quot;chunk-bc7ac356d3b96aa45f10f8864536d6bf-e-4&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-171c1deb2bffaad5a637104b101eb41f-e-4" label="l{x}">
        <attvalues>
          <attvalue for="0" value="l{x}" />
          <attvalue for="1" value="Dislocation Line Length" />
          <attvalue for="2" value="`l{x}`：指颗粒内部的位错线长度，该长度是位错穿透距离x的函数。它作为位错的一个关键几何属性，是计算其他物理量（如力F₁、F₂）的基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-171c1deb2bffaad5a637104b101eb41f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-171c1deb2bffaad5a637104b101eb41f-e-7" label="x">
        <attvalues>
          <attvalue for="0" value="x" />
          <attvalue for="1" value="Distance" />
          <attvalue for="2" value="一个表示粒子穿透能力的距离物理量。它指粒子从进入介质的入射点起，沿直线穿行至停止点或作用点的深度，是描述粒子与物质相互作用过程中的一个基本参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-171c1deb2bffaad5a637104b101eb41f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-171c1deb2bffaad5a637104b101eb41f-e-8" label="R">
        <attvalues>
          <attvalue for="0" value="R" />
          <attvalue for="1" value="Force" />
          <attvalue for="2" value="R 是一个在方程 (2.30b) 中定义的力项，其值通过该方程与另外两个力 F₁ 和 F₂ 建立数学关联。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-171c1deb2bffaad5a637104b101eb41f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-171c1deb2bffaad5a637104b101eb41f-e-9" label="b">
        <attvalues>
          <attvalue for="0" value="b" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="参数b是一个用于计算剪应力τ的物理参数。在相关计算公式中，它位于分母位置，其数值与剪应力的大小成反比关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-171c1deb2bffaad5a637104b101eb41f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-171c1deb2bffaad5a637104b101eb41f-e-10" label="L">
        <attvalues>
          <attvalue for="0" value="L" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="L是一个用于计算剪应力(τ)的长度参数。在剪应力计算公式中，该参数位于分母，其数值大小与剪应力成反比关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-171c1deb2bffaad5a637104b101eb41f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bc7ac356d3b96aa45f10f8864536d6bf-e-1" label="l{x}">
        <attvalues>
          <attvalue for="0" value="l{x}" />
          <attvalue for="1" value="Function" />
          <attvalue for="2" value="l{x}是一个源于初等几何的数学函数，用于描述和计算在粒子相互作用过程中定义的某一特定长度。该函数将粒子系统的某个变量（x）映射为一个具有物理意义的长度值。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;2(2rx − x²)¹/²&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-bc7ac356d3b96aa45f10f8864536d6bf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bc7ac356d3b96aa45f10f8864536d6bf-e-5" label="Force-distance plots">
        <attvalues>
          <attvalue for="0" value="Force-distance plots" />
          <attvalue for="1" value="Diagram" />
          <attvalue for="2" value="力-距离图是一种以距离为横轴、力的大小为纵轴的图表。它用于直观展示合力随距离的变化行为，并可用于分析或确认其最大值等关键特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-bc7ac356d3b96aa45f10f8864536d6bf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bc7ac356d3b96aa45f10f8864536d6bf-e-6" label="(F₁ + F₂)">
        <attvalues>
          <attvalue for="0" value="(F₁ + F₂)" />
          <attvalue for="1" value="Force Sum" />
          <attvalue for="2" value="(F₁ + F₂) 指力 F₁ 与 F₂ 的矢量和。在特定物理条件下，该合力会达到一个最大值，这一极值状态由拖曳位错（Trailing dislocation）所引发，并且可以通过力-距离图（Force-distance plots）进行观测和确认。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-bc7ac356d3b96aa45f10f8864536d6bf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-bc7ac356d3b96aa45f10f8864536d6bf-e-9" label="xm">
        <attvalues>
          <attvalue for="0" value="xm" />
          <attvalue for="1" value="Position" />
          <attvalue for="2" value="`xm` 是一个位置参数，用于定义前沿位错（Leading dislocation）在所受总力达到最大值时所处的特定空间坐标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-bc7ac356d3b96aa45f10f8864536d6bf" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bc7ac356d3b96aa45f10f8864536d6bf-e-9&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bc7ac356d3b96aa45f10f8864536d6bf-e-10" label="Equations (2.30a) and (2.30b)">
        <attvalues>
          <attvalue for="0" value="Equations (2.30a) and (2.30b)" />
          <attvalue for="1" value="Mathematical Model" />
          <attvalue for="2" value="一个数学模型，代表一组在特定条件 F₂ = 0 的情况下，由更普适的方程组简化而来的方程。该模型具体表达为 2τbL = −F₁{xm} = γAPBl{xm}。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-bc7ac356d3b96aa45f10f8864536d6bf" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bc7ac356d3b96aa45f10f8864536d6bf-e-10&quot;, &quot;chunk-79f5ca3c2c1d10a28f29d15836a7774d-e-2&quot;]}]" />
          <attvalue for="9" value="134" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-bc7ac356d3b96aa45f10f8864536d6bf-e-11" label="2τbL = −F₁{xm} = γAPBl{xm}">
        <attvalues>
          <attvalue for="0" value="2τbL = −F₁{xm} = γAPBl{xm}" />
          <attvalue for="1" value="Reduced Equation" />
          <attvalue for="2" value="方程(2.31)是一个由方程(2.30a)和(2.30b)简化得到的数学方程。其表达式为 2τbL = −F₁{xm} = γAPBl{xm} = 2R，该公式确立了多个物理量或变量之间的等价关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-bc7ac356d3b96aa45f10f8864536d6bf" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Equation (2.31)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bc7ac356d3b96aa45f10f8864536d6bf-e-11&quot;, &quot;chunk-79f5ca3c2c1d10a28f29d15836a7774d-e-3&quot;]}]" />
          <attvalue for="9" value="134" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-79f5ca3c2c1d10a28f29d15836a7774d-e-1" label="F₂">
        <attvalues>
          <attvalue for="0" value="F₂" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="F₂是一个分力变量。在特定分析中，其值被设为零，这是应用方程(2.30a)和(2.30b)的必要条件。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;0&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-79f5ca3c2c1d10a28f29d15836a7774d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="134" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-79f5ca3c2c1d10a28f29d15836a7774d-e-4" label="R">
        <attvalues>
          <attvalue for="0" value="R" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="在位错理论中，R是一个变量，指作用于两个同号位错间的排斥力大小。该力的大小决定了材料的临界剪应力τ，其数值可通过公式 Gb²/(2πxm) 近似估算。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-79f5ca3c2c1d10a28f29d15836a7774d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-79f5ca3c2c1d10a28f29d15836a7774d-e-5" label="τ">
        <attvalues>
          <attvalue for="0" value="τ" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="τ是代表临界剪切应力的变量，指颗粒发生剪切所需达到的应力阈值。当作用于颗粒的应力达到此值时，剪切过程便会启动。其具体数值由R等系统参数决定，是衡量颗粒系统抵抗剪切变形能力的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-79f5ca3c2c1d10a28f29d15836a7774d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-79f5ca3c2c1d10a28f29d15836a7774d-e-5&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-79f5ca3c2c1d10a28f29d15836a7774d-e-6" label="Particle shearing (granular materials)">
        <attvalues>
          <attvalue for="0" value="Particle shearing (granular materials)" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="一种物理过程，指在颗粒材料（如粉末、悬浮液）中，只有当施加的剪应力(τ)超过某一临界值时，颗粒间才会发生相对滑移并产生宏观流动。低于该临界值，材料则抵抗剪切变形。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-79f5ca3c2c1d10a28f29d15836a7774d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Particle shearing&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-79f5ca3c2c1d10a28f29d15836a7774d-e-6&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-79f5ca3c2c1d10a28f29d15836a7774d-e-7" label="Dislocation theory">
        <attvalues>
          <attvalue for="0" value="Dislocation theory" />
          <attvalue for="1" value="Scientific Theory" />
          <attvalue for="2" value="位错理论是材料科学与固体物理学的核心理论。它通过描述晶体材料中一类名为“位错”的线缺陷的运动、增殖及相互作用，来解释晶体的塑性形变、强化和断裂等力学行为，并可用于估算位错间的相互作用力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-79f5ca3c2c1d10a28f29d15836a7774d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-79f5ca3c2c1d10a28f29d15836a7774d-e-8" label="Two dislocations of the same sign">
        <attvalues>
          <attvalue for="0" value="Two dislocations of the same sign" />
          <attvalue for="1" value="Physical Concept" />
          <attvalue for="2" value="一种晶体缺陷，指一组柏氏矢量方向相同的位错。由于应力场相互叠加，它们之间会产生排斥作用。这种相互作用的强度可通过单位长度的相互作用能来描述，并取决于位错间的距离（如xm）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-79f5ca3c2c1d10a28f29d15836a7774d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Dislocations&quot;, &quot;Dislocations of the same sign&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-79f5ca3c2c1d10a28f29d15836a7774d-e-8&quot;, &quot;chunk-1a99c3b4586a66f5a28ddb8f55295b0d-e-2&quot;, &quot;chunk-ac23817ca85b5e2cba9cb1da3a1960fc-e-6&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-79f5ca3c2c1d10a28f29d15836a7774d-e-9" label="xm">
        <attvalues>
          <attvalue for="0" value="xm" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="在材料科学中，`xm` 是一个物理符号，定义为两个同号位错（一种晶体缺陷）之间的分离距离。由于同号位错之间存在相互排斥力，该距离是分析位错相互作用、稳定构型及其对材料力学性能影响的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-79f5ca3c2c1d10a28f29d15836a7774d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-79f5ca3c2c1d10a28f29d15836a7774d-e-9&quot;, &quot;chunk-1a99c3b4586a66f5a28ddb8f55295b0d-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-79f5ca3c2c1d10a28f29d15836a7774d-e-10" label="Gb²/(2πxm)">
        <attvalues>
          <attvalue for="0" value="Gb²/(2πxm)" />
          <attvalue for="1" value="Mathematical Formula" />
          <attvalue for="2" value="在材料科学中，用于近似计算两个平行的、同符号位错之间单位长度排斥力的公式。式中G为剪切模量，b为柏格斯矢量模，x为位错间距，m是取决于位错类型和材料性质（如泊松比）的系数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-79f5ca3c2c1d10a28f29d15836a7774d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1a99c3b4586a66f5a28ddb8f55295b0d-e-1" label="Interaction Energy per unit length">
        <attvalues>
          <attvalue for="0" value="Interaction Energy per unit length" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="一个物理量，指符号相同的两条位错之间，沿位错线单位长度上所具有的相互作用能。该能量源于位错应力场的叠加，是导致同号位错相互排斥的势能。" />
          <attvalue for="3" value="{&quot;approximation&quot;: &quot;Gb²/(2πxm)&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-1a99c3b4586a66f5a28ddb8f55295b0d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1a99c3b4586a66f5a28ddb8f55295b0d-e-4" label="w">
        <attvalues>
          <attvalue for="0" value="w" />
          <attvalue for="1" value="Dimensionless Constant" />
          <attvalue for="2" value="w是一个为处理和量化微小不确定性而引入的无量纲常数。它通常在模型或计算中充当修正或权重因子，以提高结果的准确性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1a99c3b4586a66f5a28ddb8f55295b0d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="255" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1a99c3b4586a66f5a28ddb8f55295b0d-e-5" label="Small uncertainties">
        <attvalues>
          <attvalue for="0" value="Small uncertainties" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="在特定模型或公式中，通过引入无量纲常数‘w’来进行统一考量或修正的一系列微小的不确定性因素。它代表了那些难以单独建模但对整体结果有影响的次要变量或误差。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1a99c3b4586a66f5a28ddb8f55295b0d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="255" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a00605aad03a48315b6372d73ae11d54-e-4" label="chunk-a00605aad03a48315b6372d73ae11d54-e-4">
        <attvalues>
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
