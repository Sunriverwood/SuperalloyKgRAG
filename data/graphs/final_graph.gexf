      <node id="chunk-cb57093a6357773efc0ab02b57f76fa1-e-28" label="Wright-Patterson Air Force Base">
        <attvalues>
          <attvalue for="0" value="Wright-Patterson Air Force Base" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="赖特-帕特森空军基地（Wright-Patterson Air Force Base）是美国空军位于俄亥俄州代顿附近的重要基地。它是空军装备司令部总部和空军研究实验室所在地，是美国空军关键的科研、采购与后勤中心。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-28" />
          <attvalue for="5" value="chunk-cb57093a6357773efc0ab02b57f76fa1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Wright-Patterson Air Force&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cb57093a6357773efc0ab02b57f76fa1-e-28&quot;]}]" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8037aec19ea88422e6032e36e14ec0c5-e-7" label="Air Force Research Laboratory (AFRL)">
        <attvalues>
          <attvalue for="0" value="Air Force Research Laboratory (AFRL)" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="美国空军的主要科研机构，通常指美国空军研究实验室(AFRL)位于赖特-帕特森空军基地的总部及核心单位。该组织作为美国空军的科技研发中心，致力于开发先进的航空航天技术，以支持美国的空中和太空力量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-8037aec19ea88422e6032e36e14ec0c5" />
