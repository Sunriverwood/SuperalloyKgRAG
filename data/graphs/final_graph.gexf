        <attvalues>
          <attvalue for="0" value="Manufacturing" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="指将原材料、零部件通过物理或化学方法，大规模加工或组装成可供使用或销售的新产品的工业过程。它是现代工业的核心环节，通常涉及标准化的流程、机械化设备与质量控制，以确保产品的一致性与可靠性。" />
          <attvalue for="3" value="{}" />
