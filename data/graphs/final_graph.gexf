          <attvalue for="9" value="85" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-632d29e490ba842c81dadf45a38731c6-e-9" label="Nickel-base alloy substrates">
        <attvalues>
          <attvalue for="0" value="Nickel-base alloy substrates" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍基合金基底是一种以镍为主要成分的合金基材。因其具备优异的高温强度和抗氧化性能，通常被用作先进热障系统粘结涂层的附着基础，广泛应用于航空发动机、燃气轮机等高温部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-632d29e490ba842c81dadf45a38731c6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="85" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-632d29e490ba842c81dadf45a38731c6-e-10" label="Cobalt-base alloy substrates">
        <attvalues>
          <attvalue for="0" value="Cobalt-base alloy substrates" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种以钴为主要成分的高温合金材料，通常作为航空发动机涡轮叶片等高温部件的基体。其表面用于承载先进热障系统的粘结涂层，以提供优异的隔热和抗氧化性能，从而保护基体免受极端环境的损害。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-632d29e490ba842c81dadf45a38731c6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="85" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-632d29e490ba842c81dadf45a38731c6-e-11" label="Iron-base alloy substrates">
        <attvalues>
          <attvalue for="0" value="Iron-base alloy substrates" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种以铁为主要成分的合金材料。它通常作为基底，用于承载先进热障系统的粘结涂层，为核心部件在高温环境下提供热防护和结构支撑。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-632d29e490ba842c81dadf45a38731c6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-632d29e490ba842c81dadf45a38731c6-e-11&quot;]}]" />
          <attvalue for="9" value="85" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-632d29e490ba842c81dadf45a38731c6-e-13" label="Materials design for the next generation of thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="Materials design for the next generation of thermal barrier coatings" />
          <attvalue for="1" value="Article" />
          <attvalue for="2" value="《Materials design for the next generation of thermal barrier coatings》是一篇由D. R. Clarke与C. G. Levi合著的学术文章。该文系统探讨了下一代热障涂层的材料设计原理与方法，并发表于学术期刊《材料研究年评》(Annual Review of Materials Research)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-632d29e490ba842c81dadf45a38731c6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-632d29e490ba842c81dadf45a38731c6-e-13&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-632d29e490ba842c81dadf45a38731c6-e-14" label="Advanced thermal barrier system bond coatings for use on nickel-, cobalt- and iron-base alloy substrates">
        <attvalues>
          <attvalue for="0" value="Advanced thermal barrier system bond coatings for use on nickel-, cobalt- and iron-base alloy substrates" />
          <attvalue for="1" value="Article" />
          <attvalue for="2" value="一篇由S. Stecura撰写并发表在期刊《薄膜》(Thin Solid Films)上的科学论文。该文研究了用于镍、钴和铁基合金基底的先进热障系统粘合涂层技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-632d29e490ba842c81dadf45a38731c6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-632d29e490ba842c81dadf45a38731c6-e-14&quot;]}]" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-27fe0e6f1cc64567c0f71ef94ca1d008-e-1" label="cobalt- and iron-base alloy substrates">
        <attvalues>
          <attvalue for="0" value="cobalt- and iron-base alloy substrates" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一类以钴（Co）或铁（Fe）为主要成分的合金材料。它们在材料科学与工程中被用作基底或衬底，为在其表面通过物理或化学方法生长和沉积薄膜、涂层等功能性材料提供一个稳定的物理支撑平台。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-27fe0e6f1cc64567c0f71ef94ca1d008" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-27fe0e6f1cc64567c0f71ef94ca1d008-e-1&quot;]}]" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-27fe0e6f1cc64567c0f71ef94ca1d008-e-3" label="S. Alperine">
        <attvalues>
          <attvalue for="0" value="S. Alperine" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="S. Alperine是一位研究人员，与L. Lelait合作研究了等离子喷涂氧化钇部分稳定氧化锆热障涂层（TBC）的微观结构。其相关研究论文发表于美国机械工程师学会（ASME）旗下的《燃气轮机与动力工程学报》期刊上。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-27fe0e6f1cc64567c0f71ef94ca1d008" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-27fe0e6f1cc64567c0f71ef94ca1d008-e-4" label="L. Lelait">
        <attvalues>
          <attvalue for="0" value="L. Lelait" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="L. Lelait是一名材料科学领域的研究人员。他/她作为合著者，与S. Alperine合作发表了关于等离子喷涂氧化钇部分稳定氧化锆热障涂层（TBC）微观结构研究的学术论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-27fe0e6f1cc64567c0f71ef94ca1d008" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-27fe0e6f1cc64567c0f71ef94ca1d008-e-6" label="Transactions ASME: Journal of Engineering for Gas Turbines and Flows">
        <attvalues>
          <attvalue for="0" value="Transactions ASME: Journal of Engineering for Gas Turbines and Flows" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由美国机械工程师学会（ASME）出版的权威学术期刊。该期刊专注于发表燃气轮机、动力系统、航空推进及相关流体工程领域的原创高质量研究成果与技术论文。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;116&quot;, &quot;year&quot;: &quot;1994&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-27fe0e6f1cc64567c0f71ef94ca1d008" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-27fe0e6f1cc64567c0f71ef94ca1d008-e-8" label="J. L. Smialek">
        <attvalues>
          <attvalue for="0" value="J. L. Smialek" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="Co-author of a paper on phase stability in plasma-sprayed partially stabilised zirconia-yttria." />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-27fe0e6f1cc64567c0f71ef94ca1d008" />
