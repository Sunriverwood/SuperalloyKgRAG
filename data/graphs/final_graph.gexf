          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f23caa328479b9d419f0d855b9335eb4-e-3" label="CMSX-6">
        <attvalues>
          <attvalue for="0" value="CMSX-6" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="CMSX-6是一种不含铼（Re）的第一代单晶镍基高温合金。它具有优异的高温强度、抗蠕变性及良好的热稳定性，主要用于制造航空发动机和工业燃气轮机的高压涡轮叶片等在极端温度和应力环境下工作的关键热端部件。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;191, 192&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-f23caa328479b9d419f0d855b9335eb4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f23caa328479b9d419f0d855b9335eb4-e-3&quot;]}]" />
          <attvalue for="9" value="366" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-f23caa328479b9d419f0d855b9335eb4-e-5" label="ΕΡΜ-102">
        <attvalues>
          <attvalue for="0" value="ΕΡΜ-102" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="ΕΡΜ-102是一种锌基压铸合金，属于锌-铝-铜(Zamak)系。该合金具有良好的铸造流动性和机械性能，主要用于通过压铸工艺生产五金件、汽车零部件和装饰品等精密铸件。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;20&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-f23caa328479b9d419f0d855b9335eb4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="367" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-f23caa328479b9d419f0d855b9335eb4-e-9" label="IN706">
        <attvalues>
          <attvalue for="0" value="IN706" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="IN706是一种镍铁铬基沉淀硬化型高温合金。它通过γ'和γ''相沉淀强化，在高温下具有优异的强度、抗蠕变性和良好的加工焊接性。因其出色的综合性能，被广泛用于制造大型陆基燃气轮机的涡轮盘、轴和机匣等关键热端部件。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;34, 239, 241&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-f23caa328479b9d419f0d855b9335eb4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f23caa328479b9d419f0d855b9335eb4-e-9&quot;]}]" />
          <attvalue for="9" value="368" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-f23caa328479b9d419f0d855b9335eb4-e-12" label="IN939">
        <attvalues>
          <attvalue for="0" value="IN939" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="IN939是一种镍基铸造高温合金。它以优异的高温强度、良好的抗热腐蚀性和铸造性能而著称，主要用于制造工业燃气轮机的涡轮叶片和导向叶等在严苛环境下工作的热端部件。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;169, 330&quot;}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-f23caa328479b9d419f0d855b9335eb4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="369" />
          <attvalue for="10" value="0" />
