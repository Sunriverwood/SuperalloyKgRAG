        <attvalues>
          <attvalue for="11" value="PROVIDES" />
          <attvalue for="12" value="The use of the 'first crack' as a conservative basis for calculation provides a further built-in margin of safety." />
          <attvalue for="13" value="Note that the use of the ‘first crack' as the basis for the calculation will be conservative... This provides a further built-in margin of safety." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-5672d8823c0e88aff98a62f9c1f74614" />
