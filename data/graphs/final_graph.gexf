          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-62f2a69b28a3f59402f17b59e67f8707-e-7&quot;]}]" />
          <attvalue for="9" value="119" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-62f2a69b28a3f59402f17b59e67f8707-e-8" label="Grain Boundaries in Metals">
        <attvalues>
          <attvalue for="0" value="Grain Boundaries in Metals" />
          <attvalue for="1" value="Book" />
          <attvalue for="2" value="《金属中的晶界》(Grain Boundaries in Metals) 是由D. 麦克莱恩 (D. McLean) 撰写的一部材料科学专著。该书于1957年由克拉伦登出版社 (Clarendon Press) 出版，是系统论述金属中晶界的结构、性质及其对材料性能影响的经典著作。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1957&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-62f2a69b28a3f59402f17b59e67f8707" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-62f2a69b28a3f59402f17b59e67f8707-e-8&quot;]}]" />
          <attvalue for="9" value="119" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-62f2a69b28a3f59402f17b59e67f8707-e-9" label="Clarendon Press">
        <attvalues>
          <attvalue for="0" value="Clarendon Press" />
          <attvalue for="1" value="Publisher" />
          <attvalue for="2" value="克拉伦登出版社（Clarendon Press）是牛津大学出版社（OUP）旗下历史悠久的学术出版品牌。它以在人文科学、社会科学及自然科学等领域出版高水准、权威性的学术专著而闻名于世。" />
          <attvalue for="3" value="{&quot;location&quot;: &quot;Oxford&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-62f2a69b28a3f59402f17b59e67f8707" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="119" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-62f2a69b28a3f59402f17b59e67f8707-e-10" label="J. G. Smeggil">
        <attvalues>
          <attvalue for="0" value="J. G. Smeggil" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="J. G. Smeggil是一名学者或研究人员。其学术贡献包括作为合著者，发表了题为《A relationship between indigenous impurity elements and protective oxide scale adherence characteristics》的出版物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-62f2a69b28a3f59402f17b59e67f8707" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-62f2a69b28a3f59402f17b59e67f8707-e-11" label="A. W. Funkenbusch">
        <attvalues>
          <attvalue for="0" value="A. W. Funkenbusch" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="A. W. Funkenbusch是一位作者。他作为合著者发表了科技出版物《A relationship between indigenous impurity elements and protective oxide scale adherence characteristics》，该研究探讨了材料中的固有杂质元素与其保护性氧化皮附着特性之间的关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-62f2a69b28a3f59402f17b59e67f8707" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-62f2a69b28a3f59402f17b59e67f8707-e-12" label="N. S. Bornstein">
        <attvalues>
          <attvalue for="0" value="N. S. Bornstein" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="N. S. Bornstein 是一位材料科学领域的研究者。他作为合著者发表了论文《A relationship between indigenous impurity elements and protective oxide scale adherence characteristics》，该研究探讨了材料中的杂质元素对保护性氧化皮附着特性的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-62f2a69b28a3f59402f17b59e67f8707" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-62f2a69b28a3f59402f17b59e67f8707-e-13" label="A relationship between indigenous impurity elements and protective oxide scale adherence characteristics">
        <attvalues>
          <attvalue for="0" value="A relationship between indigenous impurity elements and protective oxide scale adherence characteristics" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一部由J. G. Smeggil、A. W. Funkenbusch和N. S. Bornstein合著的出版物。该著作主要探讨了材料中本土杂质元素与保护性氧化皮附着特性之间的相互关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-62f2a69b28a3f59402f17b59e67f8707" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-62f2a69b28a3f59402f17b59e67f8707-e-14" label="indigenous impurity elements">
        <attvalues>
          <attvalue for="0" value="indigenous impurity elements" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="原生杂质元素指材料基体中天然存在的、非有意添加的微量元素。这些元素的存在与分布，能够显著影响材料表面保护性氧化皮的附着力，进而改变材料的整体防护性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-62f2a69b28a3f59402f17b59e67f8707" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Indigenous impurity elements&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-62f2a69b28a3f59402f17b59e67f8707-e-14&quot;, &quot;chunk-06ba6595cab42702f10c3f20f15fc2ee-e-1&quot;]}]" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-06ba6595cab42702f10c3f20f15fc2ee-e-2" label="Protective oxide scale">
        <attvalues>
          <attvalue for="0" value="Protective oxide scale" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="一种在高温环境下于材料表面形成的致密氧化物层，能够阻止或减缓基体材料的进一步氧化和腐蚀。该层的附着力是其实现保护作用的关键特性，而这种附着力会受到材料内部固有杂质元素的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-06ba6595cab42702f10c3f20f15fc2ee" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-06ba6595cab42702f10c3f20f15fc2ee-e-2&quot;]}]" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-06ba6595cab42702f10c3f20f15fc2ee-e-4" label="T. N. Rhys-Jones">
        <attvalues>
          <attvalue for="0" value="T. N. Rhys-Jones" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="T. N. Rhys-Jones是一位材料科学领域的研究者与作者，其研究专注于表面涂层对材料疲劳行为的影响。他们曾就此主题在科学期刊《表面与涂层技术》（Surface and Coatings Technology）上发表过相关论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-06ba6595cab42702f10c3f20f15fc2ee" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-06ba6595cab42702f10c3f20f15fc2ee-e-5" label="T. P. Cunningham">
        <attvalues>
          <attvalue for="0" value="T. P. Cunningham" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="T. P. Cunningham，一名学者，其研究涉及表面涂层对材料疲劳行为的影响。他曾在该领域的学术期刊《表面与涂层技术》(Surface and Coatings Technology) 上发表相关研究论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-06ba6595cab42702f10c3f20f15fc2ee" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-06ba6595cab42702f10c3f20f15fc2ee-e-6" label="Surface coatings">
        <attvalues>
          <attvalue for="0" value="Surface coatings" />
          <attvalue for="1" value="Material Treatment" />
          <attvalue for="2" value="一种材料处理技术，特指为研究或改善航空发动机材料的疲劳性能，而施加在其表面的功能性涂层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-06ba6595cab42702f10c3f20f15fc2ee" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="218" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-06ba6595cab42702f10c3f20f15fc2ee-e-7" label="Aeroengine materials">
        <attvalues>
          <attvalue for="0" value="Aeroengine materials" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="航空发动机材料是用于制造航空发动机的特种材料。其表面常施加涂层以应对高温、腐蚀等极端环境，而这些涂层会显著影响材料在循环载荷下的疲劳性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-06ba6595cab42702f10c3f20f15fc2ee" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="218" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-06ba6595cab42702f10c3f20f15fc2ee-e-9" label="T. C. Totemeier">
        <attvalues>
          <attvalue for="0" value="T. C. Totemeier" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="T. C. Totemeier是一位作者与材料科学领域的研究人员。他是学术出版物《Isothermal fatigue of an aluminide-coated single-crystal superalloy: part I》的作者，该著作主要研究铝化物涂层单晶高温合金的等温疲劳性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-06ba6595cab42702f10c3f20f15fc2ee" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-06ba6595cab42702f10c3f20f15fc2ee-e-9&quot;, &quot;chunk-b9dbde7895f392734e33f1d55d95cc73-e-1&quot;]}]" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-06ba6595cab42702f10c3f20f15fc2ee-e-10" label="J. E. King">
        <attvalues>
          <attvalue for="0" value="J. E. King" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="J. E. King是一位材料科学领域的研究人员。他/她撰写了题为《Isothermal fatigue of an aluminide-coated single-crystal superalloy: part I》的学术论文，该论文研究了铝化物涂层单晶高温合金的等温疲劳特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-06ba6595cab42702f10c3f20f15fc2ee" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-06ba6595cab42702f10c3f20f15fc2ee-e-10&quot;, &quot;chunk-b9dbde7895f392734e33f1d55d95cc73-e-2&quot;]}]" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-06ba6595cab42702f10c3f20f15fc2ee-e-11" label="Isothermal fatigue">
        <attvalues>
          <attvalue for="0" value="Isothermal fatigue" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="**等温疲劳 (Isothermal Fatigue)**&#10;&#10;一种材料力学性能，指材料在恒定温度下，因承受周期性变化的载荷而发生累积损伤并最终断裂的现象。它是评估在稳定高温环境下工作的构件（如涡轮叶片）寿命和可靠性的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-06ba6595cab42702f10c3f20f15fc2ee" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-06ba6595cab42702f10c3f20f15fc2ee-e-12" label="Aluminide-coated single-crystal">
        <attvalues>
          <attvalue for="0" value="Aluminide-coated single-crystal" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种复合材料，指在单晶（通常为高温合金）基体表面制备了铝化物涂层的材料。该涂层旨在为基体提供高温环境下的抗氧化和抗腐蚀保护，常用于航空发动机涡轮叶片等关键热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-06ba6595cab42702f10c3f20f15fc2ee" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-06ba6595cab42702f10c3f20f15fc2ee-e-12&quot;]}]" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b9dbde7895f392734e33f1d55d95cc73-e-3" label="Isothermal fatigue of an aluminide-coated single-crystal superalloy: part I">
        <attvalues>
          <attvalue for="0" value="Isothermal fatigue of an aluminide-coated single-crystal superalloy: part I" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《铝化物涂层单晶高温合金的等温疲劳：第一部分》是由T. C. Totemeier与J. E. King合著的学术论文，发表于材料学期刊《冶金与材料汇刊》。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1996&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-b9dbde7895f392734e33f1d55d95cc73" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-b9dbde7895f392734e33f1d55d95cc73-e-5" label="G. W. Meetham">
        <attvalues>
          <attvalue for="0" value="G. W. Meetham" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="G. W. Meetham是一位作者，专注于航空燃气涡轮发动机领域。他撰写了关于该领域保护涂层应用的专业出版物《Use of protective coatings in aero gas turbine engines》。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-b9dbde7895f392734e33f1d55d95cc73" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b9dbde7895f392734e33f1d55d95cc73-e-6" label="Use of protective coatings in aero gas turbine engines">
        <attvalues>
          <attvalue for="0" value="Use of protective coatings in aero gas turbine engines" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由G. W. Meetham撰写并发表于《材料科学与技术》（Materials Science and Technology）期刊的学术论文。该文的核心主题是探讨防护涂层在航空燃气涡轮发动机中的具体应用与技术。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1986&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-b9dbde7895f392734e33f1d55d95cc73" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b9dbde7895f392734e33f1d55d95cc73-e-8" label="Y. A. Tamarin">
        <attvalues>
          <attvalue for="0" value="Y. A. Tamarin" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="Y. A. Tamarin是一位材料科学领域的研究人员，其专业方向为涡轮叶片涂层的热机械疲劳性能。他是该领域相关著作《涡轮叶片涂层的热机械疲劳测试》(Thermo-mechanical fatigue tests of coatings for turbine blades) 的作者。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-b9dbde7895f392734e33f1d55d95cc73" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b9dbde7895f392734e33f1d55d95cc73-e-8&quot;, &quot;chunk-413a7900ebed3c0bb042bc07c13cf29f-e-1&quot;]}]" />
          <attvalue for="9" value="35" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b9dbde7895f392734e33f1d55d95cc73-e-9" label="V. G. Sundyrin">
        <attvalues>
          <attvalue for="0" value="V. G. Sundyrin" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="V. G. Sundyrin是一位作者，其专业领域为材料科学与工程。他撰写了题为《Thermo-mechanical fatigue tests of coatings》（涂层的热机械疲劳测试）的出版物，专注于研究涂层材料的疲劳行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-b9dbde7895f392734e33f1d55d95cc73" />
