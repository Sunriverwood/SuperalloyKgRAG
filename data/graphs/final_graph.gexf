          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2b6a04ecc641ed4c1cec1b3e414ec201-e-2&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2b6a04ecc641ed4c1cec1b3e414ec201-e-3" label="Neural network analysis">
        <attvalues>
          <attvalue for="0" value="Neural network analysis" />
          <attvalue for="1" value="Analysis Method" />
          <attvalue for="2" value="一种基于人工神经网络的机器学习分析方法，通过训练模型来识别数据中的复杂模式和关系。在材料科学等领域，它被用于分析多晶高温合金等材料数据，以进行性能预测、确认研究发现。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-2b6a04ecc641ed4c1cec1b3e414ec201" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-99e1c2354bf8364a02d01889797902c8-e-5" label="Neural Network">
        <attvalues>
          <attvalue for="0" value="Neural Network" />
          <attvalue for="1" value="Computational Model" />
          <attvalue for="2" value="一种用于预测材料属性的神经网络计算模型。该模型经训练后预测，更高的钛铝比（Ti/Al ratio）是提升材料强度的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-99e1c2354bf8364a02d01889797902c8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-99e1c2354bf8364a02d01889797902c8-e-6" label="Ti/Al ratio">
        <attvalues>
          <attvalue for="0" value="Ti/Al ratio" />
          <attvalue for="1" value="Material Parameter" />
          <attvalue for="2" value="钛/铝比（Ti/Al ratio）是材料中钛（Ti）与铝（Al）元素的含量比，为一个关键的成分特征，常见于Rene 95和Rene 88DT等镍基高温合金中。该比值的提高能够改善材料的抗疲劳性能，具体表现为在650°C高温下降低其疲劳裂纹扩展速率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-99e1c2354bf8364a02d01889797902c8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-99e1c2354bf8364a02d01889797902c8-e-6&quot;, &quot;chunk-127ccac0bbb9a57ea78fa0e8276b38f5-e-2&quot;, &quot;chunk-6b0fd58b99d0490b98efe29e49c3ef5d-e-3&quot;, &quot;chunk-198cb71263c64f896cad9847f29b39cf-e-5&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-99e1c2354bf8364a02d01889797902c8-e-8" label="Hardening Theories">
        <attvalues>
          <attvalue for="0" value="Hardening Theories" />
          <attvalue for="1" value="Scientific Theory" />
          <attvalue for="2" value="一组解释材料硬化机制的科学理论。该理论体系强调反相畴界（APB）能的关键作用，其观点与神经网络的预测及材料中Ti/Al比率的影响表现出一致性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-99e1c2354bf8364a02d01889797902c8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-99e1c2354bf8364a02d01889797902c8-e-8&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-99e1c2354bf8364a02d01889797902c8-e-10" label="Cobalt">
        <attvalues>
          <attvalue for="0" value="Cobalt" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="钴（Cobalt）是一种化学元素，符号为Co，原子序数为27。它是一种坚硬、有光泽的银灰色铁磁性金属，常用于制造高温合金、锂离子电池、磁性材料和颜料。钴也是维生素B12的核心成分，是生物体必需的微量元素之一。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;Co&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-99e1c2354bf8364a02d01889797902c8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Co&quot;, &quot;Cobalt (Co)&quot;, &quot;cobalt&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-99e1c2354bf8364a02d01889797902c8-e-10&quot;, &quot;chunk-127ccac0bbb9a57ea78fa0e8276b38f5-e-3&quot;, &quot;chunk-58a0b5872320286acd36be7afd8ed1ba-e-5&quot;, &quot;chunk-03e3f6f2736d579e9767469fc63d46a3-e-6&quot;, &quot;chunk-518564762410dd52d42b1aa0d775ef76-e-6&quot;, &quot;chunk-6cc9936949c5f333eaac7910b952ef48-e-8&quot;, &quot;chunk-2fd5876b35a11cace4a36b2cc1865696-e-1&quot;, &quot;chunk-def444476734c5b41ca30b16989718fd-e-5&quot;, &quot;chunk-f7942340b7bda97e3a76f6ceb1d90c75-e-10&quot;, &quot;chunk-1ad3d9def6416eb2826a0448d6287c6f-e-2&quot;, &quot;chunk-5b143324ae92718a4dde1cd69bd72bd2-e-5&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-127ccac0bbb9a57ea78fa0e8276b38f5-e-5" label="Molybdenum">
        <attvalues>
          <attvalue for="0" value="Molybdenum" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="钼（Molybdenum）是一种化学元素，化学符号为Mo，原子序数42。它是一种银白色的过渡金属，熔点和沸点极高，硬度大。钼主要用作钢的合金添加剂，能显著提高钢的强度、硬度和耐腐蚀性。此外，它也是植物和动物所必需的微量营养素之一。" />
          <attvalue for="3" value="{&quot;concentration_increase&quot;: &quot;zero to 20 wt%&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-127ccac0bbb9a57ea78fa0e8276b38f5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Mo&quot;, &quot;molybdenum&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-9&quot;, &quot;chunk-f14b0074e13363327f2213611a99c96e-e-9&quot;, &quot;chunk-60c0ee3413a86135d14081dd80f51aaf-e-1&quot;, &quot;chunk-c66cb4a523402b814bf33ff19d16eb24-e-8&quot;, &quot;chunk-127ccac0bbb9a57ea78fa0e8276b38f5-e-5&quot;, &quot;chunk-6b0fd58b99d0490b98efe29e49c3ef5d-e-1&quot;, &quot;chunk-a8e2ede64fab8f44656d400d86989bf1-e-5&quot;, &quot;chunk-11fd3f8dd428533f2dacdd280d5458c0-e-6&quot;, &quot;chunk-a4fbcaedb1a3455b29f18439a3d53ae7-e-7&quot;, &quot;chunk-def444476734c5b41ca30b16989718fd-e-8&quot;, &quot;chunk-9f8adabfb1010fa4a4528e361c3f5223-e-3&quot;, &quot;chunk-ec1da0ebfe72b58a50620a5a71c6abf7-e-6&quot;, &quot;chunk-8c75d16dc148897cf486c21cbe30e4be-e-9&quot;, &quot;chunk-1410988dfcbd0392c9d01a4bc32fcff9-e-8&quot;, &quot;chunk-951c3bbe670e3cf4f0dc7a8bc55e7730-e-3&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-127ccac0bbb9a57ea78fa0e8276b38f5-e-8" label="RR1000">
        <attvalues>
          <attvalue for="0" value="RR1000" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="RR1000是一种添加了钽(Ta)的粉末盘高温合金。为满足严苛的性能要求，其化学成分的设计受到疲劳裂纹扩展速率(FCP rates)的严格限制，以确保材料在航空发动机等应用中的耐久性与可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-127ccac0bbb9a57ea78fa0e8276b38f5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;RR1000 superalloy&quot;, &quot;Rolls-Royce's RR1000&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-127ccac0bbb9a57ea78fa0e8276b38f5-e-8&quot;, &quot;chunk-6b0fd58b99d0490b98efe29e49c3ef5d-e-2&quot;, &quot;chunk-3031ff2205f827feea0affe73ca7d2ae-e-9&quot;, &quot;chunk-e29ab0c1999b2fd0630fcd1c30c3554b-e-5&quot;, &quot;chunk-ae682ac4e4eb339bd48233482011cdd1-e-23&quot;, &quot;chunk-e3a2ad2f86c91d0494cd03450bd94ade-e-2&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6b0fd58b99d0490b98efe29e49c3ef5d-e-7" label="Hardening theories of Chapter 2">
        <attvalues>
          <attvalue for="0" value="Hardening theories of Chapter 2" />
          <attvalue for="1" value="Scientific Theory" />
          <attvalue for="2" value="一组阐述材料强化机制的科学理论。该理论集的核心观点是，材料的屈服应力与其内部强化相（如位错、析出相等）总量的平方根之间存在线性关系，这一结论与实验观察相符。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-6b0fd58b99d0490b98efe29e49c3ef5d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6b0fd58b99d0490b98efe29e49c3ef5d-e-7&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d9d4e9c6bdfb7df170a8302da4a9bf0c-e-1" label="Alloys with high Ti/Al ratio">
        <attvalues>
          <attvalue for="0" value="Alloys with high Ti/Al ratio" />
          <attvalue for="1" value="Material Group" />
          <attvalue for="2" value="一类钛(Ti)含量远高于铝(Al)含量的合金材料。该材料群组以其优异的机械强度而著称，其性能特点可通过神经网络分析等先进计算方法进行研究和验证。" />
          <attvalue for="3" value="{&quot;Ti/Al ratio&quot;: &quot;high&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-d9d4e9c6bdfb7df170a8302da4a9bf0c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d9d4e9c6bdfb7df170a8302da4a9bf0c-e-1&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d9d4e9c6bdfb7df170a8302da4a9bf0c-e-3" label="Neural network analysis of [17]">
        <attvalues>
          <attvalue for="0" value="Neural network analysis of [17]" />
          <attvalue for="1" value="Analysis" />
          <attvalue for="2" value="一项基于神经网络的分析，其研究对象为高钛铝比（Ti/Al）合金的强度性能。该分析得出的结论与这类合金所表现出的强度特性相符。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d9d4e9c6bdfb7df170a8302da4a9bf0c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-54d9cab0bf8e738ae99d8958ce8cd086-e-4" label="y' solvus">
        <attvalues>
          <attvalue for="0" value="y' solvus" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**γ′相固溶线 (gamma prime solvus)**&#10;&#10;在材料科学中，特指强化相γ′（gamma prime）在加热过程中完全溶解于基体中的临界温度。它是镍基高温合金等材料进行固溶热处理时必须精确控制的关键工艺参数，直接决定了材料最终的显微组织和力学性能。" />
          <attvalue for="3" value="{&quot;temperature_range&quot;: &quot;1050°C - 1200°C&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-54d9cab0bf8e738ae99d8958ce8cd086" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;gamma prime solvus&quot;, &quot;y' solvus temperature&quot;, &quot;γ'-solvus&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-54d9cab0bf8e738ae99d8958ce8cd086-e-4&quot;, &quot;chunk-117357a69dc4feae2bf2578a7ae7467c-e-2&quot;, &quot;chunk-03e3f6f2736d579e9767469fc63d46a3-e-7&quot;, &quot;chunk-f942fb543f3ac01d63fdbc3537940608-e-1&quot;, &quot;chunk-3b4422ce09cd66eaf6abd58690d6f8ef-e-12&quot;, &quot;chunk-502aba15d381acd1fe322927c6f750ed-e-1&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-54d9cab0bf8e738ae99d8958ce8cd086-e-6" label="dislocation motion">
        <attvalues>
          <attvalue for="0" value="dislocation motion" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="**标准化描述:**&#10;位错运动是晶体材料中线状缺陷（位错）在外力作用下于晶格内滑移的过程，是材料塑性变形的主要微观机制。γ'相粒子等晶内障碍物会阻碍其运动，从而显著提高材料的强度和抗蠕变性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-54d9cab0bf8e738ae99d8958ce8cd086" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;dislocation movement&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-54d9cab0bf8e738ae99d8958ce8cd086-e-6&quot;, &quot;chunk-f0829bcd269a8d2dfa4641c4b0e70d30-e-6&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-117357a69dc4feae2bf2578a7ae7467c-e-1" label="Disc alloys">
        <attvalues>
          <attvalue for="0" value="Disc alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="盘用合金（Disc alloys）是一类专用于制造航空发动机和燃气轮机中涡轮盘等关键旋转部件的高性能材料，通常为镍基高温合金。它们在高温高应力环境下工作，其优异的力学性能依赖于通过精密热处理工艺对γ'相等强化相微观结构的精确控制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-117357a69dc4feae2bf2578a7ae7467c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-117357a69dc4feae2bf2578a7ae7467c-e-5" label="Primary γ' precipitates">
        <attvalues>
          <attvalue for="0" value="Primary γ' precipitates" />
          <attvalue for="1" value="Microstructural Phase" />
          <attvalue for="2" value="初生γ'相 (Primary γ' precipitates) 是一种在亚固溶线热处理后未溶解残留的微观结构相。它通过钉扎晶界效应来有效抑制晶粒长大，可通过更高温度的超固溶线热处理使其完全溶解并消除。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-117357a69dc4feae2bf2578a7ae7467c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Primary y'&quot;, &quot;Primary γ' (gamma prime)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-117357a69dc4feae2bf2578a7ae7467c-e-5&quot;, &quot;chunk-0e0767a37495716d0ec698e5b4703122-e-3&quot;, &quot;chunk-27e744dfd57dfdad9eeacf1afe66f2e9-e-3&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-117357a69dc4feae2bf2578a7ae7467c-e-6" label="Grain-pinning effect">
        <attvalues>
          <attvalue for="0" value="Grain-pinning effect" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="钉扎效应是一种材料物理现象，指材料中弥散分布的第二相粒子（如初生γ'相）通过阻碍晶界的迁移，从而有效抑制晶粒长大的作用。该效应对稳定材料在高温下的微观组织和力学性能至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-117357a69dc4feae2bf2578a7ae7467c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Pinning sites&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-117357a69dc4feae2bf2578a7ae7467c-e-6&quot;, &quot;chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f-e-11&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-117357a69dc4feae2bf2578a7ae7467c-e-9" label="y grains">
        <attvalues>
          <attvalue for="0" value="y grains" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="一种金属微观结构特征，指内部弥散分布着晶内二次和三次γ'强化相粒子的γ(gamma)基体相晶粒。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-117357a69dc4feae2bf2578a7ae7467c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-117357a69dc4feae2bf2578a7ae7467c-e-9&quot;, &quot;chunk-b7bfd8f1e9243bc095953814aae07253-e-6&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-117357a69dc4feae2bf2578a7ae7467c-e-10" label="y' phase distribution">
        <attvalues>
          <attvalue for="0" value="y' phase distribution" />
          <attvalue for="1" value="Material Characteristic" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;γ'相分布是指作为主要强化相的γ'相，在材料微观结构中的形态、尺寸、体积分数和空间排布的综合特征。该分布状态直接决定了镍基高温合金等材料的高温强度、蠕变抗力等关键力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-117357a69dc4feae2bf2578a7ae7467c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="294" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-b7bfd8f1e9243bc095953814aae07253-e-3" label="Primary y'">
        <attvalues>
          <attvalue for="0" value="Primary y'" />
          <attvalue for="1" value="Material Phase Particle" />
          <attvalue for="2" value="初生y'相 (Primary y') 是一种存在于高温合金中的y'强化相颗粒。它通常在凝固或高温热处理过程中首先形成，与后续析出的二次或三次y'相相比，其尺寸更粗大，是合金中y'相总体分布的一个重要组成部分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-b7bfd8f1e9243bc095953814aae07253" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b7bfd8f1e9243bc095953814aae07253-e-4" label="Intragranular secondary y' particles">
        <attvalues>
          <attvalue for="0" value="Intragranular secondary y' particles" />
          <attvalue for="1" value="Material Phase Particle" />
          <attvalue for="2" value="一种在γ基体晶粒内部形成的细小沉淀强化相粒子。作为二次析出的γ'相，它与尺寸较大的初生γ'相共同构成γ'相整体的双峰尺寸分布，是决定高温合金性能的关键微观结构之一。" />
          <attvalue for="3" value="{&quot;particle_diameter&quot;: &quot;~100nm&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-b7bfd8f1e9243bc095953814aae07253" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b7bfd8f1e9243bc095953814aae07253-e-5" label="Tertiary γ' particles">
        <attvalues>
          <attvalue for="0" value="Tertiary γ' particles" />
          <attvalue for="1" value="Material Phase Particle" />
          <attvalue for="2" value="三次γ'相粒子是一种弥散分布于γ基体晶粒内部的细小沉淀相。它们是构成γ'相双峰尺寸分布的关键组分，通常对应分布中的细小尺寸端，对材料的强化起重要作用。" />
          <attvalue for="3" value="{&quot;particle_diameter&quot;: &quot;~50 nm&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-b7bfd8f1e9243bc095953814aae07253" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Tertiary y' particles&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b7bfd8f1e9243bc095953814aae07253-e-5&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b7bfd8f1e9243bc095953814aae07253-e-7" label="Bimodal distribution">
        <attvalues>
          <attvalue for="0" value="Bimodal distribution" />
          <attvalue for="1" value="Distribution Property" />
          <attvalue for="2" value="双峰分布是一种具有两个明显峰值（众数）的概率分布，通常表明样本中存在两个不同的子群体。在材料科学中，它是一种典型的分布特性，如γ'相的颗粒分布，由颗粒的形核、长大和粗化等不同动力学过程的相互作用而形成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-b7bfd8f1e9243bc095953814aae07253" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e6cb5398ced000d3d2d4fd852f609957-e-1" label="y' particle nucleation">
        <attvalues>
          <attvalue for="0" value="y' particle nucleation" />
          <attvalue for="1" value="Kinetic Process" />
          <attvalue for="2" value="y' 粒子形核是一种动力学过程，指作为新相变第一步的 y' 粒子初始形成。它是在材料经历热处理时，从过饱和母相中形成稳定晶核的关键阶段。此过程常见于冷却、等温固溶以及时效热处理等工艺中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-e6cb5398ced000d3d2d4fd852f609957" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;y' nucleation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e6cb5398ced000d3d2d4fd852f609957-e-1&quot;, &quot;chunk-8f3b49d954f278e4e921209ef50d8c33-e-6&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-e6cb5398ced000d3d2d4fd852f609957-e-4" label="isothermal solutioning">
        <attvalues>
          <attvalue for="0" value="isothermal solutioning" />
          <attvalue for="1" value="Heat Treatment" />
          <attvalue for="2" value="一种热处理工艺，指在恒定温度下，通过控制材料中γ′强化相的形核、长大及粗化等动力学过程，来调整其微观结构与力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-e6cb5398ced000d3d2d4fd852f609957" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e6cb5398ced000d3d2d4fd852f609957-e-5" label="ageing heat treatments">
        <attvalues>
          <attvalue for="0" value="ageing heat treatments" />
          <attvalue for="1" value="Heat Treatment" />
          <attvalue for="2" value="一种在特定温度下保温一定时间的热处理工艺。它通过控制强化粒子（析出相）在材料基体中的形核、长大与粗化过程，引发时效硬化效应，从而显著提高材料的强度和硬度。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;around 700 °C&quot;, &quot;duration&quot;: &quot;several hours&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e6cb5398ced000d3d2d4fd852f609957" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-e6cb5398ced000d3d2d4fd852f609957-e-6" label="Cooling rate">
        <attvalues>
          <attvalue for="0" value="Cooling rate" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="冷却速率 (Cooling Rates) 是指材料温度随时间下降的速率，一个关键的工艺参数。它直接影响材料的微观结构与化学均匀性，速率降低通常会加剧化学成分偏析（即化学不均匀性）。例如，在电渣重熔(ESR)工艺中，其固有的慢冷却速率是导致化学不均匀性的原因之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e6cb5398ced000d3d2d4fd852f609957" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Cooling Rates&quot;, &quot;cooling rate&quot;, &quot;cooling rates&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c20cadb2415cd2dfc078d894fd496ac4-e-6&quot;, &quot;chunk-e6cb5398ced000d3d2d4fd852f609957-e-6&quot;, &quot;chunk-1af21239034eac9b97020a65cbbdcded-e-2&quot;, &quot;chunk-a9fba026e3b8980c4957dbe16260f585-e-5&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-e6cb5398ced000d3d2d4fd852f609957-e-7" label="equilibrium fraction of γ'">
        <attvalues>
          <attvalue for="0" value="equilibrium fraction of γ'" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="指合金在特定温度下达到热力学平衡时，γ'相所具有的稳定体积分数。该值由合金成分决定，是一个理论上的稳定状态。在实际热处理中，由于受冷却速率等动力学因素的限制，通常难以完全达到该平衡分数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-e6cb5398ced000d3d2d4fd852f609957" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;equilibrium fraction of y'&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e6cb5398ced000d3d2d4fd852f609957-e-7&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e6cb5398ced000d3d2d4fd852f609957-e-8" label="cooling">
        <attvalues>
          <attvalue for="0" value="cooling" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="冷却（Cooling）指降低温度的物理过程。在材料科学中，该过程是影响材料微观结构的关键环节，可在此期间促使特定物相（如y'相）发生形核与长大。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-e6cb5398ced000d3d2d4fd852f609957" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Cooling&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e6cb5398ced000d3d2d4fd852f609957-e-8&quot;, &quot;chunk-8f374054b3af3dbd36329b272a6ab2a1-e-5&quot;, &quot;chunk-1522e93c065590bf976748cff2b67e57-e-1&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-e6cb5398ced000d3d2d4fd852f609957-e-9" label="age-hardening response">
        <attvalues>
          <attvalue for="0" value="age-hardening response" />
          <attvalue for="1" value="Material Response" />
          <attvalue for="2" value="一种材料响应，指合金在时效热处理过程中，因内部析出细小、弥散的强化相粒子，阻碍位错运动，从而使其硬度和强度随时间显著变化的现象。该响应是析出强化或时效强化的核心机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-e6cb5398ced000d3d2d4fd852f609957" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Age-hardening response&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e6cb5398ced000d3d2d4fd852f609957-e-9&quot;, &quot;chunk-c46fd89a11edd99dc16bcf1682764928-e-1&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-c46fd89a11edd99dc16bcf1682764928-e-4" label="Heat treatment">
        <attvalues>
          <attvalue for="0" value="Heat treatment" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种应用于Udimet 720Li高温合金的热处理工艺，在约700°C的温度下进行约30小时。该工艺的一个显著特点是在此条件下不会影响合金中已有的二次γ'颗粒。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;around 700 °C&quot;, &quot;optimal_duration&quot;: &quot;about 30 h&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c46fd89a11edd99dc16bcf1682764928" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c46fd89a11edd99dc16bcf1682764928-e-5" label="Secondary γ' particles">
        <attvalues>
          <attvalue for="0" value="Secondary γ' particles" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="二次γ'相 (Secondary γ' particles) 是一种在镍基高温合金中析出的细小、弥散分布的强化相，通常为Ni₃(Al,Ti)型金属间化合物。其关键特征是在特定的热处理工艺下尺寸和形态能保持稳定，不发生粗化，这对于维持合金持久且优异的高温力学性能至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c46fd89a11edd99dc16bcf1682764928" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c46fd89a11edd99dc16bcf1682764928-e-5&quot;, &quot;chunk-5efed09d54cb5442431710f41fa6ab69-e-1&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-5efed09d54cb5442431710f41fa6ab69-e-4" label="Strength level">
        <attvalues>
          <attvalue for="0" value="Strength level" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="强度水平是特指多晶高温合金的一种关键材料属性，用于衡量其抵抗变形和断裂的能力。该属性的高低主要取决于合金中铝（Al）、钛（Ti）和铌（Nb）等强化元素的浓度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-5efed09d54cb5442431710f41fa6ab69" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Strength levels&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2b6a04ecc641ed4c1cec1b3e414ec201-e-8&quot;, &quot;chunk-5efed09d54cb5442431710f41fa6ab69-e-4&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-5efed09d54cb5442431710f41fa6ab69-e-5" label="Optimum properties">
        <attvalues>
          <attvalue for="0" value="Optimum properties" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;指材料通过精确控制的热处理工艺后，所能达到的最理想的综合性能状态。此状态旨在实现如强度、韧性、硬度等关键特性的最佳组合，以满足特定工程应用的要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-5efed09d54cb5442431710f41fa6ab69" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5efed09d54cb5442431710f41fa6ab69-e-6" label="Absolute static strength">
        <attvalues>
          <attvalue for="0" value="Absolute static strength" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="绝对静态强度是一种材料的机械性能，其数值主要受尺寸在50-100nm范围内的特定微观结构的显著影响。通常，采用较高的固溶温度进行热处理有利于提升此性能，但对其优化会使材料的疲劳性能优化变得复杂，二者存在一定的制约关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-5efed09d54cb5442431710f41fa6ab69" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5efed09d54cb5442431710f41fa6ab69-e-6&quot;, &quot;chunk-0e0767a37495716d0ec698e5b4703122-e-1&quot;, &quot;chunk-e0b75e1db98f5ed18e200239c3a5bcc3-e-1&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-5efed09d54cb5442431710f41fa6ab69-e-7" label="Higher solutioning temperatures">
        <attvalues>
          <attvalue for="0" value="Higher solutioning temperatures" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="较高的固溶温度是一种热处理工艺参数。它指在固溶处理中，为充分溶解合金元素并优化材料性能而设定的一个相对较高的温度值。根据上下文，选择该参数通常是为了获得更优的绝对静强度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-5efed09d54cb5442431710f41fa6ab69" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5efed09d54cb5442431710f41fa6ab69-e-7&quot;, &quot;chunk-0e0767a37495716d0ec698e5b4703122-e-2&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0e0767a37495716d0ec698e5b4703122-e-4" label="y' in the range 50nm to 100 nm">
        <attvalues>
          <attvalue for="0" value="y' in the range 50nm to 100 nm" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="指尺寸在50至100纳米范围内的γ'析出相，是一种关键的微观结构特征。它对材料的绝对静态强度起决定性作用，其体积分数通常与尺寸更大的初生γ'相呈负相关。" />
          <attvalue for="3" value="{&quot;size_range&quot;: &quot;50nm to 100 nm&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0e0767a37495716d0ec698e5b4703122" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0e0767a37495716d0ec698e5b4703122-e-5" label="Fatigue properties">
        <attvalues>
          <attvalue for="0" value="Fatigue properties" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="疲劳性能是一种关键的材料力学属性，指材料在远低于其静强度的循环载荷作用下，抵抗损伤和断裂的能力。其表现受y'相析出物分布等微观结构影响，是静态强度优化设计中必须考虑的复杂因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-0e0767a37495716d0ec698e5b4703122" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0e0767a37495716d0ec698e5b4703122-e-6" label="y' precipitates distribution">
        <attvalues>
          <attvalue for="0" value="y' precipitates distribution" />
          <attvalue for="1" value="Microstructural Characteristic" />
          <attvalue for="2" value="指γ'沉淀相在材料基体中的空间排布、尺寸和形态。作为一种关键的微观结构特征，它通过影响位错运动来强化材料，并显著影响其力学性能，特别是疲劳性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0e0767a37495716d0ec698e5b4703122" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ef72440f70fee44097b994414253b0b4-e-2" label="dwell-time fatigue crack propagation (FCP) rate">
        <attvalues>
          <attvalue for="0" value="dwell-time fatigue crack propagation (FCP) rate" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="驻留疲劳裂纹扩展速率 (dwell-time FCP rate) 是一种材料属性，表征在循环载荷的峰值处包含一段恒定保持时间（驻留）的条件下，疲劳裂纹的扩展速度。该速率通常在Paris区进行测量，其性能受γ'相微观结构等因素影响，可通过超固溶热处理等工艺进行改善。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-ef72440f70fee44097b994414253b0b4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ef72440f70fee44097b994414253b0b4-e-2&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-ef72440f70fee44097b994414253b0b4-e-3" label="Super-solvus heat treatment">
        <attvalues>
          <attvalue for="0" value="Super-solvus heat treatment" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="超固溶热处理（super-solvus heat treatment）是一种在材料固溶线（solvus）以上温度进行的热处理工艺。其目的是完全溶解材料中的特定强化相，以实现组织均匀化或控制晶粒尺寸。该工艺的实现通常得益于一个足够宽的工艺窗口，以避免材料发生熔化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-ef72440f70fee44097b994414253b0b4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Super-solvus heat treatments&quot;, &quot;Super-solvus processing&quot;, &quot;super-solvus heat treatment&quot;, &quot;supersolvus heat treatment&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ef72440f70fee44097b994414253b0b4-e-3&quot;, &quot;chunk-1af21239034eac9b97020a65cbbdcded-e-1&quot;, &quot;chunk-b0fcb2d1e6cc033c9c5417a044b26160-e-7&quot;, &quot;chunk-9c7953b64a6a98e79dd79734f10a7c02-e-6&quot;, &quot;chunk-03e3f6f2736d579e9767469fc63d46a3-e-9&quot;, &quot;chunk-3031ff2205f827feea0affe73ca7d2ae-e-2&quot;, &quot;chunk-d89de553b45749db88cca84e98f06178-e-4&quot;, &quot;chunk-569a3d8aec20d9df6a256b4cf4b263a7-e-12&quot;, &quot;chunk-117357a69dc4feae2bf2578a7ae7467c-e-8&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="11" />
        </attvalues>
      </node>
      <node id="chunk-ef72440f70fee44097b994414253b0b4-e-4" label="Sub-solvus heat treatment">
        <attvalues>
          <attvalue for="0" value="Sub-solvus heat treatment" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="亚固溶线热处理 (Sub-solvus heat-treatment) 是一种在低于γ'相固溶线温度下进行的固溶处理工艺。该工艺旨在溶解部分可溶相（如二次γ'相），同时完整保留尺寸粗大的一次γ'相不被溶解，从而获得特定的双态组织结构并优化材料的综合力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-ef72440f70fee44097b994414253b0b4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Sub-solvus heat treatments&quot;, &quot;Sub-solvus heat-treatment&quot;, &quot;sub-solvus heat treatment&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ef72440f70fee44097b994414253b0b4-e-4&quot;, &quot;chunk-b0fcb2d1e6cc033c9c5417a044b26160-e-6&quot;, &quot;chunk-9c7953b64a6a98e79dd79734f10a7c02-e-5&quot;, &quot;chunk-d89de553b45749db88cca84e98f06178-e-3&quot;, &quot;chunk-a5ab94c496162dae08a6cf75a408debb-e-5&quot;, &quot;chunk-569a3d8aec20d9df6a256b4cf4b263a7-e-11&quot;, &quot;chunk-117357a69dc4feae2bf2578a7ae7467c-e-4&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-ef72440f70fee44097b994414253b0b4-e-5" label="Paris regime">
        <attvalues>
          <attvalue for="0" value="Paris regime" />
          <attvalue for="1" value="Technical Concept" />
          <attvalue for="2" value="Paris regime是在断裂力学中，疲劳裂纹扩展过程的一个稳定阶段。在此阶段，裂纹扩展速率与应力强度因子范围（ΔK）遵循巴黎定律（Paris Law）所描述的幂律关系，是进行材料疲劳寿命预测的关键区域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ef72440f70fee44097b994414253b0b4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ef72440f70fee44097b994414253b0b4-e-5&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ef72440f70fee44097b994414253b0b4-e-6" label="Microstructural effect">
        <attvalues>
          <attvalue for="0" value="Microstructural effect" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="指材料的微观结构特征对宏观性能产生的决定性影响，是导致材料出现不同失效机制和结果差异的根本原因。这种物理效应的作用机理和规律，可通过基于物理的定律进行解释。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-ef72440f70fee44097b994414253b0b4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Microstructural effects&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ef72440f70fee44097b994414253b0b4-e-6&quot;, &quot;chunk-72d2b781ce509c8d28bf7d43bac6d2b1-e-7&quot;]}]" />
          <attvalue for="9" value="69" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-ef72440f70fee44097b994414253b0b4-e-7" label="Minor changes in chemistry">
        <attvalues>
          <attvalue for="0" value="Minor changes in chemistry" />
          <attvalue for="1" value="Factor" />
          <attvalue for="2" value="指材料化学成分的微小调整，如铌/钽（Nb/Ta）比与钴（Co）含量的变化。该因素对材料的疲劳裂纹扩展速率（FCP rate）有影响，但其作用强度弱于微观结构效应。" />
          <attvalue for="3" value="{&quot;components&quot;: &quot;Nb/Ta ratio, Co content&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ef72440f70fee44097b994414253b0b4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="69" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1af21239034eac9b97020a65cbbdcded-e-3" label="FCP rate">
        <attvalues>
          <attvalue for="0" value="FCP rate" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="疲劳裂纹扩展速率 (Fatigue Crack Propagation rate, FCP rate) 是一项表征材料在循环载荷下抵抗裂纹扩展能力的性能指标。它通常在特定最大应力强度因子(Kmax)下测量，其数值会受到材料微观结构（如y'相尺寸）和加工工艺（如空冷）的显著影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-1af21239034eac9b97020a65cbbdcded" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;FCP rates&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1af21239034eac9b97020a65cbbdcded-e-3&quot;, &quot;chunk-0dac1108ee01fd25c7f627485d2972e6-e-2&quot;, &quot;chunk-11fd3f8dd428533f2dacdd280d5458c0-e-2&quot;, &quot;chunk-3031ff2205f827feea0affe73ca7d2ae-e-10&quot;, &quot;chunk-84e66d4c5b0aa04871a2cf1b578e46dd-e-1&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-1af21239034eac9b97020a65cbbdcded-e-4" label="Kmax">
        <attvalues>
          <attvalue for="0" value="Kmax" />
          <attvalue for="1" value="Test Parameter" />
          <attvalue for="2" value="在疲劳裂纹扩展（FCP）试验中，一个加载循环周期内所施加的最大应力强度因子。它是一个关键的测试参数，用于确定在该载荷条件下的疲劳裂纹扩展速率。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;25 MPa m1/2&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1af21239034eac9b97020a65cbbdcded" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1af21239034eac9b97020a65cbbdcded-e-5" label="Air cooling">
        <attvalues>
          <attvalue for="0" value="Air cooling" />
          <attvalue for="1" value="Cooling Method" />
          <attvalue for="2" value="空气冷却（Air cooling）是一种以空气为介质的冷却方法。与炉冷等较慢的冷却方式相比，其冷却速率更快，这通常会导致材料产生更高的FCP速率和更细小的y'相颗粒尺寸。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1af21239034eac9b97020a65cbbdcded" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1af21239034eac9b97020a65cbbdcded-e-6" label="Furnace cooling">
        <attvalues>
          <attvalue for="0" value="Furnace cooling" />
          <attvalue for="1" value="Cooling Method" />
          <attvalue for="2" value="炉冷是一种热处理冷却工艺，指将材料或工件在关闭热源后留在炉内随炉缓慢冷却。因其冷却速率最慢，能使组织接近平衡状态，它常作为基准，用于与空冷等更快冷却方式的效果进行比较，并对材料最终的颗粒尺寸等微观结构有决定性影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-1af21239034eac9b97020a65cbbdcded" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0dac1108ee01fd25c7f627485d2972e6-e-1" label="Combinations of super-solvus and sub-solvus heat treatment">
        <attvalues>
          <attvalue for="0" value="Combinations of super-solvus and sub-solvus heat treatment" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种包含超固溶（super-solvus）和亚固溶（sub-solvus）处理的组合热处理工艺。该工艺通过引起γ'相的析出，导致材料的疲劳裂纹扩展（FCP）速率显著增加，从而严重损害其抗疲劳裂纹扩展性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-0dac1108ee01fd25c7f627485d2972e6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0dac1108ee01fd25c7f627485d2972e6-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0dac1108ee01fd25c7f627485d2972e6-e-4" label="γ' particle size distribution">
        <attvalues>
          <attvalue for="0" value="γ' particle size distribution" />
          <attvalue for="1" value="Microstructural Characteristic" />
          <attvalue for="2" value="γ'相粒径分布是一种关键的微观组织特征，指材料（尤其是镍基高温合金）中作为主要强化相的γ'相颗粒的尺寸统计分布情况。该分布是决定材料抗疲劳裂纹扩展（FCP）性能的核心参数，对优化材料的整体力学性能至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0dac1108ee01fd25c7f627485d2972e6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0dac1108ee01fd25c7f627485d2972e6-e-4&quot;, &quot;chunk-97f22587e687782a5433110f85b94c9e-e-1&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-0dac1108ee01fd25c7f627485d2972e6-e-5" label="FCP resistance">
        <attvalues>
          <attvalue for="0" value="FCP resistance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="疲劳裂纹扩展抗力 (FCP resistance) 是一种力学性能，指材料在循环载荷作用下抵抗裂纹生长的能力。它是评估材料耐久性的关键指标，其性能表现受到材料微观结构（如γ'相颗粒尺寸分布）的显著影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-0dac1108ee01fd25c7f627485d2972e6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0dac1108ee01fd25c7f627485d2972e6-e-5&quot;, &quot;chunk-97f22587e687782a5433110f85b94c9e-e-2&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-97f22587e687782a5433110f85b94c9e-e-3" label="Static strength">
        <attvalues>
          <attvalue for="0" value="Static strength" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="静态强度是一种力学性能，指材料在静载荷（缓慢施加的恒定载荷）作用下，抵抗发生塑性变形或断裂的能力。它是衡量材料承载能力的基本指标，其数值受材料的微观结构（如γ'相颗粒尺寸分布）等因素的显著影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-97f22587e687782a5433110f85b94c9e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-97f22587e687782a5433110f85b94c9e-e-3&quot;, &quot;chunk-e15d40b719932710977e7301c85e011b-e-8&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-97f22587e687782a5433110f85b94c9e-e-7" label="Low-cycle-fatigue (LCF) life">
        <attvalues>
          <attvalue for="0" value="Low-cycle-fatigue (LCF) life" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="低周疲劳寿命（Low Cycle Fatigue life）是一项材料属性，指材料在经受高应力或高应变幅的反复循环加载下，发生失效破坏前所能承受的循环次数。它是衡量材料在严苛循环载荷条件下耐久性的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-97f22587e687782a5433110f85b94c9e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;LCF life&quot;, &quot;Low-cycle fatigue (LCF) life&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-97f22587e687782a5433110f85b94c9e-e-7&quot;, &quot;chunk-e15d40b719932710977e7301c85e011b-e-2&quot;, &quot;chunk-28369a1f48e0d9ccd0e560147c06b368-e-8&quot;, &quot;chunk-7f5d267485eb6b44a173a04ba9a301e4-e-1&quot;, &quot;chunk-9c7953b64a6a98e79dd79734f10a7c02-e-9&quot;, &quot;chunk-870742dec10263e0078e94a0b6a827aa-e-10&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e15d40b719932710977e7301c85e011b-e-1" label="Tensile strength">
        <attvalues>
          <attvalue for="0" value="Tensile strength" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="抗拉强度是衡量材料力学性能的关键指标，指材料在承受拉伸载荷时，发生断裂前所能承受的最大应力。它表征了材料抵抗外部拉伸作用而不断裂的能力，是工程设计和材料选择中的重要依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-e15d40b719932710977e7301c85e011b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e15d40b719932710977e7301c85e011b-e-1&quot;, &quot;chunk-a5ab94c496162dae08a6cf75a408debb-e-4&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e15d40b719932710977e7301c85e011b-e-6" label="Fatigue crack propagation rates">
        <attvalues>
          <attvalue for="0" value="Fatigue crack propagation rates" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="疲劳裂纹扩展速率是衡量材料在循环载荷下裂纹扩展速度的力学性能指标。此速率越低，材料的抗疲劳性能越好。通常，较大的晶粒尺寸会通过裂纹偏转等机制减缓扩展速率，而较小的晶粒尺寸则会加速扩展。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e15d40b719932710977e7301c85e011b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e15d40b719932710977e7301c85e011b-e-6&quot;, &quot;chunk-28369a1f48e0d9ccd0e560147c06b368-e-1&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-e15d40b719932710977e7301c85e011b-e-7" label="Large grain sizes">
        <attvalues>
          <attvalue for="0" value="Large grain sizes" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="大晶粒尺寸是一种材料的微观结构特征，指构成材料的晶粒尺寸较大。这种结构能够通过减少晶界来提高材料的抗蠕变性能，并阻碍裂纹尖端的位错运动，从而降低疲劳裂纹的扩展速率，通常有利于高温应用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-e15d40b719932710977e7301c85e011b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Larger grain size&quot;, &quot;Larger grain sizes&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e15d40b719932710977e7301c85e011b-e-7&quot;, &quot;chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0-e-1&quot;, &quot;chunk-4c8046e347f9b34e2d562b9ab80e224b-e-1&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-e15d40b719932710977e7301c85e011b-e-9" label="Resistance to cyclic fatigue crack propagation">
        <attvalues>
          <attvalue for="0" value="Resistance to cyclic fatigue crack propagation" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="疲劳裂纹扩展抗性是一种机械性能，指材料在循环载荷下抵抗已有裂纹发生扩展的能力。该性能与材料的晶粒尺寸等微观结构相关，在工程设计中，通常需要与绝对静强度等其他性能进行权衡。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-e15d40b719932710977e7301c85e011b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e15d40b719932710977e7301c85e011b-e-9&quot;, &quot;chunk-e0b75e1db98f5ed18e200239c3a5bcc3-e-2&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e0b75e1db98f5ed18e200239c3a5bcc3-e-4" label="Yield strength">
        <attvalues>
          <attvalue for="0" value="Yield strength" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="屈服强度（YS）是一种关键力学性能，指材料从弹性变形过渡到塑性变形的临界应力值。超过此值，材料将产生永久变形，无法恢复原状。它表征材料的塑性抗力，可通过晶粒细化等工艺有效提高。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-e0b75e1db98f5ed18e200239c3a5bcc3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Yield Strength&quot;, &quot;Yield Strength (YS)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e0b75e1db98f5ed18e200239c3a5bcc3-e-4&quot;, &quot;chunk-f15a8c6d190d14d1db32161520fa75ce-e-5&quot;, &quot;chunk-53753c2242e7dd6a1f075c9d1be8ff40-e-6&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e0b75e1db98f5ed18e200239c3a5bcc3-e-5" label="Resistance to fatigue crack initiation">
        <attvalues>
          <attvalue for="0" value="Resistance to fatigue crack initiation" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="衡量材料在循环载荷下抵抗裂纹萌生能力的机械性能。作为疲劳破坏的初始阶段，该性能通常与材料的晶粒尺寸成反比，即晶粒越细小，材料的抗裂纹萌生能力越强。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e0b75e1db98f5ed18e200239c3a5bcc3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e0b75e1db98f5ed18e200239c3a5bcc3-e-5&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e0b75e1db98f5ed18e200239c3a5bcc3-e-6" label="Creep strength">
        <attvalues>
          <attvalue for="0" value="Creep strength" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="蠕变强度是一种力学性能指标，指材料在高温和恒定应力作用下抵抗缓慢塑性变形（即蠕变）的能力。它与材料的晶粒尺寸等微观结构密切相关，是评估材料高温服役稳定性的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e0b75e1db98f5ed18e200239c3a5bcc3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Creep Strength&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e0b75e1db98f5ed18e200239c3a5bcc3-e-6&quot;, &quot;chunk-f15a8c6d190d14d1db32161520fa75ce-e-2&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f15a8c6d190d14d1db32161520fa75ce-e-3" label="Resistance to Fatigue Crack Growth">
        <attvalues>
          <attvalue for="0" value="Resistance to Fatigue Crack Growth" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="**抗疲劳裂纹扩展抗力 (Resistance to Fatigue Crack Growth)**&#10;&#10;一种力学性能指标，用于衡量材料在循环载荷作用下阻止已有裂纹发生扩展的能力。该性能通常会随着材料晶粒尺寸的增大而提高，是评估材料在疲劳环境下可靠性的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-f15a8c6d190d14d1db32161520fa75ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f15a8c6d190d14d1db32161520fa75ce-e-3&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f15a8c6d190d14d1db32161520fa75ce-e-4" label="Bain et al. [22]">
        <attvalues>
          <attvalue for="0" value="Bain et al. [22]" />
          <attvalue for="1" value="Researcher" />
          <attvalue for="2" value="Bain et al. [22]是一组研究人员的学术引用代号。其研究以Udimet 720材料为对象，重点关注晶粒尺寸对材料关键力学性能的影响，并精确测量了该材料的屈服强度、疲劳强度与蠕变强度等重要属性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f15a8c6d190d14d1db32161520fa75ce" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-f15a8c6d190d14d1db32161520fa75ce-e-6" label="Fatigue Strength">
        <attvalues>
          <attvalue for="0" value="Fatigue Strength" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="疲劳强度（Fatigue Strength）是一种材料力学性能，指材料在经受无限次或规定次数的交变载荷作用下而不发生断裂时，所能承受的最大应力。它是评估材料在循环加载下耐久性的关键指标，通常通过S-N曲线来表征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-f15a8c6d190d14d1db32161520fa75ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f15a8c6d190d14d1db32161520fa75ce-e-6&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f15a8c6d190d14d1db32161520fa75ce-e-7" label="Udimet 720">
        <attvalues>
          <attvalue for="0" value="Udimet 720" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="Udimet 720是由特殊金属公司(Special Metals Corporation)开发的一种镍基高温合金。它以含有铬（原始版本为18 wt%）为特点，其研发项目对于理解铬在同类合金中的浓度极限具有重要意义，促进了材料科学的发展。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-f15a8c6d190d14d1db32161520fa75ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f15a8c6d190d14d1db32161520fa75ce-e-7&quot;, &quot;chunk-b0fcb2d1e6cc033c9c5417a044b26160-e-1&quot;, &quot;chunk-9f35adfc9c150d132285785cf907bbcb-e-4&quot;, &quot;chunk-84e66d4c5b0aa04871a2cf1b578e46dd-e-5&quot;, &quot;chunk-9e77a589c8fe70a5a486a0c63c76551f-e-7&quot;, &quot;chunk-e3a2ad2f86c91d0494cd03450bd94ade-e-14&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-b0fcb2d1e6cc033c9c5417a044b26160-e-2" label="Yield, fatigue and creep">
        <attvalues>
          <attvalue for="0" value="Yield, fatigue and creep" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一组核心力学性能，分别表征材料抵抗永久变形的能力（屈服）、在循环载荷下的断裂行为（疲劳），以及在恒定载荷与高温下的长期变形趋势（蠕变）。这些属性共同决定了材料的强度、可靠性与使用寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-b0fcb2d1e6cc033c9c5417a044b26160" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b0fcb2d1e6cc033c9c5417a044b26160-e-3" label="VIM/VAR">
        <attvalues>
          <attvalue for="0" value="VIM/VAR" />
          <attvalue for="1" value="Processing Method" />
          <attvalue for="2" value="VIM/VAR指真空感应熔炼/真空电弧重熔，是一种双联熔炼工艺。该工艺通过两步真空冶炼，用于生产Udimet 720等高性能高温合金，以获得成分精确、组织均匀且高度纯净的材料，满足航空航天等领域的严苛应用要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-b0fcb2d1e6cc033c9c5417a044b26160" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b0fcb2d1e6cc033c9c5417a044b26160-e-3&quot;, &quot;chunk-18c533341a9790d5a6a16a72face3f19-e-7&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b0fcb2d1e6cc033c9c5417a044b26160-e-4" label="Hot-Die Forging">
        <attvalues>
          <attvalue for="0" value="Hot-Die Forging" />
          <attvalue for="1" value="Processing Method" />
          <attvalue for="2" value="热模锻是一种锻造工艺，指将模具加热到与工件相近的温度进行锻造。该方法可减缓坯料冷却，降低变形抗力，从而能够成形高温合金（如Udimet 720）、钛合金等难变形材料，用于制造形状复杂的近净形锻件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-b0fcb2d1e6cc033c9c5417a044b26160" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Hot-die forging&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b0fcb2d1e6cc033c9c5417a044b26160-e-4&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b0fcb2d1e6cc033c9c5417a044b26160-e-8" label="Double ageing treatments">
        <attvalues>
          <attvalue for="0" value="Double ageing treatments" />
          <attvalue for="1" value="Processing Method" />
          <attvalue for="2" value="双时效处理（Double ageing treatments）是一种分两个阶段进行的时效硬化热处理工艺，常用于Udimet 720等镍基高温合金。它通过在不同温度下进行两次时效，以优化材料内部析出相的尺寸与分布，从而显著提高合金的综合力学性能，特别是高温强度和持久性能。" />
          <attvalue for="3" value="{&quot;step_1&quot;: &quot;760°C/8 h/air cool&quot;, &quot;step_2&quot;: &quot;650°C/24 h/air cool&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-b0fcb2d1e6cc033c9c5417a044b26160" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b0fcb2d1e6cc033c9c5417a044b26160-e-9" label="Uniform grain sizes">
        <attvalues>
          <attvalue for="0" value="Uniform grain sizes" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种材料属性，指材料内部晶粒尺寸大小均一、分布狭窄的微观结构特征。这种均匀的结构通常能提升材料的综合力学性能与稳定性，是一种理想的材料组织状态，可通过粉末冶金等工艺获得。" />
          <attvalue for="3" value="{&quot;sizes_in_microns&quot;: &quot;19 µm, 90 µm, 127 µm, 360 µm&quot;, &quot;corresponding_ASTM_sizes&quot;: &quot;8.5, 4, 3, 0&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-b0fcb2d1e6cc033c9c5417a044b26160" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Uniform Grain Size&quot;, &quot;Uniform grain size&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b0fcb2d1e6cc033c9c5417a044b26160-e-9&quot;, &quot;chunk-100afba087a43fc5308b3284aa10cb35-e-7&quot;, &quot;chunk-0365022a18454a90e4598122a8f449ca-e-2&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-27e744dfd57dfdad9eeacf1afe66f2e9-e-1" label="Produced Materials">
        <attvalues>
          <attvalue for="0" value="Produced Materials" />
          <attvalue for="1" value="Material Group" />
          <attvalue for="2" value="一个为测试目的生产的材料组，包含127µm和360µm两种晶粒尺寸，对应特定的ASTM晶粒尺寸标准。其关键的显微结构特征是缺少初生γ'（gamma prime）相。" />
          <attvalue for="3" value="{&quot;grain_sizes_µm&quot;: &quot;127, 360&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-27e744dfd57dfdad9eeacf1afe66f2e9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-27e744dfd57dfdad9eeacf1afe66f2e9-e-4" label="19 µm material">
        <attvalues>
          <attvalue for="0" value="19 µm material" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种平均晶粒尺寸为19微米（µm）的材料，其显著的微观结构特征是含有初生γ'（伽马撇）相。这种特征通常表明该材料是一种镍基高温合金，其中γ'相作为主要的强化相存在。" />
          <attvalue for="3" value="{&quot;grain_size_µm&quot;: &quot;19&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-27e744dfd57dfdad9eeacf1afe66f2e9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-27e744dfd57dfdad9eeacf1afe66f2e9-e-5" label="Finest-grained material">
        <attvalues>
          <attvalue for="0" value="Finest-grained material" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种在特定测试组中晶粒最为细小的材料。通过拉伸试样测试表明，其具有该组材料中最高的屈服应力，强度优于晶粒较粗的同类材料。" />
          <attvalue for="3" value="{&quot;room_temperature_yield_stress&quot;: &quot;about 1200 MPa&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-27e744dfd57dfdad9eeacf1afe66f2e9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="109" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-27e744dfd57dfdad9eeacf1afe66f2e9-e-6" label="Coarser-grained material">
        <attvalues>
          <attvalue for="0" value="Coarser-grained material" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种晶粒尺寸相对粗大的材料。在特定上下文中，它被用作屈服应力对比的参照物，其屈服应力比最细晶粒材料低200 MPa，用以展示晶粒尺寸对材料强度的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-27e744dfd57dfdad9eeacf1afe66f2e9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-27e744dfd57dfdad9eeacf1afe66f2e9-e-6&quot;]}]" />
          <attvalue for="9" value="109" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-27e744dfd57dfdad9eeacf1afe66f2e9-e-7" label="Tensile specimens">
        <attvalues>
          <attvalue for="0" value="Tensile specimens" />
          <attvalue for="1" value="Test Sample" />
          <attvalue for="2" value="拉伸试样是一种具有标准几何形状（通常为哑铃形）的材料样品。它被用于力学性能测试中，通过施加轴向拉伸载荷直至断裂，以精确测定材料的屈服强度、抗拉强度和延伸率等关键力学性能指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-27e744dfd57dfdad9eeacf1afe66f2e9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="109" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9f35adfc9c150d132285785cf907bbcb-e-1" label="Room Temperature Yield Stress (YS)">
        <attvalues>
          <attvalue for="0" value="Room Temperature Yield Stress (YS)" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="室温屈服强度（YS）是衡量材料在室温下抵抗永久塑性变形能力的核心力学性能指标。它指材料开始发生塑性变形时的临界应力值，是评估材料可靠性的关键参数，其数值常与极限抗拉强度（UTS）同步变化，并对微观结构（如晶粒尺寸）高度敏感。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;about 1200 MPa&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-9f35adfc9c150d132285785cf907bbcb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Yield stress at ambient temperature&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-166f31f5769126f6a4cd51ea1a1302a5-e-6&quot;, &quot;chunk-9f35adfc9c150d132285785cf907bbcb-e-1&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9f35adfc9c150d132285785cf907bbcb-e-2" label="Coarsest-grained material">
        <attvalues>
          <attvalue for="0" value="Coarsest-grained material" />
          <attvalue for="1" value="Material Condition" />
          <attvalue for="2" value="一种具有最粗晶粒组织的材料状态，通常作为性能对比的基准。由于晶粒粗大，其屈服强度较低，在本例中比主要对比材料低约200 MPa。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-9f35adfc9c150d132285785cf907bbcb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9f35adfc9c150d132285785cf907bbcb-e-2&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9f35adfc9c150d132285785cf907bbcb-e-3" label="Udimet 720Li">
        <attvalues>
          <attvalue for="0" value="Udimet 720Li" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="Udimet 720Li是一种沉淀强化型镍基高温合金，是Udimet 720的低碳（Low Interstitial）改进型。它具有卓越的高温强度、抗蠕变及抗疲劳性能，同时改善了加工与焊接性。主要用于制造航空发动机及工业燃气轮机中的涡轮盘等关键热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-9f35adfc9c150d132285785cf907bbcb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Udimet 720Li superalloy&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c46fd89a11edd99dc16bcf1682764928-e-3&quot;, &quot;chunk-9f35adfc9c150d132285785cf907bbcb-e-3&quot;, &quot;chunk-7f5d267485eb6b44a173a04ba9a301e4-e-3&quot;, &quot;chunk-44a103d3439804fea5910e3206b26742-e-1&quot;, &quot;chunk-e3a2ad2f86c91d0494cd03450bd94ade-e-15&quot;, &quot;chunk-e59e76ae369265e25373e5545e9102c3-e-1&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="11" />
        </attvalues>
      </node>
      <node id="chunk-53753c2242e7dd6a1f075c9d1be8ff40-e-2" label="Strain-controlled LCF tests">
        <attvalues>
          <attvalue for="0" value="Strain-controlled LCF tests" />
          <attvalue for="1" value="Mechanical Test" />
          <attvalue for="2" value="应变控制低周疲劳试验是一种机械测试方法。该试验通过对光滑、抛光的标准试样施加一个恒定的、循环的应变幅，记录其应力响应，旨在评估材料在经历显著塑性变形时的疲劳寿命和循环应力-应变行为。" />
          <attvalue for="3" value="{&quot;R&quot;: &quot;0&quot;, &quot;frequency&quot;: &quot;0.33 Hz&quot;, &quot;total_strain_range&quot;: &quot;0.80%&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-53753c2242e7dd6a1f075c9d1be8ff40" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-53753c2242e7dd6a1f075c9d1be8ff40-e-2&quot;]}]" />
          <attvalue for="9" value="172" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-53753c2242e7dd6a1f075c9d1be8ff40-e-3" label="Smooth, polished testpieces">
        <attvalues>
          <attvalue for="0" value="Smooth, polished testpieces" />
          <attvalue for="1" value="Material Sample" />
          <attvalue for="2" value="一种经过光滑和抛光表面处理的材料试样。它专门用于进行应变控制的低周疲劳（LCF）试验，以测试和评估材料在循环塑性应变作用下的疲劳寿命和力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-53753c2242e7dd6a1f075c9d1be8ff40" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="172" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-53753c2242e7dd6a1f075c9d1be8ff40-e-4" label="LCF life">
        <attvalues>
          <attvalue for="0" value="LCF life" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="LCF life，即低周疲劳寿命，是一项关键力学性能，指材料在循环载荷作用下的预期寿命。该性能受材料晶粒尺寸的显著影响：通过晶粒细化可有效提高其寿命，而粗大的晶粒则会降低其寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-53753c2242e7dd6a1f075c9d1be8ff40" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-53753c2242e7dd6a1f075c9d1be8ff40-e-4&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-53753c2242e7dd6a1f075c9d1be8ff40-e-5" label="Grain refinement">
        <attvalues>
          <attvalue for="0" value="Grain refinement" />
          <attvalue for="1" value="Material Process" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;晶粒细化是一种通过减小金属或合金内部晶粒尺寸，以改善其力学性能的材料工艺。根据霍尔-佩奇关系，该工艺能有效提高材料的屈服强度，同时也会对其低周疲劳（LCF）寿命产生影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-53753c2242e7dd6a1f075c9d1be8ff40" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;grain size refinement&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-53753c2242e7dd6a1f075c9d1be8ff40-e-5&quot;, &quot;chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676-e-7&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-53753c2242e7dd6a1f075c9d1be8ff40-e-7" label="Grain size of 360 µm">
        <attvalues>
          <attvalue for="0" value="Grain size of 360 µm" />
          <attvalue for="1" value="Material Characteristic" />
          <attvalue for="2" value="一种材料微观结构参数，指晶粒平均尺寸为360微米(µm)。在相关测试中，这是所采用的最大晶粒尺寸，该尺寸已被证实会降低材料的低周疲劳(LCF)寿命，对材料耐久性产生负面影响。" />
          <attvalue for="3" value="{&quot;size&quot;: &quot;360 µm&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-53753c2242e7dd6a1f075c9d1be8ff40" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-53753c2242e7dd6a1f075c9d1be8ff40-e-7&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-53753c2242e7dd6a1f075c9d1be8ff40-e-8" label="Grain size of 19 µm">
        <attvalues>
          <attvalue for="0" value="Grain size of 19 µm" />
          <attvalue for="1" value="Material Characteristic" />
          <attvalue for="2" value="一种材料微观结构特征，指晶粒平均尺寸为19微米。作为一种细晶粒结构，它与较大晶粒（如360µm）相比，能显著提升材料的低周疲劳（LCF）寿命。" />
          <attvalue for="3" value="{&quot;size&quot;: &quot;19 µm&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-53753c2242e7dd6a1f075c9d1be8ff40" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-53753c2242e7dd6a1f075c9d1be8ff40-e-8&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d4529d405393ac6d501a33e3c215f2a0-e-2" label="Static yield properties">
        <attvalues>
          <attvalue for="0" value="Static yield properties" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="静态屈服性能 (Static yield properties) 是衡量材料在静态载荷下抵抗塑性变形能力的力学指标，通常用屈服强度表示。在多晶高温合金中，该性能与晶粒尺寸密切相关：晶粒尺寸越细，晶界对位错运动的阻碍作用越强，材料的屈服强度越高，因此该性能得到改善。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-d4529d405393ac6d501a33e3c215f2a0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d4529d405393ac6d501a33e3c215f2a0-e-2&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d4529d405393ac6d501a33e3c215f2a0-e-3" label="LCF properties">
        <attvalues>
          <attvalue for="0" value="LCF properties" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="低周疲劳性能（LCF properties）是衡量材料在低周次循环载荷下抵抗疲劳破坏能力的机械性能。对于多晶高温合金而言，该性能主要取决于其合金成分与晶粒尺寸，其中，细小的晶粒尺寸能够有效提升材料的低周疲劳性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d4529d405393ac6d501a33e3c215f2a0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d4529d405393ac6d501a33e3c215f2a0-e-3&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d4529d405393ac6d501a33e3c215f2a0-e-4" label="Fine grain sizes">
        <attvalues>
          <attvalue for="0" value="Fine grain sizes" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="多晶高温合金中一种优选的显微组织特征。它指材料内部的晶粒尺寸较为细小，这种结构能够显著提升材料的静态屈服强度和低周疲劳（LCF）性能，是优化其力学表现的关键。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d4529d405393ac6d501a33e3c215f2a0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-9b97021f9b9b8256b6c78711278f4654-e-2" label="Fatigue crack growth">
        <attvalues>
          <attvalue for="0" value="Fatigue crack growth" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="疲劳裂纹扩展(Fatigue crack growth)是一种在循环载荷下材料裂纹稳定增长的现象。在晶体材料中，该过程的微观机理表现为裂纹沿特定的{111}晶面扩展，并平行于滑移带痕迹。其扩展机制与速率受到温度和外部环境的显著影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-9b97021f9b9b8256b6c78711278f4654" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;crack growth&quot;, &quot;fatigue crack growth&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9b97021f9b9b8256b6c78711278f4654-e-2&quot;, &quot;chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd-e-4&quot;, &quot;chunk-63304b61ed04760729e5b6e71982902a-e-3&quot;, &quot;chunk-378cff7c7b5d0dedcf7174df0a8eba7a-e-2&quot;, &quot;chunk-8a91b63add4adbc77d4752d41b7c75aa-e-7&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-9b97021f9b9b8256b6c78711278f4654-e-3" label="Creep rupture performance">
        <attvalues>
          <attvalue for="0" value="Creep rupture performance" />
          <attvalue for="1" value="Material Performance Metric" />
          <attvalue for="2" value="蠕变断裂性能指材料在高温和恒定应力作用下，抵抗因蠕变变形累积而导致断裂的性能。它是一个关键的材料性能指标，通常由材料在特定温度和应力下的断裂寿命或持久强度来评定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-9b97021f9b9b8256b6c78711278f4654" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9b97021f9b9b8256b6c78711278f4654-e-3&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9b97021f9b9b8256b6c78711278f4654-e-4" label="Bain et al. [22]">
        <attvalues>
          <attvalue for="0" value="Bain et al. [22]" />
          <attvalue for="1" value="Research Group" />
          <attvalue for="2" value="Bain等人[22]是一个以Bain为主要作者的研究团队，其研究在文中被作为第22篇参考文献引用。根据上下文，该团队因执行了恒定载荷蠕变试验而受到关注。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-9b97021f9b9b8256b6c78711278f4654" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="173" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9b97021f9b9b8256b6c78711278f4654-e-5" label="Constant load creep tests">
        <attvalues>
          <attvalue for="0" value="Constant load creep tests" />
          <attvalue for="1" value="Mechanical Test" />
          <attvalue for="2" value="恒载荷蠕变试验是一种重要的材料机械测试方法。它指在恒定温度下对材料施加一恒定载荷，通过测量材料随时间产生的形变和最终的断裂时间，来评估其蠕变抗性及蠕变断裂性能。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;700°C&quot;, &quot;stress&quot;: &quot;690 MPa&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-9b97021f9b9b8256b6c78711278f4654" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9b97021f9b9b8256b6c78711278f4654-e-5&quot;]}]" />
          <attvalue for="9" value="173" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9b97021f9b9b8256b6c78711278f4654-e-6" label="Rupture life">
        <attvalues>
          <attvalue for="0" value="Rupture life" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="蠕变断裂寿命（Rupture Life），也称持久寿命，是一项关键性能指标，指材料在恒定载荷与高温等特定蠕变条件下，从开始加载到发生断裂的总时间。在高温蠕变中，该寿命通常随晶粒尺寸的增大而延长。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-9b97021f9b9b8256b6c78711278f4654" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9b97021f9b9b8256b6c78711278f4654-e-6&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9b97021f9b9b8256b6c78711278f4654-e-7" label="NR3 superalloy">
        <attvalues>
          <attvalue for="0" value="NR3 superalloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="NR3是一种高温合金。它通过特定的热处理工艺，可形成粗晶或细晶等不同的晶粒结构，以用于评估和研究材料在高温下的蠕变性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-9b97021f9b9b8256b6c78711278f4654" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9b97021f9b9b8256b6c78711278f4654-e-7&quot;, &quot;chunk-c0d12490c7b814ce8a1cab25a00073a6-e-1&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c0d12490c7b814ce8a1cab25a00073a6-e-2" label="Coarse-grain structure">
        <attvalues>
          <attvalue for="0" value="Coarse-grain structure" />
          <attvalue for="1" value="Microstructure" />
          <attvalue for="2" value="NR3高温合金经超固溶线温度热处理后形成的一种微观组织。其特点是晶粒粗大，能够显著提高材料在高温下的抗蠕变性能，从而获得更低的最小蠕变速率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c0d12490c7b814ce8a1cab25a00073a6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c0d12490c7b814ce8a1cab25a00073a6-e-2&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c0d12490c7b814ce8a1cab25a00073a6-e-3" label="Fine-grain structure">
        <attvalues>
          <attvalue for="0" value="Fine-grain structure" />
          <attvalue for="1" value="Microstructure" />
          <attvalue for="2" value="NR3高温合金在亚固溶温度下进行热处理后形成的一种显微组织。其主要特征是合金内部的晶粒尺寸均匀且细小，这种结构通常旨在改善材料的综合力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c0d12490c7b814ce8a1cab25a00073a6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c0d12490c7b814ce8a1cab25a00073a6-e-3&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c0d12490c7b814ce8a1cab25a00073a6-e-5" label="Creep Test at 750 °C and 300 MPa">
        <attvalues>
          <attvalue for="0" value="Creep Test at 750 °C and 300 MPa" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="指在750°C温度和300MPa恒定应力下，为测定NR3高温合金蠕变性能而规定的一组特定试验条件。该条件是评估和测量材料在此工况下关键力学指标（如最小蠕变速率）的基准。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;750 °C&quot;, &quot;pressure&quot;: &quot;300 MPa&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c0d12490c7b814ce8a1cab25a00073a6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0-e-3" label="Fatigue crack propagation rate">
        <attvalues>
          <attvalue for="0" value="Fatigue crack propagation rate" />
          <attvalue for="1" value="Material Performance" />
          <attvalue for="2" value="疲劳裂纹扩展速率指材料在循环载荷下疲劳裂纹增长的速度。作为一项关键材料性能，它直接影响并控制着材料的疲劳寿命，是进行损伤容限设计与寿命评估的核心参数。该速率对材料微观结构（如晶粒尺寸）、温度、环境介质等因素高度敏感。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Fatigue crack growth rate&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0-e-3&quot;, &quot;chunk-b8f64fb156fdeb0f33d3fd48ce26370d-e-2&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="13" />
        </attvalues>
      </node>
      <node id="chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0-e-4" label="Damage-tolerant method for life assessment">
        <attvalues>
          <attvalue for="0" value="Damage-tolerant method for life assessment" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="一种工程评估技术，它假定构件存在初始缺陷或损伤。该方法基于断裂力学原理，通过分析疲劳裂纹扩展速率等因素，来预测构件在规定条件下能够安全使用的剩余寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0-e-4&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0-e-5" label="Fatigue life">
        <attvalues>
          <attvalue for="0" value="Fatigue life" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**疲劳寿命 (Fatigue Life)**&#10;&#10;一种材料属性，指材料在特定的循环应力或应变作用下，直至发生疲劳断裂时所能承受的载荷循环总次数。它是衡量材料在交变载荷下抵抗失效能力的关键指标，用于评估结构部件的耐久性和可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Fatigue lives&quot;, &quot;VJL12U superalloy&quot;, &quot;fatigue life&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0-e-5&quot;, &quot;chunk-6f4c84e8661d1e3a5f359969b56cd45d-e-1&quot;, &quot;chunk-1d594ec5fbaf685c293ac798de95c065-e-1&quot;, &quot;chunk-e3527c9f74d686641ceba7afb52a8ef3-e-4&quot;, &quot;chunk-9e77a589c8fe70a5a486a0c63c76551f-e-4&quot;, &quot;chunk-0c0cb15f0b332db0e8b9015221af9b16-e-2&quot;, &quot;chunk-0489a6121ca8cc5c02cc985cc307d8a1-e-2&quot;, &quot;chunk-9fd48949e9fa068e1f82454ee4d745a1-e-8&quot;, &quot;chunk-203cb57048ee781208098d35869844a7-e-6&quot;, &quot;chunk-dc948aa78d11700723dfefe1c5756cc9-e-4&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="11" />
        </attvalues>
      </node>
      <node id="chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0-e-6" label="Bain et al. [22]">
        <attvalues>
          <attvalue for="0" value="Bain et al. [22]" />
          <attvalue for="1" value="Researcher" />
          <attvalue for="2" value="一个由Bain等人代表的研究团队（引文[22]），其在发表的研究中对疲劳循环裂纹的扩展速率进行了测量，为相关领域的分析提供了关键实验数据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0-e-6&quot;, &quot;chunk-8827e315f10ef4c6612df3e85c9f593c-e-2&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0-e-7" label="Air">
        <attvalues>
          <attvalue for="0" value="Air" />
          <attvalue for="1" value="Environment" />
          <attvalue for="2" value="在材料科学中，指用于测量疲劳裂纹扩展速率的实验环境。它通常代表标准大气条件，作为与其他环境（如真空或腐蚀介质）中的材料性能进行比较的基准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-daa34d2c0ba5a6e91ef5f07c4e9393f0-e-7&quot;, &quot;chunk-8827e315f10ef4c6612df3e85c9f593c-e-3&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8827e315f10ef4c6612df3e85c9f593c-e-1" label="Fatigue cyclic crack growth rates">
        <attvalues>
          <attvalue for="0" value="Fatigue cyclic crack growth rates" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="疲劳循环裂纹扩展速率是一项关键材料属性，表征材料在循环载荷作用下裂纹增长的快慢。它直接影响材料的疲劳寿命，并受到温度、应力比、加载频率、环境（如空气）以及材料微观结构（如晶粒尺寸）的显著影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-8827e315f10ef4c6612df3e85c9f593c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8827e315f10ef4c6612df3e85c9f593c-e-1&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-8827e315f10ef4c6612df3e85c9f593c-e-5" label="R ratio of 0.05">
        <attvalues>
          <attvalue for="0" value="R ratio of 0.05" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="一项用于测量疲劳循环裂纹扩展速率的试验条件，指在循环加载中，最小应力与最大应力之比（即应力比R）的设定值为0.05。" />
          <attvalue for="3" value="{&quot;parameter&quot;: &quot;R ratio&quot;, &quot;value&quot;: &quot;0.05&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-8827e315f10ef4c6612df3e85c9f593c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8827e315f10ef4c6612df3e85c9f593c-e-5&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8827e315f10ef4c6612df3e85c9f593c-e-6" label="3.3 Hz">
        <attvalues>
          <attvalue for="0" value="3.3 Hz" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="一项测试条件，指在测量疲劳循环裂纹扩展速率的试验中，所施加的循环载荷频率为3.3赫兹（Hz），即每秒循环3.3次。" />
          <attvalue for="3" value="{&quot;parameter&quot;: &quot;frequency&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-8827e315f10ef4c6612df3e85c9f593c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8827e315f10ef4c6612df3e85c9f593c-e-7" label="5 min dwell at the maximum load">
        <attvalues>
          <attvalue for="0" value="5 min dwell at the maximum load" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="一项试验保载条件，指在最大载荷下保持恒定5分钟。该条件仅应用于650°C下的试验，而不用于425°C的试验。" />
          <attvalue for="3" value="{&quot;parameter&quot;: &quot;dwell time&quot;, &quot;value&quot;: &quot;5 min&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-8827e315f10ef4c6612df3e85c9f593c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-4c8046e347f9b34e2d562b9ab80e224b-e-2" label="Smaller grain size">
        <attvalues>
          <attvalue for="0" value="Smaller grain size" />
          <attvalue for="1" value="Material Microstructure" />
          <attvalue for="2" value="一种材料微观结构特征。细小的晶粒尺寸可以提升材料性能，尤其是在425°C高温及低应力强度因子(ΔK)的疲劳阈值区表现更优，其断裂模式通常呈现为穿晶断裂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-4c8046e347f9b34e2d562b9ab80e224b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4c8046e347f9b34e2d562b9ab80e224b-e-2&quot;]}]" />
          <attvalue for="9" value="81" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-4c8046e347f9b34e2d562b9ab80e224b-e-3" label="Crack Growth Rate">
        <attvalues>
          <attvalue for="0" value="Crack Growth Rate" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="裂纹扩展速率是断裂力学中衡量材料抵抗裂纹扩展能力的关键力学性能指标。它定义为单位时间或载荷循环下裂纹长度的增量，受应力水平、环境及晶粒尺寸等微观结构影响，用于预测构件的疲劳寿命。" />
          <attvalue for="3" value="{&quot;magnitude_for_larger_grain_size&quot;: &quot;two orders of magnitude smaller&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-4c8046e347f9b34e2d562b9ab80e224b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Crack growth rate&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4c8046e347f9b34e2d562b9ab80e224b-e-3&quot;, &quot;chunk-870742dec10263e0078e94a0b6a827aa-e-9&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-4c8046e347f9b34e2d562b9ab80e224b-e-4" label="Tortuous crack path">
        <attvalues>
          <attvalue for="0" value="Tortuous crack path" />
          <attvalue for="1" value="Fracture Mechanism" />
          <attvalue for="2" value="一种断裂机制，指裂纹沿着非线性、蜿蜒的路径进行扩展。这种路径的形成通常与较大的晶粒尺寸有关，因为裂纹在扩展时会沿晶界发生偏转，从而增加了其扩展的阻力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-4c8046e347f9b34e2d562b9ab80e224b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4c8046e347f9b34e2d562b9ab80e224b-e-5" label="Rougher fracture surfaces">
        <attvalues>
          <attvalue for="0" value="Rougher fracture surfaces" />
          <attvalue for="1" value="Fracture Surface Morphology" />
          <attvalue for="2" value="一种宏观上较为粗糙的断裂表面形态，主要表现为沿晶断裂。该形态通常由材料中较大的晶粒尺寸导致，裂纹沿晶粒边界扩展而形成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-4c8046e347f9b34e2d562b9ab80e224b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-4c8046e347f9b34e2d562b9ab80e224b-e-6" label="Intergranular fracture">
        <attvalues>
          <attvalue for="0" value="Intergranular fracture" />
          <attvalue for="1" value="Fracture Mode" />
          <attvalue for="2" value="晶间断裂是一种断裂模式，指裂纹沿材料的晶界扩展，而非穿过晶粒。它通常因晶界处弱化（如杂质偏析或腐蚀）而发生，导致晶粒间发生分离。其断裂面会暴露出完整的晶粒轮廓，因此形貌较为粗糙。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-4c8046e347f9b34e2d562b9ab80e224b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4c8046e347f9b34e2d562b9ab80e224b-e-6&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4c8046e347f9b34e2d562b9ab80e224b-e-7" label="425 °C">
        <attvalues>
          <attvalue for="0" value="425 °C" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="一个特定的实验温度条件。在此温度下，通过比较不同晶粒尺寸材料的性能，发现较小晶粒尺寸的材料表现更优越。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;425&quot;, &quot;unit&quot;: &quot;°C&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-4c8046e347f9b34e2d562b9ab80e224b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="81" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4c8046e347f9b34e2d562b9ab80e224b-e-8" label="Threshold regime at low AK">
        <attvalues>
          <attvalue for="0" value="Threshold regime at low AK" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="一种断裂力学试验条件，指在极低的应力强度因子范围（ΔK）下研究疲劳裂纹扩展的近阈值区域。在此条件下，裂纹扩展速率对材料的微观结构（如晶粒尺寸）高度敏感，细晶粒材料通常表现出更优的抗裂纹扩展性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-4c8046e347f9b34e2d562b9ab80e224b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="81" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4c8046e347f9b34e2d562b9ab80e224b-e-9" label="Transgranular fracture">
        <attvalues>
          <attvalue for="0" value="Transgranular fracture" />
          <attvalue for="1" value="Fracture Mode" />
          <attvalue for="2" value="穿晶断裂是一种材料断裂模式，指裂纹在扩展过程中直接穿过材料内部的晶粒，而不是沿着晶粒边界进行。其断裂路径与沿晶界发生的沿晶断裂相对，通常表现为解理断裂或韧窝断裂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-4c8046e347f9b34e2d562b9ab80e224b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4c8046e347f9b34e2d562b9ab80e224b-e-9&quot;]}]" />
          <attvalue for="9" value="81" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-1" label="Threshold Regime">
        <attvalues>
          <attvalue for="0" value="Threshold Regime" />
          <attvalue for="1" value="Material Science Concept" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;材料科学概念，指疲劳裂纹扩展过程中，发生在低应力强度因子范围（ΔK）下的特定初始区域。该区域的裂纹扩展速率极低，接近于停止扩展的临界阈值，并可通过其独特的断口形貌进行表征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-2" label="Low AK">
        <attvalues>
          <attvalue for="0" value="Low AK" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="低ΔK（低应力强度因子范围）指材料在疲劳裂纹扩展门槛区所处的工况。在该工况下，裂纹扩展速率极低，但存在引发并促进晶体学开裂的倾向，是评估材料疲劳寿命极限的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-2&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-4" label="Paris Exponents">
        <attvalues>
          <attvalue for="0" value="Paris Exponents" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="帕里斯指数（Paris Exponents）是帕里斯定律中的一个关键材料参数，用于量化材料在II区疲劳裂纹扩展阶段的速率。该指数为一个无量纲常数，其数值基本不受晶粒尺寸变化的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-4&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-5" label="Stage II Growth">
        <attvalues>
          <attvalue for="0" value="Stage II Growth" />
          <attvalue for="1" value="Material Science Concept" />
          <attvalue for="2" value="在材料科学中，II区扩展指疲劳裂纹扩展的稳定阶段。其特征是裂纹扩展速率与应力强度因子范围在双对数坐标下呈线性关系，可用帕里斯定律（Paris Law）精确描述。帕里斯指数是该定律中表征材料性能的核心参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-7" label="Fatigue Crack Growth">
        <attvalues>
          <attvalue for="0" value="Fatigue Crack Growth" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="疲劳裂纹扩展指材料在远低于其断裂强度的循环载荷作用下，内部已有裂纹或缺陷发生稳定、渐进性扩展的过程。它是导致工程结构和部件失效的主要模式之一，其微观机制可表现为晶体学开裂等形式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-7&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-8" label="Low Temperatures">
        <attvalues>
          <attvalue for="0" value="Low Temperatures" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="低温是一种物理环境条件。它会使材料（尤其是金属）的脆性增加、韧性降低，从而显著促进或引发沿特定晶体学平面发生的脆性断裂，即晶体学开裂（Crystallographic Cracking）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-9" label="High Strain Rates">
        <attvalues>
          <attvalue for="0" value="High Strain Rates" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="高应变速率是一种材料加载条件，指其在极短时间内发生高速变形。此工况会强烈促进沿特定晶体学平面发生的断裂（即晶体学开裂），是诱发材料表现出脆性断裂特征的重要因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-10" label="Crystallographic Cracking">
        <attvalues>
          <attvalue for="0" value="Crystallographic Cracking" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="**晶体学开裂 (Crystallographic Cracking)**&#10;&#10;一种疲劳裂纹扩展的失效机理，其特征是由平面滑移导致裂纹沿特定的{111}晶面发生。这种开裂现象在低温、高应变率以及低应力强度因子范围(ΔK)的条件下更容易被促进。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-12" label="Planar slip">
        <attvalues>
          <attvalue for="0" value="Planar slip" />
          <attvalue for="1" value="Deformation Mechanism" />
          <attvalue for="2" value="平面滑移是一种晶体形变机制。当材料中可激活的滑移系数量有限时，位错运动被严格限制在特定的滑移面上。这种高度局域化的塑性变形会导致局部应力集中，从而引发沿特定晶面（如{111}面）的晶体学开裂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Planar Slip&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-12&quot;, &quot;chunk-d8d142dae6b416fb1b1609254612e5f8-e-2&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-d8d142dae6b416fb1b1609254612e5f8-e-1" label="Crystallographic cracking on {111} planes">
        <attvalues>
          <attvalue for="0" value="Crystallographic cracking on {111} planes" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="一种沿特定{111}晶面发生的材料断裂失效模式。该现象通常由平面滑移导致：当位错滑移在{111}面上高度集中时，会引发局部应力集中，最终形成并扩展为裂纹。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-d8d142dae6b416fb1b1609254612e5f8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d8d142dae6b416fb1b1609254612e5f8-e-3" label="Limited number of activated slip systems">
        <attvalues>
          <attvalue for="0" value="Limited number of activated slip systems" />
          <attvalue for="1" value="Material Condition" />
          <attvalue for="2" value="指材料中被激活的滑移系数量有限的一种状态。该状态导致位错运动被限制在少数滑移面上，从而使平面滑移成为主导的塑性变形机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d8d142dae6b416fb1b1609254612e5f8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d8d142dae6b416fb1b1609254612e5f8-e-4" label="Higher temperatures and larger AK">
        <attvalues>
          <attvalue for="0" value="Higher temperatures and larger AK" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="一种综合了热与力学载荷的工况，特指材料在较高温度和较大应力强度因子范围（ΔK）共同作用下的状态。该工况会促进材料发生均匀和“波状”滑移，并导致可逆塑性区的尺寸增大。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d8d142dae6b416fb1b1609254612e5f8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="110" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d8d142dae6b416fb1b1609254612e5f8-e-5" label="Reversible plastic zone">
        <attvalues>
          <attvalue for="0" value="Reversible plastic zone" />
          <attvalue for="1" value="Material Region" />
          <attvalue for="2" value="可逆塑性区 (Reversible plastic zone) 是指位于裂纹尖端、发生循环或反向塑性变形的材料区域。在疲劳加载等条件下，该区域的尺寸会随着温度的升高以及应力强度因子范围（ΔK）的增大而相应增大。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d8d142dae6b416fb1b1609254612e5f8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="110" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d8d142dae6b416fb1b1609254612e5f8-e-6" label="Homogeneous and 'wavy' slip">
        <attvalues>
          <attvalue for="0" value="Homogeneous and 'wavy' slip" />
          <attvalue for="1" value="Deformation Mechanism" />
          <attvalue for="2" value="一种材料变形机制，特征为滑移在晶体中均匀分布且滑移线呈波状。它通常在较高温度和较大AK值条件下发生，此时激活的交滑移使位错更容易绕过障碍，形成非平直的滑移轨迹。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-d8d142dae6b416fb1b1609254612e5f8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="110" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d8d142dae6b416fb1b1609254612e5f8-e-7" label="Li, Ashbaugh and Rosenberger [27]">
        <attvalues>
          <attvalue for="0" value="Li, Ashbaugh and Rosenberger [27]" />
          <attvalue for="1" value="Researchers" />
          <attvalue for="2" value="一组研究人员（文献[27]）。他们使用高分辨率扫描电子显微镜（SEM），对在低周疲劳（LCF）条件下的IN100合金断裂表面进行了表征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d8d142dae6b416fb1b1609254612e5f8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d8d142dae6b416fb1b1609254612e5f8-e-8" label="IN100">
        <attvalues>
          <attvalue for="0" value="IN100" />
          <attvalue for="1" value="Material Feature" />
          <attvalue for="2" value="IN100合金在低周疲劳（LCF）条件下形成的断裂表面。该材料特征由Li、Ashbaugh和Rosenberger [27]进行研究，旨在表征其滑移效应。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-d8d142dae6b416fb1b1609254612e5f8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Fracture surfaces of IN100&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d8d142dae6b416fb1b1609254612e5f8-e-8&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d8d142dae6b416fb1b1609254612e5f8-e-10" label="High-resolution SEM microscopy">
        <attvalues>
          <attvalue for="0" value="High-resolution SEM microscopy" />
          <attvalue for="1" value="Characterization Technique" />
          <attvalue for="2" value="高分辨率扫描电子显微镜 (high-resolution SEM) 是一种利用聚焦电子束扫描样品表面的显微分析技术。它通过收集电子束与物质相互作用产生的信号来成像，可提供具有极高放大倍率和纳米级分辨率的图像，用于精确观察和分析材料的表面形貌、微观结构及成分信息。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-d8d142dae6b416fb1b1609254612e5f8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;high-resolution SEM microscopy&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d8d142dae6b416fb1b1609254612e5f8-e-10&quot;, &quot;chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd-e-3&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd-e-1" label="IN100">
        <attvalues>
          <attvalue for="0" value="IN100" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="IN100是一种沉淀强化型镍基铸造高温合金。它以优异的高温强度、抗蠕变和抗氧化性能而著称，主要通过熔模铸造工艺成型，广泛应用于制造航空发动机和燃气轮机中的涡轮叶片、导向叶片等热端关键部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd-e-1&quot;, &quot;chunk-2457bc4af0771717326f8f8489539e06-e-6&quot;, &quot;chunk-f23caa328479b9d419f0d855b9335eb4-e-7&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd-e-6" label="slip band traces">
        <attvalues>
          <attvalue for="0" value="slip band traces" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="滑移带痕迹是一种晶体材料塑性变形后在表面形成的微观线状特征，是内部活动滑移面与材料表面的交线。在疲劳初期阶段，裂纹常沿最大切应力面（即滑移面）扩展，因此其扩展路径在宏观上表现为与滑移带痕迹平行。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd-e-6&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd-e-7" label="{001} facets">
        <attvalues>
          <attvalue for="0" value="{001} facets" />
          <attvalue for="1" value="Crystallographic Feature" />
          <attvalue for="2" value="{001}面是一种出现在材料断口上的晶体学特征，表现为沿{001}晶面的平坦小平面。其出现频率随温度升高而增加，通常与γ'析出物的存在相关联，是特定高温断裂机制的典型标志。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd-e-9" label="Temperature">
        <attvalues>
          <attvalue for="0" value="Temperature" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="作为材料疲劳试验中的一项关键实验条件，指测试期间设定或测量的环境温度。该物理量对材料的疲劳裂纹扩展速率有直接影响，是评估和预测材料在特定热环境下服役性能和寿命的重要参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd-e-9&quot;, &quot;chunk-b8f64fb156fdeb0f33d3fd48ce26370d-e-5&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd-e-10" label="Environment">
        <attvalues>
          <attvalue for="0" value="Environment" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="在材料疲劳实验中，指对IN100合金样品产生影响的外部物理和化学条件。它作为一项关键实验条件，涵盖温度、压力、腐蚀性介质等，并显著影响材料的疲劳裂纹扩展速率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd-e-10&quot;, &quot;chunk-b8f64fb156fdeb0f33d3fd48ce26370d-e-3&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b8f64fb156fdeb0f33d3fd48ce26370d-e-1" label="IN100">
        <attvalues>
          <attvalue for="0" value="IN100" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="IN100是一种材料，其疲劳裂纹扩展速率是一项被重点研究的关键力学性能。此项性能的评估通常在特定环境条件下进行，以预测其在工程应用中的结构可靠性与使用寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-b8f64fb156fdeb0f33d3fd48ce26370d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b8f64fb156fdeb0f33d3fd48ce26370d-e-4" label="Vacuum">
        <attvalues>
          <attvalue for="0" value="Vacuum" />
          <attvalue for="1" value="Experimental Condition" />
          <attvalue for="2" value="一种压力远低于标准大气压（可低至10⁻⁸ atm）的实验环境。在此条件下，由于缺少活性介质，通常会显著降低材料的疲劳裂纹扩展速率。" />
          <attvalue for="3" value="{&quot;pressure_range&quot;: &quot;1 to 10-8 atm&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-b8f64fb156fdeb0f33d3fd48ce26370d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b8f64fb156fdeb0f33d3fd48ce26370d-e-7" label="Dwell Time">
        <attvalues>
          <attvalue for="0" value="Dwell Time" />
          <attvalue for="1" value="Experimental Condition" />
          <attvalue for="2" value="**保载时间 (Dwell Time)**&#10;&#10;一种实验条件，特别是在疲劳或蠕变疲劳试验中，指在每个加载循环的峰值（或谷值）载荷下保持恒定的时间段。该参数是研究材料在持续应力下行为的关键，对疲劳裂纹扩展速率等性能有显著影响。" />
          <attvalue for="3" value="{&quot;duration&quot;: &quot;30 s&quot;, &quot;timing&quot;: &quot;at the peak load&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-b8f64fb156fdeb0f33d3fd48ce26370d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Dwell period&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b8f64fb156fdeb0f33d3fd48ce26370d-e-7&quot;, &quot;chunk-198cb71263c64f896cad9847f29b39cf-e-10&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b8f64fb156fdeb0f33d3fd48ce26370d-e-8" label="Incipient fatigue cracks">
        <attvalues>
          <attvalue for="0" value="Incipient fatigue cracks" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="初期裂纹是一种材料缺陷，指在内部瑕疵处萌生的初始分离。其形成与扩展会降低材料储存的弹性应变能，并最终可能导致结构断裂或失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-b8f64fb156fdeb0f33d3fd48ce26370d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Incipient cracks&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b8f64fb156fdeb0f33d3fd48ce26370d-e-8&quot;, &quot;chunk-047adffb203a8742a16f24b4f8936843-e-6&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-cbf4d780dd2a841aa5348c2c70b0276f-e-2" label="Linear elastic fracture mechanics">
        <attvalues>
          <attvalue for="0" value="Linear elastic fracture mechanics" />
          <attvalue for="1" value="Theoretical Framework" />
          <attvalue for="2" value="一种基于线弹性假设的断裂力学理论框架。它通过分析裂纹尖端的应力场，并利用应力强度因子这一关键参量，来预测材料在载荷作用下的裂纹扩展行为，包括稳定扩展（如巴黎定律描述的疲劳裂纹扩展）和最终的失稳断裂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-cbf4d780dd2a841aa5348c2c70b0276f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cbf4d780dd2a841aa5348c2c70b0276f-e-4" label="Fatigue crack threshold for long cracks">
        <attvalues>
          <attvalue for="0" value="Fatigue crack threshold for long cracks" />
          <attvalue for="1" value="Threshold" />
          <attvalue for="2" value="在疲劳载荷下，长裂纹发生扩展所需的最低应力强度因子范围(ΔK)临界值。当ΔK低于此值时，长裂纹将停止扩展。该阈值是区分长、短裂纹行为的重要材料参数，短裂纹可在其下方继续扩展。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-cbf4d780dd2a841aa5348c2c70b0276f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cbf4d780dd2a841aa5348c2c70b0276f-e-5" label="Turbine disc applications">
        <attvalues>
          <attvalue for="0" value="Turbine disc applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="指涡轮盘在特定工况下的工程应用。在此类应用中，短裂纹扩展是影响其结构完整性和服役寿命的关键因素，因此需要制定精确的寿命预测策略（Lifing policy）以确保运行安全。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-cbf4d780dd2a841aa5348c2c70b0276f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cbf4d780dd2a841aa5348c2c70b0276f-e-6" label="Lifing policy">
        <attvalues>
          <attvalue for="0" value="Lifing policy" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="寿命评定策略（Lifing policy）是一种工程方法论，旨在预测和确定关键部件（如涡轮盘）的安全服役寿命，以防止其在运行中发生失效。该策略包含多种具体准则，例如“首次裂纹寿命法”（Life-to-first-crack method）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-cbf4d780dd2a841aa5348c2c70b0276f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-925bc5f619d7b2214c7a718b66fcfe15-e-1" label="Crack method">
        <attvalues>
          <attvalue for="0" value="Crack method" />
          <attvalue for="1" value="Method" />
          <attvalue for="2" value="Crack方法是一种用于评估涡轮盘的工程方法。与传统损伤容限方法不同，该方法在裂纹扩展至K1c准则所定义的临界长度之前，便预先设定了盘的失效标准，从而提前进行失效判断。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-925bc5f619d7b2214c7a718b66fcfe15" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-925bc5f619d7b2214c7a718b66fcfe15-e-4" label="Traditional damage-tolerant approach">
        <attvalues>
          <attvalue for="0" value="Traditional damage-tolerant approach" />
          <attvalue for="1" value="Method" />
          <attvalue for="2" value="一种传统的结构失效分析方法，与裂纹法相对。它通常不考虑材料中预存裂纹的扩展效应，而是基于整体应力水平、安全系数或无缺陷体的疲劳寿命来评估结构的损伤容限能力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-925bc5f619d7b2214c7a718b66fcfe15" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-925bc5f619d7b2214c7a718b66fcfe15-e-5" label="Dual heat treatment processes">
        <attvalues>
          <attvalue for="0" value="Dual heat treatment processes" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="双重热处理工艺是一种材料加工技术，它使用常规熔炉，旨在使单个构件的不同区域获得差异化的微观结构。该工艺能使构件的孔区（内部）形成细晶粒组织，而在轮缘（表面）形成粗晶粒组织，从而优化特定区域的机械性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-925bc5f619d7b2214c7a718b66fcfe15" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-925bc5f619d7b2214c7a718b66fcfe15-e-5&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-925bc5f619d7b2214c7a718b66fcfe15-e-8" label="Coarse grain size">
        <attvalues>
          <attvalue for="0" value="Coarse grain size" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种材料属性，指材料内部晶粒尺寸较大。它通常是部件边缘区域所需要的一种特定组织结构，可通过双重热处理等工艺获得，用以优化该区域的材料性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-925bc5f619d7b2214c7a718b66fcfe15" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-925bc5f619d7b2214c7a718b66fcfe15-e-8&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-925bc5f619d7b2214c7a718b66fcfe15-e-9" label="Rim">
        <attvalues>
          <attvalue for="0" value="Rim" />
          <attvalue for="1" value="Component Part" />
          <attvalue for="2" value="轮缘区域 (Rim regions) 是指部件边缘或外围的特定功能位置。其设计关键是材料必须具备高抗蠕变性，以抵抗在持续应力和高温作用下发生的缓慢永久变形，从而保证部件的结构完整性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-925bc5f619d7b2214c7a718b66fcfe15" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Rim region&quot;, &quot;Rim regions&quot;, &quot;rim sections&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-925bc5f619d7b2214c7a718b66fcfe15-e-9&quot;, &quot;chunk-476c99d22cc46115c3dc1dca1b6b4708-e-3&quot;, &quot;chunk-a1650d74269b8238062c417df547e98e-e-5&quot;, &quot;chunk-d89de553b45749db88cca84e98f06178-e-6&quot;, &quot;chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f-e-4&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-925bc5f619d7b2214c7a718b66fcfe15-e-10" label="Conventional furnace">
        <attvalues>
          <attvalue for="0" value="Conventional furnace" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="常规炉是一种工业加热设备，通常利用燃料燃烧或电阻产生高温，用于改变材料的性能。作为执行热处理工艺的基础设备，它被广泛应用于包括双重热处理（dual heat treatment）在内的多种热加工流程中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-925bc5f619d7b2214c7a718b66fcfe15" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4d0d33f3cc6eb923cdb179d25235cb3e-e-1" label="Conventional Furnace">
        <attvalues>
          <attvalue for="0" value="Conventional Furnace" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="一种工业热处理设备，在亚固溶温度（Sub-solvus Temperature）条件下运行，专门用于对盘件（Disc）进行初始热处理工序。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-4d0d33f3cc6eb923cdb179d25235cb3e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-4d0d33f3cc6eb923cdb179d25235cb3e-e-2" label="Disc">
        <attvalues>
          <attvalue for="0" value="Disc" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="Disc是一种组件，它通过在传统熔炉中进行两阶段热处理，使其作为构成部分的中心孔(Bore)和外缘(Rim)区域具备不同的材料性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-4d0d33f3cc6eb923cdb179d25235cb3e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-4d0d33f3cc6eb923cdb179d25235cb3e-e-3" label="Bore">
        <attvalues>
          <attvalue for="0" value="Bore" />
          <attvalue for="1" value="Component Part" />
          <attvalue for="2" value="Bore是盘（Disc）的中心部分，作为一个关键的组成构件，它通过亚固溶热处理工艺获得特定的细晶组织以满足性能要求。在工作状态下，它与盘的外缘（Rim）之间存在一个显著的温度梯度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-4d0d33f3cc6eb923cdb179d25235cb3e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;bore&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4d0d33f3cc6eb923cdb179d25235cb3e-e-3&quot;, &quot;chunk-ca9e8043d267b5456310acc3e6414a07-e-12&quot;, &quot;chunk-150175465cd3482592c4a1c003a558af-e-5&quot;, &quot;chunk-717d24299fbce8d4fb4707450c5ac643-e-7&quot;, &quot;chunk-7a1f5be456518061b87546ca7f9d9812-e-9&quot;, &quot;chunk-d89de553b45749db88cca84e98f06178-e-5&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-4d0d33f3cc6eb923cdb179d25235cb3e-e-4" label="Sub-solvus Temperature">
        <attvalues>
          <attvalue for="0" value="Sub-solvus Temperature" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="一种热处理工艺参数，指低于合金固溶线（solvus line）的温度范围。在此温度下进行热处理，材料中的强化相不完全溶解，从而获得细化的晶粒组织，用以优化盘件孔部等关键区域的力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-4d0d33f3cc6eb923cdb179d25235cb3e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4d0d33f3cc6eb923cdb179d25235cb3e-e-4&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4d0d33f3cc6eb923cdb179d25235cb3e-e-5" label="Second Furnace">
        <attvalues>
          <attvalue for="0" value="Second Furnace" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="Second Furnace是一种精密热处理设备。它通过选择性地加热圆盘工件的边缘（Rim），并结合使用冷却气体（Cooling Gas），在工件的中心孔与边缘之间制造出陡峭的温度梯度，以实现特定的热处理工艺。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-4d0d33f3cc6eb923cdb179d25235cb3e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-4d0d33f3cc6eb923cdb179d25235cb3e-e-6" label="Rim">
        <attvalues>
          <attvalue for="0" value="Rim" />
          <attvalue for="1" value="Component Part" />
          <attvalue for="2" value="盘件的外缘部分。在第二热处理炉中，该部分被加热至超固溶线温度，从而与盘件内孔（Bore）形成一个特定的热梯度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-4d0d33f3cc6eb923cdb179d25235cb3e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-4d0d33f3cc6eb923cdb179d25235cb3e-e-7" label="Super-solvus Temperature">
        <attvalues>
          <attvalue for="0" value="Super-solvus Temperature" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="超固溶线温度是一种热处理工艺参数，指高于合金材料固溶线的温度。在此温度下，合金中的强化相会完全溶解，以形成均匀的固溶体组织。它特指在特定热处理阶段，盘件轮缘区域所要达到并保持的目标温度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-4d0d33f3cc6eb923cdb179d25235cb3e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4d0d33f3cc6eb923cdb179d25235cb3e-e-7&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4d0d33f3cc6eb923cdb179d25235cb3e-e-8" label="Cooling Gas">
        <attvalues>
          <attvalue for="0" value="Cooling Gas" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种用于第二熔炉等设备中的气态物质。其主要作用是通过快速降温，在特定区域内建立一个陡峭的温度梯度，这种精确的温控对于满足特定工业流程或科学实验的要求至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-4d0d33f3cc6eb923cdb179d25235cb3e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Cooling gas&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4d0d33f3cc6eb923cdb179d25235cb3e-e-8&quot;, &quot;chunk-d015db7235325173c4b776781906ae0b-e-1&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-d015db7235325173c4b776781906ae0b-e-3" label="Heat treatment step">
        <attvalues>
          <attvalue for="0" value="Heat treatment step" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种热处理工艺步骤，指在制造过程中，向工件的内孔区域施加冷却气体，以精确控制其冷却速率，从而改变材料的物理特性并获得所需的组织结构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d015db7235325173c4b776781906ae0b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d015db7235325173c4b776781906ae0b-e-4" label="Insulating materials">
        <attvalues>
          <attvalue for="0" value="Insulating materials" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种具有低导热性的材料，常用于熔炉等高温设备中。其主要功能是通过阻碍热量传递来减少热量损失，从而帮助建立并维持工艺所需的特定温度梯度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d015db7235325173c4b776781906ae0b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d015db7235325173c4b776781906ae0b-e-6" label="Temperature gradients">
        <attvalues>
          <attvalue for="0" value="Temperature gradients" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="温度梯度是一种物理现象，指温度在空间上的变化率。在热循环过程中，材料内部会形成不均匀的温度分布即温度梯度，这是导致材料因热应力不均而发生分层失效（Delamination）的一种主要驱动力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-d015db7235325173c4b776781906ae0b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;temperature gradient&quot;, &quot;temperature gradients&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d015db7235325173c4b776781906ae0b-e-6&quot;, &quot;chunk-4f1eb842a2e3520e40274bedacb6597f-e-2&quot;, &quot;chunk-86085af24c3d22aa7ef748be1713da2e-e-4&quot;, &quot;chunk-40762f1b619063834a1784b067d301ee-e-8&quot;, &quot;chunk-a9fba026e3b8980c4957dbe16260f585-e-4&quot;, &quot;chunk-502aba15d381acd1fe322927c6f750ed-e-5&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-d015db7235325173c4b776781906ae0b-e-7" label="Thermocoupling and controller systems">
        <attvalues>
          <attvalue for="0" value="Thermocoupling and controller systems" />
          <attvalue for="1" value="Control System" />
          <attvalue for="2" value="一种由热电偶（作为温度传感器）与控制器集成的控制系统。该系统通过实时监测温度并进行调节，以实现和维持所需的温度水平，是精密温度控制应用中的必要组成部分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d015db7235325173c4b776781906ae0b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="174" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d015db7235325173c4b776781906ae0b-e-8" label="Temperature control">
        <attvalues>
          <attvalue for="0" value="Temperature control" />
          <attvalue for="1" value="Process Control" />
          <attvalue for="2" value="一种过程控制技术，旨在通过使用热电偶等温度传感器和控制器系统，对特定对象或过程的温度进行测量与调节，使其稳定在预设的设定值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-d015db7235325173c4b776781906ae0b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="174" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d015db7235325173c4b776781906ae0b-e-9" label="Rene 104">
        <attvalues>
          <attvalue for="0" value="Rene 104" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="Rene 104是一种试验性粉末高温合金，专为制造军用涡轮盘等高温承力部件而开发。该合金通过控制ASTM晶粒尺寸等微观结构来优化性能，但目前其相关技术仍处于试验阶段，尚未投入生产应用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-d015db7235325173c4b776781906ae0b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Rene 104 powder superalloy&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d015db7235325173c4b776781906ae0b-e-9&quot;, &quot;chunk-c59c4008e266198b10130c9d3679b582-e-1&quot;, &quot;chunk-3031ff2205f827feea0affe73ca7d2ae-e-5&quot;, &quot;chunk-35f68dab755d8efb78530fe9fc2cf841-e-3&quot;, &quot;chunk-ae682ac4e4eb339bd48233482011cdd1-e-18&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-d015db7235325173c4b776781906ae0b-e-10" label="Trials">
        <attvalues>
          <attvalue for="0" value="Trials" />
          <attvalue for="1" value="Test" />
          <attvalue for="2" value="指对特定技术或材料（如高温合金Rene 104）所进行的一系列实验性测试，旨在验证、评估其性能与可行性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-d015db7235325173c4b776781906ae0b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c59c4008e266198b10130c9d3679b582-e-2" label="ASTM grain size">
        <attvalues>
          <attvalue for="0" value="ASTM grain size" />
          <attvalue for="1" value="Standard" />
          <attvalue for="2" value="ASTM晶粒度是由美国材料与试验协会(ASTM)制定，用于评定金属等材料中晶粒尺寸的工业标准。它使用一个无量纲的等级号进行表征，数值越大代表实际晶粒越细小。该等级号与材料的微观结构和力学性能直接相关。" />
          <attvalue for="3" value="{&quot;rim_value&quot;: &quot;6&quot;, &quot;bore_value&quot;: &quot;about 11&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c59c4008e266198b10130c9d3679b582" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;ASTM grain sizes&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-27e744dfd57dfdad9eeacf1afe66f2e9-e-2&quot;, &quot;chunk-c59c4008e266198b10130c9d3679b582-e-2&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c59c4008e266198b10130c9d3679b582-e-3" label="Transition zone">
        <attvalues>
          <attvalue for="0" value="Transition zone" />
          <attvalue for="1" value="Region" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;指Rene 104粉末高温合金材料中的一个特定物理区域，其特征是ASTM晶粒尺寸在此区域内发生梯度变化或过渡。" />
          <attvalue for="3" value="{&quot;length&quot;: &quot;about 50 mm&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c59c4008e266198b10130c9d3679b582" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c59c4008e266198b10130c9d3679b582-e-4" label="Turbine discs for military applications">
        <attvalues>
          <attvalue for="0" value="Turbine discs for military applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="军用涡轮盘是一种应用领域。在此应用中，采用特定工艺加工的Rene 104粉末高温合金来制造涡轮盘，被证实具有显著优势，是该材料的理想应用方向。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c59c4008e266198b10130c9d3679b582" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4fd900e79f8eed0adbe03897dc24fda9-e-1" label="Grain-boundary elements">
        <attvalues>
          <attvalue for="0" value="Grain-boundary elements" />
          <attvalue for="1" value="Material Additive" />
          <attvalue for="2" value="晶界元素是指在多晶材料中，选择性偏析或富集于晶粒间界面的化学元素。它们能够显著影响材料的力学、电学或化学性能，但其具体作用机制通常复杂且尚存争议，是材料科学领域的一个重要研究方向。" />
          <attvalue for="3" value="{&quot;condition&quot;: &quot;added in small quantities&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-4fd900e79f8eed0adbe03897dc24fda9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4fd900e79f8eed0adbe03897dc24fda9-e-1&quot;, &quot;chunk-001e173127ba04e558ad53ba47c3764c-e-1&quot;, &quot;chunk-c000c9e441af2d51c033dcc75d8753cc-e-5&quot;, &quot;chunk-61584d620a7ea3197cac715cb4ce2e82-e-2&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-4fd900e79f8eed0adbe03897dc24fda9-e-5" label="Low-cycle-fatigue resistance">
        <attvalues>
          <attvalue for="0" value="Low-cycle-fatigue resistance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="低周疲劳抗性（Low-cycle-fatigue resistance）指材料在反复的高应力或高应变循环下抵抗失效的能力。作为一项关键的材料力学性能，它可以通过添加特定的晶界元素来强化晶界，从而得到有效增强。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-4fd900e79f8eed0adbe03897dc24fda9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4fd900e79f8eed0adbe03897dc24fda9-e-7" label="Work of cohesion">
        <attvalues>
          <attvalue for="0" value="Work of cohesion" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="内聚功（Work of cohesion）是一种物理性能，指沿单位面积将材料内部可逆地分离成两个表面时所需要的能量，用以衡量材料内部原子间结合的强度。当晶界元素在特定合金的γ/γ'界面发生偏聚时，会提高该界面的内聚功，从而增强其结合强度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-4fd900e79f8eed0adbe03897dc24fda9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4fd900e79f8eed0adbe03897dc24fda9-e-7&quot;, &quot;chunk-001e173127ba04e558ad53ba47c3764c-e-2&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-4fd900e79f8eed0adbe03897dc24fda9-e-8" label="Creep rupture strength">
        <attvalues>
          <attvalue for="0" value="Creep rupture strength" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="蠕变断裂强度指材料在高温和恒定应力作用下，经过一定时间后发生断裂时所能承受的应力值。它是衡量材料在高温下长期承载能力和抗蠕变性能的重要力学指标，对于高温合金等材料的设计和应用至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-4fd900e79f8eed0adbe03897dc24fda9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;creep rupture strength&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4fd900e79f8eed0adbe03897dc24fda9-e-8&quot;, &quot;chunk-001e173127ba04e558ad53ba47c3764c-e-3&quot;, &quot;chunk-3f04709d6681598a00c3a9a4a76620aa-e-9&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-001e173127ba04e558ad53ba47c3764c-e-5" label="Low-cycle-fatigue behaviour">
        <attvalues>
          <attvalue for="0" value="Low-cycle-fatigue behaviour" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="低周疲劳行为是一种力学性能，指材料在足以引起显著塑性变形的循环载荷作用下，在较少循环次数内萌生裂纹并断裂的现象。它是衡量材料在强应变条件下抵抗失效能力的关键指标，可通过增加材料的内聚功等方式来改善。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-001e173127ba04e558ad53ba47c3764c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-001e173127ba04e558ad53ba47c3764c-e-5&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-001e173127ba04e558ad53ba47c3764c-e-6" label="Borides">
        <attvalues>
          <attvalue for="0" value="Borides" />
          <attvalue for="1" value="Precipitate" />
          <attvalue for="2" value="硼化物是硼与电负性较低的元素（通常为金属或类金属）形成的一类化合物。因硼原子间可形成强大的共价键网络，硼化物通常具有极高的硬度、熔点和化学稳定性。它们被广泛应用于制造耐火材料、磨料、切削工具及先进陶瓷等领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-001e173127ba04e558ad53ba47c3764c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;borides&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-001e173127ba04e558ad53ba47c3764c-e-6&quot;, &quot;chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f-e-10&quot;, &quot;chunk-61a441c3ea495edfbd1f923ab25e12c9-e-14&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-001e173127ba04e558ad53ba47c3764c-e-7" label="Carbides">
        <attvalues>
          <attvalue for="0" value="Carbides" />
          <attvalue for="1" value="Precipitate" />
          <attvalue for="2" value="碳化物是碳与电负性较低的元素（通常为金属或准金属）形成的化合物。这类化合物通常具有高硬度和高熔点。在金属合金中，它们常以沉淀相的形式存在于晶界，其分布和形态对材料的强度、韧性和耐腐蚀性等性能有决定性影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-001e173127ba04e558ad53ba47c3764c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;carbides&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-001e173127ba04e558ad53ba47c3764c-e-7&quot;, &quot;chunk-c4fe22a34792a9a7cb4e8b1e16f25e2f-e-9&quot;, &quot;chunk-2f922c93a3f1955e166d2270226ee05e-e-7&quot;, &quot;chunk-0ba22e2612dbc225416101c15d4cb857-e-10&quot;, &quot;chunk-870742dec10263e0078e94a0b6a827aa-e-3&quot;, &quot;chunk-64f0b642dc984a92646a132ee856bc18-e-18&quot;, &quot;chunk-cad1eaa9ffb0e731892120bbe3415da7-e-3&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-6007146f18f54e1531784eefc3822dae-e-5" label="Zirconium">
        <attvalues>
          <attvalue for="0" value="Zirconium" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="锆（Zirconium）是一种化学元素，符号为Zr，原子序数为40。它是一种呈银白色的过渡金属，具有极强的抗腐蚀性。由于其极低的中子吸收截面，锆合金被广泛用作核反应堆中的核燃料包壳材料。此外，它也用于制造特种合金和耐腐蚀化工设备。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-6007146f18f54e1531784eefc3822dae" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Zirconium (Zr)&quot;, &quot;Zr&quot;, &quot;zirconium&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6007146f18f54e1531784eefc3822dae-e-5&quot;, &quot;chunk-804bbac328e38b8447144e9fc384514f-e-3&quot;, &quot;chunk-7f5d267485eb6b44a173a04ba9a301e4-e-6&quot;, &quot;chunk-61584d620a7ea3197cac715cb4ce2e82-e-7&quot;, &quot;chunk-a8e2ede64fab8f44656d400d86989bf1-e-4&quot;, &quot;chunk-b674e36d570cafb7928d33912e7c1b02-e-4&quot;, &quot;chunk-11fd3f8dd428533f2dacdd280d5458c0-e-5&quot;, &quot;chunk-1b1d17125a9be9ae98260d7ef4e48178-e-5&quot;, &quot;chunk-f61cdab914bad0a421a3603e3cce6172-e-1&quot;, &quot;chunk-7638042a561888cfdce1fb2ee9ad0428-e-8&quot;, &quot;chunk-bc88baa62dfcfaa0545bb367cad979a7-e-6&quot;, &quot;chunk-dbe450c14d87c9df145aceea4a48b35c-e-4&quot;, &quot;chunk-2ae64e13937ad7ab215b73765cbe0ff3-e-11&quot;, &quot;chunk-ad330a92e751427aaea8ad592c6975d4-e-6&quot;, &quot;chunk-cd90df188efe63a1aba2d62ab225c3ae-e-15&quot;, &quot;chunk-78c519f8cce4113c48c714a60ca273ce-e-4&quot;, &quot;chunk-db7cc890c68f0a43d000b2dba6ecf910-e-7&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="10" />
        </attvalues>
      </node>
      <node id="chunk-6007146f18f54e1531784eefc3822dae-e-7" label="Phosphorus">
        <attvalues>
          <attvalue for="0" value="Phosphorus" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="磷是一种化学元素，符号为P，原子序数为15。作为一种非金属元素，它在冶金学中常被视为有害的杂质（“tramp element”），会损害金属材料的机械性能，例如导致钢材脆化。锆（Zirconium）等元素可作为其吸杂剂（getter），用于消除其不利影响。" />
          <attvalue for="3" value="{&quot;classification&quot;: &quot;deleterious tramp element&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-6007146f18f54e1531784eefc3822dae" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6007146f18f54e1531784eefc3822dae-e-7&quot;, &quot;chunk-c000c9e441af2d51c033dcc75d8753cc-e-4&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c000c9e441af2d51c033dcc75d8753cc-e-1" label="Segregant">
        <attvalues>
          <attvalue for="0" value="Segregant" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="一种材料组分，在材料中充当捕获剂（getter）。它能选择性地结合并固定有害的杂质元素（Tramp elements），从而消除其对材料性能的不利影响，起到净化提纯的作用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-c000c9e441af2d51c033dcc75d8753cc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c000c9e441af2d51c033dcc75d8753cc-e-6" label="Garosshen et al. [33]">
        <attvalues>
          <attvalue for="0" value="Garosshen et al. [33]" />
          <attvalue for="1" value="Researcher" />
          <attvalue for="2" value="以Garosshen为代表的研究团队。该团队因其对一种实验性粉末冶金(P/M)合金的机械性能进行的研究而知名，相关成果在学术文献中被引为参考文献[33]。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c000c9e441af2d51c033dcc75d8753cc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="175" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c000c9e441af2d51c033dcc75d8753cc-e-7" label="Experimental P/M alloy">
        <attvalues>
          <attvalue for="0" value="Experimental P/M alloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种实验性的粉末冶金（P/M）合金。Garosshen等人（参考文献[33]）曾为探究其特性而对其力学性能进行了专门研究。" />
          <attvalue for="3" value="{&quot;base_composition&quot;: &quot;Ni–19Co-12.5Cr-5Al–4.4Ti–3.3Mo&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c000c9e441af2d51c033dcc75d8753cc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c000c9e441af2d51c033dcc75d8753cc-e-7&quot;]}]" />
          <attvalue for="9" value="175" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-804bbac328e38b8447144e9fc384514f-e-1" label="P/M alloy Ni–19Co-12.5Cr-5Al–4.4Ti–3.3Mo">
        <attvalues>
          <attvalue for="0" value="P/M alloy Ni–19Co-12.5Cr-5Al–4.4Ti–3.3Mo" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种通过粉末冶金（P/M）工艺制造的实验性镍基合金。该合金以镍(Ni)为基体，含有钴(Co)、铬(Cr)等多种元素，并通过添加微量的硼(B)、锆(Zr)和碳(C)进行掺杂。其主要研究方向是蠕变断裂寿命等力学性能。" />
          <attvalue for="3" value="{&quot;base_composition&quot;: &quot;Ni–19Co-12.5Cr-5Al–4.4Ti–3.3Mo (wt%)&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-804bbac328e38b8447144e9fc384514f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-804bbac328e38b8447144e9fc384514f-e-4" label="Carbon">
        <attvalues>
          <attvalue for="0" value="Carbon" />
          <attvalue for="1" value="Dopant" />
          <attvalue for="2" value="碳（Carbon）是一种用于粉末冶金（P/M）合金的元素掺杂剂。在0.003 wt%（重量百分比）的浓度下，其添加具有有益效果，但当浓度进一步增加至0.06 wt%时，效果不再提升。该元素的添加不影响合金的蠕变断裂寿命。" />
          <attvalue for="3" value="{&quot;beneficial_concentration&quot;: &quot;0.003 wt%&quot;, &quot;ineffective_concentration&quot;: &quot;0.06 wt%&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-804bbac328e38b8447144e9fc384514f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-804bbac328e38b8447144e9fc384514f-e-5" label="Creep Rupture Life">
        <attvalues>
          <attvalue for="0" value="Creep Rupture Life" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="蠕变断裂寿命是一种机械性能，指材料在特定高温（如732°C）和恒定应力（如655MPa）下，从承受载荷到发生断裂所需的时间。它是评估P/M镍基高温合金等材料耐用性的关键指标，其长短会因硼、锆、碳等掺杂元素的组合而显著改变。" />
          <attvalue for="3" value="{&quot;test_temperature&quot;: &quot;732 °C&quot;, &quot;test_stress&quot;: &quot;655 MPa&quot;, &quot;undoped_value&quot;: &quot;&lt; 0.1 h&quot;, &quot;doped_value&quot;: &quot;69h&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-804bbac328e38b8447144e9fc384514f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-804bbac328e38b8447144e9fc384514f-e-5&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-804bbac328e38b8447144e9fc384514f-e-6" label="Dopant Combination (0.02%B, 0.05%Zr, 0.003%C)">
        <attvalues>
          <attvalue for="0" value="Dopant Combination (0.02%B, 0.05%Zr, 0.003%C)" />
          <attvalue for="1" value="Material Additive" />
          <attvalue for="2" value="一种由0.02%硼(B)、0.05%锆(Zr)和0.003%碳(C)构成的特定材料添加剂。作为一种复合掺杂剂，它被用于粉末冶金(P/M)镍基高温合金中，以显著提高材料的蠕变断裂寿命。" />
          <attvalue for="3" value="{&quot;composition&quot;: &quot;0.02 wt%B, 0.05 wt%Zr, 0.003 wt%C&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-804bbac328e38b8447144e9fc384514f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0af77caf506bcb6ff459691ed394fb4f-e-1" label="Boron additions">
        <attvalues>
          <attvalue for="0" value="Boron additions" />
          <attvalue for="1" value="Material Addition" />
          <attvalue for="2" value="指在材料中添加超过其溶解度极限的硼。该过程是一种材料改性方法，它会导致M3B2型化合物的形成或析出，但通常并不会对材料的整体机械性能带来改善。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-0af77caf506bcb6ff459691ed394fb4f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0af77caf506bcb6ff459691ed394fb4f-e-2" label="M3B2 compound">
        <attvalues>
          <attvalue for="0" value="M3B2 compound" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="M3B2化合物是一种化学式为M3B2的金属硼化物相。它通常因材料（如合金）中添加了过量的硼元素，而在晶界处以晶间析出物的形式形成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-0af77caf506bcb6ff459691ed394fb4f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0af77caf506bcb6ff459691ed394fb4f-e-4" label="Strengthening effect of boron">
        <attvalues>
          <attvalue for="0" value="Strengthening effect of boron" />
          <attvalue for="1" value="Material Phenomenon" />
          <attvalue for="2" value="指通过添加微量硼元素来提高材料强度的一种现象。其机理通常是硼原子在晶界偏聚，增强晶界结合力并抑制沿晶断裂，而非通过形成硬质的硼化物相。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0af77caf506bcb6ff459691ed394fb4f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="176" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0af77caf506bcb6ff459691ed394fb4f-e-5" label="Formation of borides">
        <attvalues>
          <attvalue for="0" value="Formation of borides" />
          <attvalue for="1" value="Material Process" />
          <attvalue for="2" value="一种制备硼化物的材料工艺。指通过化学反应，使硼元素与一种或多种更正电性的元素（通常是金属）结合，生成具有高硬度、高熔点和化学惰性等特性的二元或多元化合物的过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-0af77caf506bcb6ff459691ed394fb4f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0af77caf506bcb6ff459691ed394fb4f-e-5&quot;]}]" />
          <attvalue for="9" value="176" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0af77caf506bcb6ff459691ed394fb4f-e-6" label="Additions of carbon, boron and zirconium">
        <attvalues>
          <attvalue for="0" value="Additions of carbon, boron and zirconium" />
          <attvalue for="1" value="Material Addition" />
          <attvalue for="2" value="一种材料合金化工艺，指将碳(C)、硼(B)和锆(Zr)三种元素复合添加至基体材料中以改善其性能。该特定的复合添加组合不会对材料中γ'相（伽马撇相）的形貌产生影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0af77caf506bcb6ff459691ed394fb4f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="177" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0af77caf506bcb6ff459691ed394fb4f-e-7" label="Morphology of the γ' phase">
        <attvalues>
          <attvalue for="0" value="Morphology of the γ' phase" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="γ'相形态是镍基高温合金中的一种关键显微结构特征，指其主要强化相（γ'相）析出物的形状（如球状、立方形）、尺寸、空间分布及体积分数。该形态是决定合金高温强度和蠕变抗力等力学性能的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-0af77caf506bcb6ff459691ed394fb4f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Morphology of the y' phase&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0af77caf506bcb6ff459691ed394fb4f-e-7&quot;]}]" />
          <attvalue for="9" value="177" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-28369a1f48e0d9ccd0e560147c06b368-e-3" label="Boron-doped IN718">
        <attvalues>
          <attvalue for="0" value="Boron-doped IN718" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="掺硼IN718是一种通过添加硼元素进行改性的IN718高温合金。研究证实，硼的掺杂显著影响了该材料的疲劳裂纹路径曲折度，其疲劳裂纹扩展速率的研究结果也与此发现相符，使其成为研究疲劳失效机制的特定材料变体。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-28369a1f48e0d9ccd0e560147c06b368" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-28369a1f48e0d9ccd0e560147c06b368-e-3&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-28369a1f48e0d9ccd0e560147c06b368-e-4" label="Tortuosity of the fatigue crack path">
        <attvalues>
          <attvalue for="0" value="Tortuosity of the fatigue crack path" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一项量化疲劳裂纹扩展路径几何复杂性的材料属性，指裂纹路径的弯曲、偏折程度。较高的曲折度能有效阻碍裂纹扩展，从而提升材料性能。在IN718合金等材料中，可通过硼掺杂等方式显著提高此特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-28369a1f48e0d9ccd0e560147c06b368" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-28369a1f48e0d9ccd0e560147c06b368-e-5" label="Boron doping">
        <attvalues>
          <attvalue for="0" value="Boron doping" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="一项工艺参数，指在IN718合金中添加硼元素。在此工艺中，硼含量从12 ppm提高至29 ppm，从而增加了材料疲劳裂纹路径的曲折度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-28369a1f48e0d9ccd0e560147c06b368" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-28369a1f48e0d9ccd0e560147c06b368-e-5&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-28369a1f48e0d9ccd0e560147c06b368-e-6" label="12 ppm">
        <attvalues>
          <attvalue for="0" value="12 ppm" />
          <attvalue for="1" value="Concentration" />
          <attvalue for="2" value="12 ppm（百万分率）是一个浓度值，特指硼掺杂的初始水平。该数值是后续掺杂浓度增加前的起始基准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-28369a1f48e0d9ccd0e560147c06b368" />
