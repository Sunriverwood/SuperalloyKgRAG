      <edge source="chunk-2582edaf6620b68f12a09bd6df3bb24c-e-3" target="chunk-2582edaf6620b68f12a09bd6df3bb24c-e-4" id="chunk-2582edaf6620b68f12a09bd6df3bb24c-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="INTENDED_FOR" />
          <attvalue for="12" value="Dual microstructure discs are not yet used in gas turbine engines but are expected to be in the near future." />
          <attvalue for="13" value="At the time of writing, dual microstructure discs have yet to be employed in the gas turbine engine, but this situation is likely to change in the near future." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-2582edaf6620b68f12a09bd6df3bb24c" />
          <attvalue for="16" value="0.5" />
