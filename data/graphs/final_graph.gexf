        <attvalues>
          <attvalue for="11" value="REPLACED_BY" />
          <attvalue for="12" value="In the final equation, the variable r₁ is replaced by r to generalize the result for a uniform distribution of particles." />
          <attvalue for="13" value="where r₁ has been replaced by r since the result will be valid for the general case of a uniform distribution of particles." />
          <attvalue for="14" value="r-5" />
