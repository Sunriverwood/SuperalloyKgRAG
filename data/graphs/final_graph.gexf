      <edge source="chunk-89e037006a60ff84d312fb1878f7b7ba-e-3" target="chunk-dc7beb2c110a0e2f253f174dddd75d00-e-3" id="chunk-89e037006a60ff84d312fb1878f7b7ba-r-2" weight="4.0">
        <attvalues>
          <attvalue for="11" value="CONTEXTUALIZES_USE_OF" />
          <attvalue for="12" value="The era of jet-powered civil aviation, starting in the 1950s, provides the timeframe for the use of superalloys in improving gas turbine engines." />
          <attvalue for="13" value="since the 1950s when the age of jet- powered civil aviation began, the superalloys have underpinned the improvements in per- formance of the modern gas turbine engine [1]." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-89e037006a60ff84d312fb1878f7b7ba" />
          <attvalue for="16" value="0.001491779343617089" />
          <attvalue for="17" value="0.2675617342728369" />
        </attvalues>
      </edge>
      <edge source="chunk-6ef562415fc4e831401481f93072dca3-e-2" target="chunk-6ef562415fc4e831401481f93072dca3-e-3" id="chunk-6ef562415fc4e831401481f93072dca3-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="USED_FOR" />
          <attvalue for="12" value="The Ghost engine was used for the first commercial flight of the Comet I." />
          <attvalue for="13" value="Today's designs are appreciably superior to the Ghost engine used for the first commercial flight of the Comet I" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-6ef562415fc4e831401481f93072dca3" />
          <attvalue for="16" value="0.001733140274669826" />
          <attvalue for="17" value="0.4010398841648019" />
        </attvalues>
      </edge>
      <edge source="chunk-c66ff8a529b9512996f0b3af456f00ce-e-2" target="chunk-35e59a51ed8121212e1426f0053ba534-e-9" id="chunk-c66ff8a529b9512996f0b3af456f00ce-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="NORMALIZED_BY" />
          <attvalue for="12" value="The engine weight is evaluated relative to the thrust it develops." />
          <attvalue for="13" value="the engine weight, when normalised against the thrust developed, is lower by about a factor of 4." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-c66ff8a529b9512996f0b3af456f00ce" />
          <attvalue for="16" value="0.0026545566232284673" />
          <attvalue for="17" value="0.4015927339739371" />
        </attvalues>
      </edge>
      <edge source="chunk-c66ff8a529b9512996f0b3af456f00ce-e-9" target="chunk-dc7beb2c110a0e2f253f174dddd75d00-e-3" id="chunk-c66ff8a529b9512996f0b3af456f00ce-r-7" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_PROPERTY_OF" />
          <attvalue for="12" value="Fatigue is a critical property of the superalloys." />
          <attvalue for="13" value="As the composi- tions of the alloys have evolved, the critical properties in creep and fatigue have impro" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-c66ff8a529b9512996f0b3af456f00ce" />
          <attvalue for="16" value="0.001491779343617089" />
          <attvalue for="17" value="0.4008950676061703" />
        </attvalues>
      </edge>
      <edge source="chunk-f1dbde91fa2668ef8c190d0d43e91e27-e-1" target="chunk-966af38b21cd6fefe9490e0dc9e97393-e-5" id="chunk-f1dbde91fa2668ef8c190d0d43e91e27-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_IMPROVED_PROPERTY" />
          <attvalue for="12" value="The creep properties of the alloys have improved markedly." />
          <attvalue for="13" value="the critical properties in creep and fatigue have improved markedly" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-f1dbde91fa2668ef8c190d0d43e91e27" />
          <attvalue for="16" value="0.0008674531575294934" />
          <attvalue for="17" value="0.4005204718945177" />
        </attvalues>
      </edge>
      <edge source="chunk-f1dbde91fa2668ef8c190d0d43e91e27-e-1" target="chunk-f1dbde91fa2668ef8c190d0d43e91e27-e-3" id="chunk-f1dbde91fa2668ef8c190d0d43e91e27-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_IMPROVED_PROPERTY" />
          <attvalue for="12" value="The fatigue properties of the alloys have improved markedly." />
          <attvalue for="13" value="the critical properties in creep and fatigue have improved markedly" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-f1dbde91fa2668ef8c190d0d43e91e27" />
          <attvalue for="16" value="0.00028915105250983114" />
          <attvalue for="17" value="0.4001734906315059" />
        </attvalues>
      </edge>
      <edge source="chunk-f1dbde91fa2668ef8c190d0d43e91e27-e-3" target="chunk-8debf02eecb6d1c5cb6982c6f0228498-e-2" id="chunk-f1dbde91fa2668ef8c190d0d43e91e27-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IMPROVEMENT_ALLOWED_INCREASE_IN" />
          <attvalue for="12" value="The improvement in fatigue properties allowed the turbine entry temperature to be increased." />
          <attvalue for="13" value="the critical properties in creep and fatigue have improved markedly – and this has allowed the turbine entry temperature to be increased beyond 1700 K" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-f1dbde91fa2668ef8c190d0d43e91e27" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-f1dbde91fa2668ef8c190d0d43e91e27-e-5" target="chunk-f1dbde91fa2668ef8c190d0d43e91e27-e-1" id="chunk-f1dbde91fa2668ef8c190d0d43e91e27-r-5" weight="4.0">
        <attvalues>
          <attvalue for="11" value="AIDED_DEVELOPMENT_OF" />
          <attvalue for="12" value="The development of new processes played a key role in the context of alloy evolution and property improvement." />
          <attvalue for="13" value="The development of new processes has played a key role too" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-f1dbde91fa2668ef8c190d0d43e91e27" />
          <attvalue for="16" value="0.0011566042100393246" />
          <attvalue for="17" value="0.26736062919269027" />
        </attvalues>
      </edge>
