      <node id="chunk-a584f7fe38f352b7318e0169178d3d01-e-10" label="M. McLean">
        <attvalues>
          <attvalue for="0" value="M. McLean" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="M. McLean是一位作家，其撰写的专著《Directionally Solidified Materials for High Temperature Service》（高温应用定向凝固材料）是材料科学领域的代表性作品之一，主要探讨了先进高温合金的定向凝固技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-a584f7fe38f352b7318e0169178d3d01" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="127" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a584f7fe38f352b7318e0169178d3d01-e-11" label="Directionally Solidified Materials for High Temperature Service">
        <attvalues>
          <attvalue for="0" value="Directionally Solidified Materials for High Temperature Service" />
          <attvalue for="1" value="Book" />
          <attvalue for="2" value="《Directionally Solidified Materials for High Temperature Service》是由M. McLean撰写，The Metals Society出版的一部学术专著。该书系统地阐述了适用于高温服役环境的定向凝固材料的科学原理、制备工艺与性能应用。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1983&quot;}" />
