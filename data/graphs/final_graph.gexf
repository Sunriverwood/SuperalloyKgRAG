          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-98004d55693f7f9432c5daf0464e7353-e-4" label="K₁c">
        <attvalues>
          <attvalue for="0" value="K₁c" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="K1c准则，即平面应变断裂韧性（K_Ic），是衡量材料抵抗脆性断裂的固有属性。在断裂力学中，它定义了I型（张开型）加载下裂纹发生失稳扩展的临界应力强度因子值，一旦达到该值，材料将发生快速失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-98004d55693f7f9432c5daf0464e7353" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;K1c&quot;, &quot;K1c criterion&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-925bc5f619d7b2214c7a718b66fcfe15-e-3&quot;, &quot;chunk-d6cd281784308ff093a41e825b50764e-e-7&quot;, &quot;chunk-e77911125f8830a7b4bf67b20165ed0e-e-7&quot;, &quot;chunk-98004d55693f7f9432c5daf0464e7353-e-4&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-98004d55693f7f9432c5daf0464e7353-e-6" label="Paris Law">
        <attvalues>
          <attvalue for="0" value="Paris Law" />
          <attvalue for="1" value="Model" />
          <attvalue for="2" value="Paris relationship（帕里斯定律）是断裂力学中的一个核心模型，用于描述材料疲劳裂纹的稳定扩展阶段。它建立了裂纹扩展速率（da/dN）与应力强度因子范围（ΔK）之间的幂律关系，其通用形式为 da/dN = C(ΔK)^m，广泛用于预测多晶镍基高温合金等金属材料的疲劳寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-98004d55693f7f9432c5daf0464e7353" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Paris Law regime&quot;, &quot;Paris equation&quot;, &quot;Paris law&quot;, &quot;Paris law expression&quot;, &quot;Paris relationship&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-98004d55693f7f9432c5daf0464e7353-e-6&quot;, &quot;chunk-c8a13933656ed9f144b18b40f2e9861e-e-8&quot;, &quot;chunk-8f26cf45a6fdac28f68b7d1e6d3677ff-e-6&quot;, &quot;chunk-3f9080fcd7c49e23baf06d3cf81ed207-e-6&quot;, &quot;chunk-f73ef33407197a56c2a6d96f014100a5-e-7&quot;, &quot;chunk-c07d98a8c6e8b07242a68bd712fcfe4c-e-1&quot;, &quot;chunk-cbf4d780dd2a841aa5348c2c70b0276f-e-3&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="11" />
        </attvalues>
      </node>
      <node id="chunk-98004d55693f7f9432c5daf0464e7353-e-10" label="d/Di">
        <attvalues>
          <attvalue for="0" value="d/Di" />
          <attvalue for="1" value="Normalized Variable" />
          <attvalue for="2" value="d/Di是表示缺陷尺寸'd'与颗粒尺寸'Di'之比的无量纲归一化变量。它作为一个关键参数，用于评估缺陷的相对大小及其对另一变量'Np'的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-98004d55693f7f9432c5daf0464e7353" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-98004d55693f7f9432c5daf0464e7353-e-10&quot;]}]" />
          <attvalue for="9" value="34" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-98004d55693f7f9432c5daf0464e7353-e-11" label="Figure 4.46">
        <attvalues>
          <attvalue for="0" value="Figure 4.46" />
          <attvalue for="1" value="Figure" />
          <attvalue for="2" value="图4.46是一个图表，它清晰地展示了寿命（Np）与归一化缺陷尺寸（d/Di）之间的变化关系。该图通过绘制数据点或曲线，直观地说明了当缺陷尺寸发生变化时，寿命（Np）所受到的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-98004d55693f7f9432c5daf0464e7353" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="34" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
