      <node id="chunk-413a7900ebed3c0bb042bc07c13cf29f-e-9" label="M. I. Wood">
        <attvalues>
          <attvalue for="0" value="M. I. Wood" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="M. I. Wood是一位研究人员，因其撰写的关于材料科学的学术著作《涂层高温合金的热机械疲劳》(Thermomechanical fatigue of coated superalloys)而知名。" />
