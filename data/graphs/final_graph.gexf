        <attvalues>
          <attvalue for="11" value="FORMS" />
          <attvalue for="12" value="The interaction between yttrium and sulphur forms refractory sulphides." />
          <attvalue for="13" value="these also confirmed a role of yttrium in interacting with indigenous sulphur to form refractory sulphides such as YS and Y2S3" />
          <attvalue for="14" value="r-2" />
