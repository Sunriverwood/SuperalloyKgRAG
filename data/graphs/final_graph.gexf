      <node id="chunk-50f39f54006f612a0e1ae1be19a6ae87-e-5" label="K. J. Hemker">
        <attvalues>
          <attvalue for="0" value="K. J. Hemker" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="K. J. Hemker是一名材料科学领域的研究人员，专注于热障涂层等先进材料技术。他是学术出版物《热障涂层用铂改性扩散粘结涂层的微观结构表征》(Microstructural characterisation of a platinum-modified diffusion bond coat for thermal barrier coatings)的作者之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-50f39f54006f612a0e1ae1be19a6ae87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-50f39f54006f612a0e1ae1be19a6ae87-e-6" label="Microstructural characterisation of a platinum-modified diffusion bond coat for thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="Microstructural characterisation of a platinum-modified diffusion bond coat for thermal barrier coatings" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由M. W. Chen、K. J. T. Livi、P. K. Wright和K. J. Hemker合著的学术论文，发表于《冶金与材料汇刊》。该论文系统研究了用作热障涂层的铂改性扩散粘结层的微观结构特征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-50f39f54006f612a0e1ae1be19a6ae87" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Chen et al. 2003 Publication&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-50f39f54006f612a0e1ae1be19a6ae87-e-6&quot;, &quot;chunk-8a8245180b98739270d9b9b4befedd30-e-14&quot;]}]" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-50f39f54006f612a0e1ae1be19a6ae87-e-8" label="Platinum-modified diffusion bond coat">
        <attvalues>
          <attvalue for="0" value="Platinum-modified diffusion bond coat" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="铂改性扩散粘结层是一种高性能材料，作为热障涂层的关键组成部分。它通过在扩散涂层中添加贵金属铂，为基体提供优异的高温抗氧化保护，并显著增强其与陶瓷面层之间的结合强度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-50f39f54006f612a0e1ae1be19a6ae87" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;platinum-modified diffusion bond coat&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-50f39f54006f612a0e1ae1be19a6ae87-e-8&quot;]}]" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-50f39f54006f612a0e1ae1be19a6ae87-e-10" label="J. Angenete">
        <attvalues>
          <attvalue for="0" value="J. Angenete" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="J. Angenete是一位作者，是学术出版物《Microstructural and microchemical development of simple and Pt-modified aluminide》的作者之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-50f39f54006f612a0e1ae1be19a6ae87" />
