        </attvalues>
      </node>
      <node id="chunk-d4336056b69d9ed5dd6dd68380e06523-e-2" label="Defects">
        <attvalues>
          <attvalue for="0" value="Defects" />
          <attvalue for="1" value="Flaw" />
          <attvalue for="2" value="Defects指在制造过程中产生的，不符合设计要求或质量标准的瑕疵。这些非预期的缺陷会损害产品的功能、性能或外观，是生产活动中必须被主动预防和消除的不良结果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-d4336056b69d9ed5dd6dd68380e06523" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d4336056b69d9ed5dd6dd68380e06523-e-2&quot;]}]" />
          <attvalue for="9" value="190" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d4336056b69d9ed5dd6dd68380e06523-e-3" label="Pre-existing defects">
        <attvalues>
          <attvalue for="0" value="Pre-existing defects" />
          <attvalue for="1" value="Flaw" />
          <attvalue for="2" value="指材料在投入使用前就已存在的瑕疵。其尺寸是影响材料服役寿命和安全性的关键因素，过大的缺陷可能引发灾难性后果。通常，低强度合金对此类缺陷具有更高的容忍度。" />
          <attvalue for="3" value="{&quot;length&quot;: &quot;greater than 1 mm&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d4336056b69d9ed5dd6dd68380e06523" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d4336056b69d9ed5dd6dd68380e06523-e-3&quot;, &quot;chunk-c49d762f9999a07400560c738c6df23e-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c49d762f9999a07400560c738c6df23e-e-2" label="Catastrophic consequences">
        <attvalues>
          <attvalue for="0" value="Catastrophic consequences" />
          <attvalue for="1" value="Outcome" />
          <attvalue for="2" value="一种严重的失效结果。它指当带有足够尺寸预存缺陷的组件投入使用后，缺陷扩展所引发的突发性、毁灭性的结构损坏或功能丧失。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c49d762f9999a07400560c738c6df23e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c49d762f9999a07400560c738c6df23e-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c49d762f9999a07400560c738c6df23e-e-4" label="Lower-strength alloys">
        <attvalues>
          <attvalue for="0" value="Lower-strength alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="低强度合金 (Lower-strength alloys) 是一种强度相对较低的合金。其核心优势在于具有优异的缺陷容限和良好的抗疲劳性能，对材料中预存的微小裂纹等缺陷不敏感，因此在特定工程应用中更安全可靠。" />
          <attvalue for="3" value="{&quot;property&quot;: &quot;superior tolerance to defects&quot;, &quot;reputation&quot;: &quot;fatigue-resistant&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c49d762f9999a07400560c738c6df23e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c49d762f9999a07400560c738c6df23e-e-6" label="Adequate life of 10000 cycles">
        <attvalues>
          <attvalue for="0" value="Adequate life of 10000 cycles" />
          <attvalue for="1" value="Performance Goal" />
          <attvalue for="2" value="一项以10000次循环为基准的服役寿命性能目标。在应用于高强度合金时，达成此目标高度依赖于其材料具备足够小的初始缺陷尺寸。" />
          <attvalue for="3" value="{&quot;duration&quot;: &quot;10000 cycles&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c49d762f9999a07400560c738c6df23e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ed84e701f59ede6b9d64fc542ae54ff7-e-1" label="Superalloys">
        <attvalues>
          <attvalue for="0" value="Superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="高温合金（Superalloys）是一类高性能合金材料，以其卓越的抗疲劳性能和对缺陷的高容忍度而著称。它们主要用于涡轮盘等严苛环境的应用中，旨在抵抗低周疲劳（LCF）等关键损伤机制。" />
          <attvalue for="3" value="{&quot;characteristic&quot;: &quot;fatigue-resistant&quot;, &quot;tolerance&quot;: &quot;superior tolerance to defects&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-ed84e701f59ede6b9d64fc542ae54ff7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-ed84e701f59ede6b9d64fc542ae54ff7-e-2" label="New alloys">
        <attvalues>
          <attvalue for="0" value="New alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一类旨在取代现有抗疲劳材料（如高温合金）的潜在候选合金。其研发目的是为了在特定应用中提供更优异的机械性能、耐用性或成本效益。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-ed84e701f59ede6b9d64fc542ae54ff7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ed84e701f59ede6b9d64fc542ae54ff7-e-4" label="Probabilistic approach to lifing">
        <attvalues>
          <attvalue for="0" value="Probabilistic approach to lifing" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="**概率寿命预测法 (Probabilistic approach to lifing)**&#10;&#10;一种基于概率论与统计学的方法论，用于评估材料、构件或结构的服役寿命。该方法通过量化载荷、材料性能、损伤等因素的不确定性，来预测其在特定条件下的失效概率与可靠性，取代了传统的确定性评估。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-ed84e701f59ede6b9d64fc542ae54ff7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ed84e701f59ede6b9d64fc542ae54ff7-e-4&quot;]}]" />
          <attvalue for="9" value="305" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-ed84e701f59ede6b9d64fc542ae54ff7-e-5" label="Turbine disc applications">
        <attvalues>
          <attvalue for="0" value="Turbine disc applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="指将高温合金等先进材料用于制造航空发动机或工业燃气轮机核心部件——涡轮盘的工程应用。该应用要求材料能在高温、高应力和高速旋转的极端环境下长期可靠地工作，对材料性能有极高要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ed84e701f59ede6b9d64fc542ae54ff7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ed84e701f59ede6b9d64fc542ae54ff7-e-7" label="Crack initiation">
        <attvalues>
          <attvalue for="0" value="Crack initiation" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="裂纹萌生 (Crack initiation) 是指材料在低周疲劳等循环载荷作用下，其内部或表面形成初始微观裂纹的损伤过程。作为材料疲劳断裂的首要阶段，它发生在裂纹扩展之前，是决定结构疲劳寿命的关键环节。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ed84e701f59ede6b9d64fc542ae54ff7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;crack initiation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ed84e701f59ede6b9d64fc542ae54ff7-e-7&quot;, &quot;chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6-e-10&quot;, &quot;chunk-68c5be2cf8e0d90b4fdb45e22dc55649-e-9&quot;, &quot;chunk-751499c91bd84a08839fce6991037b26-e-3&quot;, &quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-14&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-ed84e701f59ede6b9d64fc542ae54ff7-e-8" label="Crack growth">
        <attvalues>
          <attvalue for="0" value="Crack growth" />
          <attvalue for="1" value="Damage Process" />
          <attvalue for="2" value="裂纹扩展 (Crack propagation) 是指材料在应力作用下，内部已有的裂纹从其尖端开始进一步延伸和发展的过程。作为继裂纹萌生后的一个关键阶段，它的持续进行会逐渐削弱材料的承载能力，并最终可能导致整个结构的断裂失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-ed84e701f59ede6b9d64fc542ae54ff7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Crack propagation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ed84e701f59ede6b9d64fc542ae54ff7-e-8&quot;, &quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-15&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-facbcb1a7f1293806d28cad7034ba304-e-1" label="Crack Initiation by Low-Cycle Fatigue (LCF)">
        <attvalues>
          <attvalue for="0" value="Crack Initiation by Low-Cycle Fatigue (LCF)" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="低周疲劳裂纹萌生是一种材料失效机制，指材料在循环载荷作用下，因塑性应变累积而产生初始微裂纹的过程。它通常是涡轮盘等关键部件的一种主要失效模式，并发生在随后的循环疲劳裂纹扩展之前。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-facbcb1a7f1293806d28cad7034ba304" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-facbcb1a7f1293806d28cad7034ba304-e-1&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-facbcb1a7f1293806d28cad7034ba304-e-2" label="Cyclic Fatigue Crack Propagation">
        <attvalues>
          <attvalue for="0" value="Cyclic Fatigue Crack Propagation" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="循环疲劳裂纹扩展是一种失效机制，指材料在循环载荷作用下，由低周疲劳等方式萌生的初始裂纹发生稳定、持续扩展的现象。此过程是导致涡轮盘等关键承力构件发生灾难性断裂的主要原因，直接决定了部件的服役寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-facbcb1a7f1293806d28cad7034ba304" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-facbcb1a7f1293806d28cad7034ba304-e-2&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-facbcb1a7f1293806d28cad7034ba304-e-3" label="Turbine Disc Applications">
        <attvalues>
          <attvalue for="0" value="Turbine Disc Applications" />
          <attvalue for="1" value="Component Application" />
          <attvalue for="2" value="指涡轮盘在航空发动机等设备中的具体工程应用场景。其特点是承受高温和高循环应力，使低周疲劳（LCF）裂纹萌生和循环疲劳裂纹扩展成为限制其服役寿命的关键失效模式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-facbcb1a7f1293806d28cad7034ba304" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-facbcb1a7f1293806d28cad7034ba304-e-4" label="Laboratory Experimentation">
        <attvalues>
          <attvalue for="0" value="Laboratory Experimentation" />
          <attvalue for="1" value="Test Method" />
          <attvalue for="2" value="一种在受控实验室环境中进行的测试方法。它通过对标准试件施加载荷，以研究材料的疲劳、裂纹扩展等力学行为，例如探究由低周疲劳（LCF）引起的裂纹萌生机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-facbcb1a7f1293806d28cad7034ba304" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-facbcb1a7f1293806d28cad7034ba304-e-5" label="Test Pieces">
        <attvalues>
          <attvalue for="0" value="Test Pieces" />
          <attvalue for="1" value="Test Specimen" />
          <attvalue for="2" value="**试件 (Test Pieces)**：指在实验室实验中，用以模拟大型部件（如涡轮盘）在特定工况下的性能与行为而制备的小尺寸标准化样本，是进行材料或结构性能评估的基础。" />
          <attvalue for="3" value="{&quot;diameter&quot;: &quot;~10mm&quot;, &quot;gauge_length&quot;: &quot;~50mm&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-facbcb1a7f1293806d28cad7034ba304" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Test pieces&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-facbcb1a7f1293806d28cad7034ba304-e-5&quot;, &quot;chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6-e-1&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6-e-2" label="Turbine disc">
        <attvalues>
          <attvalue for="0" value="Turbine disc" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮盘是涡轮发动机的关键旋转部件，用于安装并固定涡轮叶片。由于它在高温高压下承受巨大离心力，其材料性能、疲劳寿命和潜在损伤情况，通常通过具有代表性的试件进行模拟和评估，以保证其结构完整性与运行安全。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6-e-3" label="Nucleation sites">
        <attvalues>
          <attvalue for="0" value="Nucleation sites" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="一种微观结构特征，指材料内部能够萌生疲劳裂纹等损伤的特定位置。其分布密度是评估材料宏观性能和损伤演化的关键参数，在低周疲劳条件或特定合金（如高温合金）中通常较高。" />
          <attvalue for="3" value="{&quot;density&quot;: &quot;large&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6-e-5" label="Cyclic strain">
        <attvalues>
          <attvalue for="0" value="Cyclic strain" />
          <attvalue for="1" value="Mechanical Parameter" />
          <attvalue for="2" value="循环应变是一种关键力学参数，指材料在循环载荷作用下所经历的周期性往复变化的应变。其应变幅的大小是判断材料是否处于低周疲劳（LCF）工况并预测其疲劳寿命的主要依据。" />
          <attvalue for="3" value="{&quot;level&quot;: &quot;high&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Cyclic strains&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6-e-5&quot;, &quot;chunk-6656e9c896783e532db09028bd4f742e-e-6&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6-e-11" label="Intense slip bands">
        <attvalues>
          <attvalue for="0" value="Intense slip bands" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="强滑移带是一种微观结构特征，指在某些高温合金中，由高度集中的局部塑性变形所形成的带状区域。这些区域是材料内部的薄弱环节，由于应力集中，通常是裂纹萌生的优先位置。" />
          <attvalue for="3" value="{&quot;density&quot;: &quot;very high&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6-e-11&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6-e-12" label="Damage">
        <attvalues>
          <attvalue for="0" value="Damage" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="指涡轮盘在服役条件下，材料性能发生劣化，导致其结构完整性下降或出现宏观缺陷的现象。它是影响部件安全和寿命的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6-e-12&quot;, &quot;chunk-e29ab0c1999b2fd0630fcd1c30c3554b-e-7&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e29ab0c1999b2fd0630fcd1c30c3554b-e-2" label="Lifing approach">
        <attvalues>
          <attvalue for="0" value="Lifing approach" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="一种用于评估部件寿命的确定性方法论。该方法通过系统性地分析实验室试验数据，并考虑其内在的离散性（scatter），以计算或预测部件在特定条件下的可靠服役寿命。" />
          <attvalue for="3" value="{&quot;nature&quot;: &quot;essentially deterministic&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-e29ab0c1999b2fd0630fcd1c30c3554b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="191" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e29ab0c1999b2fd0630fcd1c30c3554b-e-3" label="Laboratory test data">
        <attvalues>
          <attvalue for="0" value="Laboratory test data" />
          <attvalue for="1" value="Data" />
          <attvalue for="2" value="指在实验室受控条件下获得的，用于寿命评估方法的一组实验数据。其显著特征是数据点存在固有的离散性（scatter），是预测材料或结构疲劳寿命和可靠性的关键依据。" />
          <attvalue for="3" value="{&quot;characteristic&quot;: &quot;scatter&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-e29ab0c1999b2fd0630fcd1c30c3554b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="191" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e29ab0c1999b2fd0630fcd1c30c3554b-e-6" label="Powder-processing routes">
        <attvalues>
          <attvalue for="0" value="Powder-processing routes" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="粉末加工路线（powder-processing routes）是一类以金属、陶瓷或复合材料粉末为原料的制造工艺。它通常包括粉末制备、混合、成型（如压制）和高温烧结等关键步骤，将离散的粉末颗粒固结成具有所需形状和性能的致密块体材料或最终制品。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e29ab0c1999b2fd0630fcd1c30c3554b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Powder-processing&quot;, &quot;powder-processing routes&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e29ab0c1999b2fd0630fcd1c30c3554b-e-6&quot;, &quot;chunk-e3527c9f74d686641ceba7afb52a8ef3-e-1&quot;, &quot;chunk-1c5754d75a0e54b3c65fcb24c11999a4-e-8&quot;, &quot;chunk-fd63d9cd61eb501106c8b03551043c54-e-1&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e3527c9f74d686641ceba7afb52a8ef3-e-3" label="higher strength">
        <attvalues>
          <attvalue for="0" value="higher strength" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种材料属性，指其抵抗外力而不发生失效或塑性变形的能力较强。较高的强度通常能提升材料的疲劳极限，从而延长高周疲劳寿命。然而，该特性也可能导致延展性下降，对低周疲劳性能产生不利影响，是决定疲劳寿命的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-e3527c9f74d686641ceba7afb52a8ef3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e3527c9f74d686641ceba7afb52a8ef3-e-6" label="slip bands">
        <attvalues>
          <attvalue for="0" value="slip bands" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="滑移带 (slip bands) 是晶体材料在循环载荷作用下，因局部区域发生集中的塑性变形而形成的微观带状特征。它由大量位错沿特定晶面滑移产生，是应变集中的表现，常作为疲劳裂纹的优先萌生点，在材料疲劳失效中起关键作用。" />
          <attvalue for="3" value="{&quot;density&quot;: &quot;low&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e3527c9f74d686641ceba7afb52a8ef3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e3527c9f74d686641ceba7afb52a8ef3-e-6&quot;, &quot;chunk-dcabec43f1f2206a87597ccc217e55d1-e-2&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e3527c9f74d686641ceba7afb52a8ef3-e-7" label="testing conditions">
        <attvalues>
          <attvalue for="0" value="testing conditions" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="标准化描述：&#10;在材料或构件的性能评估中所设定的特定环境与物理参数。这些条件通常是简化的，可能无法完全代表真实的服役环境，这种差异是导致尺寸效应等现象产生的原因之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-e3527c9f74d686641ceba7afb52a8ef3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e3527c9f74d686641ceba7afb52a8ef3-e-9" label="size effect">
        <attvalues>
          <attvalue for="0" value="size effect" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="指材料或构件的力学性能、强度等物理性质随其几何尺寸变化而变化的现象。该现象是导致实验室小尺寸试件的测试结果与实际服役的大尺寸构件性能存在差异的重要原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-e3527c9f74d686641ceba7afb52a8ef3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ae58c0f988aba111d22bb6ff5c500655-e-5" label="Processing route">
        <attvalues>
          <attvalue for="0" value="Processing route" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="指在材料制造或处理过程中，导致陶瓷夹杂物被引入的一系列特定工序或步骤。该工艺是材料中此类缺陷的直接来源。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ae58c0f988aba111d22bb6ff5c500655" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ae58c0f988aba111d22bb6ff5c500655-e-6" label="Rene 95 superalloy">
        <attvalues>
          <attvalue for="0" value="Rene 95 superalloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="Rene 95是一种通过粉末冶金工艺制造的镍基高温合金。它以在高达650°C的温度下仍保持卓越的强度、抗疲劳和抗蠕变性能而闻名。由于这些特性，它被广泛应用于制造航空发动机的压气机和涡轮盘等承受高应力的关键热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-ae58c0f988aba111d22bb6ff5c500655" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ae58c0f988aba111d22bb6ff5c500655-e-6&quot;, &quot;chunk-3f9080fcd7c49e23baf06d3cf81ed207-e-1&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-ae58c0f988aba111d22bb6ff5c500655-e-7" label="Particle size distribution">
        <attvalues>
          <attvalue for="0" value="Particle size distribution" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**标准化描述：**&#10;&#10;粒度分布（Particle size distribution），也称颗粒大小分布，是一个表征粉体、乳液或气溶胶等样品中，不同尺寸颗粒所占相对比例的统计指标。它通常以频率分布图或累积分布曲线的形式呈现，是衡量颗粒群体尺寸均匀性或离散程度的关键物理属性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ae58c0f988aba111d22bb6ff5c500655" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;particle size distribution&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ae58c0f988aba111d22bb6ff5c500655-e-7&quot;, &quot;chunk-d6790fb9c1169445a5d3fb409c8aba9c-e-12&quot;, &quot;chunk-bf4677fbc731927f738fe825e4a4dab8-e-5&quot;, &quot;chunk-98004d55693f7f9432c5daf0464e7353-e-8&quot;, &quot;chunk-3f9080fcd7c49e23baf06d3cf81ed207-e-7&quot;, &quot;chunk-ac0f1d7e181ea0f31c302d3d4596599b-e-6&quot;, &quot;chunk-9e77a589c8fe70a5a486a0c63c76551f-e-5&quot;, &quot;chunk-cde5a0fcf48daf01d0e3e3cd1cc4582e-e-7&quot;, &quot;chunk-0489a6121ca8cc5c02cc985cc307d8a1-e-1&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-6656e9c896783e532db09028bd4f742e-e-1" label="Scatter">
        <attvalues>
          <attvalue for="0" value="Scatter" />
          <attvalue for="1" value="Data Characteristic" />
          <attvalue for="2" value="在材料疲劳分析中，指疲劳数据点所呈现的分散性或离散程度。这种现象主要由材料内部的夹杂物等微观缺陷引起，反映了材料性能的固有变化，其大小通常与循环应变等试验条件相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-6656e9c896783e532db09028bd4f742e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6656e9c896783e532db09028bd4f742e-e-1&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6656e9c896783e532db09028bd4f742e-e-3" label="Inclusions">
        <attvalues>
          <attvalue for="0" value="Inclusions" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="在材料科学中，夹杂物(Inclusion)是一种材料内部的异质颗粒缺陷。它作为应力集中点，是引发材料失效（尤其是疲劳断裂）的主要源头。其危害性与尺寸显著相关，对于涡轮盘等大体积部件，因颗粒取样效应，存在更大、更具破坏性夹杂物的概率更高，因此更易导致其失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-6656e9c896783e532db09028bd4f742e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Inclusion&quot;, &quot;inclusion&quot;, &quot;inclusions&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6656e9c896783e532db09028bd4f742e-e-3&quot;, &quot;chunk-ace58b767445aef942b5ed63e65aad6c-e-3&quot;, &quot;chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0-e-8&quot;, &quot;chunk-d6790fb9c1169445a5d3fb409c8aba9c-e-3&quot;, &quot;chunk-ac0f1d7e181ea0f31c302d3d4596599b-e-2&quot;, &quot;chunk-0489a6121ca8cc5c02cc985cc307d8a1-e-6&quot;, &quot;chunk-257439916abb1d8e8959f74997de355a-e-1&quot;, &quot;chunk-0fc2e7bdc755aa4e47c0be4c7ca98b87-e-4&quot;, &quot;chunk-8f374054b3af3dbd36329b272a6ab2a1-e-1&quot;, &quot;chunk-d63d2e58612dcf41a9407c0b8dd57bc3-e-7&quot;, &quot;chunk-bc843e3dfc76a0be097f5be36fb00976-e-2&quot;, &quot;chunk-86425bad56c0d52ed7246eff0fe06dd8-e-11&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="13" />
        </attvalues>
      </node>
      <node id="chunk-6656e9c896783e532db09028bd4f742e-e-4" label="LCF data">
        <attvalues>
          <attvalue for="0" value="LCF data" />
          <attvalue for="1" value="Technical Data" />
          <attvalue for="2" value="低周疲劳数据（Low Cycle Fatigue data）是一种关键技术数据，用于描述材料（如Rene 95高温合金）在高应力、低周次循环载荷作用下的疲劳寿命和性能。它是评估航空发动机涡轮盘等关键承力部件服役可靠性和安全性的重要依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-6656e9c896783e532db09028bd4f742e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6656e9c896783e532db09028bd4f742e-e-4&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6656e9c896783e532db09028bd4f742e-e-7" label="Inclusions at the free surfaces">
        <attvalues>
          <attvalue for="0" value="Inclusions at the free surfaces" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="一种位于材料自由表面的夹杂物缺陷。由于该位置成为显著的应力集中源，且直接暴露于外部环境，因此极易引发疲劳裂纹。其危害性通常远大于材料内部的夹杂物，是导致零件早期失效的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-6656e9c896783e532db09028bd4f742e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="192" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6656e9c896783e532db09028bd4f742e-e-8" label="Inclusions initiating cracks at depth">
        <attvalues>
          <attvalue for="0" value="Inclusions initiating cracks at depth" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="一种材料缺陷，指位于材料亚表层或内部、并作为疲劳裂纹萌生源的夹杂物。由于不受外部环境直接影响，其应力集中效应相对较小，因此这类缺陷的危害性通常低于直接暴露在材料自由表面的夹杂物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-6656e9c896783e532db09028bd4f742e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="192" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4e8463ac395e2b30702e7ef75baf5b7a-e-1" label="Statistical, or probabilistic, approach">
        <attvalues>
          <attvalue for="0" value="Statistical, or probabilistic, approach" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="一种基于统计学和概率论的方法论，用于分析材料的疲劳性能。该方法系统地考虑了材料表面积和体积等因素对疲劳性能的影响（即尺寸效应），并由Pineau等人进行了量化研究。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-4e8463ac395e2b30702e7ef75baf5b7a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-4e8463ac395e2b30702e7ef75baf5b7a-e-3" label="Surface area">
        <attvalues>
          <attvalue for="0" value="Surface area" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="一种几何属性，指一个三维物体所有表面的面积总和。在材料科学等领域，该属性十分关键，因为更大的表面积会增加物体与外界作用的区域，从而显著提高由大颗粒撞击或表面缺陷等因素所引发的失效概率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-4e8463ac395e2b30702e7ef75baf5b7a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4e8463ac395e2b30702e7ef75baf5b7a-e-3&quot;, &quot;chunk-9e77a589c8fe70a5a486a0c63c76551f-e-3&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4e8463ac395e2b30702e7ef75baf5b7a-e-4" label="Volume of material">
        <attvalues>
          <attvalue for="0" value="Volume of material" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="材料体积是一种影响疲劳性能的物理属性。基于尺寸效应，承受应力的材料体积越大，其内部存在足以引发裂纹的临界缺陷（如大尺寸夹杂物）的统计概率就越高，从而导致其疲劳性能降低。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-4e8463ac395e2b30702e7ef75baf5b7a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-4e8463ac395e2b30702e7ef75baf5b7a-e-5" label="Inclusion of greater size">
        <attvalues>
          <attvalue for="0" value="Inclusion of greater size" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="一种材料缺陷，指材料内部尺寸较大的异物颗粒或杂质。根据统计学原理，这种缺陷存在的概率会随着材料体积的增大而相应增高。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-4e8463ac395e2b30702e7ef75baf5b7a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4e8463ac395e2b30702e7ef75baf5b7a-e-6" label="Pineau and co-workers">
        <attvalues>
          <attvalue for="0" value="Pineau and co-workers" />
          <attvalue for="1" value="Research Group" />
          <attvalue for="2" value="Pineau及其同事是一个研究团队。该团队的主要贡献在于为统计或概率方法建立了定量基础，将相关的统计学考量转化为一个可衡量、数学化、更严谨的分析框架。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-4e8463ac395e2b30702e7ef75baf5b7a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a6a0b0d2c85b7b920c33d8bae94d9958-e-2" label="Surface Area, S">
        <attvalues>
          <attvalue for="0" value="Surface Area, S" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="表面积 (S) 是一个物理量，指材料体积 (V) 的表面总面积。作为材料与外界环境作用的界面，它会暴露于循环应力 (Δσ) 等载荷下，其大小是影响材料性能的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a6a0b0d2c85b7b920c33d8bae94d9958" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a6a0b0d2c85b7b920c33d8bae94d9958-e-4" label="Uniform Spherical Inclusions">
        <attvalues>
          <attvalue for="0" value="Uniform Spherical Inclusions" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="一种材料缺陷，指在材料体积(V)内呈理想化均匀分布的球形夹杂物。其关键物理特性通过单个夹杂物的统一尺寸（直径D）和单位体积内的数量密度（n）来表征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a6a0b0d2c85b7b920c33d8bae94d9958" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a6a0b0d2c85b7b920c33d8bae94d9958-e-6" label="Density, n">
        <attvalues>
          <attvalue for="0" value="Density, n" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="指球形夹杂物的数量密度（符号为n），是一种物理性质。它定义为单位体积内所包含的球形夹杂物的数量，用于表征材料中夹杂物分布的密集程度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a6a0b0d2c85b7b920c33d8bae94d9958" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a6a0b0d2c85b7b920c33d8bae94d9958-e-7" label="Probability of any single inclusion avoiding the surface">
        <attvalues>
          <attvalue for="0" value="Probability of any single inclusion avoiding the surface" />
          <attvalue for="1" value="Calculated Probability" />
          <attvalue for="2" value="指材料内部任一单个夹杂物不与材料表面相交的计算概率。该概率值的大小取决于材料的表面积与体积之比（S/V），其近似值可通过公式 1 - DS/V 计算得出。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a6a0b0d2c85b7b920c33d8bae94d9958" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a6a0b0d2c85b7b920c33d8bae94d9958-e-9" label="1 DS/V">
        <attvalues>
          <attvalue for="0" value="1 DS/V" />
          <attvalue for="1" value="Mathematical Quantity" />
          <attvalue for="2" value="1 DS/V 是一个一阶近似表达式，用于估算夹杂物与自由表面相交的概率（P1）。该表达式基于几何概率模型，其中D、S和V通常分别代表夹杂物的特征尺寸、自由表面的面积以及系统的总体积。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-a6a0b0d2c85b7b920c33d8bae94d9958" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a6a0b0d2c85b7b920c33d8bae94d9958-e-9&quot;, &quot;chunk-b5f676dc61935d68cc39272b74bbea4b-e-2&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b5f676dc61935d68cc39272b74bbea4b-e-3" label="n_v x V">
        <attvalues>
          <attvalue for="0" value="n_v x V" />
          <attvalue for="1" value="Quantity" />
          <attvalue for="2" value="一个表示存在的夹杂物总数的物理量，其数值为夹杂物的体数密度(n_v)与总体积(V)的乘积。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-b5f676dc61935d68cc39272b74bbea4b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="193" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b5f676dc61935d68cc39272b74bbea4b-e-4" label="P1">
        <attvalues>
          <attvalue for="0" value="P1" />
          <attvalue for="1" value="Probability" />
          <attvalue for="2" value="P1是一个概率，指材料中至少一个夹杂物与自由表面相交的可能性。其数学定义为p₁{D} = 1 - (1 - DS/V)^(n_v V)，显示了其对表面积体积比(S/V)的依赖性，并可在特定条件下近似为1 DS/V。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-b5f676dc61935d68cc39272b74bbea4b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-b5f676dc61935d68cc39272b74bbea4b-e-5" label="p₁{D} = 1 - (1 - DS/V)^(n_v V)">
        <attvalues>
          <attvalue for="0" value="p₁{D} = 1 - (1 - DS/V)^(n_v V)" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="该数学公式用于定义概率P1。它表示P1与变量D、S、V及nᵥ之间的函数关系，通过这些变量的特定值来计算出P1的数值。" />
          <attvalue for="3" value="{&quot;label&quot;: &quot;4.10&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-b5f676dc61935d68cc39272b74bbea4b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b5f676dc61935d68cc39272b74bbea4b-e-6" label="Total Inclusions">
        <attvalues>
          <attvalue for="0" value="Total Inclusions" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="指在特定体积材料中所包含的夹杂物的总数量。该物理量通过材料的夹杂物数密度（n_v）与所考察的体积（V）的乘积进行量化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-b5f676dc61935d68cc39272b74bbea4b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="193" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ace58b767445aef942b5ed63e65aad6c-e-1" label="p₁{D}">
        <attvalues>
          <attvalue for="0" value="p₁{D}" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="一个表示概率的参数。它是一个具体的概率值，其形式化的数学定义由公式（4.10）明确给出。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-ace58b767445aef942b5ed63e65aad6c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="194" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ace58b767445aef942b5ed63e65aad6c-e-2" label="Equation (4.10)">
        <attvalues>
          <attvalue for="0" value="Equation (4.10)" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="一个编号为(4.10)的数学公式，它给出了概率p₁{D}的数学定义与精确计算方法。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;1 - (1 - DS/V)^(n_v V)&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-ace58b767445aef942b5ed63e65aad6c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="194" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ace58b767445aef942b5ed63e65aad6c-e-4" label="Free surface">
        <attvalues>
          <attvalue for="0" value="Free surface" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="在物理学和材料科学中，自由表面指固体或液体与气体/真空形成的界面。其关键特征是该表面上的剪应力为零。在材料中，它也指内部的夹杂物等缺陷可以运动至此并与之相交的外部边界。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-ace58b767445aef942b5ed63e65aad6c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ace58b767445aef942b5ed63e65aad6c-e-4&quot;, &quot;chunk-d6790fb9c1169445a5d3fb409c8aba9c-e-8&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ace58b767445aef942b5ed63e65aad6c-e-5" label="Fully embedded inclusion">
        <attvalues>
          <attvalue for="0" value="Fully embedded inclusion" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="一种材料缺陷，指异物颗粒完全被基体材料包裹，未暴露于表面。由于它能在材料内部形成严重的应力集中点，破坏了基体的连续性，因此通常被认为比部分嵌入式夹杂物对材料的力学性能和完整性危害更大。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ace58b767445aef942b5ed63e65aad6c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ace58b767445aef942b5ed63e65aad6c-e-5&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ace58b767445aef942b5ed63e65aad6c-e-6" label="Partially embedded inclusion">
        <attvalues>
          <attvalue for="0" value="Partially embedded inclusion" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="**部分嵌入夹杂物 (Partially embedded inclusion)**&#10;&#10;一种材料缺陷，指部分埋入材料基体、部分暴露于表面的异物，其嵌入深度为'd'。作为一种缺陷，它的危害性通常小于被基体完全包裹的“完全嵌入夹杂物”。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-ace58b767445aef942b5ed63e65aad6c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ace58b767445aef942b5ed63e65aad6c-e-6&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ace58b767445aef942b5ed63e65aad6c-e-7" label="d">
        <attvalues>
          <attvalue for="0" value="d" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="变量 (d) 是一个表示缺陷尺寸的物理量，其数值会随另一变量 'No' 的变化而改变。它通常在材料科学或工程分析模型中，用于评估结构或部件的完整性与可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ace58b767445aef942b5ed63e65aad6c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ace58b767445aef942b5ed63e65aad6c-e-7&quot;, &quot;chunk-d6790fb9c1169445a5d3fb409c8aba9c-e-1&quot;, &quot;chunk-82c9ced81969f3e1552c36cf4bd5f22e-e-6&quot;, &quot;chunk-98004d55693f7f9432c5daf0464e7353-e-2&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-ace58b767445aef942b5ed63e65aad6c-e-8" label="D">
        <attvalues>
          <attvalue for="0" value="D" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="变量D，用于表示材料中夹杂物的尺寸，通常指其直径或等效直径。它是描述和分析夹杂物颗粒尺寸分布（Particle Size Distribution）时所使用的基本参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-ace58b767445aef942b5ed63e65aad6c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ace58b767445aef942b5ed63e65aad6c-e-8&quot;, &quot;chunk-d6790fb9c1169445a5d3fb409c8aba9c-e-2&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ace58b767445aef942b5ed63e65aad6c-e-9" label="Fatigue life (No)">
        <attvalues>
          <attvalue for="0" value="Fatigue life (No)" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="疲劳寿命(No)是一种基于损伤容限设计方法的材料属性，指材料中一个尺寸为'd'的初始缺陷，在循环载荷作用下扩展至临界尺寸所能经历的循环周次。它是预测含缺陷构件安全使用寿命的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-ace58b767445aef942b5ed63e65aad6c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ace58b767445aef942b5ed63e65aad6c-e-9&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0-e-1" label="p2">
        <attvalues>
          <attvalue for="0" value="p2" />
          <attvalue for="1" value="Probability" />
          <attvalue for="2" value="p2是一个概率值，表示实际寿命(Np)小于参考寿命(No)的可能性。它通过公式(D – d)/D计算得出。在特定条件下，例如当D等于d时，该概率p2的值为0。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;[1 - (1 - DS/V)^(n_v V)] [(D - d)/D]&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;0&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0-e-1&quot;, &quot;chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0-e-12&quot;]}]" />
          <attvalue for="9" value="34" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0-e-4" label="(D – d)/D">
        <attvalues>
          <attvalue for="0" value="(D – d)/D" />
          <attvalue for="1" value="Criterion" />
          <attvalue for="2" value="一个有害性判据 (harmfulness criterion)，其表达式为 (D – d)/D。它通过计算参考值(D)与观测值(d)之间的相对差异来量化危害程度，并被用作计算参数p2方程中的一个项。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="34" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0-e-5" label="harmfulness criterion">
        <attvalues>
          <attvalue for="0" value="harmfulness criterion" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="**标准化描述**:&#10;一个用于评价夹杂物（inclusion）效力或危害性的量化准则。它基于夹杂物自身尺寸（d）与母体或关键区域尺寸（D）等参数间的关系进行计算，其具体数学表达形式之一为 (D – d)/D。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="34" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0-e-6" label="d">
        <attvalues>
          <attvalue for="0" value="d" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="变量D，指“危害性标准”术语中的一个变量，其效力或作用强度受到“inclusion”这一条件的制约或影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;D&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0-e-6&quot;, &quot;chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0-e-7&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0-e-9" label="DS">
        <attvalues>
          <attvalue for="0" value="DS" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="DS指一个用于计算特定概率p2的数学方程中的变量。它作为该公式的一个组成部分，其具体数值会影响最终概率p2的计算结果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="306" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0-e-10" label="V">
        <attvalues>
          <attvalue for="0" value="V" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="V 是一个数学变量，在用于计算概率 p2 的特定方程中，它作为一个参数或未知数，代表一个可变或待定的数值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0" />
