      <node id="chunk-4093026dc043845c048897c7c1f6fe61-e-11" label="Zero Kelvin">
        <attvalues>
          <attvalue for="0" value="Zero Kelvin" />
          <attvalue for="1" value="Temperature" />
          <attvalue for="2" value="绝对零度（0 K）是热力学温标中的理论最低温度。在此状态下，物质的组成粒子具有最低的动能，且根据热力学第三定律，任何完美晶体的熵为零。虽然无法在现实中完全达到，但它是物理学中的一个重要基准点。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-4093026dc043845c048897c7c1f6fe61" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Zero kelvin&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4093026dc043845c048897c7c1f6fe61-e-11&quot;, &quot;chunk-557dabfd98e07916fb11233921ddc06d-e-1&quot;]}]" />
          <attvalue for="9" value="100" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-4093026dc043845c048897c7c1f6fe61-e-12" label="Gases">
        <attvalues>
          <attvalue for="0" value="Gases" />
          <attvalue for="1" value="Substance" />
          <attvalue for="2" value="气体是物质的一种基本状态，其分子可自由运动，无固定形状和体积。根据热力学第三定律，在绝对零度（0K）这一极限条件下，理想物质的熵为零。尽管现实中的气体在此温度前会转变为固态，但此零熵概念是研究所有物质（包括气体）热力学性质的理论基准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-4093026dc043845c048897c7c1f6fe61" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4093026dc043845c048897c7c1f6fe61-e-12&quot;, &quot;chunk-557dabfd98e07916fb11233921ddc06d-e-2&quot;]}]" />
          <attvalue for="9" value="100" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-4093026dc043845c048897c7c1f6fe61-e-13" label="Entropy">
        <attvalues>
          <attvalue for="0" value="Entropy" />
          <attvalue for="1" value="Thermodynamic Property" />
          <attvalue for="2" value="熵是一种热力学性质，用于度量一个系统的无序或随机程度。它也是系统内无法用于做功的能量的量度。根据热力学第三定律，任何完美晶体在绝对零度（零开尔文）时，其熵值为零。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-4093026dc043845c048897c7c1f6fe61" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4093026dc043845c048897c7c1f6fe61-e-13&quot;, &quot;chunk-557dabfd98e07916fb11233921ddc06d-e-3&quot;]}]" />
          <attvalue for="9" value="100" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
