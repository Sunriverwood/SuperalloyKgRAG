        <attvalues>
          <attvalue for="11" value="DOES_NOT_EXHIBIT" />
          <attvalue for="12" value="Unlike Group I and II alloys, Group III alloys show no evidence of internal sub-scale precipitation." />
          <attvalue for="13" value="and, unlike Group I and Group II alloys, no evidence of internal sub-scale precipitation is shown." />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-bb636c80a00702ec9bbe14461e908287" />
