        <attvalues>
          <attvalue for="11" value="EXPLAINS_PERFORMANCE_OF" />
          <attvalue for="12" value="The high value of the applied stress for bowing is a major reason for the good performance of single-crystal superalloys." />
          <attvalue for="13" value="This is significant, and is one of the major reasons why the single-crystal superalloys perform so well at elevated temperatures." />
