        <attvalues>
          <attvalue for="11" value="EQUIVALENT_TO_INTRODUCTION_OF" />
          <attvalue for="12" value="The shearing involved in creating an SESF is equivalent to introducing an extra {111} layer." />
          <attvalue for="13" value="In this case, the shearing can be shown to be equivalent to the introduction of an extra {111} layer." />
          <attvalue for="14" value="r-2" />
