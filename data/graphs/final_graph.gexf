        <attvalues>
          <attvalue for="11" value="PROCESSED_TO_HAVE" />
          <attvalue for="12" value="NR3 superalloy was heat treated at super-solvus temperatures to give a coarse-grain structure." />
          <attvalue for="13" value="in the NR3 superalloy heat treated at super- and sub-solvus temperatures to give coarse- and fine-grain structures, respectively" />
          <attvalue for="14" value="r-1" />
