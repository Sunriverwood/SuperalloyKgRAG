        <attvalues>
          <attvalue for="11" value="HAS_EXPERIENCE_WITH" />
          <attvalue for="12" value="Rolls-Royce had experience with the HP turbine blade of the Trent 500 engine that necessitated a design change." />
          <attvalue for="13" value="Hence rationalise Rolls-Royce's experience with the HP turbine blade of the Trent 500 engine, which necessitated increasing the radius of curvature at the leading edge to ensure TBC adherence." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-a6f8ce7a7c55e9b6f962543810b6ee71" />
          <attvalue for="17" value="0.4" />
