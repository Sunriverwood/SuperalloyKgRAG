        <attvalues>
          <attvalue for="11" value="COMPOSED_OF" />
          <attvalue for="12" value="The sub-scale on Group I alloys can be composed of Ni spinel." />
          <attvalue for="13" value="...accompanied by a sub-scale of Cr2O3, Al2O3 and/or the spinel Ni" />
