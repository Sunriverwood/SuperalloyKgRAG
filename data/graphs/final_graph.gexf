      <edge source="chunk-ac23817ca85b5e2cba9cb1da3a1960fc-e-8" target="chunk-ac23817ca85b5e2cba9cb1da3a1960fc-e-7" id="chunk-ac23817ca85b5e2cba9cb1da3a1960fc-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CAUSES" />
          <attvalue for="12" value="The forces τbλᵢ are due to the applied shear stress." />
          <attvalue for="13" value="the forces τbλᵢ (i = 1, 2) driving the particle-shearing process, due to the applied shear stress" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-ac23817ca85b5e2cba9cb1da3a1960fc" />
          <attvalue for="16" value="8.448086508405846e-05" />
          <attvalue for="17" value="0.40005068851905046" />
        </attvalues>
      </edge>
      <edge source="chunk-a478184a271f81c44b621f35badc5f0a-e-1" target="chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-9" id="chunk-2a630be2b8090ec92842cc9c1737eb42-r-5" weight="4.0">
        <attvalues>
          <attvalue for="11" value="BECOME" />
          <attvalue for="12" value="Dislocation pairs become 'strongly coupled' when contained within a large particle." />
          <attvalue for="13" value="Thus, any given particle may contain a pair of dislocations which are now ‘strongly coupled’" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-2a630be2b8090ec92842cc9c1737eb42" />
          <attvalue for="16" value="0.000262829358039293" />
          <attvalue for="17" value="0.26682436428149026" />
        </attvalues>
      </edge>
      <edge source="chunk-a478184a271f81c44b621f35badc5f0a-e-7" target="chunk-0fc62816353bfe4473c22a2bef9a696b-e-1" id="chunk-a478184a271f81c44b621f35badc5f0a-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DESCRIBES" />
          <attvalue for="12" value="Equation (2.23a) describes the force balance for the first dislocation." />
          <attvalue for="13" value="τbλ₁ + R + F₁ = 0 (2.23a) for the first dislocation" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-a478184a271f81c44b621f35badc5f0a" />
          <attvalue for="16" value="0.0013657739855256117" />
          <attvalue for="17" value="0.4008194643913154" />
        </attvalues>
      </edge>
      <edge source="chunk-a478184a271f81c44b621f35badc5f0a-e-8" target="chunk-62e0b88322cda2b3939ddacaff16f02d-e-3" id="chunk-a478184a271f81c44b621f35badc5f0a-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DESCRIBES" />
          <attvalue for="12" value="Equation (2.23b) describes the force balance for the second dislocation." />
          <attvalue for="13" value="τbλ₂ − R + F₂ = 0 (2.23b) for the second" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-a478184a271f81c44b621f35badc5f0a" />
          <attvalue for="16" value="0.0013657739855256117" />
          <attvalue for="17" value="0.4008194643913154" />
        </attvalues>
      </edge>
      <edge source="chunk-70bdb361c16d13b8408a365565b5baba-e-1" target="chunk-70bdb361c16d13b8408a365565b5baba-e-2" id="chunk-70bdb361c16d13b8408a365565b5baba-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_OPPOSITE_SIGN" />
          <attvalue for="12" value="The terms F₁ and F₂ are described as having opposite signs." />
          <attvalue for="13" value="The terms F₁ and F₂ are of opposite signs since the first dislocation introduces the APB, whereas the second dislocation removes it." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-70bdb361c16d13b8408a365565b5baba" />
          <attvalue for="16" value="0.5" />
          <attvalue for="17" value="0.7" />
        </attvalues>
      </edge>
      <edge source="chunk-70bdb361c16d13b8408a365565b5baba-e-6" target="chunk-70bdb361c16d13b8408a365565b5baba-e-7" id="chunk-70bdb361c16d13b8408a365565b5baba-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DERIVED_BY_ELIMINATING" />
          <attvalue for="12" value="The net shear stress for cutting (τc) is found by the elimination of the variable R." />
          <attvalue for="13" value="The net shear stress required for cutting, denoted τc, is found by elimination of R from Equations (2.23a) and (2.23b)" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-70bdb361c16d13b8408a365565b5baba" />
          <attvalue for="16" value="1.408014418067641e-05" />
          <attvalue for="17" value="0.40000844808650843" />
        </attvalues>
      </edge>
      <edge source="chunk-70bdb361c16d13b8408a365565b5baba-e-6" target="chunk-70bdb361c16d13b8408a365565b5baba-e-8" id="chunk-70bdb361c16d13b8408a365565b5baba-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DERIVED_FROM" />
          <attvalue for="12" value="The net shear stress for cutting (τc) is derived from Equations (2.23a) and (2.23b)." />
          <attvalue for="13" value="The net shear stress required for cutting, denoted τc, is found by elimination of R from Equations (2.23a) and (2.23b)" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-70bdb361c16d13b8408a365565b5baba" />
          <attvalue for="16" value="1.408014418067641e-05" />
          <attvalue for="17" value="0.40000844808650843" />
        </attvalues>
      </edge>
      <edge source="chunk-70bdb361c16d13b8408a365565b5baba-e-6" target="chunk-70bdb361c16d13b8408a365565b5baba-e-9" id="chunk-70bdb361c16d13b8408a365565b5baba-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DEFINED_BY" />
          <attvalue for="12" value="The net shear stress for cutting (τc) is given by Equation (2.24)." />
          <attvalue for="13" value="τc = (γAPB/b) * ((2r₁ - 2r₂)/(λ₁ + λ₂)) ≈ (γAPB/2b) * [(2r₁/λ₁) - (2r₂/λ₂)] (2.24)" />
