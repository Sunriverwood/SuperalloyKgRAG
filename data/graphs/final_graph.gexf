        <attvalues>
          <attvalue for="11" value="USES" />
          <attvalue for="12" value="The constitutive equations (A1) use strain components (e.g., €11, €22, €33) to calculate stress." />
          <attvalue for="13" value="σ11 = C11€11 + C12€22 + C12€33" />
