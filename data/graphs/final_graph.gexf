      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-4" target="chunk-a4b011eeea4fbc315a0833a25a29121a-e-6" id="chunk-a4b011eeea4fbc315a0833a25a29121a-r-10" weight="5.0">
        <attvalues>
          <attvalue for="11" value="AFFECTS" />
          <attvalue for="12" value="Re has a significant effect on the high-temperature properties of superalloys." />
          <attvalue for="13" value="It is probable that this is the reason why Re has such a significant effect on the high-temperature properties of the superalloys." />
          <attvalue for="14" value="r-10" />
          <attvalue for="15" value="chunk-a4b011eeea4fbc315a0833a25a29121a" />
          <attvalue for="16" value="0.0011199528440907752" />
          <attvalue for="17" value="0.40067197170645447" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-6" target="chunk-9f35adfc9c150d132285785cf907bbcb-e-3" id="chunk-7f5d267485eb6b44a173a04ba9a301e4-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="USED_AS_DOPANT_IN" />
          <attvalue for="12" value="The effects of increasing Hafnium concentration in Udimet 720Li were studied." />
          <attvalue for="13" value="...and Hf from zero to 0.75 wt% were also studied." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-7f5d267485eb6b44a173a04ba9a301e4" />
          <attvalue for="17" value="0.4" />
        </attvalues>
