      <edge source="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29-e-2" target="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29-e-3" id="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="ILLUSTRATED_IN" />
          <attvalue for="12" value="Walston's illustration of the difficulty with the design space is presented in Figure 6.5." />
          <attvalue for="13" value="Walston has illustrated this difficulty in a pictorial sense (see Figure 6.5)..." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29" />
          <attvalue for="16" value="5.783021050196623e-05" />
          <attvalue for="17" value="0.4000346981263012" />
        </attvalues>
      </edge>
      <edge source="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29-e-2" target="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29-e-4" id="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="ANALYZED" />
          <attvalue for="12" value="Walston pointed out that the 'design space' for next-generation single-crystal superalloys is becoming increasingly 'crowded'." />
          <attvalue for="13" value="Walston has illustrated this difficulty in a pictorial sense (see Figure 6.5), pointing out that the 'design space' available for next-generation single-crystal superalloys is becoming increasingly 'crowded'." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29" />
          <attvalue for="16" value="0.0024866990515845476" />
          <attvalue for="17" value="0.40149201943095075" />
        </attvalues>
      </edge>
      <edge source="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29-e-4" target="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29-e-5" id="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="APPLIES_TO" />
          <attvalue for="12" value="The 'design space' is the conceptual area available for the development of next-generation single-crystal superalloys." />
          <attvalue for="13" value="...the 'design space' available for next-generation single-crystal superalloys is becoming increasingly 'crowded'." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29" />
          <attvalue for="16" value="0.00011566042100393245" />
          <attvalue for="17" value="0.4000693962526024" />
        </attvalues>
      </edge>
      <edge source="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29-e-4" target="chunk-d60cc087d5f03ae6059fa8890a861a5b-e-3" id="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IMPACTS" />
          <attvalue for="12" value="The crowded 'design space' forces turbine designers to make decisions about the relative importance of material requirements." />
          <attvalue for="13" value="From the turbine designers' perspective, this means that decisions need to be made concerning the relative importance of the requirements to be exhibited." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-1a3aca6895e2c3ed98b3470c9aa4ae29" />
          <attvalue for="16" value="0.004742077261161231" />
          <attvalue for="17" value="0.4028452463566968" />
        </attvalues>
      </edge>
      <edge source="chunk-d59969b39f742308167ec01469929e5b-e-1" target="chunk-d59969b39f742308167ec01469929e5b-e-2" id="chunk-d59969b39f742308167ec01469929e5b-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS UNSUITABLE FOR" />
          <attvalue for="12" value="The text states it is unlikely that a single composition will be suitable for all turbine engines." />
          <attvalue for="13" value="It means also that it is unlikely that a ‘one-size-fits-all' composition will be identified which is suitable for all turbine engines, so that there is scope for compositions ‘tailored' for different applications." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-d59969b39f742308167ec01469929e5b" />
          <attvalue for="16" value="0.5" />
          <attvalue for="17" value="0.7" />
        </attvalues>
      </edge>
      <edge source="chunk-d59969b39f742308167ec01469929e5b-e-3" target="chunk-d59969b39f742308167ec01469929e5b-e-4" id="chunk-d59969b39f742308167ec01469929e5b-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="ARE DESIGNED FOR" />
          <attvalue for="12" value="The text indicates there is scope for compositions specifically 'tailored' for different applications." />
          <attvalue for="13" value="...so that there is scope for compositions ‘tailored' for different applications." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-d59969b39f742308167ec01469929e5b" />
          <attvalue for="16" value="0.5" />
          <attvalue for="17" value="0.7" />
        </attvalues>
      </edge>
      <edge source="chunk-d59969b39f742308167ec01469929e5b-e-5" target="chunk-3f32f2a159ceed7150fba353307d3969-e-2" id="chunk-ba75e6448ea6f9f49ca3935b800555ba-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="PRODUCE" />
          <attvalue for="12" value="Metallurgists have been able to produce single crystal superalloys with increasing creep resistance." />
          <attvalue for="13" value="the metallurgists who have been able to produce alloys of increasing creep resistance" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-ba75e6448ea6f9f49ca3935b800555ba" />
          <attvalue for="16" value="0.0014457552625491558" />
          <attvalue for="17" value="0.40086745315752953" />
        </attvalues>
      </edge>
      <edge source="chunk-d59969b39f742308167ec01469929e5b-e-5" target="chunk-d59969b39f742308167ec01469929e5b-e-6" id="chunk-d59969b39f742308167ec01469929e5b-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DESIGNS" />
          <attvalue for="12" value="The text provides an example of a metallurgist designing a superalloy composition for an IGT." />
          <attvalue for="13" value="For example, the metallurgist designing a superalloy composition for an IGT is likely to place greater emphasis on corrosion resistance, cost and castability due to the large size of the blading and the operating environment [3]" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-d59969b39f742308167ec01469929e5b" />
          <attvalue for="16" value="0.000983113578533426" />
          <attvalue for="17" value="0.40058986814712005" />
        </attvalues>
      </edge>
      <edge source="chunk-d59969b39f742308167ec01469929e5b-e-6" target="chunk-d59969b39f742308167ec01469929e5b-e-7" id="chunk-d59969b39f742308167ec01469929e5b-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS DESIGNED FOR" />
          <attvalue for="12" value="The name of the composition explicitly states its intended application is for an IGT." />
          <attvalue for="13" value="For example, the metallurgist designing a superalloy composition for an IGT..." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-d59969b39f742308167ec01469929e5b" />
          <attvalue for="16" value="0.0018505667360629193" />
          <attvalue for="17" value="0.40111034004163776" />
        </attvalues>
      </edge>
      <edge source="chunk-d59969b39f742308167ec01469929e5b-e-6" target="chunk-d59969b39f742308167ec01469929e5b-e-9" id="chunk-d59969b39f742308167ec01469929e5b-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS CONSTRAINED BY" />
          <attvalue for="12" value="The designer of a superalloy for an IGT is likely to place greater emphasis on cost, making it a key constraint." />
          <attvalue for="13" value="...the metallurgist designing a superalloy composition for an IGT is likely to place greater emphasis on... cost..." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-d59969b39f742308167ec01469929e5b" />
          <attvalue for="16" value="0.00011566042100393245" />
          <attvalue for="17" value="0.4000693962526024" />
        </attvalues>
      </edge>
      <edge source="chunk-d59969b39f742308167ec01469929e5b-e-7" target="chunk-e3fb38d02a415446b1548e163c6a6dda-e-4" id="chunk-a55ba38301e56c486550e13f957970e0-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="MARKET_OUTSTRIPS" />
          <attvalue for="12" value="The market for IGTs is projected to outstrip the market for aeroengines by the year 2025." />
          <attvalue for="13" value="most projections indicate that by 2025 the market for IGTs will outstrip that for aeroengines, which is itself projected to double by that time." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-a55ba38301e56c486550e13f957970e0" />
          <attvalue for="16" value="0.0034698126301179735" />
          <attvalue for="17" value="0.4020818875780708" />
        </attvalues>
      </edge>
      <edge source="chunk-d59969b39f742308167ec01469929e5b-e-7" target="chunk-a55ba38301e56c486550e13f957970e0-e-4" id="chunk-a55ba38301e56c486550e13f957970e0-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="USED_WITH" />
          <attvalue for="12" value="IGTs are used in conjunction with steam-powered turbines within combined-cycle power plants." />
          <attvalue for="13" value="In part this is due to an increased reliance on combined-cycle power plant, which requires IGTs to be used in conjunction with steam-powered turbines." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-a55ba38301e56c486550e13f957970e0" />
          <attvalue for="16" value="0.002775850104094379" />
          <attvalue for="17" value="0.40166551006245665" />
        </attvalues>
      </edge>
      <edge source="chunk-d59969b39f742308167ec01469929e5b-e-7" target="chunk-af0a9cb061b4d858fd5a6c9a30785963-e-7" id="chunk-af0a9cb061b4d858fd5a6c9a30785963-r-7" weight="5.0">
        <attvalues>
          <attvalue for="11" value="REQUIRES" />
          <attvalue for="12" value="The industrial gas turbine sector will require further developments in superalloy metallurgy." />
          <attvalue for="13" value="Whatever the balance of power between the aeroengine and industrial gas turbine sectors, it seems certain that further developments in superalloy metallurgy and processing will be required" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-af0a9cb061b4d858fd5a6c9a30785963" />
          <attvalue for="16" value="0.014804533888503354" />
          <attvalue for="17" value="0.408882720333102" />
        </attvalues>
      </edge>
