        <attvalues>
          <attvalue for="0" value="Dr Dan Miracle" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="Dan Miracle博士是一位美国科研人员，任职于美国赖特-帕特森空军实验室 (Wright-Patterson Air Force Laboratory)。" />
