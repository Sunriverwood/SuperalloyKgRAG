      <edge source="chunk-d8d142dae6b416fb1b1609254612e5f8-e-3" target="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-12" id="chunk-d8d142dae6b416fb1b1609254612e5f8-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="MAKES_PREVALENT" />
          <attvalue for="12" value="The limited number of activated slip systems is the reason that planar slip is prevalent." />
          <attvalue for="13" value="'planar slip', which is then prevalent due to the limited number of slip systems that are activated." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-d8d142dae6b416fb1b1609254612e5f8" />
          <attvalue for="16" value="0.00041228612657184083" />
          <attvalue for="17" value="0.40024737167594315" />
        </attvalues>
