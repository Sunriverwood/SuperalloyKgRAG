        <attvalues>
          <attvalue for="0" value="low activity processes" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="指用于生产铂铝涂层的一种替代性制造工艺。它作为一种备选技术方案，为制备该类特种防护涂层提供了不同的工艺路径。" />
          <attvalue for="3" value="{}" />
