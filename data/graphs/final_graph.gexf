      <node id="chunk-92b406eccca67ea13b9ebc2a390eadd2-e-8" label="Clean diffusion coatings by chemical vapour deposition">
        <attvalues>
          <attvalue for="0" value="Clean diffusion coatings by chemical vapour deposition" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Clean diffusion coatings by chemical vapour deposition》是一篇由B. M. Warnes和D. C. Punola共同撰写的学术文章，发表于科学期刊《Surface and Coatings Technology》上。该文主要探讨通过化学气相沉积技术制备清洁扩散涂层的方法。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1997&quot;, &quot;volume&quot;: &quot;94–95&quot;, &quot;pages&quot;: &quot;1–6&quot;}" />
          <attvalue for="4" value="e-8" />
