        <attvalues>
          <attvalue for="11" value="IS_ACCOMPANIED_BY" />
          <attvalue for="12" value="The external scale of NiO is accompanied by a sub-scale of Al2O3." />
          <attvalue for="13" value="a continuous, external scale of NiO accompanied by a sub-scale of Cr2O3, Al2O3 and/or the spinel Ni(Al, Cr)2O4." />
