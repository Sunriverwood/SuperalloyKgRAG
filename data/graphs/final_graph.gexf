          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2b0bf628a95c22fc39c3dcd9f2959fd7-e-9&quot;, &quot;chunk-9b8241b51916aa0fe236ff3e6c045cdf-e-3&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2b0bf628a95c22fc39c3dcd9f2959fd7-e-10" label="Temperature field">
        <attvalues>
          <attvalue for="0" value="Temperature field" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="温度场是一种物理状态，指一个物体或空间区域内各点温度的分布情况。它是一个随时间和空间变化的标量场，在热力学和传热学中是基本概念。其分布不均匀或随时间变化是引起材料内部产生热应力与残余应力的主要原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-2b0bf628a95c22fc39c3dcd9f2959fd7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2b0bf628a95c22fc39c3dcd9f2959fd7-e-10&quot;, &quot;chunk-9b8241b51916aa0fe236ff3e6c045cdf-e-4&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2b0bf628a95c22fc39c3dcd9f2959fd7-e-11" label="Material deformation behaviour">
        <attvalues>
          <attvalue for="0" value="Material deformation behaviour" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;材料变形行为是一种材料属性，指材料在应力作用下产生应变（形状或尺寸改变）的响应特性。它通常包含弹性变形、塑性变形和断裂等阶段，是表征材料力学性能、进行结构设计和失效分析的核心依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-2b0bf628a95c22fc39c3dcd9f2959fd7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2b0bf628a95c22fc39c3dcd9f2959fd7-e-11&quot;, &quot;chunk-9b8241b51916aa0fe236ff3e6c045cdf-e-5&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9b8241b51916aa0fe236ff3e6c045cdf-e-1" label="Modelling">
        <attvalues>
          <attvalue for="0" value="Modelling" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种在制造业中应用的计算过程，旨在通过数学方法量化各类物理因素与工艺结果之间的关系。它能够实现对残余应力场等现象的分析，并用于优化机械加工等具体操作，以提升生产效率与产品质量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-9b8241b51916aa0fe236ff3e6c045cdf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-9b8241b51916aa0fe236ff3e6c045cdf-e-6" label="Residual stress field">
        <attvalues>
          <attvalue for="0" value="Residual stress field" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="残余应力场是一种物理状态，指在外部载荷、热梯度等外因移除后，仍保留在材料内部并处于自相平衡状态的内应力分布。它是材料制造和加工历史的产物，其分布可通过建模来量化，并对构件的强度、疲劳寿命及尺寸稳定性有重要影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-9b8241b51916aa0fe236ff3e6c045cdf" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Residual stress fields&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2b0bf628a95c22fc39c3dcd9f2959fd7-e-4&quot;, &quot;chunk-9b8241b51916aa0fe236ff3e6c045cdf-e-6&quot;, &quot;chunk-ee2c916092b69050b73e7898f576b082-e-6&quot;, &quot;chunk-523637843506c3574fe003659e8f0b3e-e-6&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-9b8241b51916aa0fe236ff3e6c045cdf-e-8" label="Lathing operations">
        <attvalues>
          <attvalue for="0" value="Lathing operations" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="车削是一种机械加工工艺，指在车床上利用工件的旋转运动和刀具的进给运动来切削多余材料。它主要用于加工具有旋转对称性的零件，如内外圆柱面、圆锥面、螺纹和沟槽。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-9b8241b51916aa0fe236ff3e6c045cdf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9b8241b51916aa0fe236ff3e6c045cdf-e-9" label="Excessive metal movement and deformation">
        <attvalues>
          <attvalue for="0" value="Excessive metal movement and deformation" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="**过度金属移动和变形**&#10;&#10;指在机械加工过程中，工件产生的位移或形状改变超出了预定义的公差范围。这是一种会导致部件被拒收甚至报废的不良现象，因此加工工艺通常会进行优化以预防其发生。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-9b8241b51916aa0fe236ff3e6c045cdf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-9b8241b51916aa0fe236ff3e6c045cdf-e-10" label="Pre-defined tolerance levels">
        <attvalues>
          <attvalue for="0" value="Pre-defined tolerance levels" />
          <attvalue for="1" value="Specification" />
          <attvalue for="2" value="一种预先设定的技术规范，用于定义零件变形的最大允许限值。若变形量超出此限值，该零件将被判定为不合格并予以报废，是确保最终产品符合质量要求的关键标准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-9b8241b51916aa0fe236ff3e6c045cdf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9b8241b51916aa0fe236ff3e6c045cdf-e-11" label="Scrapping of components">
        <attvalues>
          <attvalue for="0" value="Scrapping of components" />
          <attvalue for="1" value="Outcome" />
          <attvalue for="2" value="指部件因物理缺陷（如过度变形）导致其尺寸超出规定公差范围，不符合质量标准，最终被判定为不合格并废弃处理的结果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-9b8241b51916aa0fe236ff3e6c045cdf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9b8241b51916aa0fe236ff3e6c045cdf-e-12" label="State-of-the-art process models">
        <attvalues>
          <attvalue for="0" value="State-of-the-art process models" />
          <attvalue for="1" value="Process Model" />
          <attvalue for="2" value="前沿工艺模型是一种先进的建模技术，用于定量预测和模拟材料在特定工艺条件下微观结构的动态演变过程，代表了该领域的最高技术水平。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-9b8241b51916aa0fe236ff3e6c045cdf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-fd0257f35193366950536d3c582b3768-e-1" label="process models">
        <attvalues>
          <attvalue for="0" value="process models" />
          <attvalue for="1" value="Computational Tool" />
          <attvalue for="2" value="过程模型是一种计算工具，通过提供物理洞见来预测微观结构的演变。它常被用于工业生产中的质量保证等任务，是一个活跃的研究领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
