      <node id="chunk-2b7a9fe88ca8d6ac202cedf8f0e4d421-e-7" label="N. Yamaguchi">
        <attvalues>
          <attvalue for="0" value="N. Yamaguchi" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="N. Yamaguchi，一位研究人员，作为共同作者参与撰写了关于氧化锆-氧化钇(ZrO2-Y2O3)层晶体织构演变的学术论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-2b7a9fe88ca8d6ac202cedf8f0e4d421" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2b7a9fe88ca8d6ac202cedf8f0e4d421-e-8" label="H. Matsubara">
        <attvalues>
          <attvalue for="0" value="H. Matsubara" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="H. Matsubara是一位研究人员，其专业领域为材料科学。他专注于氧化锆-氧化钇（ZrO2-Y2O3）等陶瓷材料的晶体织构演化，并以合著者身份发表了相关领域的学术论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-2b7a9fe88ca8d6ac202cedf8f0e4d421" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2b7a9fe88ca8d6ac202cedf8f0e4d421-e-9" label="ZrO2-Y2O3 layers">
        <attvalues>
          <attvalue for="0" value="ZrO2-Y2O3 layers" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="由氧化锆(ZrO2)和氧化钇(Y2O3)组成的陶瓷材料层，即氧化钇稳定氧化锆(YSZ)。它通过电子束物理气相沉积技术制备，具有因该工艺产生的特定晶体织构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-2b7a9fe88ca8d6ac202cedf8f0e4d421" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2b7a9fe88ca8d6ac202cedf8f0e4d421-e-9&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2b7a9fe88ca8d6ac202cedf8f0e4d421-e-11" label="Publication [16]">
        <attvalues>
          <attvalue for="0" value="Publication [16]" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由K. Wada、N. Yamaguchi和H. Matsubara合著的学术论文，题为《Crystallographic texture evolution in ZrO2-Y2O3 layers produced by electron beam physical vapour deposition》。该文于2004年发表于《Surface and Coatings Technology》期刊，研究了电子束物理气相沉积法制备的氧化锆-氧化钇（ZrO2-Y2O3）层的晶体织构演变。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2004&quot;, &quot;volume&quot;: &quot;184&quot;, &quot;pages&quot;: &quot;55–62&quot;}" />
