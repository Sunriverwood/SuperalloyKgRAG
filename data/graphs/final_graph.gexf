      <node id="chunk-6f4f79d57f35ab3e77324ff6707d70bf-e-10" label="H. Harada">
        <attvalues>
          <attvalue for="0" value="H. Harada" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="H. Harada是一位学者或研究人员，研究领域涉及材料科学或航空航天工程。作为论文《先进喷气发动机退役TBC部件的降解机理》的合著者，他/她的研究工作聚焦于喷气发动机热障涂层（TBC）在服役后的失效与退化机制。" />
          <attvalue for="3" value="{}" />
