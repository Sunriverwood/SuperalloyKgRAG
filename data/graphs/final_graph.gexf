          <attvalue for="7" value="[&quot;Metallurgical and Materials Transactions, 32A&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7027df3183981418ce449ee96ef327a1-e-7&quot;]}]" />
