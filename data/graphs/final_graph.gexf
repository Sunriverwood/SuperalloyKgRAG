        <attvalues>
          <attvalue for="0" value="Figure 4.51" />
          <attvalue for="1" value="Data Source" />
          <attvalue for="2" value="图4.51是一张展示材料横截面积的数据图。该图通过其包含的数据，证实了基于二维截面准确估算材料中夹杂物体积分数的固有难度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
