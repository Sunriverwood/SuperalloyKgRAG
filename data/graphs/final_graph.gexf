        <attvalues>
          <attvalue for="11" value="TO_BE_DETERMINED_FOR" />
          <attvalue for="12" value="The useful work is a quantity to be determined for the specified ideal cycle." />
          <attvalue for="13" value="Assuming an ideal cycle such that the turbine work equals the work of compression, determine the useful work available to provide a propulsive force." />
