        <attvalues>
          <attvalue for="11" value="EXHIBITS" />
          <attvalue for="12" value="IN100 is an example of a P/M alloy that exhibits the correlation where crack growth rates scale with yield stress." />
          <attvalue for="13" value="...for many of the P/M alloys developed to that point, such as... IN100... crack growth rates scaled with the yield stress..." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-2457bc4af0771717326f8f8489539e06" />
