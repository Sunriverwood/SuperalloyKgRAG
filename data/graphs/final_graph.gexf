          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-e-9&quot;, &quot;chunk-fd08a4d01f900e8f06f5ce2b9d625965-e-7&quot;]}]" />
          <attvalue for="9" value="253" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-e-10" label="Equation (2.28a)">
        <attvalues>
          <attvalue for="0" value="Equation (2.28a)" />
          <attvalue for="1" value="Mathematical Equation" />
          <attvalue for="2" value="源自《镍及其合金的物理冶金学》的数学方程(2.28a)，该方程通过变量 L、R、λ₁ 和 φ 给出了对 λ₁³ 的定义。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;λ₁³ = 2L²R = L²λ₁/cos{φ/2}&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-e-11" label="Equation (2.28b)">
        <attvalues>
          <attvalue for="0" value="Equation (2.28b)" />
          <attvalue for="1" value="Mathematical Equation" />
          <attvalue for="2" value="方程（2.28b）是一个数学方程，它将比值 (λ₁/L)² 表示为变量 φ、T 和 F 的函数。该方程明确了这些物理量之间的定量关系，并用于定义或求解 λ₁。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;(λ₁/L)² = 1/cos{φ/2} = 2T/F&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-e-11&quot;]}]" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-e-12" label="Equation (2.28c)">
        <attvalues>
          <attvalue for="0" value="Equation (2.28c)" />
          <attvalue for="1" value="Mathematical Equation" />
          <attvalue for="2" value="方程(2.28c)是用于定义参数λ₁的数学公式，它将λ₁表示为由变量T、F和L构成的函数关系。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;λ₁ = (2T/F)¹/² × L&quot;}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-e-12&quot;]}]" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-e-13" label="Equation (2.28d)">
        <attvalues>
          <attvalue for="0" value="Equation (2.28d)" />
          <attvalue for="1" value="Mathematical Equation" />
          <attvalue for="2" value="方程(2.28d)是一个数学公式，它根据变量 T、F、f 和 r₁ 来定义 λ₁ 的值。该方程是基于方程(2.27)作为前提条件推导得出的。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;λ₁ = (2T/F)¹/² × (2π/(3f))¹/² × r₁&quot;}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-e-13&quot;]}]" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-e-14" label="Equation (2.27)">
        <attvalues>
          <attvalue for="0" value="Equation (2.27)" />
          <attvalue for="1" value="Mathematical Equation" />
          <attvalue for="2" value="在特定文献中被编号为 (2.27) 的数学方程。它是一个先前已确立的表达式，在相关数学推导中，被用作得出方程 (2.28d) 的基础或前提条件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-e-15" label="The physical metallurgy of nickel and its alloys">
        <attvalues>
          <attvalue for="0" value="The physical metallurgy of nickel and its alloys" />
          <attvalue for="1" value="Source Document" />
          <attvalue for="2" value="《镍及其合金的物理冶金学》是一部系统阐述镍基材料的成分、结构、工艺与性能之间关系的学术著作。该文献是物理冶金学领域的专业资料，常被用作研究和引用的来源。" />
          <attvalue for="3" value="{&quot;page&quot;: &quot;78&quot;}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-997d3c401570597d742a9d087ab0476d-e-1" label="Equation (2.28d)">
        <attvalues>
          <attvalue for="0" value="Equation (2.28d)" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="公式(2.28d)是一个用于确定弗里德尔间距(Friedel spacing)的关键方程。该方程被代入公式(2.24)中，以推导出临界分切应力(critical resolved shear stress)的估算值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-997d3c401570597d742a9d087ab0476d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="46" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-997d3c401570597d742a9d087ab0476d-e-2" label="Equation (2.28c)">
        <attvalues>
          <attvalue for="0" value="Equation (2.28c)" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="方程 (2.28c) 是一个关键的数学公式，用于定义或计算物理学概念“弗里德尔间距”(Friedel spacing)。它在相关理论推导中具有基础性的重要作用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-997d3c401570597d742a9d087ab0476d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="46" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-997d3c401570597d742a9d087ab0476d-e-3" label="Friedel spacing (symbolic/abstract physical quantity)">
        <attvalues>
          <attvalue for="0" value="Friedel spacing (symbolic/abstract physical quantity)" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="弗里德尔间距 (Friedel spacing) 是一个以λ₁为符号的物理量。它是一个与方晶格间距成正比的特征间距参数，在相关物理方程（如2.28c, 2.28d）中作为关键参数使用。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;λ₁&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-997d3c401570597d742a9d087ab0476d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Friedel spacing&quot;, &quot;Friedel spacings&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-997d3c401570597d742a9d087ab0476d-e-3&quot;, &quot;chunk-02948169a54de26c861e1fa5741b30de-e-4&quot;]}]" />
          <attvalue for="9" value="46" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-997d3c401570597d742a9d087ab0476d-e-4" label="Square lattice spacing">
        <attvalues>
          <attvalue for="0" value="Square lattice spacing" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="方格点阵间距 (Square lattice spacing) 是一个表示方格点阵中特征距离的物理量，通常用符号L表示。其值与解链面积 (unzipped area) 的平方根成反比，且与弗里德尔间距 (Friedel spacing) 成正比。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;L&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-997d3c401570597d742a9d087ab0476d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;square lattice spacing&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-997d3c401570597d742a9d087ab0476d-e-4&quot;, &quot;chunk-02948169a54de26c861e1fa5741b30de-e-5&quot;]}]" />
          <attvalue for="9" value="46" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-997d3c401570597d742a9d087ab0476d-e-5" label="Unzipped area">
        <attvalues>
          <attvalue for="0" value="Unzipped area" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="Unzipped area是一个物理量，通常记为A，指一个特定区域的面积。根据其物理定义，该面积的平方根与方晶格的间距大小成反比关系。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;A&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-997d3c401570597d742a9d087ab0476d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="46" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-997d3c401570597d742a9d087ab0476d-e-6" label="Critical resolved shear stress">
        <attvalues>
          <attvalue for="0" value="Critical resolved shear stress" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="临界分切应力（CRSS）是单晶体在特定滑移系（滑移面和滑移方向）上启动塑性变形（滑移）所需的最小切应力。当作用在滑移系上的分切应力达到此临界值时，位错开始运动，引发滑移。它是表征晶体材料塑性变形抗力的一个基本物理量。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;τc&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-997d3c401570597d742a9d087ab0476d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="46" />
          <attvalue for="10" value="2" />
