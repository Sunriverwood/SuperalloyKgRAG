      <edge source="chunk-8a09d4abdceadaee1556e78882f58629-e-8" target="chunk-077fe9c69fdb63678553adb8495eef57-e-2" id="chunk-077fe9c69fdb63678553adb8495eef57-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="PRODUCED_BY_MANIPULATION_OF" />
          <attvalue for="12" value="'herringbone' structures are produced by the manipulation of the substrate during the deposition process." />
          <attvalue for="13" value="Further microstructural modifications in the form of 'herringbone' structures have been produced by manipulation of the substrate during deposition, giving symmetrical zig-zag or wavy columns [59];" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-077fe9c69fdb63678553adb8495eef57" />
          <attvalue for="16" value="0.5" />
          <attvalue for="17" value="0.7" />
        </attvalues>
      </edge>
      <edge source="chunk-077fe9c69fdb63678553adb8495eef57-e-3" target="chunk-077fe9c69fdb63678553adb8495eef57-e-4" id="chunk-077fe9c69fdb63678553adb8495eef57-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_LOWER_THERMAL_CONDUCTIVITY_THAN" />
          <attvalue for="12" value="It is claimed that coatings with 'herringbone' structures can have a thermal conductivity up to 25% lower than straight-columned TBCs." />
          <attvalue for="13" value="it has been claimed that the thermal conductivity of the coatings produced in this way can be up to 25% lower than so-called straight-columned TBCs produced ordinarily." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-077fe9c69fdb63678553adb8495eef57" />
          <attvalue for="16" value="0.5" />
          <attvalue for="17" value="0.7" />
        </attvalues>
      </edge>
      <edge source="chunk-e01b059cc1c9a00298a478f93a9ec05a-e-2" target="chunk-e01b059cc1c9a00298a478f93a9ec05a-e-3" id="chunk-e01b059cc1c9a00298a478f93a9ec05a-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="FOCUSES" />
          <attvalue for="12" value="High-velocity gas flows are used to focus the vapour plume during deposition." />
          <attvalue for="13" value="Similar structures have been produced using high-velocity gas flows to focus the vapour plume, a process which has been christened ‘directed vapour deposition'" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-e01b059cc1c9a00298a478f93a9ec05a" />
          <attvalue for="16" value="0.1" />
          <attvalue for="17" value="0.46" />
        </attvalues>
      </edge>
