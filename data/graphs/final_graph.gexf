        <attvalues>
          <attvalue for="11" value="LEADS_TO" />
          <attvalue for="12" value="Controversy exists regarding the specific failure conditions that lead to TBC failure." />
          <attvalue for="13" value="It is emphasised that, at this point, controversy exists concerning the circumstances leading to TBC failure – possibly due to the difficulty in reproducing the failure conditions" />
          <attvalue for="14" value="r-2" />
