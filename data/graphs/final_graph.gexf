        </attvalues>
      </node>
      <node id="chunk-e8782374074efdfc5b7bd36ebce09647-e-11" label="a">
        <attvalues>
          <attvalue for="0" value="a" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="变量a是一个物理维度参数，在公式(4.2)和(4.3)中被用于估算σε和στ。在进行估算时，其取值为7.5厘米；而在进行理论分析时，其值被设定为0。" />
          <attvalue for="3" value="{&quot;estimation_value&quot;: &quot;7.5 cm&quot;, &quot;condition_value&quot;: &quot;0&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-e8782374074efdfc5b7bd36ebce09647" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-e8782374074efdfc5b7bd36ebce09647-e-13" label="b">
        <attvalues>
          <attvalue for="0" value="b" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="参数b是一个值为33厘米的线性尺寸，在相关计算中，它被用作求解环向应力(σο)的一个关键输入变量。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;33 cm&quot;}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-e8782374074efdfc5b7bd36ebce09647" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e8782374074efdfc5b7bd36ebce09647-e-13&quot;, &quot;chunk-7a1f5be456518061b87546ca7f9d9812-e-3&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-e8782374074efdfc5b7bd36ebce09647-e-14" label="w">
        <attvalues>
          <attvalue for="0" value="w" />
          <attvalue for="1" value="Rotational Speed" />
          <attvalue for="2" value="参数w，代表转速（Rotational Speed）。它是一个用于描述发动机等旋转机械运行状态的物理量，也是计算环向应力（σο）等力学指标的关键输入。其设定值与机械尺寸相关，大型发动机通常需要较低的转速。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;10000 rev/min&quot;}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-e8782374074efdfc5b7bd36ebce09647" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e8782374074efdfc5b7bd36ebce09647-e-14&quot;, &quot;chunk-7a1f5be456518061b87546ca7f9d9812-e-5&quot;, &quot;chunk-63b965a50bbef46a7e7134449d064762-e-2&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-7a1f5be456518061b87546ca7f9d9812-e-1" label="Tensile stress (στ as axial stress)">
        <attvalues>
          <attvalue for="0" value="Tensile stress (στ as axial stress)" />
          <attvalue for="1" value="Stress Component" />
          <attvalue for="2" value="στ，通常指拉应力（Tensile Stress），是材料力学中的一个基本物理量。它描述物体因受到轴向拉伸力而在其内部产生的正应力，其方向垂直于作用截面，会导致材料发生伸长变形。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-7a1f5be456518061b87546ca7f9d9812" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;στ&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7a1f5be456518061b87546ca7f9d9812-e-1&quot;]}]" />
          <attvalue for="9" value="299" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-7a1f5be456518061b87546ca7f9d9812-e-2" label="σε (True Stress)">
        <attvalues>
          <attvalue for="0" value="σε (True Stress)" />
          <attvalue for="1" value="Stress Component" />
          <attvalue for="2" value="σε，通常指真实应力（True Stress），是材料力学中的一个应力分量。它定义为瞬时载荷除以材料变形后的瞬时横截面积。该值与真实应变(ε)共同描述了材料的内在力学性能，是表征材料本构关系的关键物理量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-7a1f5be456518061b87546ca7f9d9812" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;σε&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7a1f5be456518061b87546ca7f9d9812-e-2&quot;]}]" />
          <attvalue for="9" value="300" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-7a1f5be456518061b87546ca7f9d9812-e-10" label="Equation (4.4)">
        <attvalues>
          <attvalue for="0" value="Equation (4.4)" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="方程(4.4)是一个数学方程，阐述了孔应力（Bore Stress）与线性尺寸之间的缩放关系，即孔应力如何根据线性尺寸的变化而等比例变化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-7a1f5be456518061b87546ca7f9d9812" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="111" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7a1f5be456518061b87546ca7f9d9812-e-11" label="Bore Stress">
        <attvalues>
          <attvalue for="0" value="Bore Stress" />
          <attvalue for="1" value="Stress" />
          <attvalue for="2" value="指发生在物体内孔（bore）处的应力。其关键特征是，应力大小与物体的线性尺寸的平方成正比，这一缩放关系可由特定方程（如公式4.4）描述。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-7a1f5be456518061b87546ca7f9d9812" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7a1f5be456518061b87546ca7f9d9812-e-11&quot;]}]" />
          <attvalue for="9" value="111" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7a1f5be456518061b87546ca7f9d9812-e-12" label="Larger Engines">
        <attvalues>
          <attvalue for="0" value="Larger Engines" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种尺寸较大的发动机部件。其物理特性决定了它必须以相对较低的角速度（w）或转速运行，尺寸与所需转速通常成反比关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-7a1f5be456518061b87546ca7f9d9812" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7a1f5be456518061b87546ca7f9d9812-e-13" label="Linear Dimensions">
        <attvalues>
          <attvalue for="0" value="Linear Dimensions" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;线性尺寸 (Linear Dimensions) 是一个关键物理参数，通常指长度、半径等一维测量值。在相关力学模型中，孔应力 (Bore Stress) 的大小与该参数的平方成正比，因此它被用作决定孔应力缩放比例的核心变量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-7a1f5be456518061b87546ca7f9d9812" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="111" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-63b965a50bbef46a7e7134449d064762-e-1" label="Linear dimensions">
        <attvalues>
          <attvalue for="0" value="Linear dimensions" />
          <attvalue for="1" value="Geometric Parameter" />
          <attvalue for="2" value="作为一种几何参数，线性尺寸指组件在单一方向上的物理大小，如长度、宽度或直径。它不仅决定组件的空间占用和形态，还直接影响其操作性能，例如可能与另一参数（如w）呈反向相关关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-63b965a50bbef46a7e7134449d064762" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-63b965a50bbef46a7e7134449d064762-e-4" label="Materials with high-yield stresses">
        <attvalues>
          <attvalue for="0" value="Materials with high-yield stresses" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="指具有高屈服强度的材料类别。这类材料能承受巨大应力而不发生永久塑性变形，是制造航空发动机涡轮盘等关键承力部件的基础材料，对其安全可靠运行至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-63b965a50bbef46a7e7134449d064762" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="184" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-63b965a50bbef46a7e7134449d064762-e-5" label="Turbine-disc applications">
        <attvalues>
          <attvalue for="0" value="Turbine-disc applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="指涡轮盘在航空发动机、燃气轮机等设备中的应用场景。因部件需在高温和高速旋转下承受巨大应力，该应用对材料的屈服强度有极高要求，以防止发生永久变形，确保结构完整性和运行安全。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-63b965a50bbef46a7e7134449d064762" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="184" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-63b965a50bbef46a7e7134449d064762-e-6" label="Geometry">
        <attvalues>
          <attvalue for="0" value="Geometry" />
          <attvalue for="1" value="Design Parameter" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;几何形状 (Geometry) 是一个关键设计参数，用于定义组件的外形、尺寸和空间构造。它直接决定了组件内部的应力分布和大小，因此其精确设计对于确保产品的结构完整性、性能和可靠性至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-63b965a50bbef46a7e7134449d064762" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="185" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-63b965a50bbef46a7e7134449d064762-e-7" label="Stress levels">
        <attvalues>
          <attvalue for="0" value="Stress levels" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="作为一项关键性能指标，应力水平用于量化物体或部件内部因外力作用而产生的内力大小。该指标直接关系到结构的安全与寿命，其分布和峰值受几何形状等设计因素显著影响，必须控制在许用范围内。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-63b965a50bbef46a7e7134449d064762" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="185" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-63b965a50bbef46a7e7134449d064762-e-9" label="Parasitic weight">
        <attvalues>
          <attvalue for="0" value="Parasitic weight" />
          <attvalue for="1" value="Negative Outcome" />
          <attvalue for="2" value="寄生重量（Parasitic weight）是在工程设计中，因过度保守（如安全系数过高）而产生的非功能性多余重量。它对结构强度或功能并无贡献，反而会增加成本、降低系统整体性能和效率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-63b965a50bbef46a7e7134449d064762" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-63b965a50bbef46a7e7134449d064762-e-9&quot;, &quot;chunk-926a036993bc42eccb957e97d54b732e-e-2&quot;]}]" />
          <attvalue for="9" value="37" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-926a036993bc42eccb957e97d54b732e-e-1" label="Conservatism in component design">
        <attvalues>
          <attvalue for="0" value="Conservatism in component design" />
          <attvalue for="1" value="Design Philosophy" />
          <attvalue for="2" value="一种设计哲学，为确保组件的安全与可靠性而采用较大的安全裕度。这种方法在过度应用时，会因材料冗余而增加不必要的寄生重量，从而影响整体效率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-926a036993bc42eccb957e97d54b732e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="37" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-926a036993bc42eccb957e97d54b732e-e-4" label="Life-to-first-crack approach">
        <attvalues>
          <attvalue for="0" value="Life-to-first-crack approach" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="初始裂纹寿命法 (Life-to-first-crack approach) 是一种在英国用于评估断裂关键部件寿命的方法。它将部件的安全服役寿命定义为萌生初始裂纹所需的时间或循环次数，是涡轮盘等高完整性要求组件的常用设计准则。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-926a036993bc42eccb957e97d54b732e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Life-to-first-crack method&quot;, &quot;life-to-first-crack approach&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cbf4d780dd2a841aa5348c2c70b0276f-e-7&quot;, &quot;chunk-926a036993bc42eccb957e97d54b732e-e-4&quot;, &quot;chunk-18de6e8fd136f10abd92c810dc2280ba-e-1&quot;, &quot;chunk-e3a4ba849abe93a2a6728157cbd079b2-e-3&quot;, &quot;chunk-bd5710a1dc51c42dffb282b63e6aaa4f-e-1&quot;, &quot;chunk-c54fb0cde287461ac785a255da940d8d-e-8&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-926a036993bc42eccb957e97d54b732e-e-6" label="Fracture critical components">
        <attvalues>
          <attvalue for="0" value="Fracture critical components" />
          <attvalue for="1" value="Component Category" />
          <attvalue for="2" value="**断裂关键件**&#10;&#10;指一类其断裂会引发灾难性后果的零部件。为此，这类部件在设计与管理上必须采用“初始裂纹寿命方法”，即在其寿命周期内不允许出现任何裂纹，一旦发现便需立即更换。高压涡轮盘是其典型代表。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-926a036993bc42eccb957e97d54b732e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-926a036993bc42eccb957e97d54b732e-e-7" label="HP turbine disc">
        <attvalues>
          <attvalue for="0" value="HP turbine disc" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="高压涡轮盘（HP turbine disc）是涡轮发动机高压部分的核心旋转部件，用于承载涡轮叶片。它在极端应力和高温下运行，其结构完整性对飞行安全至关重要，任何失效都可能导致灾难性后果，因此被定义为断裂关键部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-926a036993bc42eccb957e97d54b732e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1ac6995f0fe228ff138a38c832d667fd-e-2" label="safe-life policy">
        <attvalues>
          <attvalue for="0" value="safe-life policy" />
          <attvalue for="1" value="Policy" />
          <attvalue for="2" value="一种设计与维护策略，它将部件的“失效”定义为工程裂纹达到一个预设的特定尺寸。该策略应用于高压涡轮盘等关键部件，要求在裂纹扩展至危险程度前就将其退役，以预防灾难性故障的发生。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-1ac6995f0fe228ff138a38c832d667fd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1ac6995f0fe228ff138a38c832d667fd-e-3" label="engineering crack">
        <attvalues>
          <attvalue for="0" value="engineering crack" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="工程裂纹是一种缺陷，在安全寿命原则下，它的出现即被定义为部件失效。该裂纹尺寸小于引发快速灾难性断裂的临界值，且其探测能力受限于无损检测（NDI）方法。" />
          <attvalue for="3" value="{&quot;surface length&quot;: &quot;0.75 mm&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-1ac6995f0fe228ff138a38c832d667fd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-1ac6995f0fe228ff138a38c832d667fd-e-4" label="Non-destructive inspection (NDI)">
        <attvalues>
          <attvalue for="0" value="Non-destructive inspection (NDI)" />
          <attvalue for="1" value="Inspection Method" />
          <attvalue for="2" value="无损检测（NDI）是在不损坏被检测对象的前提下，利用物理或化学方法，对其内部及表面的结构、性质、状态进行检查和测试的技术总称。其目的是发现材料或工件中的缺陷（如裂纹、夹杂），并评估其完整性。常用方法包括超声、射线、磁粉及渗透检测等。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1ac6995f0fe228ff138a38c832d667fd" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Non-destructive inspection (NDI) methods&quot;, &quot;non-destructive inspection&quot;, &quot;non-destructive inspection (NDI) methods&quot;, &quot;nondestructive inspection (NDI)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1ac6995f0fe228ff138a38c832d667fd-e-4&quot;, &quot;chunk-a20a835d2cdab6d6d8e5c12e628578cc-e-1&quot;, &quot;chunk-1297af8788c2be7a2a158412cd2652f3-e-5&quot;, &quot;chunk-9c5b2b7dade746247326fc0930d280e0-e-7&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1ac6995f0fe228ff138a38c832d667fd-e-5" label="fast catastrophic fracture">
        <attvalues>
          <attvalue for="0" value="fast catastrophic fracture" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="在断裂力学中，快速断裂（Fast Fracture）是一种材料失效事件。它指当材料中的裂纹长度达到临界值（acrit）时，裂纹会失稳并迅速扩展，最终导致结构发生突然且灾难性破坏的瞬间。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1ac6995f0fe228ff138a38c832d667fd" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Fast Fracture&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1ac6995f0fe228ff138a38c832d667fd-e-5&quot;, &quot;chunk-18de6e8fd136f10abd92c810dc2280ba-e-7&quot;, &quot;chunk-d6cd281784308ff093a41e825b50764e-e-5&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a20a835d2cdab6d6d8e5c12e628578cc-e-2" label="Spin Rig Testing">
        <attvalues>
          <attvalue for="0" value="Spin Rig Testing" />
          <attvalue for="1" value="Test Equipment" />
          <attvalue for="2" value="旋转试验台 (Spin Rigs) 是一种专用测试设备，通过使高压涡轮盘等部件高速旋转，来评估其在巨大离心力作用下的结构完整性、材料性能和疲劳寿命。该测试是确保关键旋转部件在极端工况下安全可靠运行的重要验证手段。" />
          <attvalue for="3" value="{&quot;cost_per_test&quot;: &quot;$250000 to $500000&quot;, &quot;number_of_tests&quot;: &quot;small, rarely exceeds five&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a20a835d2cdab6d6d8e5c12e628578cc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Spin rig testing&quot;, &quot;spin rigs&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1ac6995f0fe228ff138a38c832d667fd-e-6&quot;, &quot;chunk-a20a835d2cdab6d6d8e5c12e628578cc-e-2&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a20a835d2cdab6d6d8e5c12e628578cc-e-4" label="Number of cycles to failure">
        <attvalues>
          <attvalue for="0" value="Number of cycles to failure" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="失效循环次数是一个衡量部件耐久性的性能指标，指其失效前能承受的运行循环总数。该指标的统计模型通常遵循对数正态分布，是估算安全使用寿命的基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a20a835d2cdab6d6d8e5c12e628578cc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a20a835d2cdab6d6d8e5c12e628578cc-e-5" label="Log-normal density function">
        <attvalues>
          <attvalue for="0" value="Log-normal density function" />
          <attvalue for="1" value="Statistical Model" />
          <attvalue for="2" value="对数正态密度函数是一种连续概率分布的数学函数。若一随机变量的对数服从正态分布，则该变量自身服从对数正态分布。该函数常用于为恒为正值的变量建模，例如在可靠性工程中，它被假定为“失效循环次数”的统计分布模型。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a20a835d2cdab6d6d8e5c12e628578cc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a20a835d2cdab6d6d8e5c12e628578cc-e-5&quot;, &quot;chunk-499702b336b2277c0acd3c75976b9758-e-2&quot;]}]" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-499702b336b2277c0acd3c75976b9758-e-1" label="Number of cycles to failure">
        <attvalues>
          <attvalue for="0" value="Number of cycles to failure" />
          <attvalue for="1" value="Probabilistic Variable" />
          <attvalue for="2" value="表示盘件疲劳寿命的概率变量，指其在失效前能承受的载荷循环总数。该变量通常服从对数正态分布，其数据的离散性由离散因子量化，其安全下限（如最低保证寿命）则由特定分位数（如1/750分位数）定义。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-499702b336b2277c0acd3c75976b9758" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-499702b336b2277c0acd3c75976b9758-e-3" label="95% confidence level">
        <attvalues>
          <attvalue for="0" value="95% confidence level" />
          <attvalue for="1" value="Statistical Parameter" />
          <attvalue for="2" value="一个用于衡量统计估计可靠性的概率值。它表示在多次重复实验中，通过特定方法构建的区间有95%的可能包含真实的总体参数（如真实的裂纹率）。在此上下文中，它量化了“750个盘片中有1个”这一裂纹发生率估计值的可信度。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;95%&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-499702b336b2277c0acd3c75976b9758" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-499702b336b2277c0acd3c75976b9758-e-4" label="Crack of surface length greater than 0.75 mm">
        <attvalues>
          <attvalue for="0" value="Crack of surface length greater than 0.75 mm" />
          <attvalue for="1" value="Defect Criterion" />
          <attvalue for="2" value="一种失效判据，指将材料或结构中出现的0.75毫米长裂纹定义为失效。该特定长度作为一个保守的阈值，旨在提供安全裕度并创造额外的安全系数，以保证结构的完整性和可靠性。" />
          <attvalue for="3" value="{&quot;surface_length&quot;: &quot;&gt; 0.75 mm&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-499702b336b2277c0acd3c75976b9758" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;0.75 mm long crack&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-499702b336b2277c0acd3c75976b9758-e-4&quot;, &quot;chunk-bf397c87db59ffcc5a67f58416f7a430-e-1&quot;]}]" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-499702b336b2277c0acd3c75976b9758-e-5" label="1 in 750 discs">
        <attvalues>
          <attvalue for="0" value="1 in 750 discs" />
          <attvalue for="1" value="Occurrence Rate" />
          <attvalue for="2" value="指在95%置信水平下评估的最大预期发生率。在该发生率下，每750个圆盘中预计有1个含有长度大于0.75毫米的表面裂纹。此比率在统计学上对应于1/750分位数。" />
          <attvalue for="3" value="{&quot;rate&quot;: &quot;1/750&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-499702b336b2277c0acd3c75976b9758" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-499702b336b2277c0acd3c75976b9758-e-6" label="1/750 quantile">
        <attvalues>
          <attvalue for="0" value="1/750 quantile" />
          <attvalue for="1" value="Statistical Quantile" />
          <attvalue for="2" value="一个统计学分位数，指在概率分布中仅有1/750的观测值低于该值的点。在正态分布中，它约等于-3个标准差（-3σ），常被用作工程可靠性分析中的下限，例如为“失效前循环次数”设定一个保守的最低保证值。" />
          <attvalue for="3" value="{&quot;sigma_level&quot;: &quot;-3σ&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-499702b336b2277c0acd3c75976b9758" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Lower 1/750 Quartile Life&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-499702b336b2277c0acd3c75976b9758-e-6&quot;, &quot;chunk-cae41d8859f876b74046ac829e1e4b4c-e-2&quot;]}]" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-499702b336b2277c0acd3c75976b9758-e-7" label="Scatter factor">
        <attvalues>
          <attvalue for="0" value="Scatter factor" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="分散系数 (Scatter Factor) 是一个统计学概念，主要用于结构疲劳安全寿命计算。它是一个为保证可靠性而设定的安全系数，用以量化和覆盖因材料性能、制造工艺等因素导致的试验数据离散性，从而将试验寿命换算为保守的许用安全寿命。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;6&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-499702b336b2277c0acd3c75976b9758" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Scatter Factor&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-499702b336b2277c0acd3c75976b9758-e-7&quot;, &quot;chunk-cae41d8859f876b74046ac829e1e4b4c-e-1&quot;]}]" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cae41d8859f876b74046ac829e1e4b4c-e-3" label="Geometric Mean">
        <attvalues>
          <attvalue for="0" value="Geometric Mean" />
          <attvalue for="1" value="Statistical Measure" />
          <attvalue for="2" value="几何平均数是一种衡量中心趋势的数学概念，定义为n个正数乘积的n次方根。它常用于计算变量的平均增长率或比较不同尺度的数据。在工程可靠性分析中，它可由试验数据（如旋转试验）计算得出，代表一种特征寿命，而“安全寿命”通常是低于该值的保守估计。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-cae41d8859f876b74046ac829e1e4b4c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;geometric mean&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cae41d8859f876b74046ac829e1e4b4c-e-3&quot;, &quot;chunk-98f4bd6f7320ce29bc3a42071b0fee20-e-2&quot;]}]" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-cae41d8859f876b74046ac829e1e4b4c-e-4" label="Spin Testing">
        <attvalues>
          <attvalue for="0" value="Spin Testing" />
          <attvalue for="1" value="Test Method" />
          <attvalue for="2" value="Spin Testing是一种以获取几何平均值为核心目的的测试方法。它通过标准化的计算流程，为评估一个数据集的集中趋势提供关键统计指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-cae41d8859f876b74046ac829e1e4b4c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cae41d8859f876b74046ac829e1e4b4c-e-5" label="Lower Confidence Bound">
        <attvalues>
          <attvalue for="0" value="Lower Confidence Bound" />
          <attvalue for="1" value="Statistical Limit" />
          <attvalue for="2" value="在统计学中，置信下限（Lower Confidence Bound, LCB）是置信区间的下端点。它为一个未知参数（如产品寿命）提供了一个保守的估计值，即我们有特定置信度（如95%）相信真实参数值大于或等于该值。" />
          <attvalue for="3" value="{&quot;factor&quot;: &quot;6^(1.645/6√n)&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-cae41d8859f876b74046ac829e1e4b4c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="301" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-cae41d8859f876b74046ac829e1e4b4c-e-6" label="95% Confidence Limit">
        <attvalues>
          <attvalue for="0" value="95% Confidence Limit" />
          <attvalue for="1" value="Statistical Limit" />
          <attvalue for="2" value="95%置信极限是一种统计学限值，它界定了一个置信区间的端点。根据样本数据计算，该区间有95%的概率包含真实的总体参数（如均值）。在正态分布下，该限值通常对应距样本均值特定倍数的标准差，例如1.645个标准差。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-cae41d8859f876b74046ac829e1e4b4c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cae41d8859f876b74046ac829e1e4b4c-e-7" label="1.645 Standard Deviations">
        <attvalues>
          <attvalue for="0" value="1.645 Standard Deviations" />
          <attvalue for="1" value="Statistical Value" />
          <attvalue for="2" value="一个统计学中的Z值，代表在标准正态分布下，对应单侧95%置信水平的临界值。在“安全寿命”计算中，它被用作分母的指数，以确保寿命预测结果达到特定的可靠性或置信度标准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-cae41d8859f876b74046ac829e1e4b4c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;1.645 standard deviations&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cae41d8859f876b74046ac829e1e4b4c-e-7&quot;, &quot;chunk-98f4bd6f7320ce29bc3a42071b0fee20-e-5&quot;]}]" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cae41d8859f876b74046ac829e1e4b4c-e-9" label="Safe Life Calculation Procedure">
        <attvalues>
          <attvalue for="0" value="Safe Life Calculation Procedure" />
          <attvalue for="1" value="Method" />
          <attvalue for="2" value="一种用于确定部件或结构安全寿命的统计学方法。该程序通过综合运用置信限与散布因子等统计变量进行计算，从而界定一个在规定可靠度下，可接受的无故障运行周期。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-cae41d8859f876b74046ac829e1e4b4c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cae41d8859f876b74046ac829e1e4b4c-e-9&quot;]}]" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-98f4bd6f7320ce29bc3a42071b0fee20-e-1" label="Safe Life">
        <attvalues>
          <attvalue for="0" value="Safe Life" />
          <attvalue for="1" value="Engineering Concept" />
          <attvalue for="2" value="安全使用寿命 (Safe service life) 是一个工程概念，指在特定假设条件下，构件或系统能够安全运行的规定期限。这些假设通常涉及材料性能、载荷条件和预期的失效循环次数等，旨在确保设备在其寿命期内不会发生灾难性失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-98f4bd6f7320ce29bc3a42071b0fee20" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;'Safe Life'&quot;, &quot;Safe service life&quot;, &quot;safe life&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a20a835d2cdab6d6d8e5c12e628578cc-e-3&quot;, &quot;chunk-cae41d8859f876b74046ac829e1e4b4c-e-8&quot;, &quot;chunk-98f4bd6f7320ce29bc3a42071b0fee20-e-1&quot;]}]" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-98f4bd6f7320ce29bc3a42071b0fee20-e-3" label="Denominator">
        <attvalues>
          <attvalue for="0" value="Denominator" />
          <attvalue for="1" value="Mathematical Term" />
          <attvalue for="2" value="Denominator是一个数学术语，指在“安全寿命”方程中使用的分母。它是一个统计折减系数，用于将几何平均寿命降低至具有特定置信度的安全寿命。其值根据样本量'n'和1.645倍标准差等参数计算得出。" />
          <attvalue for="3" value="{&quot;formula_component&quot;: &quot;(2.449 x 6^((1.645)/(6√n)))&quot;, &quot;value_at_n=1&quot;: &quot;4.00&quot;, &quot;value_at_n=3&quot;: &quot;3.25&quot;, &quot;value_at_n=8&quot;: &quot;2.90&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-98f4bd6f7320ce29bc3a42071b0fee20" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-98f4bd6f7320ce29bc3a42071b0fee20-e-4" label="n">
        <attvalues>
          <attvalue for="0" value="n" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="在安全寿命（safe life）方程中的一个变量，通常指用于统计分析的样本数量或试验次数。该参数是决定分母等相关统计量的基础，对评估材料或结构的疲劳寿命至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-98f4bd6f7320ce29bc3a42071b0fee20" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5672d8823c0e88aff98a62f9c1f74614-e-1" label="Safety Factor">
        <attvalues>
          <attvalue for="0" value="Safety Factor" />
          <attvalue for="1" value="Engineering Metric" />
          <attvalue for="2" value="安全系数 (Safety Factor) 是一个工程学指标，用于衡量系统或结构的冗余强度，通常定义为其实际极限承载能力与设计要求荷载的比值。在特定情况下，其数值的确定会依赖于所测试的组件数量，以评估系统的统计可靠性。" />
          <attvalue for="3" value="{&quot;value_at_n=1&quot;: &quot;4.00&quot;, &quot;value_at_n=3&quot;: &quot;3.25&quot;, &quot;value_at_n=8&quot;: &quot;2.90&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-5672d8823c0e88aff98a62f9c1f74614" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="186" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5672d8823c0e88aff98a62f9c1f74614-e-2" label="Number of Components Tested">
        <attvalues>
          <attvalue for="0" value="Number of Components Tested" />
          <attvalue for="1" value="Test Parameter" />
          <attvalue for="2" value="一个测试参数，指代在特定测试中所检验的组件总数，通常用符号'n'表示。该数值是计算安全系数时的关键输入变量，其大小会直接影响最终的评估结果。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;n&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-5672d8823c0e88aff98a62f9c1f74614" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="186" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5672d8823c0e88aff98a62f9c1f74614-e-3" label="'First Crack'">
        <attvalues>
          <attvalue for="0" value="'First Crack'" />
          <attvalue for="1" value="Calculation Basis" />
          <attvalue for="2" value="First Crack 是一种保守的计算基础，它通过采用审慎的参数和假设，为计算结果提供安全边际，以确保最终方案的可靠性与安全性。" />
          <attvalue for="3" value="{&quot;property&quot;: &quot;conservative&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-5672d8823c0e88aff98a62f9c1f74614" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5672d8823c0e88aff98a62f9c1f74614-e-4" label="Surface Crack">
        <attvalues>
          <attvalue for="0" value="Surface Crack" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="一种存在于材料表面的线状缺陷。当其长度或深度扩展至临界值时，会显著降低结构强度，并可能引发灾难性失效，例如导致盘片爆裂。" />
          <attvalue for="3" value="{&quot;burst_length_threshold&quot;: &quot;&gt; 0.75 mm&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-5672d8823c0e88aff98a62f9c1f74614" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="187" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5672d8823c0e88aff98a62f9c1f74614-e-5" label="Disc">
        <attvalues>
          <attvalue for="0" value="Disc" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种圆盘状的机械构件。由于其在高速旋转等工况下承受巨大应力，表面的裂纹会成为应力集中点，进而引发灾难性的突发破裂（即爆裂）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-5672d8823c0e88aff98a62f9c1f74614" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="187" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5672d8823c0e88aff98a62f9c1f74614-e-6" label="Margin of Safety">
        <attvalues>
          <attvalue for="0" value="Margin of Safety" />
          <attvalue for="1" value="Engineering Concept" />
          <attvalue for="2" value="安全裕度（Margin of safety）是一个工程安全概念，指结构或系统的实际承载能力超出其设计要求负载的程度。它通过设定失效准则（如可容忍0.75毫米的裂纹）来提供一个内置的安全缓冲，以确保系统在承受超预期载荷或存在缺陷时仍能安全运行。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-5672d8823c0e88aff98a62f9c1f74614" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Margin of safety&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5672d8823c0e88aff98a62f9c1f74614-e-6&quot;, &quot;chunk-bf397c87db59ffcc5a67f58416f7a430-e-2&quot;]}]" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-bf397c87db59ffcc5a67f58416f7a430-e-3" label="Damage-tolerant lifing">
        <attvalues>
          <attvalue for="0" value="Damage-tolerant lifing" />
          <attvalue for="1" value="Engineering Procedure" />
          <attvalue for="2" value="**损伤容限寿命预测 (Damage-tolerant lifing)**&#10;&#10;一种工程评估方法，用于确定含缺陷结构或部件的服役寿命。在此方法中，对于失效准则的选择以及是否应用额外安全系数，会引发关于寿命评估结果保守性的两难困境，从而影响最终决策。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-bf397c87db59ffcc5a67f58416f7a430" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bf397c87db59ffcc5a67f58416f7a430-e-3&quot;]}]" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bf397c87db59ffcc5a67f58416f7a430-e-4" label="'extra' safety factor">
        <attvalues>
          <attvalue for="0" value="'extra' safety factor" />
          <attvalue for="1" value="Safety Concept" />
          <attvalue for="2" value="一种安全概念，指因将0.75毫米裂纹设定为失效点而产生的、量值不确定的附加安全系数。它的存在给损伤容限寿命评定程序带来了难题。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-bf397c87db59ffcc5a67f58416f7a430" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="38" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-18de6e8fd136f10abd92c810dc2280ba-e-2" label="damage-tolerant approach">
        <attvalues>
          <attvalue for="0" value="damage-tolerant approach" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="损伤容限法是一种断裂力学设计方法。它假定结构中存在初始缺陷，并依据帕里斯定律（Paris Law）、材料断裂韧性（K₁c）和应力范围（Δσ），计算缺陷从初始尺寸扩展至临界尺寸所需的疲劳寿命（N）。该方法旨在确保含缺陷结构在服役期内的安全。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-18de6e8fd136f10abd92c810dc2280ba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Damage-tolerant approach&quot;, &quot;damage tolerant approach&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-18de6e8fd136f10abd92c810dc2280ba-e-2&quot;, &quot;chunk-ace58b767445aef942b5ed63e65aad6c-e-10&quot;, &quot;chunk-98004d55693f7f9432c5daf0464e7353-e-3&quot;, &quot;chunk-0e400a717c0177b6e54870a3d685e980-e-7&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="10" />
        </attvalues>
      </node>
      <node id="chunk-18de6e8fd136f10abd92c810dc2280ba-e-3" label="retirement for cause method">
        <attvalues>
          <attvalue for="0" value="retirement for cause method" />
          <attvalue for="1" value="Lifing Approach" />
          <attvalue for="2" value="有因退役法（Retirement for Cause Method）是一种结构寿命评定方法，即“损伤容限法”的别称。该方法假定结构中存在初始缺陷，通过分析裂纹从初始尺寸扩展至临界尺寸的过程，来确定结构的安全使用寿命和检查间隔，从而确保其在服役期间的完整性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-18de6e8fd136f10abd92c810dc2280ba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-18de6e8fd136f10abd92c810dc2280ba-e-4" label="burst">
        <attvalues>
          <attvalue for="0" value="burst" />
          <attvalue for="1" value="Failure Event" />
          <attvalue for="2" value="一种被定义为快速灾难性断裂的失效事件。其发生的临界条件，特别是产生该事件所需的裂纹长度，通常通过断裂力学方法进行估算。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-18de6e8fd136f10abd92c810dc2280ba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-18de6e8fd136f10abd92c810dc2280ba-e-5" label="fracture mechanics approach">
        <attvalues>
          <attvalue for="0" value="fracture mechanics approach" />
          <attvalue for="1" value="Analysis Method" />
          <attvalue for="2" value="断裂力学方法是一种应用断裂力学原理的工程分析方法。它通过分析材料中已有裂纹在循环载荷下的扩展行为，来预测疲劳裂纹的扩展速率和路径，从而估算结构部件发生断裂所需的循环次数或剩余寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-18de6e8fd136f10abd92c810dc2280ba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Fracture Mechanics Approach&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-18de6e8fd136f10abd92c810dc2280ba-e-5&quot;, &quot;chunk-d6cd281784308ff093a41e825b50764e-e-1&quot;, &quot;chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676-e-12&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-18de6e8fd136f10abd92c810dc2280ba-e-6" label="fatigue crack">
        <attvalues>
          <attvalue for="0" value="fatigue crack" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="疲劳裂纹（fatigue crack）是一种在循环载荷作用下萌生和扩展的结构缺陷。在损伤容限分析方法中，其以载荷循环次数为单位的扩展速率是评估结构完整性和预测剩余寿命的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-18de6e8fd136f10abd92c810dc2280ba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Fatigue Crack&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-18de6e8fd136f10abd92c810dc2280ba-e-6&quot;, &quot;chunk-d6cd281784308ff093a41e825b50764e-e-3&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d6cd281784308ff093a41e825b50764e-e-2" label="Number of Cycles">
        <attvalues>
          <attvalue for="0" value="Number of Cycles" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="在断裂力学中，这是一个用于评估疲劳寿命的关键参数，指通过特定方法估算出的、使疲劳裂纹发生扩展所需的载荷循环数量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-d6cd281784308ff093a41e825b50764e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d6cd281784308ff093a41e825b50764e-e-4" label="acrit">
        <attvalues>
          <attvalue for="0" value="acrit" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="acrit (临界裂纹长度) 是一个断裂力学参数，指在特定应力下，导致材料发生快速断裂的裂纹长度阈值。当裂纹达到或超过该长度时，结构会失稳破坏。其计算通常涉及材料的断裂韧性 (K1c)、应力 (Stress) 及几何因子 (Y)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d6cd281784308ff093a41e825b50764e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;a_crit&quot;, &quot;size required for burst (acrit)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d6cd281784308ff093a41e825b50764e-e-4&quot;, &quot;chunk-f73ef33407197a56c2a6d96f014100a5-e-5&quot;, &quot;chunk-c07d98a8c6e8b07242a68bd712fcfe4c-e-12&quot;, &quot;chunk-e77911125f8830a7b4bf67b20165ed0e-e-9&quot;, &quot;chunk-57054d164541d83734201813bb4b9d8f-e-1&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-d6cd281784308ff093a41e825b50764e-e-6" label="Y">
        <attvalues>
          <attvalue for="0" value="Y" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="一个在计算临界值'acrit'时所假定的几何因子参数。它用于量化和表征裂纹、缺陷或构件的几何形状对计算结果的影响。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;0.67&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-d6cd281784308ff093a41e825b50764e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d6cd281784308ff093a41e825b50764e-e-8" label="Stress">
        <attvalues>
          <attvalue for="0" value="Stress" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="一个用于工程计算的假定应力物理量。其数值在定义上等于材料的规定塑性延伸强度（Proof Strength），常被用作特定计算（如acrit计算）的输入参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-d6cd281784308ff093a41e825b50764e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d6cd281784308ff093a41e825b50764e-e-9" label="Proof Strength">
        <attvalues>
          <attvalue for="0" value="Proof Strength" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="规定塑性延伸强度（Proof Strength）是一种材料力学性能，指材料在拉伸试验中产生特定微小永久变形（通常为0.2%）时所对应的应力。它常用于衡量没有明确屈服点的金属材料（如镍基合金）的弹性极限，是工程结构设计和安全分析中的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-d6cd281784308ff093a41e825b50764e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;proof strength&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d6cd281784308ff093a41e825b50764e-e-9&quot;, &quot;chunk-095e7b19e19ba75f3f37b75ed9ca8622-e-3&quot;, &quot;chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec-e-4&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-d6cd281784308ff093a41e825b50764e-e-10" label="Crack Lengths at Initiation">
        <attvalues>
          <attvalue for="0" value="Crack Lengths at Initiation" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="一个工程参数，指在损伤容限或疲劳分析中假定的初始裂纹尺寸。其值等效于无损检测技术能够可靠检出的最小缺陷尺寸，即无损检测极限(aNDI)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-d6cd281784308ff093a41e825b50764e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f73ef33407197a56c2a6d96f014100a5-e-2" label="one-third dysfunction">
        <attvalues>
          <attvalue for="0" value="one-third dysfunction" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="三分之一功能障碍 (one-third dysfunction) 是一种特定的功能障碍状态。其判定标准或关键特征是存在一个0.50毫米的相关测量值。该术语将一个具体量化的物理测量与某种功能异常状况关联起来。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-f73ef33407197a56c2a6d96f014100a5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f73ef33407197a56c2a6d96f014100a5-e-2&quot;, &quot;chunk-57054d164541d83734201813bb4b9d8f-e-8&quot;, &quot;chunk-63304b61ed04760729e5b6e71982902a-e-1&quot;]}]" />
          <attvalue for="9" value="61" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f73ef33407197a56c2a6d96f014100a5-e-3" label="two-thirds dysfunction">
        <attvalues>
          <attvalue for="0" value="two-thirds dysfunction" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="三分之二功能障碍（two-thirds dysfunction）是一种以特定物理测量值为特征的功能失调状况。其诊断标准为相关测量值达到1.20毫米。该名称源于此数值（1.20毫米）恰好是正常或预期基准值（推测为1.80毫米）的三分之二，通过这种比例关系来界定其功能障碍的程度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-f73ef33407197a56c2a6d96f014100a5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f73ef33407197a56c2a6d96f014100a5-e-3&quot;, &quot;chunk-57054d164541d83734201813bb4b9d8f-e-9&quot;, &quot;chunk-63304b61ed04760729e5b6e71982902a-e-2&quot;]}]" />
          <attvalue for="9" value="61" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f73ef33407197a56c2a6d96f014100a5-e-4" label="failure">
        <attvalues>
          <attvalue for="0" value="failure" />
          <attvalue for="1" value="Event" />
          <attvalue for="2" value="在部件的生命周期中，继一系列渐进性功能障碍（如“三分之一功能障碍”）之后发生的最终事件。此事件假定在特定运行循环次数时出现，标志着部件功能完全丧失。" />
          <attvalue for="3" value="{&quot;assumed_life&quot;: &quot;10000 cycles&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f73ef33407197a56c2a6d96f014100a5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="61" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f73ef33407197a56c2a6d96f014100a5-e-6" label="Fatigue-crack propagation data (da/dN data)">
        <attvalues>
          <attvalue for="0" value="Fatigue-crack propagation data (da/dN data)" />
          <attvalue for="1" value="Data Type" />
          <attvalue for="2" value="一种表征材料疲劳裂纹每循环扩展速率(da/dN)的数据，是进行疲劳裂纹扩展分析和寿命预测的必要输入，其规律通常符合Paris定律表达式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-f73ef33407197a56c2a6d96f014100a5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f73ef33407197a56c2a6d96f014100a5-e-6&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f73ef33407197a56c2a6d96f014100a5-e-8" label="Fatigue-crack propagation analysis">
        <attvalues>
          <attvalue for="0" value="Fatigue-crack propagation analysis" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="疲劳裂纹扩展分析是一种断裂力学计算方法。它基于材料的疲劳裂纹扩展数据(da/dN)，用于计算和预测裂纹从无损检测可发现的初始尺寸(aNDI)扩展至导致断裂的临界尺寸(acrit)所需的时间或循环次数，以评估构件的疲劳寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-f73ef33407197a56c2a6d96f014100a5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c07d98a8c6e8b07242a68bd712fcfe4c-e-2" label="da/dN">
        <attvalues>
          <attvalue for="0" value="da/dN" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="**da/dN**&#10;&#10;在断裂力学中指疲劳裂纹扩展速率，是一个描述材料疲劳性能的核心变量。它精确定义了材料在循环载荷下，每个载荷循环（dN）所引起的裂纹长度的增量（da），单位为米/周（m/cycle）。该速率通常通过帕里斯定律（Paris' Law）与应力强度因子范围（ΔΚ）相关联。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c07d98a8c6e8b07242a68bd712fcfe4c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c07d98a8c6e8b07242a68bd712fcfe4c-e-2&quot;, &quot;chunk-e77911125f8830a7b4bf67b20165ed0e-e-1&quot;, &quot;chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec-e-10&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c07d98a8c6e8b07242a68bd712fcfe4c-e-3" label="A">
        <attvalues>
          <attvalue for="0" value="A" />
          <attvalue for="1" value="Constant" />
          <attvalue for="2" value="在断裂力学中，A是帕里斯定律（Paris Law）中的一个经验常数，也称帕里斯定律系数。它是一个与具体材料、环境、应力比等因素相关的属性，与指数m共同用于量化和预测材料的疲劳裂纹扩展速率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c07d98a8c6e8b07242a68bd712fcfe4c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="302" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-c07d98a8c6e8b07242a68bd712fcfe4c-e-4" label="ΔK">
        <attvalues>
          <attvalue for="0" value="ΔK" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="ΔK，即应力强度因子范围，是Paris定律中描述疲劳裂纹扩展驱动力的核心参量。它在线性弹性断裂力学中，综合了循环应力范围(Δσ)、裂纹长度(a)及几何形状因子(Υ)的影响，用于预测裂纹的扩展速率。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;Υ∆σ√πa&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c07d98a8c6e8b07242a68bd712fcfe4c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;ΔΚ&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c07d98a8c6e8b07242a68bd712fcfe4c-e-4&quot;, &quot;chunk-e77911125f8830a7b4bf67b20165ed0e-e-2&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-c07d98a8c6e8b07242a68bd712fcfe4c-e-5" label="m">
        <attvalues>
          <attvalue for="0" value="m" />
          <attvalue for="1" value="Exponent" />
          <attvalue for="2" value="m，即帕里斯指数（Paris exponent），是帕里斯定律中的一个无量纲经验常数。它用于表征材料（如高温合金）的疲劳裂纹扩展特性，其数值反映了裂纹扩展速率对应力强度因子的敏感度，需通过实验确定。" />
          <attvalue for="3" value="{&quot;value_range&quot;: &quot;between 3 and 4 for superalloys&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c07d98a8c6e8b07242a68bd712fcfe4c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c07d98a8c6e8b07242a68bd712fcfe4c-e-7" label="Υ">
        <attvalues>
          <attvalue for="0" value="Υ" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="Υ (Upsilon) 是断裂力学中的一个变量，代表一个无量纲的几何因子。它被用于计算应力强度因子范围 (ΔK) 的表达式中，用以量化裂纹体的几何形状、尺寸及加载方式对裂纹尖端应力场的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c07d98a8c6e8b07242a68bd712fcfe4c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c07d98a8c6e8b07242a68bd712fcfe4c-e-8" label="Δσ">
        <attvalues>
          <attvalue for="0" value="Δσ" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="Δσ，指应力范围（Stress Range），是损伤容限法中的一个关键数据常量。它代表材料在循环载荷下所承受的最大应力与最小应力之差，是预测疲劳裂纹扩展速率、评估结构部件剩余寿命的核心输入参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-c07d98a8c6e8b07242a68bd712fcfe4c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Cyclic Stress, Δσ&quot;, &quot;∆σ&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c07d98a8c6e8b07242a68bd712fcfe4c-e-8&quot;, &quot;chunk-a6a0b0d2c85b7b920c33d8bae94d9958-e-3&quot;, &quot;chunk-98004d55693f7f9432c5daf0464e7353-e-5&quot;, &quot;chunk-3f9080fcd7c49e23baf06d3cf81ed207-e-4&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-c07d98a8c6e8b07242a68bd712fcfe4c-e-9" label="a">
        <attvalues>
          <attvalue for="0" value="a" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="在断裂力学中，变量`a`是表示裂纹长度的物理量。作为计算应力强度因子范围(ΔK)的关键输入参数，它被用于评估材料的断裂韧性及预测疲劳裂纹的扩展行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-c07d98a8c6e8b07242a68bd712fcfe4c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c07d98a8c6e8b07242a68bd712fcfe4c-e-10" label="No">
        <attvalues>
          <attvalue for="0" value="No" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="在断裂力学中，No (失效循环数) 是一个通过对 Paris 定律积分而得到的方程。它用于计算裂纹从初始尺寸 (a_NDI) 扩展到临界尺寸 (a_crit) 所需的疲劳循环总次数，以此预测构件的疲劳寿命。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;1 / (A(m/2 – 1)Y^m Δσ^m π^(m/2)) * [1 / a_NDI^(m/2-1) - 1 / a_crit^(m/2-1)]&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-c07d98a8c6e8b07242a68bd712fcfe4c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8f26cf45a6fdac28f68b7d1e6d3677ff-e-1" label="No">
        <attvalues>
          <attvalue for="0" value="No" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="一个工程学变量，指材料或构件在失效前所能承受的载荷循环总数，即疲劳寿命。其数值通常通过“失效循环方程”计算或预测得出，是评估结构可靠性的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-8f26cf45a6fdac28f68b7d1e6d3677ff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="188" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8f26cf45a6fdac28f68b7d1e6d3677ff-e-2" label="Failure Cycle Equation">
        <attvalues>
          <attvalue for="0" value="Failure Cycle Equation" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="失效周期方程是一个数学公式，用于计算或预测材料、构件在承受循环载荷作用下，发生疲劳失效所需的循环次数（No）。它在工程和材料科学领域中被广泛用于评估结构的疲劳寿命。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;No = 1 / (A(m/2 – 1)Y^m Δσ^m π^(m/2)) * [1 / a_NDI^(m/2-1) - 1 / a_crit^(m/2-1)]&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-8f26cf45a6fdac28f68b7d1e6d3677ff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="188" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8f26cf45a6fdac28f68b7d1e6d3677ff-e-3" label="Knott [48]">
        <attvalues>
          <attvalue for="0" value="Knott [48]" />
          <attvalue for="1" value="Reference" />
          <attvalue for="2" value="由Knott撰写的参考文献，编号为[48]。该文献为多晶镍基高温合金提供了一项数值分析研究。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-8f26cf45a6fdac28f68b7d1e6d3677ff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8f26cf45a6fdac28f68b7d1e6d3677ff-e-4" label="polycrystalline nickel-based superalloys">
        <attvalues>
          <attvalue for="0" value="polycrystalline nickel-based superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种具有多晶体结构的镍基高温合金。因其在高温下具备优异的机械强度、耐久性和抗疲劳性能，是制造航空发动机和燃气轮机涡轮盘等承受极端工况的核心部件的关键材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-8f26cf45a6fdac28f68b7d1e6d3677ff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8f26cf45a6fdac28f68b7d1e6d3677ff-e-5" label="turbine disc applications">
        <attvalues>
          <attvalue for="0" value="turbine disc applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="一种工程应用，指使用多晶镍基高温合金等高性能材料，制造航空发动机和燃气轮机中的核心旋转部件——涡轮盘。该应用要求材料能在高温、高应力的严苛工况下长期可靠运行。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-8f26cf45a6fdac28f68b7d1e6d3677ff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e77911125f8830a7b4bf67b20165ed0e-e-3" label="da/dN = 4 × 10⁻¹² ΔK^3.3">
        <attvalues>
          <attvalue for="0" value="da/dN = 4 × 10⁻¹² ΔK^3.3" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="该方程是帕里斯定律（Paris's Law）的一种具体形式，为一个经验公式。它描述了材料的稳定疲劳裂纹扩展速率（da/dN）与应力强度因子范围（ΔΚ）之间的关系。公式中的 4 × 10⁻¹² 和 3.3 是由实验确定的特定材料常数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-e77911125f8830a7b4bf67b20165ed0e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;da/dN = 4 × 10−12 ΔΚ^3.3&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8f26cf45a6fdac28f68b7d1e6d3677ff-e-7&quot;, &quot;chunk-e77911125f8830a7b4bf67b20165ed0e-e-3&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-e77911125f8830a7b4bf67b20165ed0e-e-4" label="Y">
        <attvalues>
          <attvalue for="0" value="Y" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="断裂力学参数，是计算半圆形表面裂纹应力强度因子时所使用的几何形状修正系数。该无量纲系数考虑了裂纹与构件的具体几何形状对裂纹尖端应力场的影响。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;0.67&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-e77911125f8830a7b4bf67b20165ed0e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="189" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e77911125f8830a7b4bf67b20165ed0e-e-5" label="Semicircular edge crack">
        <attvalues>
          <attvalue for="0" value="Semicircular edge crack" />
          <attvalue for="1" value="Geometric Feature" />
          <attvalue for="2" value="一种从构件边缘起始、裂纹前沿呈半圆形的表面裂纹。它是在断裂力学中用于评估结构完整性的标准化几何模型，其应力强度分析涉及一个特定的几何因子Y。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e77911125f8830a7b4bf67b20165ed0e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="189" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e77911125f8830a7b4bf67b20165ed0e-e-8" label="Ar">
        <attvalues>
          <attvalue for="0" value="Ar" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="Ar是一个变量，代表假定的应力范围值。在断裂力学和疲劳分析中，它是一个关键的输入参数，用于计算材料的临界裂纹尺寸(acrit)。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;800 MPa&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-e77911125f8830a7b4bf67b20165ed0e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-57054d164541d83734201813bb4b9d8f-e-4" label="10000 cycles">
        <attvalues>
          <attvalue for="0" value="10000 cycles" />
          <attvalue for="1" value="Requirement" />
          <attvalue for="2" value="一项针对涡轮盘设定的最低寿命要求，规定其在退役前必须能安全工作至少10000个工作循环。该要求是确定部件无损检测（aNDI）限制和检修周期的关键依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-57054d164541d83734201813bb4b9d8f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-57054d164541d83734201813bb4b9d8f-e-5" label="'first crack'">
        <attvalues>
          <attvalue for="0" value="'first crack'" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="一个在“首次裂纹寿命”方法中使用的参数，用于量化材料在形成初始裂纹前的预测寿命或损伤程度。该值常与aNDI limit等许用限值进行比较，以评估结构完整性与安全性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-57054d164541d83734201813bb4b9d8f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-57054d164541d83734201813bb4b9d8f-e-6" label="a at 3300 cycles">
        <attvalues>
          <attvalue for="0" value="a at 3300 cycles" />
          <attvalue for="1" value="State" />
          <attvalue for="2" value="指材料或结构在经历3300次疲劳循环后，其裂纹尺寸'a'所处的一种特定状态。该状态的出现，标志着系统已达到三分之一的功能障碍。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;0.50 mm&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-57054d164541d83734201813bb4b9d8f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-57054d164541d83734201813bb4b9d8f-e-6&quot;]}]" />
          <attvalue for="9" value="61" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-57054d164541d83734201813bb4b9d8f-e-7" label="a at 6700 cycles">
        <attvalues>
          <attvalue for="0" value="a at 6700 cycles" />
          <attvalue for="1" value="State" />
          <attvalue for="2" value="在6700次循环时测得的裂纹尺寸'a'。该尺寸值所表征的状态，与系统达到“三分之二功能障碍”(two-thirds dysfunction)的程度相对应。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;1.20 mm&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-57054d164541d83734201813bb4b9d8f" />
          <attvalue for="6" value="true" />
