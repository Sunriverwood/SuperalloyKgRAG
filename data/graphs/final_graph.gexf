      <node id="chunk-398a384cc3aa286c4fab7654b4862802-e-7" label="Optimisation of single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="Optimisation of single-crystal superalloys" />
          <attvalue for="1" value="Topic" />
          <attvalue for="2" value="指通过优化化学成分、热处理及制备工艺，旨在提升单晶高温合金的综合力学性能，特别是其高温强度、抗蠕变性和疲劳寿命，以满足航空发动机等尖端领域的严苛应用需求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-398a384cc3aa286c4fab7654b4862802" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-46d5bcfdf9cb882db631b70343f35d62-e-2" label="Primary dendrite arm spacing">
        <attvalues>
          <attvalue for="0" value="Primary dendrite arm spacing" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="一次枝晶臂间距（Primary Dendrite Arm Spacing）是一个关键的微观组织特征参数，定义为金属凝固过程中相邻一次枝晶主干的中心距离。该参数的大小显著影响材料的力学性能及宏观偏析缺陷（如雀斑）的形成，是控制凝固组织和性能的重要指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-46d5bcfdf9cb882db631b70343f35d62" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Primary arm spacing, Lp&quot;, &quot;primary dendrite arm spacing&quot;, &quot;primary dendrite arm spacing, Lp&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58-e-4&quot;, &quot;chunk-398a384cc3aa286c4fab7654b4862802-e-3&quot;, &quot;chunk-46d5bcfdf9cb882db631b70343f35d62-e-2&quot;, &quot;chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676-e-15&quot;, &quot;chunk-5518f1c4ab4a7b4e100f841b3b90e572-e-2&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-46d5bcfdf9cb882db631b70343f35d62-e-3" label="Commercial superalloys">
        <attvalues>
          <attvalue for="0" value="Commercial superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="商用高温合金是一类高性能金属材料，可在极端高温下保持优异的机械强度和抗腐蚀性。其最终性能由凝固过程形成的微观结构决定，例如可通过控制热梯度(G)和凝固速率(v)等条件来调控其一次枝晶臂间距。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-46d5bcfdf9cb882db631b70343f35d62" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-46d5bcfdf9cb882db631b70343f35d62-e-4" label="G and v conditions">
        <attvalues>
          <attvalue for="0" value="G and v conditions" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="G和v条件指材料凝固过程中的关键工艺参数组合：温度梯度（G）与凝固速率（v）。这两个变量共同控制着从液相到固相的转变过程，从而决定最终的微观组织和材料性能，常用于商业高温合金的制备与研究。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-46d5bcfdf9cb882db631b70343f35d62" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
