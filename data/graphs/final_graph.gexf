          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5b143324ae92718a4dde1cd69bd72bd2-e-10&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3ca8a51d3be3a429f4f741571769150f-e-6" label="Aerospace applications">
        <attvalues>
          <attvalue for="0" value="Aerospace applications" />
          <attvalue for="1" value="Application Domain" />
          <attvalue for="2" value="航空航天应用是指在飞机、火箭、卫星等飞行器的设计、制造与运行中的技术实践。该领域对材料性能要求严苛，因此常使用钛、铝、镍等具备高强度重量比、耐高温、耐腐蚀特性的金属及合金，以确保飞行器在极端环境下的可靠性与安全性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-3ca8a51d3be3a429f4f741571769150f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-323f9e8ea85610f0279e242666644995-e-1" label="Outer d electrons">
        <attvalues>
          <attvalue for="0" value="Outer d electrons" />
          <attvalue for="1" value="Atomic Structure" />
          <attvalue for="2" value="外层d电子 (Outer d electrons) 是指过渡金属原子中，位于次外层d轨道的价电子。这些电子能参与形成金属键，产生强大的内聚力，这是过渡金属普遍具有高熔点、高硬度、高密度等特性的主要原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-323f9e8ea85610f0279e242666644995" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="245" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-323f9e8ea85610f0279e242666644995-e-2" label="Transition metals">
        <attvalues>
          <attvalue for="0" value="Transition metals" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="一类以其外层d电子为根本特征的金属。这些d电子的存在为原子间提供了强大的内聚力，是其区别于其他金属的关键，并决定了其独特的物理和化学性质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-323f9e8ea85610f0279e242666644995" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="245" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-323f9e8ea85610f0279e242666644995-e-3" label="Physical metallurgy of nickel and its alloys">
        <attvalues>
          <attvalue for="0" value="Physical metallurgy of nickel and its alloys" />
          <attvalue for="1" value="Field of Study" />
          <attvalue for="2" value="物理冶金学的一个分支领域，专注于研究镍及其合金的成分、加工工艺、微观结构与物理及力学性能之间的内在联系和规律。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-323f9e8ea85610f0279e242666644995" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-323f9e8ea85610f0279e242666644995-e-5" label="Nickel alloys">
        <attvalues>
          <attvalue for="0" value="Nickel alloys" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="镍合金是以镍为基体，并添加其他元素形成的一类金属材料。它们通常具有卓越的高温强度、抗腐蚀和抗氧化性能，是航空航天、能源及化工等严苛环境中应用的关键高性能材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-323f9e8ea85610f0279e242666644995" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-323f9e8ea85610f0279e242666644995-e-7" label="Phases">
        <attvalues>
          <attvalue for="0" value="Phases" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="在高温合金中，相是由特定合金元素促进形成的微观结构特征。它是合金内部物理与化学性质均匀的组成部分，其种类、形态和分布直接决定了材料的宏观性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-323f9e8ea85610f0279e242666644995" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-437f3a81b91ea86a4ff09a52be9748e2-e-1" label="superalloy">
        <attvalues>
          <attvalue for="0" value="superalloy" />
          <attvalue for="1" value="Material Grade" />
          <attvalue for="2" value="高温合金（Superalloy）是一类专为高温环境设计的金属材料。其新牌号的设计常利用热力学数据库，以精确调控微观结构，其中起关键强化作用的有序γ'相（gamma prime phase）是其保持优异高温强度和抗蠕变性能的核心。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-437f3a81b91ea86a4ff09a52be9748e2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="78" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-437f3a81b91ea86a4ff09a52be9748e2-e-2" label="thermodynamic databases">
        <attvalues>
          <attvalue for="0" value="thermodynamic databases" />
          <attvalue for="1" value="Data Resource" />
          <attvalue for="2" value="一种包含定量热力学信息的数据资源，用于根据材料的化学成分与温度，计算并预测其冶金相的类型、数量与稳定性。它是设计高温合金等先进材料的关键计算工具。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-437f3a81b91ea86a4ff09a52be9748e2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="78" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-437f3a81b91ea86a4ff09a52be9748e2-e-3" label="metallurgical phases">
        <attvalues>
          <attvalue for="0" value="metallurgical phases" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="冶金相是材料中物理与化学性质均一的组成部分。其在平衡状态下的种类、成分和相对比例可以通过热力学数据库等方法进行预测。例如，有序γ'相就是一种典型的冶金相。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-437f3a81b91ea86a4ff09a52be9748e2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="78" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-437f3a81b91ea86a4ff09a52be9748e2-e-4" label="ordered γ' phase">
        <attvalues>
          <attvalue for="0" value="ordered γ' phase" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="有序γ'相（Gamma Prime Phase）是一种具有L1₂型有序晶体结构的金属间化合物，如Ni₃(Al, Ti)。作为镍基等高温合金中的主要强化相，它通过与基体共格析出，有效阻碍位错运动，从而赋予材料优异的高温强度、持久性能和抗蠕变性，是高温合金性能的关键所在。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-437f3a81b91ea86a4ff09a52be9748e2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;ordered y' phase&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-437f3a81b91ea86a4ff09a52be9748e2-e-4&quot;]}]" />
          <attvalue for="9" value="78" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b38b75a018fa569ff580b1d94d62395d-e-3" label="lattice defects">
        <attvalues>
          <attvalue for="0" value="lattice defects" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="晶格缺陷是指晶体材料中原子偏离其理想周期性排列而形成的微观区域。作为一种材料缺陷，它包括空位、位错和面缺陷等类型。晶格缺陷的种类和密度显著影响材料的力学性能，其控制对于获得所需的高温强度和抗蠕变性至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-b38b75a018fa569ff580b1d94d62395d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c14396eea836d3f1007eeea78f6bab8c-e-4" label="High-temperature creep strength">
        <attvalues>
          <attvalue for="0" value="High-temperature creep strength" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="高温蠕变强度是一种材料力学性能，指材料在高温和恒定应力作用下，抵抗缓慢发生永久性变形（即蠕变）的能力。它是衡量高温合金等材料在高温环境下长期服役时，保持尺寸稳定性和可靠性的关键性能指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c14396eea836d3f1007eeea78f6bab8c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c14396eea836d3f1007eeea78f6bab8c-e-4&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c14396eea836d3f1007eeea78f6bab8c-e-6" label="Section 2.4">
        <attvalues>
          <attvalue for="0" value="Section 2.4" />
          <attvalue for="1" value="Document Section" />
          <attvalue for="2" value="文档的一个章节，编号为2.4。该章节是对“镍及其合金的蠕变行为”这一特定主题进行的系统性论述。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c14396eea836d3f1007eeea78f6bab8c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-2" label="Ni–X alloys">
        <attvalues>
          <attvalue for="0" value="Ni–X alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="Ni-X合金是由金属镍（Ni）与一种过渡金属（X）构成的二元合金体系。这类合金是制备扩散偶的关键材料，常用于研究材料在固相状态下的原子扩散现象与界面反应。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-f86488a9b0d8a6ad97c3c2b189dd5035" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-4" label="Rhenium (Re)">
        <attvalues>
          <attvalue for="0" value="Rhenium (Re)" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="铼（Re）是一种化学元素，原子序数75。它是一种银白色、高密度、高熔点的稀有过渡金属。作为一种重要的“γ相分配元素”（y-partitioning element），它常被添加于镍基高温合金中以显著提升材料的高温强度和性能。" />
          <attvalue for="3" value="{&quot;location_in_d_block&quot;: &quot;near the centre&quot;, &quot;diffusion_rate&quot;: &quot;slow&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f86488a9b0d8a6ad97c3c2b189dd5035" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Re&quot;, &quot;Rhenium&quot;, &quot;rhenium&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-4&quot;, &quot;chunk-78865a21d21766b0dd173d92dcbbfc0d-e-3&quot;, &quot;chunk-114d612b5f5f30e54d96d2a909a6dd20-e-6&quot;, &quot;chunk-a4b011eeea4fbc315a0833a25a29121a-e-3&quot;, &quot;chunk-23893d297564190aa46fd314ec1e6f0e-e-7&quot;, &quot;chunk-a4fbcaedb1a3455b29f18439a3d53ae7-e-5&quot;, &quot;chunk-04f7985cbfd683d851bd2e54d7fa0470-e-7&quot;, &quot;chunk-f14b0074e13363327f2213611a99c96e-e-7&quot;, &quot;chunk-1ad3d9def6416eb2826a0448d6287c6f-e-3&quot;, &quot;chunk-a921a108c7811dc9a541483523b2c983-e-12&quot;, &quot;chunk-6f03154ca36cf3915a23738d2e17bbfa-e-4&quot;, &quot;chunk-cad1eaa9ffb0e731892120bbe3415da7-e-15&quot;, &quot;chunk-6ba4a169178093a9ea2ecfdeeb70cb76-e-5&quot;, &quot;chunk-22dadd8677004929f45649f589c98023-e-1&quot;, &quot;chunk-2fd5876b35a11cace4a36b2cc1865696-e-6&quot;, &quot;chunk-7ac0ca58bfe13a4f34daf0b8dc6214df-e-7&quot;, &quot;chunk-c2bce381433d364861cf87ccbd650b94-e-2&quot;, &quot;chunk-98dc45a2c81a5783151664ba74c4681e-e-2&quot;, &quot;chunk-e1a389bc8645b3e7fa58f05c1e0a798f-e-7&quot;, &quot;chunk-3d0590efade07af78fea353ef909c7ec-e-6&quot;, &quot;chunk-10af7aee4fb23531546db15200cbea75-e-6&quot;, &quot;chunk-bd63f78238a96a3498c5ca89d8572bea-e-1&quot;, &quot;chunk-480d57aecb221d6739d918eba055fa57-e-3&quot;, &quot;chunk-9f8adabfb1010fa4a4528e361c3f5223-e-5&quot;, &quot;chunk-8cc148c1ca974c554ee456036519b0b3-e-17&quot;, &quot;chunk-3840a842bb1a54d4d273056bed0dac49-e-6&quot;, &quot;chunk-934fe384c1e1c8aa8f00e3faee00cc14-e-1&quot;, &quot;chunk-1d0418c28a59c280072dbd96eeaaa524-e-2&quot;, &quot;chunk-4bc43156e1a0a7c73048cc8f158c8919-e-5&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="35" />
        </attvalues>
      </node>
      <node id="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-6" label="Hafnium (Hf)">
        <attvalues>
          <attvalue for="0" value="Hafnium (Hf)" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="铪（Hafnium）是一种化学元素，符号为Hf，原子序数72。它是一种有光泽的银灰色过渡金属，物理及化学性质与锆相似。因其优异的中子吸收能力，常被用作核反应堆的控制棒。同时，它也是一种重要的合金添加剂，用于制造航空航天领域的超合金和耐高温材料。" />
          <attvalue for="3" value="{&quot;location_in_d_block&quot;: &quot;far west&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-f86488a9b0d8a6ad97c3c2b189dd5035" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Hafnium&quot;, &quot;Hf&quot;, &quot;hafnium&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-6&quot;, &quot;chunk-5af1439dfd2daa394494b8c8df9e4287-e-1&quot;, &quot;chunk-54728fc56c44ccf66b9375798fee1dd9-e-5&quot;, &quot;chunk-df56dbe04dca860f9b208ab9b4878418-e-13&quot;, &quot;chunk-7f5d267485eb6b44a173a04ba9a301e4-e-7&quot;, &quot;chunk-a921a108c7811dc9a541483523b2c983-e-7&quot;, &quot;chunk-1abe15e2f2db1602f97ac75bb847ef30-e-15&quot;, &quot;chunk-6d7a887b0ad8aa25cf8cb0d2e4a60af2-e-3&quot;, &quot;chunk-cd90df188efe63a1aba2d62ab225c3ae-e-6&quot;, &quot;chunk-d55298f42964ce23c30b0bcafa72ab6c-e-6&quot;, &quot;chunk-7638042a561888cfdce1fb2ee9ad0428-e-6&quot;, &quot;chunk-dceb4b755a836df5a6b40aba440100ba-e-6&quot;, &quot;chunk-bc88baa62dfcfaa0545bb367cad979a7-e-3&quot;, &quot;chunk-2a84c8f3deba57fec16eeb3e18ab4ff5-e-4&quot;, &quot;chunk-def444476734c5b41ca30b16989718fd-e-6&quot;, &quot;chunk-1b1d17125a9be9ae98260d7ef4e48178-e-6&quot;, &quot;chunk-4bc43156e1a0a7c73048cc8f158c8919-e-6&quot;, &quot;chunk-84d1269d81f3d4fb66cfdbb567801e32-e-5&quot;, &quot;chunk-870742dec10263e0078e94a0b6a827aa-e-15&quot;, &quot;chunk-569a3d8aec20d9df6a256b4cf4b263a7-e-3&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="13" />
        </attvalues>
      </node>
      <node id="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-8" label="Diffusion couples">
        <attvalues>
          <attvalue for="0" value="Diffusion couples" />
          <attvalue for="1" value="Experimental Setup" />
          <attvalue for="2" value="扩散偶（Diffusion couples）是一种材料学实验样品，由两种不同成分的材料（如镍与镍基合金）在原子层面紧密接触构成。它主要用于在高温下研究固相原子扩散行为，通过分析界面区域的成分分布来确定扩散系数及界面相的演化规律。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-f86488a9b0d8a6ad97c3c2b189dd5035" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-5af1439dfd2daa394494b8c8df9e4287-e-2" label="Au">
        <attvalues>
          <attvalue for="0" value="Au" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="黄金（Gold）是一种化学元素，化学符号为Au，原子序数为79。它是一种质地柔软、色泽金黄、抗腐蚀的贵金属，也是一种过渡金属。因其稀有、保值及优良的物理化学性质，被广泛用于珠宝、货币、电子工业等领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-5af1439dfd2daa394494b8c8df9e4287" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Gold (Au)&quot;, &quot;gold&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3ff783a5b26a130b0577173680195866-e-6&quot;, &quot;chunk-cad1eaa9ffb0e731892120bbe3415da7-e-11&quot;, &quot;chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-7&quot;, &quot;chunk-5af1439dfd2daa394494b8c8df9e4287-e-2&quot;, &quot;chunk-54728fc56c44ccf66b9375798fee1dd9-e-6&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-5af1439dfd2daa394494b8c8df9e4287-e-4" label="Diffusion">
        <attvalues>
          <attvalue for="0" value="Diffusion" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="一种物理过程。其速率曾被错误地认为与晶格错配直接相关，但量子力学模型已证伪此关联，并解释了该过程的真实机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-5af1439dfd2daa394494b8c8df9e4287" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5af1439dfd2daa394494b8c8df9e4287-e-6" label="Solute atom radii">
        <attvalues>
          <attvalue for="0" value="Solute atom radii" />
          <attvalue for="1" value="Atomic Property" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;溶质原子半径（Solute atom radii）是指在固溶体中，溶质元素的原子半径。作为一种原子属性，它与溶剂原子半径的差异，是决定晶格错配大小和引起晶格应变的关键物理量，从而影响材料的宏观性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-5af1439dfd2daa394494b8c8df9e4287" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5af1439dfd2daa394494b8c8df9e4287-e-6&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5af1439dfd2daa394494b8c8df9e4287-e-7" label="Solvent atom radii">
        <attvalues>
          <attvalue for="0" value="Solvent atom radii" />
          <attvalue for="1" value="Atomic Property" />
          <attvalue for="2" value="一种原子属性，指在固溶体或合金中作为基体（溶剂）的原子半径。它是一个关键参数，通过与溶质原子半径进行比较，共同决定了因原子尺寸差异而引起的晶格错配程度，进而影响材料的性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-5af1439dfd2daa394494b8c8df9e4287" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5af1439dfd2daa394494b8c8df9e4287-e-7&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5af1439dfd2daa394494b8c8df9e4287-e-8" label="Quantum-mechanical modelling">
        <attvalues>
          <attvalue for="0" value="Quantum-mechanical modelling" />
          <attvalue for="1" value="Computational Method" />
          <attvalue for="2" value="量子力学建模是一种基于量子力学原理的计算方法。它通过在原子或分子尺度上进行模拟，来研究和预测物质的性质与行为，从而为扩散等物理现象的实验观测提供合理解释。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-5af1439dfd2daa394494b8c8df9e4287" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5af1439dfd2daa394494b8c8df9e4287-e-8&quot;, &quot;chunk-7e95d744723775d720f898b62dc67090-e-1&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-5af1439dfd2daa394494b8c8df9e4287-e-9" label="Nickel">
        <attvalues>
          <attvalue for="0" value="Nickel" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍（Nickel）是一种化学元素，符号为Ni，原子序数28。它是一种坚硬、有延展性的银白色过渡金属，具有优异的耐腐蚀性。其物理冶金学是重要的研究领域，主要关注其作为纯金属以及在不锈钢、高温合金等多种关键合金材料中的性能与应用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-5af1439dfd2daa394494b8c8df9e4287" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Al atom&quot;, &quot;Ni&quot;, &quot;Nickel (Ni)&quot;, &quot;nickel&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-1&quot;, &quot;chunk-5af1439dfd2daa394494b8c8df9e4287-e-9&quot;, &quot;chunk-114d612b5f5f30e54d96d2a909a6dd20-e-11&quot;, &quot;chunk-77690a63edc0814cc6c868e5e4d95012-e-4&quot;, &quot;chunk-b2761392d08e0abe002c7c4fcb313ba7-e-4&quot;, &quot;chunk-44ba0b547d89e889a875ab5cd81995c8-e-6&quot;, &quot;chunk-c2b78e8b376569da6104df59fa66c5ca-e-4&quot;, &quot;chunk-234c3eebb3d42a0daf6e298133c20255-e-9&quot;, &quot;chunk-a28f8cc76e765a7c0aa9878e6ea3e623-e-1&quot;, &quot;chunk-8001720db94f44ac88b442f606ab7d39-e-7&quot;, &quot;chunk-5d285668cb116d3577030c45282de28e-e-3&quot;, &quot;chunk-22ef75b1c4655668db62d8db90f9c1bb-e-5&quot;, &quot;chunk-04d8e878969e6a9500600ef092423800-e-3&quot;, &quot;chunk-f6159d3dd840711c5298adf7f057d3b6-e-1&quot;, &quot;chunk-9a58de583a6c9c66ff501b98683b07d7-e-7&quot;, &quot;chunk-a4d65971a0e96c0f576b576adadc50ce-e-3&quot;, &quot;chunk-921a9348cd77597c4374323349308669-e-1&quot;, &quot;chunk-3ca8a51d3be3a429f4f741571769150f-e-2&quot;, &quot;chunk-323f9e8ea85610f0279e242666644995-e-4&quot;, &quot;chunk-8904cb48a935223e48567818a6621b2f-e-3&quot;, &quot;chunk-1410988dfcbd0392c9d01a4bc32fcff9-e-1&quot;, &quot;chunk-67e83ce412e1a2b3ed6d85749ac58af6-e-3&quot;, &quot;chunk-1f5d781c40896f23b19d1622a0e99572-e-2&quot;, &quot;chunk-466225ab73e7ea49ac0af36e5725c4c1-e-8&quot;, &quot;chunk-bf906ca2cbc8d790d36fdc40a9295b24-e-5&quot;, &quot;chunk-833b212eb3a569521f9a95be24874ec1-e-7&quot;, &quot;chunk-5b143324ae92718a4dde1cd69bd72bd2-e-1&quot;, &quot;chunk-d246d51e161275b250bc309214ccd241-e-10&quot;, &quot;chunk-b6d430b58fe5b3336f2235e2e6daa465-e-12&quot;, &quot;chunk-ec1da0ebfe72b58a50620a5a71c6abf7-e-9&quot;, &quot;chunk-c8fee299c7ba0eef0fb9057ffd13203c-e-6&quot;, &quot;chunk-b7b41d99b7968db6938fc41d4745dc0d-e-11&quot;, &quot;chunk-0625d83d7200f989528119d9ba61865a-e-14&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="33" />
        </attvalues>
      </node>
      <node id="chunk-5af1439dfd2daa394494b8c8df9e4287-e-10" label="Nickel alloys">
        <attvalues>
          <attvalue for="0" value="Nickel alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍合金是一种以金属镍为基体，通过添加一种或多种其他元素（如铬、铁、钼等）形成的金属材料。这类合金通常为获得优异的耐腐蚀性、耐高温性、高强度等特定性能而设计，广泛应用于航空航天、化工等严苛环境。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-5af1439dfd2daa394494b8c8df9e4287" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7e95d744723775d720f898b62dc67090-e-2" label="First principles methods">
        <attvalues>
          <attvalue for="0" value="First principles methods" />
          <attvalue for="1" value="Computational Technique" />
          <attvalue for="2" value="第一原理方法，也称从头算法（ab initio methods），是一类基于量子力学基本原理的计算方法。它不依赖任何经验或实验参数，通过直接求解描述微观系统行为的基本物理方程，来计算和预测材料、分子的电子结构及各项物理化学性质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-7e95d744723775d720f898b62dc67090" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7e95d744723775d720f898b62dc67090-e-3" label="Activation energies for solute-vacancy exchange">
        <attvalues>
          <attvalue for="0" value="Activation energies for solute-vacancy exchange" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="溶质-空位交换活化能（E♭）是描述材料中溶质原子与晶格空位交换位置时所需克服的最小能量。该物理性质是扩散动力学中的关键参数，通常通过量子力学建模等理论计算方法获得。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;E♭&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-7e95d744723775d720f898b62dc67090" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7e95d744723775d720f898b62dc67090-e-4" label="Vacancy formation energy for a solute-vacancy complex">
        <attvalues>
          <attvalue for="0" value="Vacancy formation energy for a solute-vacancy complex" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="溶质-空位复合体的空位形成能是一种物理性质，指形成一个溶质原子与空位结合的缺陷复合体所需的能量。该值通常通过量子力学模型计算（记作E(f)X-Va），且在d区元素中的变化不显著。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;E(f)X-Va&quot;, &quot;variation&quot;: &quot;no more than 40 kJ/mol&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-7e95d744723775d720f898b62dc67090" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7e95d744723775d720f898b62dc67090-e-4&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-54728fc56c44ccf66b9375798fee1dd9-e-1" label="E(f)Hf-Va">
        <attvalues>
          <attvalue for="0" value="E(f)Hf-Va" />
          <attvalue for="1" value="Energy Term" />
          <attvalue for="2" value="在镍(Ni)基体中，于一个铪(Hf)溶质原子近邻位置处形成一个空位时所需的能量。该能量值与在纯镍中形成空位的能量相近，用于衡量铪原子对周围空位稳定性的影响。" />
          <attvalue for="3" value="{&quot;magnitude&quot;: &quot;close to 120 kJ/mol&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-54728fc56c44ccf66b9375798fee1dd9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="130" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-54728fc56c44ccf66b9375798fee1dd9-e-2" label="E(f)Au-Va">
        <attvalues>
          <attvalue for="0" value="E(f)Au-Va" />
          <attvalue for="1" value="Energy Term" />
          <attvalue for="2" value="一个能量项，指在镍(Ni)基体中，与金(Au)溶质原子相关联的空位形成能。它具体表示在金原子邻近位置创建一个空位所需要的能量，其数值可反映金溶质对基体材料中空位稳定性的影响。" />
          <attvalue for="3" value="{&quot;magnitude&quot;: &quot;close to 120 kJ/mol&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-54728fc56c44ccf66b9375798fee1dd9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="130" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-54728fc56c44ccf66b9375798fee1dd9-e-3" label="Vacancy formation energy in pure Ni">
        <attvalues>
          <attvalue for="0" value="Vacancy formation energy in pure Ni" />
          <attvalue for="1" value="Energy Term" />
          <attvalue for="2" value="纯镍（Ni）空位形成能，是在理想的纯镍晶体中，将一个原子从晶格内部移至晶体表面，从而形成一个点缺陷（空位）时，系统能量的净变化值。该物理量是衡量纯镍材料中空位形成难易程度的关键热力学参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-54728fc56c44ccf66b9375798fee1dd9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="130" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-54728fc56c44ccf66b9375798fee1dd9-e-4" label="Solute-vacancy binding energy">
        <attvalues>
          <attvalue for="0" value="Solute-vacancy binding energy" />
          <attvalue for="1" value="Energy Term" />
          <attvalue for="2" value="溶质-空位结合能 (Solute-vacancy binding energy) 是指在晶体材料中，一个孤立的溶质原子与一个孤立的空位移动到相邻位置形成稳定复合体时，系统能量的降低值。该能量量化了溶质原子与空位之间的相互作用强度，是影响原子扩散、偏析和相变等行为的关键物理参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-54728fc56c44ccf66b9375798fee1dd9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-54728fc56c44ccf66b9375798fee1dd9-e-4&quot;, &quot;chunk-a4b011eeea4fbc315a0833a25a29121a-e-11&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-54728fc56c44ccf66b9375798fee1dd9-e-7" label="Re-Va binding energy">
        <attvalues>
          <attvalue for="0" value="Re-Va binding energy" />
          <attvalue for="1" value="Energy Term" />
          <attvalue for="2" value="铼-空位结合能（Re-Va binding energy）是衡量晶体材料中一个铼（Re）溶质原子与一个晶格空位（Va）之间相互作用强度的物理量。它定义为两者从分离状态结合成稳定复合物时系统能量的降低值。正值表示相互吸引，是预测材料中溶质偏析、辐照损伤等微观结构演化的关键参数。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;about +40 kJ/mol&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-54728fc56c44ccf66b9375798fee1dd9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-54728fc56c44ccf66b9375798fee1dd9-e-7&quot;, &quot;chunk-114d612b5f5f30e54d96d2a909a6dd20-e-1&quot;]}]" />
          <attvalue for="9" value="433" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-54728fc56c44ccf66b9375798fee1dd9-e-8" label="E(f)X-Va">
        <attvalues>
          <attvalue for="0" value="E(f)X-Va" />
          <attvalue for="1" value="Energy Term" />
          <attvalue for="2" value="E(f)X-Va是一个能量项，定义为在晶体中形成一个与特定溶质原子X相关联的晶格空位所需的能量。它是一个通用表达式，其具体数值因溶质X的种类（由其原子序数决定）而异。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-54728fc56c44ccf66b9375798fee1dd9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-54728fc56c44ccf66b9375798fee1dd9-e-8&quot;, &quot;chunk-114d612b5f5f30e54d96d2a909a6dd20-e-2&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-114d612b5f5f30e54d96d2a909a6dd20-e-4" label="Interdiffusion coefficient">
        <attvalues>
          <attvalue for="0" value="Interdiffusion coefficient" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="互扩散系数是表征多组分体系中，不同种类原子相互扩散快慢程度的物理量。作为一种材料性质，其数值大小与材料组分、温度等因素有关，并主要受原子扩散时所需克服的扩散能垒的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-114d612b5f5f30e54d96d2a909a6dd20" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-114d612b5f5f30e54d96d2a909a6dd20-e-4&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-114d612b5f5f30e54d96d2a909a6dd20-e-5" label="Diffusion energy barrier, E♭">
        <attvalues>
          <attvalue for="0" value="Diffusion energy barrier, E♭" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="扩散能垒（E♭）是一种物理性质，指原子在晶格中迁移时需要克服的能量障碍。它作为影响互扩散系数变化的主要因素，对于铼（Re）、钌（Ru）等特定元素的扩散行为尤为重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-114d612b5f5f30e54d96d2a909a6dd20" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-114d612b5f5f30e54d96d2a909a6dd20-e-9" label="Electronic bonding">
        <attvalues>
          <attvalue for="0" value="Electronic bonding" />
          <attvalue for="1" value="Chemical Property" />
          <attvalue for="2" value="电子成键是一种物理概念，指原子或离子间通过价电子的相互作用而形成的结合力。这种成键的类型、强度和方向性，是决定分子、晶体等物质结构及其宏观物理化学特性（如Ni-Re和Ni-Ru键的特性）的根本原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-114d612b5f5f30e54d96d2a909a6dd20" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-114d612b5f5f30e54d96d2a909a6dd20-e-9&quot;, &quot;chunk-a4b011eeea4fbc315a0833a25a29121a-e-7&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-114d612b5f5f30e54d96d2a909a6dd20-e-10" label="Unpaired electrons">
        <attvalues>
          <attvalue for="0" value="Unpaired electrons" />
          <attvalue for="1" value="Chemical Property" />
          <attvalue for="2" value="未成对电子是指在原子或分子轨道中单独占据一个轨道的电子。其数量决定了物质的磁性等化学性质。在铼(Re)、钌(Ru)等过渡金属中，大量的未成对电子能形成极强的金属键，使原子紧密堆积，是这些元素具有高密度的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-114d612b5f5f30e54d96d2a909a6dd20" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-114d612b5f5f30e54d96d2a909a6dd20-e-10&quot;, &quot;chunk-a4b011eeea4fbc315a0833a25a29121a-e-8&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a4b011eeea4fbc315a0833a25a29121a-e-1" label="Ni-Re bonds">
        <attvalues>
          <attvalue for="0" value="Ni-Re bonds" />
          <attvalue for="1" value="Chemical Bond" />
          <attvalue for="2" value="Ni-Re键是一种由电子相互作用形成的强化学键，具有显著的方向性和不可压缩性。该键强烈抑制溶质-空位交换，其对材料性能的影响超过了原子半径和错配应变等物理因素。" />
          <attvalue for="3" value="{&quot;characteristic&quot;: &quot;directional and incompressible&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-a4b011eeea4fbc315a0833a25a29121a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a4b011eeea4fbc315a0833a25a29121a-e-1&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-a4b011eeea4fbc315a0833a25a29121a-e-2" label="Ni-Ru bonds">
        <attvalues>
          <attvalue for="0" value="Ni-Ru bonds" />
          <attvalue for="1" value="Chemical Bond" />
          <attvalue for="2" value="Ni-Ru键是一种在镍(Ni)和钌(Ru)原子间形成的化学键。它源于未成对电子间的强电子成键作用，具有显著的方向性和不可压缩性。这些特性使该化学键倾向于抑制材料中的溶质-空位交换，从而增强结构稳定性。" />
          <attvalue for="3" value="{&quot;characteristic&quot;: &quot;directional and incompressible&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a4b011eeea4fbc315a0833a25a29121a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a4b011eeea4fbc315a0833a25a29121a-e-2&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a4b011eeea4fbc315a0833a25a29121a-e-5" label="Solute-vacancy exchanges">
        <attvalues>
          <attvalue for="0" value="Solute-vacancy exchanges" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="一种晶体材料中的物理过程，指溶质原子与相邻的晶格空位互换位置，是原子扩散的基本机制。在特定合金中，如存在Ni-Re或Ni-Ru键时，强大的原子键合会阻碍此交换过程，从而降低溶质元素的扩散速率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a4b011eeea4fbc315a0833a25a29121a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a4b011eeea4fbc315a0833a25a29121a-e-6" label="High-temperature properties">
        <attvalues>
          <attvalue for="0" value="High-temperature properties" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="高温性能是一种材料属性，特指材料在高温环境下所表现出的力学性能、物理性能和化学稳定性。对于高温合金而言，其抗蠕变和抗氧化等关键高温性能，通常通过添加铼(Re)等合金元素得到显著提升。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a4b011eeea4fbc315a0833a25a29121a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a4b011eeea4fbc315a0833a25a29121a-e-6&quot;, &quot;chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-8&quot;, &quot;chunk-dc4fc8b9731ff54ceedadcde2ec92655-e-6&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a4b011eeea4fbc315a0833a25a29121a-e-9" label="Atomic radius">
        <attvalues>
          <attvalue for="0" value="Atomic radius" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="原子半径是衡量原子大小的一种物理性质。在实践中，它常被定义为两个相邻原子核间距离的一半，其具体数值取决于测量方式和化学环境（如共价半径、金属半径）。它是决定元素化学性质和物理特性的一个基本参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-a4b011eeea4fbc315a0833a25a29121a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a4b011eeea4fbc315a0833a25a29121a-e-10" label="misfit strain">
        <attvalues>
          <attvalue for="0" value="misfit strain" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="**失配应变 (misfit strain, єT)**&#10;&#10;一个物理量，用于量化因材料间热膨胀系数差异(Δα)在经历温度变化(ΔΤ)时产生的内部应变。它反映了热失配的程度，其大小由热膨胀系数差与冷却温差的乘积(Δα·ΔΤ)定义，是计算界面能等物理量的基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-a4b011eeea4fbc315a0833a25a29121a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Misfit strain&quot;, &quot;Misfit strains&quot;, &quot;misfit strain (єT)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a4b011eeea4fbc315a0833a25a29121a-e-10&quot;, &quot;chunk-5395b7a3b731615ee1a2521907378b84-e-1&quot;, &quot;chunk-40762f1b619063834a1784b067d301ee-e-7&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-66ba88a6026c55d38eeb24aad6777073-e-3" label="Defects">
        <attvalues>
          <attvalue for="0" value="Defects" />
          <attvalue for="1" value="Material Imperfection" />
          <attvalue for="2" value="缺陷 (Defects) 是指在伽马撇 (γ') 相中存在的晶体结构不完美性。这些偏离理想原子排列的区域，如空位、位错或反位缺陷，会显著影响材料的宏观性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-66ba88a6026c55d38eeb24aad6777073" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-66ba88a6026c55d38eeb24aad6777073-e-6" label="nickel alloys">
        <attvalues>
          <attvalue for="0" value="nickel alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍基合金（Nickel alloys）是以镍为主要基体元素的合金，通常具有优异的高温强度、耐腐蚀和抗氧化性能。在许多沉淀强化型镍基高温合金中，有序强化相的存在会形成反相畴界，这是其获得高强度的关键微观结构特征和强化机制之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-66ba88a6026c55d38eeb24aad6777073" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-66ba88a6026c55d38eeb24aad6777073-e-7" label="perfect crystals of γ'">
        <attvalues>
          <attvalue for="0" value="perfect crystals of γ'" />
          <attvalue for="1" value="Material State" />
          <attvalue for="2" value="一种具有完美原子有序排列的γ'相晶体的理想化理论模型。它作为参考基准，用于描述当其晶格发生a/2⟨101⟩等矢量位移时，如何形成反相畴界（APB）这一晶体缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-66ba88a6026c55d38eeb24aad6777073" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-66ba88a6026c55d38eeb24aad6777073-e-8" label="a/2⟨101⟩">
        <attvalues>
          <attvalue for="0" value="a/2⟨101⟩" />
          <attvalue for="1" value="Crystallographic Vector" />
          <attvalue for="2" value="a/2⟨101⟩ 是一个晶体学矢量，用于在γ'相有序合金中定义反相畴界(APB)。它代表连接最近邻Ni和Al原子的位移，当完美晶体的一部分沿该矢量发生滑移时，就会形成APB这种平面缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-66ba88a6026c55d38eeb24aad6777073" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-66ba88a6026c55d38eeb24aad6777073-e-8&quot;, &quot;chunk-08620c5a2f94ef5584dba0230f92c28f-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-66ba88a6026c55d38eeb24aad6777073-e-9" label="Ni atoms">
        <attvalues>
          <attvalue for="0" value="Ni atoms" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="镍原子是在晶体结构中，其相对空间位置由a/2⟨101⟩矢量所连接的原子集合。该矢量是面心立方晶体（如镍）中的一个重要晶向，定义了原子间特定的排列方式和距离，通常与晶体缺陷和滑移系统有关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-66ba88a6026c55d38eeb24aad6777073" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-66ba88a6026c55d38eeb24aad6777073-e-9&quot;, &quot;chunk-9b30e2ac693416c047e70b5d2cbba7ff-e-8&quot;, &quot;chunk-9718b105c96174ffb3694bd3c4362a1e-e-1&quot;, &quot;chunk-13624c30d54236964523cb607119931d-e-4&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-66ba88a6026c55d38eeb24aad6777073-e-10" label="Al atoms">
        <attvalues>
          <attvalue for="0" value="Al atoms" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="铝（Al）元素的原子。该上下文特指在铝所属的面心立方（FCC）晶体结构中，由a/2⟨101⟩晶向向量连接的原子。该向量定义了晶格中最近邻原子间的位移关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-66ba88a6026c55d38eeb24aad6777073" />
