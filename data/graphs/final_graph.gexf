      <node id="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-e-4" label="L">
        <attvalues>
          <attvalue for="0" value="L" />
          <attvalue for="1" value="Mathematical Variable" />
          <attvalue for="2" value="数学变量L，是在公式(2.28a)、(2.28b)和(2.28c)中，为定义另一个变量λ₁而引入的构成参数。其确切的数学含义和计算方法由这些特定公式的上下文所规定。" />
          <attvalue for="3" value="{}" />
