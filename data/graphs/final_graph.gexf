      </node>
      <node id="chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-14" label="D">
        <attvalues>
          <attvalue for="0" value="D" />
          <attvalue for="1" value="Symbol" />
          <attvalue for="2" value="符号“D”是一个常数，通常在数学或科学表达式中使用，代表一个在特定上下文中保持固定不变的数值或物理量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-f2dcbd0ede6add46d4e0540d9a794efa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="101" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-15" label="constant">
        <attvalues>
          <attvalue for="0" value="constant" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="常数，或称常量，指在特定问题或计算过程中数值保持不变的量。它可以是具体的数学常数（如π），也可以是用符号（如C、D）表示的某个固定值，与变量相对。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-f2dcbd0ede6add46d4e0540d9a794efa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="101" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-16" label="P">
        <attvalues>
          <attvalue for="0" value="P" />
          <attvalue for="1" value="Symbol" />
          <attvalue for="2" value="P是拉森-米勒参数（Larson-Miller parameter）的符号，这是一个在材料科学中广泛应用的参数，用于通过结合温度和时间来预测材料在特定应力下的蠕变断裂寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-f2dcbd0ede6add46d4e0540d9a794efa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-16&quot;]}]" />
          <attvalue for="9" value="52" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-17" label="Larson–Miller parameter">
        <attvalues>
          <attvalue for="0" value="Larson–Miller parameter" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="拉森-米勒参数（Larson-Miller Parameter）是材料科学中一个用于预测材料高温蠕变断裂寿命的参量。它通过一个公式建立了温度和时间之间的等效关系，从而能够利用短时高温的试验数据，外推预测材料在较低温度下长期服役的性能。它是进行高温合金等材料寿命评估的重要工程工具。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-17" />
          <attvalue for="5" value="chunk-f2dcbd0ede6add46d4e0540d9a794efa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Larson-Miller parameter&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-17&quot;, &quot;chunk-7cf221202ae924d5b8c87acce1ae3bfd-e-1&quot;, &quot;chunk-c54fb0cde287461ac785a255da940d8d-e-2&quot;, &quot;chunk-c8a13933656ed9f144b18b40f2e9861e-e-7&quot;]}]" />
          <attvalue for="9" value="52" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-18" label="E">
        <attvalues>
          <attvalue for="0" value="E" />
          <attvalue for="1" value="Symbol" />
          <attvalue for="2" value="符号E，代表拉森-米勒常数（Larson-Miller constant）。这是一个材料学常数，在拉森-米勒关系式中，用于关联温度、时间和应力，以评估和预测材料在高温下的蠕变断裂寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-18" />
          <attvalue for="5" value="chunk-f2dcbd0ede6add46d4e0540d9a794efa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="158" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-19" label="Larson–Miller constant">
        <attvalues>
          <attvalue for="0" value="Larson–Miller constant" />
          <attvalue for="1" value="Constant" />
          <attvalue for="2" value="拉森-米勒常数（Larson–Miller constant），符号通常为C，是拉森-米勒参数公式中的一个经验性材料常数，用于预测材料在高温下的蠕变断裂寿命。该常数值因材料而异，通常在15至25之间，在工程计算中常取20作为近似值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-19" />
          <attvalue for="5" value="chunk-f2dcbd0ede6add46d4e0540d9a794efa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-19&quot;, &quot;chunk-7cf221202ae924d5b8c87acce1ae3bfd-e-2&quot;]}]" />
          <attvalue for="9" value="158" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-20" label="Equation (1.11)">
        <attvalues>
          <attvalue for="0" value="Equation (1.11)" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="定义拉森-米勒参数（P）的数学表达式，写作 T[E + log₁₀ tr] = P。该公式建立了材料的温度（T）、断裂时间（tr）与材料常数（E）之间的关系，用以预测其高温蠕变寿命。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;T[E + log₁₀ tr] = P&quot;}" />
          <attvalue for="4" value="e-20" />
          <attvalue for="5" value="chunk-f2dcbd0ede6add46d4e0540d9a794efa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-20&quot;]}]" />
          <attvalue for="9" value="52" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7cf221202ae924d5b8c87acce1ae3bfd-e-3" label="Creep tests">
        <attvalues>
          <attvalue for="0" value="Creep tests" />
          <attvalue for="1" value="Test Method" />
          <attvalue for="2" value="蠕变试验是一种材料力学性能试验方法，指在恒定的应力(σ)和温度(T)下，测量材料形变随时间变化的过程。其数据用于评估材料的蠕变抗力及长期服役寿命，例如通过多组试验建立拉森-米勒参数与应力对数（logσ）的相关性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-7cf221202ae924d5b8c87acce1ae3bfd" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7cf221202ae924d5b8c87acce1ae3bfd-e-3&quot;]}]" />
          <attvalue for="9" value="52" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7cf221202ae924d5b8c87acce1ae3bfd-e-4" label="logσ">
        <attvalues>
          <attvalue for="0" value="logσ" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="`logσ`是应力(σ)的对数。在材料科学中，它是一个与拉森-米勒参数（LMP）具有强相关性的关键参数，常用于绘制材料性能曲线，并预测材料在高温下的蠕变断裂寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-7cf221202ae924d5b8c87acce1ae3bfd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="52" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7cf221202ae924d5b8c87acce1ae3bfd-e-5" label="Larson-Miller diagrams">
        <attvalues>
          <attvalue for="0" value="Larson-Miller diagrams" />
          <attvalue for="1" value="Diagram" />
          <attvalue for="2" value="拉森-米勒图是一种工程图表，用于预测材料在高温下的蠕变断裂寿命。它通过绘制应力水平（通常为其对数）与拉森-米勒参数之间的关系来建立模型，该参数是一个综合了温度和时间的函数，能有效表征材料的蠕变行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-7cf221202ae924d5b8c87acce1ae3bfd" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7cf221202ae924d5b8c87acce1ae3bfd-e-5&quot;]}]" />
          <attvalue for="9" value="52" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
