      </node>
      <node id="chunk-c5385f7f28e0875405c91c30084a5d9b-e-12" label="Warrendale, PA">
        <attvalues>
          <attvalue for="0" value="Warrendale, PA" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="沃伦代尔 (Warrendale) 是美国宾夕法尼亚州的一个地区。在学术出版领域，它特指国际“高温合金”(Superalloys) 系列会议论文集的官方出版地，是《Superalloys 2000》和《Superalloys 2004》等重要科技文献的出版来源。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-c5385f7f28e0875405c91c30084a5d9b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c5385f7f28e0875405c91c30084a5d9b-e-12&quot;, &quot;chunk-c6e7b6a8ae77f73405b4c1cca62aa7e4-e-10&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-68a06b7c34233385dd7e1ad8a70b5d54-e-4" label="The use of two reactive elements to optimise oxidation performance of alumina-forming alloys">
        <attvalues>
          <attvalue for="0" value="The use of two reactive elements to optimise oxidation performance of alumina-forming alloys" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由B. A. Pint、K. L. More及I. G. Wright合著的科学论文，发表于《高温材料》(Materials at High Temperatures)期刊。该论文主要研究如何通过使用两种活性元素，来优化可形成氧化铝保护层的合金的抗氧化性能。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2003&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-68a06b7c34233385dd7e1ad8a70b5d54" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-68a06b7c34233385dd7e1ad8a70b5d54-e-4&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-68a06b7c34233385dd7e1ad8a70b5d54-e-5" label="alumina-forming alloys">
        <attvalues>
          <attvalue for="0" value="alumina-forming alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一类能在高温氧化环境中，于自身表面形成一层致密、稳定且具有保护性的α-Al₂O₃（α-氧化铝）氧化膜的材料。该氧化膜能有效阻止材料基体被进一步氧化，从而赋予材料优异的高温抗氧化性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-68a06b7c34233385dd7e1ad8a70b5d54" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;a-Al2O3 formers&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-68a06b7c34233385dd7e1ad8a70b5d54-e-5&quot;, &quot;chunk-bc88baa62dfcfaa0545bb367cad979a7-e-4&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-68a06b7c34233385dd7e1ad8a70b5d54-e-6" label="Materials at High Temperatures">
        <attvalues>
          <attvalue for="0" value="Materials at High Temperatures" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《Materials at High Temperatures》是一本学术期刊，专注于发表有关材料在高温环境下的性能、行为及应用的原创研究。该期刊涵盖金属合金、陶瓷、复合材料等，重点关注其在高温下的氧化、腐蚀、蠕变等降解机制以及相关的防护技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-68a06b7c34233385dd7e1ad8a70b5d54" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-68a06b7c34233385dd7e1ad8a70b5d54-e-6&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-68a06b7c34233385dd7e1ad8a70b5d54-e-7" label="S. Hayashi">
        <attvalues>
          <attvalue for="0" value="S. Hayashi" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="S. Hayashi是一位研究人员，作为作者之一发表了题为《Interdiffusion behaviour of Pt-modified y-Ni and y-Ni3Al alloys coupled to Ni-Al-based alloys》的学术出版物，该研究关注铂改性镍基合金的互扩散行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-68a06b7c34233385dd7e1ad8a70b5d54" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-68a06b7c34233385dd7e1ad8a70b5d54-e-8" label="W. Wang">
        <attvalues>
          <attvalue for="0" value="W. Wang" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="W. Wang是一位材料科学领域的研究人员。他是学术出版物《Pt改性的y-Ni和y'-Ni3Al合金与Ni-Al基合金耦合的互扩散行为》的作者之一，其研究工作聚焦于铂（Pt）改性的镍基高温合金的性能与相互作用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-68a06b7c34233385dd7e1ad8a70b5d54" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-68a06b7c34233385dd7e1ad8a70b5d54-e-9" label="D. J. Sordelet">
        <attvalues>
          <attvalue for="0" value="D. J. Sordelet" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. J. Sordelet是一位学者或研究人员，专注于材料科学领域。他是学术论文《Interdiffusion behaviour of Pt-modified y-Ni and y-Ni3Al alloys coupled to Ni-Al-based alloys》的作者之一，该论文主要研究铂改性镍基合金的相互扩散行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-68a06b7c34233385dd7e1ad8a70b5d54" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-68a06b7c34233385dd7e1ad8a70b5d54-e-10" label="B. Gleeson">
        <attvalues>
          <attvalue for="0" value="B. Gleeson" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="B. Gleeson是一位材料科学领域的研究者。他是学术论文《Pt改性γ-Ni和γ'-Ni3Al合金与Ni-Al基合金的互扩散行为》的作者之一，该论文研究了特定镍基高温合金间的原子扩散机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-68a06b7c34233385dd7e1ad8a70b5d54" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-68a06b7c34233385dd7e1ad8a70b5d54-e-13" label="Ni-Al-based alloys">
        <attvalues>
          <attvalue for="0" value="Ni-Al-based alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍铝基合金是以镍(Ni)和铝(Al)为主要组元的金属材料。因其形成的金属间化合物赋予其优异的高温强度与抗氧化性，常被用作高温结构材料。在材料研究中，它常与其它合金（如Pt修饰的γ-Ni和γ'-Ni3Al合金）耦合，用于探究元素间的相互扩散行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-68a06b7c34233385dd7e1ad8a70b5d54" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-68a06b7c34233385dd7e1ad8a70b5d54-e-14" label="Interdiffusion behaviour of Pt-modified γ-Ni and γ'-Ni3Al alloys coupled to Ni-Al-based alloys">
        <attvalues>
          <attvalue for="0" value="Interdiffusion behaviour of Pt-modified γ-Ni and γ'-Ni3Al alloys coupled to Ni-Al-based alloys" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇于2005年发表在《冶金与材料汇刊》(Metallurgical and Materials Transactions)上的学术论文。该论文研究了铂(Pt)改性的γ-Ni和γ'-Ni3Al合金与镍铝基合金耦合时的互扩散行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-68a06b7c34233385dd7e1ad8a70b5d54" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Interdiffusion behaviour of Pt-modified y-Ni and y-Ni3Al alloys coupled to Ni-Al-based alloys&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-68a06b7c34233385dd7e1ad8a70b5d54-e-14&quot;, &quot;chunk-4897104ddb336b2f8f129d218c5a2cc4-e-1&quot;]}]" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-4897104ddb336b2f8f129d218c5a2cc4-e-3" label="Pt-modified γ-Ni">
        <attvalues>
          <attvalue for="0" value="Pt-modified γ-Ni" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="铂改性γ-Ni是一种通过添加铂（Pt）元素进行改性的γ-Ni（镍）合金。在材料科学中，其与Ni-Al基合金耦合时的原子相互扩散行为是重要的研究课题，对于评估高温涂层或合金体系的稳定性至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-4897104ddb336b2f8f129d218c5a2cc4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Pt-modified y-Ni&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4897104ddb336b2f8f129d218c5a2cc4-e-3&quot;, &quot;chunk-68a06b7c34233385dd7e1ad8a70b5d54-e-11&quot;]}]" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-4897104ddb336b2f8f129d218c5a2cc4-e-5" label="Ni-Al-based alloys">
        <attvalues>
          <attvalue for="0" value="Ni-Al-based alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种以镍（Ni）和铝（Al）为主要组元的高温合金。其典型的微观结构由γ-Ni基体和γ'-Ni₃Al金属间化合物强化相构成，具有卓越的高温强度、抗蠕变和抗氧化性能，是航空发动机涡轮叶片等热端部件的核心材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-4897104ddb336b2f8f129d218c5a2cc4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-4897104ddb336b2f8f129d218c5a2cc4-e-9" label="Synthesis and cyclic oxidation behaviour of a (Ni,Pt)Al coating on a desulfurised Ni-base superalloy">
        <attvalues>
          <attvalue for="0" value="Synthesis and cyclic oxidation behaviour of a (Ni,Pt)Al coating on a desulfurised Ni-base superalloy" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="这是一篇由Y. Zhang、W. Y. Lee和J. A. Haynes合著的科学论文，于1999年发表在《冶金汇刊》(Metallurgical Transactions)上。该论文研究了(Ni,Pt)Al涂层在一种脱硫镍基高温合金上的合成过程及其循环氧化行为。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1999&quot;, &quot;volume&quot;: &quot;30A&quot;, &quot;pages&quot;: &quot;2679–2687&quot;}" />
