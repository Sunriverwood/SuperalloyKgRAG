      <node id="chunk-fc5aa264fb28225ff63c38a7e3698291-e-10" label="Vacuum plasma spray quality control">
        <attvalues>
          <attvalue for="0" value="Vacuum plasma spray quality control" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《真空等离子喷涂质量控制》(Vacuum plasma spray quality control) 是一篇由H. Gruner撰写的科学论文，发表于学术期刊《Thin Solid Films》。该文主要探讨在真空等离子喷涂工艺中进行质量保证与控制的方法和技术。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1984&quot;, &quot;volume&quot;: &quot;118&quot;, &quot;pages&quot;: &quot;409-420&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-fc5aa264fb28225ff63c38a7e3698291" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-fc5aa264fb28225ff63c38a7e3698291-e-11" label="National Materials Advisory Board">
        <attvalues>
          <attvalue for="0" value="National Materials Advisory Board" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="美国国家材料顾问委员会（NMAB）是美国国家研究理事会下属的顾问机构。其主要职能是就材料科学与工程相关的国家级问题，向政府、工业界及学术界提供独立的、权威的建议、评估与研究报告。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-fc5aa264fb28225ff63c38a7e3698291" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="214" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fc5aa264fb28225ff63c38a7e3698291-e-12" label="Coatings for High-Temperature Structural Materials: Trends and Opportunities">
        <attvalues>
          <attvalue for="0" value="Coatings for High-Temperature Structural Materials: Trends and Opportunities" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由美国国家材料顾问委员会撰写的一份技术出版物。该报告聚焦于高温结构材料的涂层技术领域，系统地分析并探讨了其当前的发展趋势与未来的发展机遇。" />
          <attvalue for="3" value="{&quot;location&quot;: &quot;Washington D. C&quot;}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-fc5aa264fb28225ff63c38a7e3698291" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="214" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c0e09318f4b18b79d33ab740d82e3946-e-1" label="H. B. Guo">
        <attvalues>
          <attvalue for="0" value="H. B. Guo" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="H. B. Guo是一位专注于热障涂层领域的研究人员和作者。其研究工作具体涉及大气等离子喷涂厚热障涂层及分段式热障涂层等方向，相关学术成果发表在《Surface and Coatings Technology》等专业期刊上。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-c0e09318f4b18b79d33ab740d82e3946" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c0e09318f4b18b79d33ab740d82e3946-e-2" label="R. Vassen">
        <attvalues>
          <attvalue for="0" value="R. Vassen" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="R. Vassen是一位材料科学领域的研究人员。他专注于热障涂层技术，特别是利用大气等离子喷涂工艺制备厚涂层的相关研究，并以合著者身份发表过学术成果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c0e09318f4b18b79d33ab740d82e3946" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="332" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-c0e09318f4b18b79d33ab740d82e3946-e-3" label="D. Stover">
        <attvalues>
          <attvalue for="0" value="D. Stover" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. Stover是一位材料科学领域的研究人员，其研究专长为热障涂层技术。他曾作为合著者，参与一项关于利用大气等离子喷涂方法制备厚热障涂层的学术研究。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c0e09318f4b18b79d33ab740d82e3946" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="333" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-c0e09318f4b18b79d33ab740d82e3946-e-4" label="Atmospheric plasma sprayed (APS) thermal barrier coating">
        <attvalues>
          <attvalue for="0" value="Atmospheric plasma sprayed (APS) thermal barrier coating" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="一种通过大气等离子喷涂（APS）工艺制备的厚涂层材料体系。它属于热障涂层，专为高温环境下的隔热保护而设计。其显著特征是具有高密度的分割裂纹，这种结构能够有效提升涂层的应变容限和抗热震性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c0e09318f4b18b79d33ab740d82e3946" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Atmospheric plasma sprayed thick thermal barrier coatings&quot;, &quot;air plasma-sprayed (APS) thermal barrier coating&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c0e09318f4b18b79d33ab740d82e3946-e-4&quot;, &quot;chunk-3bddba5642b8475906b4fe90443b6049-e-4&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c0e09318f4b18b79d33ab740d82e3946-e-5" label="Segmentation crack density">
        <attvalues>
          <attvalue for="0" value="Segmentation crack density" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="节段裂纹密度是评价大气等离子喷涂厚热障涂层性能的关键微观结构参数。它指涂层截面单位长度内，垂直于基体表面的节段裂纹数量。这些裂纹旨在提升涂层的应变容限和抗热疲劳性，其密度是影响涂层宏观性能与寿命的核心因素。" />
          <attvalue for="3" value="{&quot;level&quot;: &quot;high&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c0e09318f4b18b79d33ab740d82e3946" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c0e09318f4b18b79d33ab740d82e3946-e-7" label="H. Murakami">
        <attvalues>
          <attvalue for="0" value="H. Murakami" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="H. Murakami是一名研究人员，是一项关于热处理对分段式热障涂层影响的研究论文的合著者。其研究领域涉及材料科学或工程学。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c0e09318f4b18b79d33ab740d82e3946" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="334" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-c0e09318f4b18b79d33ab740d82e3946-e-8" label="S. Kuroda">
        <attvalues>
          <attvalue for="0" value="S. Kuroda" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="S. Kuroda是一位学术研究者，其专业领域可能为材料科学或工程学。根据已知信息，他/她是一项关于热处理对分段式热障涂层影响的研究论文的合著者之一，专注于该特定技术领域的研究工作。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-c0e09318f4b18b79d33ab740d82e3946" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="335" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-c0e09318f4b18b79d33ab740d82e3946-e-11" label="Physical properties">
        <attvalues>
          <attvalue for="0" value="Physical properties" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="物理性质是物质无需发生化学变化就能表现出来的固有特性。它包括密度、熔点、热导率、电导率、热膨胀系数等，是描述材料（如高温合金）基本特征并决定其应用的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-c0e09318f4b18b79d33ab740d82e3946" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Physical Properties&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c0e09318f4b18b79d33ab740d82e3946-e-11&quot;, &quot;chunk-c8fee299c7ba0eef0fb9057ffd13203c-e-9&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c0e09318f4b18b79d33ab740d82e3946-e-12" label="Segmented thermal barrier">
        <attvalues>
          <attvalue for="0" value="Segmented thermal barrier" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="分段式热障是一种先进材料系统，特指具有贯穿厚度的微裂纹网络结构的热障涂层。这种“分段”结构旨在提高涂层对应变和热冲击的耐受性，从而增强其在航空发动机等高温部件上的服役稳定性和寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-c0e09318f4b18b79d33ab740d82e3946" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-419ca09fedc825c26d4010cfa0528d12-e-1" label="Effects of heat treatment on microstructures and physical properties of segmented thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="Effects of heat treatment on microstructures and physical properties of segmented thermal barrier coatings" />
          <attvalue for="1" value="Article" />
          <attvalue for="2" value="一篇于2005年发表在《Materials Transactions》期刊上的学术论文。该文研究了热处理工艺对分段式热障涂层的微观结构演变及其物理性能所产生的影响。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2005&quot;, &quot;pages&quot;: &quot;1775–1778&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-419ca09fedc825c26d4010cfa0528d12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="215" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-419ca09fedc825c26d4010cfa0528d12-e-2" label="Materials Transactions">
        <attvalues>
          <attvalue for="0" value="Materials Transactions" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《Materials Transactions》是由日本金属学会（JIM）等机构联合出版的国际学术期刊。该刊专注于材料科学与工程领域，发表关于金属、陶瓷等先进材料的微观结构、性能和加工工艺的原创研究。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;46&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-419ca09fedc825c26d4010cfa0528d12" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-419ca09fedc825c26d4010cfa0528d12-e-2&quot;]}]" />
          <attvalue for="9" value="215" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-419ca09fedc825c26d4010cfa0528d12-e-3" label="Pack cementation processes">
        <attvalues>
          <attvalue for="0" value="Pack cementation processes" />
          <attvalue for="1" value="Article" />
          <attvalue for="2" value="《Pack cementation processes》是一篇学术论文，作者是R. Mevrel、C. Duret和R. Pichoir。该论文于1986年发表在期刊《Materials Science and Technology》上。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1986&quot;, &quot;pages&quot;: &quot;201–206&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-419ca09fedc825c26d4010cfa0528d12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-419ca09fedc825c26d4010cfa0528d12-e-4" label="R. Mevrel">
        <attvalues>
          <attvalue for="0" value="R. Mevrel" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="R. Mevrel是一位学者，其以作者身份发表了关于材料表面处理技术“包埋法”的学术文章《Pack cementation processes》。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-419ca09fedc825c26d4010cfa0528d12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-419ca09fedc825c26d4010cfa0528d12-e-5" label="C. Duret">
        <attvalues>
          <attvalue for="0" value="C. Duret" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="C. Duret是一位研究人员，作为科技文章《Pack cementation processes》的作者之一而知名。该文章主要探讨材料科学领域的包埋渗镀工艺，属于表面工程技术范畴。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-419ca09fedc825c26d4010cfa0528d12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-419ca09fedc825c26d4010cfa0528d12-e-6" label="R. Pichoir">
        <attvalues>
          <attvalue for="0" value="R. Pichoir" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="R. Pichoir是一位研究者，作为主要作者撰写了关于材料表面处理技术的重要论文《Pack cementation processes》（包埋法工艺）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-419ca09fedc825c26d4010cfa0528d12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-419ca09fedc825c26d4010cfa0528d12-e-8" label="Volatile species in halide-activated diffusion coating packs">
        <attvalues>
          <attvalue for="0" value="Volatile species in halide-activated diffusion coating packs" />
          <attvalue for="1" value="Article" />
          <attvalue for="2" value="《Volatile species in halide-activated diffusion coating packs》是一篇由R. Bianco、R. A. Rapp和N. S. Jacobson共同撰写的科学论文，于1992年发表在学术期刊《Oxidation of Metals》上。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1992&quot;, &quot;pages&quot;: &quot;33–43&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-419ca09fedc825c26d4010cfa0528d12" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-419ca09fedc825c26d4010cfa0528d12-e-8&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-419ca09fedc825c26d4010cfa0528d12-e-9" label="R. Bianco">
        <attvalues>
          <attvalue for="0" value="R. Bianco" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="R. Bianco是一位研究人员，因撰写关于材料科学的论文《Pack cementation aluminide coatings on superalloys: codeposition of Cr and reactive elements》而知名。该论文主要研究高温合金的包埋法渗铝涂层技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-419ca09fedc825c26d4010cfa0528d12" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-419ca09fedc825c26d4010cfa0528d12-e-9&quot;, &quot;chunk-9de67a861b4260c65467b4b0d1d09a13-e-1&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-419ca09fedc825c26d4010cfa0528d12-e-10" label="R. A. Rapp">
        <attvalues>
          <attvalue for="0" value="R. A. Rapp" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="R. A. Rapp是一位材料科学领域的学者，主要研究高温防护涂层技术。他发表了关于包渗铝化物涂层及卤化物活化扩散涂层包等主题的论文，在表面工程和材料防护领域做出了重要贡献。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-419ca09fedc825c26d4010cfa0528d12" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-419ca09fedc825c26d4010cfa0528d12-e-10&quot;, &quot;chunk-9de67a861b4260c65467b4b0d1d09a13-e-2&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-419ca09fedc825c26d4010cfa0528d12-e-11" label="N. S. Jacobson">
        <attvalues>
          <attvalue for="0" value="N. S. Jacobson" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="N. S. Jacobson是一名研究人员，也是学术文章《卤化物活化扩散涂层包中的挥发性物质》(Volatile species in halide-activated diffusion coating packs) 的作者之一。该描述明确了他的学者身份和具体的学术贡献。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-419ca09fedc825c26d4010cfa0528d12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-419ca09fedc825c26d4010cfa0528d12-e-12" label="Oxidation of Metals">
        <attvalues>
          <attvalue for="0" value="Oxidation of Metals" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《Oxidation of Metals》是一本由施普林格（Springer）出版的国际同行评审科学期刊。该期刊专注于发表有关金属与气体在高温下相互作用的基础与应用研究，内容涵盖金属和合金的氧化、腐蚀机理、动力学以及防护涂层技术等领域。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;38&quot;}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-419ca09fedc825c26d4010cfa0528d12" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-419ca09fedc825c26d4010cfa0528d12-e-12&quot;, &quot;chunk-9de67a861b4260c65467b4b0d1d09a13-e-7&quot;, &quot;chunk-2ae64e13937ad7ab215b73765cbe0ff3-e-4&quot;, &quot;chunk-ad330a92e751427aaea8ad592c6975d4-e-10&quot;, &quot;chunk-d246d51e161275b250bc309214ccd241-e-7&quot;, &quot;chunk-dfe2f1887dc7e61661390cb2b77598da-e-15&quot;, &quot;chunk-1abe15e2f2db1602f97ac75bb847ef30-e-2&quot;, &quot;chunk-cd90df188efe63a1aba2d62ab225c3ae-e-3&quot;, &quot;chunk-bdbf4600f0f46ee6111ce0bae60fe800-e-3&quot;]}]" />
          <attvalue for="9" value="10" />
