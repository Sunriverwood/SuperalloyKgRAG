      <node id="chunk-0bff8302b00567f9758ab71ce974ace7-e-3" label="R. Wang">
        <attvalues>
          <attvalue for="0" value="R. Wang" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="R. Wang是一位学者或研究人员，其撰写的学术论文《热障系统中的外物损伤：机理与模拟》主要研究热障涂层系统的损伤机制与模拟方法。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-0bff8302b00567f9758ab71ce974ace7" />
