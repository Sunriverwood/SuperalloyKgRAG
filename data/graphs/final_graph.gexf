        <attvalues>
          <attvalue for="11" value="IS_PERFORMED_BY" />
          <attvalue for="12" value="The upsetting stage is carried out using open-die forging." />
          <attvalue for="13" value="upsetting by open-die forging" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-eb085f02bba98b62b26a7b0962fa3843" />
          <attvalue for="16" value="0.00014005602240896358" />
          <attvalue for="17" value="0.4000840336134454" />
        </attvalues>
      </edge>
      <edge source="chunk-eb085f02bba98b62b26a7b0962fa3843-e-5" target="chunk-eb085f02bba98b62b26a7b0962fa3843-e-7" id="chunk-eb085f02bba98b62b26a7b0962fa3843-r-7" weight="5.0">
        <attvalues>
          <attvalue for="11" value="PRODUCES" />
          <attvalue for="12" value="The upsetting stage produces an axisymmetric ingot." />
          <attvalue for="13" value="upsetting by open-die forging, to produce an axisymmetric ingot of reduced thickness and greater cross-sectional area" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-eb085f02bba98b62b26a7b0962fa3843" />
          <attvalue for="16" value="0.00014005602240896358" />
          <attvalue for="17" value="0.4000840336134454" />
        </attvalues>
