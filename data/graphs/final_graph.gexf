        </attvalues>
      </node>
      <node id="chunk-99354e5831501ba1d07293128331db80-e-6" label="NiAl">
        <attvalues>
          <attvalue for="0" value="NiAl" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍铝化物（NiAl）是一种金属间化合物，因其高熔点、低密度和优异的抗高温氧化性而备受关注。它通过在表面形成一层保护性氧化膜来抵抗腐蚀，该氧化膜的形态与剥落行为是决定其作为高温结构材料或涂层性能的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-99354e5831501ba1d07293128331db80" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-99354e5831501ba1d07293128331db80-e-8" label="a-Al₂O₃ scale">
        <attvalues>
          <attvalue for="0" value="a-Al₂O₃ scale" />
          <attvalue for="1" value="Material Phenomenon" />
          <attvalue for="2" value="α-Al₂O₃氧化膜是在高温环境下，于金属或合金表面形成的致密、稳定的α相三氧化二铝层。它作为保护性屏障，能有效阻止基体材料进一步氧化。其内部及界面空洞的形成是影响其稳定性和防护性能的关键研究课题。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-99354e5831501ba1d07293128331db80" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;a-Al2O3 scale&quot;, &quot;a-Al2O3 scales&quot;, &quot;a–Al2O3 scale&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bdbf4600f0f46ee6111ce0bae60fe800-e-2&quot;, &quot;chunk-99354e5831501ba1d07293128331db80-e-8&quot;, &quot;chunk-2a84c8f3deba57fec16eeb3e18ab4ff5-e-2&quot;, &quot;chunk-306c5bd949573532d99c69946ae2e6b5-e-4&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-99354e5831501ba1d07293128331db80-e-9" label="Interfacial and internal voids">
        <attvalues>
          <attvalue for="0" value="Interfacial and internal voids" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="一种材料缺陷，特指在α-Al2O3氧化膜中形成的空洞。其中，界面空洞位于氧化膜与基体界面，内部空洞则在氧化膜层内。这些空洞的形成会损害氧化膜的附着力及其对基体的保护性能，是相关领域的重要研究课题。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-99354e5831501ba1d07293128331db80" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;interfacial and internal voids&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-99354e5831501ba1d07293128331db80-e-9&quot;, &quot;chunk-bdbf4600f0f46ee6111ce0bae60fe800-e-4&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-bdbf4600f0f46ee6111ce0bae60fe800-e-9" label="aluminide oxidation performance">
        <attvalues>
          <attvalue for="0" value="aluminide oxidation performance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="铝化物氧化性能是一种材料性能，指铝化物（金属间化合物）在高温环境中抵抗氧化腐蚀的能力。该性能主要取决于材料表面能否形成一层致密、稳定且具有保护性的氧化铝（Al₂O₃）膜，这对于其在航空航天等高温应用中至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-bdbf4600f0f46ee6111ce0bae60fe800" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bdbf4600f0f46ee6111ce0bae60fe800-e-10" label="improved bond coats">
        <attvalues>
          <attvalue for="0" value="improved bond coats" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="改良粘结涂层 (Improved Bond Coats) 是一种先进材料组分，通常用作热障涂层系统中的关键中间层。它经过优化设计，旨在比传统涂层提供更优异的高温抗氧化、抗腐蚀性能及附着力，从而显著延长高温合金基底部件的服役寿命和可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-bdbf4600f0f46ee6111ce0bae60fe800" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bdbf4600f0f46ee6111ce0bae60fe800-e-11" label="Superalloys 2000">
        <attvalues>
          <attvalue for="0" value="Superalloys 2000" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Superalloys 2000》是一部关于高温合金的论文集，由矿物、金属与材料学会 (TMS) 于2000年出版。该出版物由 T. M. Pollock、R. D. Kissinger 和 R. R. Bowman 共同主编，汇集了多位作者在该领域的研究成果。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2000&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-bdbf4600f0f46ee6111ce0bae60fe800" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Superalloys 200&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bdbf4600f0f46ee6111ce0bae60fe800-e-11&quot;, &quot;chunk-0bff8302b00567f9758ab71ce974ace7-e-12&quot;, &quot;chunk-5d1954b761cf7718ff2558f9e10a2fac-e-3&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="12" />
        </attvalues>
      </node>
      <node id="chunk-bdbf4600f0f46ee6111ce0bae60fe800-e-13" label="R. D. Kissinger">
        <attvalues>
          <attvalue for="0" value="R. D. Kissinger" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="R. D. Kissinger是一位编辑，主要以担任专业技术出版物《Superalloys 2000》编辑的角色而闻名。该出版物聚焦于高温合金领域，表明其可能是在材料科学或相关工程领域具有专业知识的学者或研究人员。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
