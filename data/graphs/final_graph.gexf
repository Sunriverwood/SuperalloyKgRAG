          <attvalue for="9" value="6" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-c15f4840811d8961d78c6bb255597276-e-5" label="On the rumpling mechanism in nickel-aluminide coatings, part II: Characterisation of surface undulations and bond coat swelling">
        <attvalues>
          <attvalue for="0" value="On the rumpling mechanism in nickel-aluminide coatings, part II: Characterisation of surface undulations and bond coat swelling" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由K. Tolpygo与D. R. Clarke合著，发表于期刊《Acta Materialia》的学术论文。该文是关于镍铝涂层起皱机理系列研究的第二部分，接续第一部分的研究，重点表征了涂层的表面起伏与粘结层溶胀现象。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2004&quot;, &quot;pages&quot;: &quot;5129–5141&quot;, &quot;part&quot;: &quot;II&quot;}" />
