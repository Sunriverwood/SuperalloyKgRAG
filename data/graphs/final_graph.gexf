        <attvalues>
          <attvalue for="11" value="PROVIDES_ESTIMATE_FOR" />
          <attvalue for="12" value="Equation (2.29) is used to calculate a final estimate of 90 MPa for the cutting stress (τc)." />
          <attvalue for="13" value="A final estimate of τc is therefore 90 MPa, a factor of ~4 different from the 400 MPa determined from the ratio γAPB/b." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-88fbc7a52ff45f9431f17e23dd2d49a1" />
