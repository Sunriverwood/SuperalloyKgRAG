        <attvalues>
          <attvalue for="11" value="IMPLIES_EQUALITY_FOR" />
          <attvalue for="12" value="For cubic symmetry, certain elastic constants are equal, such as C11 = C22 = C33." />
          <attvalue for="13" value="Then C11 = C22 = C33, C44 = C55 = C66 and C12 = C13 = C2" />
