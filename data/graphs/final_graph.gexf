        <attvalues>
          <attvalue for="11" value="UNDERGOES" />
          <attvalue for="12" value="The spherical particles undergo solidification inside the atomisation chamber." />
          <attvalue for="13" value="The atomisation chamber is designed to be long enough to allow solidification of the particles before they reach the outlet of the chamber." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-dc663680c2568caff49f127612995631" />
          <attvalue for="17" value="0.4" />
