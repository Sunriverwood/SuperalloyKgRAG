      <node id="chunk-aaf1405fdcaab5726ea1519f7e18e407-e-1" label="Equation (2.24)">
        <attvalues>
          <attvalue for="0" value="Equation (2.24)" />
          <attvalue for="1" value="Mathematical Equation" />
          <attvalue for="2" value="一个用于解释“第二位错”的数学公式，在文档中被标记为(2.24)，其第一项的显著特征是包含因子½。" />
          <attvalue for="3" value="{}" />
