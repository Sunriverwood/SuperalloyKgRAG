      <node id="chunk-22f7760442ee5013f08b1b2ce224b483-e-6" label="classwork">
        <attvalues>
          <attvalue for="0" value="classwork" />
          <attvalue for="1" value="EducationalActivity" />
          <attvalue for="2" value="“课堂作业”（Classwork）指在课程教学期间，由教师安排并指导学生在课堂上完成的学习任务或活动。其目的在于巩固知识、培养技能或进行即时评估，是区别于课后家庭作业的一种教学环节。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-22f7760442ee5013f08b1b2ce224b483" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="50" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-22f7760442ee5013f08b1b2ce224b483-e-7" label="problem sets">
        <attvalues>
          <attvalue for="0" value="problem sets" />
          <attvalue for="1" value="EducationalActivity" />
          <attvalue for="2" value="一种教学活动，指为巩固和应用课程知识而设计的一系列练习题。作为课程的有机组成部分，它通常要求学生利用部分课堂时间进行练习、解答或集体讨论。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-22f7760442ee5013f08b1b2ce224b483" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="50" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-22f7760442ee5013f08b1b2ce224b483-e-8" label="design exercises">
        <attvalues>
          <attvalue for="0" value="design exercises" />
          <attvalue for="1" value="EducationalActivity" />
          <attvalue for="2" value="设计练习是一种旨在培养与评估设计能力的实践性教学活动。它通常作为课程的有机组成部分，在指定课时内进行，要求参与者围绕特定主题或问题，完成一项或多项具体的设计任务。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-22f7760442ee5013f08b1b2ce224b483" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="50" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-30207adabf4599d8a652adb7ed7362dc-e-1" label="Book's contents">
        <attvalues>
          <attvalue for="0" value="Book's contents" />
          <attvalue for="1" value="Educational Material" />
          <attvalue for="2" value="一种以高温合金为主题的教育材料。它系统性地阐述了高温合金的多个方面，并在教学中用于着重强调其结构与成分等不同特性之间的内在联系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-30207adabf4599d8a652adb7ed7362dc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-30207adabf4599d8a652adb7ed7362dc-e-2" label="Structure/composition of these materials">
        <attvalues>
          <attvalue for="0" value="Structure/composition of these materials" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="指材料内部的原子排列方式（结构）与化学元素构成（成分）。作为一项基础材料属性，它从根本上决定了材料的机械、化学等宏观性能与行为，并进而影响其加工工艺和应用设计。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-30207adabf4599d8a652adb7ed7362dc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-30207adabf4599d8a652adb7ed7362dc-e-3" label="Mechanical/chemical behaviour">
        <attvalues>
          <attvalue for="0" value="Mechanical/chemical behaviour" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="材料的力学与化学性能，指其在力学载荷与化学环境作用下的响应特征。它综合反映了材料的强度、韧性、抗腐蚀和抗氧化等能力，由其微观结构、化学成分及加工工艺共同决定，是评估材料使役性能的核心指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-30207adabf4599d8a652adb7ed7362dc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-30207adabf4599d8a652adb7ed7362dc-e-5" label="Design of the components">
        <attvalues>
          <attvalue for="0" value="Design of the components" />
          <attvalue for="1" value="Engineering Discipline" />
          <attvalue for="2" value="一门以应用需求为导向的工程学科，旨在综合考虑几何结构、材料及加工工艺，以确定组件的性能和功能。它作为关键的应用驱动环节，是推动高温合金等新材料发展的核心技术动力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-30207adabf4599d8a652adb7ed7362dc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-30207adabf4599d8a652adb7ed7362dc-e-6" label="Technological impetus">
        <attvalues>
          <attvalue for="0" value="Technological impetus" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="**技术驱动力 (Technological impetus)**&#10;&#10;一种源于部件设计需求，并直接推动了高温合金（Superalloys）研发与进步的根本力量。它将特定应用场景（如航空发动机）对材料性能的严苛要求，转化为合金材料开发的技术目标和前进动力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-30207adabf4599d8a652adb7ed7362dc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
