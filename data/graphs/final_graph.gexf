      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-4" target="chunk-3c63640879572110ccd78db6ac213a06-e-3" id="chunk-3d0590efade07af78fea353ef909c7ec-r-6" weight="4.0">
        <attvalues>
          <attvalue for="11" value="INFLUENCES" />
          <attvalue for="12" value="Rhenium is noted to have an influence on freckling." />
          <attvalue for="13" value="influence on freckling 140" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-3d0590efade07af78fea353ef909c7ec" />
          <attvalue for="17" value="0.26666666666666666" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-4" target="chunk-22dadd8677004929f45649f589c98023-e-4" id="chunk-bd63f78238a96a3498c5ca89d8572bea-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IMPROVES" />
          <attvalue for="12" value="Rhenium plays a role in improving alloy stability." />
          <attvalue for="13" value="role in improving alloy stability 157-162" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-bd63f78238a96a3498c5ca89d8572bea" />
          <attvalue for="16" value="0.0008989095195991745" />
          <attvalue for="17" value="0.40053934571175953" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-4" target="chunk-bd63f78238a96a3498c5ca89d8572bea-e-3" id="chunk-bd63f78238a96a3498c5ca89d8572bea-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="INFLUENCES" />
          <attvalue for="12" value="Rhenium has a role in the so-called reverse partitioning effect." />
          <attvalue for="13" value="role in so-called reverse partitioning effect 162" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-bd63f78238a96a3498c5ca89d8572bea" />
          <attvalue for="16" value="0.0012231063955201885" />
          <attvalue for="17" value="0.40073386383731213" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-4" target="chunk-421a0cbf74306b155ad41d43e8de9233-e-4" id="chunk-1ad3d9def6416eb2826a0448d6287c6f-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_MEMBER_OF" />
          <attvalue for="12" value="Rhenium (Re) is identified as one of the HCP metals." />
          <attvalue for="13" value="Of the HCP metals, only Co displays an acceptable density and cost; Re and Ru are PGMs" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-1ad3d9def6416eb2826a0448d6287c6f" />
          <attvalue for="16" value="0.002486000589448866" />
          <attvalue for="17" value="0.4014916003536693" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-4" target="chunk-5b143324ae92718a4dde1cd69bd72bd2-e-2" id="chunk-114d612b5f5f30e54d96d2a909a6dd20-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_MEMBER_OF" />
          <attvalue for="12" value="Rhenium (Re) is described as one of the densest elements in the d block." />
          <attvalue for="13" value="Alloying with these elements, which are amongst the densest in the d block owing to their electronic bonding and many unpaired electrons, causes directional and incompressible Ni" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-114d612b5f5f30e54d96d2a909a6dd20" />
          <attvalue for="16" value="0.0005526083112290009" />
          <attvalue for="17" value="0.40033156498673744" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-4" target="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-6" id="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-r-8" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DIFFUSES_SLOWER_THAN" />
          <attvalue for="12" value="Rhenium (Re) was found to diffuse several orders of magnitude more slowly than Hafnium (Hf)." />
          <attvalue for="13" value="Elements near the centre of the d block of the periodic table, for example, Re and Ru, were found to diffuse several orders of magnitude more slowly than those from the far west or far east of the d block, for example, Hf and Au;" />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-f86488a9b0d8a6ad97c3c2b189dd5035" />
          <attvalue for="16" value="0.006162196679438058" />
          <attvalue for="17" value="0.40369731800766284" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-4" target="chunk-5af1439dfd2daa394494b8c8df9e4287-e-2" id="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-r-9" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DIFFUSES_SLOWER_THAN" />
          <attvalue for="12" value="Rhenium (Re) was found to diffuse several orders of magnitude more slowly than Gold (Au)." />
          <attvalue for="13" value="Elements near the centre of the d block of the periodic table, for example, Re and Ru, were found to diffuse several orders of magnitude more slowly than those from the far west or far east of the d block, for example, Hf and Au;" />
          <attvalue for="14" value="r-9" />
          <attvalue for="15" value="chunk-f86488a9b0d8a6ad97c3c2b189dd5035" />
          <attvalue for="16" value="0.000852244817762059" />
          <attvalue for="17" value="0.40051134689065726" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-4" target="chunk-114d612b5f5f30e54d96d2a909a6dd20-e-9" id="chunk-114d612b5f5f30e54d96d2a909a6dd20-r-7" weight="4.0">
        <attvalues>
          <attvalue for="11" value="CHARACTERIZED_BY" />
          <attvalue for="12" value="The high density of Rhenium (Re) is attributed to its electronic bonding." />
          <attvalue for="13" value="Alloying with these elements, which are amongst the densest in the d block owing to their electronic bonding and many unpaired electrons, causes directional and incompressible Ni" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-114d612b5f5f30e54d96d2a909a6dd20" />
          <attvalue for="16" value="0.004155614500442086" />
          <attvalue for="17" value="0.2691600353669319" />
        </attvalues>
      </edge>
      <edge source="chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-4" target="chunk-114d612b5f5f30e54d96d2a909a6dd20-e-10" id="chunk-114d612b5f5f30e54d96d2a909a6dd20-r-8" weight="4.0">
        <attvalues>
          <attvalue for="11" value="CHARACTERIZED_BY" />
          <attvalue for="12" value="The high density of Rhenium (Re) is attributed to its many unpaired electrons." />
          <attvalue for="13" value="Alloying with these elements, which are amongst the densest in the d block owing to their electronic bonding and many unpaired electrons, causes directional and incompressible Ni" />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-114d612b5f5f30e54d96d2a909a6dd20" />
          <attvalue for="16" value="0.004155614500442086" />
