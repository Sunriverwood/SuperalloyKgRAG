          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e215022d1d6f514980641a512c1ab4f3-e-5" label="gas turbine applications">
        <attvalues>
          <attvalue for="0" value="gas turbine applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="燃气轮机应用指将燃料化学能转化为机械功的技术领域。因其高温、高压的工作环境，常需使用热障涂层等先进材料进行防护。主要涵盖发电、航空推进（喷气发动机）及工业驱动（如驱动压缩机）等方面。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e215022d1d6f514980641a512c1ab4f3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e215022d1d6f514980641a512c1ab4f3-e-5&quot;, &quot;chunk-069e9bb3e2c8dfdab86052450cf45cd2-e-5&quot;, &quot;chunk-3335ffc26fd60180a0fad8ac8e695ea9-e-3&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e215022d1d6f514980641a512c1ab4f3-e-6" label="Journal of Vacuum Science and Technology">
        <attvalues>
          <attvalue for="0" value="Journal of Vacuum Science and Technology" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由美国物理联合会(AIP)为AVS学会出版的同行评审科学期刊，专注于真空科学、薄膜和表面科学。该期刊于1964年创刊，1983年分刊为《Journal of Vacuum Science &amp; Technology A》和《B》两个系列。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;11&quot;, &quot;year&quot;: &quot;1974&quot;, &quot;pages&quot;: &quot;641-646&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e215022d1d6f514980641a512c1ab4f3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-e215022d1d6f514980641a512c1ab4f3-e-7" label="C. C. Berndt">
        <attvalues>
          <attvalue for="0" value="C. C. Berndt" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="C. C. Berndt是一位研究者与作者，其专业领域为材料科学。他/她因作为科学出版物《等离子喷涂热障涂层的失效分析》（Failure analysis of plasma-sprayed thermal barrier coatings）的合著者而为人所知。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-e215022d1d6f514980641a512c1ab4f3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e215022d1d6f514980641a512c1ab4f3-e-7&quot;, &quot;chunk-fc5aa264fb28225ff63c38a7e3698291-e-1&quot;]}]" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-e215022d1d6f514980641a512c1ab4f3-e-8" label="H. Herman">
        <attvalues>
          <attvalue for="0" value="H. Herman" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="H. Herman是一位研究人员，专注于等离子喷涂热障涂层的失效机理。他曾撰写关于该涂层在热循环过程中失效的论文，并将研究成果发表于材料科学领域的知名期刊《Thin Solid Films》。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-e215022d1d6f514980641a512c1ab4f3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e215022d1d6f514980641a512c1ab4f3-e-9" label="plasma-sprayed thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="plasma-sprayed thermal barrier coatings" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种采用等离子喷涂技术制备的先进陶瓷基复合涂层材料。它主要用于为航空发动机、燃气轮机等热端部件的金属基体提供高温隔热保护，以延长其在严苛环境下的服役寿命和可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-e215022d1d6f514980641a512c1ab4f3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e215022d1d6f514980641a512c1ab4f3-e-10" label="Thin Solid Films">
        <attvalues>
          <attvalue for="0" value="Thin Solid Films" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Thin Solid Films》是由爱思唯尔(Elsevier)出版的国际同行评审科学期刊。该期刊专注于薄膜和厚膜的科学与技术，内容涵盖其制备、结构、表征、性能及在电子、光学、涂层等领域的应用，是材料科学领域的重要学术出版物。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;108&quot;, &quot;year&quot;: &quot;1983&quot;, &quot;pages&quot;: &quot;427–437&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-e215022d1d6f514980641a512c1ab4f3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e215022d1d6f514980641a512c1ab4f3-e-10&quot;, &quot;chunk-fc5aa264fb28225ff63c38a7e3698291-e-4&quot;, &quot;chunk-632d29e490ba842c81dadf45a38731c6-e-12&quot;, &quot;chunk-27fe0e6f1cc64567c0f71ef94ca1d008-e-2&quot;, &quot;chunk-d1f2b714ead29d747fbffc907324606e-e-3&quot;, &quot;chunk-50f39f54006f612a0e1ae1be19a6ae87-e-1&quot;]}]" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-fc5aa264fb28225ff63c38a7e3698291-e-3" label="Failure analysis of plasma-sprayed thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="Failure analysis of plasma-sprayed thermal barrier coatings" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《等离子喷涂热障涂层的失效分析》(Failure analysis of plasma-sprayed thermal barrier coatings) 是一篇由C. C. Berndt与R. A. Miller合著的科学论文。该出版物详细探讨了等离子喷涂热障涂层的失效机理，并发表于学术期刊《薄固体薄膜》(Thin Solid Films)。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1984&quot;, &quot;volume&quot;: &quot;119&quot;, &quot;pages&quot;: &quot;173–184&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-fc5aa264fb28225ff63c38a7e3698291" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-fc5aa264fb28225ff63c38a7e3698291-e-5" label="B. J. Gill">
        <attvalues>
          <attvalue for="0" value="B. J. Gill" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="B. J. Gill是一位作者，作为科技出版物《等离子喷涂涂层工艺》（Plasma spray coating processes）的合著者而知名。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-fc5aa264fb28225ff63c38a7e3698291" />
