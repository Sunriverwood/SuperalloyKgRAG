        </attvalues>
      </node>
      <node id="chunk-27fe0e6f1cc64567c0f71ef94ca1d008-e-9" label="R. G. Garlik">
        <attvalues>
          <attvalue for="0" value="R. G. Garlik" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="R. G. Garlik是一位材料科学领域的研究人员。他与R. A. Miller等人合作，专注于陶瓷涂层领域，共同发表了关于等离子喷涂部分稳定氧化锆-氧化钇相稳定性的学术论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-27fe0e6f1cc64567c0f71ef94ca1d008" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-27fe0e6f1cc64567c0f71ef94ca1d008-e-9&quot;, &quot;chunk-43f7a3d07847f327a8e75bdf9e852f1d-e-2&quot;]}]" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-27fe0e6f1cc64567c0f71ef94ca1d008-e-10" label="Phase stability">
        <attvalues>
          <attvalue for="0" value="Phase stability" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="相稳定性是一种材料属性，指材料在高温等条件下抵抗晶体结构发生相变的能力。它是决定热障涂层等高温材料服役可靠性的关键。不良的相稳定性会导致有害相变，引发体积突变与应力，进而造成材料开裂失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-27fe0e6f1cc64567c0f71ef94ca1d008" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-43f7a3d07847f327a8e75bdf9e852f1d-e-1" label="Smialek">
        <attvalues>
          <attvalue for="0" value="Smialek" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="Smialek是一位研究人员，其研究领域涉及材料科学。他撰写并发表了一篇关于部分稳定氧化锆-氧化钇（partially stabilised zirconia-yttria）相稳定性的学术出版物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-43f7a3d07847f327a8e75bdf9e852f1d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-43f7a3d07847f327a8e75bdf9e852f1d-e-3" label="partially stabilised zirconia-yttria">
        <attvalues>
          <attvalue for="0" value="partially stabilised zirconia-yttria" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="The subject material of a study on phase stability." />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-43f7a3d07847f327a8e75bdf9e852f1d" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-43f7a3d07847f327a8e75bdf9e852f1d-e-4" label="plasma-sprayed">
        <attvalues>
          <attvalue for="0" value="plasma-sprayed" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="等离子喷涂是一种热喷涂工艺。它利用高温等离子射流将粉末材料（如钇稳定氧化锆）加热至熔融或半熔融状态，并高速喷射到基体表面，以形成具有特定功能（如隔热、耐磨）的致密涂层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-43f7a3d07847f327a8e75bdf9e852f1d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-43f7a3d07847f327a8e75bdf9e852f1d-e-4&quot;]}]" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-43f7a3d07847f327a8e75bdf9e852f1d-e-5" label="A. H. Heuer">
        <attvalues>
          <attvalue for="0" value="A. H. Heuer" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="A. H. Heuer，学者，因担任材料科学领域重要出版物《氧化锆的科学与技术》（Science and Technology of Zirconia）的编辑而知名。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-43f7a3d07847f327a8e75bdf9e852f1d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-43f7a3d07847f327a8e75bdf9e852f1d-e-6" label="L. W. Hobbs">
        <attvalues>
          <attvalue for="0" value="L. W. Hobbs" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="L. W. Hobbs是一位学者或研究人员，以其在材料科学领域的贡献而知名。其作为作者之一，发表了题为《The oxidation mechanism of θ-Al2O3 scales》的科学出版物，该著作主要研究了特定形态氧化铝（θ-Al2O3）的氧化机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-43f7a3d07847f327a8e75bdf9e852f1d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-43f7a3d07847f327a8e75bdf9e852f1d-e-6&quot;, &quot;chunk-fd2a5b7b3ff5ec7dcf35bde15448af5a-e-11&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-43f7a3d07847f327a8e75bdf9e852f1d-e-7" label="Science and Technology of Zirconia">
        <attvalues>
          <attvalue for="0" value="Science and Technology of Zirconia" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Science and Technology of Zirconia》是一本由A. H. Heuer与L. W. Hobbs共同编辑的学术著作，由美国陶瓷学会（American Ceramic Society）出版。该书是《陶瓷进展》（Advances in Ceramics）系列丛书的一部分，系统阐述了氧化锆材料领域的科学理论与技术应用。" />
          <attvalue for="3" value="{&quot;Volume&quot;: &quot;3&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-43f7a3d07847f327a8e75bdf9e852f1d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-43f7a3d07847f327a8e75bdf9e852f1d-e-8" label="American Ceramic Society">
        <attvalues>
          <attvalue for="0" value="American Ceramic Society" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="美国陶瓷学会（The American Ceramic Society, ACerS）是一个非营利性的国际专业会员组织。它致力于通过期刊、书籍、会议和教育项目等方式，服务全球陶瓷与玻璃材料领域的科学家、工程师和学生，以推动该领域的科学、技术及艺术发展。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-43f7a3d07847f327a8e75bdf9e852f1d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-43f7a3d07847f327a8e75bdf9e852f1d-e-9" label="J. A. Thompson">
        <attvalues>
          <attvalue for="0" value="J. A. Thompson" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="J. A. Thompson 是一位学者或研究人员。基于其曾在材料科学领域的权威学术期刊《Acta Materialia》上发表过论文，可推断其专业方向与材料科学相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-43f7a3d07847f327a8e75bdf9e852f1d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-43f7a3d07847f327a8e75bdf9e852f1d-e-10" label="T. W. Clyne">
        <attvalues>
          <attvalue for="0" value="T. W. Clyne" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="T. W. Clyne 是一位学者，他作为作者之一发表了关于等离子喷涂热障涂层热流模拟的学术论文《An analytical model for simulation of heat flow in plasma-sprayed thermal barrier coatings》。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-43f7a3d07847f327a8e75bdf9e852f1d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-43f7a3d07847f327a8e75bdf9e852f1d-e-10&quot;, &quot;chunk-65dc63e5f84c9fe26415a54961f65c33-e-3&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-43f7a3d07847f327a8e75bdf9e852f1d-e-12" label="zirconia top coats">
        <attvalues>
          <attvalue for="0" value="zirconia top coats" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="氧化锆顶涂层是等离子喷涂热障涂层（TBCs）的关键组成部分，通常为陶瓷材料。它起到核心隔热作用，其一个重要特性是刚度等力学性能会受到热处理工艺的显著影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-43f7a3d07847f327a8e75bdf9e852f1d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1627343f7b800c4d8692450b585a00e8-e-1" label="J. R. Brandon">
        <attvalues>
          <attvalue for="0" value="J. R. Brandon" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="J. R. Brandon是一位学者、研究人员，因其在材料科学领域的贡献而知名。他是学术论文《The phase stability of zirconia-based thermal barrier coatings: 1. Zirconia-yttria alloys》的合著者之一，该论文主要研究了氧化锆基热障涂层在锆-钇合金体系中的相稳定性问题。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-1627343f7b800c4d8692450b585a00e8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1627343f7b800c4d8692450b585a00e8-e-2" label="R. Taylor">
        <attvalues>
          <attvalue for="0" value="R. Taylor" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="R. Taylor是一位材料科学领域的研究人员。他/她是关于氧化锆基热障涂层相稳定性研究论文的合著者之一，该研究具体探讨了氧化锆-氧化钇合金的特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-1627343f7b800c4d8692450b585a00e8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1627343f7b800c4d8692450b585a00e8-e-3" label="The phase stability of zirconia-based thermal barrier coatings: 1. Zirconia-yttria alloys">
        <attvalues>
          <attvalue for="0" value="The phase stability of zirconia-based thermal barrier coatings: 1. Zirconia-yttria alloys" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由J. R. Brandon和R. Taylor合著的学术论文，于1991年发表在期刊《Surface Coatings Technology》上。该论文研究了氧化锆基热障涂层的相稳定性，并重点探讨了其中的氧化锆-氧化钇合金。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1991&quot;, &quot;volume&quot;: &quot;46&quot;, &quot;pages&quot;: &quot;75–90&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-1627343f7b800c4d8692450b585a00e8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-1627343f7b800c4d8692450b585a00e8-e-4" label="Zirconia-yttria alloys">
        <attvalues>
          <attvalue for="0" value="Zirconia-yttria alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="氧化锆-氧化钇合金是一种先进陶瓷材料，通常被称为钇稳定氧化锆（YSZ）。它是通过在氧化锆中添加氧化钇作为稳定剂，以抑制其破坏性相变，从而在高温下保持稳定的晶体结构。因其优异的热稳定性、低热导率和高断裂韧性，被广泛用作航空发动机和燃气轮机上的热障涂层关键材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1627343f7b800c4d8692450b585a00e8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1627343f7b800c4d8692450b585a00e8-e-4&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1627343f7b800c4d8692450b585a00e8-e-6" label="R. L. Jones">
        <attvalues>
          <attvalue for="0" value="R. L. Jones" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="R. L. Jones是一位研究人员，因其作为合著者发表的关于材料科学的论文而知名。该论文主要研究在1400°C高温下，使用氧化钪和氧化钇来提高氧化锆材料的四方相稳定性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-1627343f7b800c4d8692450b585a00e8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1627343f7b800c4d8692450b585a00e8-e-6&quot;, &quot;chunk-491e59c42061a40a1fe533ef4ec8d245-e-4&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1627343f7b800c4d8692450b585a00e8-e-7" label="D. Mess">
        <attvalues>
          <attvalue for="0" value="D. Mess" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="D. Mess是一位研究人员，作为合著者发表了题为“Improved tetragonal phase stability at 1400 °C with scandia, yttria-stabilised zirconia”的学术论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-1627343f7b800c4d8692450b585a00e8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1627343f7b800c4d8692450b585a00e8-e-8" label="Improved tetragonal phase stability at 1400 °C with scandia, yttria-stabilised zirconia">
        <attvalues>
          <attvalue for="0" value="Improved tetragonal phase stability at 1400 °C with scandia, yttria-stabilised zirconia" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Improved tetragonal phase stability at 1400 °C with scandia, yttria-stabilised zirconia》是一篇由R. L. Jones和D. Mess合著的学术论文。该论文于1996年发表在科学期刊《Surface and Coatings Technology》上，主要研究在高温下利用氧化钪和氧化钇提高氧化锆稳定性的课题。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1996&quot;, &quot;volume&quot;: &quot;86–87&quot;, &quot;pages&quot;: &quot;94-101&quot;, &quot;temperature&quot;: &quot;1400 °C&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-1627343f7b800c4d8692450b585a00e8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-1627343f7b800c4d8692450b585a00e8-e-9" label="scandia, yttria-stabilised zirconia">
        <attvalues>
          <attvalue for="0" value="scandia, yttria-stabilised zirconia" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="A material that provides improved tetragonal phase stability at 1400 °C." />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-1627343f7b800c4d8692450b585a00e8" />
          <attvalue for="9" value="216" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1627343f7b800c4d8692450b585a00e8-e-10" label="tetragonal phase stability">
        <attvalues>
          <attvalue for="0" value="tetragonal phase stability" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="四方相稳定性是一种材料性能，指氧化锆等材料在一定条件下维持其四方晶相结构、抵抗向其他晶相转变的能力。该稳定性可通过掺杂氧化钪和氧化钇等稳定剂来提高，对于改善材料的高温性能至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-1627343f7b800c4d8692450b585a00e8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="216" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-491e59c42061a40a1fe533ef4ec8d245-e-1" label="scandia, yttria-stabilised zirconia">
        <attvalues>
          <attvalue for="0" value="scandia, yttria-stabilised zirconia" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="氧化钪钇稳定氧化锆是一种先进陶瓷，通过向氧化锆(ZrO₂)中共同掺杂氧化钪和氧化钇作为稳定剂制成。这种共掺杂显著提升了材料的氧离子电导率和热稳定性，使其成为高性能固体氧化物燃料电池(SOFC)和氧传感器的关键电解质材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-491e59c42061a40a1fe533ef4ec8d245" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-491e59c42061a40a1fe533ef4ec8d245-e-1&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-491e59c42061a40a1fe533ef4ec8d245-e-3" label="M. Leoni">
        <attvalues>
          <attvalue for="0" value="M. Leoni" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="M. Leoni是一位研究人员，作为作者之一发表了题为《Phase stability of scandia-yttria-stabilised zirconia TBCs》的学术论文，该研究主要关注特定热障涂层材料的相稳定性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-491e59c42061a40a1fe533ef4ec8d245" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-491e59c42061a40a1fe533ef4ec8d245-e-5" label="P. Scardi">
        <attvalues>
          <attvalue for="0" value="P. Scardi" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="P. Scardi 是一名研究人员，是学术著作《Phase stability of scandia-yttria-stabilised zirconia TBCs》的作者之一。该著作主要研究材料科学领域中，钪-钇稳定氧化锆热障涂层（TBCs）的相稳定性问题。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-491e59c42061a40a1fe533ef4ec8d245" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-491e59c42061a40a1fe533ef4ec8d245-e-6" label="Phase stability of scandia-yttria-stabilised zirconia TBCs">
        <attvalues>
          <attvalue for="0" value="Phase stability of scandia-yttria-stabilised zirconia TBCs" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由M. Leoni、R. L. Jones和P. Scardi合著的研究论文，发表于《表面与涂层技术》期刊。该论文主要研究了采用钪和钇共同稳定的氧化锆作为热障涂层（TBCs）材料时的相稳定性问题。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;108–109&quot;, &quot;year&quot;: &quot;1998&quot;, &quot;pages&quot;: &quot;107–113&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-491e59c42061a40a1fe533ef4ec8d245" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-491e59c42061a40a1fe533ef4ec8d245-e-7" label="K. Matsumoto">
        <attvalues>
          <attvalue for="0" value="K. Matsumoto" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="K. Matsumoto是一位材料科学领域的研究人员。他/她作为作者之一，发表了题为《EB-PVD process and thermal properties of hafnia-based thermal barrier coating》的学术论文，该论文研究了氧化铪基热障涂层的制备工艺与热性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-491e59c42061a40a1fe533ef4ec8d245" />
