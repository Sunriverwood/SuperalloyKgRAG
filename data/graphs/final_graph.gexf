      <edge source="chunk-d6f6eec7dd0b201862043d9dfba0195d-e-3" target="chunk-954a43f6bb0bc08cefcb62bd390ac3fa-e-3" id="chunk-d6f6eec7dd0b201862043d9dfba0195d-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_ALTERNATIVE_REPRESENTATION_OF" />
          <attvalue for="12" value="Compliance constants (Sij) are an alternative way to represent the elastic properties of a material, instead of using elasticity constants (Cij)." />
          <attvalue for="13" value="An alternative representation is via the compliance constants S11, S12 and S44, such that" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-d6f6eec7dd0b201862043d9dfba0195d" />
          <attvalue for="16" value="0.013495276653171389" />
          <attvalue for="17" value="0.4080971659919029" />
        </attvalues>
      </edge>
      <edge source="chunk-d6f6eec7dd0b201862043d9dfba0195d-e-6" target="chunk-d6f6eec7dd0b201862043d9dfba0195d-e-3" id="chunk-d6f6eec7dd0b201862043d9dfba0195d-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_CALCULATED_WITH" />
          <attvalue for="12" value="The strain component €11 is calculated using the compliance constants S11 and S12." />
          <attvalue for="13" value="€11 = S11σ11 + S12σ22 + S12σ33" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-d6f6eec7dd0b201862043d9dfba0195d" />
          <attvalue for="16" value="0.004048582995951417" />
          <attvalue for="17" value="0.4024291497975709" />
        </attvalues>
      </edge>
      <edge source="chunk-d6f6eec7dd0b201862043d9dfba0195d-e-7" target="chunk-d6f6eec7dd0b201862043d9dfba0195d-e-3" id="chunk-d6f6eec7dd0b201862043d9dfba0195d-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_CALCULATED_WITH" />
          <attvalue for="12" value="The strain component €22 is calculated using the compliance constants S11 and S12." />
          <attvalue for="13" value="€22 = S12σ11 + S11σ22 + S12σ33" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-d6f6eec7dd0b201862043d9dfba0195d" />
          <attvalue for="16" value="0.004048582995951417" />
          <attvalue for="17" value="0.4024291497975709" />
        </attvalues>
      </edge>
      <edge source="chunk-d6f6eec7dd0b201862043d9dfba0195d-e-8" target="chunk-d6f6eec7dd0b201862043d9dfba0195d-e-3" id="chunk-d6f6eec7dd0b201862043d9dfba0195d-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_CALCULATED_WITH" />
          <attvalue for="12" value="The strain component €33 is calculated using the compliance constants S11 and S12." />
          <attvalue for="13" value="€33 = S12σ11 + S12σ22 + S11σ33" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-d6f6eec7dd0b201862043d9dfba0195d" />
          <attvalue for="16" value="0.004048582995951417" />
          <attvalue for="17" value="0.4024291497975709" />
        </attvalues>
