      <node id="chunk-fb8636aebcb8b8d854ebe34fb885b102-e-6" label="Protective coatings">
        <attvalues>
          <attvalue for="0" value="Protective coatings" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Protective coatings》是由学者J. H. Wood与E. Goldman共同撰写的一篇出版物。该文是学术专著《Superalloys II》中的一个章节，详细论述了高温合金的防护涂层技术。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;359–384&quot;}" />
