      <node id="chunk-f5c07b55f3d29bb402b546962b69a445-e-2" label="CMSX-4">
        <attvalues>
          <attvalue for="0" value="CMSX-4" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="CMSX-4是一种第二代镍基单晶高温合金，以添加约3%的铼（Re）为主要特征。该合金具有卓越的高温蠕变强度、抗热腐蚀和抗疲劳性能，是制造先进航空发动机及工业燃气轮机的高压涡轮叶片等核心热端部件的关键材料。" />
          <attvalue for="3" value="{&quot;generation&quot;: &quot;second-generation&quot;, &quot;category&quot;: &quot;single-crystal superalloy&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-f5c07b55f3d29bb402b546962b69a445" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;CMSX-4 superalloy&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f5c07b55f3d29bb402b546962b69a445-e-2&quot;, &quot;chunk-ba75e6448ea6f9f49ca3935b800555ba-e-3&quot;, &quot;chunk-8cc148c1ca974c554ee456036519b0b3-e-15&quot;, &quot;chunk-ada80b922694fd6450f48225d9ee63bb-e-5&quot;, &quot;chunk-c26d17a0082c516bc0b48b307c73e551-e-1&quot;, &quot;chunk-c44bc316af8bfbfde3c05fd247258d3c-e-3&quot;, &quot;chunk-810fb1ebfd1f2112fedd829e635a8739-e-3&quot;, &quot;chunk-10bd7f0e07de14852011152b501359da-e-3&quot;, &quot;chunk-78c519f8cce4113c48c714a60ca273ce-e-10&quot;, &quot;chunk-f23caa328479b9d419f0d855b9335eb4-e-2&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-f5c07b55f3d29bb402b546962b69a445-e-3" label="RR3000">
        <attvalues>
          <attvalue for="0" value="RR3000" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="RR3000是一种第三代合金，以其显著改善的蠕变断裂寿命为主要特征。该性能优于其前代合金SRR99，从而在高温高压等严苛环境下能拥有更长的服役寿命和更高的可靠性。" />
          <attvalue for="3" value="{&quot;generation&quot;: &quot;third-generation&quot;, &quot;category&quot;: &quot;single-crystal superalloy&quot;}" />
          <attvalue for="4" value="e-3" />
