        <attvalues>
          <attvalue for="11" value="AFFECTS_NON_MONOTONICALLY" />
          <attvalue for="12" value="The creep performance does not increase linearly as the γ' fraction increases; a 70% fraction results in better performance than a 100% fraction." />
          <attvalue for="13" value="A second point is that the creep performance does not increase monotonically as the y' fraction is increased – thus, an alloy with 70% γ' performs better than one with 100% γ'." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-ee27b5b0461f20c87cc65a6eed743e2e" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
