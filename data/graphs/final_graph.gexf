        <attvalues>
          <attvalue for="11" value="REDUCES_LOAD_BEARING_AREA_OF" />
          <attvalue for="12" value="Instability, such as TCP formation, reduces the effective load-bearing cross-sectional area of thin-walled sections." />
          <attvalue for="13" value="the cross-sectional area of the thin-walled sections, which is effective at load-bearing, is reduced by such instability." />
