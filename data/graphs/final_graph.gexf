        <attvalues>
          <attvalue for="11" value="IS_PROBABILITY_OF_EVENT_INVOLVING" />
          <attvalue for="12" value="p2 is defined as the probability that the actual life Np is less than No." />
          <attvalue for="13" value="the probability, p2, that the actual life is Np such that Np &lt; No is" />
