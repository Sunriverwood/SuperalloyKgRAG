        <attvalues>
          <attvalue for="0" value="Reference [131]" />
          <attvalue for="1" value="Bibliographic Reference" />
          <attvalue for="2" value="文献引用[131]是一条由学者A. G. Evans、J. W. Hutchinson与M. Y. He合著的学术著作书目信息。该引用条目是不完整的，缺少如标题、年份或出版物等详细信息。" />
          <attvalue for="3" value="{&quot;reference_number&quot;: &quot;[131]&quot;}" />
