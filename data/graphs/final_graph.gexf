      <edge source="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-12" target="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-10" id="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-r-10" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CAUSES" />
          <attvalue for="12" value="Crystallographic cracking on {111} planes is caused by planar slip." />
          <attvalue for="13" value="there is a strong tendency for crystallographic cracking on {111} planes due to the 'planar slip'" />
          <attvalue for="14" value="r-10" />
          <attvalue for="15" value="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa" />
          <attvalue for="16" value="0.00041228612657184083" />
          <attvalue for="17" value="0.40024737167594315" />
        </attvalues>
      </edge>
      <edge source="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-12" target="chunk-d8d142dae6b416fb1b1609254612e5f8-e-1" id="chunk-d8d142dae6b416fb1b1609254612e5f8-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CAUSES" />
          <attvalue for="12" value="Planar slip is stated as the reason for the strong tendency for crystallographic cracking on {111} planes." />
          <attvalue for="13" value="strong tendency for crystallographic cracking on {111} planes due to the 'planar slip'" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-d8d142dae6b416fb1b1609254612e5f8" />
          <attvalue for="16" value="0.00020614306328592042" />
          <attvalue for="17" value="0.4001236858379716" />
        </attvalues>
