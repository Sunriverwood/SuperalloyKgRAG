      <node id="chunk-e215022d1d6f514980641a512c1ab4f3-e-2" label="T. E. Strangman">
        <attvalues>
          <attvalue for="0" value="T. E. Strangman" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="T. E. Strangman是一位研究人员，其研究领域为应用于燃气轮机的电子束气相沉积涂层技术。他曾将该领域的相关研究论文发表于《真空科学与技术杂志》（Journal of Vacuum Science and Technology）。" />
          <attvalue for="3" value="{}" />
