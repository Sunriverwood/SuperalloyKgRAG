        <attvalues>
          <attvalue for="11" value="COMPARED_WITH" />
          <attvalue for="12" value="The anisotropy factor of Nickel (2.44) is compared with that of Silver (2.97)." />
          <attvalue for="13" value="The value for Ni is 2.44, which compares with... Ag at 2.97..." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-3ff783a5b26a130b0577173680195866" />
          <attvalue for="16" value="1.4736221632773356e-05" />
