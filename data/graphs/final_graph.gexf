          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e408a73fcde801378877f777a7391169-e-11&quot;, &quot;chunk-918e2b930e37d82a44d73a02b4fca57a-e-7&quot;, &quot;chunk-356a95a5ba9ccf9ed595619218c5107b-e-11&quot;]}]" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-e408a73fcde801378877f777a7391169-e-12" label="Thermal barrier coatings for gas-turbine applications">
        <attvalues>
          <attvalue for="0" value="Thermal barrier coatings for gas-turbine applications" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由N. P. Padture、M. Gell与E. H. Jordan合著的科学论文，主题为燃气轮机应用中的热障涂层。该文发表于国际顶级期刊《科学》（Science），是该领域的关键研究文献之一。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2002&quot;}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-e408a73fcde801378877f777a7391169" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-e408a73fcde801378877f777a7391169-e-13" label="Science">
        <attvalues>
          <attvalue for="0" value="Science" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《科学》（Science）是由美国科学促进会（AAAS）出版的同行评审学术期刊。作为全球最权威、引用最广泛的科学期刊之一，它发表涵盖所有科学领域的原创性研究论文、综述及评论。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;296&quot;}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-e408a73fcde801378877f777a7391169" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e408a73fcde801378877f777a7391169-e-15" label="D. R. Clarke">
        <attvalues>
          <attvalue for="0" value="D. R. Clarke" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. R. Clarke是一位研究人员，作为科学论文《Oxidation-induced failure of EB-PVD thermal barrier coatings》的作者之一，其研究聚焦于材料科学领域。该论文主要探讨了通过电子束物理气相沉积（EB-PVD）技术制备的先进热障涂层，因氧化而导致的失效机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-e408a73fcde801378877f777a7391169" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e408a73fcde801378877f777a7391169-e-15&quot;, &quot;chunk-632d29e490ba842c81dadf45a38731c6-e-3&quot;, &quot;chunk-40aba596fdad149dc1402c5d9c81d53c-e-2&quot;, &quot;chunk-8a8245180b98739270d9b9b4befedd30-e-7&quot;, &quot;chunk-c15f4840811d8961d78c6bb255597276-e-2&quot;, &quot;chunk-b0e7e9ee8763bf537001ff2836e82040-e-4&quot;, &quot;chunk-69451a0856df90ef7a5f897ca8878dd2-e-6&quot;, &quot;chunk-356a95a5ba9ccf9ed595619218c5107b-e-4&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="10" />
        </attvalues>
      </node>
      <node id="chunk-e408a73fcde801378877f777a7391169-e-16" label="Materials selection guidelines for low thermal conductivity thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="Materials selection guidelines for low thermal conductivity thermal barrier coatings" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇发表于《表面与涂层技术》(Surface and Coatings Technology) 的科学出版物。该文献为低导热率热障涂层的材料选择提供了系统的指导方针，阐述了用于开发高效隔热涂层的材料筛选原则、性能要求与评估标准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-e408a73fcde801378877f777a7391169" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e408a73fcde801378877f777a7391169-e-16&quot;, &quot;chunk-c2ec04cbf3c90264a785b174dcc622ba-e-1&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c2ec04cbf3c90264a785b174dcc622ba-e-3" label="Surface and Coatings Technology">
        <attvalues>
          <attvalue for="0" value="Surface and Coatings Technology" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《表面与涂层技术》（Surface and Coatings Technology）是由爱思唯尔（Elsevier）出版的国际同行评审学术期刊。该刊专注于表面工程、薄膜和涂层的科学与技术，发表材料科学、物理、化学等交叉学科领域的相关原创研究，是该领域的重要刊物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c2ec04cbf3c90264a785b174dcc622ba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Surface Coatings Technology&quot;, &quot;Surface and Coatings&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e408a73fcde801378877f777a7391169-e-17&quot;, &quot;chunk-c2ec04cbf3c90264a785b174dcc622ba-e-3&quot;, &quot;chunk-2b7a9fe88ca8d6ac202cedf8f0e4d421-e-4&quot;, &quot;chunk-c0e09318f4b18b79d33ab740d82e3946-e-6&quot;, &quot;chunk-819db6cd818e9e8d5c81db94051547db-e-12&quot;, &quot;chunk-92b406eccca67ea13b9ebc2a390eadd2-e-5&quot;, &quot;chunk-edb9affa83770653e14e4cc8e96d4809-e-3&quot;, &quot;chunk-1627343f7b800c4d8692450b585a00e8-e-5&quot;, &quot;chunk-491e59c42061a40a1fe533ef4ec8d245-e-2&quot;, &quot;chunk-be8d9004ced79264b7784b3065b5da94-e-4&quot;, &quot;chunk-72bc234ea267d66a5baa8214264163ee-e-9&quot;, &quot;chunk-65dc63e5f84c9fe26415a54961f65c33-e-10&quot;, &quot;chunk-ab782043d3ae1a90c5f1e5036270c1d8-e-2&quot;, &quot;chunk-6eb9964e0070cc2b73d942919084bb21-e-11&quot;, &quot;chunk-f84d9415930cf45b94dd88365f7c6b9e-e-8&quot;, &quot;chunk-06ba6595cab42702f10c3f20f15fc2ee-e-8&quot;, &quot;chunk-67429b99cdb3121ddbb638d5930365e4-e-8&quot;, &quot;chunk-8031eb636b002393280031950b878895-e-5&quot;, &quot;chunk-40aba596fdad149dc1402c5d9c81d53c-e-6&quot;, &quot;chunk-6f4f79d57f35ab3e77324ff6707d70bf-e-5&quot;, &quot;chunk-65335c426f17131b3458c32075ac90d7-e-8&quot;, &quot;chunk-0be0c36bfb88c04374e36b5059a1c5fc-e-5&quot;, &quot;chunk-69451a0856df90ef7a5f897ca8878dd2-e-10&quot;, &quot;chunk-918e2b930e37d82a44d73a02b4fca57a-e-10&quot;, &quot;chunk-0bff8302b00567f9758ab71ce974ace7-e-1&quot;, &quot;chunk-988c4d7fcff0bc412e7695d08b17502d-e-5&quot;, &quot;chunk-8858e7b554c309b2b183ee00a5fadc99-e-5&quot;, &quot;chunk-356a95a5ba9ccf9ed595619218c5107b-e-8&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="24" />
        </attvalues>
      </node>
      <node id="chunk-c2ec04cbf3c90264a785b174dcc622ba-e-4" label="Substrate and bond coat compositions: factors affecting alumina scale adhesion">
        <attvalues>
          <attvalue for="0" value="Substrate and bond coat compositions: factors affecting alumina scale adhesion" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="B. A. Pint, I. G. Wright, W. Y. Lee, Y. Zhang, K. Prussner 和 K. B. Alexander 是一组研究人员，他们共同撰写了科学出版物《Substrate and bond coat compositions: factors affecting alumina scale adhesion》。该研究探讨了基体和粘结层的成分作为影响氧化铝皮膜附着力的关键因素。" />
          <attvalue for="3" value="{&quot;publication_year&quot;: &quot;1998&quot;, &quot;volume&quot;: &quot;A245&quot;, &quot;pages&quot;: &quot;201–211&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c2ec04cbf3c90264a785b174dcc622ba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;B. A. Pint, I. G. Wright, W. Y. Lee, Y. Zhang, K. Prussner and K. B. Alexander&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c2ec04cbf3c90264a785b174dcc622ba-e-4&quot;, &quot;chunk-c2ec04cbf3c90264a785b174dcc622ba-e-5&quot;]}]" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c2ec04cbf3c90264a785b174dcc622ba-e-7" label="Materials Science and Engineering">
        <attvalues>
          <attvalue for="0" value="Materials Science and Engineering" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="由爱思唯尔（Elsevier）出版的国际同行评审学术期刊系列。该系列期刊专注于材料科学与工程领域，探讨材料的结构、性能、加工与应用之间的关系，旗下分为《Materials Science and Engineering: A》、《B》、《C》、《R》等多个子刊。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c2ec04cbf3c90264a785b174dcc622ba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c2ec04cbf3c90264a785b174dcc622ba-e-7&quot;, &quot;chunk-65335c426f17131b3458c32075ac90d7-e-11&quot;, &quot;chunk-0be0c36bfb88c04374e36b5059a1c5fc-e-2&quot;, &quot;chunk-69451a0856df90ef7a5f897ca8878dd2-e-3&quot;]}]" />
          <attvalue for="9" value="33" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c2ec04cbf3c90264a785b174dcc622ba-e-8" label="Effects of strain cycling on buckling, cracking and spalling of a thermally grown alumina on a nickel-based">
        <attvalues>
          <attvalue for="0" value="Effects of strain cycling on buckling, cracking and spalling of a thermally grown alumina on a nickel-based" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由J. S. Wang和A. G. Evans撰写的学术出版物。该研究探讨了应变循环对镍基合金上热生长氧化铝层所产生的屈曲、开裂和剥落等失效模式的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-c2ec04cbf3c90264a785b174dcc622ba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c2ec04cbf3c90264a785b174dcc622ba-e-9" label="J. S. Wang and A. G. Evans">
        <attvalues>
          <attvalue for="0" value="J. S. Wang and A. G. Evans" />
          <attvalue for="1" value="Author Group" />
          <attvalue for="2" value="J. S. Wang与A. G. Evans是合作发表科学论文的学者组合。他们以共同撰写的论文而知名，该论文系统研究了应变循环对镍基合金上热生长氧化铝涂层的屈曲、开裂和剥落等力学行为的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-c2ec04cbf3c90264a785b174dcc622ba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c2ec04cbf3c90264a785b174dcc622ba-e-11" label="nickel-based">
        <attvalues>
          <attvalue for="0" value="nickel-based" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种以镍为基体（通常含量&gt;50%）的合金，多指镍基高温合金。因其优异的高温强度、抗氧化和抗蠕变性能，常用于制造航空发动机等热端部件，在高温环境中其表面可形成热生长氧化铝保护层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-c2ec04cbf3c90264a785b174dcc622ba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c2ec04cbf3c90264a785b174dcc622ba-e-12" label="strain cycling">
        <attvalues>
          <attvalue for="0" value="strain cycling" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;应变循环是一种力学过程，指材料或结构承受周期性重复施加的变形（应变）。这种循环加载会引发材料疲劳，逐渐累积损伤，最终可导致开裂（cracking）、屈曲（buckling）或剥落（spalling）等失效模式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-c2ec04cbf3c90264a785b174dcc622ba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c2ec04cbf3c90264a785b174dcc622ba-e-12&quot;, &quot;chunk-6dac0a4c73567f8946fa9c50957af9ca-e-1&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-6dac0a4c73567f8946fa9c50957af9ca-e-3" label="cracking">
        <attvalues>
          <attvalue for="0" value="cracking" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="开裂是一种主要影响堆焊层的失效模式，指材料中形成裂纹的现象。其发生倾向由材料的韧脆转变温度（DBTT）所控制，当温度低于该值时，材料更易发生脆性断裂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-6dac0a4c73567f8946fa9c50957af9ca" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Cracking&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6dac0a4c73567f8946fa9c50957af9ca-e-3&quot;, &quot;chunk-2555e274f1223f9245526a48267868ff-e-16&quot;, &quot;chunk-5d7f538c5d3017feeaf09d39e949ccdc-e-2&quot;, &quot;chunk-15c033042f1da840c39554ca327f7acd-e-5&quot;, &quot;chunk-dc948aa78d11700723dfefe1c5756cc9-e-10&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-6dac0a4c73567f8946fa9c50957af9ca-e-4" label="Spalling">
        <attvalues>
          <attvalue for="0" value="Spalling" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="Spalling（剥落）是一种物理过程，指材料表面因热应力、机械应力或腐蚀而发生破裂、剥离或成片脱落。在特定语境中，它是在未掺杂材料上，发生在再氧化（Re-oxidation）步骤之前的一种表面层降解现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-6dac0a4c73567f8946fa9c50957af9ca" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;spalling&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6dac0a4c73567f8946fa9c50957af9ca-e-4&quot;, &quot;chunk-f61cdab914bad0a421a3603e3cce6172-e-10&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6dac0a4c73567f8946fa9c50957af9ca-e-6" label="nickel-based bond coat">
        <attvalues>
          <attvalue for="0" value="nickel-based bond coat" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种应用于热障涂层系统中的镍基合金中间层。它位于金属基体与陶瓷面层之间，作用是增强结合力，并在高温下形成一层致密的、起保护作用的热生长氧化铝（TGO），以抵抗氧化和腐蚀。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-6dac0a4c73567f8946fa9c50957af9ca" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6dac0a4c73567f8946fa9c50957af9ca-e-7" label="Acta Materialia">
        <attvalues>
          <attvalue for="0" value="Acta Materialia" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《Acta Materialia》是一本在材料科学领域享有盛誉的国际同行评审期刊。它主要发表关于材料的加工、结构、性能及其内在关系的高水平原创研究。该期刊覆盖所有材料类别，是该领域最具影响力的出版物之一，由爱思唯尔（Elsevier）为Acta Materialia Inc.出版。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;47&quot;, &quot;year&quot;: &quot;1999&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-6dac0a4c73567f8946fa9c50957af9ca" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6dac0a4c73567f8946fa9c50957af9ca-e-7&quot;, &quot;chunk-43f7a3d07847f327a8e75bdf9e852f1d-e-14&quot;, &quot;chunk-df56dbe04dca860f9b208ab9b4878418-e-5&quot;, &quot;chunk-dfe2f1887dc7e61661390cb2b77598da-e-10&quot;, &quot;chunk-40aba596fdad149dc1402c5d9c81d53c-e-4&quot;, &quot;chunk-20fd2faa7ba3f4c68768474b9e5e44a5-e-5&quot;, &quot;chunk-8a8245180b98739270d9b9b4befedd30-e-8&quot;, &quot;chunk-c15f4840811d8961d78c6bb255597276-e-4&quot;, &quot;chunk-b0e7e9ee8763bf537001ff2836e82040-e-1&quot;, &quot;chunk-6f4f79d57f35ab3e77324ff6707d70bf-e-14&quot;, &quot;chunk-8765b343b5bd5551f3f9be47330d68d2-e-8&quot;, &quot;chunk-65335c426f17131b3458c32075ac90d7-e-2&quot;, &quot;chunk-22e09ee7f38295f048d1264e0df1823f-e-4&quot;, &quot;chunk-59a3edbbbcb792361a0376e0da5d6d3f-e-4&quot;, &quot;chunk-ff572be856494622eb9d81badd3c18da-e-4&quot;, &quot;chunk-918e2b930e37d82a44d73a02b4fca57a-e-5&quot;, &quot;chunk-73957e2d0e70c072d7fd407a82b25f99-e-12&quot;, &quot;chunk-988c4d7fcff0bc412e7695d08b17502d-e-9&quot;, &quot;chunk-2439a21f2a1f1a9980c37a01408d1b87-e-2&quot;, &quot;chunk-326ba48df9469bbb4fb6ddd6a5c15eb8-e-14&quot;, &quot;chunk-a584f7fe38f352b7318e0169178d3d01-e-2&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="22" />
        </attvalues>
      </node>
      <node id="chunk-6dac0a4c73567f8946fa9c50957af9ca-e-8" label="A. G. Evans">
        <attvalues>
          <attvalue for="0" value="A. G. Evans" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="A. G. Evans是一位研究员，作为作者之一发表了学术论文《The influence of test method on failure mechanisms and durability of a thermal barrier system》，该论文主要研究测试方法对热障系统失效机制和耐久性的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-6dac0a4c73567f8946fa9c50957af9ca" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6dac0a4c73567f8946fa9c50957af9ca-e-8&quot;, &quot;chunk-20fd2faa7ba3f4c68768474b9e5e44a5-e-2&quot;, &quot;chunk-b0e7e9ee8763bf537001ff2836e82040-e-5&quot;, &quot;chunk-8765b343b5bd5551f3f9be47330d68d2-e-2&quot;, &quot;chunk-69451a0856df90ef7a5f897ca8878dd2-e-12&quot;, &quot;chunk-59a3edbbbcb792361a0376e0da5d6d3f-e-2&quot;, &quot;chunk-ff572be856494622eb9d81badd3c18da-e-2&quot;, &quot;chunk-918e2b930e37d82a44d73a02b4fca57a-e-1&quot;, &quot;chunk-0bff8302b00567f9758ab71ce974ace7-e-5&quot;, &quot;chunk-73957e2d0e70c072d7fd407a82b25f99-e-9&quot;, &quot;chunk-5e278081cfff8673fd80e9618e358fc2-e-6&quot;, &quot;chunk-988c4d7fcff0bc412e7695d08b17502d-e-3&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="17" />
        </attvalues>
      </node>
      <node id="chunk-6dac0a4c73567f8946fa9c50957af9ca-e-9" label="D. R. Mumm">
        <attvalues>
          <attvalue for="0" value="D. R. Mumm" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. R. Mumm是一位学者或研究人员，作为学术论文《The influence of test method on failure mechanisms and durability of a thermal barrier system》的作者之一而知名。该论文研究了测试方法对热障系统的失效机制及耐久性的影响，表明其专业领域为材料科学或相关工程学。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-6dac0a4c73567f8946fa9c50957af9ca" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6dac0a4c73567f8946fa9c50957af9ca-e-9&quot;, &quot;chunk-b0e7e9ee8763bf537001ff2836e82040-e-3&quot;, &quot;chunk-73957e2d0e70c072d7fd407a82b25f99-e-7&quot;, &quot;chunk-8765b343b5bd5551f3f9be47330d68d2-e-5&quot;, &quot;chunk-988c4d7fcff0bc412e7695d08b17502d-e-2&quot;]}]" />
          <attvalue for="9" value="6" />
