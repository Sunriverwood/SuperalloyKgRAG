      <node id="chunk-2b7a9fe88ca8d6ac202cedf8f0e4d421-e-2" label="D. M. Zhu">
        <attvalues>
          <attvalue for="0" value="D. M. Zhu" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="一位研究人员，是关于热障涂层研究论文《Tailored microstructure of EB-PVD 8YSZ thermal barrier coatings》的作者之一。其研究工作涉及通过电子束物理气相沉积法（EB-PVD）调控氧化钇稳定氧化锆（8YSZ）涂层的微观结构。" />
          <attvalue for="3" value="{}" />
