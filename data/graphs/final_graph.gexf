        <attvalues>
          <attvalue for="11" value="IS_DEFINED_BY" />
          <attvalue for="12" value="The misfit strain (εT) is equal to the product of Δα and ΔΤ." />
          <attvalue for="13" value="where the misfit strain, єT, is equal to Δα × ΔΤ" />
