      </node>
      <node id="chunk-2a7c59397b735114b173a918c874616d-e-7" label="United Kingdom Department of Transport">
        <attvalues>
          <attvalue for="0" value="United Kingdom Department of Transport" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="英国运输部（Department for Transport）是负责英国交通运输系统的政府部门。其职责涵盖公路、铁路、航空和海事领域，负责制定交通政策、管理运输网络和进行安全监管。例如，它负责主导或发布如此次空难事故调查类的官方报告。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-2a7c59397b735114b173a918c874616d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2a7c59397b735114b173a918c874616d-e-8" label="Her Majesty's Stationery Office">
        <attvalues>
          <attvalue for="0" value="Her Majesty's Stationery Office" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="女王陛下文书办公室（Her Majesty's Stationery Office, HMSO）是英国政府的一个部门，长期担任英国王室与议会的官方出版机构。其主要职责是印刷和发行所有政府官方出版物，包括议会法案、官方公报以及各类调查报告，例如关于1985年曼彻斯特机场空难的事故报告。" />
          <attvalue for="3" value="{&quot;location&quot;: &quot;London&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-2a7c59397b735114b173a918c874616d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2a7c59397b735114b173a918c874616d-e-9" label="D. Kondepudi">
        <attvalues>
          <attvalue for="0" value="D. Kondepudi" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. Kondepudi是一位作家，其代表作是热力学领域的专著《现代热力学——从热机到耗散结构》(Modern Thermodynamics – From Heat Engines to Dissipative Structures)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-2a7c59397b735114b173a918c874616d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2a7c59397b735114b173a918c874616d-e-10" label="I. Prigogine">
        <attvalues>
          <attvalue for="0" value="I. Prigogine" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="伊利亚·普里高津（Ilya Prigogine），比利时物理化学家，1977年诺贝尔化学奖得主。他以在非平衡态热力学领域的开创性工作而闻名，特别是提出了耗散结构理论，深刻地解释了开放系统如何从无序中自发形成有序结构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-2a7c59397b735114b173a918c874616d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2a7c59397b735114b173a918c874616d-e-13" label="F. R. N. Nabarro">
        <attvalues>
          <attvalue for="0" value="F. R. N. Nabarro" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="弗兰克·纳巴罗（Frank Nabarro, 1916-2006），英裔南非固态物理学家，英国皇家学会院士。他是晶体位错理论的先驱之一，在材料蠕变等领域做出了开创性贡献，著名的“纳巴罗-希林蠕变”机制即以其命名。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-2a7c59397b735114b173a918c874616d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="431" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-2a7c59397b735114b173a918c874616d-e-14" label="H. L. de Villiers">
        <attvalues>
          <attvalue for="0" value="H. L. de Villiers" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="一位作者。由于该名称仅出现于一则不完整的引文中，其确切身份、具体作品及生平信息均无法确定，可能指代多位姓名缩写或姓氏相同的个体。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-2a7c59397b735114b173a918c874616d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="432" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-9e6a9c9670a733534cf4cbfaf5e54d18-e-1" label="I. Prigogine and D. Kondepudi">
        <attvalues>
          <attvalue for="0" value="I. Prigogine and D. Kondepudi" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="伊利亚·普里戈金（Ilya Prigogine）与迪利普·孔德普迪（Dilip Kondepudi），二人是物理学专著《现代热力学：从热机到耗散结构》的合著者。普里戈金是比利时物理化学家，因其在耗散结构领域的开创性研究荣获1977年诺贝尔化学奖。孔德普迪是专注于热力学与复杂系统的物理学家。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-9e6a9c9670a733534cf4cbfaf5e54d18" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9e6a9c9670a733534cf4cbfaf5e54d18-e-2" label="Modern Thermodynamics: From Heat Engines to Dissipative Structures">
        <attvalues>
          <attvalue for="0" value="Modern Thermodynamics: From Heat Engines to Dissipative Structures" />
          <attvalue for="1" value="Document" />
          <attvalue for="2" value="《现代热力学：从热机到耗散结构》是由I. Prigogine与D. Kondepudi合著的学术专著，于1998年由Wiley出版社出版。该书系统地阐述了从经典热力学到非平衡态热力学及耗散结构理论，是该领域的一部重要著作。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1998&quot;, &quot;location&quot;: &quot;Chichester, UK&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-9e6a9c9670a733534cf4cbfaf5e54d18" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Modern Thermodynamics – From Heat Engines to Dissipative Structures&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2a7c59397b735114b173a918c874616d-e-11&quot;, &quot;chunk-9e6a9c9670a733534cf4cbfaf5e54d18-e-2&quot;]}]" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-9e6a9c9670a733534cf4cbfaf5e54d18-e-4" label="F. R. N. Nabarro and H. L. de Villiers">
        <attvalues>
          <attvalue for="0" value="F. R. N. Nabarro and H. L. de Villiers" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="F. R. N. Nabarro与H. L. de Villiers是物理学家，两人合作撰写了材料科学领域的经典著作《蠕变物理学》(The Physics of Creep)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-9e6a9c9670a733534cf4cbfaf5e54d18" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="128" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9e6a9c9670a733534cf4cbfaf5e54d18-e-5" label="The Physics of Creep">
        <attvalues>
          <attvalue for="0" value="The Physics of Creep" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《The Physics of Creep》是一本由 F. R. N. Nabarro 和 H. L. de Villiers 合著的学术著作。该书于1995年由国际知名出版商 Taylor and Francis 首次出版，专注于探讨材料蠕变现象的物理学原理。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1995&quot;, &quot;location&quot;: &quot;London&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-9e6a9c9670a733534cf4cbfaf5e54d18" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="128" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9e6a9c9670a733534cf4cbfaf5e54d18-e-6" label="Taylor and Francis">
        <attvalues>
          <attvalue for="0" value="Taylor and Francis" />
          <attvalue for="1" value="Publisher" />
          <attvalue for="2" value="泰勒-弗朗西斯（Taylor &amp; Francis）是一家总部位于英国的国际学术出版商。该公司出版大量学术期刊和书籍，是全球领先的学术出版机构之一，隶属于英富曼集团（Informa）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-9e6a9c9670a733534cf4cbfaf5e54d18" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="128" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9e6a9c9670a733534cf4cbfaf5e54d18-e-7" label="O. D. Sherby and P. M. Burke">
        <attvalues>
          <attvalue for="0" value="O. D. Sherby and P. M. Burke" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="O. D. Sherby与P. M. Burke是两位学者，他们因共同撰写了关于材料科学的经典论文《Mechanical behaviour of crystalline solids at elevated temperatures》而知名，该文系统阐述了晶体固体在高温环境下的力学行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-9e6a9c9670a733534cf4cbfaf5e54d18" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9e6a9c9670a733534cf4cbfaf5e54d18-e-7&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9e6a9c9670a733534cf4cbfaf5e54d18-e-8" label="Mechanical behaviour of crystalline solids at elevated temperatures">
        <attvalues>
          <attvalue for="0" value="Mechanical behaviour of crystalline solids at elevated temperatures" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《高温下晶体固体的力学行为》(Mechanical behaviour of crystalline solids at elevated temperatures) 是一篇由学者O. D. Sherby与P. M. Burke合著的科学论文。该论文于1967年发表在材料科学领域的权威学术期刊《材料科学进展》(Progress in Materials Science)上。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1967&quot;, &quot;pages&quot;: &quot;325–390&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-9e6a9c9670a733534cf4cbfaf5e54d18" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9e6a9c9670a733534cf4cbfaf5e54d18-e-8&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9e6a9c9670a733534cf4cbfaf5e54d18-e-10" label="H. J. Frost and M. F. Ashby">
        <attvalues>
          <attvalue for="0" value="H. J. Frost and M. F. Ashby" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="美国材料科学家H. J. Frost与英国材料科学家M. F. Ashby的合称。他们共同撰写了材料科学领域的经典著作《变形机制图：金属与陶瓷的塑性与蠕变》，该书系统阐明了材料在不同条件下的力学行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-9e6a9c9670a733534cf4cbfaf5e54d18" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9e6a9c9670a733534cf4cbfaf5e54d18-e-10&quot;]}]" />
          <attvalue for="9" value="129" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9e6a9c9670a733534cf4cbfaf5e54d18-e-11" label="Deformation-Mechanism Maps: The Plasticity and Creep of Metals and Ceramics">
        <attvalues>
          <attvalue for="0" value="Deformation-Mechanism Maps: The Plasticity and Creep of Metals and Ceramics" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由H. J. 弗罗斯特(H. J. Frost)与M. F. 阿什比(M. F. Ashby)合著的材料科学领域经典专著，1982年由佩加蒙出版社(Pergamon Press)出版。该书系统阐述了变形机制图理论，并用其分析和预测金属与陶瓷在不同应力及温度条件下的塑性与蠕变行为。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1982&quot;, &quot;location&quot;: &quot;Oxford&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-9e6a9c9670a733534cf4cbfaf5e54d18" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9e6a9c9670a733534cf4cbfaf5e54d18-e-11&quot;, &quot;chunk-833b212eb3a569521f9a95be24874ec1-e-1&quot;]}]" />
          <attvalue for="9" value="129" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9e6a9c9670a733534cf4cbfaf5e54d18-e-12" label="Pergamon Press">
        <attvalues>
          <attvalue for="0" value="Pergamon Press" />
          <attvalue for="1" value="Publisher" />
          <attvalue for="2" value="帕加马出版社（Pergamon Press）是一家总部位于英国牛津的著名学术出版商，由罗伯特·麦克斯韦创立。它专注于出版科学、技术和医学领域的书籍与期刊，在相关领域有重要影响力。1991年被爱思唯尔（Elsevier）收购，现为其旗下重要印记。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-9e6a9c9670a733534cf4cbfaf5e54d18" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9e6a9c9670a733534cf4cbfaf5e54d18-e-12&quot;, &quot;chunk-833b212eb3a569521f9a95be24874ec1-e-2&quot;]}]" />
          <attvalue for="9" value="129" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-833b212eb3a569521f9a95be24874ec1-e-3" label="A. M. Brown">
        <attvalues>
          <attvalue for="0" value="A. M. Brown" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="A. M. Brown是一位学者或研究人员，作为作者之一参与撰写了题为《Correlations for diffusion coefficients》的学术文章。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-833b212eb3a569521f9a95be24874ec1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="91" />
