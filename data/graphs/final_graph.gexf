        <attvalues>
          <attvalue for="11" value="REQUIRED_IN" />
          <attvalue for="12" value="Minimum property levels are required to be demonstrated in the bore region of a component." />
          <attvalue for="13" value="Slowly, the requirements expanded to include demonstration of minimum property levels in both bore and rim regions." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-a1650d74269b8238062c417df547e98e" />
          <attvalue for="16" value="0.000496031746031746" />
