          <attvalue for="9" value="40" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7d1c0c8031d67aa9cde5e31731da960b-e-7" label="G">
        <attvalues>
          <attvalue for="0" value="G" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="G是一个由变量R定义的变量，同时它也是决定过冷度(AT)的三个关键自变量之一。" />
          <attvalue for="3" value="{}" />
