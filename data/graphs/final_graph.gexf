      <edge source="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-10" target="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-7" id="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-r-5" weight="4.0">
        <attvalues>
          <attvalue for="11" value="IS_MECHANISM_OF" />
          <attvalue for="12" value="Crystallographic cracking is a mechanism of fatigue crack growth." />
          <attvalue for="13" value="These observations are consistent with the mechanisms of fatigue crack growth which are agreed upon [23,26]: at low temperatures, high strain rates and low AK, there is a strong tendency for crystallographic cracking on {111} planes" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa" />
          <attvalue for="16" value="0.0011337868480725624" />
          <attvalue for="17" value="0.2673469387755102" />
        </attvalues>
      </edge>
      <edge source="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-10" target="chunk-795763ad7f38bb8adeb25f9d763ce8dd-e-4" id="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-r-9" weight="5.0">
        <attvalues>
          <attvalue for="11" value="OCCURS_ON" />
          <attvalue for="12" value="Crystallographic cracking occurs on {111} planes." />
          <attvalue for="13" value="there is a strong tendency for crystallographic cracking on {111} planes" />
          <attvalue for="14" value="r-9" />
          <attvalue for="15" value="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa" />
          <attvalue for="17" value="0.4" />
        </attvalues>
