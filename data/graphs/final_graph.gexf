        <attvalues>
          <attvalue for="11" value="EQUALS" />
          <attvalue for="12" value="A core assumption of the specified ideal cycle is that the compression work equals the turbine work." />
          <attvalue for="13" value="Assuming an ideal cycle such that the compression work equals the turbine work, determine the rate of useful working (or specific power) available to provide a propulsive force." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-35e59a51ed8121212e1426f0053ba534" />
          <attvalue for="16" value="2.1938484489491466e-05" />
