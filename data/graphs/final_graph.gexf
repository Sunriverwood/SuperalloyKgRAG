      <node id="chunk-a584f7fe38f352b7318e0169178d3d01-e-8" label="The Jet Engine, 4th edn">
        <attvalues>
          <attvalue for="0" value="The Jet Engine, 4th edn" />
          <attvalue for="1" value="Book" />
          <attvalue for="2" value="《The Jet Engine》第四版是由世界著名航空发动机制造商罗尔斯·罗伊斯公司出版的权威技术著作。该书系统性地阐述了喷气发动机的工作原理、结构设计与制造技术，是航空航天领域的经典参考书籍。" />
          <attvalue for="3" value="{&quot;edition&quot;: &quot;4th&quot;, &quot;year&quot;: &quot;1992&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-a584f7fe38f352b7318e0169178d3d01" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="28" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a584f7fe38f352b7318e0169178d3d01-e-9" label="The Technical Publications Department, Rolls-Royce plc">
        <attvalues>
          <attvalue for="0" value="The Technical Publications Department, Rolls-Royce plc" />
          <attvalue for="1" value="Publisher" />
          <attvalue for="2" value="隶属于罗尔斯·罗伊斯公司（Rolls-Royce plc）的内部技术出版部门。作为官方出版方，该部门负责制作与发行公司产品（尤其是航空发动机）相关的技术手册、服务通告等专业文档。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
