      <node id="chunk-b18667fadfdf7cfdf2bd35cc10bf1f84-e-9" label="The Australian Transport Safety Bureau">
        <attvalues>
          <attvalue for="0" value="The Australian Transport Safety Bureau" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="澳大利亚运输安全局（ATSB）是澳大利亚的联邦政府机构，作为独立的国家级运输安全调查机构，负责调查航空、海事及铁路运输领域内的安全事故和事件。其主要职能是通过发布技术分析报告等方式查明事发因素，并提出安全建议，以改善运输安全，防止事故再次发生。" />
          <attvalue for="3" value="{&quot;location&quot;: &quot;Canberra, Australia&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-b18667fadfdf7cfdf2bd35cc10bf1f84" />
          <attvalue for="6" value="true" />
