      <node id="chunk-cb57093a6357773efc0ab02b57f76fa1-e-16" label="Oak Ridge National Laboratory">
        <attvalues>
          <attvalue for="0" value="Oak Ridge National Laboratory" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="橡树岭国家实验室（Oak Ridge National Laboratory）是美国能源部下属的一个多学科科学与技术国家实验室，位于田纳西州橡树岭。它是美国最大的科学与能源研究机构，专注于中子科学、高性能计算、先进材料和核能等领域的研究，以应对国家关键的科学与安全挑战。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-cb57093a6357773efc0ab02b57f76fa1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-cb57093a6357773efc0ab02b57f76fa1-e-18" label="Dr Jim Smialek">
        <attvalues>
          <attvalue for="0" value="Dr Jim Smialek" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="斯米亚莱克博士（Dr. Jim Smialek）是一位隶属于美国国家航空航天局（NASA）的材料科学家。他作为NASA格伦研究中心的资深研究工程师，专注于航空航天推进系统所需的高温材料、超合金及其氧化行为等领域的研究，是该领域的知名专家。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-18" />
          <attvalue for="5" value="chunk-cb57093a6357773efc0ab02b57f76fa1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cb57093a6357773efc0ab02b57f76fa1-e-19" label="Dr Tim Gabb">
        <attvalues>
          <attvalue for="0" value="Dr Tim Gabb" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="蒂姆·加布博士（Dr. Tim Gabb）是一位隶属于美国国家航空航天局（NASA）的科学家或专家。他凭借其博士级的专业知识，为该机构的太空探索与科学研究项目做出贡献。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-19" />
