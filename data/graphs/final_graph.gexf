      <edge source="chunk-dc663680c2568caff49f127612995631-e-3" target="chunk-dc663680c2568caff49f127612995631-e-4" id="chunk-dc663680c2568caff49f127612995631-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CAUSES_DISINTEGRATION_OF" />
          <attvalue for="12" value="The action of the gas stream causes the molten metal stream to disintegrate." />
          <attvalue for="13" value="the action of which causes its disintegration into spherical particles of diameter 30 to 300 µm." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-dc663680c2568caff49f127612995631" />
          <attvalue for="16" value="0.001176470588235294" />
