      </node>
      <node id="chunk-54db0fe1dd89cd8e8ede6b8d3623ba34-e-3" label="r">
        <attvalues>
          <attvalue for="0" value="r" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="一个通常表示半径（radius）的变量。在当前上下文中，它被用作定义实体 L 的关键参数，以确定其几何特性或计算范围。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-54db0fe1dd89cd8e8ede6b8d3623ba34" />
