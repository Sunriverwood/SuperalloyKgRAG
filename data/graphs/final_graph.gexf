      <node id="chunk-819db6cd818e9e8d5c81db94051547db-e-4" label="W. Y. Lee">
        <attvalues>
          <attvalue for="0" value="W. Y. Lee" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="W. Y. Lee是一名学者，是学术论文《Effect of Pt incorporation on the isothermal oxidation behaviour of chemical vapour deposition aluminide coatings》的作者之一。该论文主要研究在化学气相沉积铝化物涂层中，铂（Pt）的加入对其等温氧化行为产生的影响。" />
          <attvalue for="3" value="{}" />
