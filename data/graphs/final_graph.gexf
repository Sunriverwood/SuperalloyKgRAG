        <attvalues>
          <attvalue for="11" value="CONTAINS" />
          <attvalue for="12" value="Group III alloys possess appreciable concentrations of chromium." />
          <attvalue for="13" value="Group III alloys - which possess appreciable concentrations of both chromium and aluminium" />
