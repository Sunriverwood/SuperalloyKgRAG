        <attvalues>
          <attvalue for="11" value="LEADS_TO" />
          <attvalue for="12" value="Micromechanical deformation modes lead to the cutting off process associated with rupture." />
          <attvalue for="13" value="...and the micromechanical deformation modes which lead to the cutting o" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-561d2449c805db1de389831a67f53313" />
          <attvalue for="16" value="0.00013061650992685477" />
