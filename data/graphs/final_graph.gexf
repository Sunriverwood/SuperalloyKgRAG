        <attvalues>
          <attvalue for="11" value="HAS_POTENTIAL_APPLICATION_IN" />
          <attvalue for="12" value="Fourth-generation single-crystal superalloys have acknowledged potential benefits but have not yet been applied in gas turbine engines." />
          <attvalue for="13" value="At the time of writing, these fourth-generation single-crystal superalloys have yet to find application in gas turbine engines, although their potential benefit is acknowledged." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-3840a842bb1a54d4d273056bed0dac49" />
          <attvalue for="16" value="0.0005713197486193107" />
          <attvalue for="17" value="0.4003427918491716" />
        </attvalues>
      </edge>
      <edge source="chunk-3840a842bb1a54d4d273056bed0dac49-e-3" target="chunk-3840a842bb1a54d4d273056bed0dac49-e-1" id="chunk-3840a842bb1a54d4d273056bed0dac49-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HINDERS_APPLICATION_OF" />
          <attvalue for="12" value="The cost of fourth-generation single-crystal superalloys is a reason for the reluctance to use them in the latest designs." />
          <attvalue for="13" value="The current reluctance to insert them into the latest designs is due to their cost and density; see Figure 6.4." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-3840a842bb1a54d4d273056bed0dac49" />
          <attvalue for="16" value="0.0008252396368945598" />
