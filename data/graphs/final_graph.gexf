      <node id="chunk-b0e7e9ee8763bf537001ff2836e82040-e-2" label="S. Darzens">
        <attvalues>
          <attvalue for="0" value="S. Darzens" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="S. Darzens是一位学者或研究人员。根据已知信息，他/她是关于铂改性镍铝基涂层材料的科学论文《On the microstructural development in platinum-modified nickel-aluminide bond coats》的合著者之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
