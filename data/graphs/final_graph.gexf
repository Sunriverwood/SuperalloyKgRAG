    <nodes>
      <node id="chunk-dc7beb2c110a0e2f253f174dddd75d00-e-1" label="Roger C. Reed">
        <attvalues>
          <attvalue for="0" value="Roger C. Reed" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="罗杰·C·里德 (Roger C. Reed) 是一位材料科学领域的专家和学者。他因撰写了该领域的权威著作《高温合金：基础与应用》(The Superalloys: Fundamentals and Applications) 而广为人知，该书是高温合金研究的重要教科书和参考资料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-dc7beb2c110a0e2f253f174dddd75d00" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;ROGER C. REED&quot;, &quot;Roger Reed&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dc7beb2c110a0e2f253f174dddd75d00-e-1&quot;, &quot;chunk-7e597a71b078bd5a96ed4a1909874041-e-2&quot;, &quot;chunk-8c60d2526947a5ab3509fae533f5e115-e-4&quot;, &quot;chunk-562ab8120c986d32d5b96c3da5071063-e-1&quot;]}]" />
          <attvalue for="9" value="30" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dc7beb2c110a0e2f253f174dddd75d00-e-3" label="Superalloys">
        <attvalues>
          <attvalue for="0" value="Superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="超级合金（Superalloys）是一类专为极端高温环境设计的特种金属材料。其核心特性是在高温下仍具备卓越的机械强度和抗化学降解（如氧化、腐蚀）能力。基于这些特性，它们成为制造燃气轮机发动机热端部件的关键材料。其发展与设计遵循先进的冶金学原理。" />
          <attvalue for="3" value="{&quot;property&quot;: &quot;unique&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-dc7beb2c110a0e2f253f174dddd75d00" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Land-based turbine systems&quot;, &quot;Superalloy&quot;, &quot;common superalloys&quot;, &quot;high temperature alloys&quot;, &quot;spurious grains&quot;, &quot;superalloy components&quot;, &quot;superalloys&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dc7beb2c110a0e2f253f174dddd75d00-e-3&quot;, &quot;chunk-d6bdb664cd0308fc87bae418c9eaeb6d-e-1&quot;, &quot;chunk-43df518934138ca7d680747b9c908d8b-e-1&quot;, &quot;chunk-a4b011eeea4fbc315a0833a25a29121a-e-4&quot;, &quot;chunk-66ba88a6026c55d38eeb24aad6777073-e-1&quot;, &quot;chunk-03cfea53fa6d7edca4135b4a86169a55-e-5&quot;, &quot;chunk-6368a72cf89a3485f9379d1f9ae026ed-e-1&quot;, &quot;chunk-77690a63edc0814cc6c868e5e4d95012-e-3&quot;, &quot;chunk-b3a801531784aa7ab699c1b1f24edd83-e-1&quot;, &quot;chunk-97a0a28a657f3432d5d667cd779eea4b-e-1&quot;, &quot;chunk-86d807c2e09f9a36246a74f6393dba7c-e-1&quot;, &quot;chunk-6e0983cf58b9c26b71630200f3b8184c-e-4&quot;, &quot;chunk-30207adabf4599d8a652adb7ed7362dc-e-7&quot;, &quot;chunk-21326bde35e345c13df547ee17d7383b-e-1&quot;, &quot;chunk-44ba0b547d89e889a875ab5cd81995c8-e-5&quot;, &quot;chunk-dca55a5d4cb2d2d1e2f4de0e571af023-e-8&quot;, &quot;chunk-a2c3fd11f3ed7bc596943938c9fdae5d-e-1&quot;, &quot;chunk-db0aaf39ddd68495034176be78a2d349-e-5&quot;, &quot;chunk-d9d4d301605356b62bd308e19ed1fd05-e-1&quot;, &quot;chunk-5a639fd67a832fc8cf42f11056698bcf-e-4&quot;, &quot;chunk-c87d6224a6dfa2402ba4ce5b82dd066c-e-2&quot;, &quot;chunk-e00b2aac6b639de957a0e986581a8e1c-e-2&quot;, &quot;chunk-b2761392d08e0abe002c7c4fcb313ba7-e-3&quot;, &quot;chunk-d13800606f8047850e1ad6f9b8f895ce-e-6&quot;, &quot;chunk-becba5847060251232d4df2b31913a6b-e-1&quot;, &quot;chunk-bccef826d0431af78a9477b3c9f26b2b-e-1&quot;, &quot;chunk-d04c85025e4505eb3f79316f3a28ed39-e-1&quot;, &quot;chunk-97a0a28a657f3432d5d667cd779eea4b-e-6&quot;, &quot;chunk-86d807c2e09f9a36246a74f6393dba7c-e-2&quot;, &quot;chunk-0365022a18454a90e4598122a8f449ca-e-9&quot;, &quot;chunk-518564762410dd52d42b1aa0d775ef76-e-2&quot;, &quot;chunk-c07d98a8c6e8b07242a68bd712fcfe4c-e-6&quot;, &quot;chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6-e-6&quot;, &quot;chunk-ecbdb2f69e15219fedba1f6f77faf2ed-e-6&quot;, &quot;chunk-e01b059cc1c9a00298a478f93a9ec05a-e-8&quot;, &quot;chunk-49678bb9dd21687268c5616ea6e657b4-e-4&quot;, &quot;chunk-3580e24626fc58694eb8b9e80eb9ed69-e-2&quot;, &quot;chunk-89e037006a60ff84d312fb1878f7b7ba-e-2&quot;, &quot;chunk-c66ff8a529b9512996f0b3af456f00ce-e-4&quot;, &quot;chunk-8031eb636b002393280031950b878895-e-10&quot;, &quot;chunk-5d1954b761cf7718ff2558f9e10a2fac-e-12&quot;, &quot;chunk-fbbf41abcd4950c59415caeec768db40-e-15&quot;, &quot;chunk-f7942340b7bda97e3a76f6ceb1d90c75-e-6&quot;, &quot;chunk-5518f1c4ab4a7b4e100f841b3b90e572-e-9&quot;, &quot;chunk-86425bad56c0d52ed7246eff0fe06dd8-e-4&quot;, &quot;chunk-ec1da0ebfe72b58a50620a5a71c6abf7-e-10&quot;, &quot;chunk-b7b41d99b7968db6938fc41d4745dc0d-e-3&quot;, &quot;chunk-0625d83d7200f989528119d9ba61865a-e-7&quot;, &quot;chunk-9c5b2b7dade746247326fc0930d280e0-e-2&quot;, &quot;chunk-44260d4b7de8c9a00040496e0aad271b-e-7&quot;, &quot;chunk-e6c8cf32e29caa40f92e13ee8d574c84-e-1&quot;, &quot;chunk-6961c93f48e22019dc09686be94a57fd-e-1&quot;, &quot;chunk-9eb2cadb717d72e1940b942340621320-e-6&quot;, &quot;chunk-bf906ca2cbc8d790d36fdc40a9295b24-e-1&quot;, &quot;chunk-5abc3c05849dadfca952537bf1c8dc41-e-7&quot;, &quot;chunk-0ded602080ef74e810480d8e88484e82-e-4&quot;, &quot;chunk-ee8fa246fa35655243004b46a963f27f-e-1&quot;, &quot;chunk-a11b164392ee72e1727a4debab9eb766-e-4&quot;, &quot;chunk-8a91b63add4adbc77d4752d41b7c75aa-e-4&quot;, &quot;chunk-c8fee299c7ba0eef0fb9057ffd13203c-e-1&quot;, &quot;chunk-c8fee299c7ba0eef0fb9057ffd13203c-e-2&quot;, &quot;chunk-64f0b642dc984a92646a132ee856bc18-e-7&quot;, &quot;chunk-b7b41d99b7968db6938fc41d4745dc0d-e-7&quot;, &quot;chunk-323f9e8ea85610f0279e242666644995-e-6&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="51" />
        </attvalues>
      </node>
