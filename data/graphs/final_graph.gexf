          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-918e2b930e37d82a44d73a02b4fca57a-e-9&quot;]}]" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-0bff8302b00567f9758ab71ce974ace7-e-2" label="X. Chen">
        <attvalues>
          <attvalue for="0" value="X. Chen" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="X. Chen是一位学者，撰写了关于热障系统外物损伤的学术论文《Foreign object damage in a thermal barrier system: mechanisms and simulations》。" />
          <attvalue for="3" value="{}" />
