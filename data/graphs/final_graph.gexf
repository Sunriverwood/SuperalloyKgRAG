      </node>
      <node id="chunk-b0e7e9ee8763bf537001ff2836e82040-e-6" label="Observations and analysis of the influence of phase transformations on the instability of the thermally grown oxide in a thermal barrier system">
        <attvalues>
          <attvalue for="0" value="Observations and analysis of the influence of phase transformations on the instability of the thermally grown oxide in a thermal barrier system" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Observations and analysis of the influence of phase transformations on the instability of the thermally grown oxide in a thermal barrier system》是一篇由S. Darzens、D. R. Mumm、D. R. Clarke及A. G. Evans合著的科学论文。该文发表于学术期刊《冶金与材料汇刊》(Metallurgical and Materials Transactions)，内容聚焦于研究相变对热障涂层系统中热生长氧化物不稳定性的影响。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2003&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-b0e7e9ee8763bf537001ff2836e82040" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b0e7e9ee8763bf537001ff2836e82040-e-6&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-b0e7e9ee8763bf537001ff2836e82040-e-7" label="Metallurgical and Materials Transactions">
        <attvalues>
          <attvalue for="0" value="Metallurgical and Materials Transactions" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《冶金与材料汇刊》(Metallurgical and Materials Transactions)是一本专注于冶金学和材料科学的著名同行评审学术期刊。该期刊由TMS与ASM International联合出版，分为A辑（物理冶金与材料科学）和B辑（过程冶金与材料加工科学），发表相关领域的原创研究。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;34A&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-b0e7e9ee8763bf537001ff2836e82040" />
          <attvalue for="6" value="true" />
