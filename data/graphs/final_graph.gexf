      <node id="chunk-54db0fe1dd89cd8e8ede6b8d3623ba34-e-7" label="h (geometric variable for arc/sagitta)">
        <attvalues>
          <attvalue for="0" value="h (geometric variable for arc/sagitta)" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="h是一个由半圆定义的几何变量，通常指其矢高。在远小于半径R（h ≪ R）的假设下，它作为关键参数，出现在与λ₁相关的方程中，并用于对变量A进行近似计算。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-54db0fe1dd89cd8e8ede6b8d3623ba34" />
          <attvalue for="6" value="true" />
