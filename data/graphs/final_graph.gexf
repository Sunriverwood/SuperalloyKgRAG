      <node id="chunk-326ba48df9469bbb4fb6ddd6a5c15eb8-e-13" label="structural materials for aerospace systems">
        <attvalues>
          <attvalue for="0" value="structural materials for aerospace systems" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="航空航天结构材料是指用于制造飞机、航天器及相关系统承力构件的一类先进材料。这类材料的核心要求是具备高强度重量比、优异的抗疲劳性、耐腐蚀性以及在极端温度下的稳定性。主要包括高性能铝合金、钛合金、高温合金和先进复合材料，是保障航空航天系统安全与性能的关键。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-326ba48df9469bbb4fb6ddd6a5c15eb8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
