          <attvalue for="9" value="23" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e408a73fcde801378877f777a7391169-e-8" label="Superalloys 1984">
        <attvalues>
          <attvalue for="0" value="Superalloys 1984" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Superalloys 1984》是一部关于高温合金的会议论文集，由M. Gell、W. B. Kent和R. H. Bricknell共同编辑。该论文集收录了相关领域的学术著作，由美国矿物、金属与材料学会冶金学会（The Metallurgical Society of AIME）于1984年出版。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1984&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-e408a73fcde801378877f777a7391169" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e408a73fcde801378877f777a7391169-e-8&quot;, &quot;chunk-6eb9964e0070cc2b73d942919084bb21-e-1&quot;]}]" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-e408a73fcde801378877f777a7391169-e-10" label="N. P. Padture">
        <attvalues>
          <attvalue for="0" value="N. P. Padture" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="N. P. Padture是一位材料科学家与学者，研究领域为热障涂层等先进陶瓷材料。他是该领域重要学术论文《燃气轮机应用的热障涂层》(Thermal barrier coatings for gas-turbine applications) 的作者之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-e408a73fcde801378877f777a7391169" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e408a73fcde801378877f777a7391169-e-11" label="E. H. Jordan">
        <attvalues>
          <attvalue for="0" value="E. H. Jordan" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="E. Jordan是一位学者，作为作者之一撰写了学术论文《Bond strength, bond stress and spallation mechanisms of thermal barrier coatings》。其研究主要关注材料科学领域中热障涂层的结合强度、应力与剥落机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-e408a73fcde801378877f777a7391169" />
          <attvalue for="6" value="true" />
