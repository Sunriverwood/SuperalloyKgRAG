      <node id="chunk-5508d220f18b6461ca52c2a3d80737ec-e-6" label="D. S. Rickerby, S. R. Bell and R. G. Wing">
        <attvalues>
          <attvalue for="0" value="D. S. Rickerby, S. R. Bell and R. G. Wing" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="D. S. Rickerby、S. R. Bell 和 R. G. Wing 是一组发明人。他们是1997年被授予的美国专利 US 5,667,663 的共同署名者，该专利是确认他们作者身份和技术贡献的核心依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-5508d220f18b6461ca52c2a3d80737ec" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5508d220f18b6461ca52c2a3d80737ec-e-8" label="superalloy article">
        <attvalues>
          <attvalue for="0" value="superalloy article" />
          <attvalue for="1" value="Substrate" />
          <attvalue for="2" value="一种由高温合金制成的部件，作为承受热障涂层的基材。该涂层旨在为基材在高温工作环境下提供隔热保护，从而提升其性能并延长服役寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-5508d220f18b6461ca52c2a3d80737ec" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7027df3183981418ce449ee96ef327a1-e-1" label="US Patent 5,667,663">
        <attvalues>
          <attvalue for="0" value="US Patent 5,667,663" />
          <attvalue for="1" value="Patent" />
          <attvalue for="2" value="一项于1997年授予的美国专利（专利号：5,667,663），由发明人 D. S. Rickerby、S. R. Bell 和 R. G. Wing 共同撰写。该专利公开了一种用于施加和形成热障涂层的方法和技术。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1997&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-7027df3183981418ce449ee96ef327a1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;US Patent 5,667,663 (1997)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5508d220f18b6461ca52c2a3d80737ec-e-9&quot;, &quot;chunk-7027df3183981418ce449ee96ef327a1-e-1&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-7027df3183981418ce449ee96ef327a1-e-2" label="Ni-base superalloy article">
        <attvalues>
          <attvalue for="0" value="Ni-base superalloy article" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种特殊的单晶镍基高温合金制品。该材料的化学成分、微观结构、制造方法和特定用途等关键特征，在美国专利US 5,667,663中有详细的定义和说明，通常应用于航空发动机涡轮叶片等高温高应力环境。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-7027df3183981418ce449ee96ef327a1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7027df3183981418ce449ee96ef327a1-e-5" label="chemical vapour deposition aluminide coatings">
        <attvalues>
          <attvalue for="0" value="chemical vapour deposition aluminide coatings" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="一种通过化学气相沉积（CVD）工艺制备的防护涂层，主要成分为金属间铝化物。该涂层常通过掺入铂（Pt）进行改性，以提升其在航空发动机等高温应用中的抗氧化与抗腐蚀性能。" />
          <attvalue for="3" value="{&quot;deposition_method&quot;: &quot;chemical vapour deposition&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-7027df3183981418ce449ee96ef327a1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="221" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7027df3183981418ce449ee96ef327a1-e-6" label="Pt incorporation">
        <attvalues>
          <attvalue for="0" value="Pt incorporation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种将铂（Pt）元素通过电镀等方法引入材料表面，以制备铂改性铝化物涂层的工艺过程。该过程旨在通过改变涂层相结构，显著提升其高温抗氧化与抗腐蚀性能，从而影响其等温行为。" />
          <attvalue for="3" value="{&quot;element&quot;: &quot;Pt&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-7027df3183981418ce449ee96ef327a1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7027df3183981418ce449ee96ef327a1-e-6&quot;, &quot;chunk-23667ab4826d0039e851f5cb53aa5455-e-7&quot;]}]" />
          <attvalue for="9" value="221" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7027df3183981418ce449ee96ef327a1-e-7" label="Chemical vapour deposition aluminide coating">
        <attvalues>
          <attvalue for="0" value="Chemical vapour deposition aluminide coating" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《冶金与材料汇刊A》（Metallurgical and Materials Transactions A）是一本专注于物理冶金学和材料科学的国际同行评审期刊。“32A”特指该期刊于2001年出版的第32卷A部分，该卷收录了Y. Zhang等人发表的研究论文。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2001&quot;, &quot;volume&quot;: &quot;32A&quot;, &quot;pages&quot;: &quot;1727–1741&quot;}" />
