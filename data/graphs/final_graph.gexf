        <attvalues>
          <attvalue for="11" value="EXHIBITS" />
          <attvalue for="12" value="Pure nickel exhibits anisotropy, as its stiffness varies significantly between different crystallographic directions." />
          <attvalue for="13" value="Using the values of Sij for pure nickel, one can show that the (100) direction is the least stiff, (111) the stiffest (about 2.4 times stiffer than (100)), with (110) between the two limits." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-d4ec865719f1815d38483ef812cf9ed2" />
          <attvalue for="16" value="0.002886002886002886" />
