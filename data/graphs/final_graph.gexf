        <attvalues>
          <attvalue for="11" value="RESOLVES_ISSUE_OF" />
          <attvalue for="12" value="The bypass design is presented as the solution to the problem of Specific Fuel Consumption being too large." />
          <attvalue for="13" value="The only way around this dilemma is to use a bypass design." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-cdeb193bdb0bc0bd0987151c84c2d210" />
          <attvalue for="16" value="0.01842467055709125" />
