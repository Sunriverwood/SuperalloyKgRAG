        <attvalues>
          <attvalue for="11" value="INCREASES" />
          <attvalue for="12" value="Employing air cooling instead of furnace cooling increased the FCP rate by a factor of 4." />
          <attvalue for="13" value="the FCP rate increased by about a factor of 4 at a Kmax of 25 MPa m1/2 when air cooling rather than furnace cooling was employed" />
          <attvalue for="14" value="r-2" />
