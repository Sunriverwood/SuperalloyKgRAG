      <node id="chunk-c1282ac66fd9c2c8ff0d43cddcd3f8a6-e-5" label="Numerical working tools">
        <attvalues>
          <attvalue for="0" value="Numerical working tools" />
          <attvalue for="1" value="Tool" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;指为解决需要定量分析、数据处理或数学计算的问题时所使用的辅助工具。它涵盖了从物理计算器到电子表格、统计软件及编程环境等多种形式，是进行数值操作的基础。" />
          <attvalue for="3" value="{&quot;examples&quot;: &quot;calculator, spreadsheet or computer programming tool&quot;}" />
