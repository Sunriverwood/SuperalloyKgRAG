        <attvalues>
          <attvalue for="11" value="CONTRASTED_WITH" />
          <attvalue for="12" value="The 'prime-reliant' mode of using TBCs is presented as an alternative to the 'band-aid' mode." />
          <attvalue for="13" value="this will allow them to be used in ‘prime-reliant' rather than 'band-aid' mode." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-e619cc9d54ad4b2ac97ef772a3ffcd8c" />
          <attvalue for="16" value="0.0023539011989203436" />
          <attvalue for="17" value="0.26807900738601886" />
        </attvalues>
