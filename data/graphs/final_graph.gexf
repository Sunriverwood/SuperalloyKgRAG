        <attvalues>
          <attvalue for="11" value="EVOLVED_FROM" />
          <attvalue for="12" value="Third-generation alloys are a subsequent development from second-generation alloys, characterized by a higher Re content." />
          <attvalue for="13" value="In the second-generation single-crystal superalloys, Re was added at levels of about 3 wt%... Concentrations of Re were subsequently increased to 6 wt% in the third-generation alloys..." />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-c2bce381433d364861cf87ccbd650b94" />
          <attvalue for="16" value="1.4736221632773356e-05" />
          <attvalue for="17" value="0.2666755083996463" />
