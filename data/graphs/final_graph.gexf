        </attvalues>
      </node>
      <node id="chunk-d6790fb9c1169445a5d3fb409c8aba9c-e-14" label="infinite life">
        <attvalues>
          <attvalue for="0" value="infinite life" />
          <attvalue for="1" value="State" />
          <attvalue for="2" value="在材料科学中，无限寿命是一种理论状态。它指在完全没有缺陷，或缺陷与构件尺寸之比(d/D)趋于零的理想条件下，材料因能够承受无限次载荷循环而不会发生疲劳破坏的特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-d6790fb9c1169445a5d3fb409c8aba9c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Infinite life&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d6790fb9c1169445a5d3fb409c8aba9c-e-14&quot;, &quot;chunk-bf4677fbc731927f738fe825e4a4dab8-e-2&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-bf4677fbc731927f738fe825e4a4dab8-e-4" label="superalloy turbine disc material">
        <attvalues>
          <attvalue for="0" value="superalloy turbine disc material" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="高温合金涡轮盘材料是一种用于制造航空发动机、燃气轮机等核心旋转部件（涡轮盘）的特种金属。它必须在极端高温和高应力环境下保持优异的强度、抗蠕变和抗疲劳性能。其材料内部特定的颗粒尺寸分布是实现这些关键力学性能的重要微观结构特征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-bf4677fbc731927f738fe825e4a4dab8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bf4677fbc731927f738fe825e4a4dab8-e-6" label="nclasses">
        <attvalues>
          <attvalue for="0" value="nclasses" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="一个用于将连续粒径分布进行离散化的参数，它定义了整个粒径范围被划分成的离散尺寸等级或区间的总数量，决定了粒径分布的分辨率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-bf4677fbc731927f738fe825e4a4dab8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-bf4677fbc731927f738fe825e4a4dab8-e-7" label="Di">
        <attvalues>
          <attvalue for="0" value="Di" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="Di是在一个离散化的颗粒粒径分布中，第i个粒径级别的特征直径。此分布总共被划分为nclasses个级别，i为该级别的索引。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-bf4677fbc731927f738fe825e4a4dab8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bf4677fbc731927f738fe825e4a4dab8-e-7&quot;, &quot;chunk-98004d55693f7f9432c5daf0464e7353-e-7&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-bf4677fbc731927f738fe825e4a4dab8-e-8" label="n_i">
        <attvalues>
          <attvalue for="0" value="n_i" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="一个参数，表示在离散化的粒径分布中，第'i'个尺寸类别的粒子数密度。该分布总共被划分为'nclasses'个类别，i为类别索引。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-bf4677fbc731927f738fe825e4a4dab8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bf4677fbc731927f738fe825e4a4dab8-e-9" label="p3">
        <attvalues>
          <attvalue for="0" value="p3" />
          <attvalue for="1" value="Probability" />
          <attvalue for="2" value="p3是一个概率值，指寿命(Np)小于其潜在寿命(No)的可能性。该值通常基于另一概率(p4)和分类数(nclasses)计算得出，用于评估在特定条件下的失效风险。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-bf4677fbc731927f738fe825e4a4dab8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bf4677fbc731927f738fe825e4a4dab8-e-9&quot;, &quot;chunk-dfdd5ec0feef4bf4548566d6892aff87-e-1&quot;, &quot;chunk-82c9ced81969f3e1552c36cf4bd5f22e-e-1&quot;, &quot;chunk-e973968dedf4b6408be8c39762f554b7-e-7&quot;]}]" />
          <attvalue for="9" value="34" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-bf4677fbc731927f738fe825e4a4dab8-e-10" label="Np">
        <attvalues>
          <attvalue for="0" value="Np" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="表示材料寿命的随机变量参数，其概率分布由p3描述。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-bf4677fbc731927f738fe825e4a4dab8" />
