        </attvalues>
      </node>
      <node id="chunk-dfdd5ec0feef4bf4548566d6892aff87-e-7" label="D_i">
        <attvalues>
          <attvalue for="0" value="D_i" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="变量 D_i 是一个索引变量，其中下标 'i' 通常代表其在序列或集合中的位置。该变量是用于构建计算另一变量 p4 所用表达式的一个组成部分。" />
          <attvalue for="3" value="{}" />
