          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-fd0257f35193366950536d3c582b3768-e-5" label="re-engineering of these processes">
        <attvalues>
          <attvalue for="0" value="re-engineering of these processes" />
          <attvalue for="1" value="Activity" />
          <attvalue for="2" value="指基于流程模型提供的物理洞见，对现有工艺进行根本性再造，以提升最终部件质量的一类活动。例如，开发更先进的热处理方法即属此类。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-fd0257f35193366950536d3c582b3768" />
