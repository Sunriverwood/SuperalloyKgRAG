        <attvalues>
          <attvalue for="11" value="PROCESSES" />
          <attvalue for="12" value="The manufacturing stream is the process used for superalloy components." />
          <attvalue for="13" value="Although superalloys have been used for the turbine discs in jet engines for about 50 years, the processing is not without some challenges. The manufacturing stream is quite lengthy, involving a number of material suppliers, melters and forgemasters" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-49fe0f122b885e8929f914d54a677b92" />
          <attvalue for="16" value="0.0029627047751829907" />
