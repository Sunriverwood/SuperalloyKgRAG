        <attvalues>
          <attvalue for="11" value="OCCURS_IN" />
          <attvalue for="12" value="The situation involving the formation of faulted particles is applicable to the under-aged condition." />
          <attvalue for="13" value="This situation is applicable to the case of the under-aged condition." />
