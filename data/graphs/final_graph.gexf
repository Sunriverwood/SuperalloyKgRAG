        </attvalues>
      </node>
      <node id="chunk-e780ac83d97fe15870adf76ec9226ed9-e-7" label="B. Saruhan, P. Francois, K. Kritscher and U. Schulz">
        <attvalues>
          <attvalue for="0" value="B. Saruhan, P. Francois, K. Kritscher and U. Schulz" />
          <attvalue for="1" value="Authors" />
          <attvalue for="2" value="P. Francois、K. Kritscher与U. Schulz是一组研究人员。他们合作撰写了一篇关于采用电子束物理气相沉积(EB-PVD)工艺制备烧绿石结构La2Zr2O7基热障涂层的研究论文，该成果发表于学术期刊《Surface and Coatings Technology》。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-e780ac83d97fe15870adf76ec9226ed9" />
