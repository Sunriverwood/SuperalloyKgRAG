          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1a5bdd6114d60338a6db59595a5e76c4-e-4" label="Ni3Al">
        <attvalues>
          <attvalue for="0" value="Ni3Al" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="y-Ni3Al合金是一种基于金属间化合物Ni₃Al的镍基合金，通常指镍基高温合金中的γ'（伽马撇）强化相。该相具有L12有序晶体结构，是合金高温强度的主要来源。通过铂(Pt)等元素改性可提升其性能，其原子相互扩散行为是研究其高温稳定性的关键。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1a5bdd6114d60338a6db59595a5e76c4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Binary Ni3Al&quot;, &quot;Ni3 Al&quot;, &quot;Ni3Al compound&quot;, &quot;y-Ni3Al alloys&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1a5bdd6114d60338a6db59595a5e76c4-e-4&quot;, &quot;chunk-99c942e2e9af3f5f017d599dea23d62d-e-2&quot;, &quot;chunk-13624c30d54236964523cb607119931d-e-7&quot;, &quot;chunk-169f02cd5c7c6d28badcb341503cb862-e-4&quot;, &quot;chunk-c8291b746df8607dee394ae506322bb2-e-8&quot;, &quot;chunk-2fb89ce2ee9a1401de467999142656eb-e-2&quot;, &quot;chunk-0baebe66ecf34ef5401ef67e8b23af1b-e-3&quot;, &quot;chunk-8a245245cb1a365cd2add49b05ab2208-e-5&quot;, &quot;chunk-a4d65971a0e96c0f576b576adadc50ce-e-4&quot;, &quot;chunk-dceb4b755a836df5a6b40aba440100ba-e-2&quot;, &quot;chunk-68a06b7c34233385dd7e1ad8a70b5d54-e-12&quot;, &quot;chunk-4897104ddb336b2f8f129d218c5a2cc4-e-4&quot;, &quot;chunk-264495632c5fce243bda26582e560253-e-8&quot;, &quot;chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-9&quot;, &quot;chunk-3b4422ce09cd66eaf6abd58690d6f8ef-e-5&quot;]}]" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="18" />
        </attvalues>
      </node>
      <node id="chunk-1a5bdd6114d60338a6db59595a5e76c4-e-5" label="Planar faults">
        <attvalues>
          <attvalue for="0" value="Planar faults" />
          <attvalue for="1" value="Crystallographic Defect" />
          <attvalue for="2" value="一种面缺陷（二维晶体缺陷），指晶体中原子平面（如Ni3Al中的{111}晶面）的正常堆垛顺序因机械形变而发生错乱。它是材料发生塑性变形的一种基本方式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1a5bdd6114d60338a6db59595a5e76c4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1a5bdd6114d60338a6db59595a5e76c4-e-5&quot;]}]" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-99c942e2e9af3f5f017d599dea23d62d-e-1" label="Planar faults in Ni3Al">
        <attvalues>
          <attvalue for="0" value="Planar faults in Ni3Al" />
          <attvalue for="1" value="Crystallographic Defect" />
          <attvalue for="2" value="Ni3Al中的面缺陷（Planar faults in Ni3Al）是一种在镍铝金属间化合物中出现的晶体缺陷。它特指由机械变形所引起，而非热处理或再结晶过程导致的平面状晶格结构不规则。这种缺陷的产生与材料的力学行为密切相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-99c942e2e9af3f5f017d599dea23d62d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-99c942e2e9af3f5f017d599dea23d62d-e-1&quot;]}]" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-99c942e2e9af3f5f017d599dea23d62d-e-6" label="a/2⟨101⟩ shear">
        <attvalues>
          <attvalue for="0" value="a/2⟨101⟩ shear" />
          <attvalue for="1" value="Crystallographic Shear" />
          <attvalue for="2" value="一种晶体学切变，指在{111}晶面上沿⟨101⟩方向发生的a/2大小的滑移。此过程会在有序合金中产生一个反相畴界（APB），破坏原有的原子有序排列，并导致形成能量较高的同类原子键（如Al-Al键）。" />
          <attvalue for="3" value="{&quot;vector&quot;: &quot;a/2⟨101⟩&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-99c942e2e9af3f5f017d599dea23d62d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-99c942e2e9af3f5f017d599dea23d62d-e-7" label="APB on {111}">
        <attvalues>
          <attvalue for="0" value="APB on {111}" />
          <attvalue for="1" value="Crystallographic Defect" />
          <attvalue for="2" value="一种存在于{111}晶面上的反相畴界，属于晶体面缺陷。它因晶体发生a/2⟨101⟩切变而形成，导致切变面两侧原子原有的有序排列关系被破坏，形成反相关系。" />
          <attvalue for="3" value="{&quot;plane&quot;: &quot;{111}&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-99c942e2e9af3f5f017d599dea23d62d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-99c942e2e9af3f5f017d599dea23d62d-e-7&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-2" label="Top layer">
        <attvalues>
          <attvalue for="0" value="Top layer" />
          <attvalue for="1" value="Crystal Structure Component" />
          <attvalue for="2" value="指晶体结构中，沿滑移面相对于下层，发生 a/3⟨211⟩ 矢量剪切滑移的上部原子层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="246" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-3" label="a/3⟨211⟩">
        <attvalues>
          <attvalue for="0" value="a/3⟨211⟩" />
          <attvalue for="1" value="Displacement Vector" />
          <attvalue for="2" value="一个晶体学中的位移矢量，用于描述原子层沿⟨211⟩晶向族发生的剪切滑移。其大小为晶格常数a的三分之一，通常与晶体中的层错、孪晶等缺陷的形成有关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-3&quot;]}]" />
          <attvalue for="9" value="246" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-4" label="Al atoms in the top layer">
        <attvalues>
          <attvalue for="0" value="Al atoms in the top layer" />
          <attvalue for="1" value="Atomic Group" />
          <attvalue for="2" value="一个由铝原子构成的原子基团，它在晶体中形成了最顶部的原子层，并在空间上与下方的底层铝原子层相对齐。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-4&quot;]}]" />
          <attvalue for="9" value="247" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-5" label="Al atoms in the bottom one">
        <attvalues>
          <attvalue for="0" value="Al atoms in the bottom one" />
          <attvalue for="1" value="Atomic Group" />
          <attvalue for="2" value="一个由铝(Al)原子构成的原子团，它们在特定晶体结构中形成底层。该原子层在空间上位于“顶层铝原子”的正下方，与其构成垂直对齐关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-5&quot;]}]" />
          <attvalue for="9" value="247" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-6" label="ABCABCABCABC...">
        <attvalues>
          <attvalue for="0" value="ABCABCABCABC..." />
          <attvalue for="1" value="Stacking Sequence" />
          <attvalue for="2" value="一种理想晶体堆垛序列，以“ABC”为重复单元，代表完美的面心立方（FCC）结构。它常作为无缺陷的初始晶体，在剪切作用下会转变为包含堆垛层错的结构（如ABCACABCABC...）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-6&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-7" label="ABCACABCABC...">
        <attvalues>
          <attvalue for="0" value="ABCACABCABC..." />
          <attvalue for="1" value="Stacking Sequence" />
          <attvalue for="2" value="一种晶体缺陷的原子堆垛顺序。它由理想的面心立方结构（ABCABC...）经剪切滑移后形成，其...ABCAC...的序列特征定义了“超晶格内禀堆垛层错”（SISF）这种平面缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-73d5b71bcd1ef30ab316c29ee8b4abf6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-7&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-dc5958ae6c6275575fd05993164bcb7f-e-2" label="Nearest-neighbour violations">
        <attvalues>
          <attvalue for="0" value="Nearest-neighbour violations" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="最近邻违例（Nearest-neighbour violations）是一种物理现象和原子排列缺陷。它特指在晶体结构中，原子与其直接相邻的最近邻原子之间的正常化学键合或配位关系遭到破坏。这种缺陷与超晶格内禀层错（SISF）不同，后者仅改变原子堆垛顺序，但会保持最近邻的原子构型不变。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-dc5958ae6c6275575fd05993164bcb7f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;nearest-neighbour violations&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dc5958ae6c6275575fd05993164bcb7f-e-2&quot;, &quot;chunk-e69ec61e4ba33a69deaed5cb75487264-e-6&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-dc5958ae6c6275575fd05993164bcb7f-e-4" label="a/6⟨112⟩">
        <attvalues>
          <attvalue for="0" value="a/6⟨112⟩" />
          <attvalue for="1" value="Crystallographic Vector" />
          <attvalue for="2" value="一个晶体学矢量，特指面心立方（FCC）结构中肖克利不全位错的伯氏矢量。它描述了晶体在{111}滑移面上，一部分相对于另一部分发生滑移以形成一个本征层错（intrinsic stacking fault）时所产生的位移。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-dc5958ae6c6275575fd05993164bcb7f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dc5958ae6c6275575fd05993164bcb7f-e-4&quot;, &quot;chunk-13624c30d54236964523cb607119931d-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-13624c30d54236964523cb607119931d-e-3" label="Al atoms">
        <attvalues>
          <attvalue for="0" value="Al atoms" />
          <attvalue for="1" value="Atomic Element" />
          <attvalue for="2" value="标准化描述:&#10;指位于材料顶层的一类铝(Al)原子。其特征是经过重新定位，占据了镍(Ni)原子正上方的位置，这种特定的原子排列在晶体结构中形成了一种复杂的堆垛层错。" />
          <attvalue for="3" value="{&quot;layer&quot;: &quot;top&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-13624c30d54236964523cb607119931d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-13624c30d54236964523cb607119931d-e-6" label="CSF energy">
        <attvalues>
          <attvalue for="0" value="CSF energy" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="复合层错能 (CSF energy) 是一种物理性质，指在晶体中形成单位面积的复合层错（CSF）所需的能量。其数值大小与材料的化学计量比密切相关，例如在二元Ni3Al合金中有具体的估算研究。" />
          <attvalue for="3" value="{&quot;estimated_value_in_Ni3Al&quot;: &quot;~250 mJ/m²&quot;, &quot;variation_range&quot;: &quot;50 mJ/m²&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-13624c30d54236964523cb607119931d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-13624c30d54236964523cb607119931d-e-8" label="Stoichiometry">
        <attvalues>
          <attvalue for="0" value="Stoichiometry" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="化学计量（Stoichiometry）是一种基本材料属性，指化合物中各组分元素的原子数量的相对比例。该比例的精确构成或其偏离（非化学计量）会显著影响材料的物理化学性质，例如它直接导致晶体表面自由能（CSF energy）等能量参数发生变化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-13624c30d54236964523cb607119931d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-13624c30d54236964523cb607119931d-e-8&quot;, &quot;chunk-69a4ba77b1a6d872504c4b981b1f2c7e-e-3&quot;]}]" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-13624c30d54236964523cb607119931d-e-9" label="Nearest-neighbour configurations">
        <attvalues>
          <attvalue for="0" value="Nearest-neighbour configurations" />
          <attvalue for="1" value="Crystallographic Feature" />
          <attvalue for="2" value="一种描述晶体中原子与其最近邻原子空间排布的晶体学特征。在理想晶格中，该构型是确定的，但复杂层错（CSF）等晶体缺陷的形成会改变这种局域原子排列，从而影响材料的局部结构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-13624c30d54236964523cb607119931d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e69ec61e4ba33a69deaed5cb75487264-e-2" label="a/3⟨211⟩">
        <attvalues>
          <attvalue for="0" value="a/3⟨211⟩" />
          <attvalue for="1" value="Displacement Vector" />
          <attvalue for="2" value="a/3⟨211⟩ 是一种晶体学位移矢量，其在晶格中的滑移会产生一种被称为“超晶格非本征堆垛层错”（SESF）的平面缺陷。该矢量的大小和方向精确描述了形成此特定层错所需的原子位移。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-e69ec61e4ba33a69deaed5cb75487264" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e69ec61e4ba33a69deaed5cb75487264-e-5" label="Fault Energy">
        <attvalues>
          <attvalue for="0" value="Fault Energy" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="层错能是一种材料属性，指晶体中因形成一个单位面积的层错而引起的能量增加。它是评价材料中层错形成难易程度的重要物理量。对于超晶格非本征层错（SESF）和SISF等特定类型的缺陷，该能量值通常较低。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;low&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e69ec61e4ba33a69deaed5cb75487264" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-003c7763c31b55c8a5748939ac729c6a-e-1" label="Line defects">
        <attvalues>
          <attvalue for="0" value="Line defects" />
          <attvalue for="1" value="Crystal Defect Category" />
          <attvalue for="2" value="线缺陷是晶体缺陷的一种，指晶体内部原子排列的畸变或不规则性主要沿一维线状分布。这种缺陷在三维空间中延伸，其最主要和最常见的类型是位错，对材料的力学性能有决定性影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-003c7763c31b55c8a5748939ac729c6a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-003c7763c31b55c8a5748939ac729c6a-e-5" label="Dislocations in the L12 structure of the γ' phase">
        <attvalues>
          <attvalue for="0" value="Dislocations in the L12 structure of the γ' phase" />
          <attvalue for="1" value="Crystal Defect" />
          <attvalue for="2" value="一种存在于L12有序结构γ'相中的晶体缺陷。这类特殊位错具有较长的伯格斯矢量，并倾向于分解成两个或多个部分位错，以降低其线能量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-003c7763c31b55c8a5748939ac729c6a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-003c7763c31b55c8a5748939ac729c6a-e-5&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-003c7763c31b55c8a5748939ac729c6a-e-6" label="partial dislocations">
        <attvalues>
          <attvalue for="0" value="partial dislocations" />
          <attvalue for="1" value="Crystal Defect" />
          <attvalue for="2" value="一种线状晶体缺陷，其伯格斯矢量不是完整的晶格平移矢量。它通常由一个全位错分解形成，两个不全位错之间会限定一个层错区域。不全位错的运动是晶体材料塑性变形的重要机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-003c7763c31b55c8a5748939ac729c6a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Partial dislocations&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-003c7763c31b55c8a5748939ac729c6a-e-6&quot;, &quot;chunk-c8a13933656ed9f144b18b40f2e9861e-e-9&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-003c7763c31b55c8a5748939ac729c6a-e-9" label="Burgers vectors of dislocations in γ'">
        <attvalues>
          <attvalue for="0" value="Burgers vectors of dislocations in γ'" />
          <attvalue for="1" value="Dislocation Property" />
          <attvalue for="2" value="表征L12有序结构γ'相中位错的矢量。由于有序化反应，其长度通常大于γ相中的伯格斯矢量，是描述γ'相中晶格畸变大小和方向的关键物理量。" />
          <attvalue for="3" value="{&quot;possible closure vector lengths&quot;: &quot;a√2 or a√6&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-003c7763c31b55c8a5748939ac729c6a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-003c7763c31b55c8a5748939ac729c6a-e-9&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-003c7763c31b55c8a5748939ac729c6a-e-10" label="Burgers vectors of dislocations in γ">
        <attvalues>
          <attvalue for="0" value="Burgers vectors of dislocations in γ" />
          <attvalue for="1" value="Dislocation Property" />
          <attvalue for="2" value="γ相中位错的伯格斯矢量，是描述该晶体相中位错所引起的晶格畸变大小与方向的矢量。其模长是一个表征位错强度的基本物理量，定义了晶格滑移的最小单位，常被用作材料微观尺度下长度比较的参考基准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-003c7763c31b55c8a5748939ac729c6a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-003c7763c31b55c8a5748939ac729c6a-e-10&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-003c7763c31b55c8a5748939ac729c6a-e-11" label="ordering reaction">
        <attvalues>
          <attvalue for="0" value="ordering reaction" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="有序化反应（Ordering Reaction）是在特定晶体相（如γ'相）中发生的物理过程，指原子排列从无序状态转变为有序的超晶格结构。该过程的典型结果是导致晶格内部位错的伯格斯矢量伸长，从而影响材料的力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-003c7763c31b55c8a5748939ac729c6a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-003c7763c31b55c8a5748939ac729c6a-e-11&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-da122ebde0d16d97da9e3e19d5be9708-e-1" label="a[101] -&gt; a/6[112] + a/6[211]">
        <attvalues>
          <attvalue for="0" value="a[101] -&gt; a/6[112] + a/6[211]" />
          <attvalue for="1" value="Dissociation Reaction" />
          <attvalue for="2" value="一种在镍及其合金的{111}滑移面上发生的位错分解反应。它描述了一个伯氏矢量为a[101]的全位错分解为两个部分位错：a/6[112]和a/6[211]。此分解过程由复杂层错（CSF）和反相畴界（APB）共同介导，是材料塑性变形的重要机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-da122ebde0d16d97da9e3e19d5be9708" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-da122ebde0d16d97da9e3e19d5be9708-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-da122ebde0d16d97da9e3e19d5be9708-e-3" label="Figure 2.39">
        <attvalues>
          <attvalue for="0" value="Figure 2.39" />
          <attvalue for="1" value="Figure" />
          <attvalue for="2" value="图2.39是一幅用于分析“闭合矢量”（closure vectors）的示意图。它通过可视化方式，阐释与闭合矢量相关的构成、原理或数据，为理解该概念提供了关键的视觉依据和分析基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-da122ebde0d16d97da9e3e19d5be9708" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-da122ebde0d16d97da9e3e19d5be9708-e-4" label="Pope and Ezz [36]">
        <attvalues>
          <attvalue for="0" value="Pope and Ezz [36]" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="Pope和Ezz，一篇综述文章[36]的作者。该文探讨了晶体材料中复杂位错离解的多种可能性，例如将a[101]型位错分解为两个部分位错，为相关研究提供了理论构想。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-da122ebde0d16d97da9e3e19d5be9708" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-da122ebde0d16d97da9e3e19d5be9708-e-5" label="Figure 2.40">
        <attvalues>
          <attvalue for="0" value="Figure 2.40" />
          <attvalue for="1" value="Figure" />
          <attvalue for="2" value="图 2.40 是一幅示意图，阐释了一种可能的位错分解机制。该图具体描绘了 a[101] 型位错分解为 a/6[112] 和 a/6[211] 两个不全位错的反应过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-da122ebde0d16d97da9e3e19d5be9708" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-da122ebde0d16d97da9e3e19d5be9708-e-6" label="Defects in nickel and its alloys">
        <attvalues>
          <attvalue for="0" value="Defects in nickel and its alloys" />
          <attvalue for="1" value="Topic" />
          <attvalue for="2" value="一个关于镍及其合金中晶体结构不完整性的材料科学主题。它研究在原子排列中出现的各种偏差，如点缺陷（空位）、线缺陷（位错）、面缺陷（晶界）和体缺陷（孔洞、析出物）。这些缺陷的类型、密度和分布，决定或显著影响材料的机械强度、耐腐蚀性、导电性及高温性能等关键性质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-da122ebde0d16d97da9e3e19d5be9708" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-da122ebde0d16d97da9e3e19d5be9708-e-6&quot;, &quot;chunk-9a641206a39d9f183256b080afe1f768-e-7&quot;, &quot;chunk-54728fc56c44ccf66b9375798fee1dd9-e-10&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-da122ebde0d16d97da9e3e19d5be9708-e-11" label="a/6[112]">
        <attvalues>
          <attvalue for="0" value="a/6[112]" />
          <attvalue for="1" value="Partial Dislocation Vector" />
          <attvalue for="2" value="一种晶体学中的不全位错矢量（或称分位错），由一个全位错`a[101]`分解产生。在位错反应`a[101] -&gt; a/6[112] + a/6[211]`中，它是与`a/6[211]`共同生成的两个肖克利（Shockley）不全位错产物之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-da122ebde0d16d97da9e3e19d5be9708" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-da122ebde0d16d97da9e3e19d5be9708-e-11&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-da122ebde0d16d97da9e3e19d5be9708-e-12" label="a/6[211]">
        <attvalues>
          <attvalue for="0" value="a/6[211]" />
          <attvalue for="1" value="Partial Dislocation Vector" />
          <attvalue for="2" value="一种不全位错矢量。它是柏氏矢量为`a[101]`的全位错发生分解反应`a[101] -&gt; a/6[112] + a/6[211]`后，生成的两种不全位错产物之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-da122ebde0d16d97da9e3e19d5be9708" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-da122ebde0d16d97da9e3e19d5be9708-e-12&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-988dabd61f21e6f460ff885a9055c6a6-e-1" label="Dissociation by CSF, APB and CSF on {111} planes">
        <attvalues>
          <attvalue for="0" value="Dissociation by CSF, APB and CSF on {111} planes" />
          <attvalue for="1" value="Dissociation Mechanism" />
          <attvalue for="2" value="一种位错分解机制，指 a[101] 型超位错在{111}晶面上分解的过程。其特征是形成由一个反相畴界（APB）和两个复式层错（CSF）连接并分隔开的多个分位错。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;a[101] -&gt; a/6[112] + a/6[211] + a/6[211] + a/6[112]&quot;, &quot;identifier&quot;: &quot;(i)&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-988dabd61f21e6f460ff885a9055c6a6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-988dabd61f21e6f460ff885a9055c6a6-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-988dabd61f21e6f460ff885a9055c6a6-e-5" label="a[101]">
        <attvalues>
          <attvalue for="0" value="a[101]" />
          <attvalue for="1" value="Dislocation Vector" />
          <attvalue for="2" value="`a[101]`是一种全位错矢量，常见于面心立方（FCC）晶体中。它在能量上不稳定，会发生解离反应 `a[101] -&gt; a/6[112] + a/6[211]`，分解为两个能量更低的肖克利不全位错。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-988dabd61f21e6f460ff885a9055c6a6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-988dabd61f21e6f460ff885a9055c6a6-e-5&quot;, &quot;chunk-da122ebde0d16d97da9e3e19d5be9708-e-10&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-988dabd61f21e6f460ff885a9055c6a6-e-6" label="Dissociation by APB, CSF and SISF on {111} planes">
        <attvalues>
          <attvalue for="0" value="Dissociation by APB, CSF and SISF on {111} planes" />
          <attvalue for="1" value="Dissociation Mechanism" />
          <attvalue for="2" value="一种位错分解机制，指a[101]型位错在{111}晶面上分解时，同时形成了反相畴界(APB)、复杂层错(CSF)和超晶格内禀层错(SISF)三种平面缺陷。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;a[101] -&gt; a/6[112] + a/6[211] + a/6[121] + a/6[121] + a/6[112] + a/6[211]&quot;, &quot;identifier&quot;: &quot;(ii)&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-988dabd61f21e6f460ff885a9055c6a6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-988dabd61f21e6f460ff885a9055c6a6-e-6&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-988dabd61f21e6f460ff885a9055c6a6-e-8" label="Dissociation by APB on {111} planes">
        <attvalues>
          <attvalue for="0" value="Dissociation by APB on {111} planes" />
          <attvalue for="1" value="Dissociation Mechanism" />
          <attvalue for="2" value="一种位错分解机制，指a[101]等超位错在{111}晶面上分解为两个部分位错，并在两者之间形成反相畴界（APB）的现象。该机制常见于有序金属间化合物中。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;a[101] -&gt; a/2[101] + a/2[101]&quot;, &quot;identifier&quot;: &quot;(iii)&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-988dabd61f21e6f460ff885a9055c6a6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-988dabd61f21e6f460ff885a9055c6a6-e-8&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-988dabd61f21e6f460ff885a9055c6a6-e-9" label="Dissociation by SISF on {111} planes">
        <attvalues>
          <attvalue for="0" value="Dissociation by SISF on {111} planes" />
          <attvalue for="1" value="Dissociation Mechanism" />
          <attvalue for="2" value="一种位错分解机制，指 a[101] 型超位错在 {111} 晶面上分解，并在其产生的分位错之间形成超晶格内禀层错（Superlattice Intrinsic Stacking Fault, SISF）。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;a[101] -&gt; a/3[211] + a/3[112]&quot;, &quot;identifier&quot;: &quot;(iv)&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-988dabd61f21e6f460ff885a9055c6a6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-988dabd61f21e6f460ff885a9055c6a6-e-9&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-988dabd61f21e6f460ff885a9055c6a6-e-10" label="Dissociation by SISF and SESF">
        <attvalues>
          <attvalue for="0" value="Dissociation by SISF and SESF" />
          <attvalue for="1" value="Dissociation Mechanism" />
          <attvalue for="2" value="一种位错分解机制，其特点是位错在分解过程中，同时形成超晶格内禀层错（Superlattice Intrinsic Stacking Fault, SISF）和超晶格外禀层错（Superlattice Extrinsic Stacking Fault, SESF）。" />
          <attvalue for="3" value="{&quot;identifier&quot;: &quot;(v)&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-988dabd61f21e6f460ff885a9055c6a6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-988dabd61f21e6f460ff885a9055c6a6-e-10&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cb76da6f86e534b7b2a34ae7c293d1f0-e-2" label="Dislocation Dissociation (2.20)">
        <attvalues>
          <attvalue for="0" value="Dislocation Dissociation (2.20)" />
          <attvalue for="1" value="Dislocation Reaction" />
          <attvalue for="2" value="一种特定的位错分解反应，指一个伯氏矢量为a[101]的全位错在{111}晶面上，分解为两个伯氏矢量分别为a/3[211]和a/3[112]的肖克利分位错。这是面心立方结构中滑移的典型机制。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;a[101] -&gt; a/3[211] + a/3[112]&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-cb76da6f86e534b7b2a34ae7c293d1f0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cb76da6f86e534b7b2a34ae7c293d1f0-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cb76da6f86e534b7b2a34ae7c293d1f0-e-5" label="Dislocation Dissociation (2.21)">
        <attvalues>
          <attvalue for="0" value="Dislocation Dissociation (2.21)" />
          <attvalue for="1" value="Dislocation Reaction" />
          <attvalue for="2" value="一种在单晶{111}晶面上发生的特定位错分解反应。该过程由超晶格内禀层错(SISF)和超晶格外禀层错(SESF)介导，将一个柏氏矢量为a[211]的全位错分解为四个分位错，其反应式为 a[211] -&gt; a/3[121] + a/3[112] + a/3[211] + a/3[211]。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;a[211] -&gt; a/3[121] + a/3[112] + a/3[211] + a/3[211]&quot;, &quot;alias&quot;: &quot;Scheme (v)&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-cb76da6f86e534b7b2a34ae7c293d1f0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cb76da6f86e534b7b2a34ae7c293d1f0-e-5&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-cb76da6f86e534b7b2a34ae7c293d1f0-e-8" label="Dislocation Dissociation (2.22)">
        <attvalues>
          <attvalue for="0" value="Dislocation Dissociation (2.22)" />
          <attvalue for="1" value="Dislocation Reaction" />
          <attvalue for="2" value="一种发生在{010}晶面上的位错分解反应。该反应中，一个伯格斯矢量为a[101]的全位错分解为两个由反相畴界（APB）分隔开的、伯格斯矢量为a/2[101]的部分位错。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;a[101] -&gt; a/2[101] + a/2[101]&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-cb76da6f86e534b7b2a34ae7c293d1f0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cb76da6f86e534b7b2a34ae7c293d1f0-e-8&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cb76da6f86e534b7b2a34ae7c293d1f0-e-12" label="single-crystal">
        <attvalues>
          <attvalue for="0" value="single-crystal" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="单晶是一种固体材料，其内部原子在整个体积内按单一、连续的晶格结构进行周期性排列，因而没有晶界。这种高度有序的结构使其通常表现出各向异性，是研究晶体本征物理性质（如位错）的理想形态。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-cb76da6f86e534b7b2a34ae7c293d1f0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-12efe43c66bf3765417cf87c1dbf67ad-e-3" label="Scheme (v)">
        <attvalues>
          <attvalue for="0" value="Scheme (v)" />
          <attvalue for="1" value="Reaction Scheme" />
          <attvalue for="2" value="一种特定的位错分解反应。该反应在单晶合金材料中，于750 °C的温度和高外加应力条件下被观察到。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-12efe43c66bf3765417cf87c1dbf67ad" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-12efe43c66bf3765417cf87c1dbf67ad-e-5" label="750 °C">
        <attvalues>
          <attvalue for="0" value="750 °C" />
          <attvalue for="1" value="Temperature" />
          <attvalue for="2" value="750 °C是一个温度值，特指方案(v) (Scheme (v)) 被观测到时的大致温度。它是该方案所描述的化学反应或物理过程发生所需的一个关键物理条件。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;around 750 °C&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-12efe43c66bf3765417cf87c1dbf67ad" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-12efe43c66bf3765417cf87c1dbf67ad-e-6" label="High applied stress">
        <attvalues>
          <attvalue for="0" value="High applied stress" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="指施加于材料上的高强度应力，是一种能引发材料第一阶段蠕变（即初始蠕变）的关键物理条件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-12efe43c66bf3765417cf87c1dbf67ad" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-12efe43c66bf3765417cf87c1dbf67ad-e-7" label="Primary creep">
        <attvalues>
          <attvalue for="0" value="Primary creep" />
          <attvalue for="1" value="Material Phenomenon" />
          <attvalue for="2" value="主蠕变（Primary Creep），也称第一阶段蠕变，是材料在恒定应力（尤其在高温下）作用时发生的蠕变初始阶段。其核心特征是材料的变形速率因应变硬化效应而随时间延长逐渐降低。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-12efe43c66bf3765417cf87c1dbf67ad" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-12efe43c66bf3765417cf87c1dbf67ad-e-7&quot;, &quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-21&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-12efe43c66bf3765417cf87c1dbf67ad-e-8" label="Scheme (ii)">
        <attvalues>
          <attvalue for="0" value="Scheme (ii)" />
          <attvalue for="1" value="Reaction Scheme" />
          <attvalue for="2" value="方案(ii)是一种假设性的解离反应路径。该方案在理论上被提出，但截至目前，尚未发现任何实验证据能够证实其存在或发生。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-12efe43c66bf3765417cf87c1dbf67ad" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-12efe43c66bf3765417cf87c1dbf67ad-e-8&quot;]}]" />
          <attvalue for="9" value="248" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-12efe43c66bf3765417cf87c1dbf67ad-e-9" label="Scheme (iv)">
        <attvalues>
          <attvalue for="0" value="Scheme (iv)" />
          <attvalue for="1" value="Reaction Scheme" />
          <attvalue for="2" value="方案(iv)是一种假设性的解离反应路线，用于描述一种可能的化学分解过程，但该路线目前缺乏任何实验或理论上的支持性证据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-12efe43c66bf3765417cf87c1dbf67ad" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-12efe43c66bf3765417cf87c1dbf67ad-e-9&quot;]}]" />
          <attvalue for="9" value="248" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-12efe43c66bf3765417cf87c1dbf67ad-e-10" label="Scheme (i)">
        <attvalues>
          <attvalue for="0" value="Scheme (i)" />
          <attvalue for="1" value="Reaction Scheme" />
          <attvalue for="2" value="一种表示解离反应的化学方案。该反应可在γ'相（一种金属间化合物相）或包含γ'相的γ + γ'合金中发生，用于说明特定物质在这些合金环境中的分解过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-12efe43c66bf3765417cf87c1dbf67ad" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-12efe43c66bf3765417cf87c1dbf67ad-e-10&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-12efe43c66bf3765417cf87c1dbf67ad-e-11" label="Scheme (iii)">
        <attvalues>
          <attvalue for="0" value="Scheme (iii)" />
          <attvalue for="1" value="Reaction Scheme" />
          <attvalue for="2" value="一种解离反应方案，描述了在镍基高温合金常见的γ'相或γ+γ'双相合金中，特定物相可能发生的分解过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-12efe43c66bf3765417cf87c1dbf67ad" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-12efe43c66bf3765417cf87c1dbf67ad-e-11&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-795763ad7f38bb8adeb25f9d763ce8dd-e-2" label="Tension test">
        <attvalues>
          <attvalue for="0" value="Tension test" />
          <attvalue for="1" value="Mechanical Test" />
          <attvalue for="2" value="拉伸试验（Tension test）是一种基础的材料力学测试，通过对标准试样施加单轴拉伸载荷直至其断裂，以测定材料的抗拉强度、屈服强度和延展性等关键力学性能。该测试可用于评估特定材料（如γ'或γ+γ'合金）在特定应变率下的变形行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-795763ad7f38bb8adeb25f9d763ce8dd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-795763ad7f38bb8adeb25f9d763ce8dd-e-4" label="{111} plane">
        <attvalues>
          <attvalue for="0" value="{111} plane" />
          <attvalue for="1" value="Crystallographic Plane" />
          <attvalue for="2" value="{111}晶面是一族晶体学等效平面。在面心立方(FCC)等晶体结构中，它们是主要的滑移面，位错离解反应 a[101] -&gt; a/6[112] + a/6[211] 在此平面上发生，形成两个肖克利不全位错，是材料塑性变形的关键微观机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-795763ad7f38bb8adeb25f9d763ce8dd" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;{111}&quot;, &quot;{111} Plane&quot;, &quot;{111} layer&quot;, &quot;{111} planes&quot;, &quot;{111}-type planes&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-988dabd61f21e6f460ff885a9055c6a6-e-4&quot;, &quot;chunk-cb76da6f86e534b7b2a34ae7c293d1f0-e-1&quot;, &quot;chunk-795763ad7f38bb8adeb25f9d763ce8dd-e-4&quot;, &quot;chunk-d965a70b739082dfa928e6608abf4061-e-4&quot;, &quot;chunk-06552db6ca6c8a18f5c48e13e0d28d19-e-4&quot;, &quot;chunk-ef56fb2a5c4451551a2024d8490545ff-e-3&quot;, &quot;chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa-e-11&quot;, &quot;chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd-e-5&quot;, &quot;chunk-96f36e4af04723225cb4d274300efd6e-e-5&quot;, &quot;chunk-a147395bb93a2c0f3ea0e531840ca795-e-5&quot;, &quot;chunk-bcb76bb0ef5881469a3b9478e223d894-e-6&quot;, &quot;chunk-1a5bdd6114d60338a6db59595a5e76c4-e-3&quot;, &quot;chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-8&quot;, &quot;chunk-e69ec61e4ba33a69deaed5cb75487264-e-3&quot;, &quot;chunk-da122ebde0d16d97da9e3e19d5be9708-e-9&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="16" />
        </attvalues>
      </node>
      <node id="chunk-795763ad7f38bb8adeb25f9d763ce8dd-e-5" label="{010} plane">
        <attvalues>
          <attvalue for="0" value="{010} plane" />
          <attvalue for="1" value="Crystallographic Plane" />
          <attvalue for="2" value="{010}晶面，也称立方体面，是晶体学中的一族晶面。在有序合金等材料中，它是超位错（Superdislocation）可以分解的两个主要平面之一，也是反相畴界（APB）进行交滑移的目标平面，在材料的塑性变形中起着关键作用。" />
          <attvalue for="3" value="{&quot;alias&quot;: &quot;cube plane&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-795763ad7f38bb8adeb25f9d763ce8dd" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Cube Plane {010}&quot;, &quot;{010} planes&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cb76da6f86e534b7b2a34ae7c293d1f0-e-7&quot;, &quot;chunk-795763ad7f38bb8adeb25f9d763ce8dd-e-5&quot;, &quot;chunk-d965a70b739082dfa928e6608abf4061-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-d965a70b739082dfa928e6608abf4061-e-9" label="L12 compounds">
        <attvalues>
          <attvalue for="0" value="L12 compounds" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="L12型化合物指一类具有L12晶体结构（一种有序的面心立方结构）的金属间化合物。其最显著的特征是表现出反常屈服效应，即屈服强度在一定温度范围内随温度升高而增加。典型的例子是作为高温结构材料的铝化镍（Ni3Al）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-d965a70b739082dfa928e6608abf4061" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d965a70b739082dfa928e6608abf4061-e-9&quot;, &quot;chunk-169f02cd5c7c6d28badcb341503cb862-e-3&quot;]}]" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-169f02cd5c7c6d28badcb341503cb862-e-1" label="f lock">
        <attvalues>
          <attvalue for="0" value="f lock" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="f lock 是一种材料科学理论模型，作为核心概念用以解释L12型金属间化合物所特有的反常屈服效应，即材料的屈服强度随温度升高而异常增加的现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-169f02cd5c7c6d28badcb341503cb862" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-169f02cd5c7c6d28badcb341503cb862-e-6" label="Ni-Al phase diagram">
        <attvalues>
          <attvalue for="0" value="Ni-Al phase diagram" />
          <attvalue for="1" value="Technical Concept" />
          <attvalue for="2" value="**镍铝相图**是一种描述镍(Ni)和铝(Al)二元合金系统在不同温度和成分下，其内部物相组成与结构的图谱。它通过图形方式揭示了体系中各物相（如重要的金属间化合物Ni3Al）的热力学稳定区域，是开发和应用镍基高温合金等材料的基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-169f02cd5c7c6d28badcb341503cb862" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-69a4ba77b1a6d872504c4b981b1f2c7e-e-2" label="B2 structure">
        <attvalues>
          <attvalue for="0" value="B2 structure" />
          <attvalue for="1" value="Crystal Structure" />
          <attvalue for="2" value="B2结构是一种有序晶体结构，又称氯化铯(CsCl)型结构，常见于等原子比的金属间化合物（如β-NiAl）。其晶格为体心立方，两种不同原子分别占据立方体单元的角顶和体心位置，形成有序排列。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-69a4ba77b1a6d872504c4b981b1f2c7e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-69a4ba77b1a6d872504c4b981b1f2c7e-e-4" label="Point defects">
        <attvalues>
          <attvalue for="0" value="Point defects" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="点缺陷（Point Defects）是晶体材料中在原子尺度上产生局部扰动的一类零维缺陷。其影响范围通常限于一个或几个原子位置，主要类型包括使其成为子类型的结构空位（Constitutional Vacancies）和反位缺陷（Anti-site Defects）等。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-69a4ba77b1a6d872504c4b981b1f2c7e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Point Defects&quot;, &quot;point defects&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-69a4ba77b1a6d872504c4b981b1f2c7e-e-4&quot;, &quot;chunk-b90367b4b5b4b46e86c0cb9e61cfbb14-e-7&quot;, &quot;chunk-c8291b746df8607dee394ae506322bb2-e-1&quot;, &quot;chunk-9205fd6987f1eb506eff11a839efe879-e-1&quot;, &quot;chunk-821a3f267f9ff96b58c19914c2c7eff8-e-8&quot;, &quot;chunk-e7ffe201a4367e57c9d8b70da74e50b8-e-1&quot;, &quot;chunk-44a9440aa3e5fad0c388f77698c519bf-e-8&quot;, &quot;chunk-169f02cd5c7c6d28badcb341503cb862-e-5&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-69a4ba77b1a6d872504c4b981b1f2c7e-e-6" label="Anti-site defects">
        <attvalues>
          <attvalue for="0" value="Anti-site defects" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="**反位缺陷 (Anti-site defects)**&#10;&#10;一种存在于化合物或有序合金晶体中的点缺陷。它指晶体中某一类原子占据了本应由另一类原子所占据的晶格位置。这种缺陷是材料容纳化学计量偏差、维持结构稳定的一种重要方式，并会显著影响材料的电学与光学性质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-69a4ba77b1a6d872504c4b981b1f2c7e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c8291b746df8607dee394ae506322bb2-e-3" label="Anti-site Defects">
        <attvalues>
          <attvalue for="0" value="Anti-site Defects" />
          <attvalue for="1" value="Defect Type" />
          <attvalue for="2" value="反位缺陷是一种点缺陷，指在化合物或合金晶体中，一种组分的原子占据了另一种组分原子本应占据的晶格位置。它是材料（如Ni3Al）中用以调节非化学计量比的一种重要机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c8291b746df8607dee394ae506322bb2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c8291b746df8607dee394ae506322bb2-e-4" label="Al atoms on Ni sites">
        <attvalues>
          <attvalue for="0" value="Al atoms on Ni sites" />
          <attvalue for="1" value="Defect Sub-type" />
          <attvalue for="2" value="一种反位缺陷，指在含镍（Ni）和铝（Al）的晶体结构中，铝原子占据了原本应由镍原子占据的晶格位置。这种点缺陷常见于镍铝合金及金属间化合物中，会影响材料的有序度和物理性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c8291b746df8607dee394ae506322bb2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c8291b746df8607dee394ae506322bb2-e-5" label="Ni atoms on Al sites">
        <attvalues>
          <attvalue for="0" value="Ni atoms on Al sites" />
          <attvalue for="1" value="Defect Sub-type" />
          <attvalue for="2" value="一种晶体点缺陷，是反位缺陷的具体类型。它指在含镍和铝的材料（如镍铝合金）中，镍(Ni)原子占据了本应由铝(Al)原子占据的晶格位置，从而破坏了晶体的周期性结构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c8291b746df8607dee394ae506322bb2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c8291b746df8607dee394ae506322bb2-e-6" label="Vacancies on the Ni lattices">
        <attvalues>
          <attvalue for="0" value="Vacancies on the Ni lattices" />
          <attvalue for="1" value="Defect Sub-type" />
          <attvalue for="2" value="一种成分空位，指在镍或含镍合金的晶格中，为维持材料特定的化学计量比或晶体结构而固有存在的原子空位点缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c8291b746df8607dee394ae506322bb2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c8291b746df8607dee394ae506322bb2-e-7" label="Vacancies on the Al lattices">
        <attvalues>
          <attvalue for="0" value="Vacancies on the Al lattices" />
          <attvalue for="1" value="Defect Sub-type" />
          <attvalue for="2" value="指铝晶格中存在的结构空位。它是在特定铝基合金或化合物中，为维持化学计量比和结构稳定而固有形成的晶格点缺陷，区别于因热振动产生的热空位。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c8291b746df8607dee394ae506322bb2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2fb89ce2ee9a1401de467999142656eb-e-1" label="Ni3+xAl1-x">
        <attvalues>
          <attvalue for="0" value="Ni3+xAl1-x" />
          <attvalue for="1" value="Chemical Formula" />
          <attvalue for="2" value="一种表示金属间化合物Ni₃Al非化学计量成分的化学式。其中变量x表示镍(Ni)与铝(Al)的原子比例偏离理想化学计量比3:1的程度，该式涵盖了包括富镍区和富铝区在内的实际成分范围。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-2fb89ce2ee9a1401de467999142656eb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2fb89ce2ee9a1401de467999142656eb-e-3" label="Anti-site defects">
        <attvalues>
          <attvalue for="0" value="Anti-site defects" />
          <attvalue for="1" value="Crystallographic Defect" />
          <attvalue for="2" value="反位缺陷是一种晶体点缺陷，常见于有序合金或金属间化合物（如Ni3Al）中。它指一种元素的原子占据了本应由另一种元素原子占据的晶格位置。这种缺陷是该类材料容纳非化学计量比、调节组分偏离的主要机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-2fb89ce2ee9a1401de467999142656eb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-2fb89ce2ee9a1401de467999142656eb-e-4" label="Ni atoms on Al sites">
        <attvalues>
          <attvalue for="0" value="Ni atoms on Al sites" />
          <attvalue for="1" value="Crystallographic Defect" />
          <attvalue for="2" value="一种晶体学中的反位缺陷，指晶格中本应属于铝（Al）原子的位置被镍（Ni）原子错误占据。这种点缺陷常见于富镍的镍铝金属间化合物等材料中，是其容纳过量镍组分的主要方式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-2fb89ce2ee9a1401de467999142656eb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2fb89ce2ee9a1401de467999142656eb-e-5" label="Al atoms on Ni sites">
        <attvalues>
          <attvalue for="0" value="Al atoms on Ni sites" />
          <attvalue for="1" value="Crystallographic Defect" />
          <attvalue for="2" value="一种反位点缺陷，指一个铝(Al)原子占据了晶格中本应属于镍(Ni)原子的位置。该缺陷常见于贫镍(Ni-lean)组分的材料中，用于调节非化学计量比的成分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2fb89ce2ee9a1401de467999142656eb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2fb89ce2ee9a1401de467999142656eb-e-6" label="Density">
        <attvalues>
          <attvalue for="0" value="Density" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="密度是一种表征物质单位体积内所含质量的物理性质。在Ni3Al金属间化合物的具体研究中，其测量值随化学成分呈现的单调变化趋势，是证实材料内部存在反位缺陷（Anti-site defects）的关键实验证据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-2fb89ce2ee9a1401de467999142656eb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2fb89ce2ee9a1401de467999142656eb-e-7" label="Lattice parameter">
        <attvalues>
          <attvalue for="0" value="Lattice parameter" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="表征晶体材料中晶胞尺寸的物理量。在Ni3Al化合物中，其数值随化学成分发生单调变化，此现象可证实反位缺陷的存在。因为非化学计量的原子以反位缺陷形式融入晶格，会引起晶胞平均尺寸的系统性改变。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-2fb89ce2ee9a1401de467999142656eb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2fb89ce2ee9a1401de467999142656eb-e-8" label="Thermodynamic model">
        <attvalues>
          <attvalue for="0" value="Thermodynamic model" />
          <attvalue for="1" value="Scientific Model" />
          <attvalue for="2" value="一个由Numakura等人为Ni3Al金属间化合物构建的科学模型。它基于热力学原理，旨在描述和预测该材料在不同条件下的相稳定性、能量状态及其他相关的热力学性质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-2fb89ce2ee9a1401de467999142656eb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2fb89ce2ee9a1401de467999142656eb-e-8&quot;, &quot;chunk-0baebe66ecf34ef5401ef67e8b23af1b-e-2&quot;]}]" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2fb89ce2ee9a1401de467999142656eb-e-9" label="Numakura et al. [40]">
        <attvalues>
          <attvalue for="0" value="Numakura et al. [40]" />
          <attvalue for="1" value="Research Group" />
          <attvalue for="2" value="Numakura等人[40]是指代建立了Ni3Al（铝化镍）化合物热力学模型的研究团队。该名称为学术文献中的引文格式，其中Numakura是主要作者，“等人”代表其他合作者，[40]是该文献在特定上下文中的引用编号。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-2fb89ce2ee9a1401de467999142656eb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2fb89ce2ee9a1401de467999142656eb-e-9&quot;, &quot;chunk-0baebe66ecf34ef5401ef67e8b23af1b-e-1&quot;]}]" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0baebe66ecf34ef5401ef67e8b23af1b-e-4" label="Constitutional vacancies (in Ni3Al)">
        <attvalues>
          <attvalue for="0" value="Constitutional vacancies (in Ni3Al)" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="Ni3Al金属间化合物中的一种本征点缺陷，指镍(Ni)和铝(Al)亚晶格上的原子空位。即使在精确化学计量比下，该缺陷在特定温度（如950K）的热平衡中仍会以极低密度存在，其平衡浓度可用热力学模型进行估算。" />
          <attvalue for="3" value="{&quot;density_Ni_lattice&quot;: &quot;~10⁻⁸&quot;, &quot;density_Al_lattice&quot;: &quot;~10⁻¹⁰&quot;, &quot;condition&quot;: &quot;at the point of exact stoichiometry&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0baebe66ecf34ef5401ef67e8b23af1b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0baebe66ecf34ef5401ef67e8b23af1b-e-5" label="β-NiAl">
        <attvalues>
          <attvalue for="0" value="β-NiAl" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="β-NiAl相是一种镍铝金属间化合物，具有有序的体心立方（B2）晶体结构。它通常作为镍基高温合金和热障涂层（如AlY罩光涂层）中的一个关键组成相，因其优异的高温强度、抗氧化性和抗腐蚀性能，是决定材料微观结构与服役性能的重要物相。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-0baebe66ecf34ef5401ef67e8b23af1b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;NiAl&quot;, &quot;β-NiAl compound&quot;, &quot;ẞ-NiAl phase&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-69a4ba77b1a6d872504c4b981b1f2c7e-e-1&quot;, &quot;chunk-0baebe66ecf34ef5401ef67e8b23af1b-e-5&quot;, &quot;chunk-aeb95c93346b29b2210d9a08444b0239-e-6&quot;, &quot;chunk-0e56d036a3d2e550af5ea66665ba607a-e-6&quot;, &quot;chunk-dceb4b755a836df5a6b40aba440100ba-e-1&quot;, &quot;chunk-aedbe4412d2761c1e12ab362e44dea99-e-6&quot;, &quot;chunk-e66fbe12748379e18cc5f75f5238013e-e-2&quot;, &quot;chunk-1abe15e2f2db1602f97ac75bb847ef30-e-8&quot;, &quot;chunk-cd90df188efe63a1aba2d62ab225c3ae-e-14&quot;, &quot;chunk-264495632c5fce243bda26582e560253-e-9&quot;]}]" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-0baebe66ecf34ef5401ef67e8b23af1b-e-6" label="Ni constitutional vacancies (in β-NiAl)">
        <attvalues>
          <attvalue for="0" value="Ni constitutional vacancies (in β-NiAl)" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="β-NiAl合金富铝侧的一种本征点缺陷。当成分偏离化学计量比时，为保持其B2型晶体结构，多余的Al原子会占据Ni原子的晶格位置，从而在Ni亚晶格上形成结构性空位（Constitutional Vacancies）。" />
          <attvalue for="3" value="{&quot;location&quot;: &quot;Al-rich side&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0baebe66ecf34ef5401ef67e8b23af1b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0baebe66ecf34ef5401ef67e8b23af1b-e-7" label="Ni anti-site defects">
        <attvalues>
          <attvalue for="0" value="Ni anti-site defects" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="在β-NiAl合金中，当成分为富镍时，过剩的镍（Ni）原子占据了本应属于铝（Al）原子的晶格位置，由此形成的一种本征点缺陷。" />
          <attvalue for="3" value="{&quot;location&quot;: &quot;Ni-rich side&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-0baebe66ecf34ef5401ef67e8b23af1b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a245245cb1a365cd2add49b05ab2208-e-1" label="Ni constitutional vacancies">
        <attvalues>
          <attvalue for="0" value="Ni constitutional vacancies" />
          <attvalue for="1" value="Point Defect" />
          <attvalue for="2" value="一种存在于富铝侧金属间化合物（如NiAl）中的本征点缺陷。当成分偏离理想化学计量比时，为维持晶体结构的稳定性，镍（Ni）原子亚晶格上固有地产生一些空位，这种因化学配比需要而形成的空位即为Ni组分空位。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-8a245245cb1a365cd2add49b05ab2208" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="249" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a245245cb1a365cd2add49b05ab2208-e-2" label="Al-rich side">
        <attvalues>
          <attvalue for="0" value="Al-rich side" />
          <attvalue for="1" value="Compositional Condition" />
          <attvalue for="2" value="在合金体系（尤其是金属间化合物）中，指铝原子浓度超过特定化学计量比的成分状态。为保持晶体结构稳定，这种非化学计量的富铝状态通常会导致在另一组分（如镍）的亚晶格上形成固有的结构性空位。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-8a245245cb1a365cd2add49b05ab2208" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="249" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a245245cb1a365cd2add49b05ab2208-e-3" label="Ni anti-site defects">
        <attvalues>
          <attvalue for="0" value="Ni anti-site defects" />
          <attvalue for="1" value="Point Defect" />
          <attvalue for="2" value="Ni反位缺陷是一种点缺陷，指镍(Ni)原子占据了晶格中本应由其他组元原子占据的位置。这种缺陷常见于成分偏离化学计量比的富镍(Ni-rich)材料中，其在金属间化合物Ni3Al里的形成是典型研究案例。它的存在与动力学行为可通过机械损耗（内耗）谱等方法进行表征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-8a245245cb1a365cd2add49b05ab2208" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8a245245cb1a365cd2add49b05ab2208-e-4" label="Ni-rich side">
        <attvalues>
          <attvalue for="0" value="Ni-rich side" />
          <attvalue for="1" value="Compositional Condition" />
          <attvalue for="2" value="指材料的原子组分中，镍的比例超过理想化学计量比的一种成分状态。在这种条件下，过量的镍原子会占据其他元素的晶格位置，从而形成镍反位缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-8a245245cb1a365cd2add49b05ab2208" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a245245cb1a365cd2add49b05ab2208-e-6" label="Mechanical loss (internal friction) spectrum">
        <attvalues>
          <attvalue for="0" value="Mechanical loss (internal friction) spectrum" />
          <attvalue for="1" value="Measurement Technique" />
          <attvalue for="2" value="一种利用扭摆等设备测量材料机械损耗（内耗）的实验技术。它通过分析能量耗散随温度或频率变化的谱图，来研究材料内部的微观结构和缺陷动态，例如用于推断Ni3(Al, Ta)单晶中的Ni反位缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-8a245245cb1a365cd2add49b05ab2208" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8a245245cb1a365cd2add49b05ab2208-e-7" label="Ni3(Al, Ta) single crystals">
        <attvalues>
          <attvalue for="0" value="Ni3(Al, Ta) single crystals" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种具有L1₂有序结构的镍基金属间化合物单晶材料。它是在Ni₃Al（γ'相）基体中，由钽（Ta）原子部分替代铝（Al）原子进行固溶强化而形成的合金，常用于高温结构材料和基础物理性能研究。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-8a245245cb1a365cd2add49b05ab2208" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a245245cb1a365cd2add49b05ab2208-e-8" label="Torsional pendulum">
        <attvalues>
          <attvalue for="0" value="Torsional pendulum" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="扭摆是一种物理仪器，它利用悬丝或弹性杆的扭转恢复力矩产生扭转振动。通过测量其振动的自由衰减，可以精确测定材料的机械损耗谱（即内耗谱），并常用于测量材料的剪切模量等力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-8a245245cb1a365cd2add49b05ab2208" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a245245cb1a365cd2add49b05ab2208-e-9" label="Stresses">
        <attvalues>
          <attvalue for="0" value="Stresses" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="一种物理现象，特指能引起材料产生滞弹性应变（anelastic strain）的内力。这种应变具有时间依赖性，其产生和消失滞后于应力的变化，但在应力移除后可以完全恢复。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-8a245245cb1a365cd2add49b05ab2208" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8a245245cb1a365cd2add49b05ab2208-e-9&quot;]}]" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a245245cb1a365cd2add49b05ab2208-e-11" label="Movement of the defects">
        <attvalues>
          <attvalue for="0" value="Movement of the defects" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="一种材料物理过程，指固体材料在应力作用下，其内部的晶体缺陷（如位错、空位）发生迁移或重新取向。这种微观运动是材料产生非弹性应变（一种时间依赖且可恢复的形变）的根本原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-8a245245cb1a365cd2add49b05ab2208" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6ec49b4807352fc50a7eb77173350dba-e-2" label="Defects">
        <attvalues>
          <attvalue for="0" value="Defects" />
          <attvalue for="1" value="Material Imperfection" />
          <attvalue for="2" value="作为一种材料不完美结构，“缺陷”特指那些通过在材料内部从一个位置迁移至另一位置，从而引起非弹性应变的微观实体。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-6ec49b4807352fc50a7eb77173350dba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6ec49b4807352fc50a7eb77173350dba-e-3" label="Internal friction">
        <attvalues>
          <attvalue for="0" value="Internal friction" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="内耗是一种材料属性，表征材料在周期性应力下内部能量耗散或阻尼的程度。当外部激励频率与材料内部某种弛豫过程的特征频率一致时，能量耗散达到最大，使其在特定频率下呈现出一个尖锐的峰值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-6ec49b4807352fc50a7eb77173350dba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="131" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6ec49b4807352fc50a7eb77173350dba-e-4" label="Frequency">
        <attvalues>
          <attvalue for="0" value="Frequency" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="一个物理量，指材料内耗达到峰值时所对应的特定频率。该频率的精确值依赖于温度，并随之变化。" />
          <attvalue for="3" value="{&quot;range&quot;: &quot;0.03 Hz to 3 Hz&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-6ec49b4807352fc50a7eb77173350dba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="131" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6ec49b4807352fc50a7eb77173350dba-e-5" label="Temperature">
        <attvalues>
          <attvalue for="0" value="Temperature" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="温度是一种物理量。在材料内耗现象中，它的改变是导致最大内耗峰所对应的频率值发生移动或变化的决定性因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-6ec49b4807352fc50a7eb77173350dba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="131" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6ec49b4807352fc50a7eb77173350dba-e-6" label="Activation energy">
        <attvalues>
          <attvalue for="0" value="Activation energy" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="活化能（Activation energy）是一个物理量，在材料科学中特指空位形成能（vacancy formation energy）与空位迁移能（vacancy migration energy）的总和。其数值远大于结构空位（constitutional vacancy）的形成能。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;about 3.0 eV&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-6ec49b4807352fc50a7eb77173350dba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-6ec49b4807352fc50a7eb77173350dba-e-7" label="Constitutional vacancy">
        <attvalues>
          <attvalue for="0" value="Constitutional vacancy" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="**结构性空位 (Constitutional Vacancies)** 是一种点缺陷，指在非化学计量比的有序合金或化合物中，为维持其晶体结构稳定而必然产生的晶格空位。例如，在NiAl金属间化合物中，空位会出现在Ni或Al亚晶格上以调节成分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-6ec49b4807352fc50a7eb77173350dba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Constitutional Vacancies&quot;, &quot;Constitutional vacancies&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-69a4ba77b1a6d872504c4b981b1f2c7e-e-5&quot;, &quot;chunk-6ec49b4807352fc50a7eb77173350dba-e-7&quot;, &quot;chunk-c8291b746df8607dee394ae506322bb2-e-2&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-6ec49b4807352fc50a7eb77173350dba-e-8" label="Vacancy formation">
        <attvalues>
          <attvalue for="0" value="Vacancy formation" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="在晶体中，原子脱离其晶格点阵的平衡位置，从而形成一个点缺陷（空位）的物理过程。该过程需要克服一个能垒，其能量即空位形成能，是原子扩散总活化能的关键组成部分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-6ec49b4807352fc50a7eb77173350dba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6ec49b4807352fc50a7eb77173350dba-e-9" label="Migration of a vacancy">
        <attvalues>
          <attvalue for="0" value="Migration of a vacancy" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="空位迁移（Migration of a vacancy）是一种晶体材料中的物理过程，指邻近空位的原子克服能量势垒跳入该空位，从而使空位移动到原原子位置的现象。它是原子扩散的基本机制之一，其所需的能量（迁移激活能）是衡量材料扩散性能的总激活能的重要组成部分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-6ec49b4807352fc50a7eb77173350dba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6ec49b4807352fc50a7eb77173350dba-e-9&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3ca2e169452aac1fe72512e4665d8d85-e-1" label="Activation energies for vacancy formation and migration of an anti-site defect">
        <attvalues>
          <attvalue for="0" value="Activation energies for vacancy formation and migration of an anti-site defect" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="一种材料物理性质，由与反位缺陷相关的两个能量构成：在其附近形成一个晶格空位所需的形成能，以及该缺陷在晶格中从一个位置迁移到另一个位置所需的迁移能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-3ca2e169452aac1fe72512e4665d8d85" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="437" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-3ca2e169452aac1fe72512e4665d8d85-e-3" label="Symmetry-breaking defect">
        <attvalues>
          <attvalue for="0" value="Symmetry-breaking defect" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="**对称性破缺缺陷 (Symmetry-breaking defect)**&#10;&#10;一种材料缺陷，指能破坏晶格原有立方对称性的一类点缺陷或缺陷簇。这种对称性的丧失会在材料内部诱发非弹性应变，从而影响材料的力学和物理性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-3ca2e169452aac1fe72512e4665d8d85" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3ca2e169452aac1fe72512e4665d8d85-e-5" label="Lattice strain introduced by a Ni atom on an Al site">
        <attvalues>
          <attvalue for="0" value="Lattice strain introduced by a Ni atom on an Al site" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="由镍原子替代铝原子位点而引入的一种晶格应变。该应变为各向同性，即在所有方向上均匀作用，表现为一种体积效应，因此它本身不能引起具有方向依赖性的滞弹性应变。" />
          <attvalue for="3" value="{&quot;property&quot;: &quot;isotropic&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3ca2e169452aac1fe72512e4665d8d85" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3ca2e169452aac1fe72512e4665d8d85-e-6" label="Ni atom on an Al site">
        <attvalues>
          <attvalue for="0" value="Ni atom on an Al site" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="一种材料点缺陷，指晶格中本应属于铝（Al）原子的位置被镍（Ni）原子占据。这种反位缺陷（anti-site defect）会引起各向同性的晶格应变。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-3ca2e169452aac1fe72512e4665d8d85" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3ca2e169452aac1fe72512e4665d8d85-e-7" label="Al atom on a Ni site">
        <attvalues>
          <attvalue for="0" value="Al atom on a Ni site" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="一种反位缺陷，指铝原子占据了晶格中的镍原子位点。该缺陷会导致晶格产生四方畸变，进而破坏材料原有的立方对称性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-3ca2e169452aac1fe72512e4665d8d85" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-921a9348cd77597c4374323349308669-e-2" label="Ni site">
        <attvalues>
          <attvalue for="0" value="Ni site" />
          <attvalue for="1" value="Crystallographic Site" />
          <attvalue for="2" value="指晶体结构中的特定晶格位置，通常由镍（Ni）原子占据，并可被铝（Al）原子所取代。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-921a9348cd77597c4374323349308669" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-921a9348cd77597c4374323349308669-e-3" label="Tetragonal distortion">
        <attvalues>
          <attvalue for="0" value="Tetragonal distortion" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="四方畸变是一种晶格畸变物理现象。它特指因铝(Al)原子取代镍(Ni)原子位而导致的晶格结构变化，这种畸变是实现特定材料机械阻尼性能的必要条件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-921a9348cd77597c4374323349308669" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-921a9348cd77597c4374323349308669-e-4" label="Mechanical damping">
        <attvalues>
          <attvalue for="0" value="Mechanical damping" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="机械阻尼是一种材料属性，表征材料在振动或形变中耗散机械能的能力。在此特定机制下，该阻尼效应的产生，必须以材料晶体结构发生四方畸变为前提，从而实现能量的吸收与转化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-921a9348cd77597c4374323349308669" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-921a9348cd77597c4374323349308669-e-5" label="Nickel alloys">
        <attvalues>
          <attvalue for="0" value="Nickel alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍合金是一种以镍为基体，加入其他元素（如铬、铁、钼）形成的金属材料。其强度、韧性、耐腐蚀性等力学性能强烈依赖于微观结构，因此可通过热处理等工艺进行精确调控，以满足航空航天、化工等领域的严苛要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-921a9348cd77597c4374323349308669" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c2b78e8b376569da6104df59fa66c5ca-e-3" label="Physical Metallurgy">
        <attvalues>
          <attvalue for="0" value="Physical Metallurgy" />
          <attvalue for="1" value="Field of Study" />
          <attvalue for="2" value="物理冶金学是材料科学的重要分支，专注于研究金属及其合金的物理与力学性能。它旨在通过阐明材料的化学成分、加工工艺、微观结构与其最终性能之间的关系，来实现对材料性能的理解、控制与优化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c2b78e8b376569da6104df59fa66c5ca" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c2b78e8b376569da6104df59fa66c5ca-e-5" label="Nickel Alloys">
        <attvalues>
          <attvalue for="0" value="Nickel Alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="以镍为主要元素的合金材料。通常具有优异的耐高温、耐腐蚀性能，广泛应用于航空航天、化工和能源等领域。其物理冶金学是材料科学的重要研究领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c2b78e8b376569da6104df59fa66c5ca" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7cf96eceef65bf46495ba2d8c36b9a73-e-2" label="Strengthening">
        <attvalues>
          <attvalue for="0" value="Strengthening" />
          <attvalue for="1" value="Material Process" />
          <attvalue for="2" value="一种旨在提高材料机械强度的材料工艺。在此类强化过程中，作为重要析出相的γ'（伽马撇）相的形态、尺寸和分布，对最终的强化效果起着关键影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-7cf96eceef65bf46495ba2d8c36b9a73" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7cf96eceef65bf46495ba2d8c36b9a73-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7cf96eceef65bf46495ba2d8c36b9a73-e-5" label="Anti-Phase Boundary (APB)">
        <attvalues>
          <attvalue for="0" value="Anti-Phase Boundary (APB)" />
          <attvalue for="1" value="Planar Fault" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;反相畴界（Antiphase Boundary, APB）是一种存在于有序合金或有序化合物晶体中的面缺陷。它指晶体中原本有序的原子排列在跨越该界面时发生了相位错位。在位错运动中，该缺陷通常由领先位错产生，并由随后的拖尾位错消除。其能量大小用反相畴界能（γAPB）表示。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-7cf96eceef65bf46495ba2d8c36b9a73" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;APB&quot;, &quot;APB fault&quot;, &quot;Anti-phase boundaries&quot;, &quot;Anti-phase boundary (APB)&quot;, &quot;Antiphase Boundary (APB)&quot;, &quot;anti-phase boundary&quot;, &quot;anti-phase boundary (APB)&quot;, &quot;superpartial&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9a641206a39d9f183256b080afe1f768-e-4&quot;, &quot;chunk-542eb38b71ebf203cb6df08f03ceb063-e-4&quot;, &quot;chunk-988dabd61f21e6f460ff885a9055c6a6-e-3&quot;, &quot;chunk-3e64561be3c56bb2625ff8ce6474f540-e-4&quot;, &quot;chunk-cb76da6f86e534b7b2a34ae7c293d1f0-e-6&quot;, &quot;chunk-795763ad7f38bb8adeb25f9d763ce8dd-e-6&quot;, &quot;chunk-d965a70b739082dfa928e6608abf4061-e-1&quot;, &quot;chunk-7cf96eceef65bf46495ba2d8c36b9a73-e-5&quot;, &quot;chunk-59b9b1adda4a73bb67c682f77b77e783-e-3&quot;, &quot;chunk-a478184a271f81c44b621f35badc5f0a-e-11&quot;, &quot;chunk-70bdb361c16d13b8408a365565b5baba-e-4&quot;, &quot;chunk-264495632c5fce243bda26582e560253-e-5&quot;, &quot;chunk-66ba88a6026c55d38eeb24aad6777073-e-5&quot;, &quot;chunk-08620c5a2f94ef5584dba0230f92c28f-e-5&quot;, &quot;chunk-9718b105c96174ffb3694bd3c4362a1e-e-5&quot;, &quot;chunk-de934887953c10df356d75f9bd459e77-e-1&quot;, &quot;chunk-2ea107a54755373c4c649a5b4b0b14ad-e-4&quot;, &quot;chunk-f263635cd44ee57c5a9142ff0e73030b-e-2&quot;, &quot;chunk-da122ebde0d16d97da9e3e19d5be9708-e-8&quot;, &quot;chunk-dc4fc8b9731ff54ceedadcde2ec92655-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="23" />
        </attvalues>
      </node>
      <node id="chunk-7cf96eceef65bf46495ba2d8c36b9a73-e-6" label="Dislocation pairs">
        <attvalues>
          <attvalue for="0" value="Dislocation pairs" />
          <attvalue for="1" value="Crystallographic Phenomenon" />
          <attvalue for="2" value="由两条a/2⟨110⟩{111}位错构成的特定位型，常见于γ/γ'结构材料中。该配对结构能够共同切过有序的γ'相，是这类材料的一种关键塑性变形机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-7cf96eceef65bf46495ba2d8c36b9a73" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-59b9b1adda4a73bb67c682f77b77e783-e-1" label="Dislocations">
        <attvalues>
          <attvalue for="0" value="Dislocations" />
          <attvalue for="1" value="Crystallographic Defect" />
          <attvalue for="2" value="位错是一种晶体缺陷，其特征是在γ/γ'结构中成对移动。在该过程中，领先的位错会产生一个反相畴界（APB），而紧随其后的第二个位错会将其消除。透射电子显微镜（TEM）为这一现象提供了证据。" />
          <attvalue for="3" value="{&quot;type&quot;: &quot;a/2⟨110⟩{111}&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-59b9b1adda4a73bb67c682f77b77e783" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-59b9b1adda4a73bb67c682f77b77e783-e-4" label="Transmission electron microscopy (TEM)">
        <attvalues>
          <attvalue for="0" value="Transmission electron microscopy (TEM)" />
          <attvalue for="1" value="Analysis Technique" />
          <attvalue for="2" value="透射电子显微镜（TEM）是一种利用高能电子束穿透超薄样品并与之相互作用而成像的显微分析技术。它能以近原子级的高分辨率，揭示材料的内部结构、晶体缺陷（如位错）及形态，是材料科学等领域的重要研究工具。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-59b9b1adda4a73bb67c682f77b77e783" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;transmission electron microscopy&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0440023a44a202881a859e66f23ec3de-e-6&quot;, &quot;chunk-cb76da6f86e534b7b2a34ae7c293d1f0-e-9&quot;, &quot;chunk-59b9b1adda4a73bb67c682f77b77e783-e-4&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-59b9b1adda4a73bb67c682f77b77e783-e-5" label="Anti-Phase Boundary Energy (γAPB)">
        <attvalues>
          <attvalue for="0" value="Anti-Phase Boundary Energy (γAPB)" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="反相畴界能（APB energy）是一种物理性质，指与反相畴界（Antiphase Boundary）相关的界面能。该能量具有强烈的各向异性，其值取决于畴界所在的晶面方向。例如，对于由a/2&lt;101&gt;型位移矢量产生的反相畴界，其能量在{110}晶面上最高，而在{001}晶面上最低。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-59b9b1adda4a73bb67c682f77b77e783" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;APB Energy (γAPB)&quot;, &quot;APB energy&quot;, &quot;Anisotropy of the APB energy&quot;, &quot;Anti-phase boundary energy (γAPB)&quot;, &quot;γAPB&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9108d08e6e7d916cfb35fde79b233c67-e-3&quot;, &quot;chunk-c170c36341964554c175d2ca279d86c6-e-5&quot;, &quot;chunk-59b9b1adda4a73bb67c682f77b77e783-e-5&quot;, &quot;chunk-4f41447104e1101d06dfe6066a69e83c-e-2&quot;, &quot;chunk-99e1c2354bf8364a02d01889797902c8-e-9&quot;, &quot;chunk-127ccac0bbb9a57ea78fa0e8276b38f5-e-1&quot;, &quot;chunk-a478184a271f81c44b621f35badc5f0a-e-4&quot;, &quot;chunk-26ae1c8b32c505920e532d6304655e87-e-8&quot;, &quot;chunk-88fbc7a52ff45f9431f17e23dd2d49a1-e-4&quot;, &quot;chunk-c026408b0eb125d3c56d1ed05d0a0f15-e-10&quot;, &quot;chunk-08620c5a2f94ef5584dba0230f92c28f-e-9&quot;, &quot;chunk-96f36e4af04723225cb4d274300efd6e-e-1&quot;, &quot;chunk-a147395bb93a2c0f3ea0e531840ca795-e-4&quot;, &quot;chunk-9718b105c96174ffb3694bd3c4362a1e-e-3&quot;, &quot;chunk-f263635cd44ee57c5a9142ff0e73030b-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="17" />
        </attvalues>
      </node>
      <node id="chunk-59b9b1adda4a73bb67c682f77b77e783-e-6" label="Particle cutting">
        <attvalues>
          <attvalue for="0" value="Particle cutting" />
          <attvalue for="1" value="Deformation Mechanism" />
          <attvalue for="2" value="**粒子切割 (Particle cutting)**&#10;&#10;一种材料变形机制，指位错在运动中直接剪切并穿过强化相粒子的现象。该过程的发生需要位错克服粒子造成的阻力，特别是当剪切有序析出相时，必须克服因产生反相畴界（APB）而形成的能量势垒。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-59b9b1adda4a73bb67c682f77b77e783" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-59b9b1adda4a73bb67c682f77b77e783-e-6&quot;, &quot;chunk-4f41447104e1101d06dfe6066a69e83c-e-6&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-4f41447104e1101d06dfe6066a69e83c-e-4" label="TEM experiments">
        <attvalues>
          <attvalue for="0" value="TEM experiments" />
          <attvalue for="1" value="Experimental Method" />
          <attvalue for="2" value="一种基于透射电子显微镜(TEM)的实验方法，旨在通过观察和分析材料的微观结构特征（如位错对间距），来定量计算和测定其反相畴界能(γAPB)的数值。" />
          <attvalue for="3" value="{&quot;citation&quot;: &quot;[47]&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-4f41447104e1101d06dfe6066a69e83c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-41c4572391c7a506f02a50c6ea737ecc-e-2" label="Nickel-based alloys">
        <attvalues>
          <attvalue for="0" value="Nickel-based alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍基合金是一种以镍为基体，并以“有序强化”为主要强化机制的金属材料。它通过形成有序的金属间化合物沉淀相来阻碍位错运动，从而获得优异的高温强度和抗蠕变性能，常被称为高温合金。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-41c4572391c7a506f02a50c6ea737ecc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-41c4572391c7a506f02a50c6ea737ecc-e-3" label="Modulus difference strengthening">
        <attvalues>
          <attvalue for="0" value="Modulus difference strengthening" />
          <attvalue for="1" value="Strengthening Mechanism" />
          <attvalue for="2" value="一种应用于镍基合金等材料的强化机制。它源于沉淀相与基体之间存在的弹性模量差异，这种差异会对位错运动产生阻碍，从而提高材料强度。在镍基高温合金中，其强化效果通常弱于有序强化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-41c4572391c7a506f02a50c6ea737ecc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-41c4572391c7a506f02a50c6ea737ecc-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-41c4572391c7a506f02a50c6ea737ecc-e-4" label="Stacking fault energy difference strengthening">
        <attvalues>
          <attvalue for="0" value="Stacking fault energy difference strengthening" />
          <attvalue for="1" value="Strengthening Mechanism" />
          <attvalue for="2" value="层错能差异强化是应用于镍基合金的一种强化机制。它利用基体与强化相之间层错能的差异来阻碍位错运动，从而提高材料强度。在镍基合金中，这种强化机制的贡献通常小于有序强化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-41c4572391c7a506f02a50c6ea737ecc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-41c4572391c7a506f02a50c6ea737ecc-e-4&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-41c4572391c7a506f02a50c6ea737ecc-e-5" label="Interfacial energy difference strengthening">
        <attvalues>
          <attvalue for="0" value="Interfacial energy difference strengthening" />
          <attvalue for="1" value="Strengthening Mechanism" />
          <attvalue for="2" value="一种材料强化机制，常见于镍基合金。该机制源于位错切过析出相时，因产生具有更高能量的新界面而对位错运动形成阻力，从而提高材料强度。在同时存在有序强化的合金中，其强化贡献通常相对较小，并被有序强化所超越。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-41c4572391c7a506f02a50c6ea737ecc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-41c4572391c7a506f02a50c6ea737ecc-e-5&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-41c4572391c7a506f02a50c6ea737ecc-e-6" label="Orowan strengthening">
        <attvalues>
          <attvalue for="0" value="Orowan strengthening" />
          <attvalue for="1" value="Strengthening Mechanism" />
          <attvalue for="2" value="奥罗万强化（Orowan strengthening）是一种材料强化机制，指位错线在运动中绕过硬的、不可切削的第二相粒子，从而受到阻碍并提高材料强度。在镍基合金等材料中，它是一种重要的强化方式，但其贡献通常小于有序强化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-41c4572391c7a506f02a50c6ea737ecc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6c8bf2ccc7af91368e39bedeb76382ef-e-3" label="paired dislocations">
        <attvalues>
          <attvalue for="0" value="paired dislocations" />
          <attvalue for="1" value="Dislocation Configuration" />
          <attvalue for="2" value="一种由领先位错和尾随位错耦合形成的特定位错构型。这两个位错共同运动，并在其间限定出一个带状的晶体缺陷（如层错）。弱耦合位错是它的一种特例。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-6c8bf2ccc7af91368e39bedeb76382ef" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6c8bf2ccc7af91368e39bedeb76382ef-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-6c8bf2ccc7af91368e39bedeb76382ef-e-6" label="faulted particles">
        <attvalues>
          <attvalue for="0" value="faulted particles" />
          <attvalue for="1" value="Material State" />
          <attvalue for="2" value="在晶体材料中，由一对部分位错（前导位错与后行位错）运动时，在它们之间所夹区域内处于层错状态的粒子。该区域的原子堆垛顺序发生错误，破坏了晶格原有的完美周期性排列。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-6c8bf2ccc7af91368e39bedeb76382ef" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6c8bf2ccc7af91368e39bedeb76382ef-e-6&quot;, &quot;chunk-0fc62816353bfe4473c22a2bef9a696b-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0fc62816353bfe4473c22a2bef9a696b-e-1" label="leading dislocation">
        <attvalues>
          <attvalue for="0" value="leading dislocation" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="前沿位错（Leading Dislocation）是一种材料缺陷，通常指扩展位错（Extended Dislocation）中领先运动的分位错（Partial Dislocation）。当其在晶格中滑移时，会在其后方产生一个原子堆垛次序错误的区域，即层错（Stacking Fault）。它与一个后行的分位错共同构成一个完整的全位错。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-0fc62816353bfe4473c22a2bef9a696b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;First Dislocation&quot;, &quot;Leading Dislocation&quot;, &quot;Leading dislocation&quot;, &quot;first dislocation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6c8bf2ccc7af91368e39bedeb76382ef-e-5&quot;, &quot;chunk-0fc62816353bfe4473c22a2bef9a696b-e-1&quot;, &quot;chunk-0fc62816353bfe4473c22a2bef9a696b-e-2&quot;, &quot;chunk-a478184a271f81c44b621f35badc5f0a-e-5&quot;, &quot;chunk-70bdb361c16d13b8408a365565b5baba-e-3&quot;, &quot;chunk-aaf1405fdcaab5726ea1519f7e18e407-e-5&quot;, &quot;chunk-62e0b88322cda2b3939ddacaff16f02d-e-4&quot;, &quot;chunk-2863217e233dc47e4fc60478978f8746-e-1&quot;, &quot;chunk-19203bda469f6dad8b0600aecd2de043-e-2&quot;, &quot;chunk-bc7ac356d3b96aa45f10f8864536d6bf-e-8&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="20" />
        </attvalues>
      </node>
      <node id="chunk-0fc62816353bfe4473c22a2bef9a696b-e-6" label="second dislocation">
        <attvalues>
          <attvalue for="0" value="second dislocation" />
          <attvalue for="1" value="Crystallographic Defect" />
          <attvalue for="2" value="一种材料晶体缺陷，指在成对切割γ'强化相粒子的一对位错（超位错）中，跟在前导位错之后的第二个位错，也称为尾随位错。这两个位错之间的间距（如λ₂）是影响材料强度的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0fc62816353bfe4473c22a2bef9a696b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Second Dislocation&quot;, &quot;Second dislocation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0fc62816353bfe4473c22a2bef9a696b-e-6&quot;, &quot;chunk-aaf1405fdcaab5726ea1519f7e18e407-e-2&quot;, &quot;chunk-70bdb361c16d13b8408a365565b5baba-e-5&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-0fc62816353bfe4473c22a2bef9a696b-e-7" label="Friedel spacing (materials science: dislocation pinning)">
        <attvalues>
          <attvalue for="0" value="Friedel spacing (materials science: dislocation pinning)" />
          <attvalue for="1" value="Technical Concept" />
          <attvalue for="2" value="在材料科学中，弗里德尔间距 (Friedel spacing) 是一个关键概念，指位错在滑移面上运动时所遇到的钉扎点（如析出相、溶质原子）之间的平均距离。该间距决定了位错线克服障碍所需的临界应力，直接影响材料的屈服强度。它是理解和量化固溶强化及沉淀强化等机制的核心参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-0fc62816353bfe4473c22a2bef9a696b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Friedel spacing&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-be2e5714ffd15b4d499890769149ecb3-e-19&quot;, &quot;chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-4&quot;, &quot;chunk-0fc62816353bfe4473c22a2bef9a696b-e-7&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-0fc62816353bfe4473c22a2bef9a696b-e-8" label="λ₁">
        <attvalues>
          <attvalue for="0" value="λ₁" />
          <attvalue for="1" value="Material Parameter" />
          <attvalue for="2" value="λ₁是一个代表颗粒间距的物理参数。它在物理模型中用于定义颗粒间的距离，并与颗粒半径(r₁)共同构成关键比值 2r₁/λ₁，该比值通过关联颗粒直径与间距，来估算和表征颗粒系统的相关物理特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-0fc62816353bfe4473c22a2bef9a696b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0fc62816353bfe4473c22a2bef9a696b-e-8&quot;, &quot;chunk-c57d743ecd992fc77a60fae245010e74-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-0fc62816353bfe4473c22a2bef9a696b-e-9" label="λ₂">
        <attvalues>
          <attvalue for="0" value="λ₂" />
          <attvalue for="1" value="Material Parameter" />
          <attvalue for="2" value="λ₂是一种材料参数，为特定的弗里德尔间距（Friedel spacing），定义为与第二个位错相交的粒子沿该位错线分布的平均间隔。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-0fc62816353bfe4473c22a2bef9a696b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ac23817ca85b5e2cba9cb1da3a1960fc-e-1" label="Friedel spacing (condensed matter physics: Friedel oscillations)">
        <attvalues>
          <attvalue for="0" value="Friedel spacing (condensed matter physics: Friedel oscillations)" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="弗里德尔间距是凝聚态物理学概念，指金属或电子气中，由局部杂质或缺陷引发的电子电荷密度振荡（即弗里德尔振荡）的空间周期或波长。其大小与材料的费米波矢成反比，是源于费米面尖锐截断的一种量子干涉效应。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-ac23817ca85b5e2cba9cb1da3a1960fc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Friedel spacing&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ac23817ca85b5e2cba9cb1da3a1960fc-e-1&quot;]}]" />
          <attvalue for="9" value="438" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-ac23817ca85b5e2cba9cb1da3a1960fc-e-2" label="r₁">
        <attvalues>
          <attvalue for="0" value="r₁" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="变量r₁，一个用于表示沿特定第一条线分布或排列的粒子半径的参数。该符号明确了其测量对象（粒子）和空间限制（沿第一条线），通常用于物理或工程模型中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-ac23817ca85b5e2cba9cb1da3a1960fc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="132" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ac23817ca85b5e2cba9cb1da3a1960fc-e-3" label="r₂">
        <attvalues>
          <attvalue for="0" value="r₂" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="r₂ 是一个物理量符号，在特定上下文的公式(2.24)中，作为变量被用来定义另一物理量 τc。它的具体物理意义（例如半径、距离等）取决于该公式所描述的特定物理模型。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-ac23817ca85b5e2cba9cb1da3a1960fc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ac23817ca85b5e2cba9cb1da3a1960fc-e-3&quot;, &quot;chunk-26ae1c8b32c505920e532d6304655e87-e-11&quot;]}]" />
          <attvalue for="9" value="132" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ac23817ca85b5e2cba9cb1da3a1960fc-e-4" label="Particles">
        <attvalues>
          <attvalue for="0" value="Particles" />
          <attvalue for="1" value="Physical Entity" />
          <attvalue for="2" value="一组物理粒子，其组成个体的半径分别由r₁和r₂这两个符号所指代。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-ac23817ca85b5e2cba9cb1da3a1960fc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="132" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ac23817ca85b5e2cba9cb1da3a1960fc-e-7" label="τbλᵢ">
        <attvalues>
          <attvalue for="0" value="τbλᵢ" />
          <attvalue for="1" value="Force" />
          <attvalue for="2" value="τbλᵢ (Force): 指由施加的剪切应力所引起，并驱动颗粒剪切过程的一种作用力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ac23817ca85b5e2cba9cb1da3a1960fc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ac23817ca85b5e2cba9cb1da3a1960fc-e-8" label="Applied shear stress">
        <attvalues>
          <attvalue for="0" value="Applied shear stress" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="一种物理量，指与材料表面相切（平行）的应力分量。它由外部施加，能引起材料内部产生剪切力（如τbλᵢ），导致其截面发生相对错动或剪切变形。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-ac23817ca85b5e2cba9cb1da3a1960fc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a478184a271f81c44b621f35badc5f0a-e-1" label="Dislocation Pair">
        <attvalues>
          <attvalue for="0" value="Dislocation Pair" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="位错对是一种由两个独立的位错组成的晶体缺陷。这两个位错之间存在相互作用，并可能通过这种作用转变为一种能量更低的强耦合状态，形成“强耦合位错”。" />
          <attvalue for="3" value="{&quot;sense&quot;: &quot;same&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-a478184a271f81c44b621f35badc5f0a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Dislocation pairs&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a478184a271f81c44b621f35badc5f0a-e-1&quot;, &quot;chunk-2a630be2b8090ec92842cc9c1737eb42-e-4&quot;, &quot;chunk-af1f9e9d18ac9effde532d2b56262cf6-e-6&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a478184a271f81c44b621f35badc5f0a-e-7" label="Force Balance for First Dislocation">
        <attvalues>
          <attvalue for="0" value="Force Balance for First Dislocation" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="一个用于描述第一个位错的力平衡方程，其表达式为 τbλ₁ + R + F₁ = 0。该方程表明，当作用在位错上的驱动力(τbλ₁)、阻力(R)及其他外力(F₁)的矢量和为零时，该位错处于静态平衡状态。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;τbλ₁ + R + F₁ = 0&quot;, &quot;label&quot;: &quot;2.23a&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a478184a271f81c44b621f35badc5f0a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a478184a271f81c44b621f35badc5f0a-e-7&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a478184a271f81c44b621f35badc5f0a-e-8" label="Force Balance for Second Dislocation">
        <attvalues>
          <attvalue for="0" value="Force Balance for Second Dislocation" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="一个描述第二个位错（Second Dislocation）静态平衡条件的物理方程，其数学表达式为 τbλ₂ − R + F₂ = 0。该方程表明，作用于该位错上的驱动力（τbλ₂）、阻力（R）以及其他相互作用力（F₂）的矢量和为零。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;τbλ₂ − R + F₂ = 0&quot;, &quot;label&quot;: &quot;2.23b&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-a478184a271f81c44b621f35badc5f0a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a478184a271f81c44b621f35badc5f0a-e-8&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-70bdb361c16d13b8408a365565b5baba-e-1" label="F₁">
        <attvalues>
          <attvalue for="0" value="F₁" />
          <attvalue for="1" value="Mathematical Term" />
          <attvalue for="2" value="F₁ 是一个数学术语，指在特定方程或数学关系中，与另一项 F₂ 符号相反的量。它精确地满足关系式 F₁ = -F₂，意味着两者大小相等（绝对值相同），且代数和为零。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-70bdb361c16d13b8408a365565b5baba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-70bdb361c16d13b8408a365565b5baba-e-1&quot;]}]" />
          <attvalue for="9" value="250" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-70bdb361c16d13b8408a365565b5baba-e-2" label="F₂">
        <attvalues>
          <attvalue for="0" value="F₂" />
          <attvalue for="1" value="Mathematical Term" />
          <attvalue for="2" value="一个数学术语，指在方程中与 F₁ 符号相反的项。两者通常成对出现，其值大小相等、方向相反，满足数学关系 F₂ = -F₁ 或 F₁ + F₂ = 0。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-70bdb361c16d13b8408a365565b5baba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-70bdb361c16d13b8408a365565b5baba-e-2&quot;]}]" />
          <attvalue for="9" value="250" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-70bdb361c16d13b8408a365565b5baba-e-6" label="τc">
        <attvalues>
          <attvalue for="0" value="τc" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="τc是一个表示切削所需净剪应力的物理量。它由方程(2.24)给出数学定义，该定义是通过从方程(2.23a)和(2.23b)中消去变量R推导得出的。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-70bdb361c16d13b8408a365565b5baba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-70bdb361c16d13b8408a365565b5baba-e-6&quot;, &quot;chunk-fd08a4d01f900e8f06f5ce2b9d625965-e-5&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-70bdb361c16d13b8408a365565b5baba-e-7" label="R">
        <attvalues>
          <attvalue for="0" value="R" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="一个在特定方程组（2.23a和2.23b）中，为了求解另一个变量τc而被消去的中间变量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-70bdb361c16d13b8408a365565b5baba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-70bdb361c16d13b8408a365565b5baba-e-8" label="Equations (2.23a) and (2.23b)">
        <attvalues>
          <attvalue for="0" value="Equations (2.23a) and (2.23b)" />
          <attvalue for="1" value="Mathematical Equation" />
          <attvalue for="2" value="一组编号为(2.23a)和(2.23b)的联立数学方程。通过在该方程组中消去变量R，可以推导出净剪切应力τc。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-70bdb361c16d13b8408a365565b5baba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-70bdb361c16d13b8408a365565b5baba-e-9" label="Equation (2.24)">
        <attvalues>
          <attvalue for="0" value="Equation (2.24)" />
          <attvalue for="1" value="Mathematical Equation" />
          <attvalue for="2" value="方程(2.24)是一个数学公式，用于定义和计算在切削过程中产生的净剪切应力（τc）。它明确了该物理量的构成与计算方法。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;τc = (γAPB/b) * ((2r₁ - 2r₂)/(λ₁ + λ₂))&quot;, &quot;approximation&quot;: &quot;τc ≈ (γAPB/2b) * [(2r₁/λ₁) - (2r₂/λ₂)]&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-70bdb361c16d13b8408a365565b5baba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-70bdb361c16d13b8408a365565b5baba-e-9&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-26ae1c8b32c505920e532d6304655e87-e-1" label="τc">
        <attvalues>
          <attvalue for="0" value="τc" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="物理量τc，是一个由公式(2.24)定义的临界值。其数值取决于两个比值（2r₁/λ₁ 与 2r₂/λ₂）的差值，这两个比值通常与系统的尺寸和波长相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-26ae1c8b32c505920e532d6304655e87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-26ae1c8b32c505920e532d6304655e87-e-2" label="Equation (2.24)">
        <attvalues>
          <attvalue for="0" value="Equation (2.24)" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="方程(2.24)是一个数学公式，它将变量τc定义为另一组变量（γAPB, b, r₁, r₂, λ₁, λ₂）的函数。该公式明确了这些变量之间的定量关系，用于计算τc的值。" />
          <attvalue for="3" value="{&quot;expression&quot;: &quot;τc = (γAPB/b) * ((2r₁ - 2r₂)/(λ₁ + λ₂)) ≈ (γAPB/2b) * [(2r₁/λ₁) - (2r₂/λ₂)]&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-26ae1c8b32c505920e532d6304655e87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-26ae1c8b32c505920e532d6304655e87-e-5" label="λ₁ (Physical Quantity)">
        <attvalues>
          <attvalue for="0" value="λ₁ (Physical Quantity)" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="λ₁是一个物理量，由符号“λ₁”表示。在特定科学上下文中，它被用作公式(2.24)中的一个变量，其物理性质或数值预期与另一物理量λ₂高度相似。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-26ae1c8b32c505920e532d6304655e87" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;λ₁&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-26ae1c8b32c505920e532d6304655e87-e-5&quot;]}]" />
          <attvalue for="9" value="251" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-26ae1c8b32c505920e532d6304655e87-e-6" label="λ₂">
        <attvalues>
          <attvalue for="0" value="λ₂" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="λ₂是在公式(2.24)中定义的一个物理量变量，其数值和物理意义被认为与另一物理量λ₁高度相似。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-26ae1c8b32c505920e532d6304655e87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="251" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-26ae1c8b32c505920e532d6304655e87-e-7" label="difference between the ratios 2r₁/λ₁ and 2r₂/λ₂">
        <attvalues>
          <attvalue for="0" value="difference between the ratios 2r₁/λ₁ and 2r₂/λ₂" />
          <attvalue for="1" value="Mathematical Concept" />
          <attvalue for="2" value="在材料科学中，这是一个与位错相关的关键数学参数。它通过计算两组障碍物的几何特征（如尺寸r和间距λ）所形成的无量纲比率之差，来量化其对位错运动的影响，并直接决定材料发生塑性变形所需的临界剪切应力（τc）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-26ae1c8b32c505920e532d6304655e87" />
          <attvalue for="6" value="true" />
