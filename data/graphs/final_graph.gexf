        <attvalues>
          <attvalue for="11" value="OSCILLATED_DURING" />
          <attvalue for="12" value="The DC bias is oscillated during the EB-PVD process to create layers." />
          <attvalue for="13" value="oscillating the d.c. bias applied to the substrate during the EB-PVD process" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-8a09d4abdceadaee1556e78882f58629" />
