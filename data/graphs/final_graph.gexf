      <node id="chunk-92b406eccca67ea13b9ebc2a390eadd2-e-7" label="D. C. Punola">
        <attvalues>
          <attvalue for="0" value="D. C. Punola" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. C. Punola是一位作者，以其在材料科学领域的出版物《通过化学气相沉积的清洁扩散涂层》(Clean diffusion coatings by chemical vapour deposition) 而知名。该著作专注于研究一种利用化学气相沉积技术制备保护性涂层的方法。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
