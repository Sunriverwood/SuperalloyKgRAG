        <attvalues>
          <attvalue for="11" value="VARIES_IN" />
          <attvalue for="12" value="The resistance to shearing varies with the angle within the 23 plane." />
          <attvalue for="13" value="however, the resistance to shearing does vary with angle in the 23 plane." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-7468b5a535de86347797d4977b885a9e" />
          <attvalue for="16" value="0.00020614306328592042" />
