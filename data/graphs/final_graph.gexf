          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ae682ac4e4eb339bd48233482011cdd1-e-1" label="316">
        <attvalues>
          <attvalue for="0" value="316" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="316是一种常见的奥氏体不锈钢牌号。它在铬镍不锈钢的基础上添加了钼元素，这使其具有卓越的耐腐蚀性，尤其是优异的抗氯化物点蚀能力。因此，它被广泛应用于海洋环境、化学工业、食品加工及医疗器械等领域。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;179&quot;}" />
          <attvalue for="4" value="e-1" />
