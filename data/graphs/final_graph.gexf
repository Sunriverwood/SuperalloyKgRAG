        <attvalues>
          <attvalue for="11" value="INCREASES_SIZE_OF" />
          <attvalue for="12" value="Higher temperatures and larger AK increase the size of the reversible plastic zone." />
          <attvalue for="13" value="At higher temperatures and larger AK, which increases the size of the reversible plastic zone, slip is more homogeneous and 'wavy'." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-d8d142dae6b416fb1b1609254612e5f8" />
          <attvalue for="16" value="0.16666666666666666" />
          <attvalue for="17" value="0.5" />
