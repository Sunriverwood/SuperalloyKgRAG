        <attvalues>
          <attvalue for="11" value="DEPENDS_ON" />
          <attvalue for="12" value="The probability of an inclusion intersecting the free surface (P1) depends on the surface to volume ratio (S/V)." />
          <attvalue for="13" value="upon the surface to volume ratio, S/V" />
          <attvalue for="14" value="r-1" />
