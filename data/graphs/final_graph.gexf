        <attvalues>
          <attvalue for="11" value="IS_EXAMPLE_OF" />
          <attvalue for="12" value="Ti is provided as an example of a γ'-forming element." />
          <attvalue for="13" value="Proportions of y'-forming elements such as Al, Ti and Ta should be high, such that the γ' fraction is ~70%." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-ed24a575ccc7da550855ce4a7d4ebb9f" />
          <attvalue for="16" value="0.00027507613714510264" />
