        <attvalues>
          <attvalue for="11" value="INFLUENCES" />
          <attvalue for="12" value="The influence of the rafting effect on the creep capability of single-crystal superalloys is described as a controversial question." />
          <attvalue for="13" value="A controversial question concerns the influence of the rafting effect on the creep capability of the single-crystal superalloys." />
