        <attvalues>
          <attvalue for="11" value="CONTAINS" />
          <attvalue for="12" value="Paired dislocations consist of two dislocations, one of which is the first (leading) dislocation." />
          <attvalue for="13" value="consequently, the second trailing dislocation is some way behind the first" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-6c8bf2ccc7af91368e39bedeb76382ef" />
