      </node>
      <node id="chunk-2b0bf628a95c22fc39c3dcd9f2959fd7-e-9" label="Part geometry">
        <attvalues>
          <attvalue for="0" value="Part geometry" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="零件几何形状（Part geometry）是一项物理属性，指构成一个部件的形状、尺寸、公差及表面特征的集合。它作为关键的设计参数，直接影响制造工艺、材料行为以及最终产品的性能与完整性，例如其内部的残余应力分布。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-2b0bf628a95c22fc39c3dcd9f2959fd7" />
          <attvalue for="6" value="true" />
