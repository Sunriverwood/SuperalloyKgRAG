        <attvalues>
          <attvalue for="11" value="INFLUENCES" />
          <attvalue for="12" value="The environment has a considerable influence on fatigue crack growth in IN100." />
          <attvalue for="13" value="Related work on IN100 [28] has demonstrated a considerable influence of environment on the fatigue crac" />
