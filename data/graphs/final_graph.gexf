          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6eb99f000765a2ae4e04228357023bf7-e-1" label="No 9 combustor can">
        <attvalues>
          <attvalue for="0" value="No 9 combustor can" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="**9号燃烧罐 (No. 9 combustor can)**&#10;&#10;一个由哈氏合金X (Hastelloy X) 高温超合金构成的关键组件。其主要功能是容纳燃料与空气的燃烧过程，并引导所产生的高温高压气体。该组件因发生360度结构分离而被确定为初始故障点。" />
          <attvalue for="3" value="{&quot;failure_mode&quot;: &quot;360° separation&quot;, &quot;cycles_at_failure&quot;: &quot;3371&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-6eb99f000765a2ae4e04228357023bf7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="72" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6eb99f000765a2ae4e04228357023bf7-e-2" label="Hastelloy X">
        <attvalues>
          <attvalue for="0" value="Hastelloy X" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="哈氏X合金（Hastelloy X）是一种镍基固溶强化型高温合金。它以其优异的高温强度、杰出的抗氧化性以及良好的成形和焊接性能而著称，被广泛应用于航空发动机的燃烧室部件、工业炉及石油化工等领域的高温环境中。" />
          <attvalue for="3" value="{&quot;category&quot;: &quot;superalloy&quot;, &quot;form&quot;: &quot;sheet&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-6eb99f000765a2ae4e04228357023bf7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6eb99f000765a2ae4e04228357023bf7-e-2&quot;, &quot;chunk-f23caa328479b9d419f0d855b9335eb4-e-6&quot;]}]" />
          <attvalue for="9" value="72" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6eb99f000765a2ae4e04228357023bf7-e-3" label="Hot gases">
        <attvalues>
          <attvalue for="0" value="Hot gases" />
          <attvalue for="1" value="Physical Medium" />
          <attvalue for="2" value="一种高温气态物理介质。特指从失效的9号燃烧室罐中泄漏出的气体，它直接冲击燃烧室外壳，是导致外壳因过热而发生破裂的直接原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-6eb99f000765a2ae4e04228357023bf7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="72" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6eb99f000765a2ae4e04228357023bf7-e-4" label="Combustion chamber outer case">
        <attvalues>
          <attvalue for="0" value="Combustion chamber outer case" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种包围燃烧室的外部承压结构部件，用于承受燃烧产生的高温高压。若燃烧室内的高温气体直接冲击其表面，会造成局部过热，并可能导致该部件灾难性破裂。" />
          <attvalue for="3" value="{&quot;failure_mode&quot;: &quot;catastrophic rupture&quot;, &quot;failure_cause&quot;: &quot;localised overheating&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-6eb99f000765a2ae4e04228357023bf7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="72" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c10a0017a749c4bb59ab487c7354c02a-e-1" label="No 9 can">
        <attvalues>
          <attvalue for="0" value="No 9 can" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="No 9 can是一个曾表现出周向裂纹的部件。该部件在接受裂纹检查与修复后，于额外运行2036个循环后最终发生失效。" />
          <attvalue for="3" value="{&quot;inspected_after_cycles&quot;: &quot;3371&quot;, &quot;cycles_before_failure_post_repair&quot;: &quot;2036&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-c10a0017a749c4bb59ab487c7354c02a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="53" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c10a0017a749c4bb59ab487c7354c02a-e-2" label="Circumferential cracking">
        <attvalues>
          <attvalue for="0" value="Circumferential cracking" />
          <attvalue for="1" value="Damage" />
          <attvalue for="2" value="环向裂纹是一种沿圆筒或管状构件（如“No 9 can”）的圆周方向扩展的裂纹损伤。其裂纹路径与构件轴线垂直，是一种可修复的结构缺陷，例如通过熔焊技术进行修复。" />
          <attvalue for="3" value="{&quot;combined_length&quot;: &quot;180 mm&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c10a0017a749c4bb59ab487c7354c02a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="53" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c10a0017a749c4bb59ab487c7354c02a-e-3" label="Fusion welding">
        <attvalues>
          <attvalue for="0" value="Fusion welding" />
          <attvalue for="1" value="Repair Method" />
          <attvalue for="2" value="熔焊是一种通过加热熔化母材（常添加填充金属）来连接或修复金属部件的工艺。在本次应用中，它被用于修复部件上的环向裂纹。此修复流程的一个关键特点是，其后并未进行固溶处理和焊后应力消除热处理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c10a0017a749c4bb59ab487c7354c02a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="53" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c10a0017a749c4bb59ab487c7354c02a-e-4" label="Solutioning and weld stress-relief heat treatments">
        <attvalues>
          <attvalue for="0" value="Solutioning and weld stress-relief heat treatments" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种应用于焊接件的组合热处理工艺。它包含固溶处理和焊后应力消除处理两个阶段：固溶处理旨在使合金元素充分溶解形成均匀固溶体；应力消除处理则用于降低焊接产生的残余应力，共同改善材料的组织结构与力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c10a0017a749c4bb59ab487c7354c02a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="53" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c10a0017a749c4bb59ab487c7354c02a-e-5" label="Failure">
        <attvalues>
          <attvalue for="0" value="Failure" />
          <attvalue for="1" value="Event" />
          <attvalue for="2" value="指“9号罐”在接受维修后，额外运行了2036个周期后发生的最终功能丧失事件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c10a0017a749c4bb59ab487c7354c02a" />
