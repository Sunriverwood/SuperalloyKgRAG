        <attvalues>
          <attvalue for="11" value="INITIALLY_FORMS" />
          <attvalue for="12" value="A transient NiO/Ni(Al, Cr)2O4 mixed external scale initially forms on Group II alloys." />
          <attvalue for="13" value="Initially, a transient NiO/Ni(Al, Cr)2O4 mixed external scale and Cr2O3/Al2O3 sub-scale form as before" />
