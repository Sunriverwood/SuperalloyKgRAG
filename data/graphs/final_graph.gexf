      <edge source="chunk-bf602d6d22c552a1206d1179123ca1f7-e-8" target="chunk-bf602d6d22c552a1206d1179123ca1f7-e-9" id="chunk-bf602d6d22c552a1206d1179123ca1f7-r-8" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_DEFINED_BY" />
          <attvalue for="12" value="The misfit strain (εT) is equal to the product of Δα and ΔΤ." />
          <attvalue for="13" value="where the misfit strain, єT, is equal to Δα × ΔΤ" />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-bf602d6d22c552a1206d1179123ca1f7" />
          <attvalue for="16" value="0.0006184291898577612" />
