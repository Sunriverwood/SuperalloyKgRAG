      <node id="chunk-65817dd1ccad389cffd2a92e861510de-e-3" label="λ (general Greek letter / multi-domain symbol)">
        <attvalues>
          <attvalue for="0" value="λ (general Greek letter / multi-domain symbol)" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="λ (Lambda) 是第十一个希腊字母的小写形式。作为一个变量符号，它在科学与工程领域被广泛使用。λ 常用于代表物理学中的波长、数学中的特征值、统计学中的速率参数，或计算机科学中的Lambda函数（匿名函数）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-65817dd1ccad389cffd2a92e861510de" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;λ&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-65817dd1ccad389cffd2a92e861510de-e-3&quot;]}]" />
          <attvalue for="9" value="277" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-65817dd1ccad389cffd2a92e861510de-e-4" label="Extremum condition">
        <attvalues>
          <attvalue for="0" value="Extremum condition" />
          <attvalue for="1" value="Criterion" />
          <attvalue for="2" value="极值条件是一种判定准则，它规定了当某一参数（如'a'）的取值能使变量ΔT达到最小值或使变量v达到最大值时，生长将会发生。该准则旨在确定系统达到最优生长状态的临界点。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-65817dd1ccad389cffd2a92e861510de" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-65817dd1ccad389cffd2a92e861510de-e-5" label="Equation (3.15)">
        <attvalues>
          <attvalue for="0" value="Equation (3.15)" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="方程(3.15)是一个由极值条件经代数变换推导出的数学表达式。该方程包含变量v，可用于导出∆T/8λ=0的结论，并且是方程(3.16)的一种等价形式。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;vG2λ4 = 40 Dmco(1 – k)&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-65817dd1ccad389cffd2a92e861510de" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-65817dd1ccad389cffd2a92e861510de-e-6" label="Equation (3.16)">
        <attvalues>
          <attvalue for="0" value="Equation (3.16)" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="方程(3.16)是方程(3.15)的一种替代形式，为一个包含变量'v'的数学表达式。" />
