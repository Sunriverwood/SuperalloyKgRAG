        <attvalues>
          <attvalue for="11" value="HAS_FORM" />
          <attvalue for="12" value="Wrought superalloys are employed in polycrystalline form." />
          <attvalue for="13" value="Table 1.4 lists the chemical compositions of common wrought superalloys, which are employed therefore in polycrystalline form." />
