      <node id="chunk-9de67a861b4260c65467b4b0d1d09a13-e-5" label="S. C. Kung">
        <attvalues>
          <attvalue for="0" value="S. C. Kung" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="S. C. Kung是一位研究人员，其撰写的科学论文为《Analyses of the gaseous species in halide-activated cementation coating packs》。该研究属于材料科学领域，内容聚焦于分析卤化物活化渗镀涂层工艺中的气态物质组分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
