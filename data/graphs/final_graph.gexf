      <node id="chunk-311ad4452372c744328957f626b3057d-e-11" label="Ni-based superalloy turbine discs">
        <attvalues>
          <attvalue for="0" value="Ni-based superalloy turbine discs" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="镍基高温合金涡轮盘是由镍基高温合金材料制成的关键旋转部件，主要用于航空发动机和燃气轮机的热端。其核心功能是在极端的高温、高转速和高应力环境下承载涡轮叶片，对发动机的性能和安全至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-311ad4452372c744328957f626b3057d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-070dbf53e1878b9845a3e7782a58ad66-e-1" label="activation energy">
        <attvalues>
          <attvalue for="0" value="activation energy" />
          <attvalue for="1" value="Physical Concept" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;活化能（Activation Energy）是引发一个物理过程（如原子扩散、材料蠕变）或化学反应所需的最低能量。它是一个必须被克服的能量势垒，其大小决定了过程发生的速率。活化能越低，过程越容易发生且速率越快。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-070dbf53e1878b9845a3e7782a58ad66" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-070dbf53e1878b9845a3e7782a58ad66-e-2" label="creep deformation processes">
        <attvalues>
          <attvalue for="0" value="creep deformation processes" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="一种物理过程，指固体材料在持续应力（尤其在高温）下，发生缓慢且持续的塑性变形。作为一种热激活过程，其变形速率由激活能、温度和应力共同决定，是导致材料长期失效的关键机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-070dbf53e1878b9845a3e7782a58ad66" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-070dbf53e1878b9845a3e7782a58ad66-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-070dbf53e1878b9845a3e7782a58ad66-e-6" label="alloy powder">
        <attvalues>
          <attvalue for="0" value="alloy powder" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;合金粉末（Alloy Powder）是一种由合金制成的粉末状材料形态。它通过特定制造工艺生产，通常作为粉末冶金或增材制造的原料，经过压制、烧结等固结过程，用于生产具有特定性能的金属部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-070dbf53e1878b9845a3e7782a58ad66" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-070dbf53e1878b9845a3e7782a58ad66-e-8" label="manufacture">
        <attvalues>
          <attvalue for="0" value="manufacture" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="一种专用于生产合金粉末的制造过程。该过程通过特定的工业技术和方法，将一种或多种金属及非金属原料转化为具有特定成分和粒度的粉末状合金材料，作为其最终产出物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-070dbf53e1878b9845a3e7782a58ad66" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-070dbf53e1878b9845a3e7782a58ad66-e-9" label="alloying addition">
        <attvalues>
          <attvalue for="0" value="alloying addition" />
          <attvalue for="1" value="Material Role" />
          <attvalue for="2" value="作为一种材料角色，**合金添加物 (Alloying Addition)** 指为改善基体金属或合金的特定性能（如耐腐蚀性、强度等）而特意加入的元素或物质。它通过改变材料的化学成分和微观结构，来优化或赋予其所需的物理、化学或机械性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-070dbf53e1878b9845a3e7782a58ad66" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Alloying Addition&quot;, &quot;Alloying addition&quot;, &quot;Alloying additions&quot;, &quot;alloying additions&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-738d5a08a05f18670227192d3b2434f7-e-8&quot;, &quot;chunk-3029d23645f5b8329b94fe4d5e582d6f-e-4&quot;, &quot;chunk-1cfc07c1de96187a9aff83a89de841ed-e-3&quot;, &quot;chunk-ee8fa246fa35655243004b46a963f27f-e-6&quot;, &quot;chunk-070dbf53e1878b9845a3e7782a58ad66-e-9&quot;, &quot;chunk-5d942c8f1c01db54bab51b31faea4836-e-1&quot;, &quot;chunk-870742dec10263e0078e94a0b6a827aa-e-16&quot;, &quot;chunk-569a3d8aec20d9df6a256b4cf4b263a7-e-4&quot;, &quot;chunk-a9fba026e3b8980c4957dbe16260f585-e-15&quot;, &quot;chunk-1159c2afbaaccc92d505d71fb856dee1-e-9&quot;, &quot;chunk-3d0590efade07af78fea353ef909c7ec-e-8&quot;, &quot;chunk-23df60e783372fb64b1a5a9966ec4edc-e-11&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="11" />
        </attvalues>
      </node>
      <node id="chunk-9f8adabfb1010fa4a4528e361c3f5223-e-1" label="um">
        <attvalues>
          <attvalue for="0" value="um" />
          <attvalue for="1" value="Index Term" />
          <attvalue for="2" value="um，即微米（micrometre），是国际单位制中的长度单位，符号为μm。它等于一米的百万分之一（10⁻⁶ m），也称“微米”（micron）。常用于描述细胞、粒子等微观物体的尺寸。" />
          <attvalue for="3" value="{&quot;references&quot;: &quot;34-35, 51, 88, 164, 220, 284, 305&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-9f8adabfb1010fa4a4528e361c3f5223" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="365" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-78c519f8cce4113c48c714a60ca273ce-e-6" label="Alloy 10">
        <attvalues>
          <attvalue for="0" value="Alloy 10" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="Alloy 10是一种金属材料，为合金的一种具体牌号。由于缺乏详细信息，其具体的化学成分、物理性能、制造标准及应用领域需要根据特定的技术文件或上下文来确定。" />
