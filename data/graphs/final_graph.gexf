      </node>
      <node id="chunk-edb9affa83770653e14e4cc8e96d4809-e-4" label="W. D. Kingery">
        <attvalues>
          <attvalue for="0" value="W. D. Kingery" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="W. D. Kingery (William David Kingery) 是一位美国材料科学家，被誉为“现代陶瓷之父”。他是将材料科学原理系统地应用于陶瓷研究的先驱，其工作奠定了现代物理陶瓷学的基础，对陶瓷的烧结、微观结构和性能关系等领域做出了开创性贡献。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-edb9affa83770653e14e4cc8e96d4809" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-edb9affa83770653e14e4cc8e96d4809-e-6" label="single-phase ceramics">
        <attvalues>
          <attvalue for="0" value="single-phase ceramics" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种由单一、均匀物相构成的陶瓷材料。它具有均质的微观结构，其热导率是材料科学中的一个重要研究参数，并在W. D. Kingery的经典论文中得到了重点研究。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-edb9affa83770653e14e4cc8e96d4809" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-edb9affa83770653e14e4cc8e96d4809-e-7" label="Journal of the American Ceramic Society">
        <attvalues>
          <attvalue for="0" value="Journal of the American Ceramic Society" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《美国陶瓷学会杂志》(Journal of the American Ceramic Society) 是一本由美国陶瓷学会 (ACerS) 出版的同行评审学术期刊。该期刊发表关于陶瓷科学、工程与技术等领域的原创研究论文、综述及通讯，是全球陶瓷和材料科学领域最具影响力的核心刊物之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-edb9affa83770653e14e4cc8e96d4809" />
          <attvalue for="6" value="true" />
