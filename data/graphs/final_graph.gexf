        <attvalues>
          <attvalue for="11" value="HAS_MAXIMUM_VALUE_AT" />
          <attvalue for="12" value="The anisotropy term reaches its maximum value of one-third along the (111) direction." />
          <attvalue for="13" value="a maximum value of one-third along (111)" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-9b96433e844031d4f15964cb1b24320d" />
          <attvalue for="16" value="0.0020242914979757085" />
          <attvalue for="17" value="0.4012145748987854" />
