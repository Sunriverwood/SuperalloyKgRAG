        <attvalues>
          <attvalue for="11" value="COMPRISES" />
          <attvalue for="12" value="The production of the disc includes the blocking stage." />
          <attvalue for="13" value="Again the production of the disc is usually a three-stage process, typically comprising... (ii) blocking by closed-die forging..." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-eb085f02bba98b62b26a7b0962fa3843" />
          <attvalue for="16" value="0.00014005602240896358" />
