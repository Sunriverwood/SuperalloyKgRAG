          <attvalue for="9" value="30" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b18667fadfdf7cfdf2bd35cc10bf1f84-e-1" label="The Metals Society">
        <attvalues>
          <attvalue for="0" value="The Metals Society" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="一个于1974年至1985年间存在的英国学术团体，由英国钢铁学会和金属学会合并而成。该组织专注于冶金与材料科学，是该领域的知名出版商，后合并成为英国金属学会(The Institute of Metals)。" />
          <attvalue for="3" value="{&quot;location&quot;: &quot;London&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-b18667fadfdf7cfdf2bd35cc10bf1f84" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="430" />
          <attvalue for="10" value="0" />
