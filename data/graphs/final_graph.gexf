        <attvalues>
          <attvalue for="11" value="COMPETES_WITH" />
          <attvalue for="12" value="There is a competition between the failure mechanism of delamination from edges and the buckling of the TGO." />
          <attvalue for="13" value="Emphasis is placed on the competition (see Figure 5.53) between (i) delamination from edges... and (ii) buckling of the TGO from pre-existing interfacial separations which have already nucleated." />
          <attvalue for="14" value="r-1" />
