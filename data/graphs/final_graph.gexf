        <attvalues>
          <attvalue for="11" value="IS_A_PARAMETER_OF" />
          <attvalue for="12" value="Cooling rates are a characteristic parameter of the atomization process." />
          <attvalue for="13" value="Cooling rates are typically in excess of 100°C/s, being greater for finer particles." />
          <attvalue for="14" value="r-8" />
