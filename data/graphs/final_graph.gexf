      <edge source="chunk-28445053586870da241f4ba6806f06eb-e-6" target="chunk-28445053586870da241f4ba6806f06eb-e-3" id="chunk-28445053586870da241f4ba6806f06eb-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_CALCULATED_FROM" />
          <attvalue for="12" value="The transformed component S'11 is calculated using the direction cosines (l1, l2, l3)." />
          <attvalue for="13" value="S'11 = [l1^4S11 + 2l1^2l2^2S12 + 2l1^2l3^2S13 + 2l1^2l2l3S14 + 2l1^3l3S15 + 2l1^3l2S16 + l2^4S22 + 2l2^2l3^" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-28445053586870da241f4ba6806f06eb" />
