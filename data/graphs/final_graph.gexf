      <node id="chunk-ae682ac4e4eb339bd48233482011cdd1-e-15" label="Rene 80">
        <attvalues>
          <attvalue for="0" value="Rene 80" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="Rene 80是一种镍基高温合金，以其卓越的高温强度和抗氧化性著称。它被广泛用作焊接材料，用于修复航空发动机和工业燃气轮机中的高压（HP）涡轮叶片等在高温严苛环境下工作的关键部件。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;6&quot;}" />
