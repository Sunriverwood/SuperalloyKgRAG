        <attvalues>
          <attvalue for="0" value="D. Raynor" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. Raynor是一位学者，是关于材料科学的科技著作《涂层高温合金的热机械疲劳》（Thermomechanical fatigue of coated superalloys）的作者。" />
          <attvalue for="3" value="{}" />
