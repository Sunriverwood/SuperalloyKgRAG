        <attvalues>
          <attvalue for="11" value="SIMILARLY_AFFECTED_AS" />
          <attvalue for="12" value="Incoherent γ/γ' boundaries were found to be similarly affected by segregation as the y/y grain boundaries." />
          <attvalue for="13" value="Incoherent γ/γ' boundaries were found to be similarly affected." />
