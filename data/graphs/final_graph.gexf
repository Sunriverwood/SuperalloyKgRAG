        <attvalues>
          <attvalue for="11" value="CAUSES_FORMATION_OF" />
          <attvalue for="12" value="Group II alloys cause the internal precipitation of Al2O3." />
          <attvalue for="13" value="causes an external scale of Cr2O3 and internal precipitation of Al2O3" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-fda27af1d78f24b216020258d3d0926f" />
