        <attvalues>
          <attvalue for="0" value="v" />
          <attvalue for="1" value="Process Variable" />
          <attvalue for="2" value="一个过程变量，符号为v。该变量与一次枝晶臂间距（Lp）成正比关系，是影响Lp的因素之一，但其影响程度小于另一个变量G。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-398a384cc3aa286c4fab7654b4862802" />
