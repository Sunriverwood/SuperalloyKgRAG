      <edge source="chunk-44ba0b547d89e889a875ab5cd81995c8-e-1" target="chunk-8981e8877dd5635849029e4451056d6d-e-8" id="chunk-8981e8877dd5635849029e4451056d6d-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_A" />
          <attvalue for="12" value="Homologous temperature is identified as one of the most important dimensionless groups." />
          <attvalue for="13" value="One can see that the most important dimen- sionless groups are the homologous temperature, T/Tm" />
