        </attvalues>
      </node>
      <node id="chunk-1abe15e2f2db1602f97ac75bb847ef30-e-16" label="CVD NiAl bond coat">
        <attvalues>
          <attvalue for="0" value="CVD NiAl bond coat" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="CVD NiAl粘结涂层是一种通过化学气相沉积（CVD）工艺制备的镍铝（NiAl）金属间化合物涂层。它主要用作热障涂层系统中的粘结层，作用是增强陶瓷面层与高温合金基体的结合力，并在高温下形成致密的氧化物层，为基体提供抗氧化保护。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-1abe15e2f2db1602f97ac75bb847ef30" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;CVD NiAl bond coatings&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cd90df188efe63a1aba2d62ab225c3ae-e-7&quot;, &quot;chunk-1abe15e2f2db1602f97ac75bb847ef30-e-16&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-cd90df188efe63a1aba2d62ab225c3ae-e-1" label="Wright">
        <attvalues>
          <attvalue for="0" value="Wright" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="一名学者，其论文《Influence of sulphur, platinum and hafnium on the oxidation behaviour of CVD NiAl bond coatings》研究了硫、铂和铪等元素对化学气相沉积（CVD）NiAl粘结涂层氧化行为的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-cd90df188efe63a1aba2d62ab225c3ae" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cd90df188efe63a1aba2d62ab225c3ae-e-1&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cd90df188efe63a1aba2d62ab225c3ae-e-2" label="Influence of sulphur, platinum and hafnium on the oxidation behaviour of CVD NiAl bond coatings">
        <attvalues>
          <attvalue for="0" value="Influence of sulphur, platinum and hafnium on the oxidation behaviour of CVD NiAl bond coatings" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="这是一篇由赖特（Wright）等人撰写，于2002年发表在《Oxidation of Metals》期刊上的学术论文。该研究探讨了化学气相沉积（CVD）NiAl粘结涂层的氧化行为，并重点分析了硫（sulphur）、铂（platinum）和铪（hafnium）这三种元素对该行为的具体影响。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2002&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-cd90df188efe63a1aba2d62ab225c3ae" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cd90df188efe63a1aba2d62ab225c3ae-e-2&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-cd90df188efe63a1aba2d62ab225c3ae-e-8" label="R. Prescott">
        <attvalues>
          <attvalue for="0" value="R. Prescott" />
          <attvalue for="1" value="Researcher" />
          <attvalue for="2" value="R. Prescott，学者，科技论文《用SIMS测定β-NiAl+Zr的氧化机理》的作者之一。该研究聚焦于添加了锆的β-NiAl（镍铝）合金的氧化机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
