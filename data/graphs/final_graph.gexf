        <attvalues>
          <attvalue for="11" value="OUTWEIGHS" />
          <attvalue for="12" value="The contribution from order strengthening is greater than the contribution from modulus differences in nickel-based alloys." />
          <attvalue for="13" value="Indeed, in the nickel-based alloys, the contribution from order strengthening outweighs other contributions due to differences of modulus, stacking fault energy, interfacial energy and Orowan strengthening." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-41c4572391c7a506f02a50c6ea737ecc" />
