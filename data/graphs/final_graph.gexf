      <edge source="chunk-44ba0b547d89e889a875ab5cd81995c8-e-1" target="chunk-ebfa8b7ae005eda909fbe4d14158391d-e-4" id="chunk-ebfa8b7ae005eda909fbe4d14158391d-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_IMPORTANT_FOR" />
          <attvalue for="12" value="The homologous temperature is one of the most important dimensionless groups for analyzing high-temperature performance." />
          <attvalue for="13" value="an see that the most important dimen- sionless groups are the homologous temperature, T/Tm, and the combination Qv/(RTm)." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-ebfa8b7ae005eda909fbe4d14158391d" />
          <attvalue for="16" value="0.0006184291898577612" />
