      <node id="chunk-d5ce586afcf8fd710ae4779854d26909-e-8" label="Nb-I">
        <attvalues>
          <attvalue for="0" value="Nb-I" />
          <attvalue for="1" value="Exotic Alloy" />
          <attvalue for="2" value="Nb-I是一种异种合金，被认为是一种极具潜力的高温材料。尽管其性能前景备受关注，但该合金目前尚未在燃气轮机中获得实际应用。" />
