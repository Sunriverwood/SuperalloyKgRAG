      <node id="chunk-b9dbde7895f392734e33f1d55d95cc73-e-11" label="Thermo-mechanical fatigue tests of coatings">
        <attvalues>
          <attvalue for="0" value="Thermo-mechanical fatigue tests of coatings" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Thermo-mechanical fatigue tests of coatings for turbine blades》是一篇由Y. A. Tamarin、V. G. Sundyrin和N. G. Bychkov合著的研究出版物，主要内容为涡轮叶片涂层的热机械疲劳测试，发表于《High Temperature Surface Engineering》。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
