        <attvalues>
          <attvalue for="11" value="INTERACTS_WITH" />
          <attvalue for="12" value="Yttrium interacts with indigenous sulphur to form compounds." />
          <attvalue for="13" value="these also confirmed a role of yttrium in interacting with indigenous sulphur to form refractory sulphides" />
          <attvalue for="14" value="r-1" />
