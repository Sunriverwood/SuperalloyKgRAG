        <attvalues>
          <attvalue for="11" value="USES" />
          <attvalue for="12" value="The constitutive equations (A1) use elastic constants (C11, C12, C44) as coefficients to relate stress and strain." />
          <attvalue for="13" value="σ11 = C11€11 + C12€22 + C12€33" />
