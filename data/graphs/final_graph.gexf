      <node id="chunk-92b406eccca67ea13b9ebc2a390eadd2-e-1" label="A. B. Smith">
        <attvalues>
          <attvalue for="0" value="A. B. Smith" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="A. B. Smith是一位学者或研究人员，作为作者之一发表了学术出版物《Vapour aluminide coating of internal cooling channels in turbine blades and vanes》。该著作主要研究应用于涡轮叶片等关键部件的先进表面涂层技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
