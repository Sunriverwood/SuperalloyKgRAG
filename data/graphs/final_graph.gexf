        </attvalues>
      </node>
      <node id="chunk-5b143324ae92718a4dde1cd69bd72bd2-e-6" label="Isotope 58">
        <attvalues>
          <attvalue for="0" value="Isotope 58" />
          <attvalue for="1" value="Isotope" />
          <attvalue for="2" value="镍-58（化学符号：⁵⁸Ni）是化学元素镍的一种稳定同位素，也是其丰度最高的同位素，自然丰度约为68.077%。其原子核由28个质子和30个中子构成，性质稳定，不会发生放射性衰变。" />
          <attvalue for="3" value="{&quot;probability&quot;: &quot;67.7%&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-5b143324ae92718a4dde1cd69bd72bd2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5b143324ae92718a4dde1cd69bd72bd2-e-7" label="Nickel-60">
        <attvalues>
          <attvalue for="0" value="Nickel-60" />
          <attvalue for="1" value="Isotope" />
          <attvalue for="2" value="镍-60（⁶⁰Ni）是化学元素镍的一种稳定同位素，也是其丰度最高的同位素（约占26.223%）。它的原子核由28个质子和32个中子构成。" />
          <attvalue for="3" value="{&quot;probability&quot;: &quot;26.2%&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-5b143324ae92718a4dde1cd69bd72bd2" />
          <attvalue for="6" value="true" />
