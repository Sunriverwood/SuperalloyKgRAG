        <attvalues>
          <attvalue for="11" value="PERFORMED_BY" />
          <attvalue for="12" value="The finishing operation is performed using closed-die forging." />
          <attvalue for="13" value="finishing, again by closed-die forging, to produce the desired disc shape." />
