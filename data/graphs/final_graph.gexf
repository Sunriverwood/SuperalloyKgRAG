        </attvalues>
      </node>
      <node id="chunk-78c519f8cce4113c48c714a60ca273ce-e-7" label="AM1">
        <attvalues>
          <attvalue for="0" value="AM1" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="AM1是一种由法国开发的镍基单晶高温合金。它具有优异的高温强度、抗蠕变及抗疲劳性能，被广泛应用于航空航天领域，是制造先进航空发动机涡轮叶片等关键热端部件的核心材料。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;188&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-78c519f8cce4113c48c714a60ca273ce" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-78c519f8cce4113c48c714a60ca273ce-e-9" label="CMSX-2">
        <attvalues>
          <attvalue for="0" value="CMSX-2" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="CMSX-2是一种第一代镍基单晶高温合金，以其卓越的高温强度、抗蠕变和抗氧化性能而著称。它主要用于制造航空发动机和工业燃气轮机中的高性能涡轮叶片等关键热端部件。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;158&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-78c519f8cce4113c48c714a60ca273ce" />
