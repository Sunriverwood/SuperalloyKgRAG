        <attvalues>
          <attvalue for="11" value="FORMS" />
          <attvalue for="12" value="Oxidation of Group III alloys results in the exclusive formation of a compact external Al2O3 scale." />
          <attvalue for="13" value="oxidation of Group III alloys - which possess appreciable concentrations of both chromium and aluminium – result in the exclusive formation of a compact external Al2O3 scale" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-bb636c80a00702ec9bbe14461e908287" />
          <attvalue for="16" value="0.0008499932000543995" />
