      <node id="chunk-63304b61ed04760729e5b6e71982902a-e-4" label="last few thousand cycles">
        <attvalues>
          <attvalue for="0" value="last few thousand cycles" />
          <attvalue for="1" value="Time Period" />
          <attvalue for="2" value="指材料疲劳寿命的末期阶段。在此期间，疲劳裂纹以加速方式不稳定扩展，占据了裂纹扩展总量的绝大部分，并迅速导致最终断裂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-63304b61ed04760729e5b6e71982902a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-63304b61ed04760729e5b6e71982902a-e-5" label="fatigue life estimates">
        <attvalues>
          <attvalue for="0" value="fatigue life estimates" />
          <attvalue for="1" value="Calculation" />
          <attvalue for="2" value="一种预测材料或结构在循环载荷作用下，发生失效前所能承受的循环次数的计算方法。其估算结果通常偏于保守，即预测寿命低于实际寿命，旨在确保工程应用的安全。" />
          <attvalue for="3" value="{&quot;characteristic&quot;: &quot;usually conservative&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-63304b61ed04760729e5b6e71982902a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="303" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-378cff7c7b5d0dedcf7174df0a8eba7a-e-1" label="Service life estimation">
        <attvalues>
          <attvalue for="0" value="Service life estimation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;服务寿命估算，是预测产品、设备或结构在特定工作条件下，能维持其预定功能的时间周期的过程。它综合考虑材料特性、设计载荷、环境因素及失效机理，通过分析或试验方法进行评估，为可靠性设计、维护策略和资产管理提供关键依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-378cff7c7b5d0dedcf7174df0a8eba7a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-378cff7c7b5d0dedcf7174df0a8eba7a-e-1&quot;, &quot;chunk-e3527c9f74d686641ceba7afb52a8ef3-e-2&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-378cff7c7b5d0dedcf7174df0a8eba7a-e-3" label="Disc">
        <attvalues>
          <attvalue for="0" value="Disc" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="盘件 (Disc) 是一种在发动机中运行的寿命周期件，具有设定的工作循环寿命。为确保其结构完整性，必须定期采用无损检测 (NDE) 技术对其进行探伤，以发现和评估潜在缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-378cff7c7b5d0dedcf7174df0a8eba7a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-378cff7c7b5d0dedcf7174df0a8eba7a-e-5" label="Engine">
        <attvalues>
          <attvalue for="0" value="Engine" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="一种系统级组件，作为盘片（Disc）的驱动装置和承载平台。它为盘片提供旋转动力和物理支持，使其能够在其内部稳定地运行并执行预定功能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-378cff7c7b5d0dedcf7174df0a8eba7a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-378cff7c7b5d0dedcf7174df0a8eba7a-e-6" label="Flaws">
        <attvalues>
          <attvalue for="0" value="Flaws" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="一种缺陷，指材料或构件中存在的、可能损害其性能或完整性的不完美之处（如裂纹、夹杂物）。它是质量控制中需要重点关注的对象，通常通过无损检测(NDE)等技术手段进行探测和评估。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-378cff7c7b5d0dedcf7174df0a8eba7a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;flaws&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-378cff7c7b5d0dedcf7174df0a8eba7a-e-6&quot;, &quot;chunk-d6790fb9c1169445a5d3fb409c8aba9c-e-13&quot;, &quot;chunk-bf4677fbc731927f738fe825e4a4dab8-e-3&quot;, &quot;chunk-0cc0ddc3943d8f2fd7c506b872a6a90c-e-2&quot;, &quot;chunk-a0bc17e9304523fcbd1eb1f1e003c749-e-10&quot;, &quot;chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-16&quot;, &quot;chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676-e-2&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-095e7b19e19ba75f3f37b75ed9ca8622-e-5" label="engine">
        <attvalues>
          <attvalue for="0" value="engine" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="在损伤容限方法中，一种用于承载其他组件并对其施加指定循环载荷的测试机器或装置。其核心功能是作为测试平台，用以评估和验证组件的耐久性与损伤容限性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-095e7b19e19ba75f3f37b75ed9ca8622" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec-e-5" label="Temperature">
        <attvalues>
          <attvalue for="0" value="Temperature" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="一种物理条件，指低于600°C的温度范围。在此区间内，合金的规定强度（Proof Strength）受温度影响较小，表现出相对稳定性。" />
          <attvalue for="3" value="{&quot;threshold&quot;: &quot;below 600 °C&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec-e-6" label="aNDI">
        <attvalues>
          <attvalue for="0" value="aNDI" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="aNDI limit (无损检测极限) 是损伤容限分析中的一个关键参数，指特定无损检测(NDI)方法可稳定检出的最小初始缺陷尺寸。该限值基于特定运行寿命周期（如10000次循环）确定，用以确保任何初始缺陷在该寿命内不会扩展至危险程度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Non-destructive Inspection Limit (aNDI)&quot;, &quot;aNDI limit&quot;, &quot;a_NDI&quot;, &quot;non-destructive inspection limit (aNDI)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d6cd281784308ff093a41e825b50764e-e-11&quot;, &quot;chunk-f73ef33407197a56c2a6d96f014100a5-e-1&quot;, &quot;chunk-c07d98a8c6e8b07242a68bd712fcfe4c-e-11&quot;, &quot;chunk-57054d164541d83734201813bb4b9d8f-e-2&quot;, &quot;chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec-e-6&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec-e-7" label="10,000 cycles">
        <attvalues>
          <attvalue for="0" value="10,000 cycles" />
          <attvalue for="1" value="Lifetime Target" />
          <attvalue for="2" value="一项关键的设计寿命指标，指产品在发生爆裂或完全功能失常等严重故障前，所必须承受的最低工作循环次数。它定义了产品在设计使用年限内的基本耐久性与可靠性要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec-e-7&quot;, &quot;chunk-e3a4ba849abe93a2a6728157cbd079b2-e-5&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec-e-8" label="Burst">
        <attvalues>
          <attvalue for="0" value="Burst" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="Burst是一种导致完全功能失调的严重故障模式。设计要求其在10,000次循环前不得发生，系统通过检测aNDI信号对其进行预防。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec-e-9" label="K1c">
        <attvalues>
          <attvalue for="0" value="K1c" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="K1c是一个关键参数，其估计值是测算或评估另一项指标aNDI数值的核心依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
