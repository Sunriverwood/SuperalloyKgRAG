      <node id="chunk-28027332c1e907d2b9fb62cbdc68fd6c-e-13" label="Future developments in plasma spray coating">
        <attvalues>
          <attvalue for="0" value="Future developments in plasma spray coating" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由A. R. Nicholl、H. Gruner、G. Wuest及S. Keller共同撰写的学术文章，该文于1986年发表在期刊《Materials Science and Technology》上，探讨了等离子喷涂涂层的未来发展。" />
          <attvalue for="3" value="{}" />
