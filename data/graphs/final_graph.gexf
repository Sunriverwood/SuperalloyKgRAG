      <node id="chunk-22f7760442ee5013f08b1b2ce224b483-e-3" label="the book">
        <attvalues>
          <attvalue for="0" value="the book" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一种为特定单学期课程设计的教学出版物。其内容经过精心筛选与编排，旨在系统性地覆盖该课程的教学大纲和学习目标，通常作为学生的核心教材或指定的学习资料。" />
