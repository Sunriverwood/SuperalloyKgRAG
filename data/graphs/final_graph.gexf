        <attvalues>
          <attvalue for="11" value="CAUSES_INCREASE_IN" />
          <attvalue for="12" value="The decrease in y' particle size is the stated reason for the increase in the FCP rate." />
          <attvalue for="13" value="the FCP rate increased by about a factor of 4 ... because the y' particle size decreased from 250 nm to 170 nm" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-1af21239034eac9b97020a65cbbdcded" />
