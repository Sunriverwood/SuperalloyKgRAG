      <node id="chunk-bdbf4600f0f46ee6111ce0bae60fe800-e-14" label="R. R. Bowman">
        <attvalues>
          <attvalue for="0" value="R. R. Bowman" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="R. R. Bowman是一位编辑，以其担任科技出版物《Superalloys 2000》编辑的身份而知名。他/她的主要贡献是对该出版物的编辑工作。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-bdbf4600f0f46ee6111ce0bae60fe800" />
