        <attvalues>
          <attvalue for="0" value="∆To" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="变量 ∆To，是用于定义另一变量 R 的一个基本参数。它同时也是构建特定数学关系式，即公式 (3.14) 的关键构成要素。" />
          <attvalue for="3" value="{}" />
