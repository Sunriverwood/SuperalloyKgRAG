      <edge source="chunk-78865a21d21766b0dd173d92dcbbfc0d-e-2" target="chunk-78865a21d21766b0dd173d92dcbbfc0d-e-6" id="chunk-78865a21d21766b0dd173d92dcbbfc0d-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="INCREASES" />
          <attvalue for="12" value="The alloying element Ru increases the cost." />
          <attvalue for="13" value="for example, Ru improves stability but increases cost" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-78865a21d21766b0dd173d92dcbbfc0d" />
          <attvalue for="16" value="0.00012484394506866417" />
          <attvalue for="17" value="0.40007490636704124" />
        </attvalues>
      </edge>
      <edge source="chunk-78865a21d21766b0dd173d92dcbbfc0d-e-4" target="chunk-b821a94296e5e31338263fc084ea39d5-e-6" id="chunk-78865a21d21766b0dd173d92dcbbfc0d-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IMPROVES" />
          <attvalue for="12" value="The alloying element Cr improves the property of corrosion resistance." />
          <attvalue for="13" value="Cr improves corrosion resistance but degrades stability, etc." />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-78865a21d21766b0dd173d92dcbbfc0d" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-78865a21d21766b0dd173d92dcbbfc0d-e-4" target="chunk-78865a21d21766b0dd173d92dcbbfc0d-e-5" id="chunk-78865a21d21766b0dd173d92dcbbfc0d-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DEGRADES" />
          <attvalue for="12" value="The alloying element Cr degrades the property of stability." />
          <attvalue for="13" value="Cr improves corrosion resistance but degrades stability, etc." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-78865a21d21766b0dd173d92dcbbfc0d" />
          <attvalue for="16" value="0.00012484394506866417" />
          <attvalue for="17" value="0.40007490636704124" />
