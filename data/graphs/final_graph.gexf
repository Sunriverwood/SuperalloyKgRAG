      <node id="chunk-fb8636aebcb8b8d854ebe34fb885b102-e-14" label="MRS Bulletin">
        <attvalues>
          <attvalue for="0" value="MRS Bulletin" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《MRS Bulletin》是美国材料研究学会（MRS）的旗舰月刊。该期刊聚焦材料科学与工程领域的跨学科研究，内容涵盖权威综述、前沿进展和新闻，是该领域的核心学术期刊之一。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;28&quot;}" />
