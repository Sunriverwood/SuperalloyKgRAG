      <node id="chunk-8a8245180b98739270d9b9b4befedd30-e-3" label="R. T. Ott">
        <attvalues>
          <attvalue for="0" value="R. T. Ott" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="一位材料科学领域的研究人员，其发表的论文研究了粘结层中的马氏体相变。该研究对于理解和改进用于燃气轮机等高温环境下的热障涂层性能具有重要意义。" />
