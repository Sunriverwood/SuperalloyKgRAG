      <node id="chunk-e780ac83d97fe15870adf76ec9226ed9-e-1" label="hafnia-based thermal barrier coating">
        <attvalues>
          <attvalue for="0" value="hafnia-based thermal barrier coating" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种以氧化铪(HfO₂)为主要成分的先进陶瓷材料。作为热障涂层，它凭借极低的导热率和优异的高温稳定性，常被应用于航空发动机及燃气轮机等设备，为核心金属部件提供隔热保护，使其能在更高温度下工作。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-e780ac83d97fe15870adf76ec9226ed9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e780ac83d97fe15870adf76ec9226ed9-e-2" label="Science and Technology of Advanced Materials">
        <attvalues>
          <attvalue for="0" value="Science and Technology of Advanced Materials" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《先进材料科学与技术》(Science and Technology of Advanced Materials)是一本国际同行评审的开放获取学术期刊。该刊专注于材料科学领域，发表关于新材料的发现、合成、性能及应用的原创研究和综述，由日本国立材料科学研究所(NIMS)主办。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;4&quot;, &quot;year&quot;: &quot;2003&quot;, &quot;pages&quot;: &quot;153–158&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-e780ac83d97fe15870adf76ec9226ed9" />
