      <node id="chunk-cb57093a6357773efc0ab02b57f76fa1-e-11" label="National Institute for Materials Science">
        <attvalues>
          <attvalue for="0" value="National Institute for Materials Science" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="日本国立物质材料研究机构（National Institute for Materials Science）是位于日本的国家级研究机构，作为独立行政法人运作，是专注于材料科学领域基础研究和技术开发的全球领先科研中心之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
