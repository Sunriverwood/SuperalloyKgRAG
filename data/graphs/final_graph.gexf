          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-28027332c1e907d2b9fb62cbdc68fd6c-e-7" label="Materials Science and Technology">
        <attvalues>
          <attvalue for="0" value="Materials Science and Technology" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《材料科学与技术》（Materials Science and Technology）是由英国材料、矿物与采矿学会（IOM3）主办的国际同行评审期刊。该刊发表材料科学与工程领域的基础及应用研究，涵盖各类材料的加工、结构、性能及应用，如热机械疲劳等课题。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-28027332c1e907d2b9fb62cbdc68fd6c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-28027332c1e907d2b9fb62cbdc68fd6c-e-7&quot;, &quot;chunk-fc5aa264fb28225ff63c38a7e3698291-e-8&quot;, &quot;chunk-419ca09fedc825c26d4010cfa0528d12-e-7&quot;, &quot;chunk-b9dbde7895f392734e33f1d55d95cc73-e-7&quot;, &quot;chunk-8858e7b554c309b2b183ee00a5fadc99-e-11&quot;, &quot;chunk-356a95a5ba9ccf9ed595619218c5107b-e-2&quot;, &quot;chunk-a84c0c4e9e29df6948391158c41ca449-e-7&quot;]}]" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="8" />
