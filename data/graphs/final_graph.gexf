      <node id="chunk-419ca09fedc825c26d4010cfa0528d12-e-13" label="Pack cementation aluminide coatings on supe">
        <attvalues>
          <attvalue for="0" value="Pack cementation aluminide coatings on supe" />
          <attvalue for="1" value="Article" />
          <attvalue for="2" value="由学者R. Bianco与R. A. Rapp合著的一篇学术文章。该文系统综述了在高温合金（superalloys）上进行包埋法渗铝涂层的工艺、原理及其性能。文中的“supe”是“superalloys”的不完整写法。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-419ca09fedc825c26d4010cfa0528d12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9de67a861b4260c65467b4b0d1d09a13-e-3" label="Pack cementation aluminide coatings on superalloys: codeposition of Cr and reactive elements">
        <attvalues>
          <attvalue for="0" value="Pack cementation aluminide coatings on superalloys: codeposition of Cr and reactive elements" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由R. Bianco与R. A. Rapp合著的学术论文，题为《Pack cementation aluminide coatings on superalloys: codeposition of Cr and reactive elements》。该论文于1993年发表在学术期刊《电化学学会杂志》（Journal of the Electrochemical Society）上。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1993&quot;, &quot;volume&quot;: &quot;140&quot;, &quot;pages&quot;: &quot;1181–1190&quot;}" />
