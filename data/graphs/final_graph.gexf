        <attvalues>
          <attvalue for="11" value="CHARACTERIZED BY" />
          <attvalue for="12" value="The large size of the blading is presented as a characteristic of the IGT application context." />
          <attvalue for="13" value="...due to the large size of the blading and the operating environment [3]" />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-d59969b39f742308167ec01469929e5b" />
          <attvalue for="16" value="0.0041059449456396025" />
