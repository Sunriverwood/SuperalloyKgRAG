        </attvalues>
      </node>
      <node id="chunk-bfbc49438adee74f98c04c5e0bb57599-e-4" label="y' precipitates">
        <attvalues>
          <attvalue for="0" value="y' precipitates" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="γ'析出相 (γ' precipitates) 是一种材料微观结构，通常作为高温合金中的主要强化相。其颗粒的形貌（常呈现立方体状）受到它与基体材料之间晶格错配度 (misfit) 的显著影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-bfbc49438adee74f98c04c5e0bb57599" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bfbc49438adee74f98c04c5e0bb57599-e-4&quot;, &quot;chunk-ef72440f70fee44097b994414253b0b4-e-1&quot;, &quot;chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd-e-8&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-bfbc49438adee74f98c04c5e0bb57599-e-5" label="Cuboids">
        <attvalues>
          <attvalue for="0" value="Cuboids" />
          <attvalue for="1" value="Morphology" />
          <attvalue for="2" value="一种几何形状，特指在材料科学中，当γ'相粒子与基体的晶格错配度较小时所呈现的形态。其标志性特征是具有尖锐的棱角，这表明粒子与基体之间保持着弹性共格关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-bfbc49438adee74f98c04c5e0bb57599" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;cuboids&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bfbc49438adee74f98c04c5e0bb57599-e-5&quot;, &quot;chunk-bd6f6e5d223dd374971ce11dcab2f7b5-e-3&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-bd6f6e5d223dd374971ce11dcab2f7b5-e-1" label="y' particles">
        <attvalues>
          <attvalue for="0" value="y' particles" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="γ′相（y' particles）是一种沉淀相，其形态主要由它与基体（matrix）之间的晶格错配度大小决定。当错配度较小时，该析出相趋于球形；随着错配度增大，其形状会逐渐演变为立方体状。它在材料科学中通常作为一种重要的强化相存在。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-bd6f6e5d223dd374971ce11dcab2f7b5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Tertiary γ'&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bd6f6e5d223dd374971ce11dcab2f7b5-e-1&quot;, &quot;chunk-54d9cab0bf8e738ae99d8958ce8cd086-e-5&quot;, &quot;chunk-5efed09d54cb5442431710f41fa6ab69-e-2&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-bd6f6e5d223dd374971ce11dcab2f7b5-e-4" label="spherical">
        <attvalues>
          <attvalue for="0" value="spherical" />
          <attvalue for="1" value="Shape" />
          <attvalue for="2" value="一种为最小化界面能而形成的几何形状。在材料科学中，当析出物与基体的错配度增加并失去共格关系时，粒子（如'y'粒子）会趋向于形成此能量最优的球形形态。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-bd6f6e5d223dd374971ce11dcab2f7b5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bd6f6e5d223dd374971ce11dcab2f7b5-e-6" label="high-temperature diffractometry">
        <attvalues>
          <attvalue for="0" value="high-temperature diffractometry" />
          <attvalue for="1" value="Experimental Technique" />
          <attvalue for="2" value="高温衍射法是一种原位分析技术，它利用X射线或中子衍射，实时追踪材料在加热或冷却过程中的晶体结构与物相演变。该技术常用于研究材料的相变、热膨胀、化学反应以及晶格错配等与温度相关的物理和化学现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-bd6f6e5d223dd374971ce11dcab2f7b5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bd6f6e5d223dd374971ce11dcab2f7b5-e-6&quot;, &quot;chunk-807030ab9eb9ee85e606b0c18c1d17af-e-7&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-807030ab9eb9ee85e606b0c18c1d17af-e-3" label="expansion coefficient">
        <attvalues>
          <attvalue for="0" value="expansion coefficient" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="热膨胀系数是表征材料尺寸随温度变化的物理量。其数值会因材料物相（如γ'相和γ相）的不同而存在显著差异，可通过高温衍射法等技术进行测定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-807030ab9eb9ee85e606b0c18c1d17af" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-807030ab9eb9ee85e606b0c18c1d17af-e-6" label="temperature">
        <attvalues>
          <attvalue for="0" value="temperature" />
          <attvalue for="1" value="Physical Parameter" />
          <attvalue for="2" value="温度是一种衡量物体冷热程度的物理参数。在当前材料科学的上下文中，该参数的升高是导致晶格失配度（lattice misfit）向更负值变化的直接原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-807030ab9eb9ee85e606b0c18c1d17af" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-807030ab9eb9ee85e606b0c18c1d17af-e-8" label="Figure 3.32">
        <attvalues>
          <attvalue for="0" value="Figure 3.32" />
          <attvalue for="1" value="Figure" />
          <attvalue for="2" value="图3.32是一张科学图表，它展示了晶格错配（lattice misfit）随温度的变化关系，并具体呈现了四种特定合金的相关实验结果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
