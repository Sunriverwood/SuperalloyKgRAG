        </attvalues>
      </node>
      <node id="chunk-c5385f7f28e0875405c91c30084a5d9b-e-7" label="K. A. Green">
        <attvalues>
          <attvalue for="0" value="K. A. Green" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="K. A. Green 是一位编辑，曾担任《Superalloys 2004》会议论文集的编辑之一。该论文集是高温合金领域的重要学术出版物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c5385f7f28e0875405c91c30084a5d9b" />
