      </node>
      <node id="chunk-28027332c1e907d2b9fb62cbdc68fd6c-e-15" label="Oxidation and high temperature corrosion behaviour of modified MCrAlY cast materials">
        <attvalues>
          <attvalue for="0" value="Oxidation and high temperature corrosion behaviour of modified MCrAlY cast materials" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇题为《改性MCrAlY铸造材料的高温腐蚀行为》的科学论文。该文研究了特定改性MCrAlY铸造材料在高温环境下的腐蚀特性与表现，作为章节或论文发表于1984年出版的《超级合金1984》（Superalloys 1984）会议论文集中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-28027332c1e907d2b9fb62cbdc68fd6c" />
