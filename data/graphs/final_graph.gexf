        <attvalues>
          <attvalue for="11" value="PRECEDES" />
          <attvalue for="12" value="The primary age step is followed by the secondary age step." />
          <attvalue for="13" value="...a primary age of 4h at 1140°C followed by a secondary age of 16h at 870°C." />
