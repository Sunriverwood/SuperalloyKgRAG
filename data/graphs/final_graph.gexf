        <attvalues>
          <attvalue for="11" value="PRECIPITATES_AT" />
          <attvalue for="12" value="TCP phases form (precipitate) at elevated temperatures." />
          <attvalue for="13" value="...TCP phases which precipitate at these elevated temperatures..." />
