        <attvalues>
          <attvalue for="0" value="r₁" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="r₁ 是一个表示颗粒半径的物理参数。在相关模型或公式中，它是一个核心输入变量，用于定义和计算物理量 Nv 的数值。" />
          <attvalue for="3" value="{}" />
