        <attvalues>
          <attvalue for="0" value="M. R. Begley" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="M. R. Begley是一位研究人员和作者。他是学术出版物《Analysis of a wedge impression test for measuring the interface toughness between films/coatings and ductile substrates》的作者之一，该著作主要分析了一种用于测量薄膜/涂层与韧性基底之间界面韧性的楔形压痕测试方法。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-988c4d7fcff0bc412e7695d08b17502d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-988c4d7fcff0bc412e7695d08b17502d-e-8" label="Analysis of a wedge impression test for measuring the interface toughness between films/coatings and ductile substrates">
        <attvalues>
          <attvalue for="0" value="Analysis of a wedge impression test for measuring the interface toughness between films/coatings and ductile substrates" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由M. R. Begley、D. R. Mumm、A. G. Evans和J. W. Hutchinson合著，发表于材料科学期刊《Acta Materialia》的一篇科学论文。该文对一种楔形压痕测试方法进行了分析，该方法旨在测量薄膜/涂层与韧性基底之间的界面韧性。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2000&quot;, &quot;volume&quot;: &quot;48&quot;, &quot;pages&quot;: &quot;3211–3220&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-988c4d7fcff0bc412e7695d08b17502d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-988c4d7fcff0bc412e7695d08b17502d-e-11" label="Delamination">
        <attvalues>
          <attvalue for="0" value="Delamination" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="分层（Delamination）是一种失效机制，指复合材料、涂层或层状结构在层间界面发生分离或断裂。此失效会削弱材料的结构完整性，是热障涂层、层压板等工程应用中导致构件失效的关键模式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-988c4d7fcff0bc412e7695d08b17502d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-988c4d7fcff0bc412e7695d08b17502d-e-12" label="Wedge impression test">
        <attvalues>
          <attvalue for="0" value="Wedge impression test" />
          <attvalue for="1" value="Test Method" />
          <attvalue for="2" value="一种材料测试方法，通过使用楔形压头在样品表面产生压痕，用于定量测量薄膜或涂层与其韧性基底之间的界面韧性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-988c4d7fcff0bc412e7695d08b17502d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2439a21f2a1f1a9980c37a01408d1b87-e-1" label="Surface toughness between films/coatings and ductile substrates">
        <attvalues>
          <attvalue for="0" value="Surface toughness between films/coatings and ductile substrates" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《薄膜/涂层与韧性基底间的表面韧性》(Surface toughness between films/coatings and ductile substrates) 是一篇于2000年发表在材料科学期刊《Acta Materialia》上的科学论文。该文主要研究薄膜或涂层与其韧性基底之间的界面结合强度和断裂韧性问题。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2000&quot;, &quot;volume&quot;: &quot;48&quot;, &quot;pages&quot;: &quot;3211–3220&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-2439a21f2a1f1a9980c37a01408d1b87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2439a21f2a1f1a9980c37a01408d1b87-e-3" label="A. Vasinonta">
        <attvalues>
          <attvalue for="0" value="A. Vasinonta" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="A. Vasinonta是一位材料科学领域的研究人员。他是学术论文《Measurement of interfacial toughness in thermal barrier coating systems by indentation》的作者之一，该论文主要研究热障涂层材料的界面力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-2439a21f2a1f1a9980c37a01408d1b87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="87" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2439a21f2a1f1a9980c37a01408d1b87-e-4" label="J. L. Beuth">
        <attvalues>
          <attvalue for="0" value="J. L. Beuth" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="学者，学术出版物《热障涂层系统中界面韧性的压痕测量》的作者之一。其研究领域为热障涂层材料，专注于通过压痕法测量其界面韧性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-2439a21f2a1f1a9980c37a01408d1b87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="87" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2439a21f2a1f1a9980c37a01408d1b87-e-5" label="Measurement of interfacial toughness in thermal barrier coating systems by indentation">
        <attvalues>
          <attvalue for="0" value="Measurement of interfacial toughness in thermal barrier coating systems by indentation" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《通过压痕法测量热障涂层系统的界面韧性》(Measurement of interfacial toughness in thermal barrier coating systems by indentation) 是一篇由A. Vasinonta与J. L. Beuth合著的学术论文。该文于2001年发表在《工程断裂力学》(Engineering Fracture Mechanics)期刊上，提出了一种利用压痕技术来测量热障涂层系统界面韧性的方法。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2001&quot;, &quot;volume&quot;: &quot;68&quot;, &quot;pages&quot;: &quot;843-860&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2439a21f2a1f1a9980c37a01408d1b87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="87" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2439a21f2a1f1a9980c37a01408d1b87-e-6" label="Engineering Fracture Mechanics">
        <attvalues>
          <attvalue for="0" value="Engineering Fracture Mechanics" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《Engineering Fracture Mechanics》是由爱思唯尔（Elsevier）出版的国际同行评审期刊，是断裂力学领域的权威刊物。该刊专注于发表材料与结构的断裂、疲劳、损伤力学及结构完整性评估等方面的原创研究。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-2439a21f2a1f1a9980c37a01408d1b87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="87" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2439a21f2a1f1a9980c37a01408d1b87-e-7" label="C. A. Johnson">
        <attvalues>
          <attvalue for="0" value="C. A. Johnson" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="C. A. Johnson 是一位学者，是学术出版物《Relationships between residual stress, microstructure and mechanical properties》的作者之一。该著作主要研究材料科学领域中，残余应力、微观结构与力学性能之间的关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-2439a21f2a1f1a9980c37a01408d1b87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="67" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2439a21f2a1f1a9980c37a01408d1b87-e-8" label="J. A. Rund">
        <attvalues>
          <attvalue for="0" value="J. A. Rund" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="J. A. Rund是一位研究人员，其作为作者之一发表了关于材料科学的著作《残余应力、微观结构和力学性能之间的关系》。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-2439a21f2a1f1a9980c37a01408d1b87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="67" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2439a21f2a1f1a9980c37a01408d1b87-e-9" label="R. Bruce">
        <attvalues>
          <attvalue for="0" value="R. Bruce" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="R. Bruce是一位学者或研究人员，是关于材料科学的学术出版物《残余应力、微观结构和力学性能之间的关系》(Relationships between residual stress, microstructure and mechanical properties) 的作者之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-2439a21f2a1f1a9980c37a01408d1b87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="67" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2439a21f2a1f1a9980c37a01408d1b87-e-10" label="D. Wortman">
        <attvalues>
          <attvalue for="0" value="D. Wortman" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. Wortman是一名研究人员，他是学术出版物《残余应力、微观结构与力学性能之间的关系》(Relationships between residual stress, microstructure and mechanical properties)的作者之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-2439a21f2a1f1a9980c37a01408d1b87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="67" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2439a21f2a1f1a9980c37a01408d1b87-e-11" label="Relationships between residual stress, microstructure and mechanical properties">
        <attvalues>
          <attvalue for="0" value="Relationships between residual stress, microstructure and mechanical properties" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一部由C. A. Johnson、J. A. Rund、R. Bruce和D. Wortman合著的科学出版物。该著作系统地研究并阐述了在材料科学领域中，材料内部的残余应力、其微观结构形态以及宏观机械性能这三者之间存在的内在联系与相互作用机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-2439a21f2a1f1a9980c37a01408d1b87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="67" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-31cd2366f102780cc28ad1a099e8127d-e-2" label="Microstructure">
        <attvalues>
          <attvalue for="0" value="Microstructure" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**微观结构 (Microstructure)**&#10;&#10;材料在显微尺度下的内部结构，特指其组成相、晶粒、孔隙等的形态、尺寸和分布。作为热障涂层的关键属性，微观结构直接决定了材料的隔热性能、应力耐受性和使用寿命等宏观表现。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-31cd2366f102780cc28ad1a099e8127d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Microstructures&quot;, &quot;microstructure&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-31cd2366f102780cc28ad1a099e8127d-e-2&quot;, &quot;chunk-921a9348cd77597c4374323349308669-e-7&quot;, &quot;chunk-8f2b320fa48cfb5ef53d60e1a4ca2d11-e-4&quot;, &quot;chunk-e3bf4592567fa4c79f22955763ff9714-e-4&quot;, &quot;chunk-e4445ec100361e8a0d56ff46090155d6-e-4&quot;, &quot;chunk-bdd419f61b4df7e511da7b854e288ce6-e-4&quot;, &quot;chunk-c0e09318f4b18b79d33ab740d82e3946-e-10&quot;, &quot;chunk-4ab48ef35596d95655c761b2200818d3-e-7&quot;, &quot;chunk-a0f76fcaabee1ce4b8e484eb6ae1cf58-e-3&quot;, &quot;chunk-063edb5b1170ac940a0b2ac7356bfa53-e-4&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="15" />
        </attvalues>
      </node>
      <node id="chunk-31cd2366f102780cc28ad1a099e8127d-e-6" label="Thermal fatigue degradation">
        <attvalues>
          <attvalue for="0" value="Thermal fatigue degradation" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="热疲劳降解是指铝化物涂层在经历反复的温度循环时，因机械应力与化学过程的共同作用而发生的材料劣化现象，是一种典型的失效机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-31cd2366f102780cc28ad1a099e8127d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-31cd2366f102780cc28ad1a099e8127d-e-6&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-31cd2366f102780cc28ad1a099e8127d-e-8" label="Chemical processes">
        <attvalues>
          <attvalue for="0" value="Chemical processes" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="在热疲劳条件下，导致铝化物涂层性能退化和结构损伤的一系列化学反应与变化过程。它是涂层热疲劳降解的关键内在机制之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-31cd2366f102780cc28ad1a099e8127d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-31cd2366f102780cc28ad1a099e8127d-e-8&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-31cd2366f102780cc28ad1a099e8127d-e-9" label="Mechanical processes">
        <attvalues>
          <attvalue for="0" value="Mechanical processes" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="指因热循环导致材料（如铝化物涂层）内部产生周期性机械应力和应变，从而引发微裂纹形成与扩展，并最终造成热疲劳损伤的物理机制。其根源常为涂层与基体间的热膨胀失配。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-31cd2366f102780cc28ad1a099e8127d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8858e7b554c309b2b183ee00a5fadc99-e-2" label="R. C. Pennefather">
        <attvalues>
          <attvalue for="0" value="R. C. Pennefather" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="R. C. Pennefather是一位学者，作为合著者之一发表了关于材料科学的学术论文《Mechanical degradation of coating systems in high-temperature cyclic oxidation》。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-8858e7b554c309b2b183ee00a5fadc99" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8858e7b554c309b2b183ee00a5fadc99-e-4" label="Mechanical degradation of coating systems in high-temperature cyclic oxidation">
        <attvalues>
          <attvalue for="0" value="Mechanical degradation of coating systems in high-temperature cyclic oxidation" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由 R. C. Pennefather 与 D. H. Boone 合著的学术论文，发表于期刊《Surface and Coatings Technology》。该论文研究并阐述了涂层系统在高温循环氧化环境下的机械性能退化问题及其 underlying 机制。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1995&quot;, &quot;volume&quot;: &quot;76&quot;, &quot;pages&quot;: &quot;47-52&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-8858e7b554c309b2b183ee00a5fadc99" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8858e7b554c309b2b183ee00a5fadc99-e-6" label="Y. H. Zhang">
        <attvalues>
          <attvalue for="0" value="Y. H. Zhang" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="Y. H. Zhang是一位学者和作者，其研究领域涉及材料科学或工程。他因作为学术论文《热机械疲劳下涂层系统的损伤机制》（'Damage mechanisms of coated systems under thermomechanical fatigue'）的合著者而知名。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-8858e7b554c309b2b183ee00a5fadc99" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8858e7b554c309b2b183ee00a5fadc99-e-7" label="P. J. Withers">
        <attvalues>
          <attvalue for="0" value="P. J. Withers" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="P. J. Withers是一位学者，作为论文《热机械疲劳下涂层系统的损伤机制》的合著者而知名。其研究聚焦于材料科学领域，探讨了涂层系统在复杂负载条件下的损伤行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-8858e7b554c309b2b183ee00a5fadc99" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8858e7b554c309b2b183ee00a5fadc99-e-8" label="M. D. Fox">
        <attvalues>
          <attvalue for="0" value="M. D. Fox" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="M. D. Fox 是一名研究人员，作为合著者发表了学术论文《Damage mechanisms of coated systems under thermomechanical fatigue》，该文研究涂层系统在热机械疲劳下的损伤机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-8858e7b554c309b2b183ee00a5fadc99" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8858e7b554c309b2b183ee00a5fadc99-e-9" label="D. M. Knowles">
        <attvalues>
          <attvalue for="0" value="D. M. Knowles" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="D. M. Knowles是一位学者，作为合著者发表了关于涂层系统热机械疲劳损伤机制的学术论文《Damage mechanisms of coated systems under thermomechanical fatigue》。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-8858e7b554c309b2b183ee00a5fadc99" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8858e7b554c309b2b183ee00a5fadc99-e-10" label="Damage mechanisms of coated systems under thermomechanical fatigue">
        <attvalues>
          <attvalue for="0" value="Damage mechanisms of coated systems under thermomechanical fatigue" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由Y. H. Zhang、P. J. Withers、M. D. Fox与D. M. Knowles合著的学术论文。该论文题为《热机疲劳下涂层系统的损伤机理》(Damage mechanisms of coated systems under thermomechanical fatigue)，并发表于《材料科学与技术》期刊。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1999&quot;, &quot;volume&quot;: &quot;15&quot;, &quot;pages&quot;: &quot;1031–1036&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-8858e7b554c309b2b183ee00a5fadc99" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-8858e7b554c309b2b183ee00a5fadc99-e-12" label="Publication in Metallurgical Transactions, 21A">
        <attvalues>
          <attvalue for="0" value="Publication in Metallurgical Transactions, 21A" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇发表在冶金学期刊《冶金汇刊》（Metallurgical Transactions）第21A卷中的学术论文。该期刊是冶金与材料科学领域的权威出版物，卷号“21A”指明了其具体的发表卷册。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1990&quot;, &quot;volume&quot;: &quot;21A&quot;, &quot;pages&quot;: &quot;1209–1222&quot;}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-8858e7b554c309b2b183ee00a5fadc99" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-356a95a5ba9ccf9ed595619218c5107b-e-1" label="thermomechanical fatigue">
        <attvalues>
          <attvalue for="0" value="thermomechanical fatigue" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="热机械疲劳（TMF）是一种材料科学现象，指材料在同时经受周期性变化的温度和机械应力的联合作用下，所产生的疲劳损伤和失效。它是评估航空发动机、燃气轮机等高温结构部件寿命与可靠性的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-356a95a5ba9ccf9ed595619218c5107b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;thermal mechanical fatigue&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-356a95a5ba9ccf9ed595619218c5107b-e-1&quot;, &quot;chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-12&quot;]}]" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-356a95a5ba9ccf9ed595619218c5107b-e-5" label="K. S. Murphy">
        <attvalues>
          <attvalue for="0" value="K. S. Murphy" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="K. S. Murphy是一位材料科学领域的研究人员或学者。他是学术论文《Oxidation-induced failure of EB-PVD thermal barrier coatings》（中译：电子束物理气相沉积热障涂层的氧化诱导失效）的作者之一，该论文主要研究热障涂层的失效机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-356a95a5ba9ccf9ed595619218c5107b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-356a95a5ba9ccf9ed595619218c5107b-e-6" label="Oxidation-induced failure">
        <attvalues>
          <attvalue for="0" value="Oxidation-induced failure" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="氧化诱导失效是一种由材料氧化反应导致的失效机制。该现象通常发生在高温环境中，氧化物生长会引发应力、裂纹或层裂，最终导致材料性能退化和结构完整性丧失，是电子束物理气相沉积（EB-PVD）热障涂层的一种典型失效模式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-356a95a5ba9ccf9ed595619218c5107b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="220" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-356a95a5ba9ccf9ed595619218c5107b-e-7" label="EB-PVD thermal barrier coating">
        <attvalues>
          <attvalue for="0" value="EB-PVD thermal barrier coating" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="EB-PVD热障涂层是一种采用电子束物理气相沉积（EB-PVD）技术制备的先进陶瓷隔热涂层。它具有独特的柱状晶微观结构，常用于保护航空发动机涡轮叶片等高温部件，以抵御极端温度。在高温服役环境下，氧化是导致其失效的关键因素之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-356a95a5ba9ccf9ed595619218c5107b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;EB-PVD thermal barrier coatings&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-356a95a5ba9ccf9ed595619218c5107b-e-7&quot;]}]" />
          <attvalue for="9" value="220" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-356a95a5ba9ccf9ed595619218c5107b-e-14" label="Oxidation-induced failure of EB-PVD thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="Oxidation-induced failure of EB-PVD thermal barrier coatings" />
          <attvalue for="1" value="Paper" />
          <attvalue for="2" value="一篇由V. K. Tolpygo、D. R. Clarke及K. S. Murphy合著的学术论文，发表于《Surface and Coatings Technology》期刊。该论文主要研究电子束物理气相沉积（EB-PVD）热障涂层因氧化而导致的失效机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-356a95a5ba9ccf9ed595619218c5107b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-356a95a5ba9ccf9ed595619218c5107b-e-14&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-356a95a5ba9ccf9ed595619218c5107b-e-15" label="Mechanisms of spallation of electron beam physical...">
        <attvalues>
          <attvalue for="0" value="Mechanisms of spallation of electron beam physical..." />
          <attvalue for="1" value="Paper" />
          <attvalue for="2" value="由K. Vaidyanathan、M. Gell与E. Jordan合著的学术论文。该文主要研究并阐释了采用电子束物理气相沉积技术制备的涂层所发生的剥落（spallation）现象的内在物理机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-356a95a5ba9ccf9ed595619218c5107b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-5508d220f18b6461ca52c2a3d80737ec-e-1" label="K. Vaidyanathan, M. Gell and E. Jordan">
        <attvalues>
          <attvalue for="0" value="K. Vaidyanathan, M. Gell and E. Jordan" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="K. Vaidyanathan、M. Gell与E. Jordan是一组研究人员，他们于2000年在学术期刊《Surface and Coatings Technology》上合作发表了一篇关于热障涂层剥落机制的研究论文。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-5508d220f18b6461ca52c2a3d80737ec" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5508d220f18b6461ca52c2a3d80737ec-e-1&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5508d220f18b6461ca52c2a3d80737ec-e-2" label="Electron beam physical vapour deposited thermal barrier coating">
        <attvalues>
          <attvalue for="0" value="Electron beam physical vapour deposited thermal barrier coating" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="一种采用电子束物理气相沉积(EB-PVD)技术制备的先进热障涂层。它通常与铂铝化物粘结层结合使用，为航空发动机涡轮叶片等高温部件提供隔热保护，其关键失效机制为涂层剥落。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-5508d220f18b6461ca52c2a3d80737ec" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;electron beam physical vapour deposited thermal barrier coatings&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5508d220f18b6461ca52c2a3d80737ec-e-2&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-5508d220f18b6461ca52c2a3d80737ec-e-3" label="Platinum aluminide bond coat ridges">
        <attvalues>
          <attvalue for="0" value="Platinum aluminide bond coat ridges" />
          <attvalue for="1" value="Coating Component" />
          <attvalue for="2" value="铂铝化物粘结层脊是在热障涂层系统中，由铂铝化物粘结层表面因热循环引起的塑性变形而形成的一种波浪状或脊状的表面形貌。它常见于电子束物理气相沉积（EB-PVD）涂层体系中，并影响涂层的应力状态和寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-5508d220f18b6461ca52c2a3d80737ec" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;platinum aluminide bond coat ridges&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5508d220f18b6461ca52c2a3d80737ec-e-3&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5508d220f18b6461ca52c2a3d80737ec-e-4" label="Surface and Coatings Technology, 133-134 (2000), 28-34">
        <attvalues>
          <attvalue for="0" value="Surface and Coatings Technology, 133-134 (2000), 28-34" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇关于热障涂层剥落(spallation)机制的科学论文，由K. Vaidyanathan、M. Gell及E. Jordan合著。该文发表于2000年的《Surface and Coatings Technology》期刊第133-134卷，28-34页。" />
          <attvalue for="3" value="{&quot;citation_id&quot;: &quot;146&quot;}" />
          <attvalue for="4" value="e-4" />
