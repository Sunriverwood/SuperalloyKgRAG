      <node id="chunk-0bff8302b00567f9758ab71ce974ace7-e-4" label="N. Yao">
        <attvalues>
          <attvalue for="0" value="N. Yao" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="N. Yao是一位研究人员，作为主要作者发表了学术出版物《热障系统中的外物损伤：机理与模拟》(Foreign object damage in a thermal barrier system: mechanisms and simulations)。该研究聚焦于材料科学领域，探讨热障涂层系统在外物冲击下的损伤机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
