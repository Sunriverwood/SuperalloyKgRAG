          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-08620c5a2f94ef5584dba0230f92c28f-e-1" label="γ'">
        <attvalues>
          <attvalue for="0" value="γ'" />
          <attvalue for="1" value="Crystal Phase" />
          <attvalue for="2" value="γ' 是一种有序晶相，其原子结构迫使位错（如 a/2⟨110⟩{111} 型）必须成对通过。构成这种位错对的单个位错称为超偏位错，在 γ' 相内被视为一种不完美位错。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-08620c5a2f94ef5584dba0230f92c28f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9a641206a39d9f183256b080afe1f768-e-3&quot;, &quot;chunk-12efe43c66bf3765417cf87c1dbf67ad-e-2&quot;, &quot;chunk-08620c5a2f94ef5584dba0230f92c28f-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-08620c5a2f94ef5584dba0230f92c28f-e-3" label="Ni">
        <attvalues>
          <attvalue for="0" value="Ni" />
          <attvalue for="1" value="Atom" />
          <attvalue for="2" value="一种镍（Ni）原子，在特定的晶体结构中，它通过a/2⟨101⟩矢量与铝（Al）原子相连接。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-08620c5a2f94ef5584dba0230f92c28f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-08620c5a2f94ef5584dba0230f92c28f-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-08620c5a2f94ef5584dba0230f92c28f-e-4" label="Al">
        <attvalues>
          <attvalue for="0" value="Al" />
          <attvalue for="1" value="Atom" />
          <attvalue for="2" value="一种铝（Al）原子，在晶格中通过 a/2⟨101⟩ 矢量与镍（Ni）原子相连接，该矢量定义了两者间的相对位置与键合关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-08620c5a2f94ef5584dba0230f92c28f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-08620c5a2f94ef5584dba0230f92c28f-e-4&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-08620c5a2f94ef5584dba0230f92c28f-e-6" label="Ni-Al bonds">
        <attvalues>
          <attvalue for="0" value="Ni-Al bonds" />
          <attvalue for="1" value="Chemical Bond" />
          <attvalue for="2" value="Ni-Al键指镍（Ni）原子与铝（Al）原子之间形成的化学键。在晶体材料中，反相畴界（APB）的出现会使其附近的Ni-Al键数量显著减少，这是表征该区域微观结构的一个重要特征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-08620c5a2f94ef5584dba0230f92c28f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-08620c5a2f94ef5584dba0230f92c28f-e-6&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-08620c5a2f94ef5584dba0230f92c28f-e-7" label="Ni-Ni bonds">
        <attvalues>
          <attvalue for="0" value="Ni-Ni bonds" />
          <attvalue for="1" value="Chemical Bond" />
          <attvalue for="2" value="一种形成于反相畴界（APB）附近的镍-镍化学键。反相畴界作为一种晶体缺陷，其区域内的原子排列错位是导致这种特殊化学键形成的直接原因。" />
          <attvalue for="3" value="{&quot;status&quot;: &quot;forbidden&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-08620c5a2f94ef5584dba0230f92c28f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-08620c5a2f94ef5584dba0230f92c28f-e-7&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-08620c5a2f94ef5584dba0230f92c28f-e-8" label="Al-Al bonds">
        <attvalues>
          <attvalue for="0" value="Al-Al bonds" />
          <attvalue for="1" value="Chemical Bond" />
          <attvalue for="2" value="**铝-铝键 (Al-Al bonds)**：一种连接两个铝原子的化学键，特指在材料的反相畴界（Anti-phase boundary, APB）附近区域形成的成键。这种特定化学键的形成是由反相畴界的存在直接引发或促成的。" />
          <attvalue for="3" value="{&quot;status&quot;: &quot;forbidden&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-08620c5a2f94ef5584dba0230f92c28f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-08620c5a2f94ef5584dba0230f92c28f-e-8&quot;, &quot;chunk-99c942e2e9af3f5f017d599dea23d62d-e-8&quot;, &quot;chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-96f36e4af04723225cb4d274300efd6e-e-3" label="Crystallographic plane">
        <attvalues>
          <attvalue for="0" value="Crystallographic plane" />
          <attvalue for="1" value="Crystallographic Feature" />
          <attvalue for="2" value="晶体点阵中的一个原子平面，特指反相畴界（APB）等晶体缺陷所处的界面。该平面的取向决定了界面处原子键的类型和APB的能量，后者因此表现出显著的各向异性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-96f36e4af04723225cb4d274300efd6e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-96f36e4af04723225cb4d274300efd6e-e-6" label="Al atoms">
        <attvalues>
          <attvalue for="0" value="Al atoms" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="在理想的L12晶体结构中，相互之间不构成最近邻关系的铝原子。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-96f36e4af04723225cb4d274300efd6e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a147395bb93a2c0f3ea0e531840ca795-e-2" label="Second layer">
        <attvalues>
          <attvalue for="0" value="Second layer" />
          <attvalue for="1" value="Crystal Structure Component" />
          <attvalue for="2" value="晶体结构中的一个原子层，其沿 a/2⟨110⟩ 晶向发生位移，这种特定的平移导致了禁戒键的形成。" />
          <attvalue for="3" value="{&quot;displacement&quot;: &quot;a/2⟨110⟩&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a147395bb93a2c0f3ea0e531840ca795" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a147395bb93a2c0f3ea0e531840ca795-e-6" label="Ω (ordering energy)">
        <attvalues>
          <attvalue for="0" value="Ω (ordering energy)" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="有序化能（Ordering Energy, Ω）是一种物理性质，用于量化合金形成有序结构的能量优势。它由体系中不同原子对（如Ni-Ni, Al-Al, Ni-Al）间的相互作用能决定，是表征材料有序化趋势并计算反相畴界（APB）能等缺陷能量的关键参数。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;ΩNiAl − ½(ΩNiNi + ΩAlAl)&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a147395bb93a2c0f3ea0e531840ca795" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-a147395bb93a2c0f3ea0e531840ca795-e-7" label="ΩNiAl">
        <attvalues>
          <attvalue for="0" value="ΩNiAl" />
          <attvalue for="1" value="Bond Energy" />
          <attvalue for="2" value="ΩNiAl指镍(Ni)与铝(Al)原子间的键能。它是有序能(Ω)的一个基本组成部分，用于量化合金体系中原子有序排列的倾向，是决定材料相稳定性和微观结构的关键物理量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a147395bb93a2c0f3ea0e531840ca795" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a147395bb93a2c0f3ea0e531840ca795-e-7&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a147395bb93a2c0f3ea0e531840ca795-e-8" label="ΩAlAl">
        <attvalues>
          <attvalue for="0" value="ΩAlAl" />
          <attvalue for="1" value="Bond Energy" />
          <attvalue for="2" value="ΩAlAl指铝-铝（Al-Al）原子间的化学键能。作为有序化能（Ω）的一个基本组分，它用于量化原子间的相互作用，是分析和计算材料（如合金）原子排列有序程度的关键物理参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-a147395bb93a2c0f3ea0e531840ca795" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a147395bb93a2c0f3ea0e531840ca795-e-8&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a147395bb93a2c0f3ea0e531840ca795-e-9" label="ΩNiNi">
        <attvalues>
          <attvalue for="0" value="ΩNiNi" />
          <attvalue for="1" value="Bond Energy" />
          <attvalue for="2" value="ΩNiNi指镍-镍（Ni-Ni）原子间的键能，作为一个物理量，它是有序化能（Ω）的关键组成部分，被用于定义和计算有序化能的数值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-a147395bb93a2c0f3ea0e531840ca795" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a147395bb93a2c0f3ea0e531840ca795-e-9&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9b30e2ac693416c047e70b5d2cbba7ff-e-2" label="APB energy on the {110} plane">
        <attvalues>
          <attvalue for="0" value="APB energy on the {110} plane" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="与晶体{110}晶面相关的反相畴界能，一种物理性质，其计算公式为2Ω/(a²√2)。该能量值高于在{111}晶面上形成反相畴界时的能量。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;2Ω/(a²√2)&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-9b30e2ac693416c047e70b5d2cbba7ff" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9b30e2ac693416c047e70b5d2cbba7ff-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9b30e2ac693416c047e70b5d2cbba7ff-e-3" label="APB energy on the {111} plane">
        <attvalues>
          <attvalue for="0" value="APB energy on the {111} plane" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="指在有序合金的{111}晶面上，形成反相畴界（一种平面晶体缺陷）所需的单位面积能量。作为一种物理性质，该能量值低于{110}晶面，表明反相畴界在{111}晶面上更易于形成和扩展。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-9b30e2ac693416c047e70b5d2cbba7ff" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9b30e2ac693416c047e70b5d2cbba7ff-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9b30e2ac693416c047e70b5d2cbba7ff-e-4" label="Forbidden bond">
        <attvalues>
          <attvalue for="0" value="Forbidden bond" />
          <attvalue for="1" value="Crystallographic Feature" />
          <attvalue for="2" value="一种特殊的原子键，因晶体结构中第二层原子在特定晶面（如{111}和{110}面）上发生位移而形成。这种化学键在理想晶格中通常不存在，故称为“禁戒键”。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-9b30e2ac693416c047e70b5d2cbba7ff" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Forbidden bonds&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-96f36e4af04723225cb4d274300efd6e-e-2&quot;, &quot;chunk-a147395bb93a2c0f3ea0e531840ca795-e-3&quot;, &quot;chunk-9b30e2ac693416c047e70b5d2cbba7ff-e-4&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-9b30e2ac693416c047e70b5d2cbba7ff-e-6" label="a/2⟨110⟩ translation">
        <attvalues>
          <attvalue for="0" value="a/2⟨110⟩ translation" />
          <attvalue for="1" value="Crystallographic Operation" />
          <attvalue for="2" value="a/2⟨110⟩平移是一种晶体学操作，代表晶格沿连接顶点和面心的⟨110⟩方向的位移（a为晶格常数）。在面心立方等晶体中，它是主要的滑移矢量，应用于{001}晶面时不会产生禁戒键，是一种能量有利的平移方式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-9b30e2ac693416c047e70b5d2cbba7ff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9b30e2ac693416c047e70b5d2cbba7ff-e-7" label="{200} planes">
        <attvalues>
          <attvalue for="0" value="{200} planes" />
          <attvalue for="1" value="Crystallographic Plane Family" />
          <attvalue for="2" value="一个晶体学中的晶面族，其结构特征为存在仅由镍(Ni)原子构成的晶面进行交替排列。该晶面族常被用于解释{001}晶面族的性质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-9b30e2ac693416c047e70b5d2cbba7ff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9b30e2ac693416c047e70b5d2cbba7ff-e-9" label="Al atoms">
        <attvalues>
          <attvalue for="0" value="Al atoms" />
          <attvalue for="1" value="Atomic Species" />
          <attvalue for="2" value="铝原子是化学元素铝（Al）的原子，原子序数为13。作为构成物质的基本粒子，在特定晶体结构中，它通过规则排列占据晶格上的特定位置，是构成该结构的基本单元。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-9b30e2ac693416c047e70b5d2cbba7ff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="434" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-9718b105c96174ffb3694bd3c4362a1e-e-2" label="Al atoms">
        <attvalues>
          <attvalue for="0" value="Al atoms" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="一种材料组分。在特定的原子排列中，这些铝原子被限制在非最近邻位置上，形成一种有序结构。这种原子构型是影响材料反相畴界能（APB energy）的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-9718b105c96174ffb3694bd3c4362a1e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-de934887953c10df356d75f9bd459e77-e-4" label="γ matrix">
        <attvalues>
          <attvalue for="0" value="γ matrix" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="γ基体是一种无序的基体相，作为γ'强化相的载体。它也是材料中发生位错滑移和塑性变形的主要区域，决定了材料的延展性。" />
          <attvalue for="3" value="{&quot;state&quot;: &quot;disordered&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-de934887953c10df356d75f9bd459e77" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-de934887953c10df356d75f9bd459e77-e-5" label="Slip Deformation">
        <attvalues>
          <attvalue for="0" value="Slip Deformation" />
          <attvalue for="1" value="Deformation Mechanism" />
          <attvalue for="2" value="滑移变形是一种在γ基体等晶体材料中发生的塑性变形机制。其本质是由位错在外力驱动下，沿着特定的晶体学平面（滑移面）和方向（滑移方向）运动所引起的，是导致材料产生永久变形的主要方式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-de934887953c10df356d75f9bd459e77" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-de934887953c10df356d75f9bd459e77-e-6" label="Dislocation Glide">
        <attvalues>
          <attvalue for="0" value="Dislocation Glide" />
          <attvalue for="1" value="Deformation Mechanism" />
          <attvalue for="2" value="位错滑移 (Dislocation Glide) 是一种晶体材料的基本塑性变形机制。它指位错在外力作用下，沿特定的晶面和方向（合称滑移系，如 a/2⟨110⟩{111} 系）运动，是导致材料发生滑移变形的微观根源。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-de934887953c10df356d75f9bd459e77" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-de934887953c10df356d75f9bd459e77-e-8" label="a/2⟨110⟩ lattice vector">
        <attvalues>
          <attvalue for="0" value="a/2⟨110⟩ lattice vector" />
          <attvalue for="1" value="Crystallographic Vector" />
          <attvalue for="2" value="`a/2⟨110⟩`晶格矢量是晶体学中描述面心立方（FCC）晶体结构的一种矢量。它代表了FCC晶格中全位错的柏氏矢量（Burgers vector），是该晶格中最短的平移矢量，其大小为`a/√2`（`a`为晶格常数）。该矢量也定义了FCC晶体主要滑移系`a/2⟨110⟩{111}`中的滑移方向。" />
          <attvalue for="3" value="{&quot;property&quot;: &quot;shortest one available&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-de934887953c10df356d75f9bd459e77" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-de934887953c10df356d75f9bd459e77-e-8&quot;, &quot;chunk-cab35826f1356487207a5472cfaf8878-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cab35826f1356487207a5472cfaf8878-e-1" label="a/2⟨110⟩{111} system">
        <attvalues>
          <attvalue for="0" value="a/2⟨110⟩{111} system" />
          <attvalue for="1" value="Slip System" />
          <attvalue for="2" value="面心立方(FCC)晶体结构中最主要的滑移系。它描述了位错在最密排的{111}晶面上，沿着密排的⟨110⟩晶向发生滑移，从而引起塑性变形。其伯格斯矢量为a/2⟨110⟩，代表了滑移的单位方向与距离。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-cab35826f1356487207a5472cfaf8878" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cab35826f1356487207a5472cfaf8878-e-1&quot;, &quot;chunk-de934887953c10df356d75f9bd459e77-e-7&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cab35826f1356487207a5472cfaf8878-e-3" label="close-packed plane">
        <attvalues>
          <attvalue for="0" value="close-packed plane" />
          <attvalue for="1" value="Crystallographic Plane" />
          <attvalue for="2" value="密排面 (close-packed plane) 是晶体结构中原子面密度最高的晶面。在面心立方(FCC)结构中，{111}面族即为密排面，其重要几何特征是该平面必然包含连接最近邻原子的 a/2⟨110⟩ 晶格矢量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-cab35826f1356487207a5472cfaf8878" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cab35826f1356487207a5472cfaf8878-e-5" label="{111}">
        <attvalues>
          <attvalue for="0" value="{111}" />
          <attvalue for="1" value="Crystallographic Plane" />
          <attvalue for="2" value="{111}晶面是L12型有序超晶格结构中的一族密排面。它们具有最高的原子面密度，是该结构在塑性变形中的主要滑移面系，但通常不作为a⟨100⟩型位错的滑移面。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-cab35826f1356487207a5472cfaf8878" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cab35826f1356487207a5472cfaf8878-e-6" label="a⟨100⟩">
        <attvalues>
          <attvalue for="0" value="a⟨100⟩" />
          <attvalue for="1" value="Lattice Vector" />
          <attvalue for="2" value="a⟨100⟩是L12结构中的一族最短晶格矢量，代表从晶胞原点指向立方体面心的向量集合，其特征是不位于{111}晶面内。" />
          <attvalue for="3" value="{&quot;length&quot;: &quot;shortest&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-cab35826f1356487207a5472cfaf8878" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cab35826f1356487207a5472cfaf8878-e-7" label="a⟨110⟩{111}">
        <attvalues>
          <attvalue for="0" value="a⟨110⟩{111}" />
          <attvalue for="1" value="Slip System" />
          <attvalue for="2" value="a⟨110⟩{111}是L12结构在低温下的主要滑移系，由{111}晶面作为滑移面、⟨110⟩晶向作为滑移方向构成。这种滑移方式是该类材料低温塑性变形的关键机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-cab35826f1356487207a5472cfaf8878" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cab35826f1356487207a5472cfaf8878-e-8" label="low temperatures">
        <attvalues>
          <attvalue for="0" value="low temperatures" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="一种物理条件，特指能激活晶体材料中a⟨110⟩{111}滑移系的较低温度范围。在此条件下，材料主要通过该滑移系沿特定晶面和晶向发生塑性变形。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-cab35826f1356487207a5472cfaf8878" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cab35826f1356487207a5472cfaf8878-e-9" label="a⟨100⟩{001}">
        <attvalues>
          <attvalue for="0" value="a⟨100⟩{001}" />
          <attvalue for="1" value="Slip System" />
          <attvalue for="2" value="一种由{001}滑移面和⟨100⟩滑移方向构成的滑移系，也称为立方滑移。它是在L12结构中一种理论上可能、但在实际塑性变形中通常不被激活或观测到的潜在变形机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-cab35826f1356487207a5472cfaf8878" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cab35826f1356487207a5472cfaf8878-e-9&quot;]}]" />
          <attvalue for="9" value="435" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-cab35826f1356487207a5472cfaf8878-e-10" label="a/2⟨110⟩{001}">
        <attvalues>
          <attvalue for="0" value="a/2⟨110⟩{001}" />
          <attvalue for="1" value="Slip System" />
          <attvalue for="2" value="一种定义在L12结构中的晶体学滑移系，由{001}滑移面和a/2⟨110⟩滑移方向构成。它是一种理论上潜在的优选滑移系，但在实验中并未被观测到其活化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-cab35826f1356487207a5472cfaf8878" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cab35826f1356487207a5472cfaf8878-e-10&quot;]}]" />
          <attvalue for="9" value="436" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-2ea107a54755373c4c649a5b4b0b14ad-e-1" label="a/2⟨110⟩{111} dislocation">
        <attvalues>
          <attvalue for="0" value="a/2⟨110⟩{111} dislocation" />
          <attvalue for="1" value="Crystallographic Defect" />
          <attvalue for="2" value="一种晶体材料中的线缺陷，其伯格斯矢量为a/2&lt;110&gt;，在{111}晶面上滑移。它是面心立方(FCC)金属及合金中最主要的位错类型和塑性变形机制。在高温合金中，筏排(rafting)组织的形成会阻碍其运动，从而降低其活性。" />
          <attvalue for="3" value="{&quot;Burgers vector&quot;: &quot;a/2⟨110⟩&quot;, &quot;slip plane&quot;: &quot;{111}&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-2ea107a54755373c4c649a5b4b0b14ad" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;a/2(110){111} dislocation&quot;, &quot;a/2(110){111} dislocations&quot;, &quot;a/2⟨110⟩{111} dislocations&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2ea107a54755373c4c649a5b4b0b14ad-e-1&quot;, &quot;chunk-9a94346ed73c8bcf6797ad71ded00b42-e-8&quot;, &quot;chunk-4e2080b39d531470813c664fcc6dedf9-e-2&quot;, &quot;chunk-9a641206a39d9f183256b080afe1f768-e-1&quot;, &quot;chunk-9108d08e6e7d916cfb35fde79b233c67-e-12&quot;, &quot;chunk-3e64561be3c56bb2625ff8ce6474f540-e-1&quot;, &quot;chunk-003c7763c31b55c8a5748939ac729c6a-e-8&quot;, &quot;chunk-7cf96eceef65bf46495ba2d8c36b9a73-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-2ea107a54755373c4c649a5b4b0b14ad-e-5" label="Energy penalty">
        <attvalues>
          <attvalue for="0" value="Energy penalty" />
          <attvalue for="1" value="Physical Effect" />
          <attvalue for="2" value="在材料科学中，指形成反相畴界（APB fault）时，因破坏了原子的有序排列而导致的系统能量显著增加的现象。这种能量成本是阻碍该缺陷形成与扩展的势垒。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2ea107a54755373c4c649a5b4b0b14ad" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2ea107a54755373c4c649a5b4b0b14ad-e-6" label="Closure vector">
        <attvalues>
          <attvalue for="0" value="Closure vector" />
          <attvalue for="1" value="Crystallographic Vector" />
          <attvalue for="2" value="**Closure vector**&#10;&#10;一种晶体学矢量，用于描述和校正γ'相晶格中的闭合失配（closure failure），以恢复晶格的完整性。它的大小是相应伯格斯矢量的两倍且方向相同，是表征有序合金中超位错几何特征的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-2ea107a54755373c4c649a5b4b0b14ad" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;closure vectors&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2ea107a54755373c4c649a5b4b0b14ad-e-6&quot;, &quot;chunk-da122ebde0d16d97da9e3e19d5be9708-e-2&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9a641206a39d9f183256b080afe1f768-e-5" label="superdislocation">
        <attvalues>
          <attvalue for="0" value="superdislocation" />
          <attvalue for="1" value="Crystallographic Defect" />
          <attvalue for="2" value="超位错是有序晶体结构（如金属间化合物）中的一种复合位错。它由两个或多个单位错构成，这些单位错被它们之间的反相畴界（APB）等平面缺陷束缚在一起。在塑性变形中，该组合作为一个整体滑移，是此类材料的主要变形机制，同时能维持晶体的长程有序。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-9a641206a39d9f183256b080afe1f768" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Superdislocation&quot;, &quot;super dislocation&quot;, &quot;superdislocations&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0625d83d7200f989528119d9ba61865a-e-15&quot;, &quot;chunk-3b4422ce09cd66eaf6abd58690d6f8ef-e-1&quot;, &quot;chunk-9a641206a39d9f183256b080afe1f768-e-5&quot;, &quot;chunk-795763ad7f38bb8adeb25f9d763ce8dd-e-3&quot;, &quot;chunk-eb23a1fa1bb857c2e5b4e84047321caa-e-7&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-9a641206a39d9f183256b080afe1f768-e-6" label="anti-phase boundary">
        <attvalues>
          <attvalue for="0" value="anti-phase boundary" />
          <attvalue for="1" value="Crystal Defect" />
          <attvalue for="2" value="反相畴界（Anti-phase boundary）是一种存在于有序合金或化合物晶体中的面缺陷。在此界面两侧，原子在晶格亚点阵上的有序占位关系呈反相。它通常是连接两个超分差排的带状错排区域。" />
          <attvalue for="3" value="{&quot;abbreviation&quot;: &quot;APB&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-9a641206a39d9f183256b080afe1f768" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f263635cd44ee57c5a9142ff0e73030b-e-4" label="γ' precipitate">
        <attvalues>
          <attvalue for="0" value="γ' precipitate" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="γ'相是一种具有L1₂型有序晶体结构的金属间化合物沉淀相，是镍基等高温合金中的主要强化相。其有序结构能有效阻碍位错运动，是超偏位错（superpartials）发生强耦合剪切等强化机制的位置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f263635cd44ee57c5a9142ff0e73030b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f263635cd44ee57c5a9142ff0e73030b-e-4&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bcb76bb0ef5881469a3b9478e223d894-e-2" label="Section 2.3">
        <attvalues>
          <attvalue for="0" value="Section 2.3" />
          <attvalue for="1" value="Document Section" />
          <attvalue for="2" value="第2.3节是一个文件章节，其核心内容为详细阐述“超分位错耦合”（coupling of superpartial dislocations）的机制、原理与过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-bcb76bb0ef5881469a3b9478e223d894" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bcb76bb0ef5881469a3b9478e223d894-e-4" label="Ni3Al">
        <attvalues>
          <attvalue for="0" value="Ni3Al" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍三铝（Ni3Al）是一种由镍和铝组成的金属间化合物，具有有序的L1₂晶体结构。作为镍基高温合金中的关键强化相（γ'相），它赋予材料优异的高温强度、抗蠕变和抗氧化性能，是航空发动机涡轮叶片等高温部件的核心材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-bcb76bb0ef5881469a3b9478e223d894" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bcb76bb0ef5881469a3b9478e223d894-e-5" label="Kear and co-workers">
        <attvalues>
          <attvalue for="0" value="Kear and co-workers" />
          <attvalue for="1" value="Researcher" />
          <attvalue for="2" value="Kear and co-workers是一个先驱性研究团队，以其关于金属间化合物Ni3Al中平面缺陷的开创性研究论文而闻名，其成果在该领域被广泛引用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-bcb76bb0ef5881469a3b9478e223d894" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bcb76bb0ef5881469a3b9478e223d894-e-7" label="Figure 2.39">
        <attvalues>
          <attvalue for="0" value="Figure 2.39" />
          <attvalue for="1" value="Figure" />
          <attvalue for="2" value="图2.39是一幅示意图，旨在直观地展示晶体结构中{111}晶面族的堆垛方式和顺序。该图通过可视化形式，阐释了这些特定晶面层层堆叠的排列规律。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-bcb76bb0ef5881469a3b9478e223d894" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1a5bdd6114d60338a6db59595a5e76c4-e-1" label="⟨111⟩">
        <attvalues>
          <attvalue for="0" value="⟨111⟩" />
          <attvalue for="1" value="Crystallographic Direction" />
          <attvalue for="2" value="⟨111⟩是晶体学中代表晶向族的密勒指数。在立方晶系中，它指代一组等效的体对角线方向。该方向对于确定材料的力学性能（如塑性变形）至关重要，并且是体心立方(BCC)结构中的原子密排方向。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
