      <node id="chunk-225043bdf7b58131b7138652c49cfca0-e-16" label="University of Southampton">
        <attvalues>
          <attvalue for="0" value="University of Southampton" />
          <attvalue for="1" value="Institution" />
          <attvalue for="2" value="南安普顿大学（University of Southampton）是一所位于英国南安普顿的世界顶尖公立研究型大学，为英国罗素大学集团创始成员。该校在工程学、计算机科学、海洋学等领域的研究实力雄厚，享有卓越的国际声誉。" />
          <attvalue for="3" value="{}" />
