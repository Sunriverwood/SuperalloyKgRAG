      <edge source="chunk-28445053586870da241f4ba6806f06eb-e-6" target="chunk-9fdfa272aaae5e3c817cad2953b39e4e-e-3" id="chunk-9b96433e844031d4f15964cb1b24320d-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_DEFINED_BY" />
          <attvalue for="12" value="The value of S'11 is calculated using the elastic compliance constants S11, S12, and S44." />
          <attvalue for="13" value="1/E = S'11 = S11 - 2(S11 - S12 - 1/2 S44) [l1^2l2^2 + l2^2l3^2 + l3^2l1^2]" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-9b96433e844031d4f15964cb1b24320d" />
          <attvalue for="16" value="0.001349527665317139" />
          <attvalue for="17" value="0.4008097165991903" />
