        <attvalues>
          <attvalue for="11" value="IS_DEFINED_BY" />
          <attvalue for="12" value="The value of S'11 is a function of the anisotropy term [l1^2l2^2 + l2^2l3^2 + l3^2l1^2]." />
          <attvalue for="13" value="1/E = S'11 = S11 - 2(S11 - S12 - 1/2 S44) [l1^2l2^2 + l2^2l3^2 + l3^2l1^2]" />
