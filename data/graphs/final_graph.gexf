      <edge source="chunk-024c36ea3394fc7ba3bfdd8df0168497-e-6" target="chunk-024c36ea3394fc7ba3bfdd8df0168497-e-1" id="chunk-024c36ea3394fc7ba3bfdd8df0168497-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="STRENGTHENS" />
          <attvalue for="12" value="Strengthening is imparted to superalloy turbine discs by precipitation hardening." />
          <attvalue for="13" value="hence, great emphasis has been placed on imparting strengthening by grain size and precipitation hardening due to the y' phase." />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-024c36ea3394fc7ba3bfdd8df0168497" />
          <attvalue for="16" value="0.005012182387747998" />
          <attvalue for="17" value="0.40300730943264884" />
        </attvalues>
      </edge>
      <edge source="chunk-024c36ea3394fc7ba3bfdd8df0168497-e-8" target="chunk-024c36ea3394fc7ba3bfdd8df0168497-e-1" id="chunk-024c36ea3394fc7ba3bfdd8df0168497-r-7" weight="3.0">
        <attvalues>
          <attvalue for="11" value="IS_A_SUBTYPE_OF" />
          <attvalue for="12" value="High-pressure discs are a specific type of superalloy turbine disc where the design situation is altering." />
          <attvalue for="13" value="But this situation has been altering steadily – particularly for high-pressure discs" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-024c36ea3394fc7ba3bfdd8df0168497" />
          <attvalue for="16" value="0.0001392272885485555" />
          <attvalue for="17" value="0.13341686970646247" />
        </attvalues>
      </edge>
      <edge source="chunk-476c99d22cc46115c3dc1dca1b6b4708-e-2" target="chunk-476c99d22cc46115c3dc1dca1b6b4708-e-7" id="chunk-476c99d22cc46115c3dc1dca1b6b4708-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="REQUIRES_RESISTANCE_TO" />
          <attvalue for="12" value="High-pressure discs require resistance to high-temperature ‘dwell' crack propagation due to rising temperatures." />
          <attvalue for="13" value="Consequently, the need to impart resistance to high-temperature ‘dwell' crack propagation and creep is assuming greater importance." />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-476c99d22cc46115c3dc1dca1b6b4708" />
          <attvalue for="16" value="0.00011566042100393245" />
          <attvalue for="17" value="0.4000693962526024" />
        </attvalues>
      </edge>
      <edge source="chunk-476c99d22cc46115c3dc1dca1b6b4708-e-2" target="chunk-966af38b21cd6fefe9490e0dc9e97393-e-5" id="chunk-476c99d22cc46115c3dc1dca1b6b4708-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="REQUIRES_RESISTANCE_TO" />
          <attvalue for="12" value="High-pressure discs require resistance to creep due to rising temperatures." />
          <attvalue for="13" value="Consequently, the need to impart resistance to high-temperature ‘dwell' crack propagation and creep is assuming greater importance." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-476c99d22cc46115c3dc1dca1b6b4708" />
          <attvalue for="16" value="0.00011566042100393245" />
          <attvalue for="17" value="0.4000693962526024" />
        </attvalues>
      </edge>
      <edge source="chunk-476c99d22cc46115c3dc1dca1b6b4708-e-4" target="chunk-476c99d22cc46115c3dc1dca1b6b4708-e-5" id="chunk-476c99d22cc46115c3dc1dca1b6b4708-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DEFINES" />
          <attvalue for="12" value="The turbine blading is located along the gas flow path." />
          <attvalue for="13" value="the turbine blading, and thus the gas flow path, have been rising" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-476c99d22cc46115c3dc1dca1b6b4708" />
          <attvalue for="16" value="0.001488095238095238" />
          <attvalue for="17" value="0.40089285714285716" />
        </attvalues>
      </edge>
      <edge source="chunk-476c99d22cc46115c3dc1dca1b6b4708-e-6" target="chunk-925bc5f619d7b2214c7a718b66fcfe15-e-9" id="chunk-476c99d22cc46115c3dc1dca1b6b4708-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="ENABLES_HIGH_TEMPERATURE_IN" />
          <attvalue for="12" value="Advanced aeroengine designs made it possible for rim sections to reach operating temperatures of 750°C or 815°C." />
          <attvalue for="13" value="in 2000 a figure of 750°C or even 815°C for high- performance military applications was possible for some advanced aeroengine designs." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-476c99d22cc46115c3dc1dca1b6b4708" />
          <attvalue for="16" value="0.000992063492063492" />
          <attvalue for="17" value="0.4005952380952381" />
        </attvalues>
      </edge>
      <edge source="chunk-476c99d22cc46115c3dc1dca1b6b4708-e-7" target="chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-3" id="chunk-e0ff1a8ba2325330670b26bb64b4b73d-r-1" weight="4.0">
        <attvalues>
          <attvalue for="11" value="INFLUENCES" />
          <attvalue for="12" value="The increasing importance of high-temperature ‘dwell' crack propagation leads to more stringent requirements for processing steps." />
          <attvalue for="13" value="high-temperature ‘dwell' crack propagation and creep is assuming greater importance. A corollary is that the requirements placed on the various processing steps required for component fabrication are becoming more stringent." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-e0ff1a8ba2325330670b26bb64b4b73d" />
          <attvalue for="16" value="0.00017349063150589867" />
          <attvalue for="17" value="0.2667707610455702" />
        </attvalues>
      </edge>
      <edge source="chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-3" target="chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-4" id="chunk-e0ff1a8ba2325330670b26bb64b4b73d-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_REQUIRED_FOR" />
          <attvalue for="12" value="Processing steps are required for component fabrication." />
          <attvalue for="13" value="A corollary is that the requirements placed on the various processing steps required for component fabrication are becoming more stringent." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-e0ff1a8ba2325330670b26bb64b4b73d" />
          <attvalue for="16" value="0.0012144344205412907" />
          <attvalue for="17" value="0.4007286606523248" />
        </attvalues>
      </edge>
      <edge source="chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-5" target="chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-6" id="chunk-e0ff1a8ba2325330670b26bb64b4b73d-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="SHAPES" />
          <attvalue for="12" value="Thirty years ago, the turbine disc supplier's sole responsibility was to shape a superalloy billet." />
          <attvalue for="13" value="Thirty years ago, the sole responsibility of the turbine disc supplier was to shape a superalloy billet..." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-e0ff1a8ba2325330670b26bb64b4b73d" />
          <attvalue for="16" value="0.0018099547511312216" />
          <attvalue for="17" value="0.40108597285067876" />
        </attvalues>
      </edge>
