          <attvalue for="11" value="EXHIBITED" />
          <attvalue for="12" value="The No 9 can was found to have circumferential cracking after 3371 cycles." />
          <attvalue for="13" value="In November 1983, after 3371 cycles, the No 9 can had been inspected and circumferential cracking of 180 mm combined length had been repaired, by fusion welding." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-c10a0017a749c4bb59ab487c7354c02a" />
