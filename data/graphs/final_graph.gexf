      <node id="chunk-6f4f79d57f35ab3e77324ff6707d70bf-e-8" label="Y. Koizumi">
        <attvalues>
          <attvalue for="0" value="Y. Koizumi" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="Y. Koizumi是一位学者，研究领域为材料科学与航空工程。他是学术论文《先进喷气发动机退役热障涂层部件的降解机制》的合著者之一，该研究聚焦于航空发动机热障涂层（TBC）材料的失效机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-6f4f79d57f35ab3e77324ff6707d70bf" />
