          <attvalue for="7" value="[&quot;stool&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6d1754ebfc8f173c80a066a37489efe5-e-10&quot;, &quot;chunk-3462692c1f56ef713abc917f570c8aff-e-5&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-3462692c1f56ef713abc917f570c8aff-e-1" label="ss">
        <attvalues>
          <attvalue for="0" value="ss" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="一个名为ss的参数，其有效取值范围被定义或限定在50%至75%的百分比区间内。" />
          <attvalue for="3" value="{&quot;range&quot;: &quot;50–75%&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-3462692c1f56ef713abc917f570c8aff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="288" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-3462692c1f56ef713abc917f570c8aff-e-2" label="current">
        <attvalues>
          <attvalue for="0" value="current" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="一种物理现象，特指在铸造工艺中，从熔池弯月面和引锭盘位置进入金属铸锭的电流。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-3462692c1f56ef713abc917f570c8aff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-3462692c1f56ef713abc917f570c8aff-e-4" label="meniscus">
        <attvalues>
          <attvalue for="0" value="meniscus" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="在电渣重熔等冶金过程中，指电流进入金属铸锭的特定接触位置或界面区域。此术语区别于流体物理学中的弯曲液面或解剖学中的半月板。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-3462692c1f56ef713abc917f570c8aff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3462692c1f56ef713abc917f570c8aff-e-6" label="copper crucible">
        <attvalues>
          <attvalue for="0" value="copper crucible" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="一种铜制坩埚，是用于高温冶金或材料加工的设备。它作为容器，在其内部容纳待处理的物料以及位于其底部的模座（stool）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-3462692c1f56ef713abc917f570c8aff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3462692c1f56ef713abc917f570c8aff-e-7" label="solidified material">
        <attvalues>
          <attvalue for="0" value="solidified material" />
          <attvalue for="1" value="Material State" />
          <attvalue for="2" value="指物质从液态或气态等非固态，通过冷却、压力变化或化学反应等过程转变成的固体。该状态下的物质具有确定的形状和体积，内部粒子排列紧密。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-3462692c1f56ef713abc917f570c8aff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3462692c1f56ef713abc917f570c8aff-e-8" label="Molten Pool">
        <attvalues>
          <attvalue for="0" value="Molten Pool" />
          <attvalue for="1" value="Process Feature" />
          <attvalue for="2" value="熔融区（Molten Zone）是一种工艺特征，也称熔池，指材料加工过程中形成的熔融状态区域。在稳态条件下，其尺寸和形状近似保持恒定。熔融区的深度会随功率输入的增加而加深，并通常相对于电极的位置进行定义或测量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-3462692c1f56ef713abc917f570c8aff" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Molten Zone&quot;, &quot;molten pool&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6d1754ebfc8f173c80a066a37489efe5-e-1&quot;, &quot;chunk-3462692c1f56ef713abc917f570c8aff-e-8&quot;, &quot;chunk-a8ba62bd8a40bbbf72905fea95785308-e-6&quot;, &quot;chunk-f67fa6f044c8ebf471779ebaa3315c84-e-1&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-3462692c1f56ef713abc917f570c8aff-e-9" label="complex flow patterns">
        <attvalues>
          <attvalue for="0" value="complex flow patterns" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="一种物理现象，指在熔池内部，因浮力、电磁搅拌、马兰戈尼效应等多种驱动力共同作用，而形成的错综复杂的流体运动。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-3462692c1f56ef713abc917f570c8aff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-3462692c1f56ef713abc917f570c8aff-e-10" label="buoyancy forces">
        <attvalues>
          <attvalue for="0" value="buoyancy forces" />
          <attvalue for="1" value="Physical Force" />
          <attvalue for="2" value="浮力是一种物理力，指流体内部因密度差异（常由温度或成分梯度引起）而产生的力。该力使密度较小的流体部分上升，密度较大的部分下沉，从而驱动流体发生自然对流，是形成复杂流动模式（如熔池流动）的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-3462692c1f56ef713abc917f570c8aff" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Buoyancy forces&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3462692c1f56ef713abc917f570c8aff-e-10&quot;, &quot;chunk-0fc2e7bdc755aa4e47c0be4c7ca98b87-e-7&quot;, &quot;chunk-8f374054b3af3dbd36329b272a6ab2a1-e-3&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3462692c1f56ef713abc917f570c8aff-e-11" label="electromagnetic stirring">
        <attvalues>
          <attvalue for="0" value="electromagnetic stirring" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="电磁搅拌是一种利用电磁力在导电熔体（如熔融金属）中引起定向流动的冶金过程。通过施加变化的磁场，它能搅动熔池，从而实现成分和温度的均匀化、细化晶粒并去除夹杂物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-3462692c1f56ef713abc917f570c8aff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3462692c1f56ef713abc917f570c8aff-e-12" label="Marangoni effect">
        <attvalues>
          <attvalue for="0" value="Marangoni effect" />
          <attvalue for="1" value="Physical Force" />
          <attvalue for="2" value="马拉戈尼力（Marangoni forces）是一种作用于流体界面的物理力，源于表面张力的梯度。这种梯度通常由温度或浓度的不均匀分布造成，并驱动流体由低表面张力区域流向高表面张力区域，进而影响界面上的粒子或夹杂物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-3462692c1f56ef713abc917f570c8aff" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Marangoni forces&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3462692c1f56ef713abc917f570c8aff-e-12&quot;, &quot;chunk-a112fb1af2aeb898bf0f5a14a40c216f-e-11&quot;, &quot;chunk-d3b2083853e798b7a5f920d4f0cef70d-e-1&quot;, &quot;chunk-0fc2e7bdc755aa4e47c0be4c7ca98b87-e-8&quot;, &quot;chunk-8f374054b3af3dbd36329b272a6ab2a1-e-4&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-3462692c1f56ef713abc917f570c8aff-e-13" label="temperature dependence of the surface tension">
        <attvalues>
          <attvalue for="0" value="temperature dependence of the surface tension" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="表面张力的温度依赖性是一种材料属性，描述了液体表面张力随温度变化的规律。对于大多数液体，表面张力随温度升高而减小。该特性是马兰戈尼效应的物理基础，因为液体表面的温度梯度会造成表面张力梯度，进而驱动流体流动。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-3462692c1f56ef713abc917f570c8aff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3462692c1f56ef713abc917f570c8aff-e-14" label="molten material">
        <attvalues>
          <attvalue for="0" value="molten material" />
          <attvalue for="1" value="Material State" />
          <attvalue for="2" value="指从“池”(pool)的中心流出，并以特定速度和流动模式在表面上铺展的液态物质。其流动形态是该物质的一个关键特征，如图4.7所示。" />
          <attvalue for="3" value="{&quot;surface_velocity&quot;: &quot;0.01 m/s&quot;, &quot;flow_pattern&quot;: &quot;radial&quot;}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-3462692c1f56ef713abc917f570c8aff" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3462692c1f56ef713abc917f570c8aff-e-14&quot;, &quot;chunk-914e8f4139d78791da0d0b73531cfbc5-e-1&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-914e8f4139d78791da0d0b73531cfbc5-e-2" label="pool">
        <attvalues>
          <attvalue for="0" value="pool" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种熔融物质的中心聚集体。它不仅是物质的集合，更是其向外流动的源点，定义了物质流动的起始中心位置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-914e8f4139d78791da0d0b73531cfbc5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-914e8f4139d78791da0d0b73531cfbc5-e-3" label="Figure 4.7">
        <attvalues>
          <attvalue for="0" value="Figure 4.7" />
          <attvalue for="1" value="Reference" />
          <attvalue for="2" value="图4.7是正文中引用的图示，旨在直观描绘熔融材料的流动模式，为相关论述提供视觉参考。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-914e8f4139d78791da0d0b73531cfbc5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-914e8f4139d78791da0d0b73531cfbc5-e-4" label="ingot">
        <attvalues>
          <attvalue for="0" value="ingot" />
          <attvalue for="1" value="Product" />
          <attvalue for="2" value="铸锭是一种通过熔炼工艺制成的产品。与作为原料的电极相比，其组织结构和化学成分更为优越，且有害的杂质元素含量显著降低。" />
          <attvalue for="3" value="{&quot;quality&quot;: &quot;far superior structure and chemistry&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-914e8f4139d78791da0d0b73531cfbc5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-914e8f4139d78791da0d0b73531cfbc5-e-6" label="tramp elements">
        <attvalues>
          <attvalue for="0" value="tramp elements" />
          <attvalue for="1" value="Element Classification" />
          <attvalue for="2" value="Tramp elements指材料中非有意加入、且对性能有害的杂质元素，尤指钢铁中的硫、磷等。这类元素易在晶界等微观结构处偏析，显著降低材料的韧性与塑性，是导致材料脆化的主要原因之一。" />
          <attvalue for="3" value="{&quot;property&quot;: &quot;substantial vapour pressures&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-914e8f4139d78791da0d0b73531cfbc5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Tramp element&quot;, &quot;Tramp elements&quot;, &quot;tramp element&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-914e8f4139d78791da0d0b73531cfbc5-e-6&quot;, &quot;chunk-c000c9e441af2d51c033dcc75d8753cc-e-2&quot;, &quot;chunk-61a441c3ea495edfbd1f923ab25e12c9-e-11&quot;, &quot;chunk-c54fb0cde287461ac785a255da940d8d-e-7&quot;, &quot;chunk-0440023a44a202881a859e66f23ec3de-e-5&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-914e8f4139d78791da0d0b73531cfbc5-e-7" label="Lead">
        <attvalues>
          <attvalue for="0" value="Lead" />
          <attvalue for="1" value="Substance" />
          <attvalue for="2" value="铅（Lead）是一种化学元素，符号为Pb，原子序数82。它是一种质地柔软、有毒的重金属，主要用于制造蓄电池和防辐射材料。在冶金学中，铅被视为一种影响合金性能的有害杂质元素（Tramp element）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-914e8f4139d78791da0d0b73531cfbc5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;lead&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-914e8f4139d78791da0d0b73531cfbc5-e-7&quot;, &quot;chunk-c54fb0cde287461ac785a255da940d8d-e-6&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-914e8f4139d78791da0d0b73531cfbc5-e-8" label="bismuth">
        <attvalues>
          <attvalue for="0" value="bismuth" />
          <attvalue for="1" value="Substance" />
          <attvalue for="2" value="铋（Bismuth）是一种化学元素，符号为Bi，原子序数83。它是一种银白色带粉红光泽的后过渡金属，质地脆，熔点低。在冶金学中，它常被视为一种“杂质元素”（tramp element），少量存在于钢或铜合金中便会显著降低材料的延展性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-914e8f4139d78791da0d0b73531cfbc5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-914e8f4139d78791da0d0b73531cfbc5-e-8&quot;, &quot;chunk-61a441c3ea495edfbd1f923ab25e12c9-e-10&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a112fb1af2aeb898bf0f5a14a40c216f-e-1" label="Bismuth">
        <attvalues>
          <attvalue for="0" value="Bismuth" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="铋是一种化学元素。根据上下文，它具有显著的蒸气压，此特性使其在特定工艺过程中容易挥发，即转化为气体状态。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-a112fb1af2aeb898bf0f5a14a40c216f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="289" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-a112fb1af2aeb898bf0f5a14a40c216f-e-2" label="Oxygen">
        <attvalues>
          <attvalue for="0" value="Oxygen" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="氧是一种化学元素，在真空技术中特指一种气体。它可通过真空系统进行脱气处理，但因其化学活性高，当与其他特定元素共存时，难以被彻底清除。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a112fb1af2aeb898bf0f5a14a40c216f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a112fb1af2aeb898bf0f5a14a40c216f-e-3" label="Nitrogen">
        <attvalues>
          <attvalue for="0" value="Nitrogen" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="氮（Nitrogen）是一种化学元素，通常为气体形态。在真空系统中，它是一种可被脱除的气体，但当体系中存在钛、铌等易形成氮化物的元素时，其完全去除会变得非常困难。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a112fb1af2aeb898bf0f5a14a40c216f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a112fb1af2aeb898bf0f5a14a40c216f-e-4" label="Vacuum system">
        <attvalues>
          <attvalue for="0" value="Vacuum system" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="一种在密闭空间内产生并维持低于大气压环境的设备系统。它通过创造低压条件，可用于去除材料中的氧气和氮气等溶解气体，从而实现脱气工艺。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a112fb1af2aeb898bf0f5a14a40c216f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a112fb1af2aeb898bf0f5a14a40c216f-e-6" label="Niobium">
        <attvalues>
          <attvalue for="0" value="Niobium" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="**铌 (Niobium)**，化学符号Nb，是一种稀有的难熔金属，主要用作合金添加剂。在IN718等镍基高温合金中，它是形成强化相的关键元素，能显著提升材料的高温强度。同时，它也是构成莱氏相（Laves phase）这类金属间化合物的主要组分之一，其形态和分布影响着合金的最终性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a112fb1af2aeb898bf0f5a14a40c216f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Nb&quot;, &quot;niobium&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a112fb1af2aeb898bf0f5a14a40c216f-e-6&quot;, &quot;chunk-c66cb4a523402b814bf33ff19d16eb24-e-7&quot;, &quot;chunk-2b6a04ecc641ed4c1cec1b3e414ec201-e-7&quot;, &quot;chunk-99e1c2354bf8364a02d01889797902c8-e-3&quot;, &quot;chunk-3598448f2352e6832a423e2072a2f043-e-4&quot;, &quot;chunk-9f8adabfb1010fa4a4528e361c3f5223-e-4&quot;, &quot;chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-6&quot;, &quot;chunk-8c75d16dc148897cf486c21cbe30e4be-e-8&quot;, &quot;chunk-23893d297564190aa46fd314ec1e6f0e-e-5&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-a112fb1af2aeb898bf0f5a14a40c216f-e-7" label="Oxides">
        <attvalues>
          <attvalue for="0" value="Oxides" />
          <attvalue for="1" value="Compound" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;指在特定工艺中作为杂质的氧化物类化合物。可通过浮选和热分解等方法去除，其残留物会形成氧化物碎屑。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a112fb1af2aeb898bf0f5a14a40c216f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a112fb1af2aeb898bf0f5a14a40c216f-e-8" label="Flotation">
        <attvalues>
          <attvalue for="0" value="Flotation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="浮选（Flotation）是一种用于去除氧化物的工艺。与热解离法相比，该方法通常被认为更有效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-a112fb1af2aeb898bf0f5a14a40c216f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a112fb1af2aeb898bf0f5a14a40c216f-e-9" label="Thermal dissociation">
        <attvalues>
          <attvalue for="0" value="Thermal dissociation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="热解离是一种利用高温使化合物（如氧化物）分解成更简单物质的化学过程。该方法通过对氧化物进行加热，促使其发生分解反应，从而达到去除的目的。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-a112fb1af2aeb898bf0f5a14a40c216f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a112fb1af2aeb898bf0f5a14a40c216f-e-10" label="Surface tension">
        <attvalues>
          <attvalue for="0" value="Surface tension" />
          <attvalue for="1" value="Physical Force" />
          <attvalue for="2" value="表面张力是一种物理性质，源于液体分子间的内聚力。该力使液体表面犹如一张拉伸的弹性薄膜，并倾向于收缩至最小可能表面积，导致液滴呈球形等现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-a112fb1af2aeb898bf0f5a14a40c216f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a112fb1af2aeb898bf0f5a14a40c216f-e-12" label="Oxide debris">
        <attvalues>
          <attvalue for="0" value="Oxide debris" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种由氧化物颗粒组成的材料污染物。在熔融材料加工等过程中，因表面张力梯度产生的马兰戈尼力（Marangoni forces）会驱动这些细小颗粒聚集、团聚而形成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-a112fb1af2aeb898bf0f5a14a40c216f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a112fb1af2aeb898bf0f5a14a40c216f-e-12&quot;, &quot;chunk-d3b2083853e798b7a5f920d4f0cef70d-e-2&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-d3b2083853e798b7a5f920d4f0cef70d-e-4" label="Superalloys">
        <attvalues>
          <attvalue for="0" value="Superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="高温合金是一类以镍、钴或铁为基体，能在极端高温和应力下保持优异机械强度、抗蠕变及抗腐蚀性能的金属材料。为确保其高纯净度与综合性能，真空电弧重熔(VAR)是其最重要且应用最广泛的生产工艺。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d3b2083853e798b7a5f920d4f0cef70d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d3b2083853e798b7a5f920d4f0cef70d-e-5" label="White spots">
        <attvalues>
          <attvalue for="0" value="White spots" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="白斑（White spots）是一种出现在高温合金铸锭中的材料缺陷，会显著降低材料的极限抗拉强度（UTS）等力学性能。该缺陷在真空自耗电弧重熔（VAR）工艺中更易形成，而电渣重熔（ESR）工艺则较少出现，通过加强过程控制可有效减少其产生。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d3b2083853e798b7a5f920d4f0cef70d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;white spot defect&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d3b2083853e798b7a5f920d4f0cef70d-e-5&quot;, &quot;chunk-c1dd8907c8eade3b97e432bd0448abba-e-3&quot;, &quot;chunk-8672ed457160465cfb20b55abb713612-e-2&quot;, &quot;chunk-d2428cb3e80954cab38bfce19b363f27-e-5&quot;, &quot;chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-11&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-d3b2083853e798b7a5f920d4f0cef70d-e-6" label="Solute-lean regions">
        <attvalues>
          <attvalue for="0" value="Solute-lean regions" />
          <attvalue for="1" value="Material Characteristic" />
          <attvalue for="2" value="贫溶质材料 (Solute-lean material) 指材料中溶质含量相对较低的区域。其熔点通常高于主体成分，在凝固或焊接等过程中，这种成分不均的区域是导致产生白斑（White-spot）缺陷可能性的主要因素之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-d3b2083853e798b7a5f920d4f0cef70d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Solute-lean material&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d3b2083853e798b7a5f920d4f0cef70d-e-6&quot;, &quot;chunk-c1dd8907c8eade3b97e432bd0448abba-e-5&quot;, &quot;chunk-969bf7835071b6a6f17f573257c14d5c-e-2&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-d3b2083853e798b7a5f920d4f0cef70d-e-7" label="Hardening phases γ' and γ''">
        <attvalues>
          <attvalue for="0" value="Hardening phases γ' and γ''" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="γ' (gamma prime) 和 γ'' (gamma double prime) 相是主要由硬化元素形成的沉淀强化相，常见于镍基高温合金中。它们是合金获得高温强度的关键，其在微观结构中的缺失是导致材料局部性能弱化并形成“白斑”缺陷的根本原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d3b2083853e798b7a5f920d4f0cef70d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Hardening phases γ' and y\&quot;&quot;, &quot;Hardening phases γ' and γ\&quot;&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d3b2083853e798b7a5f920d4f0cef70d-e-7&quot;, &quot;chunk-c1dd8907c8eade3b97e432bd0448abba-e-1&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d3b2083853e798b7a5f920d4f0cef70d-e-8" label="Hardening elements">
        <attvalues>
          <attvalue for="0" value="Hardening elements" />
          <attvalue for="1" value="Chemical Element Group" />
          <attvalue for="2" value="硬化元素 (Hardening elements) 是一组特定的化学合金元素，能形成γ'和γ''等强化相，从而显著提高材料的硬度与强度。在材料学中，这些元素在“白斑”缺陷区域内会发生贫化或完全缺失，是区分该缺陷与正常组织的关键特征。" />
          <attvalue for="3" value="{&quot;examples&quot;: &quot;Al, Ti, Nb&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-d3b2083853e798b7a5f920d4f0cef70d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d3b2083853e798b7a5f920d4f0cef70d-e-8&quot;, &quot;chunk-c1dd8907c8eade3b97e432bd0448abba-e-2&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c1dd8907c8eade3b97e432bd0448abba-e-4" label="Metallographical etching techniques">
        <attvalues>
          <attvalue for="0" value="Metallographical etching techniques" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="金相腐蚀技术是金相学中的一组工艺方法。它通过将化学腐蚀剂施加于抛光的金属样品上，利用其选择性侵蚀作用，使样品表面产生显微衬度，从而显示出如晶界、不同物相及贫溶质区等微观结构特征，以便于显微观察。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c1dd8907c8eade3b97e432bd0448abba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c1dd8907c8eade3b97e432bd0448abba-e-6" label="Mechanical properties">
        <attvalues>
          <attvalue for="0" value="Mechanical properties" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="力学性能是材料在外力作用下所表现出的抵抗变形或断裂等行为的性质。它是一组衡量材料表现的物理属性，主要指标包括强度、硬度、塑性、韧性和疲劳极限等，是工程应用中评估材料适用性的关键依据。" />
          <attvalue for="3" value="{&quot;examples&quot;: &quot;yield stress, ultimate tensile strength (UTS)&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c1dd8907c8eade3b97e432bd0448abba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;mechanical properties&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c1dd8907c8eade3b97e432bd0448abba-e-6&quot;, &quot;chunk-0af77caf506bcb6ff459691ed394fb4f-e-3&quot;, &quot;chunk-8e4f95988fb5d512b274348d9b3d4dca-e-4&quot;, &quot;chunk-31cd2366f102780cc28ad1a099e8127d-e-3&quot;, &quot;chunk-921a9348cd77597c4374323349308669-e-6&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8672ed457160465cfb20b55abb713612-e-1" label="Ultimate Tensile Strength (UTS)">
        <attvalues>
          <attvalue for="0" value="Ultimate Tensile Strength (UTS)" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="极限抗拉强度（UTS）是一种关键的材料力学性能，指材料在拉伸过程中发生显著颈缩或断裂前所能承受的最大应力。它代表了材料抵抗均匀塑性变形的最大能力，是工程应力-应变曲线的峰值点。该指标是评估材料强度和进行结构设计的重要依据，单位通常为兆帕(MPa)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-8672ed457160465cfb20b55abb713612" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Ultimate tensile strength&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-9&quot;, &quot;chunk-8672ed457160465cfb20b55abb713612-e-1&quot;, &quot;chunk-9f35adfc9c150d132285785cf907bbcb-e-5&quot;, &quot;chunk-53753c2242e7dd6a1f075c9d1be8ff40-e-1&quot;, &quot;chunk-12abccc567e86807dfdcf4f2bea50424-e-7&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8672ed457160465cfb20b55abb713612-e-5" label="Superalloy ingots">
        <attvalues>
          <attvalue for="0" value="Superalloy ingots" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="高温合金铸锭（Superalloy ingots）是一种高性能合金的初级铸造形态，通常以真空电弧重熔（VAR）作为其最终精炼工序。这种材料形态主要用于后续的锻造或加工，但在其生产过程中可能会形成“白斑”这类关键的冶金缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-8672ed457160465cfb20b55abb713612" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8672ed457160465cfb20b55abb713612-e-6" label="Process Control">
        <attvalues>
          <attvalue for="0" value="Process Control" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="过程控制是一种应用于VIM电极生产和VAR处理等制造环节的质量管理方法。它通过对生产程序的严密监控与关注，旨在降低或消除白斑（White Spot）这类冶金缺陷的发生概率，以确保最终产品质量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-8672ed457160465cfb20b55abb713612" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8672ed457160465cfb20b55abb713612-e-6&quot;, &quot;chunk-a8ba62bd8a40bbbf72905fea95785308-e-1&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8672ed457160465cfb20b55abb713612-e-7" label="VIM electrode production">
        <attvalues>
          <attvalue for="0" value="VIM electrode production" />
          <attvalue for="1" value="Manufacturing Step" />
          <attvalue for="2" value="VIM电极生产（VIM electrode production）指采用真空感应熔炼（VIM）技术制造电极的生产工序。该工序对过程控制要求严格，旨在通过精确控制来减少或消除最终产品中的白点等质量缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-8672ed457160465cfb20b55abb713612" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8672ed457160465cfb20b55abb713612-e-7&quot;, &quot;chunk-a8ba62bd8a40bbbf72905fea95785308-e-2&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a8ba62bd8a40bbbf72905fea95785308-e-4" label="White Spot">
        <attvalues>
          <attvalue for="0" value="White Spot" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="白点是一种材料缺陷。尽管其具体形成机理多样，但共同特征通常是外来物质掉入熔池而产生。这是一种可以通过优化过程控制来显著降低其发生概率的工艺缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a8ba62bd8a40bbbf72905fea95785308" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a8ba62bd8a40bbbf72905fea95785308-e-4&quot;, &quot;chunk-4e978ffab8ecad069ff358871c8db74d-e-5&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a8ba62bd8a40bbbf72905fea95785308-e-5" label="Material">
        <attvalues>
          <attvalue for="0" value="Material" />
          <attvalue for="1" value="Substance" />
          <attvalue for="2" value="一种化学成分与熔体不同的异质物质。它在熔炼或焊接等过程中落入熔池，是导致形成“白斑”缺陷的直接原因或关键因素。" />
          <attvalue for="3" value="{&quot;chemistry&quot;: &quot;differing&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a8ba62bd8a40bbbf72905fea95785308" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-969bf7835071b6a6f17f573257c14d5c-e-1" label="White-spot occurrence">
        <attvalues>
          <attvalue for="0" value="White-spot occurrence" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="白斑现象是一种材料凝固过程中产生的现象。其发生的可能性受多种因素影响，主要包括较长的局部凝固时间、材料中存在较大颗粒以及溶质含量较低（贫溶质材料），这些条件均会促进或增加白斑的形成几率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-969bf7835071b6a6f17f573257c14d5c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-969bf7835071b6a6f17f573257c14d5c-e-1&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-969bf7835071b6a6f17f573257c14d5c-e-3" label="Larger particles">
        <attvalues>
          <attvalue for="0" value="Larger particles" />
          <attvalue for="1" value="Material Characteristic" />
          <attvalue for="2" value="一种材料特性，指因尺寸较大而溶解缓慢的颗粒。与较小颗粒相比，其不完全溶解的状态是导致材料表面产生白点缺陷可能性的直接原因。" />
          <attvalue for="3" value="{&quot;dissolution_rate&quot;: &quot;low&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-969bf7835071b6a6f17f573257c14d5c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-969bf7835071b6a6f17f573257c14d5c-e-4" label="Larger local solidification times">
        <attvalues>
          <attvalue for="0" value="Larger local solidification times" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="一项材料凝固过程中的工艺参数，指特定区域从液态完全转变为固态所需时间较长。该条件通常由局部冷却速率过慢导致，会显著增加材料内部产生“白斑”（white-spot）缺陷的风险。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-969bf7835071b6a6f17f573257c14d5c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-969bf7835071b6a6f17f573257c14d5c-e-5" label="Smaller particles">
        <attvalues>
          <attvalue for="0" value="Smaller particles" />
          <attvalue for="1" value="Material Characteristic" />
          <attvalue for="2" value="一种材料特性，指物质颗粒尺寸较小的状态。由于具有更大的比表面积，与尺寸较大的颗粒相比，小颗粒通常表现出更快的溶解速率和更高的反应活性。" />
          <attvalue for="3" value="{&quot;dissolution_rate&quot;: &quot;high&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-969bf7835071b6a6f17f573257c14d5c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Finer particles&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-969bf7835071b6a6f17f573257c14d5c-e-5&quot;, &quot;chunk-766019f20e51155bf0a83e6038d841eb-e-2&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-969bf7835071b6a6f17f573257c14d5c-e-6" label="Bulk composition">
        <attvalues>
          <attvalue for="0" value="Bulk composition" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="指材料（如合金、岩石等）的整体平均化学成分。它代表主要构成元素的比例，忽略了材料内部的局部成分差异，是决定该材料熔点、密度等宏观物理性质的基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-969bf7835071b6a6f17f573257c14d5c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-982b3fe24bf9b207729c7cfe8c0d921e-e-1" label="White-spot occurrence">
        <attvalues>
          <attvalue for="0" value="White-spot occurrence" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="一种源于冠部和架部区域的缺陷现象。该现象的发生频率取决于工艺过程的稳定性，工艺不稳定是导致其产生的主要原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-982b3fe24bf9b207729c7cfe8c0d921e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-982b3fe24bf9b207729c7cfe8c0d921e-e-2" label="Process instabilities">
        <attvalues>
          <attvalue for="0" value="Process instabilities" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="指在生产或工艺过程中出现的不稳定状态。其特征为关键参数的波动或偏离正常范围，这种状态是导致或影响“白斑”类缺陷产生的重要因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-982b3fe24bf9b207729c7cfe8c0d921e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-982b3fe24bf9b207729c7cfe8c0d921e-e-3" label="Crown and shelf region">
        <attvalues>
          <attvalue for="0" value="Crown and shelf region" />
          <attvalue for="1" value="Process Region" />
          <attvalue for="2" value="**冠架区 (Crown and shelf region)**&#10;&#10;在真空自耗电弧重熔(VAR)过程中，于熔池与坩埚界面处形成的特定工艺区域。该区域被认为是导致金属铸锭产生“白斑”缺陷的主要材料来源。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-982b3fe24bf9b207729c7cfe8c0d921e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-982b3fe24bf9b207729c7cfe8c0d921e-e-5" label="Pool/crucible interface">
        <attvalues>
          <attvalue for="0" value="Pool/crucible interface" />
          <attvalue for="1" value="Process Interface" />
          <attvalue for="2" value="在材料熔炼或晶体生长工艺中，熔融物料（熔池）与坩埚内壁接触形成的边界区域。该界面是冠部和肩部区域（crown and shelf region）形成的关键位置，其状态对工艺稳定性和产品质量至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-982b3fe24bf9b207729c7cfe8c0d921e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-982b3fe24bf9b207729c7cfe8c0d921e-e-6" label="Changes in current distribution">
        <attvalues>
          <attvalue for="0" value="Changes in current distribution" />
          <attvalue for="1" value="Process Fluctuation" />
          <attvalue for="2" value="一种工艺波动，特指电流的空间分布产生微小变化，进而导致熔池中心位置发生偏移的现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-982b3fe24bf9b207729c7cfe8c0d921e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="105" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-982b3fe24bf9b207729c7cfe8c0d921e-e-7" label="Centre of the pool">
        <attvalues>
          <attvalue for="0" value="Centre of the pool" />
          <attvalue for="1" value="Process Component" />
          <attvalue for="2" value="熔池中的核心区域，其位置并非固定，会受电流分布变化等因素影响而发生移动。该中心的移动是导致铸锭冠部（crown）发生重熔的直接原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-982b3fe24bf9b207729c7cfe8c0d921e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="105" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-982b3fe24bf9b207729c7cfe8c0d921e-e-8" label="Remelting of the crown">
        <attvalues>
          <attvalue for="0" value="Remelting of the crown" />
          <attvalue for="1" value="Process Event" />
          <attvalue for="2" value="一种工艺现象，指由于熔池中心位置发生偏移，导致其已凝固的冠部部分区域重新熔化为液态的过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-982b3fe24bf9b207729c7cfe8c0d921e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="105" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f67fa6f044c8ebf471779ebaa3315c84-e-2" label="Crown">
        <attvalues>
          <attvalue for="0" value="Crown" />
          <attvalue for="1" value="Material Structure" />
          <attvalue for="2" value="一种固态物质结构。它会因下方熔池的促进作用而发生重熔和底切，这种不稳定性最终导致其自身材料坍塌并掉入熔池中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-f67fa6f044c8ebf471779ebaa3315c84" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f67fa6f044c8ebf471779ebaa3315c84-e-3" label="Electrode">
        <attvalues>
          <attvalue for="0" value="Electrode" />
          <attvalue for="1" value="Process Component" />
          <attvalue for="2" value="作为一种组件，其机械完整性存在隐患，在使用中易发生物理或化学降解，从而成为产生并掉落颗粒的污染源。" />
          <attvalue for="3" value="{&quot;mechanical_integrity&quot;: &quot;important&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-f67fa6f044c8ebf471779ebaa3315c84" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f67fa6f044c8ebf471779ebaa3315c84-e-3&quot;, &quot;chunk-4e978ffab8ecad069ff358871c8db74d-e-1&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-f67fa6f044c8ebf471779ebaa3315c84-e-4" label="Fragmented Dendritic Material">
        <attvalues>
          <attvalue for="0" value="Fragmented Dendritic Material" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="碎片化枝晶材料(Fragmented Dendritic Material)是一种源于电极的材料。其在微观上呈现为不连续的、破碎的树枝状晶体（即枝晶）形态。该材料的结构定义不仅包括枝晶本身，还涵盖了枝晶之间的区域（枝晶间区）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f67fa6f044c8ebf471779ebaa3315c84" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f67fa6f044c8ebf471779ebaa3315c84-e-6" label="Particles">
        <attvalues>
          <attvalue for="0" value="Particles" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="在电化学等过程中，因物理或化学作用（如降解、侵蚀）而从电极表面剥落或分离的颗粒状物质。这种现象通常是电极材料失效和性能衰退的标志。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-f67fa6f044c8ebf471779ebaa3315c84" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4e978ffab8ecad069ff358871c8db74d-e-2" label="Particles">
        <attvalues>
          <attvalue for="0" value="Particles" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="从电极(Electrode)脱落的材料颗粒。其关键特性是熔化行为与尺寸相关：当直径大于6毫米时，颗粒倾向于完全熔化。在熔炼过程中，这些颗粒有可能被糊状区(Mushy Zone)捕获。" />
          <attvalue for="3" value="{&quot;melting_condition_diameter&quot;: &quot;&gt; 6 mm&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-4e978ffab8ecad069ff358871c8db74d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-4e978ffab8ecad069ff358871c8db74d-e-3" label="Mushy Zone">
        <attvalues>
          <attvalue for="0" value="Mushy Zone" />
          <attvalue for="1" value="Material Zone" />
          <attvalue for="2" value="**Mushy Zone (糊状区)**&#10;&#10;在材料熔化或凝固过程中，位于固相线和液相线之间的一个工艺区域。其特征为固相与液相共存，未完全熔化的颗粒悬浮于熔体中，并有可能在凝固时被捕获，形成夹杂物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-4e978ffab8ecad069ff358871c8db74d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Mushy Zones&quot;, &quot;Mushy zone&quot;, &quot;mushy zone&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4e978ffab8ecad069ff358871c8db74d-e-3&quot;, &quot;chunk-c20cadb2415cd2dfc078d894fd496ac4-e-5&quot;, &quot;chunk-abbdf8441a4bf6e918fd13c6184c324e-e-5&quot;, &quot;chunk-1c645de8358fdb4503314332514003ba-e-8&quot;, &quot;chunk-621e146c65396b0355e74f1485e77bf8-e-1&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-4e978ffab8ecad069ff358871c8db74d-e-4" label="Modelling studies [9]">
        <attvalues>
          <attvalue for="0" value="Modelling studies [9]" />
          <attvalue for="1" value="Data Source" />
          <attvalue for="2" value="一份被引用的模型研究文献[9]。该研究作为一种数据来源，通过建模分析，阐明了下落中的颗粒物发生融化所需满足的特定条件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-4e978ffab8ecad069ff358871c8db74d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4e978ffab8ecad069ff358871c8db74d-e-6" label="Crown Fall-in">
        <attvalues>
          <attvalue for="0" value="Crown Fall-in" />
          <attvalue for="1" value="Event" />
          <attvalue for="2" value="Crown Fall-in是一种工业生产事件，指熔炉冠部的耐火材料在使用中脱落并掉入熔体，形成污染。它被认为是导致最终产品出现“白点”缺陷的一种可能来源，且可能性通常高于未熔颗粒。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-4e978ffab8ecad069ff358871c8db74d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4e978ffab8ecad069ff358871c8db74d-e-7" label="Material falling into the pool">
        <attvalues>
          <attvalue for="0" value="Material falling into the pool" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="指在冶金等工业过程中，意外落入高温熔池的通用物料。出于安全考量，需为其评估并确定一个最大允许尺寸（如直径），以防止因剧烈反应或热冲击而引发熔体喷溅等危险。" />
          <attvalue for="3" value="{&quot;maximum_safe_diameter&quot;: &quot;2 to 3 mm&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-4e978ffab8ecad069ff358871c8db74d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="290" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-351e8ba4c7ea5776fa307b38afdc31ab-e-1" label="Pool">
        <attvalues>
          <attvalue for="0" value="Pool" />
          <attvalue for="1" value="Feature" />
          <attvalue for="2" value="一种小范围的静水体，可以是天然形成的池塘或洼地，也可以是用于游泳或装饰等目的的人造水池。它作为一个地理或人造特征，其面积、深度、容积等尺寸是关键的测量与描述属性。" />
          <attvalue for="3" value="{&quot;size_range&quot;: &quot;2 to 3 mm&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-351e8ba4c7ea5776fa307b38afdc31ab" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="291" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-351e8ba4c7ea5776fa307b38afdc31ab-e-5" label="Consumable electrode">
        <attvalues>
          <attvalue for="0" value="Consumable electrode" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="在电渣重熔（ESR）工艺中，作为导电电极和被重熔金属原料的部件。其下端与熔渣池接触，在熔渣电阻热的作用下逐渐熔化，金属液滴下落后形成精炼铸锭。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-351e8ba4c7ea5776fa307b38afdc31ab" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-351e8ba4c7ea5776fa307b38afdc31ab-e-6" label="Molten slag pool">
        <attvalues>
          <attvalue for="0" value="Molten slag pool" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="在电渣重熔（ESR）工艺中，位于自耗电极与凝固铸锭之间的熔融状态炉渣。它作为核心的电阻加热体，利用电流通过时产生的高温来熔化电极，并在金属液滴下落过程中对其进行化学净化和精炼。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-351e8ba4c7ea5776fa307b38afdc31ab" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;molten slag pool&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-351e8ba4c7ea5776fa307b38afdc31ab-e-6&quot;, &quot;chunk-434598412a5630b73fc77c4f56954329-e-1&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-351e8ba4c7ea5776fa307b38afdc31ab-e-7" label="Solidifying ingot">
        <attvalues>
          <attvalue for="0" value="Solidifying ingot" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="在电渣重熔(ESR)工艺中，由熔融金属穿过熔渣池后在其下方逐渐凝固形成的金属铸锭。它是一种高纯度材料，在空间上，熔渣池位于它与正在熔化的自耗电极之间。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-351e8ba4c7ea5776fa307b38afdc31ab" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;solidifying ingot&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-351e8ba4c7ea5776fa307b38afdc31ab-e-7&quot;, &quot;chunk-434598412a5630b73fc77c4f56954329-e-3&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-434598412a5630b73fc77c4f56954329-e-2" label="electrode">
        <attvalues>
          <attvalue for="0" value="electrode" />
          <attvalue for="1" value="Process Component" />
          <attvalue for="2" value="一种工艺组件，作为熔滴的来源。它浸入下方的熔渣池中，其浸入部分是构成电路的主要电阻。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-434598412a5630b73fc77c4f56954329" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-434598412a5630b73fc77c4f56954329-e-4" label="air">
        <attvalues>
          <attvalue for="0" value="air" />
          <attvalue for="1" value="Environment" />
          <attvalue for="2" value="一种特定的工艺环境，指在渣池的辅助下，能够直接在空气中进行的加工过程。渣池在此环境中起到关键的保护或隔离作用，使特定反应得以实现，常见于冶金领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-434598412a5630b73fc77c4f56954329" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="292" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-434598412a5630b73fc77c4f56954329-e-6" label="molten droplets">
        <attvalues>
          <attvalue for="0" value="molten droplets" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="熔融液滴是一种材料，其化学反应活性由与其接触的炉渣成分所决定。通过调整炉渣的种类和配比，可以精确调控该物质在冶金或化学过程中的反应速率与行为，是实现特定工艺目标的关键。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-434598412a5630b73fc77c4f56954329" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Molten Droplets&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-434598412a5630b73fc77c4f56954329-e-6&quot;, &quot;chunk-5354da7deedb75e784b4ab18d7e8dbe0-e-2&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-434598412a5630b73fc77c4f56954329-e-7" label="impurities">
        <attvalues>
          <attvalue for="0" value="impurities" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="杂质是指材料中存在的非目标或有害物质，如氧化物和硫。在冶金过程中，这些物质会从熔融金属中分离，并被炉渣（molten slag）吸收去除，以提高金属纯度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-434598412a5630b73fc77c4f56954329" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-434598412a5630b73fc77c4f56954329-e-8" label="Oxides">
        <attvalues>
          <attvalue for="0" value="Oxides" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="氧化物是指至少含有一个氧原子，且其中氧的氧化态通常为-2的化合物。它们通常由元素或其它化合物与氧发生氧化反应而形成，是自然界中广泛存在的一类物质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-434598412a5630b73fc77c4f56954329" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;oxides&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-434598412a5630b73fc77c4f56954329-e-8&quot;, &quot;chunk-e039cb317db23e5137b0d2d1164a7ea9-e-10&quot;, &quot;chunk-c8a13933656ed9f144b18b40f2e9861e-e-3&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-434598412a5630b73fc77c4f56954329-e-10" label="alternating current (AC)">
        <attvalues>
          <attvalue for="0" value="alternating current (AC)" />
          <attvalue for="1" value="Electrical Parameter" />
          <attvalue for="2" value="交流电（AC）是一种大小和方向均随时间做周期性变化的电流。它与方向恒定的直流电（DC）相对，这一特性是其区别于通常采用直流电的VAR工艺等其他加工方法的关键。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-434598412a5630b73fc77c4f56954329" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-434598412a5630b73fc77c4f56954329-e-11" label="circuit">
        <attvalues>
          <attvalue for="0" value="circuit" />
          <attvalue for="1" value="System Component" />
          <attvalue for="2" value="一种用于特定工业过程的电气回路系统组件。其电路总电阻主要由电极的浸入深度和熔渣层的状态共同决定，是影响该过程能量转换效率的核心部分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-434598412a5630b73fc77c4f56954329" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1ae5eeddc911b07554bcd6d0f5c9d84a-e-1" label="Electrode Immersion">
        <attvalues>
          <attvalue for="0" value="Electrode Immersion" />
          <attvalue for="1" value="Process Component" />
          <attvalue for="2" value="在冶金工艺中，指电极浸入熔渣的状态或形成的部分。它与渣盖共同构成电路中的主要电阻，其浸入深度是影响和控制电路电阻值、能量输入及熔炼效率的关键工艺参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-1ae5eeddc911b07554bcd6d0f5c9d84a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Electrode immersion&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1ae5eeddc911b07554bcd6d0f5c9d84a-e-1&quot;, &quot;chunk-ff1788efa63f5e7e3624028146e850d4-e-5&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-1ae5eeddc911b07554bcd6d0f5c9d84a-e-2" label="Slag Cap">
        <attvalues>
          <attvalue for="0" value="Slag Cap" />
          <attvalue for="1" value="Process Component" />
          <attvalue for="2" value="在电冶金工艺中，指位于电极端部周围、由熔渣形成的覆盖层。它与电极浸入深度共同构成电路中的主要电阻，是利用电阻抗产生焦耳热以实现物料熔炼的关键部分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-1ae5eeddc911b07554bcd6d0f5c9d84a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1ae5eeddc911b07554bcd6d0f5c9d84a-e-3" label="Circuit Resistance">
        <attvalues>
          <attvalue for="0" value="Circuit Resistance" />
          <attvalue for="1" value="Electrical Property" />
          <attvalue for="2" value="电路电阻是表征电路对电流阻碍作用的核心电气属性。它主要由电极插入深度和渣盖的电阻构成，是电路中利用焦耳效应产生热量的主要来源。其阻值大小遵循欧姆定律，直接影响电路中的电流与电压。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-1ae5eeddc911b07554bcd6d0f5c9d84a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-1ae5eeddc911b07554bcd6d0f5c9d84a-e-4" label="Heat Generation">
        <attvalues>
          <attvalue for="0" value="Heat Generation" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="指电流通过导体时，因电路电阻作用而将电能转化为热能的物理现象。该现象是电能损耗的主要形式之一，也被称为焦耳热效应或电阻热。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1ae5eeddc911b07554bcd6d0f5c9d84a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1ae5eeddc911b07554bcd6d0f5c9d84a-e-5" label="Slag Weight">
        <attvalues>
          <attvalue for="0" value="Slag Weight" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="作为一个过程参数，指电渣重熔等冶金工艺中熔渣的重量。通过调节渣重可改变渣池的几何形状和导电路径，从而调整电路的等效电阻值，是精确控制过程能量输入和稳定性的重要手段。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1ae5eeddc911b07554bcd6d0f5c9d84a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1ae5eeddc911b07554bcd6d0f5c9d84a-e-6" label="Current">
        <attvalues>
          <attvalue for="0" value="Current" />
          <attvalue for="1" value="Electrical Property" />
          <attvalue for="2" value="一种基本电学属性，指电荷的定向移动速率。它用于维持特定的功率输入或熔化速率，其数值大小会受到电路电阻等因素的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-1ae5eeddc911b07554bcd6d0f5c9d84a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1ae5eeddc911b07554bcd6d0f5c9d84a-e-7" label="Voltage">
        <attvalues>
          <attvalue for="0" value="Voltage" />
          <attvalue for="1" value="Electrical Property" />
          <attvalue for="2" value="电压，也称电位差，是一种基本的电气特性，指电路中两点间的电势差。它是驱动电荷定向移动形成电流的根本原因，其大小受电阻影响，并与电流共同决定功率的大小。单位为伏特（V）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-1ae5eeddc911b07554bcd6d0f5c9d84a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1ae5eeddc911b07554bcd6d0f5c9d84a-e-8" label="Power Input/Melt Rate">
        <attvalues>
          <attvalue for="0" value="Power Input/Melt Rate" />
          <attvalue for="1" value="Process Target" />
          <attvalue for="2" value="一项关键的工艺目标参数，代表为保证生产稳定而设定的输入功率或材料熔化速率。该目标值通过实时调节电流和电压进行精确控制与维持。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-1ae5eeddc911b07554bcd6d0f5c9d84a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1ae5eeddc911b07554bcd6d0f5c9d84a-e-8&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-925d9224734831ce5d9a5425d8dec113-e-1" label="Ingots">
        <attvalues>
          <attvalue for="0" value="Ingots" />
          <attvalue for="1" value="Product" />
          <attvalue for="2" value="一种通过加工控制来确保高质量和一致性的最终产品，通常指被铸造成特定形状以便后续加工的金属块或条。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-925d9224734831ce5d9a5425d8dec113" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="170" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-925d9224734831ce5d9a5425d8dec113-e-2" label="Electrode">
        <attvalues>
          <attvalue for="0" value="Electrode" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="电极是一种在加工过程中浸入熔渣的组件。其浸入深度由电极电压控制，熔化速率则通过电流进行调节，并通过电极重量实时监控。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-925d9224734831ce5d9a5425d8dec113" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-925d9224734831ce5d9a5425d8dec113-e-3" label="Slag">
        <attvalues>
          <attvalue for="0" value="Slag" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种用于材料加工的物质，通过回收利用来最小化元素交换。它在加工时与钛(Ti)和硅(Si)等元素趋于化学平衡，从而实现对材料成分的精确控制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-925d9224734831ce5d9a5425d8dec113" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;slag&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-925d9224734831ce5d9a5425d8dec113-e-3&quot;, &quot;chunk-35442490006b7aff468c9227749684e6-e-3&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-925d9224734831ce5d9a5425d8dec113-e-4" label="Electrode Voltage">
        <attvalues>
          <attvalue for="0" value="Electrode Voltage" />
          <attvalue for="1" value="Control Parameter" />
          <attvalue for="2" value="电极电压是一种关键的工艺控制参数。在特定冶金过程（如电渣重熔）中，通过调节该电压值，可以精确控制电极在熔渣中的浸入深度，并使其保持恒定，从而确保生产过程的稳定性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-925d9224734831ce5d9a5425d8dec113" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-925d9224734831ce5d9a5425d8dec113-e-5" label="Electrode Weight">
        <attvalues>
          <attvalue for="0" value="Electrode Weight" />
          <attvalue for="1" value="Measured Parameter" />
          <attvalue for="2" value="一项测量参数，指电极的重量。通过监测其因熔化而产生的动态损耗，可以计算并评估电极的熔化速率，是冶金、焊接等工艺过程中的关键控制指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-925d9224734831ce5d9a5425d8dec113" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-925d9224734831ce5d9a5425d8dec113-e-6" label="Current">
        <attvalues>
          <attvalue for="0" value="Current" />
          <attvalue for="1" value="Control Parameter" />
          <attvalue for="2" value="作为一种控制参数，指用于调节电极熔化速率的电流。系统会根据实时测量的电极熔化速率，动态地调整该电流值，以实现对熔化过程的精确控制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-925d9224734831ce5d9a5425d8dec113" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-925d9224734831ce5d9a5425d8dec113-e-8" label="Processing Controls">
        <attvalues>
          <attvalue for="0" value="Processing Controls" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="加工控制 (Processing Controls) 是指在铸锭生产过程中，为辅助产出高质量成品所应用的一套系统性控制措施。该系统通过对流程中的关键参数进行管理与调节，以确保最终产品的优良品质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-925d9224734831ce5d9a5425d8dec113" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="170" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5354da7deedb75e784b4ab18d7e8dbe0-e-1" label="Slag">
        <attvalues>
          <attvalue for="0" value="Slag" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="渣（Slag）是一种以萤石为基础，添加了CaO、MgO和Al₂O₃等成分的材料。其关键作用是决定与熔滴的反应性，通常含有SiO₂杂质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-5354da7deedb75e784b4ab18d7e8dbe0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-5354da7deedb75e784b4ab18d7e8dbe0-e-3" label="Fluorite">
        <attvalues>
          <attvalue for="0" value="Fluorite" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="萤石（Fluorite）是氟化钙（CaF₂）的矿物形式，也称氟石。它是一种重要的工业矿物，在冶金中常用作助熔剂，是形成炉渣（Slag）的基础成分，以降低熔点并去除杂质。此外，它也是提取氟元素和制造光学材料的主要原料。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;CaF2&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-5354da7deedb75e784b4ab18d7e8dbe0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5354da7deedb75e784b4ab18d7e8dbe0-e-4" label="CaO">
        <attvalues>
          <attvalue for="0" value="CaO" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="氧化钙（CaO），俗称生石灰，是一种白色或灰白色的无机化合物。作为一种常见的碱性氧化物，它在工业中被广泛用作建筑材料（如水泥）、冶金过程中的助熔剂（造渣剂）以及化工原料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-5354da7deedb75e784b4ab18d7e8dbe0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5354da7deedb75e784b4ab18d7e8dbe0-e-5" label="MgO">
        <attvalues>
          <attvalue for="0" value="MgO" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="氧化镁（MgO），俗称苦土，是一种镁的氧化物和离子化合物。它通常为白色固体，具有高熔点和耐火性，属于碱性氧化物。在冶金工业中，常被用作炉渣添加剂，以调节熔渣的碱度、粘度和熔点。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-5354da7deedb75e784b4ab18d7e8dbe0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5354da7deedb75e784b4ab18d7e8dbe0-e-7" label="SiO2">
        <attvalues>
          <attvalue for="0" value="SiO2" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="二氧化硅（SiO₂），又称硅石，是一种由硅和氧元素组成的化合物。它在自然界中广泛存在，是石英、沙子等的主要成分，也是玻璃、陶瓷等工业材料的基本原料。在特定情况下，它也可能作为一种典型的夹杂物存在于陶瓷材料中。" />
          <attvalue for="3" value="{&quot;role&quot;: &quot;impurity&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-5354da7deedb75e784b4ab18d7e8dbe0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5354da7deedb75e784b4ab18d7e8dbe0-e-7&quot;, &quot;chunk-ae58c0f988aba111d22bb6ff5c500655-e-4&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-5354da7deedb75e784b4ab18d7e8dbe0-e-10" label="Ingot">
        <attvalues>
          <attvalue for="0" value="Ingot" />
          <attvalue for="1" value="Product" />
          <attvalue for="2" value="由高纯度金属硅（Si）熔融后定向凝固形成的晶体铸块，通常为圆柱形。它是半导体和光伏产业的关键原材料，被切片后制成硅晶圆，用于生产集成电路和太阳能电池。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-5354da7deedb75e784b4ab18d7e8dbe0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;ingot&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5354da7deedb75e784b4ab18d7e8dbe0-e-10&quot;, &quot;chunk-35442490006b7aff468c9227749684e6-e-2&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-35442490006b7aff468c9227749684e6-e-1" label="metallic Si">
        <attvalues>
          <attvalue for="0" value="metallic Si" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="**金属硅 (Metallic Si)**，又称工业硅，是一种具有金属光泽和特性的高纯度硅单质。在冶金工业中，它作为一种重要的添加剂被熔炼并掺入金属铸锭中，以用作合金元素（如在铝合金中）或炼钢过程中的脱氧剂，从而改善最终材料的性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-35442490006b7aff468c9227749684e6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-35442490006b7aff468c9227749684e6-e-6" label="elemental exchange">
        <attvalues>
          <attvalue for="0" value="elemental exchange" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="元素交换指在冶金等高温工艺中，化学元素在熔融金属与炉渣等不同物相间发生转移的现象。通过回收利用炉渣是控制并最小化这种交换的有效方法，以减少元素损失。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-35442490006b7aff468c9227749684e6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-35442490006b7aff468c9227749684e6-e-9" label="molten slag">
        <attvalues>
          <attvalue for="0" value="molten slag" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="熔渣 (Molten Slag) 是指处于熔融液态的炉渣。作为一种工业材料，它利用自身的高温和高热容量，在生产过程中充当蓄热体，能够储存并传递大量的热能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-35442490006b7aff468c9227749684e6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="106" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-35442490006b7aff468c9227749684e6-e-10" label="heat reservoir">
        <attvalues>
          <attvalue for="0" value="heat reservoir" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="一个概念，指在铸锭/熔池界面顶部，由熔融炉渣所扮演的热量储存和供应角色。它通过缓冲温度波动来维持熔池的热稳定，从而对金属的凝固过程进行有效控制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-35442490006b7aff468c9227749684e6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="106" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-35442490006b7aff468c9227749684e6-e-11" label="ingot/pool boundary">
        <attvalues>
          <attvalue for="0" value="ingot/pool boundary" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="在冶金工艺中，指金属熔池与下方正在凝固的铸锭之间的交界区域。该区域的温度由覆盖在熔池上方的熔渣层维持，此熔渣层作为关键的热源或储热体，控制着凝固过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-35442490006b7aff468c9227749684e6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="106" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-35442490006b7aff468c9227749684e6-e-12" label="changes in alloy chemistry">
        <attvalues>
          <attvalue for="0" value="changes in alloy chemistry" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="指合金在重熔精炼过程中，其化学组成发生改变的现象。这种效应在电渣重熔（ESR）等工艺中尤为显著，通常由元素烧损、蒸发或与炉渣发生反应引起，可能影响合金的最终性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-35442490006b7aff468c9227749684e6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c20cadb2415cd2dfc078d894fd496ac4-e-3" label="Heat Reservoir">
        <attvalues>
          <attvalue for="0" value="Heat Reservoir" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="电渣重熔（ESR）工艺中，在铸锭与熔池交界面的顶部因热量聚集而产生的一种特定热效应。该现象通过改变熔池的形状和凝固过程，直接影响熔合线的形貌，是决定最终铸锭质量的关键物理现象之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c20cadb2415cd2dfc078d894fd496ac4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c20cadb2415cd2dfc078d894fd496ac4-e-4" label="Fusion Profile">
        <attvalues>
          <attvalue for="0" value="Fusion Profile" />
          <attvalue for="1" value="Process Characteristic" />
          <attvalue for="2" value="金属重熔工艺中熔池边界的轮廓形状，是影响铸锭凝固质量的关键特征。例如，在电渣重熔(ESR)工艺中，其熔池侧壁形成的轮廓通常比真空自耗电弧重熔(VAR)工艺的更为陡峭。" />
          <attvalue for="3" value="{&quot;sides&quot;: &quot;steeper&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c20cadb2415cd2dfc078d894fd496ac4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c20cadb2415cd2dfc078d894fd496ac4-e-7" label="Chemical Heterogeneity">
        <attvalues>
          <attvalue for="0" value="Chemical Heterogeneity" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="化学异质性是一种材料属性，指材料内部化学成分分布不均匀的现象。它通常在材料凝固过程中，因糊状区的存在及冷却速率等因素影响而形成，在电渣重熔（ESR）等特定工艺中尤为显著。" />
          <attvalue for="3" value="{&quot;level&quot;: &quot;greater in ESR&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c20cadb2415cd2dfc078d894fd496ac4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c20cadb2415cd2dfc078d894fd496ac4-e-8" label="Triple Melting">
        <attvalues>
          <attvalue for="0" value="Triple Melting" />
          <attvalue for="1" value="Manufacturing Sequence" />
          <attvalue for="2" value="三重熔炼是一种先进的金属精炼工艺序列，通常指真空感应熔炼（VIM）、电渣重熔（ESR）和真空自耗重熔（VAR）的三步法。该工艺严格遵循VIM-ESR-VAR顺序，通过多重提纯，用于生产航空航天等关键领域所需的高纯净度、高性能特种合金。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-c20cadb2415cd2dfc078d894fd496ac4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-abbdf8441a4bf6e918fd13c6184c324e-e-3" label="Ingot Diameter">
        <attvalues>
          <attvalue for="0" value="Ingot Diameter" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="**铸锭直径 (Ingot Diameter)**&#10;&#10;一个关键的熔炼工艺参数，指待熔化铸锭的横截面直径。其尺寸直接影响熔化过程，较大的直径会增大糊状区并延长局部凝固时间。其允许的最大值由合金成分决定，高强度合金对此通常有更严格的加工限制。" />
          <attvalue for="3" value="{&quot;maximum_value_dependency&quot;: &quot;alloy composition&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-abbdf8441a4bf6e918fd13c6184c324e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-abbdf8441a4bf6e918fd13c6184c324e-e-6" label="Local Solidification Times">
        <attvalues>
          <attvalue for="0" value="Local Solidification Times" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="**局部凝固时间 (Local Solidification Times)**&#10;&#10;一项工艺参数，指在材料凝固过程中，铸锭内某一局部区域从液态完全转变为固态所需的时间。它是影响最终组织结构和性能的关键因素，通常铸锭直径越大，该时间越长。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-abbdf8441a4bf6e918fd13c6184c324e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-abbdf8441a4bf6e918fd13c6184c324e-e-7" label="U720Li">
        <attvalues>
          <attvalue for="0" value="U720Li" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="U720Li是一种高强度合金。其关键特征在于，采用电渣重熔（ESR）工艺进行生产时，其铸锭的直径会受到特定限制。" />
          <attvalue for="3" value="{&quot;processing_diameter_limit&quot;: &quot;about 500 mm or 20 inches&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-abbdf8441a4bf6e918fd13c6184c324e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-abbdf8441a4bf6e918fd13c6184c324e-e-8" label="Higher-strength alloys">
        <attvalues>
          <attvalue for="0" value="Higher-strength alloys" />
          <attvalue for="1" value="Alloy Category" />
          <attvalue for="2" value="指一类因其加工受铸锭直径限制的高强度合金。这类合金（例如U720Li）的性能优越，但其可制造的构件尺寸会受到原始铸锭大小的制约。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-abbdf8441a4bf6e918fd13c6184c324e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c66cb4a523402b814bf33ff19d16eb24-e-4" label="Land-based turbine">
        <attvalues>
          <attvalue for="0" value="Land-based turbine" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="陆基燃气轮机是一种安装于陆地的旋转式动力系统，主要用于发电或提供机械驱动。它通过燃烧燃料产生高温高压燃气，推动涡轮做功。其核心部件（如涡轮盘）需由IN718这类耐高温超级合金制造，以承受极端运行条件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c66cb4a523402b814bf33ff19d16eb24" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c66cb4a523402b814bf33ff19d16eb24-e-6" label="Freckle channels">
        <attvalues>
          <attvalue for="0" value="Freckle channels" />
          <attvalue for="1" value="Defect Feature" />
          <attvalue for="2" value="一种典型的雀斑(Freckling)缺陷特征，指材料中因宏观偏析形成的、富含铌(Nb)、钼(Mo)和钛(Ti)等元素的重度通道状结构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c66cb4a523402b814bf33ff19d16eb24" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c66cb4a523402b814bf33ff19d16eb24-e-6&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c66cb4a523402b814bf33ff19d16eb24-e-10" label="Liquid phase">
        <attvalues>
          <attvalue for="0" value="Liquid phase" />
          <attvalue for="1" value="State of Matter" />
          <attvalue for="2" value="液相是物质的基本状态之一，具有流动性，体积固定但无固定形状。在冶金和材料科学的相变过程（如凝固）中，它是指熔融状态的物质，像铌(Nb)、钼(Mo)、钛(Ti)等特定元素会发生偏析，并优先富集于该相中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-c66cb4a523402b814bf33ff19d16eb24" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c66cb4a523402b814bf33ff19d16eb24-e-10&quot;, &quot;chunk-1c645de8358fdb4503314332514003ba-e-2&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-1c645de8358fdb4503314332514003ba-e-1" label="Nb, Mo and Ti">
        <attvalues>
          <attvalue for="0" value="Nb, Mo and Ti" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="铌（Nb）、钼（Mo）和钛（Ti）是三种化学元素的合称。在特定材料的相变过程中，这组元素会优先分配进入液相，从而在液相中得到富集。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-1c645de8358fdb4503314332514003ba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1c645de8358fdb4503314332514003ba-e-5" label="760 mm (30 inch) product">
        <attvalues>
          <attvalue for="0" value="760 mm (30 inch) product" />
          <attvalue for="1" value="Product" />
          <attvalue for="2" value="一种直径为760毫米（30英寸）的高品质金属产品，通常为特种合金铸锭。它采用包含真空电弧重熔（VAR）和电渣重熔（ESR）在内的三次熔炼工艺制造，以获得极高的纯净度和致密的内部组织。" />
          <attvalue for="3" value="{&quot;size&quot;: &quot;760 mm (30 inch)&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1c645de8358fdb4503314332514003ba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1c645de8358fdb4503314332514003ba-e-6" label="Freckle defects">
        <attvalues>
          <attvalue for="0" value="Freckle defects" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="**雀斑 (Freckles)**: 一种特定的材料缺陷，指在材料中出现的分散的点状或斑点状瑕疵。因其外观与皮肤上的雀斑相似而得名，是“缺陷(Defects)”的一种类型。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-1c645de8358fdb4503314332514003ba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Freckles&quot;, &quot;freckles&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1c645de8358fdb4503314332514003ba-e-6&quot;, &quot;chunk-0e400a717c0177b6e54870a3d685e980-e-12&quot;, &quot;chunk-d2428cb3e80954cab38bfce19b363f27-e-3&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-1c645de8358fdb4503314332514003ba-e-7" label="IN718">
        <attvalues>
          <attvalue for="0" value="IN718" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="IN718（Inconel 718）是一种以铌（Nb）为主要强化元素的沉淀硬化型镍铬基高温合金。它在高达700°C时仍具备优异的强度、抗蠕变和耐腐蚀性能，同时加工性良好。因其卓越的综合性能，被广泛用于制造航空发动机、燃气轮机和核反应堆等领域的高温关键部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-1c645de8358fdb4503314332514003ba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;IN718 ingots&quot;, &quot;IN718 superalloy&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c66cb4a523402b814bf33ff19d16eb24-e-2&quot;, &quot;chunk-1c645de8358fdb4503314332514003ba-e-7&quot;, &quot;chunk-6c1e5f01b68b0193af6f52382cd9e355-e-5&quot;, &quot;chunk-edc468109902c1fff7b3577a4b609989-e-6&quot;, &quot;chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6-e-8&quot;, &quot;chunk-18c533341a9790d5a6a16a72face3f19-e-2&quot;, &quot;chunk-8c811c47750a116467f7951f64cda580-e-1&quot;, &quot;chunk-3598448f2352e6832a423e2072a2f043-e-1&quot;, &quot;chunk-6ab819da0d17d27985ac5f6eebc6d38b-e-7&quot;, &quot;chunk-ee6f1e6770197cb40d6002c5cd9212fd-e-3&quot;, &quot;chunk-f23caa328479b9d419f0d855b9335eb4-e-10&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-1c645de8358fdb4503314332514003ba-e-9" label="mid-radius position">
        <attvalues>
          <attvalue for="0" value="mid-radius position" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="中径位置（mid-radius position）是指在铸锭凝固过程中，位于中心与表面之间的特定环状区域。该区域因其糊状区渗透性较大，成为雀斑等宏观偏析缺陷最易于形成的位置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-1c645de8358fdb4503314332514003ba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Mid-radius&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1c645de8358fdb4503314332514003ba-e-9&quot;, &quot;chunk-621e146c65396b0355e74f1485e77bf8-e-3&quot;, &quot;chunk-8c811c47750a116467f7951f64cda580-e-5&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-621e146c65396b0355e74f1485e77bf8-e-2" label="permeability">
        <attvalues>
          <attvalue for="0" value="permeability" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="渗透率 (Permeability) 是糊状区的一种材料属性，用于衡量枝晶间液体流经该区域的难易程度。在铸锭凝固过程中，该属性并非均匀分布，其数值通常在铸锭中心处较低，而在中半径位置处较高。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-621e146c65396b0355e74f1485e77bf8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-621e146c65396b0355e74f1485e77bf8-e-4" label="centre of the ingot">
        <attvalues>
          <attvalue for="0" value="centre of the ingot" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="指金属铸锭内部的中心区域。该位置的一个关键物理特性是其渗透率（permeability）通常低于铸锭的其他部分，因此常被用作进行渗透率比较分析时的基准或参考点。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-621e146c65396b0355e74f1485e77bf8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-621e146c65396b0355e74f1485e77bf8-e-5" label="interdendritic fluid flow">
        <attvalues>
          <attvalue for="0" value="interdendritic fluid flow" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="一种物理过程，指在金属等材料凝固时，处于糊状区（Mushy Zone）的液相在树枝状晶体（Dendrite）网络间发生的流动。这种流动由枝晶网络的渗透性所支撑，是导致宏观偏析等缺陷以及特定微观组织形成的关键机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-621e146c65396b0355e74f1485e77bf8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-621e146c65396b0355e74f1485e77bf8-e-6" label="Ingot-to-billet conversion">
        <attvalues>
          <attvalue for="0" value="Ingot-to-billet conversion" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="锭坯转化是一种金属热加工工序，通过热轧或锻造等方式，将初次铸造的、结构疏松的金属锭转变为截面均匀的半成品方坯。该过程不仅改变材料的宏观形状，更重要的是能消除铸造缺陷、细化内部晶粒，从而显著提高金属的致密度、机械性能和质量，为后续加工提供合格原料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-621e146c65396b0355e74f1485e77bf8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Conventional ingot-to-billet conversion&quot;, &quot;Ingot-to-billet conversion processes&quot;, &quot;ingot-to-billet conversion&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-621e146c65396b0355e74f1485e77bf8-e-6&quot;, &quot;chunk-7f04d61f8c3f0d04cef377ef9214e3c9-e-7&quot;, &quot;chunk-dca55a5d4cb2d2d1e2f4de0e571af023-e-7&quot;, &quot;chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-16&quot;, &quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-3&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-621e146c65396b0355e74f1485e77bf8-e-8" label="ingots">
        <attvalues>
          <attvalue for="0" value="ingots" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="一种通过重熔工艺生产的中间材料形态。其初始状态不适合直接用于机械应用，必须经过热机械加工（如转化为坯料），才能用于后续制造。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-621e146c65396b0355e74f1485e77bf8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-621e146c65396b0355e74f1485e77bf8-e-10" label="mechanical applications">
        <attvalues>
          <attvalue for="0" value="mechanical applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="指对材料力学性能有较高要求的应用领域。重熔工艺所产铸锭，因其内部常存在晶粒粗大、成分偏析等缺陷，无法满足性能要求，因此不适合直接用于此类应用，必须经过锻造、轧制等后续塑性加工以改善其组织与性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-621e146c65396b0355e74f1485e77bf8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-621e146c65396b0355e74f1485e77bf8-e-11" label="thermal-mechanical working">
        <attvalues>
          <attvalue for="0" value="thermal-mechanical working" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="热机械加工（Thermal-mechanical working）是一种材料加工工艺，属于铸锭转化。它通过对材料协同施加受控的加热和机械变形，旨在破碎其原始的铸态组织并细化晶粒，从而改善材料的力学性能，使其满足机械应用要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-621e146c65396b0355e74f1485e77bf8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Thermal-mechanical working&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-621e146c65396b0355e74f1485e77bf8-e-11&quot;, &quot;chunk-4297db8e1cac52d92cbbb0fc36d27aaf-e-1&quot;, &quot;chunk-a2c3fd11f3ed7bc596943938c9fdae5d-e-3&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-621e146c65396b0355e74f1485e77bf8-e-12" label="Billet">
        <attvalues>
          <attvalue for="0" value="Billet" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="钢坯（Billet）是一种金属半成品，特指由钢锭经过热轧或锻造等转化工艺制成的中间材料。它通常具有方形或圆形截面，作为原料可进一步加工成棒材、线材等产品。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-621e146c65396b0355e74f1485e77bf8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;billet&quot;, &quot;billets&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5d942c8f1c01db54bab51b31faea4836-e-6&quot;, &quot;chunk-621e146c65396b0355e74f1485e77bf8-e-12&quot;, &quot;chunk-61a441c3ea495edfbd1f923ab25e12c9-e-6&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-4297db8e1cac52d92cbbb0fc36d27aaf-e-2" label="As-cast structure">
        <attvalues>
          <attvalue for="0" value="As-cast structure" />
          <attvalue for="1" value="Material Structure" />
          <attvalue for="2" value="铸态组织是一种材料的原始微观结构，指金属或合金从液态经铸造凝固后，未经后续加工而直接形成的组织。其特点通常是晶粒粗大、成分不均（偏析）并存在缺陷，导致力学性能较差。它常作为起始结构，需通过热机械加工（如锻造）来破碎和改善，以获得优良性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-4297db8e1cac52d92cbbb0fc36d27aaf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4297db8e1cac52d92cbbb0fc36d27aaf-e-4" label="Ingot conversion">
        <attvalues>
          <attvalue for="0" value="Ingot conversion" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="钢锭开坯（Ingot Breakdown），也称初轧，是指对金属铸锭进行首次热塑性变形的加工工序。它通过热轧等方式，将大截面的铸锭加工成板坯、方坯等中间产品，同时破碎其粗大的铸造组织，细化晶粒，以提高材料的致密性和力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-4297db8e1cac52d92cbbb0fc36d27aaf" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;ingot breakdown&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4297db8e1cac52d92cbbb0fc36d27aaf-e-4&quot;, &quot;chunk-1297af8788c2be7a2a158412cd2652f3-e-4&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-4297db8e1cac52d92cbbb0fc36d27aaf-e-5" label="Cogging">
        <attvalues>
          <attvalue for="0" value="Cogging" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="开坯（Cogging）是一种金属热加工工艺，通过锻造或轧制的方式对金属锭施加反复的局部压缩，使其截面减小、长度增加，从而将铸锭加工成后续工序所需的方坯或板坯。它是铸锭到坯料转化的关键初始工序。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-4297db8e1cac52d92cbbb0fc36d27aaf" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;cogging process&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-621e146c65396b0355e74f1485e77bf8-e-7&quot;, &quot;chunk-4297db8e1cac52d92cbbb0fc36d27aaf-e-5&quot;, &quot;chunk-a2c3fd11f3ed7bc596943938c9fdae5d-e-4&quot;, &quot;chunk-5d942c8f1c01db54bab51b31faea4836-e-5&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-4297db8e1cac52d92cbbb0fc36d27aaf-e-6" label="Cylindrical ingot">
        <attvalues>
          <attvalue for="0" value="Cylindrical ingot" />
          <attvalue for="1" value="Workpiece" />
          <attvalue for="2" value="一种圆柱形铸锭工件。在拔长（cogging）锻造工序中，通过锻压使其横截面减小、长度增加。在此特定工艺下，其直径约减小一半，长度则增加约四倍。" />
          <attvalue for="3" value="{&quot;diameter_reduction_factor&quot;: &quot;approximately 2&quot;, &quot;length_increase_factor&quot;: &quot;four-fold&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-4297db8e1cac52d92cbbb0fc36d27aaf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1b93b31e9bac3b7ed440734e8e9845f7-e-2" label="Furnace">
        <attvalues>
          <attvalue for="0" value="Furnace" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="一种工业加热设备，用于将钢锭等工件加热至工艺所需温度。其目的在于：进行塑性变形前提高材料的可塑性，或在变形后通过热处理来调整和改善其内部金相组织与力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-1b93b31e9bac3b7ed440734e8e9845f7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1b93b31e9bac3b7ed440734e8e9845f7-e-2&quot;, &quot;chunk-0b79cef081fe645143c11d92068c62ab-e-3&quot;, &quot;chunk-a2c3fd11f3ed7bc596943938c9fdae5d-e-9&quot;, &quot;chunk-d015db7235325173c4b776781906ae0b-e-5&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-1b93b31e9bac3b7ed440734e8e9845f7-e-3" label="Forging">
        <attvalues>
          <attvalue for="0" value="Forging" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="锻造是一种金属塑性成形加工方法，指利用锤击或压力使金属坯料产生塑性变形，以获得特定形状、尺寸和性能的工件。该工艺能消除金属内部缺陷、细化晶粒，从而显著提高材料的强度和韧性等力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-1b93b31e9bac3b7ed440734e8e9845f7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;forging&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1b93b31e9bac3b7ed440734e8e9845f7-e-3&quot;, &quot;chunk-5d942c8f1c01db54bab51b31faea4836-e-10&quot;, &quot;chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-2&quot;, &quot;chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676-e-6&quot;, &quot;chunk-870742dec10263e0078e94a0b6a827aa-e-13&quot;, &quot;chunk-569a3d8aec20d9df6a256b4cf4b263a7-e-1&quot;, &quot;chunk-dae9be5eb4b7208070b473c392dd0478-e-4&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-1b93b31e9bac3b7ed440734e8e9845f7-e-4" label="Horizontal Dies">
        <attvalues>
          <attvalue for="0" value="Horizontal Dies" />
          <attvalue for="1" value="Equipment Component" />
          <attvalue for="2" value="卧式模具 (Horizontal Dies) 是一对由液压驱动的设备部件。它们沿水平方向运动，通过强力挤压金属锭等原材料，使其发生塑性变形，是一种在锻造或成型工艺中使用的关键工具。" />
          <attvalue for="3" value="{&quot;quantity&quot;: &quot;two&quot;, &quot;drive_mechanism&quot;: &quot;hydraulically&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1b93b31e9bac3b7ed440734e8e9845f7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0b79cef081fe645143c11d92068c62ab-e-2" label="Dies">
        <attvalues>
          <attvalue for="0" value="Dies" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="锻模是在锻造作业中用于塑造金属工件的核心工具。它通常由带有型腔的上、下模组成，在压力或冲击力作用下，迫使金属坯料填充型腔而发生塑性变形，最终获得所需形状和尺寸的锻件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-0b79cef081fe645143c11d92068c62ab" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;dies&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0b79cef081fe645143c11d92068c62ab-e-2&quot;, &quot;chunk-a2c3fd11f3ed7bc596943938c9fdae5d-e-8&quot;, &quot;chunk-b6d430b58fe5b3336f2235e2e6daa465-e-9&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-0b79cef081fe645143c11d92068c62ab-e-5" label="Recrystallisation">
        <attvalues>
          <attvalue for="0" value="Recrystallisation" />
          <attvalue for="1" value="Metallurgical Process" />
          <attvalue for="2" value="**再结晶 (Recrystallisation)**：一种冶金过程，指经过塑性变形的金属在特定温度下，其内部形成新的、更细、无畸变的等轴晶粒，以取代原有变形晶粒的过程。该过程能产生更细化的晶粒结构，从而消除加工硬化，恢复材料的塑性与韧性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-0b79cef081fe645143c11d92068c62ab" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;recrystallisation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0b79cef081fe645143c11d92068c62ab-e-5&quot;, &quot;chunk-2b79180c24fc2ac7584f9f1d82b69f2b-e-6&quot;, &quot;chunk-708b4323c9399297153036f203acb264-e-10&quot;, &quot;chunk-d1205630321b74480906df6510252d09-e-2&quot;, &quot;chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199-e-6&quot;, &quot;chunk-99c942e2e9af3f5f017d599dea23d62d-e-5&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-0b79cef081fe645143c11d92068c62ab-e-6" label="Finer grain structure">
        <attvalues>
          <attvalue for="0" value="Finer grain structure" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种材料微观结构，其特征为内部晶粒尺寸微小且分布均匀。它通常通过再结晶等热加工或热处理工艺获得，能显著提升材料的强度、硬度和韧性等综合力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0b79cef081fe645143c11d92068c62ab" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;finer grain structure&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0b79cef081fe645143c11d92068c62ab-e-6&quot;, &quot;chunk-2b79180c24fc2ac7584f9f1d82b69f2b-e-7&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0b79cef081fe645143c11d92068c62ab-e-7" label="Octagonal cross-section">
        <attvalues>
          <attvalue for="0" value="Octagonal cross-section" />
          <attvalue for="1" value="Geometric Property" />
          <attvalue for="2" value="一种具有八条边的多边形几何截面。在材料加工领域，它特指金属铸锭等坯料经过锻造、轧制等塑性变形工艺后所形成的特征形状。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-0b79cef081fe645143c11d92068c62ab" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0b79cef081fe645143c11d92068c62ab-e-8" label="Reheating">
        <attvalues>
          <attvalue for="0" value="Reheating" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种金属热处理工艺，指对经过轧制、锻造等变形工序后的金属铸锭进行再次加热，旨在消除加工硬化、恢复塑性，以便于进行下一道次的变形加工。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-0b79cef081fe645143c11d92068c62ab" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6c1e5f01b68b0193af6f52382cd9e355-e-2" label="Heats">
        <attvalues>
          <attvalue for="0" value="Heats" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种多步骤热加工工序，旨在通过热处理减小铸锭的直径。该过程的关键作用还包括抑制材料的晶粒生长，以确保或改善其最终的机械性能。" />
          <attvalue for="3" value="{&quot;quantity&quot;: &quot;as many as seven&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-6c1e5f01b68b0193af6f52382cd9e355" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6c1e5f01b68b0193af6f52382cd9e355-e-6" label="δ phase (Ni₃Nb)">
        <attvalues>
          <attvalue for="0" value="δ phase (Ni₃Nb)" />
          <attvalue for="1" value="Microstructural Phase" />
          <attvalue for="2" value="δ相（Delta Phase）是镍基高温合金IN718中的一种微观结构相，为化学式Ni₃Nb的金属间化合物，具有正交晶体结构。其固溶温度约为1010°C，是该合金主要强化相γ''（Ni₃Nb）的稳定形式。" />
          <attvalue for="3" value="{&quot;solvus_temperature&quot;: &quot;1010 °C&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-6c1e5f01b68b0193af6f52382cd9e355" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;8 (delta phase)&quot;, &quot;Delta phase&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6c1e5f01b68b0193af6f52382cd9e355-e-6&quot;, &quot;chunk-d2428cb3e80954cab38bfce19b363f27-e-6&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7f04d61f8c3f0d04cef377ef9214e3c9-e-1" label="Final rounding operation">
        <attvalues>
          <attvalue for="0" value="Final rounding operation" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="一种金属成型制造工序，在为后续锻造而进行坯料切片之前执行。该工序将坯料加工成精确的圆形横截面，以确保其符合锻造要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-7f04d61f8c3f0d04cef377ef9214e3c9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7f04d61f8c3f0d04cef377ef9214e3c9-e-2" label="Slicing the billet">
        <attvalues>
          <attvalue for="0" value="Slicing the billet" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="一种金属加工工序，通常位于最终圆整之后、锻造之前。该工序将金属坯料按预定尺寸或重量切割成独立的料块，目的是为后续的锻造作业提供形状和体积合格的原材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-7f04d61f8c3f0d04cef377ef9214e3c9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7f04d61f8c3f0d04cef377ef9214e3c9-e-3" label="Forging operations">
        <attvalues>
          <attvalue for="0" value="Forging operations" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="锻造作业是一种金属成形制造工艺，通过对金属坯料施加局部压缩力（通常使用锤击或压模），使其产生塑性变形，从而获得所需形状、尺寸及特定机械性能的工件。该工艺能改善金属的内部晶粒结构，提高其强度与韧性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-7f04d61f8c3f0d04cef377ef9214e3c9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Forging Operations&quot;, &quot;forging operations&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7f04d61f8c3f0d04cef377ef9214e3c9-e-3&quot;, &quot;chunk-49fe0f122b885e8929f914d54a677b92-e-5&quot;, &quot;chunk-f3de78de36038078dc14b547813962c5-e-2&quot;, &quot;chunk-b6d430b58fe5b3336f2235e2e6daa465-e-10&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-7f04d61f8c3f0d04cef377ef9214e3c9-e-4" label="Starting grain size">
        <attvalues>
          <attvalue for="0" value="Starting grain size" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="起始晶粒尺寸是一种材料属性，指材料在经历热处理或形变加工等特定工艺前，其内部晶粒的平均尺寸。它是决定材料最终性能和组织演变的关键初始参数。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;ASTM000&quot;, &quot;size&quot;: &quot;1 mm+&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-7f04d61f8c3f0d04cef377ef9214e3c9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="107" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7f04d61f8c3f0d04cef377ef9214e3c9-e-5" label="Grain size at the start of the third heat">
        <attvalues>
          <attvalue for="0" value="Grain size at the start of the third heat" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="在多道次热处理工艺中，于第三道次加热开始时测得的晶粒尺寸。它是由初始晶粒尺寸细化而来的一个中间状态，并作为后续加工的基础，将被进一步细化为最终晶粒尺寸。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;ASTM0&quot;, &quot;size&quot;: &quot;0.35 mm&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-7f04d61f8c3f0d04cef377ef9214e3c9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="107" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7f04d61f8c3f0d04cef377ef9214e3c9-e-6" label="Final grain size">
        <attvalues>
          <attvalue for="0" value="Final grain size" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="最终晶粒尺寸是一种材料属性，指材料在完成特定的制造或热处理工艺后，其内部晶粒的平均尺寸。它是评价工艺效果、控制并决定材料最终力学性能（如强度和韧性）的关键指标。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;ASTM5 or 6&quot;, &quot;size&quot;: &quot;40–60 µm&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-7f04d61f8c3f0d04cef377ef9214e3c9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7f04d61f8c3f0d04cef377ef9214e3c9-e-6&quot;]}]" />
          <attvalue for="9" value="107" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7f04d61f8c3f0d04cef377ef9214e3c9-e-8" label="Gyratory forging machine (GFM)">
        <attvalues>
          <attvalue for="0" value="Gyratory forging machine (GFM)" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="回转锻造（GFM）是一种金属塑性成形的转化工艺，是径向锻造的一种特殊形式。其核心特征是锻锤在回转运动中对工件进行高频、小压下量的锤击，以精确减小截面。该工艺能够在材料内部形成独特的应变分布，用于制造高精度的轴类、管类等零件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-7f04d61f8c3f0d04cef377ef9214e3c9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;gyratory forging machine (GFM)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7f04d61f8c3f0d04cef377ef9214e3c9-e-8&quot;, &quot;chunk-6542d72e1fe020ba20ec3d195bda41be-e-2&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-7f04d61f8c3f0d04cef377ef9214e3c9-e-9" label="Radial forging">
        <attvalues>
          <attvalue for="0" value="Radial forging" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="径向锻造是一种金属成形工艺，属于锻造的一种。它通过多个径向分布的锤头，对工件进行高频、同步的锤击。工件在锤击中通常会轴向送进并旋转，以减小截面，用于生产高精度、表面光洁的实心或空心轴类及管类零件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-7f04d61f8c3f0d04cef377ef9214e3c9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;radial forging&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7f04d61f8c3f0d04cef377ef9214e3c9-e-9&quot;, &quot;chunk-6542d72e1fe020ba20ec3d195bda41be-e-3&quot;, &quot;chunk-dae9be5eb4b7208070b473c392dd0478-e-11&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-6542d72e1fe020ba20ec3d195bda41be-e-1" label="conversion processes">
        <attvalues>
          <attvalue for="0" value="conversion processes" />
          <attvalue for="1" value="Process Category" />
          <attvalue for="2" value="转化工艺 (conversion processes) 是一类初步锻造工艺，旨在将金属铸锭粗大的铸态组织转变为细晶、均匀的锻态组织，为后续成形做准备。该工艺是锻造工序的初始阶段，其典型实例为径向锻造，常使用回转锻压机（GFM）等设备完成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-6542d72e1fe020ba20ec3d195bda41be" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Conversion&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6542d72e1fe020ba20ec3d195bda41be-e-1&quot;, &quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-2&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-6542d72e1fe020ba20ec3d195bda41be-e-4" label="strain profile">
        <attvalues>
          <attvalue for="0" value="strain profile" />
          <attvalue for="1" value="Process Characteristic" />
          <attvalue for="2" value="应变剖面（strain profile）是一种工艺特征，描述了工件在锻造后内部塑性变形的空间分布情况。它构成了摆动碾压成形（GFM）与径向锻造等不同锻造工艺之间的主要区别，并对成形件的最终力学性能有决定性影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-6542d72e1fe020ba20ec3d195bda41be" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6542d72e1fe020ba20ec3d195bda41be-e-5" label="forgemaster">
        <attvalues>
          <attvalue for="0" value="forgemaster" />
          <attvalue for="1" value="Role" />
          <attvalue for="2" value="锻造主管 (forgemaster) 是指在金属初步转化过程之后，负责通过锻造工艺，将金属坯料（cylinder of metal）塑造成涡轮盘等精密预成型件的个人或实体。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-6542d72e1fe020ba20ec3d195bda41be" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6542d72e1fe020ba20ec3d195bda41be-e-6" label="cylinder of metal">
        <attvalues>
          <attvalue for="0" value="cylinder of metal" />
          <attvalue for="1" value="Workpiece" />
          <attvalue for="2" value="一种圆柱形金属工件，在锻造工艺中作为原材料或预制件。它由锻造师进行塑形加工，最终被制成如涡轮盘等特定形状的高价值部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-6542d72e1fe020ba20ec3d195bda41be" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Cylinder of metal&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6542d72e1fe020ba20ec3d195bda41be-e-6&quot;, &quot;chunk-eb085f02bba98b62b26a7b0962fa3843-e-2&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-eb085f02bba98b62b26a7b0962fa3843-e-4" label="Production of the disc">
        <attvalues>
          <attvalue for="0" value="Production of the disc" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="一种用于成形涡轮盘的三阶段制造工艺，包含镦粗、预锻和精锻步骤。该工艺在实现盘件宏观成形的同时，需严格控制微观组织，以抑制锻造过程中发生的晶粒长大。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-eb085f02bba98b62b26a7b0962fa3843" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-eb085f02bba98b62b26a7b0962fa3843-e-5" label="Upsetting">
        <attvalues>
          <attvalue for="0" value="Upsetting" />
          <attvalue for="1" value="Process Stage" />
          <attvalue for="2" value="镦粗是盘件生产的第一道工序。该阶段采用自由锻造工艺，将金属原材料加工成轴对称的锭坯，为后续成形做准备。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-eb085f02bba98b62b26a7b0962fa3843" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-eb085f02bba98b62b26a7b0962fa3843-e-6" label="Open-die forging">
        <attvalues>
          <attvalue for="0" value="Open-die forging" />
          <attvalue for="1" value="Forging Method" />
          <attvalue for="2" value="开式模锻是一种金属塑性成形工艺。它使用不完全封闭工件的简单模具（如平模），通过多次局部加压和转动工件，使金属自由流动并逐步成形。此工艺适用于制造形状简单的大型锻件（如轴、环）或小批量产品。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-eb085f02bba98b62b26a7b0962fa3843" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;open-die forging&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-eb085f02bba98b62b26a7b0962fa3843-e-6&quot;, &quot;chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-11&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-eb085f02bba98b62b26a7b0962fa3843-e-7" label="Axisymmetric ingot">
        <attvalues>
          <attvalue for="0" value="Axisymmetric ingot" />
          <attvalue for="1" value="Intermediate Product" />
          <attvalue for="2" value="一种在锻造的镦粗阶段形成的中间产品。通过沿轴向施压，使金属原材料高度减小、横截面增大，从而形成围绕中心轴对称的工件。该锭坯通常作为后续成形加工（如闭式模锻）的预制件。" />
          <attvalue for="3" value="{&quot;thickness&quot;: &quot;reduced&quot;, &quot;cross-sectional area&quot;: &quot;greater&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-eb085f02bba98b62b26a7b0962fa3843" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-eb085f02bba98b62b26a7b0962fa3843-e-8" label="Blocking">
        <attvalues>
          <attvalue for="0" value="Blocking" />
          <attvalue for="1" value="Process Stage" />
          <attvalue for="2" value="**Blocking（制坯）**&#10;&#10;盘件生产流程中的第二道工序。该阶段采用闭式模锻工艺，对金属坯料进行初步塑性成形，使其厚薄截面按需合理分布，为最终精锻成形做准备。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-eb085f02bba98b62b26a7b0962fa3843" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-eb085f02bba98b62b26a7b0962fa3843-e-9" label="Closed-die forging">
        <attvalues>
          <attvalue for="0" value="Closed-die forging" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="闭式模锻是一种金属热机械加工工艺。它将加热后的金属坯料放置在完全或几乎完全闭合的锻模中，通过施加巨大压力使其塑性变形，并填充整个模具型腔，从而获得形状复杂、尺寸精确的锻件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-eb085f02bba98b62b26a7b0962fa3843" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;closed-die forging&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-eb085f02bba98b62b26a7b0962fa3843-e-9&quot;, &quot;chunk-2b79180c24fc2ac7584f9f1d82b69f2b-e-3&quot;, &quot;chunk-a852675cbb814a50f658ab8ff82b3bdc-e-4&quot;, &quot;chunk-a2c3fd11f3ed7bc596943938c9fdae5d-e-5&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-eb085f02bba98b62b26a7b0962fa3843-e-10" label="Finishing">
        <attvalues>
          <attvalue for="0" value="Finishing" />
          <attvalue for="1" value="Process Stage" />
          <attvalue for="2" value="**标准化描述:**&#10;Finishing（终饰）是光盘生产流程中的第三个工序阶段。作为“光盘生产”完整过程的一个有机组成部分，它在制造顺序上位于中间环节，为光盘的最终完成进行处理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-eb085f02bba98b62b26a7b0962fa3843" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2b79180c24fc2ac7584f9f1d82b69f2b-e-1" label="die forging">
        <attvalues>
          <attvalue for="0" value="die forging" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="模锻是一种金属塑性成形工艺。它将金属坯料放置在刻有预定形状型腔的锻模内，通过施加压力或冲击力使其变形，从而获得具有所需形状、尺寸和力学性能的锻件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-2b79180c24fc2ac7584f9f1d82b69f2b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2b79180c24fc2ac7584f9f1d82b69f2b-e-1&quot;]}]" />
          <attvalue for="9" value="293" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-2b79180c24fc2ac7584f9f1d82b69f2b-e-2" label="finishing">
        <attvalues>
          <attvalue for="0" value="finishing" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="终锻（finishing）是一种制造工艺，特指锻造过程中的第三道也是最后一道工序。该工序采用闭式模锻技术，旨在对工件进行最终的精确成型，以制成所需的圆盘形状。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-2b79180c24fc2ac7584f9f1d82b69f2b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2b79180c24fc2ac7584f9f1d82b69f2b-e-4" label="solvus">
        <attvalues>
          <attvalue for="0" value="solvus" />
          <attvalue for="1" value="Metallurgical Property" />
          <attvalue for="2" value="固溶线（Solvus）是合金的一个临界温度，代表固溶体中一种组元在另一组元中的最大溶解度。它是在锻造和热处理等工艺中控制合金相变与微观结构的关键参数，工艺温度常维持在其附近以获得理想的力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-2b79180c24fc2ac7584f9f1d82b69f2b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2b79180c24fc2ac7584f9f1d82b69f2b-e-4&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2b79180c24fc2ac7584f9f1d82b69f2b-e-5" label="alloy">
        <attvalues>
          <attvalue for="0" value="alloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="合金（Alloys）是由一种金属与另一种或几种金属或非金属熔合而成的具有金属特性的物质。它们通常通过混合不同元素（如钛、钴）来改变基体金属的性质，以获得特定的强度、耐腐蚀性等物理或化学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2b79180c24fc2ac7584f9f1d82b69f2b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Alloys&quot;, &quot;alloys&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ff95c020d0eb3854d47176a924594dbf-e-2&quot;, &quot;chunk-1d4877c041c898c2ccde9f07a4b45ed8-e-2&quot;, &quot;chunk-aad5a5786d03a03d8f644b4cda7a85fb-e-1&quot;, &quot;chunk-2b79180c24fc2ac7584f9f1d82b69f2b-e-5&quot;, &quot;chunk-0fc2e7bdc755aa4e47c0be4c7ca98b87-e-2&quot;, &quot;chunk-99354e5831501ba1d07293128331db80-e-3&quot;, &quot;chunk-6cc9936949c5f333eaac7910b952ef48-e-7&quot;, &quot;chunk-78c519f8cce4113c48c714a60ca273ce-e-5&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-2b79180c24fc2ac7584f9f1d82b69f2b-e-8" label="three forging operations">
        <attvalues>
          <attvalue for="0" value="three forging operations" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="一种多步锻造制造工艺，包含模锻和精加工等步骤。该工艺的核心是将温度严格控制在固溶线附近，旨在促进材料发生再结晶，从而优化其微观组织与最终的力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-2b79180c24fc2ac7584f9f1d82b69f2b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-1" label="Forged Discs">
        <attvalues>
          <attvalue for="0" value="Forged Discs" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="锻造盘（Forged Discs）是一种通过锻造工艺成型的盘状金属部件。它通常会经过淬火等热处理工序，以改善其内部金相组织，从而获得高强度、高韧性等特定的力学性能，以满足严苛工况的要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-2" label="Quenching">
        <attvalues>
          <attvalue for="0" value="Quenching" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="淬火是一种金属热处理工艺，指将工件加热至高温后，在水、油等介质中快速冷却。此过程通过改变材料的微观结构，旨在显著提高其硬度和强度。这一剧烈的冷却过程是工件内部产生热梯度的主要原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Quenching operation&quot;, &quot;Quenching process&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-2&quot;, &quot;chunk-93160044ac8bb07b73d5b072ebae265b-e-1&quot;, &quot;chunk-2b0bf628a95c22fc39c3dcd9f2959fd7-e-6&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-3" label="Oil">
        <attvalues>
          <attvalue for="0" value="Oil" />
          <attvalue for="1" value="Quenching Medium" />
          <attvalue for="2" value="作为一种淬火介质，是指在金属热处理工艺中使用的工业用油。通过将高温金属工件浸入其中进行快速冷却，以改变其金相组织，从而提高材料的硬度、强度等机械性能，同时能有效降低工件变形或开裂的风险。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-3&quot;, &quot;chunk-ee2c916092b69050b73e7898f576b082-e-3&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-4" label="Water">
        <attvalues>
          <attvalue for="0" value="Water" />
          <attvalue for="1" value="Quenching Medium" />
          <attvalue for="2" value="作为一种淬火介质，水是热处理工艺中应用最广、最经济的冷却介质。其主要特点是冷却速度快，能显著提高钢件的硬度和强度，但其剧烈的冷却效果也容易导致工件变形或开裂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-6" label="Strengthening Phases">
        <attvalues>
          <attvalue for="0" value="Strengthening Phases" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="强化相（Strengthening Phases）是在热处理过程中从基体中析出的一种微观结构相，能有效阻碍位错运动，从而显著提高材料的强度，特别是高温性能。例如，高温合金中的γ'相就是一种典型的强化相。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Strengthening phases&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-6&quot;, &quot;chunk-6b0fd58b99d0490b98efe29e49c3ef5d-e-6&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-93160044ac8bb07b73d5b072ebae265b-e-3" label="Precipitation structure">
        <attvalues>
          <attvalue for="0" value="Precipitation structure" />
          <attvalue for="1" value="Material Microstructure" />
          <attvalue for="2" value="一种材料微观组织，指在淬火等快速冷却处理中，由过饱和固溶体析出细小、弥散的第二相所形成的结构。这种结构能显著提高材料的强度和硬度，是沉淀强化（或时效强化）合金的关键组织特征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-93160044ac8bb07b73d5b072ebae265b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-93160044ac8bb07b73d5b072ebae265b-e-4" label="Discs">
        <attvalues>
          <attvalue for="0" value="Discs" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种盘状组件，指经过淬火等热处理工艺以提升机械性能，并通过精密机加工达到预定几何形状的零件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-93160044ac8bb07b73d5b072ebae265b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-93160044ac8bb07b73d5b072ebae265b-e-5" label="Machining to a pre-specified geometry">
        <attvalues>
          <attvalue for="0" value="Machining to a pre-specified geometry" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="一种在淬火操作后进行的机械加工工艺。该工艺通过切削等方式，将盘件（Discs）加工成预先设定的几何形状（通常为直线型），使其达到被称为“供货状态”（Condition of supply）的技术要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-93160044ac8bb07b73d5b072ebae265b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-93160044ac8bb07b73d5b072ebae265b-e-6" label="Condition of supply">
        <attvalues>
          <attvalue for="0" value="Condition of supply" />
          <attvalue for="1" value="Component State" />
          <attvalue for="2" value="一种矩形锻件，特指锻件经过初始机加工，达到预设的直线几何轮廓后所处的状态。该状态是组件交付时的初始形态，可用于后续精加工。" />
          <attvalue for="3" value="{&quot;geometry&quot;: &quot;rectilinear&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-93160044ac8bb07b73d5b072ebae265b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-93160044ac8bb07b73d5b072ebae265b-e-7" label="Non-destructive evaluation (NDE)">
        <attvalues>
          <attvalue for="0" value="Non-destructive evaluation (NDE)" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="**无损评估 (Non-destructive evaluation, NDE)**&#10;&#10;一种在不损害部件（如锻件）完整性的前提下，利用超声波检测等技术手段，评估其性能与内部或表面缺陷的测试过程。该过程通常在最终机加工等后续工序前执行，以确保材料和产品的质量与可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-93160044ac8bb07b73d5b072ebae265b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;NDE (Non-Destructive Evaluation)&quot;, &quot;NDE methods&quot;, &quot;NDE techniques&quot;, &quot;Non-destructive evaluation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-93160044ac8bb07b73d5b072ebae265b-e-7&quot;, &quot;chunk-378cff7c7b5d0dedcf7174df0a8eba7a-e-4&quot;, &quot;chunk-c49d762f9999a07400560c738c6df23e-e-5&quot;, &quot;chunk-9fd48949e9fa068e1f82454ee4d745a1-e-3&quot;, &quot;chunk-0cc0ddc3943d8f2fd7c506b872a6a90c-e-1&quot;, &quot;chunk-f65046762e91bbcc190f459be1701bc4-e-1&quot;, &quot;chunk-bc843e3dfc76a0be097f5be36fb00976-e-9&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="11" />
        </attvalues>
      </node>
      <node id="chunk-93160044ac8bb07b73d5b072ebae265b-e-8" label="Ultrasonic testing">
        <attvalues>
          <attvalue for="0" value="Ultrasonic testing" />
          <attvalue for="1" value="Testing Method" />
          <attvalue for="2" value="超声检测是一种利用高频声波对物体进行检查的无损评估方法。它通过向被测材料内部发射超声波，并分析其反射、透射或衰减情况，来探测材料内部的缺陷（如裂纹、夹杂），或测量物体的厚度及其他物理特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-93160044ac8bb07b73d5b072ebae265b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-93160044ac8bb07b73d5b072ebae265b-e-8&quot;, &quot;chunk-bdd419f61b4df7e511da7b854e288ce6-e-5&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-93160044ac8bb07b73d5b072ebae265b-e-9" label="Rectilinear forging">
        <attvalues>
          <attvalue for="0" value="Rectilinear forging" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种处于“供货状态”的锻件毛坯。它被特意加工成简单的矩形轮廓，目的是为了在进行最终成形机加工之前，能够方便、有效地实施无损检测（NDE），以确保其内部质量完好。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-93160044ac8bb07b73d5b072ebae265b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-93160044ac8bb07b73d5b072ebae265b-e-10" label="Machining to the final shape">
        <attvalues>
          <attvalue for="0" value="Machining to the final shape" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="一种制造工序，通常是成型的最后步骤。它采用切削、磨削等减材方法，对锻件一类的近净形工件进行精密加工，使其达到最终设计所要求的精确尺寸、几何形状和表面光洁度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-93160044ac8bb07b73d5b072ebae265b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7e79124b1e7a81a0aeb685547f1f14b7-e-1" label="Rectilinear forging">
        <attvalues>
          <attvalue for="0" value="Rectilinear forging" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="一种具有矩形或块状截面的锻造毛坯，是制造涡轮盘所用的初始材料形态。它需要通过机加工去除大量材料，以形成涡轮盘最终的复杂轮廓。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-7e79124b1e7a81a0aeb685547f1f14b7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7e79124b1e7a81a0aeb685547f1f14b7-e-3" label="Turbine disc forging">
        <attvalues>
          <attvalue for="0" value="Turbine disc forging" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="一种通过锻造工艺制成的涡轮盘金属毛坯。它是成品涡轮盘的原材料，其外形和尺寸接近成品，但留有加工余量。因需经过大量切削加工，其质量远大于最终成品。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-7e79124b1e7a81a0aeb685547f1f14b7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7e79124b1e7a81a0aeb685547f1f14b7-e-4" label="HP turbine disc">
        <attvalues>
          <attvalue for="0" value="HP turbine disc" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="高压涡轮盘 (HP turbine disc) 是罗尔斯·罗伊斯公司 (Rolls-Royce) AE3007发动机的核心旋转部件。该盘件为最终成品件，由一个质量为45公斤的盘件毛坯经精密机加工而成，用于在高温高压环境下传递动力。" />
          <attvalue for="3" value="{&quot;weight&quot;: &quot;about 8 kg&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-7e79124b1e7a81a0aeb685547f1f14b7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7e79124b1e7a81a0aeb685547f1f14b7-e-5" label="Rolls-Royce Corporation's AE3007 engine">
        <attvalues>
          <attvalue for="0" value="Rolls-Royce Corporation's AE3007 engine" />
          <attvalue for="1" value="Engine" />
          <attvalue for="2" value="罗尔斯·罗伊斯AE3007是由该公司研制的一款涡扇发动机。它以其高压涡轮盘等精密部件构成，主要作为塞斯纳奖状X（Cessna Citation X）公务机的动力装置而闻名。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-7e79124b1e7a81a0aeb685547f1f14b7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7e79124b1e7a81a0aeb685547f1f14b7-e-6" label="Cessna Citation X business jet">
        <attvalues>
          <attvalue for="0" value="Cessna Citation X business jet" />
          <attvalue for="1" value="Aircraft" />
          <attvalue for="2" value="赛斯纳奖状X（Cessna Citation X）是一款由赛斯纳公司制造的公务机，采用罗尔斯·罗伊斯公司的AE3007发动机作为其动力来源。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-7e79124b1e7a81a0aeb685547f1f14b7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7e79124b1e7a81a0aeb685547f1f14b7-e-7" label="Disc of mass 45 kg">
        <attvalues>
          <attvalue for="0" value="Disc of mass 45 kg" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="一种质量为45千克的涡轮盘锻件。它是一种中间产品或加工毛坯，通过机加工工艺，最终被制造成高压（HP）涡轮盘成品零件。" />
          <attvalue for="3" value="{&quot;mass&quot;: &quot;45 kg&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-7e79124b1e7a81a0aeb685547f1f14b7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-49fe0f122b885e8929f914d54a677b92-e-2" label="Business Jet">
        <attvalues>
          <attvalue for="0" value="Business Jet" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="公务机是一种由涡轮发动机驱动的喷气式飞机，专为企业或个人进行商务或私人出行而设计。它通常用于运载小团体乘客，提供比民航客机更快速、灵活且私密的航空运输服务。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-49fe0f122b885e8929f914d54a677b92" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-49fe0f122b885e8929f914d54a677b92-e-3" label="Superalloys">
        <attvalues>
          <attvalue for="0" value="Superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="高温合金（Superalloys）是一类能在高温和高应力下长期工作的金属材料，通常以铁、镍、钴为基体。因其优异的高温强度、抗氧化和抗蠕变性能，被广泛用于制造航空航天发动机的涡轮盘及其他关键热端部件。" />
          <attvalue for="3" value="{&quot;usage_duration&quot;: &quot;about 50 years&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-49fe0f122b885e8929f914d54a677b92" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-49fe0f122b885e8929f914d54a677b92-e-6" label="Manufacturing Stream">
        <attvalues>
          <attvalue for="0" value="Manufacturing Stream" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="指生产高温合金部件的复杂、多阶段供应链流程。该流程整合了从原料供应、熔炼到锻造成型等多个环节，通常涉及众多独立的供应商与制造商，并以其漫长的制造周期为特点。" />
          <attvalue for="3" value="{&quot;characteristic&quot;: &quot;quite lengthy&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-49fe0f122b885e8929f914d54a677b92" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937-e-1" label="Material Suppliers">
        <attvalues>
          <attvalue for="0" value="Material Suppliers" />
          <attvalue for="1" value="Actor" />
          <attvalue for="2" value="指在供应链中提供原材料、物质或组件的实体或个人。作为物料的初始来源，他们是在生产流程早期可能引入缺陷的关键参与者，其提供的物料质量直接影响最终产品的合格率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937-e-2" label="Melters">
        <attvalues>
          <attvalue for="0" value="Melters" />
          <attvalue for="1" value="Actor" />
          <attvalue for="2" value="在材料供应链中，指负责将原材料加热熔化以进行提炼或制成合金的生产单位。该环节是引入杂质、成分偏析等内部材料缺陷的关键节点，直接影响最终产品质量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937-e-3" label="Forgemasters">
        <attvalues>
          <attvalue for="0" value="Forgemasters" />
          <attvalue for="1" value="Actor" />
          <attvalue for="2" value="锻造者 (Forgemasters) 是指在材料供应链中，通过锻造工艺生产或加工金属部件的实体。其生产环节是材料产生缺陷的潜在来源之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937-e-4" label="Defects">
        <attvalues>
          <attvalue for="0" value="Defects" />
          <attvalue for="1" value="Issue" />
          <attvalue for="2" value="缺陷是在材料供应与制造过程中产生的瑕疵，例如晶粒度控制不当或锻造缺陷。它会导致材料浪费和额外成本，可通过质量控制程序进行检测。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937-e-5" label="Quality Control Procedures">
        <attvalues>
          <attvalue for="0" value="Quality Control Procedures" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="质量控制程序是一系列旨在确保产品、服务或过程符合规定质量标准的系统性活动。它通过检验和测试（如超声波检测）等方法，主动检测并识别过程或最终产品中的缺陷与不合格项。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937-e-6" label="Ultrasonic Inspection">
        <attvalues>
          <attvalue for="0" value="Ultrasonic Inspection" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="超声波检测是一种无损检测（NDT）方法，它利用高频声波在材料内部的传播和反射来探测其表面及内部的缺陷（如裂纹或夹杂物）。该过程通过分析回波信号评估部件的完整性，常用于检测高温合金坯料等关键金属部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Ultrasonic inspection&quot;, &quot;ultrasonic inspection&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-94a3c77e7b2c0cd830c7bd8fec7c4937-e-6&quot;, &quot;chunk-a0bc17e9304523fcbd1eb1f1e003c749-e-2&quot;, &quot;chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-10&quot;, &quot;chunk-a1650d74269b8238062c417df547e98e-e-2&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937-e-7" label="Material Wastage">
        <attvalues>
          <attvalue for="0" value="Material Wastage" />
          <attvalue for="1" value="Consequence" />
          <attvalue for="2" value="材料浪费 (Material Wastage) 是一种负面结果，指在生产制造过程中，因产品或流程存在缺陷，导致原材料、零部件等未能被有效利用而遭废弃或损耗，从而造成经济损失的现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937-e-8" label="Extra Cost">
        <attvalues>
          <attvalue for="0" value="Extra Cost" />
          <attvalue for="1" value="Consequence" />
          <attvalue for="2" value="指因生产或流程中的缺陷、材料浪费等非预期问题而产生的，超出预算或计划的额外财务成本或经济损失。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937-e-9" label="Inadequate control of grain size">
        <attvalues>
          <attvalue for="0" value="Inadequate control of grain size" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="一种存在于金属、陶瓷等材料中的显微组织缺陷。其特征为材料内部的晶粒尺寸过大、过小或分布不均，通常由热处理等加工工艺控制不当导致。该缺陷会显著影响材料的强度、韧性及其他关键力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937-e-10" label="Forging Defects">
        <attvalues>
          <attvalue for="0" value="Forging Defects" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="锻造缺陷是在金属锻造过程中，因材料流动不当、温度或模具等工艺问题而产生的表面或内部瑕疵。它是一种缺陷，具体类型如折叠（Laps）和充型不足，会影响锻件的几何精度、机械性能和完整性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937-e-11" label="Laps">
        <attvalues>
          <attvalue for="0" value="Laps" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="Laps（折叠）是一种材料表面缺陷，主要在金属轧制或锻造等热加工过程中形成。当金属表面发生折叠但未能完全焊合时，便会产生这种线状不连续缺陷。它会严重影响材料的机械性能，可通过超声波（高频声波）等无损检测方法探测。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-94a3c77e7b2c0cd830c7bd8fec7c4937-e-11&quot;, &quot;chunk-bc843e3dfc76a0be097f5be36fb00976-e-7&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937-e-12" label="Inadequate filling of the dies">
        <attvalues>
          <attvalue for="0" value="Inadequate filling of the dies" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="充填不足是一种锻造缺陷，指金属在模锻过程中未能完全充满模膛，导致锻件形状不完整、轮廓不清晰的现象。这通常是由于压力不足、金属流动性差或毛坯尺寸不当等原因造成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-94a3c77e7b2c0cd830c7bd8fec7c4937" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-708b4323c9399297153036f203acb264-e-1" label="Process modelling">
        <attvalues>
          <attvalue for="0" value="Process modelling" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="过程建模是一种系统化的方法论，通过使用图形符号或形式化语言，为业务、技术或工作流程创建可视化表示。其主要目标是分析、理解、设计、优化和自动化流程，从而提高效率、降低成本并确保质量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-708b4323c9399297153036f203acb264" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;process modelling&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-708b4323c9399297153036f203acb264-e-1&quot;, &quot;chunk-ee6f1e6770197cb40d6002c5cd9212fd-e-7&quot;, &quot;chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676-e-10&quot;, &quot;chunk-dae9be5eb4b7208070b473c392dd0478-e-2&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-708b4323c9399297153036f203acb264-e-2" label="Mathematical models">
        <attvalues>
          <attvalue for="0" value="Mathematical models" />
          <attvalue for="1" value="Model" />
          <attvalue for="2" value="一种通过过程建模建立的数学形式化表示，用于描述、分析和预测制造工艺中发生的现象（特别是连续介质现象）。其目标是揭示过程的内在规律，为工艺的优化与控制提供理论依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-708b4323c9399297153036f203acb264" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-708b4323c9399297153036f203acb264-e-3" label="Manufacturing route">
        <attvalues>
          <attvalue for="0" value="Manufacturing route" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="在制造业中，制造路线 (Manufacturing route) 是指将原材料或零部件加工成最终产品所必须遵循的、预先规划的一系列工序步骤。它详细规定了每道工序的操作内容、使用的设备和工作中心，是生产调度、成本核算及流程优化的基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-708b4323c9399297153036f203acb264" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-708b4323c9399297153036f203acb264-e-4" label="Continuum phenomena">
        <attvalues>
          <attvalue for="0" value="Continuum phenomena" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="在物理学和工程学中，指将物质视为连续介质时所表现出的一类宏观现象。它忽略物质的微观结构，常通过数学模型进行描述和分析，具体包括热流、应力及应变等。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-708b4323c9399297153036f203acb264" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-708b4323c9399297153036f203acb264-e-5" label="Heat flow">
        <attvalues>
          <attvalue for="0" value="Heat flow" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="一种物理过程，指热量因温差从系统的高温部分传递至低温部分。在熔模铸造中，它特指金属熔液、铸型及环境间的热量交换，此过程决定了铸件的凝固速率、微观结构和最终性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-708b4323c9399297153036f203acb264" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;heat flow&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-708b4323c9399297153036f203acb264-e-5&quot;, &quot;chunk-a67bfee0cc0003cfb8efe7f82e7665c2-e-5&quot;, &quot;chunk-569a3d8aec20d9df6a256b4cf4b263a7-e-8&quot;, &quot;chunk-d548052a2344b0da613ab35155dcbdaa-e-7&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-708b4323c9399297153036f203acb264-e-7" label="Strains">
        <attvalues>
          <attvalue for="0" value="Strains" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="**应变 (Strains)**：在连续介质力学中，指物体在经历变形时其内部产生的几何形状或尺寸的相对变化。它是一种用于量化变形程度的物理属性，属于连续介质现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-708b4323c9399297153036f203acb264" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-708b4323c9399297153036f203acb264-e-7&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-708b4323c9399297153036f203acb264-e-9" label="Microstructure evolution">
        <attvalues>
          <attvalue for="0" value="Microstructure evolution" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="一种物理现象，指材料内部的微观组织（如晶粒、相、缺陷）在热、力等外界条件作用下随时间发生变化的动态过程。该过程决定了材料的宏观性能，并且是过程模型（process models）的核心预测内容。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-708b4323c9399297153036f203acb264" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;microstructure evolution&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-708b4323c9399297153036f203acb264-e-9&quot;, &quot;chunk-9b8241b51916aa0fe236ff3e6c045cdf-e-13&quot;, &quot;chunk-fd0257f35193366950536d3c582b3768-e-2&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-d1205630321b74480906df6510252d09-e-1" label="Microstructure evolution simulation">
        <attvalues>
          <attvalue for="0" value="Microstructure evolution simulation" />
          <attvalue for="1" value="Computational Process" />
          <attvalue for="2" value="一种计算过程。它依据基础理论，结合材料的热物理性能与应力-应变行为，对再结晶、晶粒长大、织构等微观结构演化进行建模与预测。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-d1205630321b74480906df6510252d09" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-d1205630321b74480906df6510252d09-e-3" label="Grain growth">
        <attvalues>
          <attvalue for="0" value="Grain growth" />
          <attvalue for="1" value="Metallurgical Process" />
          <attvalue for="2" value="晶粒长大是一种冶金现象，指在高温下多晶材料中较大晶粒通过吞并、长大，而较小晶粒逐渐消失的过程。该现象会改变材料的微观结构，通常导致强度和硬度等力学性能下降。因此，过度的晶粒长大是在金属构件（如盘件）生产和热处理工艺中需要严格控制的关键问题。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d1205630321b74480906df6510252d09" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Grain Growth&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d1205630321b74480906df6510252d09-e-3&quot;, &quot;chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199-e-7&quot;, &quot;chunk-6c1e5f01b68b0193af6f52382cd9e355-e-7&quot;, &quot;chunk-eb085f02bba98b62b26a7b0962fa3843-e-3&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-d1205630321b74480906df6510252d09-e-4" label="Texture">
        <attvalues>
          <attvalue for="0" value="Texture" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="织构是一种材料属性，指多晶材料中晶粒的晶体学取向分布。作为微观结构的关键特征，它描述了晶粒取向的择优程度，并显著影响材料的各向异性物理和力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d1205630321b74480906df6510252d09" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d1205630321b74480906df6510252d09-e-5" label="Underlying theory">
        <attvalues>
          <attvalue for="0" value="Underlying theory" />
          <attvalue for="1" value="Theoretical Concept" />
          <attvalue for="2" value="标准化描述：&#10;指构建微观结构演化模拟所必需的基础理论框架。它为模拟提供了核心的物理原理、数学模型及计算方法，是确保模拟过程科学性和结果准确性的根本依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d1205630321b74480906df6510252d09" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d1205630321b74480906df6510252d09-e-6" label="Thermophysical properties">
        <attvalues>
          <attvalue for="0" value="Thermophysical properties" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="材料的一组物理性质，用于表征其热力学行为和热传递能力，主要包括导热系数、比热容、热膨胀系数和密度等。这些性质是进行热分析与模拟计算（如微观组织演化模拟）的基础和关键输入参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-d1205630321b74480906df6510252d09" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d1205630321b74480906df6510252d09-e-7" label="Stress-strain behaviour">
        <attvalues>
          <attvalue for="0" value="Stress-strain behaviour" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种基本材料力学性能，描述材料在承受载荷时，其内部应力与所产生应变之间的关系。它通常由应力-应变曲线表示，是进行结构分析、微观结构演化等精确数值模拟的关键输入参数，尤其在高温工况下其准确性至关重要。" />
          <attvalue for="3" value="{&quot;condition&quot;: &quot;at elevated temperatures&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d1205630321b74480906df6510252d09" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f633977b50954908714896a3fb5de045-e-1" label="Process Model">
        <attvalues>
          <attvalue for="0" value="Process Model" />
          <attvalue for="1" value="Model" />
          <attvalue for="2" value="一种应用于锻造工艺的预测性模型。它通过研究工艺变量来优化整个加工过程，其主要优势在于能够显著减少对成本高昂且耗时良久的实体试验的需求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-f633977b50954908714896a3fb5de045" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-f633977b50954908714896a3fb5de045-e-2" label="Forging processes">
        <attvalues>
          <attvalue for="0" value="Forging processes" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="锻造工艺 (Forging Processes) 是一类通过施加局部压缩力使金属材料塑性变形，以获得所需形状、尺寸和性能的制造方法。作为一种关键的金属成形技术，它是各类工艺模型（Process Model）分析、模拟与优化的主要应用对象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-f633977b50954908714896a3fb5de045" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Forging Processes&quot;, &quot;forging processes&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f633977b50954908714896a3fb5de045-e-2&quot;, &quot;chunk-1159c2afbaaccc92d505d71fb856dee1-e-15&quot;, &quot;chunk-ec1da0ebfe72b58a50620a5a71c6abf7-e-1&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f633977b50954908714896a3fb5de045-e-3" label="Predictive Capability">
        <attvalues>
          <attvalue for="0" value="Predictive Capability" />
          <attvalue for="1" value="Attribute" />
          <attvalue for="2" value="指足够精确的过程模型所具备的一项关键属性。它代表了模型能依据其内在逻辑和数据，对系统未来的状态、行为或结果进行推断和预测的能力，是衡量该模型实用价值的核心优势。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-f633977b50954908714896a3fb5de045" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f633977b50954908714896a3fb5de045-e-4" label="Process Variables">
        <attvalues>
          <attvalue for="0" value="Process Variables" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="工艺变量（Process Variables）是在生产或制造过程中可被改变、控制和研究的参数。这些变量的变化会直接影响工艺结果，常通过工艺模型进行分析与优化。常见的例子包括模具几何形状、压下量以及淬火速率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f633977b50954908714896a3fb5de045" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-f633977b50954908714896a3fb5de045-e-5" label="Die Geometry">
        <attvalues>
          <attvalue for="0" value="Die Geometry" />
          <attvalue for="1" value="Process Variable" />
          <attvalue for="2" value="模具几何 (Die Geometry) 是制造业中的一个关键工艺变量，指用于产品成型的模具所具有的形状、尺寸、角度等几何特征。它直接决定了最终产品（如挤压件、冲压件）的外形精度与质量，因此常通过仿真模型进行分析和优化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-f633977b50954908714896a3fb5de045" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f633977b50954908714896a3fb5de045-e-6" label="Bite Size">
        <attvalues>
          <attvalue for="0" value="Bite Size" />
          <attvalue for="1" value="Process Variable" />
          <attvalue for="2" value="一个过程变量，用于描述在制造或加工工艺中，物料经切割、成型或制粒后所形成的单个单元或颗粒的尺寸规格。它常作为模型研究和质量控制的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-f633977b50954908714896a3fb5de045" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f633977b50954908714896a3fb5de045-e-7" label="Quenching Rate">
        <attvalues>
          <attvalue for="0" value="Quenching Rate" />
          <attvalue for="1" value="Process Variable" />
          <attvalue for="2" value="淬火速率（Quenching Rate）是在热处理工艺中，材料或工件在淬火介质中冷却的速度，是一个关键的工艺变量。该速率直接决定材料的微观组织转变与最终获得的力学性能（如硬度、强度和韧性），是控制产品质量的核心参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-f633977b50954908714896a3fb5de045" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f633977b50954908714896a3fb5de045-e-8" label="Experimental Trials">
        <attvalues>
          <attvalue for="0" value="Experimental Trials" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="一种通过执行受控测试来研究过程变量对结果影响的科学方法。它旨在直接收集经验数据以建立因果关系，其必要性可通过使用过程模型等模拟方法来降低。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-f633977b50954908714896a3fb5de045" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f633977b50954908714896a3fb5de045-e-9" label="Processing">
        <attvalues>
          <attvalue for="0" value="Processing" />
          <attvalue for="1" value="Activity" />
          <attvalue for="2" value="一项可被分析和优化的综合性活动或整体操作。它由一系列旨在达成特定目标的步骤构成，其核心特征是可利用“流程模型”(Process Model)等工具进行系统性改进，以提升效率、降低成本或改善成果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-f633977b50954908714896a3fb5de045" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9ab220eb8343ca4f69826c693a95cb6c-e-1" label="Processing">
        <attvalues>
          <attvalue for="0" value="Processing" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="Processing是一种通用的制造过程，涵盖了如“粉末路线”等多种具体方法。该过程可以通过优化设计与执行，来有效减少在生产环节中产生的制造浪费。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-9ab220eb8343ca4f69826c693a95cb6c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="108" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9ab220eb8343ca4f69826c693a95cb6c-e-2" label="Manufacturing Waste">
        <attvalues>
          <attvalue for="0" value="Manufacturing Waste" />
          <attvalue for="1" value="Manufacturing Byproduct" />
          <attvalue for="2" value="**制造废料 (Manufacturing Waste)**&#10;&#10;指在制造过程中产生的、非预期的或无商业价值的副产品。它并非企业的主要产出物，通常可通过优化生产工艺或进行再加工（Processing）等方式来减少或消除。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-9ab220eb8343ca4f69826c693a95cb6c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="108" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9ab220eb8343ca4f69826c693a95cb6c-e-3" label="Design/Make Iterations">
        <attvalues>
          <attvalue for="0" value="Design/Make Iterations" />
          <attvalue for="1" value="Development Process" />
          <attvalue for="2" value="设计/制造迭代是在组件原型制作阶段必需的循环开发过程，包含反复的设计、制造与验证环节。优化此流程以减少迭代次数，是节省开发时间和金钱成本的关键。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-9ab220eb8343ca4f69826c693a95cb6c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="80" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-9ab220eb8343ca4f69826c693a95cb6c-e-4" label="Component Prototyping">
        <attvalues>
          <attvalue for="0" value="Component Prototyping" />
          <attvalue for="1" value="Development Phase" />
          <attvalue for="2" value="**组件原型制作 (Component Prototyping)**&#10;&#10;一个开发阶段，其核心是通过反复进行“设计与制造”的迭代循环，来创建、测试并验证组件的初步模型（原型）。此阶段旨在早期发现并解决问题，优化其设计与功能，为最终定型或量产奠定基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-9ab220eb8343ca4f69826c693a95cb6c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="80" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9ab220eb8343ca4f69826c693a95cb6c-e-5" label="Time">
        <attvalues>
          <attvalue for="0" value="Time" />
          <attvalue for="1" value="Resource" />
          <attvalue for="2" value="时间（Time）是在项目管理与产品开发流程中的一种关键资源。它特指通过减少设计与制造的迭代次数和周期所节省的投入，其节约程度直接影响项目的整体效率、成本和交付速度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-9ab220eb8343ca4f69826c693a95cb6c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="80" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9ab220eb8343ca4f69826c693a95cb6c-e-6" label="Money">
        <attvalues>
          <attvalue for="0" value="Money" />
          <attvalue for="1" value="Resource" />
          <attvalue for="2" value="在项目或生产上下文中，指资金、预算等财务资源。通过优化流程、减少设计与制造环节的重复迭代，可以显著节约该资源，从而降低项目总成本，提高经济效益。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-9ab220eb8343ca4f69826c693a95cb6c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="80" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9ab220eb8343ca4f69826c693a95cb6c-e-7" label="Powder Route">
        <attvalues>
          <attvalue for="0" value="Powder Route" />
          <attvalue for="1" value="Manufacturing Method" />
          <attvalue for="2" value="粉末路线（Powder Route）是一种以金属或非金属粉末为原料的加工制造方法，通常指粉末冶金工艺。它通过压制成形与高温烧结等步骤，将粉末固化为具有特定形状、结构和性能的致密化材料或零部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-9ab220eb8343ca4f69826c693a95cb6c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9ab220eb8343ca4f69826c693a95cb6c-e-7&quot;]}]" />
          <attvalue for="9" value="108" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9ab220eb8343ca4f69826c693a95cb6c-e-8" label="Powder Metallurgy (P/M)">
        <attvalues>
          <attvalue for="0" value="Powder Metallurgy (P/M)" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;粉末冶金（Powder Metallurgy, P/M）是一种制造工艺，通过将金属粉末压制成形并烧结，以制造涡轮盘等高性能的致密部件。该技术在早期应用中，曾因工艺控制问题而导致材料存在易产生缺陷的倾向。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-9ab220eb8343ca4f69826c693a95cb6c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;P/M processing&quot;, &quot;Powder Metallurgy&quot;, &quot;Powder metallurgy&quot;, &quot;Powder metallurgy (P/M)&quot;, &quot;Powder metallurgy techniques&quot;, &quot;powder metallurgy&quot;, &quot;powder-metallurgy (P/M)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9ab220eb8343ca4f69826c693a95cb6c-e-8&quot;, &quot;chunk-edc468109902c1fff7b3577a4b609989-e-1&quot;, &quot;chunk-e3bc91d02528ce132349b28825081f88-e-6&quot;, &quot;chunk-f1dbde91fa2668ef8c190d0d43e91e27-e-8&quot;, &quot;chunk-f5c07b55f3d29bb402b546962b69a445-e-10&quot;, &quot;chunk-0365022a18454a90e4598122a8f449ca-e-1&quot;, &quot;chunk-577e71f977df9c88b625f750e5b679c3-e-2&quot;, &quot;chunk-dddd9f3ab574da5297f93e141b49d4a6-e-5&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-edc468109902c1fff7b3577a4b609989-e-4" label="Astroloy">
        <attvalues>
          <attvalue for="0" value="Astroloy" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="Astroloy是一种高温合金（Superalloy），其强度高于早期同类合金。由于其成分特性，该材料被证实不适合采用传统的铸造和锻造工艺（Cast-and-wrought processing）进行加工。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-edc468109902c1fff7b3577a4b609989" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-edc468109902c1fff7b3577a4b609989-e-4&quot;, &quot;chunk-127ccac0bbb9a57ea78fa0e8276b38f5-e-6&quot;, &quot;chunk-b674e36d570cafb7928d33912e7c1b02-e-5&quot;, &quot;chunk-2457bc4af0771717326f8f8489539e06-e-8&quot;, &quot;chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec-e-2&quot;, &quot;chunk-bd5710a1dc51c42dffb282b63e6aaa4f-e-2&quot;, &quot;chunk-78c519f8cce4113c48c714a60ca273ce-e-8&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-edc468109902c1fff7b3577a4b609989-e-5" label="MERL 76">
        <attvalues>
          <attvalue for="0" value="MERL 76" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="MERL76是一种镍基单晶高温合金。它具有优异的高温强度、持久性能和抗蠕变性，主要用于制造先进航空发动机中的高压涡轮叶片等在极端温度和应力下工作的关键热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-edc468109902c1fff7b3577a4b609989" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;MERL76&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-edc468109902c1fff7b3577a4b609989-e-5&quot;, &quot;chunk-2457bc4af0771717326f8f8489539e06-e-7&quot;, &quot;chunk-f23caa328479b9d419f0d855b9335eb4-e-18&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-edc468109902c1fff7b3577a4b609989-e-8" label="Cast-and-wrought form">
        <attvalues>
          <attvalue for="0" value="Cast-and-wrought form" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="铸锻成形（Cast-and-wrought form）是一种传统的金属加工工艺，指先将金属铸造成形，再通过锻压等方式进行塑性加工。由于工艺限制，该方法难以加工Rene 95、Astroloy等成分复杂、强度高的新型高温合金。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-edc468109902c1fff7b3577a4b609989" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-edc468109902c1fff7b3577a4b609989-e-8&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-edc468109902c1fff7b3577a4b609989-e-9" label="Gas turbines for military purposes">
        <attvalues>
          <attvalue for="0" value="Gas turbines for military purposes" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="军用燃气轮机是一种应用于军事装备（尤其是飞机）的高性能发动机。它也是粉末冶金（P/M）技术最初的关键应用领域，该技术被用于制造耐高温、高强度的核心部件，以满足严苛的军事性能要求。著名的普惠F100战斗机发动机即是其典型实例。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-edc468109902c1fff7b3577a4b609989" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-edc468109902c1fff7b3577a4b609989-e-10" label="Pratt &amp; Whitney F100 engine">
        <attvalues>
          <attvalue for="0" value="Pratt &amp; Whitney F100 engine" />
          <attvalue for="1" value="Product" />
          <attvalue for="2" value="普惠F100（Pratt &amp; Whitney F100）是由美国普拉特·惠特尼公司研制的一款军用加力涡轮风扇发动机。作为一种先进的燃气涡轮发动机，它被用作F-15“鹰”式战斗机的主要动力装置，是世界上最成功的战斗机发动机之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-edc468109902c1fff7b3577a4b609989" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-edc468109902c1fff7b3577a4b609989-e-10&quot;, &quot;chunk-1c5754d75a0e54b3c65fcb24c11999a4-e-2&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-edc468109902c1fff7b3577a4b609989-e-11" label="F-15E Strike Eagle">
        <attvalues>
          <attvalue for="0" value="F-15E Strike Eagle" />
          <attvalue for="1" value="Product" />
          <attvalue for="2" value="F-15E“攻击鹰”是美国麦克唐纳-道格拉斯公司在F-15“鹰”的基础上研制的双座双发、全天候多用途攻击战斗机。它专为深度遮断和对地攻击任务设计，同时保留了强大的空战能力，采用普惠F100系列发动机作为动力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-edc468109902c1fff7b3577a4b609989" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;F-15 E&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-edc468109902c1fff7b3577a4b609989-e-11&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1c5754d75a0e54b3c65fcb24c11999a4-e-1" label="Gas turbines">
        <attvalues>
          <attvalue for="0" value="Gas turbines" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="燃气轮机是一种将燃料化学能转为机械功的旋转式内燃机。它通过燃烧产生高温高压气体，驱动涡轮高速旋转以输出动力。凭借高功率密度等优势，广泛应用于发电、航空航天（如喷气发动机）、船舶驱动等领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-1c5754d75a0e54b3c65fcb24c11999a4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1c5754d75a0e54b3c65fcb24c11999a4-e-3" label="F-15 Eagle">
        <attvalues>
          <attvalue for="0" value="F-15 Eagle" />
          <attvalue for="1" value="Aircraft" />
          <attvalue for="2" value="F-15“鹰”是美国麦道公司（现波音）研制的一款双发、全天候、高机动性的第四代空中优势战斗机。它采用普惠F100系列发动机，是历史上最成功的战斗机之一，以其卓越的空战性能和实战记录而闻名于世。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-1c5754d75a0e54b3c65fcb24c11999a4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;F-15 Eagle fighter&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1c5754d75a0e54b3c65fcb24c11999a4-e-3&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1c5754d75a0e54b3c65fcb24c11999a4-e-4" label="General Electric's CF6-80 engine">
        <attvalues>
          <attvalue for="0" value="General Electric's CF6-80 engine" />
          <attvalue for="1" value="Engine" />
          <attvalue for="2" value="通用电气CF6-80是由通用电气（GE）公司研制的高涵道比涡轮风扇发动机。它是成功的CF6发动机系列的衍生型号，被广泛应用于商用宽体飞机，是波音747-400等机型的可选动力装置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1c5754d75a0e54b3c65fcb24c11999a4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="171" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1c5754d75a0e54b3c65fcb24c11999a4-e-5" label="Boeing 747-400">
        <attvalues>
          <attvalue for="0" value="Boeing 747-400" />
          <attvalue for="1" value="Aircraft" />
          <attvalue for="2" value="波音747-400是美国波音公司开发的一款宽体远程商用客机，为波音747系列的重要改进型号。它采用了双人制玻璃驾驶舱、翼尖小翼和更具燃油效率的发动机，其中可选引擎包括通用电气的CF6-80。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1c5754d75a0e54b3c65fcb24c11999a4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="171" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1c5754d75a0e54b3c65fcb24c11999a4-e-6" label="GE90">
        <attvalues>
          <attvalue for="0" value="GE90" />
          <attvalue for="1" value="Engine" />
          <attvalue for="2" value="GE90是由通用电气航空(GE Aviation)为波音777客机开发的旗舰级高涵道比涡轮风扇发动机。它率先采用碳纤维复合材料风扇叶片，以巨大的尺寸和推力闻名，其衍生型号GE90-115B是经吉尼斯世界纪录认证的全球推力最大的喷气发动机。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-1c5754d75a0e54b3c65fcb24c11999a4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;General Electric GE90&quot;, &quot;General Electric's GE90&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8d8d506b8935eb12c19a6c9ce4ae735c-e-7&quot;, &quot;chunk-ca80bee312e1ad9a585f4b4507e9de12-e-3&quot;, &quot;chunk-1c5754d75a0e54b3c65fcb24c11999a4-e-6&quot;, &quot;chunk-6ef562415fc4e831401481f93072dca3-e-7&quot;, &quot;chunk-b505bbe1d912bcde398fe7f44b786cf0-e-11&quot;, &quot;chunk-1176c140725a24bab24c669fe05a7824-e-2&quot;, &quot;chunk-8a64ae02bc80ec0db6abf53700e681de-e-10&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-1c5754d75a0e54b3c65fcb24c11999a4-e-9" label="Property Uniformity">
        <attvalues>
          <attvalue for="0" value="Property Uniformity" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="属性均匀性指材料内部各处物理、化学等性质保持一致的程度，是衡量材料性能稳定可靠的关键指标。作为一种理想的材料特性，其均匀度越高，材料性能越稳定。粉末加工是改善该特性的有效工艺。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-1c5754d75a0e54b3c65fcb24c11999a4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Property uniformity&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1c5754d75a0e54b3c65fcb24c11999a4-e-9&quot;, &quot;chunk-e8af8d584a25ef7c23bcff4f05d475d5-e-2&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-1c5754d75a0e54b3c65fcb24c11999a4-e-10" label="Macrosegregation">
        <attvalues>
          <attvalue for="0" value="Macrosegregation" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="宏观偏析（Macrosegregation）是一种材料缺陷，指合金元素或杂质在材料内部发生宏观尺度上的不均匀分布。这种化学成分的偏析会导致材料各区域的物理和力学性能出现显著差异，破坏其整体性能的均匀性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-1c5754d75a0e54b3c65fcb24c11999a4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1c5754d75a0e54b3c65fcb24c11999a4-e-10&quot;, &quot;chunk-e8af8d584a25ef7c23bcff4f05d475d5-e-3&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e8af8d584a25ef7c23bcff4f05d475d5-e-4" label="Fine Grain Size">
        <attvalues>
          <attvalue for="0" value="Fine Grain Size" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="细晶粒尺寸是一种材料的微观结构特性，指材料内部晶粒尺寸微小。它通常通过双重热处理等工艺获得。这种结构能显著提高材料的强度、硬度、韧性和抗疲劳性能，因此常作为零部件（如孔径区域）的关键性能要求，以增强其耐用性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-e8af8d584a25ef7c23bcff4f05d475d5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Fine grain size&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e8af8d584a25ef7c23bcff4f05d475d5-e-4&quot;, &quot;chunk-925bc5f619d7b2214c7a718b66fcfe15-e-6&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-e8af8d584a25ef7c23bcff4f05d475d5-e-5" label="Extra Cost">
        <attvalues>
          <attvalue for="0" value="Extra Cost" />
          <attvalue for="1" value="Economic Factor" />
          <attvalue for="2" value="作为一个经济因素，额外成本（Extra Cost）特指在为粉末冶金（P/M）产品生产粉末的过程中所产生的附加费用。这笔成本是粉末冶金技术的一个主要经济劣势，直接影响最终产品的成本效益和市场竞争力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e8af8d584a25ef7c23bcff4f05d475d5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e8af8d584a25ef7c23bcff4f05d475d5-e-6" label="Powder Production">
        <attvalues>
          <attvalue for="0" value="Powder Production" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="**标准化描述：**&#10;&#10;粉末生产是粉末冶金（P/M）制造流程中的关键初始步骤。它指通过雾化、化学还原或机械粉碎等方法，将块状金属或其化合物制成具有特定尺寸、形状和纯度的金属粉末的过程。该步骤对最终产品性能至关重要，是决定其制造成本的重要环节。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e8af8d584a25ef7c23bcff4f05d475d5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e8af8d584a25ef7c23bcff4f05d475d5-e-7" label="Probabilistic Lifing Method">
        <attvalues>
          <attvalue for="0" value="Probabilistic Lifing Method" />
          <attvalue for="1" value="Analysis Method" />
          <attvalue for="2" value="一种基于概率论和统计学的先进分析方法，用于预测部件的寿命与可靠性。它能够处理材料属性、载荷等固有的不确定性，是粉末冶金（P/M）产品寿命评估所必需的复杂技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-e8af8d584a25ef7c23bcff4f05d475d5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Probabilistic lifing method&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e8af8d584a25ef7c23bcff4f05d475d5-e-7&quot;, &quot;chunk-cde5a0fcf48daf01d0e3e3cd1cc4582e-e-6&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e8af8d584a25ef7c23bcff4f05d475d5-e-8" label="Inert Gas Atomisation">
        <attvalues>
          <attvalue for="0" value="Inert Gas Atomisation" />
          <attvalue for="1" value="Manufacturing Step" />
          <attvalue for="2" value="惰性气体雾化是一种先进的金属粉末制备工艺。该工艺利用高速惰性气体（如氩气、氮气）射流冲击熔融金属液流，将其破碎成细小液滴，液滴在冷却中快速凝固形成球形或近球形粉末。此方法能有效防止金属氧化，确保粉末纯度，是粉末冶金和增材制造（3D打印）等领域的核心技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-e8af8d584a25ef7c23bcff4f05d475d5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Inert gas atomisation&quot;, &quot;inert gas atomisation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e8af8d584a25ef7c23bcff4f05d475d5-e-8&quot;, &quot;chunk-a82c14bced3fe39a05a14c312bfa9c9d-e-2&quot;, &quot;chunk-1297af8788c2be7a2a158412cd2652f3-e-3&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a82c14bced3fe39a05a14c312bfa9c9d-e-1" label="P/M product">
        <attvalues>
          <attvalue for="0" value="P/M product" />
          <attvalue for="1" value="Product" />
          <attvalue for="2" value="粉末冶金产品（P/M product）指采用粉末冶金技术制造的零部件。该工艺将金属或非金属粉末压制成预定形状的压坯，随后在低于熔点的温度下进行烧结，使粉末颗粒冶金结合，从而获得具有所需性能和精密度的最终制成品。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-a82c14bced3fe39a05a14c312bfa9c9d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a82c14bced3fe39a05a14c312bfa9c9d-e-1&quot;, &quot;chunk-e8af8d584a25ef7c23bcff4f05d475d5-e-1&quot;]}]" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-a82c14bced3fe39a05a14c312bfa9c9d-e-3" label="Master melts">
        <attvalues>
          <attvalue for="0" value="Master melts" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种通过真空感应熔炼(VIM)工艺生产的高纯净度母合金，作为原料用于惰性气体雾化工艺，以制备金属粉末。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a82c14bced3fe39a05a14c312bfa9c9d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a82c14bced3fe39a05a14c312bfa9c9d-e-5" label="Contamination">
        <attvalues>
          <attvalue for="0" value="Contamination" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="一种源于母合金熔体的杂质或非期望物质，它在生产过程中被继承或传递，并最终存在于粉末产品中的不良状况。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a82c14bced3fe39a05a14c312bfa9c9d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a82c14bced3fe39a05a14c312bfa9c9d-e-6" label="Powder">
        <attvalues>
          <attvalue for="0" value="Powder" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="粉末 (Powder) 是一种由细微固体颗粒构成的材料，其关键物理特性由粒度规格定义，例如230目 (63µm) 或325目 (45µm)。它通常作为原料，被应用于混合 (Blending) 等加工工艺中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a82c14bced3fe39a05a14c312bfa9c9d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;powders&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a82c14bced3fe39a05a14c312bfa9c9d-e-6&quot;, &quot;chunk-766019f20e51155bf0a83e6038d841eb-e-4&quot;, &quot;chunk-00040f62aa8af89625402875bec28b94-e-4&quot;, &quot;chunk-c3fbdb27751e56ed18c73b6134f4664c-e-4&quot;, &quot;chunk-1159c2afbaaccc92d505d71fb856dee1-e-11&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-a82c14bced3fe39a05a14c312bfa9c9d-e-7" label="Tundish">
        <attvalues>
          <attvalue for="0" value="Tundish" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="**中间包 (Tundish)**：一种在冶金和金属雾化工艺中使用的耐火材料容器。它作为中间缓冲设备，用于接收来自钢包或熔炼炉的熔融金属，并通过其底部的陶瓷喷嘴，将金属液稳定、均匀地分配到下一工序。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a82c14bced3fe39a05a14c312bfa9c9d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;tundish&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a82c14bced3fe39a05a14c312bfa9c9d-e-7&quot;, &quot;chunk-4d2bc3be978842eac31d6c74bc19bb3f-e-7&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a82c14bced3fe39a05a14c312bfa9c9d-e-8" label="Ceramic nozzle">
        <attvalues>
          <attvalue for="0" value="Ceramic nozzle" />
          <attvalue for="1" value="Equipment Component" />
          <attvalue for="2" value="一种用于控制流体（如钢水）流动的设备组件。在冶金领域，它通常由陶瓷材料制成。由于受到高温流体的持续冲蚀，其自身材料可能脱落，形成陶瓷夹杂物，成为影响最终产品质量的一种缺陷来源。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-a82c14bced3fe39a05a14c312bfa9c9d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;nozzle&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a82c14bced3fe39a05a14c312bfa9c9d-e-8&quot;, &quot;chunk-4d2bc3be978842eac31d6c74bc19bb3f-e-8&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a82c14bced3fe39a05a14c312bfa9c9d-e-9" label="Inert gas jets">
        <attvalues>
          <attvalue for="0" value="Inert gas jets" />
          <attvalue for="1" value="Equipment Component" />
          <attvalue for="2" value="惰性气体喷嘴是一种环绕在陶瓷喷嘴周围的设备组件，由一个或多个喷头构成。它通过输送高压的惰性气体（如氩气），在核心工艺区域形成保护性气氛，以防止氧化或外界污染。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-a82c14bced3fe39a05a14c312bfa9c9d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a82c14bced3fe39a05a14c312bfa9c9d-e-10" label="Argon">
        <attvalues>
          <attvalue for="0" value="Argon" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="Argon（氩）是一种化学元素，符号为Ar，原子序数为18。它是一种无色、无味的惰性气体，因其化学性质极不活泼，常被用作保护气。在惰性气体喷射器等工业应用中，它能隔绝空气，以防止发生不必要的化学反应。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-a82c14bced3fe39a05a14c312bfa9c9d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a82c14bced3fe39a05a14c312bfa9c9d-e-10&quot;, &quot;chunk-dc663680c2568caff49f127612995631-e-2&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a82c14bced3fe39a05a14c312bfa9c9d-e-11" label="Molten metal">
        <attvalues>
          <attvalue for="0" value="Molten metal" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="**熔融金属 (Molten metal)**&#10;&#10;指金属或合金被加热至熔点以上，从而呈现出的液态状态。在金属雾化等工业制造流程中，它作为一种关键的中间材料，被从熔炼炉中注入中间包（Tundish），以便进行后续的精炼或成型处理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-a82c14bced3fe39a05a14c312bfa9c9d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Melt / Molten metal&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a82c14bced3fe39a05a14c312bfa9c9d-e-11&quot;, &quot;chunk-766019f20e51155bf0a83e6038d841eb-e-7&quot;, &quot;chunk-00040f62aa8af89625402875bec28b94-e-2&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-dc663680c2568caff49f127612995631-e-1" label="Inert gas jets">
        <attvalues>
          <attvalue for="0" value="Inert gas jets" />
          <attvalue for="1" value="Atomization Process" />
          <attvalue for="2" value="一种利用高速惰性气体（常为氩气）射流冲击熔融金属，将其雾化并快速冷却凝固成细小颗粒的工艺。作为一种先进的金属粉末制备技术，该工艺的关键参数是冷却速率，它直接影响最终颗粒的微观结构与性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-dc663680c2568caff49f127612995631" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-dc663680c2568caff49f127612995631-e-3" label="Continuous stream of gas">
        <attvalues>
          <attvalue for="0" value="Continuous stream of gas" />
          <attvalue for="1" value="Process Medium" />
          <attvalue for="2" value="一种高压、连续的气体流，在特定工艺中用作介质，通过冲击使熔融金属流破碎解体，常用于金属粉末制造等领域。" />
          <attvalue for="3" value="{&quot;pressure&quot;: &quot;high&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-dc663680c2568caff49f127612995631" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dc663680c2568caff49f127612995631-e-4" label="Stream of molten metal">
        <attvalues>
          <attvalue for="0" value="Stream of molten metal" />
          <attvalue for="1" value="Feedstock Material" />
          <attvalue for="2" value="一种流体形态的金属原料。在喷嘴处，它被高速、连续的气体射流冲击并雾化，从而分解形成微小的球形金属颗粒。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-dc663680c2568caff49f127612995631" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-dc663680c2568caff49f127612995631-e-5" label="Nozzle">
        <attvalues>
          <attvalue for="0" value="Nozzle" />
          <attvalue for="1" value="Equipment Component" />
          <attvalue for="2" value="一种设备组件，其核心功能是引导熔融金属流与高速气流在此处交汇并相互作用，从而将金属雾化或喷射成型。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-dc663680c2568caff49f127612995631" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dc663680c2568caff49f127612995631-e-5&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dc663680c2568caff49f127612995631-e-6" label="Spherical particles">
        <attvalues>
          <attvalue for="0" value="Spherical particles" />
          <attvalue for="1" value="Product" />
          <attvalue for="2" value="一种通过雾化工艺生产的球形颗粒产品。它由熔融金属流分解成的细小液滴，在快速冷却过程中凝固而成。通常，颗粒越细，其冷却速率越高。" />
          <attvalue for="3" value="{&quot;diameter&quot;: &quot;30 to 300 µm&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-dc663680c2568caff49f127612995631" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-dc663680c2568caff49f127612995631-e-7" label="Atomisation chamber">
        <attvalues>
          <attvalue for="0" value="Atomisation chamber" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="雾化室是一种关键设备部件，用于将液体原料（如熔融金属或溶液）雾化成细小液滴。其核心设计在于提供足够的空间和停留时间，确保液滴在离开腔体前能够完全冷却凝固，最终形成固体颗粒。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-dc663680c2568caff49f127612995631" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dc663680c2568caff49f127612995631-e-9" label="Cooling rates">
        <attvalues>
          <attvalue for="0" value="Cooling rates" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="一项工艺参数，指在惰性气体喷射等工艺中颗粒的降温速率。该速率与颗粒尺寸密切相关，通常颗粒越细，冷却速率越快。" />
          <attvalue for="3" value="{&quot;rate&quot;: &quot;in excess of 100°C/s&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-dc663680c2568caff49f127612995631" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-766019f20e51155bf0a83e6038d841eb-e-1" label="Heating rates">
        <attvalues>
          <attvalue for="0" value="Heating rates" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="升温速率 (Heating rates) 是指单位时间内温度升高的速率(°C/s)，作为制造业中的一个关键工艺参数。对于更细的颗粒，因其比表面积大、能量吸收更快，故通常需要采用更高的升温速率（典型值&gt;100°C/s）进行加工，以获得理想的材料性能。" />
          <attvalue for="3" value="{&quot;rate&quot;: &quot;in excess of 100°C/s&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-766019f20e51155bf0a83e6038d841eb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-766019f20e51155bf0a83e6038d841eb-e-3" label="SEM micrograph">
        <attvalues>
          <attvalue for="0" value="SEM micrograph" />
          <attvalue for="1" value="Analysis Output" />
          <attvalue for="2" value="扫描电子显微镜显微照片（SEM micrograph）：指利用扫描电子显微镜（SEM）获得的物体表面高分辨率图像，是一种分析输出。它能清晰展示样品的微观形貌、结构和成分分布等信息，是材料科学等领域重要的表征手段。" />
          <attvalue for="3" value="{&quot;reference&quot;: &quot;Figure 4.14&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-766019f20e51155bf0a83e6038d841eb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-766019f20e51155bf0a83e6038d841eb-e-5" label="Soluble-gas atomisation">
        <attvalues>
          <attvalue for="0" value="Soluble-gas atomisation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="可溶气体雾化是一种金属制粉工艺。它利用陶瓷管引导金属熔体，并在高压下将气体溶于其中。当熔体进入低压环境时，溶解的气体迅速膨胀，将金属液流爆破并雾化成细小的液滴，最终凝固成粉末。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-766019f20e51155bf0a83e6038d841eb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-766019f20e51155bf0a83e6038d841eb-e-6" label="Ceramic tube">
        <attvalues>
          <attvalue for="0" value="Ceramic tube" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种用于可溶气体雾化工艺的耐高温陶瓷管状部件。它一端插入金属熔体，另一端连接真空室，通过压差引导熔体进入真空环境，从而引发雾化过程以制备金属粉末。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-766019f20e51155bf0a83e6038d841eb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-766019f20e51155bf0a83e6038d841eb-e-8" label="Vacuum chamber">
        <attvalues>
          <attvalue for="0" value="Vacuum chamber" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="真空室是在可溶气体雾化工艺中使用的一种关键组件。它是一个连接在陶瓷管开口端的密封腔室，其主要功能是移除内部气体，为雾化过程创造并维持一个必要的低压真空环境。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-766019f20e51155bf0a83e6038d841eb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-766019f20e51155bf0a83e6038d841eb-e-9" label="Soluble gas">
        <attvalues>
          <attvalue for="0" value="Soluble gas" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="可溶气体是一种能够溶解于熔融金属中的气体材料，通常指氢气。在金属粉末的雾化工艺中，它作为一种辅助材料，其在金属熔体中的溶解与快速释放，有助于将金属液流破碎成细小的颗粒或液滴。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-766019f20e51155bf0a83e6038d841eb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-766019f20e51155bf0a83e6038d841eb-e-9&quot;, &quot;chunk-00040f62aa8af89625402875bec28b94-e-1&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-766019f20e51155bf0a83e6038d841eb-e-10" label="Hydrogen">
        <attvalues>
          <attvalue for="0" value="Hydrogen" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="氢（Hydrogen）是一种化学元素，其单质（H₂）是宇宙中丰度最高的物质。作为一种可溶性气体，它在工业中可用于金属雾化工艺，通过溶解于熔融金属中并在喷出时迅速膨胀，从而促进细小金属粉末的形成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-766019f20e51155bf0a83e6038d841eb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-00040f62aa8af89625402875bec28b94-e-3" label="Atomisation process">
        <attvalues>
          <attvalue for="0" value="Atomisation process" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种金属粉末制备工艺。其原理是将在高压下溶解于熔融金属中的可溶性气体作为雾化介质，当压力骤然释放时，溶解的气体迅速膨胀逸出，从而将金属液流破碎成细小的颗粒或液滴。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-00040f62aa8af89625402875bec28b94" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-00040f62aa8af89625402875bec28b94-e-6" label="Extrusion">
        <attvalues>
          <attvalue for="0" value="Extrusion" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="挤压是一种材料成型工艺。它通过对模具中的粉末施加强大压力，使其发生塑性变形并被压实，从而实现粉末的固结，并制成具有特定截面形状的致密坯件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-00040f62aa8af89625402875bec28b94" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;extrusion&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-00040f62aa8af89625402875bec28b94-e-6&quot;, &quot;chunk-a852675cbb814a50f658ab8ff82b3bdc-e-8&quot;, &quot;chunk-13f1fdc70fe0c4a699a3307c18f29c33-e-5&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-00040f62aa8af89625402875bec28b94-e-7" label="Metallurgical bonding">
        <attvalues>
          <attvalue for="0" value="Metallurgical bonding" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="冶金结合是一种材料现象，为固结过程的预期目标。它指在特定温度、压力和机械变形作用下，颗粒克服表面氧化膜的阻碍，使原子跨越原始颗粒边界，形成牢固的原子间键合。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-00040f62aa8af89625402875bec28b94" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-00040f62aa8af89625402875bec28b94-e-8" label="Prior particle boundaries">
        <attvalues>
          <attvalue for="0" value="Prior particle boundaries" />
          <attvalue for="1" value="Material Feature" />
          <attvalue for="2" value="**原始颗粒边界 (Prior particle boundaries)**&#10;&#10;粉末冶金材料中的一种微观特征，指初始粉末颗粒间的原始接触界面。在烧结或热压等致密化过程中，冶金结合正是在这些界面上发生，从而将松散的粉末转变为致密的块体材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-00040f62aa8af89625402875bec28b94" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Prior particle boundaries (PPBs)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-00040f62aa8af89625402875bec28b94-e-8&quot;, &quot;chunk-24dc73bed55f1ae6b213e521e6e11919-e-3&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-00040f62aa8af89625402875bec28b94-e-10" label="Temperature">
        <attvalues>
          <attvalue for="0" value="Temperature" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="在冶金结合中，为促使材料界面发生原子扩散和塑性变形，从而形成牢固金属键所必需的关键物理条件。它通过提供足够的热能，为实现原子尺度的连接创造了前提。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-00040f62aa8af89625402875bec28b94" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-00040f62aa8af89625402875bec28b94-e-11" label="Pressure">
        <attvalues>
          <attvalue for="0" value="Pressure" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="一种物理条件，指为实现颗粒间的冶金结合，而对其施加的外部作用力。该条件促使颗粒紧密接触，是形成牢固连接和材料致密化的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-00040f62aa8af89625402875bec28b94" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-00040f62aa8af89625402875bec28b94-e-12" label="Mechanical deformation">
        <attvalues>
          <attvalue for="0" value="Mechanical deformation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="机械变形是指物体在外力作用下形状或尺寸发生改变的物理过程。在材料科学中，它是一种实现冶金结合的必要条件，通过对颗粒施加压力，破坏其表面氧化膜等钝化层，使洁净的金属表面紧密接触，从而促成原子间的牢固键合。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-00040f62aa8af89625402875bec28b94" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-00040f62aa8af89625402875bec28b94-e-12&quot;, &quot;chunk-1a5bdd6114d60338a6db59595a5e76c4-e-6&quot;, &quot;chunk-99c942e2e9af3f5f017d599dea23d62d-e-3&quot;]}]" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a852675cbb814a50f658ab8ff82b3bdc-e-1" label="Powder">
        <attvalues>
          <attvalue for="0" value="Powder" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种粉末状的起始原料。它在使用前被封装在钢制容器内，作为特定工业制造或合成工艺的初始输入物料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-a852675cbb814a50f658ab8ff82b3bdc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a852675cbb814a50f658ab8ff82b3bdc-e-2" label="Steel container">
        <attvalues>
          <attvalue for="0" value="Steel container" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="一种钢制设备容器，在粉末冶金工艺中用于封装金属或陶瓷粉末。封装后，容器被抽真空并密封，再通过热等静压(HIP)或闭式模锻等工艺连同内部粉末一起被压实，以制造出致密的近净形成形件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a852675cbb814a50f658ab8ff82b3bdc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a852675cbb814a50f658ab8ff82b3bdc-e-3" label="Hot Isostatic Pressing (HIP)">
        <attvalues>
          <attvalue for="0" value="Hot Isostatic Pressing (HIP)" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="热等静压（Hot Isostatic Pressing, HIP）是一种材料处理工艺，通过在高温和高压下，利用惰性气体对材料施加均匀压力。该工艺能有效消除材料内部的孔隙与缺陷，常用于金属铸件、粉末冶金部件和陶瓷材料的致密化，以显著提高其机械性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a852675cbb814a50f658ab8ff82b3bdc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;HIP&quot;, &quot;Hot isostatic pressing&quot;, &quot;hot isostatic pressing (HIP)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-561d2449c805db1de389831a67f53313-e-5&quot;, &quot;chunk-a852675cbb814a50f658ab8ff82b3bdc-e-3&quot;, &quot;chunk-fd63d9cd61eb501106c8b03551043c54-e-7&quot;, &quot;chunk-86425bad56c0d52ed7246eff0fe06dd8-e-9&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a852675cbb814a50f658ab8ff82b3bdc-e-5" label="High-tonnage press">
        <attvalues>
          <attvalue for="0" value="High-tonnage press" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="一种施加巨大吨位压力的工业压力机，与模具等专用工具配合使用，通过挤压工艺（Extrusion）使金属或塑料等材料强制通过模孔成型，用于制造具有固定横截面轮廓的产品。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a852675cbb814a50f658ab8ff82b3bdc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a852675cbb814a50f658ab8ff82b3bdc-e-6" label="Specialised tooling">
        <attvalues>
          <attvalue for="0" value="Specialised tooling" />
          <attvalue for="1" value="Equipment Component" />
          <attvalue for="2" value="指专为挤压成型工艺而设计的特定设备部件（如模具）。它与高吨位压力机配合使用，通过压力机施加的巨大力量，对材料进行精确塑形，以制造出特定截面形状的产品。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a852675cbb814a50f658ab8ff82b3bdc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a852675cbb814a50f658ab8ff82b3bdc-e-7" label="Fine-grained billet">
        <attvalues>
          <attvalue for="0" value="Fine-grained billet" />
          <attvalue for="1" value="Product" />
          <attvalue for="2" value="细晶坯料是一种具有细小、均匀晶粒组织的金属半成品。它通过高挤压比的挤压工艺生产而成，剧烈的塑性变形促使金属发生动态再结晶，从而细化晶粒。这种精细的微观结构通常赋予材料优异的强度和韧性，是后续精密加工的优质原料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a852675cbb814a50f658ab8ff82b3bdc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a852675cbb814a50f658ab8ff82b3bdc-e-7&quot;, &quot;chunk-dca55a5d4cb2d2d1e2f4de0e571af023-e-2&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-dca55a5d4cb2d2d1e2f4de0e571af023-e-1" label="High reduction ratios">
        <attvalues>
          <attvalue for="0" value="High reduction ratios" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="一项关键的材料塑性加工工艺参数，指工件在锻造、轧制等过程中横截面积的大幅度减小。施加高压下比是促使材料发生剧烈变形和动态再结晶，从而细化晶粒结构、获得细晶粒坯料的必要技术条件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-dca55a5d4cb2d2d1e2f4de0e571af023" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dca55a5d4cb2d2d1e2f4de0e571af023-e-3" label="Extrusion step">
        <attvalues>
          <attvalue for="0" value="Extrusion step" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="一种通过塑性变形加工材料的制造工艺。该步骤能有效分散材料内部的非金属夹杂物，从而显著提高其缺陷容限。在特定应用中，它可被亚固相线热等静压（SSHIP）工艺所替代。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-dca55a5d4cb2d2d1e2f4de0e571af023" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-dca55a5d4cb2d2d1e2f4de0e571af023-e-4" label="Non-metallic inclusions">
        <attvalues>
          <attvalue for="0" value="Non-metallic inclusions" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="非金属夹杂物（non-metallic inclusions）是在金属冶炼和凝固过程中形成的、由氧化物或硫化物等组成的非金属化合物。作为一种常见的冶金缺陷，它们会破坏金属基体的连续性，显著降低材料的强度、韧性、抗疲劳性等关键力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-dca55a5d4cb2d2d1e2f4de0e571af023" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;non-metallic inclusions&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dca55a5d4cb2d2d1e2f4de0e571af023-e-4&quot;, &quot;chunk-c3fbdb27751e56ed18c73b6134f4664c-e-3&quot;, &quot;chunk-cde5a0fcf48daf01d0e3e3cd1cc4582e-e-3&quot;, &quot;chunk-6e297624caadd734c7908a7c84598380-e-6&quot;, &quot;chunk-6ab819da0d17d27985ac5f6eebc6d38b-e-1&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-dca55a5d4cb2d2d1e2f4de0e571af023-e-5" label="Defect tolerance">
        <attvalues>
          <attvalue for="0" value="Defect tolerance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**缺陷容限 (Defect Tolerance)**&#10;&#10;一种材料属性，指材料在内部存在裂纹、孔隙等缺陷的情况下，抑制裂纹扩展并抵抗发生断裂的能力。它是断裂力学和损伤容限设计中的核心概念，是评估含缺陷结构安全性的关键指标，通常通过断裂韧性等参数来表征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-dca55a5d4cb2d2d1e2f4de0e571af023" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;defect tolerance&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dca55a5d4cb2d2d1e2f4de0e571af023-e-5&quot;, &quot;chunk-0e400a717c0177b6e54870a3d685e980-e-10&quot;, &quot;chunk-d2428cb3e80954cab38bfce19b363f27-e-1&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dca55a5d4cb2d2d1e2f4de0e571af023-e-6" label="Sub-solidus, hot isostatic pressing (SSHIP) process">
        <attvalues>
          <attvalue for="0" value="Sub-solidus, hot isostatic pressing (SSHIP) process" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="亚固相线热等静压（SSHIP）是一种制造工艺。它在低于材料固相线温度下，通过施加高温和均匀压力，用于在铸锭-坯料转换后固结材料，常作为传统挤压工序的替代方案。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-dca55a5d4cb2d2d1e2f4de0e571af023" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a2c3fd11f3ed7bc596943938c9fdae5d-e-2" label="Ingot Metallurgy">
        <attvalues>
          <attvalue for="0" value="Ingot Metallurgy" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="铸锭冶金是一种传统的高温合金制备工艺。该工艺将合金原料熔炼并浇铸成锭，再通过热机械加工来控制和改善材料的微观组织与力学性能，最终制成满足特定性能要求的构件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a2c3fd11f3ed7bc596943938c9fdae5d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Ingot metallurgy&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a2c3fd11f3ed7bc596943938c9fdae5d-e-2&quot;, &quot;chunk-fd63d9cd61eb501106c8b03551043c54-e-2&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a2c3fd11f3ed7bc596943938c9fdae5d-e-6" label="Isothermal Forging">
        <attvalues>
          <attvalue for="0" value="Isothermal Forging" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="等温锻造是一种先进的金属热成形工艺。其核心特点是在整个锻压过程中，坯料和模具都保持在相同且恒定的高温下。该工艺允许以极慢的应变速率进行变形，特别适用于加工Udimet 720等高温合金或钛合金这类难变形材料，以制造高精度的近净形复杂锻件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a2c3fd11f3ed7bc596943938c9fdae5d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Isothermal forging&quot;, &quot;isothermal forging&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a2c3fd11f3ed7bc596943938c9fdae5d-e-6&quot;, &quot;chunk-b0fcb2d1e6cc033c9c5417a044b26160-e-5&quot;, &quot;chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676-e-8&quot;, &quot;chunk-8c75d16dc148897cf486c21cbe30e4be-e-4&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-a2c3fd11f3ed7bc596943938c9fdae5d-e-7" label="Billet">
        <attvalues>
          <attvalue for="0" value="Billet" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="在等温锻造工艺中，指预先在加热炉中加热，并在锻压时与模具保持相同温度，从而发生塑性变形的金属工件或坯料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a2c3fd11f3ed7bc596943938c9fdae5d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a2c3fd11f3ed7bc596943938c9fdae5d-e-10" label="P/M superalloy product">
        <attvalues>
          <attvalue for="0" value="P/M superalloy product" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种采用粉末冶金(P/M)工艺制备的高性能合金产品。它将高温合金粉末固结后，再经首选的等温锻造工艺成形，从而获得均匀精细的微观结构与卓越的力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-a2c3fd11f3ed7bc596943938c9fdae5d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a2c3fd11f3ed7bc596943938c9fdae5d-e-10&quot;, &quot;chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199-e-1&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a2c3fd11f3ed7bc596943938c9fdae5d-e-11" label="Powder consolidation">
        <attvalues>
          <attvalue for="0" value="Powder consolidation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="粉末固结是一种粉末冶金核心工艺。它通过加热和加压（如热等静压），将松散的金属或合金粉末压实成接近完全致密的固体坯锭，以消除内部孔隙。该工艺是后续热加工成形（如等温锻造）前的关键准备步骤，为制造高性能产品提供均匀的初始材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-a2c3fd11f3ed7bc596943938c9fdae5d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Consolidation&quot;, &quot;consolidation&quot;, &quot;consolidation of powder&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-00040f62aa8af89625402875bec28b94-e-5&quot;, &quot;chunk-070dbf53e1878b9845a3e7782a58ad66-e-7&quot;, &quot;chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-13&quot;, &quot;chunk-a2c3fd11f3ed7bc596943938c9fdae5d-e-11&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199-e-2" label="Superplastic behaviour">
        <attvalues>
          <attvalue for="0" value="Superplastic behaviour" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="超塑性行为是一种材料特性，通常由细晶粒结构引起。它指材料在特定应变速率和应力下，能进行极大的均匀塑性变形，从而实现复杂形状的精确成形。该现象常见于粉末冶金高温合金，并能用于控制其再结晶和晶粒长大过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199-e-3" label="Small grain size">
        <attvalues>
          <attvalue for="0" value="Small grain size" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="一种材料微观结构特征，指构成材料的多晶体晶粒尺寸细小，通常小于10微米。细小的晶粒是材料获得优异超塑性的关键先决条件，它能促进晶界滑移，从而使材料实现极大的塑性变形。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199-e-3&quot;, &quot;chunk-e15d40b719932710977e7301c85e011b-e-4&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199-e-4" label="Deformation rates">
        <attvalues>
          <attvalue for="0" value="Deformation rates" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="变形速率，也称应变速率，是衡量材料变形快慢的工艺参数。它是一个关键因素，用于表征材料的超塑性行为，该行为通常只在相对较低且受控的变形速率下发生。" />
          <attvalue for="3" value="{&quot;range&quot;: &quot;0.002 to 0.03/s&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199-e-5" label="Stresses">
        <attvalues>
          <attvalue for="0" value="Stresses" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="一项工艺参数，指在高温变形过程中为实现超塑性而施加于材料的应力。该应力的大小是决定和表征材料是否展现超塑性行为的关键因素，并直接影响变形过程与最终效果。" />
          <attvalue for="3" value="{&quot;range&quot;: &quot;50 to 100 MPa&quot;, &quot;temperature&quot;: &quot;1200 °C&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199-e-8" label="Cold-die forging">
        <attvalues>
          <attvalue for="0" value="Cold-die forging" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="冷模锻造（Cold-die forging）是一种采用低温（通常为室温）模具对高温金属坯料进行塑性成形的锻造工艺。其主要特点是，模具与高温工件接触时产生的强烈激冷效应（Die-chill），易导致工件产生不均匀的微观组织，并可能引发晶粒异常长大等缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199-e-8&quot;, &quot;chunk-bdd419f61b4df7e511da7b854e288ce6-e-1&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199-e-9" label="Excessive grain growth">
        <attvalues>
          <attvalue for="0" value="Excessive grain growth" />
          <attvalue for="1" value="Microstructural Defect" />
          <attvalue for="2" value="一种金相组织缺陷，指金属材料在特定热加工或热处理过程（如锻造后）中，晶粒急剧长大至远超正常尺寸。这种异常粗大的晶粒结构会严重恶化材料的强度和韧性等关键力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199-e-9&quot;, &quot;chunk-bdd419f61b4df7e511da7b854e288ce6-e-2&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199-e-10" label="Die-chill">
        <attvalues>
          <attvalue for="0" value="Die-chill" />
          <attvalue for="1" value="Manufacturing Defect" />
          <attvalue for="2" value="模冷是一种制造缺陷，指因模具温度过低，导致接触的热金属（如金属液或锻造坯料）被迅速激冷，流动性降低，从而妨碍正常充型，并引发欠铸、冷隔或表面皱纹等瑕疵的现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2ce86b5d9b53f4d6cfcf3fa4ecfff199-e-10&quot;, &quot;chunk-bdd419f61b4df7e511da7b854e288ce6-e-3&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-bdd419f61b4df7e511da7b854e288ce6-e-6" label="sonic shape">
        <attvalues>
          <attvalue for="0" value="sonic shape" />
          <attvalue for="1" value="Geometry" />
          <attvalue for="2" value="一种为便于对锻件（如盘件）进行超声波探伤，通过机械加工为其设定的特定几何外形规范。该外形是工件在最终成品加工前的一种中间状态，也称为“供货状态”(condition of supply)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-bdd419f61b4df7e511da7b854e288ce6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Sonic shape&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bdd419f61b4df7e511da7b854e288ce6-e-6&quot;, &quot;chunk-bc843e3dfc76a0be097f5be36fb00976-e-11&quot;, &quot;chunk-a0bc17e9304523fcbd1eb1f1e003c749-e-1&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-bdd419f61b4df7e511da7b854e288ce6-e-8" label="GE F-101 engine">
        <attvalues>
          <attvalue for="0" value="GE F-101 engine" />
          <attvalue for="1" value="Engine" />
          <attvalue for="2" value="GE F-101是一款由通用电气公司研制的军用涡扇发动机。它是最早应用Rene 95粉末冶金高温合金的发动机之一，该先进材料被用于制造其压气机盘等关键部件，为B-1战略轰炸机提供动力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-bdd419f61b4df7e511da7b854e288ce6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-bdd419f61b4df7e511da7b854e288ce6-e-9" label="Rene 95 P/M superalloy">
        <attvalues>
          <attvalue for="0" value="Rene 95 P/M superalloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种采用粉末冶金工艺制造的镍基高温合金。它以优异的高温强度和抗疲劳性能著称，是制造高性能航空发动机涡轮盘等关键热端部件的核心材料，典型应用包括GE F-101发动机。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-bdd419f61b4df7e511da7b854e288ce6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bdd419f61b4df7e511da7b854e288ce6-e-9&quot;, &quot;chunk-577e71f977df9c88b625f750e5b679c3-e-1&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-577e71f977df9c88b625f750e5b679c3-e-4" label="Defects">
        <attvalues>
          <attvalue for="0" value="Defects" />
          <attvalue for="1" value="Material Issue" />
          <attvalue for="2" value="指在粉末冶金（P/M）工艺中，材料内部易于产生的各类瑕疵。这种材料问题是导致构件疲劳抗力下降的关键因素，会显著降低其服役性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-577e71f977df9c88b625f750e5b679c3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-577e71f977df9c88b625f750e5b679c3-e-5" label="Fatigue resistance">
        <attvalues>
          <attvalue for="0" value="Fatigue resistance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="疲劳抗性（Fatigue Resistance）是一种力学性能，指材料在循环载荷或交变应力作用下抵抗疲劳破坏的能力。在特定合金（如高温合金）中，这种性能的获得与提升，通常是通过优化作为强化相的γ'（伽马撇）相的微观结构来实现的。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-577e71f977df9c88b625f750e5b679c3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Fatigue Resistance&quot;, &quot;fatigue resistance&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-577e71f977df9c88b625f750e5b679c3-e-5&quot;, &quot;chunk-a00605aad03a48315b6372d73ae11d54-e-3&quot;, &quot;chunk-e7b8406b8d85a1255a692ddd5452a482-e-4&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-24dc73bed55f1ae6b213e521e6e11919-e-1" label="Residual voids">
        <attvalues>
          <attvalue for="0" value="Residual voids" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="残余空隙是一种材料内部缺陷，指在粉末固结过程中，因致密化不充分而在制件中残留的孔隙或空洞。它是影响材料密度、力学性能和整体质量的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-24dc73bed55f1ae6b213e521e6e11919" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-24dc73bed55f1ae6b213e521e6e11919-e-4" label="Inadequate powder consolidation">
        <attvalues>
          <attvalue for="0" value="Inadequate powder consolidation" />
          <attvalue for="1" value="Process Issue" />
          <attvalue for="2" value="**粉末固结不充分 (Inadequate powder consolidation)**&#10;&#10;一种在粉末制造工艺中发生的工艺问题，指粉末颗粒未能实现完全致密化和充分的冶金结合。该问题是导致材料内部产生残余空隙、孔隙以及原始颗粒边界（PPBs）等缺陷的直接原因，会损害最终产品的力学性能和完整性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-24dc73bed55f1ae6b213e521e6e11919" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-24dc73bed55f1ae6b213e521e6e11919-e-5" label="Metallic inclusions">
        <attvalues>
          <attvalue for="0" value="Metallic inclusions" />
          <attvalue for="1" value="Contamination" />
          <attvalue for="2" value="一种污染物，指因外来合金粉末发生交叉污染，而存在于主体材料内部的异种金属颗粒。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-24dc73bed55f1ae6b213e521e6e11919" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="51" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-24dc73bed55f1ae6b213e521e6e11919-e-7" label="Cleaning">
        <attvalues>
          <attvalue for="0" value="Cleaning" />
          <attvalue for="1" value="Quality Assurance Procedure" />
          <attvalue for="2" value="作为一项质量保证程序，它通过系统地清除设备、工具或工作环境中的残留物，旨在最大限度地降低或消除交叉污染的风险，特别是防止外来合金粉末等异物造成的污染。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-24dc73bed55f1ae6b213e521e6e11919" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="51" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4d2bc3be978842eac31d6c74bc19bb3f-e-1" label="cross-contamination">
        <attvalues>
          <attvalue for="0" value="cross-contamination" />
          <attvalue for="1" value="Process Issue" />
          <attvalue for="2" value="交叉污染是一种生产制造中的质量问题，指外来合金粉末等不应存在的异物，在生产流程中意外混入，导致最终产品纯度或成分受到影响。通过有效的清洗程序可以减少或预防此类污染的发生。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-4d2bc3be978842eac31d6c74bc19bb3f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Cross-contamination with a foreign alloy powder&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-24dc73bed55f1ae6b213e521e6e11919-e-6&quot;, &quot;chunk-4d2bc3be978842eac31d6c74bc19bb3f-e-1&quot;]}]" />
          <attvalue for="9" value="51" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-4d2bc3be978842eac31d6c74bc19bb3f-e-2" label="foreign alloy powder">
        <attvalues>
          <attvalue for="0" value="foreign alloy powder" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="外来合金粉末是一种由非预期的金属合金组成的颗粒状污染物。作为一种外来杂质，其混入会导致交叉污染，进而损害最终产品的纯度、性能和完整性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-4d2bc3be978842eac31d6c74bc19bb3f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="51" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4d2bc3be978842eac31d6c74bc19bb3f-e-3" label="chamber">
        <attvalues>
          <attvalue for="0" value="chamber" />
          <attvalue for="1" value="Equipment Component" />
          <attvalue for="2" value="一种设备组件，通常为腔室或容器状结构。它需要通过特定的“清洗程序”(washing runs)进行清洁，以最大限度地减少或防止因处理不同样品或批次而产生的交叉污染。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-4d2bc3be978842eac31d6c74bc19bb3f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="51" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4d2bc3be978842eac31d6c74bc19bb3f-e-4" label="washing runs">
        <attvalues>
          <attvalue for="0" value="washing runs" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种清洁过程，通过对特定腔室 (chamber) 进行清洗，旨在最大限度地减少交叉污染 (cross-contamination)。这通常在处理不同样品或运行不同实验之间进行，以确保结果的准确性和可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-4d2bc3be978842eac31d6c74bc19bb3f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="51" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-4d2bc3be978842eac31d6c74bc19bb3f-e-5" label="Ceramic inclusions">
        <attvalues>
          <attvalue for="0" value="Ceramic inclusions" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="陶瓷夹杂物是一种严重的材料缺陷，指非金属的陶瓷颗粒意外混入材料基体中。它主要来源于高温生产设备（如熔化坩埚、中间包、水口）的侵蚀或剥落，会显著降低材料的力学性能和纯净度，是重点关注的污染类型。可通过筛选等方法进行控制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-4d2bc3be978842eac31d6c74bc19bb3f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;ceramic inclusions&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4d2bc3be978842eac31d6c74bc19bb3f-e-5&quot;, &quot;chunk-22b6daaa9a73c8054dc2ac8a1be3676f-e-5&quot;, &quot;chunk-1cedf1737fe4754f24d3e9eaa5f64aed-e-1&quot;, &quot;chunk-ae58c0f988aba111d22bb6ff5c500655-e-2&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-4d2bc3be978842eac31d6c74bc19bb3f-e-6" label="melt crucible">
        <attvalues>
          <attvalue for="0" value="melt crucible" />
          <attvalue for="1" value="Equipment Component" />
          <attvalue for="2" value="**熔炼坩埚 (melt crucible)**&#10;&#10;一种用于熔化和盛放高温熔体（如金属液）的耐火容器部件。在冶炼过程中，其内壁会因熔体的物理冲刷和化学侵蚀而逐渐剥落，是造成熔体中产生陶瓷夹杂物缺陷的主要来源之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-4d2bc3be978842eac31d6c74bc19bb3f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4d2bc3be978842eac31d6c74bc19bb3f-e-9" label="screening">
        <attvalues>
          <attvalue for="0" value="screening" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="筛分（Screening）：一种物理分离工艺，它通过使用过滤器（filters）从粉末中分离并去除尺寸超标的颗粒（oversized particles），旨在减少或消除最终产品中的陶瓷夹杂物（ceramic inclusions）等缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-4d2bc3be978842eac31d6c74bc19bb3f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-4d2bc3be978842eac31d6c74bc19bb3f-e-10" label="filters">
        <attvalues>
          <attvalue for="0" value="filters" />
          <attvalue for="1" value="Equipment Component" />
          <attvalue for="2" value="筛分设备的关键组件，具有标准尺寸的网孔。它利用物理拦截原理，根据颗粒大小对物料进行分离、筛选或分级。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-4d2bc3be978842eac31d6c74bc19bb3f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4d2bc3be978842eac31d6c74bc19bb3f-e-11" label="oversized particles">
        <attvalues>
          <attvalue for="0" value="oversized particles" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="指因尺寸过大而无法通过过滤器孔隙，从而在过滤过程中被截留去除的固体颗粒。它是一种根据物理尺寸定义的材料类别，通常是流体中的污染物或杂质，例如冶金过程中的非金属夹杂物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-4d2bc3be978842eac31d6c74bc19bb3f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Oversized particles&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4d2bc3be978842eac31d6c74bc19bb3f-e-11&quot;, &quot;chunk-c3fbdb27751e56ed18c73b6134f4664c-e-2&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c3fbdb27751e56ed18c73b6134f4664c-e-1" label="Filters">
        <attvalues>
          <attvalue for="0" value="Filters" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="一种利用筛网等多孔介质进行物理分离的设备。它通过拦截尺寸大于其孔径的颗粒（即过大颗粒），从而实现流体净化或固体物料分级的目的。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-c3fbdb27751e56ed18c73b6134f4664c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c3fbdb27751e56ed18c73b6134f4664c-e-5" label="230 mesh (63 µm)">
        <attvalues>
          <attvalue for="0" value="230 mesh (63 µm)" />
          <attvalue for="1" value="Size Specification" />
          <attvalue for="2" value="一种用于衡量粉末颗粒大小的规格标准。“230目”为筛网单位，其筛孔尺寸对应约63微米(µm)。该规格常作为多种应用中允许的最大颗粒尺寸上限，用以确保粉末的细度满足工艺要求。" />
          <attvalue for="3" value="{&quot;mesh_size&quot;: &quot;230&quot;, &quot;particle_size_microns&quot;: &quot;63&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c3fbdb27751e56ed18c73b6134f4664c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c3fbdb27751e56ed18c73b6134f4664c-e-5&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c3fbdb27751e56ed18c73b6134f4664c-e-6" label="325 mesh (45 µm)">
        <attvalues>
          <attvalue for="0" value="325 mesh (45 µm)" />
          <attvalue for="1" value="Size Specification" />
          <attvalue for="2" value="一种用于描述粉末等颗粒材料细度的尺寸规格。其中“325 mesh”（目）指可通过每英寸325个筛孔的标准筛网，该标准对应的颗粒最大直径约为45微米（µm）。此规格通常作为允许的最大粒度，应用于对材料纯净度和均匀性有严格要求的高精度或高端制造领域。" />
          <attvalue for="3" value="{&quot;mesh_size&quot;: &quot;325&quot;, &quot;particle_size_microns&quot;: &quot;45&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c3fbdb27751e56ed18c73b6134f4664c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c3fbdb27751e56ed18c73b6134f4664c-e-6&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c3fbdb27751e56ed18c73b6134f4664c-e-7" label="Blending">
        <attvalues>
          <attvalue for="0" value="Blending" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种将两种或多种粉末状物料进行物理混合，以获得成分和性质均匀一致的混合物的工艺。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c3fbdb27751e56ed18c73b6134f4664c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fd63d9cd61eb501106c8b03551043c54-e-3" label="Cast-and-wrought product">
        <attvalues>
          <attvalue for="0" value="Cast-and-wrought product" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="一种先经铸造成形，再通过锻造或轧制等塑性加工制成的金属材料形态。此工艺可细化内部组织，消除铸造缺陷，从而获得优异的综合力学性能，是制造航空发动机涡轮盘等高要求关键部件的先进材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-fd63d9cd61eb501106c8b03551043c54" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Conventional cast-and-wrought product&quot;, &quot;cast and wrought product&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fd63d9cd61eb501106c8b03551043c54-e-3&quot;, &quot;chunk-100afba087a43fc5308b3284aa10cb35-e-6&quot;, &quot;chunk-2f922c93a3f1955e166d2270226ee05e-e-11&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-fd63d9cd61eb501106c8b03551043c54-e-5" label="Low-cycle-fatigue (LCF) properties">
        <attvalues>
          <attvalue for="0" value="Low-cycle-fatigue (LCF) properties" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="低周疲劳性能是一种材料力学性能，指材料在足以引起显著塑性变形的循环载荷作用下，抵抗开裂或断裂的能力。它通常通过材料在特定应变幅下达到失效的循环周次，即疲劳寿命，来进行表征和评估。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-fd63d9cd61eb501106c8b03551043c54" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fd63d9cd61eb501106c8b03551043c54-e-5&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fd63d9cd61eb501106c8b03551043c54-e-6" label="650 °C">
        <attvalues>
          <attvalue for="0" value="650 °C" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="指一个特定的试验温度，被用于比较高温合金Rene 95的低周疲劳（LCF）性能。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;650&quot;, &quot;unit&quot;: &quot;°C&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-fd63d9cd61eb501106c8b03551043c54" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fd63d9cd61eb501106c8b03551043c54-e-8" label="HIP + Isothermally Forged">
        <attvalues>
          <attvalue for="0" value="HIP + Isothermally Forged" />
          <attvalue for="1" value="Processing Condition" />
          <attvalue for="2" value="一种结合了热等静压（HIP）和等温锻造的复合材料加工工艺。该工艺先通过热等静压消除材料内部孔隙，再经等温锻造精确成形，旨在获得致密、均匀的微观组织和优异的力学性能，常用于高温合金等高性能材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-fd63d9cd61eb501106c8b03551043c54" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;HIP + isothermally forged&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fd63d9cd61eb501106c8b03551043c54-e-8&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fd63d9cd61eb501106c8b03551043c54-e-9" label="Extruded + Isothermally Forged">
        <attvalues>
          <attvalue for="0" value="Extruded + Isothermally Forged" />
          <attvalue for="1" value="Processing Condition" />
          <attvalue for="2" value="一种复合热机械处理工艺，指材料先经过挤压成形，再进行等温锻造。该工艺常应用于镍基高温合金（如Rene 95）等难变形材料，旨在优化其微观组织结构，以获得卓越的综合力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-fd63d9cd61eb501106c8b03551043c54" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Extruded + isothermally forged&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fd63d9cd61eb501106c8b03551043c54-e-9&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fd63d9cd61eb501106c8b03551043c54-e-10" label="Cast-and-wrought conditions">
        <attvalues>
          <attvalue for="0" value="Cast-and-wrought conditions" />
          <attvalue for="1" value="Processing Condition" />
          <attvalue for="2" value="一种源于铸锭冶金的材料加工状态。该工艺首先将金属熔炼后铸成铸锭，再通过锻造、轧制等塑性变形方式加工成材，以改善组织并获得最终形状。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-fd63d9cd61eb501106c8b03551043c54" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-22b6daaa9a73c8054dc2ac8a1be3676f-e-1" label="Extruded-and-forged material">
        <attvalues>
          <attvalue for="0" value="Extruded-and-forged material" />
          <attvalue for="1" value="Material Processing Method" />
          <attvalue for="2" value="一种结合了挤压与锻造工艺的材料加工方法。通过此方法制备的材料，其综合性能通常优于采用传统铸锻工艺或热等静压（HIP）工艺所获得的材料。" />
          <attvalue for="3" value="{&quot;performance&quot;: &quot;best&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-22b6daaa9a73c8054dc2ac8a1be3676f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-22b6daaa9a73c8054dc2ac8a1be3676f-e-2" label="Conventional cast-and-wrought processing">
        <attvalues>
          <attvalue for="0" value="Conventional cast-and-wrought processing" />
          <attvalue for="1" value="Material Processing Method" />
          <attvalue for="2" value="**标准化描述：**&#10;&#10;一种传统的金属材料加工工艺，包含“铸造”和“锻轧”两个核心阶段。该工艺首先将金属熔化并铸造成锭，随后通过锻造、轧制等方式进行塑性加工，以细化晶粒组织并改善力学性能。作为一种基准方法，其最终产品性能通常被热等静压(HIP)或特殊锻造等更先进的工艺所超越。" />
          <attvalue for="3" value="{&quot;performance&quot;: &quot;worst&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-22b6daaa9a73c8054dc2ac8a1be3676f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-22b6daaa9a73c8054dc2ac8a1be3676f-e-2&quot;, &quot;chunk-e3bc91d02528ce132349b28825081f88-e-7&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-22b6daaa9a73c8054dc2ac8a1be3676f-e-3" label="HIP Material">
        <attvalues>
          <attvalue for="0" value="HIP Material" />
          <attvalue for="1" value="Material Processing Method" />
          <attvalue for="2" value="一种通过热等静压（HIP）工艺制备的材料。其综合性能优于传统的铸锻材料，但次于挤压锻造材料。作为一种先进的粉末冶金技术，它能制造出组织均匀、内部致密的高性能构件。" />
          <attvalue for="3" value="{&quot;performance&quot;: &quot;intermediate&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-22b6daaa9a73c8054dc2ac8a1be3676f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;HIP material&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-22b6daaa9a73c8054dc2ac8a1be3676f-e-3&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-22b6daaa9a73c8054dc2ac8a1be3676f-e-4" label="LCF lives">
        <attvalues>
          <attvalue for="0" value="LCF lives" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="低周疲劳寿命（LCF lives）是一项关键的材料性能指标，指材料在足以引起塑性变形的循环载荷作用下，发生失效前所能承受的循环次数。它被用于评估和比较不同加工工艺下的材料耐久性，陶瓷夹杂物等内部缺陷是限制该性能的主要因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-22b6daaa9a73c8054dc2ac8a1be3676f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-22b6daaa9a73c8054dc2ac8a1be3676f-e-4&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1cedf1737fe4754f24d3e9eaa5f64aed-e-2" label="Turbine disc alloys">
        <attvalues>
          <attvalue for="0" value="Turbine disc alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="涡轮盘合金是用于制造燃气轮机或航空发动机核心部件——涡轮盘的一类高性能合金。它们必须在高温和高应力环境下，具备优异的力学强度、抗蠕变及抗疲劳性能，以确保发动机安全可靠地运行。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-1cedf1737fe4754f24d3e9eaa5f64aed" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1cedf1737fe4754f24d3e9eaa5f64aed-e-4" label="Turbine blading">
        <attvalues>
          <attvalue for="0" value="Turbine blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮叶片是涡轮发动机或汽轮机的核心气动部件，通过其翼型表面将高温高压流体（如燃气或蒸汽）的能量转化为转子旋转的机械能。它在极端高温环境下工作，但相较于固定并承载它的涡轮盘，所承受的离心应力更低。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1cedf1737fe4754f24d3e9eaa5f64aed" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-1" label="Turbine disc alloy">
        <attvalues>
          <attvalue for="0" value="Turbine disc alloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="涡轮盘合金是用于制造航空发动机或燃气轮机核心部件——涡轮盘的高性能合金。为确保在高温高应力下长期可靠运行，它必须具备高强度、高韧性、良好延展性，并拥有卓越的抗疲劳（抗裂纹萌生与低扩展速率）及抗蠕变性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-84f8e7f39bc8df67a9604e9a01eac9a9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-2" label="High yield stress">
        <attvalues>
          <attvalue for="0" value="High yield stress" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="高屈服强度是一种力学性能，指材料发生屈服（即开始塑性变形）所需的应力值很高。它是涡轮盘合金等高性能构件的关键要求，旨在防止其在承受高应力时发生永久变形，从而确保结构的安全与可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-84f8e7f39bc8df67a9604e9a01eac9a9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-3" label="High tensile strength">
        <attvalues>
          <attvalue for="0" value="High tensile strength" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="高抗拉强度是一种机械性能，指材料在断裂前所能承受的最大拉伸应力。该性能对于防止材料和部件在外力作用下发生断裂至关重要，是涡轮盘合金等高要求应用材料的必备属性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-84f8e7f39bc8df67a9604e9a01eac9a9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-4" label="Ductility">
        <attvalues>
          <attvalue for="0" value="Ductility" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="延展性（Ductility）是一种力学性能，指材料在发生断裂前承受塑性变形的能力。良好的延展性能使材料（如涡轮盘合金）在缺陷处通过变形来耗散能量，从而抑制裂纹扩展，赋予其对缺陷的容忍度，是确保关键部件安全性的重要指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-84f8e7f39bc8df67a9604e9a01eac9a9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-6" label="Resistance to the initiation of fatigue cracking">
        <attvalues>
          <attvalue for="0" value="Resistance to the initiation of fatigue cracking" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="**抗疲劳裂纹萌生 (Resistance to the initiation of fatigue cracking)**&#10;&#10;一种力学性能，指材料在循环载荷作用下抵抗疲劳裂纹起始和萌生的能力。它是决定涡轮盘合金等关键构件疲劳寿命和可靠性的重要指标，是确保结构在高周次应力下安全服役的前提。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-84f8e7f39bc8df67a9604e9a01eac9a9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-6&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-7" label="Low fatigue crack propagation rates">
        <attvalues>
          <attvalue for="0" value="Low fatigue crack propagation rates" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="一项关键的机械性能，指材料在循环载荷作用下抵抗裂纹扩展的能力。该速率越低，材料的抗疲劳断裂性能越强，对于涡轮盘等承受高应力的关键部件，是确保其耐久性和安全性的核心指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-84f8e7f39bc8df67a9604e9a01eac9a9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-7&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-9" label="Yield">
        <attvalues>
          <attvalue for="0" value="Yield" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="屈服（Yield）是一种材料失效模式。它指固体材料在应力作用下，应力值超过其弹性极限，开始发生显著且不可恢复的塑性变形。这种永久变形会改变构件的几何形状和性能，是如涡轮盘等关键工程部件设计中必须防止的失效形式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-84f8e7f39bc8df67a9604e9a01eac9a9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-9&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-10" label="Fracture">
        <attvalues>
          <attvalue for="0" value="Fracture" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="断裂（Fracture）是一种材料失效模式，指构件在应力作用下分离成两块或多块的现象。当外加应力超过材料的强度极限（如抗拉强度）时便会发生。在涡轮盘合金等高承载应用中，这是必须预防的关键失效形式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-84f8e7f39bc8df67a9604e9a01eac9a9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-11" label="Defects">
        <attvalues>
          <attvalue for="0" value="Defects" />
          <attvalue for="1" value="Material Imperfection" />
          <attvalue for="2" value="在材料科学中，**缺陷**（Defects）是一种材料缺陷，指晶体中原子周期性排列的任何中断或不规则性。根据上下文，该术语特指在**面心立方（FCC）晶体结构**中出现的各类晶格不完整性，例如空位、位错或堆垛层错，这些缺陷会显著影响材料的宏观性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-84f8e7f39bc8df67a9604e9a01eac9a9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;defects&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-11&quot;, &quot;chunk-8a91b63add4adbc77d4752d41b7c75aa-e-2&quot;, &quot;chunk-ed84e701f59ede6b9d64fc542ae54ff7-e-3&quot;, &quot;chunk-542eb38b71ebf203cb6df08f03ceb063-e-3&quot;, &quot;chunk-c87d6224a6dfa2402ba4ce5b82dd066c-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-12" label="Fatigue cracking">
        <attvalues>
          <attvalue for="0" value="Fatigue cracking" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="疲劳开裂是一种常见的失效模式，指材料在远低于其屈服强度的交变载荷作用下，因局部累积损伤而导致裂纹萌生、扩展，并最终造成结构断裂的现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-84f8e7f39bc8df67a9604e9a01eac9a9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cd1c24f9a838008fb8d63b627fa85467-e-1" label="Turbine Disc Alloy">
        <attvalues>
          <attvalue for="0" value="Turbine Disc Alloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="涡轮盘合金是一种用于制造航空发动机及燃气轮机核心旋转部件——涡轮盘的高温合金。因在高温和巨大应力下工作，它必须具备优异的抗蠕变性和抗应力松弛性能，以保障结构的安全与可靠。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-cd1c24f9a838008fb8d63b627fa85467" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cd1c24f9a838008fb8d63b627fa85467-e-3" label="Stress Relaxation Capability">
        <attvalues>
          <attvalue for="0" value="Stress Relaxation Capability" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="应力松弛能力是一种材料属性，指材料在总应变保持不变时，其内部应力随时间逐渐降低的特性。该能力对涡轮盘合金等高温承力部件至关重要，可有效缓解缺口等应力集中区域的峰值应力，提高部件的可靠性与寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-cd1c24f9a838008fb8d63b627fa85467" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-cd1c24f9a838008fb8d63b627fa85467-e-4" label="Lower Operating Temperatures">
        <attvalues>
          <attvalue for="0" value="Lower Operating Temperatures" />
          <attvalue for="1" value="Operating Condition" />
          <attvalue for="2" value="一种操作工况，指设备或部件在相对较低的温度下运行。在此条件下，材料因高温引发的蠕变效应不显著，因此对涡轮盘合金等高温承力部件的抗蠕变性能要求也相应降低。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-cd1c24f9a838008fb8d63b627fa85467" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cd1c24f9a838008fb8d63b627fa85467-e-5" label="Notches">
        <attvalues>
          <attvalue for="0" value="Notches" />
          <attvalue for="1" value="Component Feature" />
          <attvalue for="2" value="一种部件上的几何特征，其设计旨在特定区域形成可控的应力集中，以利用材料的应力松弛能力来缓解或重新分布整体载荷，从而提高结构的耐久性并防止失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-cd1c24f9a838008fb8d63b627fa85467" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cd1c24f9a838008fb8d63b627fa85467-e-6" label="Features of Stress Concentration">
        <attvalues>
          <attvalue for="0" value="Features of Stress Concentration" />
          <attvalue for="1" value="Component Feature" />
          <attvalue for="2" value="指零部件上因几何形状不连续（如孔、缺口、尖角、截面突变）而导致局部应力显著增大的特定区域。这些特征是结构中的薄弱点，极易成为疲劳裂纹的萌生源头并引发失效。因此，在这些区域具备应力松弛能力对于提升结构耐久性至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-cd1c24f9a838008fb8d63b627fa85467" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cd1c24f9a838008fb8d63b627fa85467-e-6&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8f2b320fa48cfb5ef53d60e1a4ca2d11-e-1" label="Turbine disc alloys">
        <attvalues>
          <attvalue for="0" value="Turbine disc alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一类专用于制造燃气轮机核心部件“涡轮盘”的高温合金。其化学成分和显微结构经特殊设计，以承受巨大的旋转应力和高温环境。它通常为多晶材料，与用于叶片的单晶高温合金相区别。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-8f2b320fa48cfb5ef53d60e1a4ca2d11" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8f2b320fa48cfb5ef53d60e1a4ca2d11-e-2" label="Gas turbine engines">
        <attvalues>
          <attvalue for="0" value="Gas turbine engines" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="一种将燃料化学能转化为机械功或推力的连续燃烧式内燃机。它通过压缩空气与燃料燃烧产生高温高压燃气，驱动涡轮高速旋转做功。因其严苛的工作环境，是涡轮盘合金等先进耐热材料的关键应用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-8f2b320fa48cfb5ef53d60e1a4ca2d11" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8f2b320fa48cfb5ef53d60e1a4ca2d11-e-3" label="Chemical Composition">
        <attvalues>
          <attvalue for="0" value="Chemical Composition" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="化学成分（Chemical composition）是一种属性，指构成特定物质或材料的化学元素的种类、含量及比例。它是决定该物质物理性质、化学性质与机械性能（如强度、耐腐蚀性）的根本因素，对涡轮盘合金等高性能材料至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-8f2b320fa48cfb5ef53d60e1a4ca2d11" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Chemical composition&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8f2b320fa48cfb5ef53d60e1a4ca2d11-e-3&quot;, &quot;chunk-117357a69dc4feae2bf2578a7ae7467c-e-3&quot;, &quot;chunk-921a9348cd77597c4374323349308669-e-8&quot;, &quot;chunk-c2b78e8b376569da6104df59fa66c5ca-e-1&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e4445ec100361e8a0d56ff46090155d6-e-3" label="Alloy Chemistry">
        <attvalues>
          <attvalue for="0" value="Alloy Chemistry" />
          <attvalue for="1" value="Material Aspect" />
          <attvalue for="2" value="合金化学是一项关键材料属性，指构成合金的化学元素种类及其精确的含量比例。它直接决定了合金的物理、机械及加工性能（如强度、硬度、耐腐蚀性），是材料设计和工艺过程建模中的核心影响参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-e4445ec100361e8a0d56ff46090155d6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;alloy chemistry&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e4445ec100361e8a0d56ff46090155d6-e-3&quot;, &quot;chunk-683c24651dbc6713d385ae625ce4aa06-e-8&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-e4445ec100361e8a0d56ff46090155d6-e-5" label="optimum combination of properties">
        <attvalues>
          <attvalue for="0" value="optimum combination of properties" />
          <attvalue for="1" value="Goal" />
          <attvalue for="2" value="指材料的各项性能（如强度、韧性等）达到最佳平衡的理想状态。这一目标状态的实现，依赖于对材料的合金化学成分与微观结构的精确调控。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e4445ec100361e8a0d56ff46090155d6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a00605aad03a48315b6372d73ae11d54-e-2" label="Strength">
        <attvalues>
          <attvalue for="0" value="Strength" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="Strength是一种材料的机械属性，指材料抵抗外力作用下发生变形或断裂的能力。在特定合金中，该属性主要通过优化其微观结构中的γ'相（一种关键强化相）来获得和增强。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a00605aad03a48315b6372d73ae11d54" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;strength&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a00605aad03a48315b6372d73ae11d54-e-2&quot;, &quot;chunk-99e1c2354bf8364a02d01889797902c8-e-7&quot;, &quot;chunk-6b0fd58b99d0490b98efe29e49c3ef5d-e-4&quot;, &quot;chunk-d9d4e9c6bdfb7df170a8302da4a9bf0c-e-2&quot;, &quot;chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-11&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a00605aad03a48315b6372d73ae11d54-e-9" label="Uniform distribution of γ' particles">
        <attvalues>
          <attvalue for="0" value="Uniform distribution of γ' particles" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="一种理想的微观组织特征，指作为强化相的γ'粒子在材料基体中呈现出弥散、均匀的分布状态。这种组织形态通常通过特定的热处理工艺调控获得，对于优化材料（尤其是高温合金）的力学性能至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-a00605aad03a48315b6372d73ae11d54" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b64f0440514a10a330fae0f79e407e4c-e-1" label="Yield stresses of the turbine disc alloys">
        <attvalues>
          <attvalue for="0" value="Yield stresses of the turbine disc alloys" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="涡轮盘合金的屈服强度是衡量其抵抗永久（塑性）变形能力的关键力学性能指标，指材料开始发生塑性变形时的临界应力值。其数值大小主要取决于合金微观结构中存在的γ'和γ''等强化相的尺寸、形态与分布。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-b64f0440514a10a330fae0f79e407e4c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-b64f0440514a10a330fae0f79e407e4c-e-2" label="Turbine disc alloys">
        <attvalues>
          <attvalue for="0" value="Turbine disc alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="涡轮盘合金是一类专用于制造涡轮盘的高性能合金。作为燃气轮机的核心旋转承力部件，该类合金的设计重点是获得卓越的高温强度、屈服强度和抗疲劳性能，以承受高速旋转产生的巨大离心应力及高温环境。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-b64f0440514a10a330fae0f79e407e4c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b64f0440514a10a330fae0f79e407e4c-e-4" label="y&quot;">
        <attvalues>
          <attvalue for="0" value="y&quot;" />
          <attvalue for="1" value="Strengthening Phase" />
          <attvalue for="2" value="γ'相 (Gamma Prime Phase) 是镍基高温合金（如涡轮盘合金）中的主要强化相，是一种由铝、钛等元素促进形成的金属间化合物。它具有L1₂有序结构，其形态、尺寸和体积分数是决定合金高温屈服强度的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-b64f0440514a10a330fae0f79e407e4c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b64f0440514a10a330fae0f79e407e4c-e-4&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b64f0440514a10a330fae0f79e407e4c-e-5" label="Elements">
        <attvalues>
          <attvalue for="0" value="Elements" />
          <attvalue for="1" value="Chemical Component" />
          <attvalue for="2" value="指在涡轮盘合金中，为促进关键强化相（如γ'相和γ&quot;相）形成而特定添加的一类合金元素。通过精确控制其浓度，可以优化合金的微观结构，从而显著提升材料在高温环境下的强度和耐久性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-b64f0440514a10a330fae0f79e407e4c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b64f0440514a10a330fae0f79e407e4c-e-6" label="Thermo-Calc">
        <attvalues>
          <attvalue for="0" value="Thermo-Calc" />
          <attvalue for="1" value="Software" />
          <attvalue for="2" value="Thermo-Calc是一款基于CALPHAD方法的热力学计算软件，广泛应用于材料科学与工程。它通过计算相图和热力学性质，精确预测多元合金体系中的相平衡、相分数（如γ'和γ''相）以及微观结构演变。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-b64f0440514a10a330fae0f79e407e4c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b64f0440514a10a330fae0f79e407e4c-e-6&quot;, &quot;chunk-166f31f5769126f6a4cd51ea1a1302a5-e-1&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-b64f0440514a10a330fae0f79e407e4c-e-7" label="Thermodynamic software">
        <attvalues>
          <attvalue for="0" value="Thermodynamic software" />
          <attvalue for="1" value="Software Category" />
          <attvalue for="2" value="一类用于材料科学与工程领域的计算软件。它通常基于CALPHAD方法和热力学数据库，计算多元合金等材料的相图、相平衡及热力学性质，是进行新材料设计和工艺优化的核心工具。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-b64f0440514a10a330fae0f79e407e4c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-166f31f5769126f6a4cd51ea1a1302a5-e-3" label="y&quot; (gamma double prime)">
        <attvalues>
          <attvalue for="0" value="y&quot; (gamma double prime)" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="y&quot; (gamma double prime) 是一种材料中的强化相。作为多种强化相之一，其体积分数是影响材料性能的关键因素，该数值通常可通过专业的材料热力学计算软件Thermo-Calc进行估算。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-166f31f5769126f6a4cd51ea1a1302a5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-166f31f5769126f6a4cd51ea1a1302a5-e-4" label="Yield stress at 650 °C">
        <attvalues>
          <attvalue for="0" value="Yield stress at 650 °C" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="650°C屈服强度是一项关键的高温力学性能指标，指材料在650摄氏度下发生塑性变形的临界应力。其数值大小与材料内部强化相（如析出相）的总量和分布密切相关，是评估材料高温结构强度的重要依据。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;650 °C&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-166f31f5769126f6a4cd51ea1a1302a5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-166f31f5769126f6a4cd51ea1a1302a5-e-5" label="Sum of the fractions of the strengthening phases">
        <attvalues>
          <attvalue for="0" value="Sum of the fractions of the strengthening phases" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="强化相分数和 (Sum of the fractions of the strengthening phases)&#10;&#10;指材料中主要强化相γ'和γ''的体积分数总和。作为一项关键材料属性，该值是预测材料（尤其在高温下）屈服强度的重要指标，与其强度表现密切相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-166f31f5769126f6a4cd51ea1a1302a5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2b6a04ecc641ed4c1cec1b3e414ec201-e-2" label="Stress for 1000 h life at 700°C">
        <attvalues>
          <attvalue for="0" value="Stress for 1000 h life at 700°C" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="一项用于评估材料蠕变性能的指标，指在700°C恒定温度下，材料能够承受1000小时而不断裂的最大应力值。该数值越高，表明材料在该条件下的抗蠕变能力越强。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;700°C&quot;, &quot;life&quot;: &quot;1000 h&quot;}" />
          <attvalue for="4" value="e-2" />
