        <attvalues>
          <attvalue for="11" value="CREATES_DILEMMA_IN" />
          <attvalue for="12" value="The 'extra' safety factor creates a dilemma within the damage-tolerant lifing procedure about how conservative it is." />
          <attvalue for="13" value="In practice, the ‘extra' safety factor arising from the choice of a 0.75 mm long crack as constituting failure creates a dilemma." />
          <attvalue for="14" value="r-2" />
