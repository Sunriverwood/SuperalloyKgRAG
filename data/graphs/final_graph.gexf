        <attvalues>
          <attvalue for="11" value="IS_ALTERNATIVE_TO" />
          <attvalue for="12" value="Platinum-diffused coatings are an alternative strategy to using aluminide-type diffusion coatings." />
          <attvalue for="13" value="An alternative strategy is to make use of platinum-diffused rather than aluminide-type diffusion coatings" />
          <attvalue for="14" value="r-4" />
