      <edge source="chunk-d59969b39f742308167ec01469929e5b-e-12" target="chunk-b821a94296e5e31338263fc084ea39d5-e-6" id="chunk-d59969b39f742308167ec01469929e5b-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="INFLUENCES REQUIREMENT FOR" />
          <attvalue for="12" value="The operating environment is given as a reason for the emphasis on corrosion resistance." />
          <attvalue for="13" value="...greater emphasis on corrosion resistance... due to... the operating environment [3]" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-d59969b39f742308167ec01469929e5b" />
