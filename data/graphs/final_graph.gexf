          <attvalue for="9" value="3" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-632d29e490ba842c81dadf45a38731c6-e-2" label="ase ceramics">
        <attvalues>
          <attvalue for="0" value="ase ceramics" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="ase ceramics 是一种陶瓷材料，该术语出自权威学术期刊《美国陶瓷学会杂志》发表的一篇研究文献，用于指代在该特定文献中所论述的陶瓷类型。" />
