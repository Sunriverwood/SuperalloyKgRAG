        <attvalues>
          <attvalue for="11" value="INCREASES" />
          <attvalue for="12" value="The combination of super-solvus and sub-solvus heat treatments was shown to be detrimental, causing an increase in the FCP rate." />
          <attvalue for="13" value="Combinations of the original super-solvus heat treatment followed by subsequent sub-solvus heat treatment were shown to be very detrimental, with a further increase in FCP rate of at least 3" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-0dac1108ee01fd25c7f627485d2972e6" />
          <attvalue for="17" value="0.4" />
