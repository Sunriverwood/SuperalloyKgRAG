        <attvalues>
          <attvalue for="11" value="DOES_NOT_SEGREGATE_AT" />
          <attvalue for="12" value="No segregation of Carbon (C) was identified at the grain boundaries." />
          <attvalue for="13" value="Interestingly, no segregation of C was identified" />
          <attvalue for="14" value="r-7" />
