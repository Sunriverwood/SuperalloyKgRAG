      <node id="chunk-27d4439c082e1df0f703012a02b14ffb-e-8" label="K. Bungardt, G. Lehnert and H. W. Meinhardt">
        <attvalues>
          <attvalue for="0" value="K. Bungardt, G. Lehnert and H. W. Meinhardt" />
          <attvalue for="1" value="Inventors" />
          <attvalue for="2" value="K. Bungardt、G. Lehnert 和 H. W. Meinhardt 是一位发明家群体。他们作为共同发明人被记载于美国专利 3819338，该专利涉及一种奥氏体铬镍钢 (Austenitic chromium-nickel steel) 的技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
