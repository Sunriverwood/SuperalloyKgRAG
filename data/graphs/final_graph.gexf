        <attvalues>
          <attvalue for="11" value="IS_PROPERTY_OF" />
          <attvalue for="12" value="The parameter 'f' represents the volume fraction of the γ' phase." />
          <attvalue for="13" value="...the volume fraction, f, of γ' is then large." />
