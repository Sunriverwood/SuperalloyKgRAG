      <node id="chunk-fb8636aebcb8b8d854ebe34fb885b102-e-10" label="Superalloys II">
        <attvalues>
          <attvalue for="0" value="Superalloys II" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《高温合金II：航空航天和工业动力用高温材料》是一部由C. T. Sims、N. S. Stoloff和W. C. Hagel共同编辑，John Wiley and Sons于1987年出版的学术专著。该书系统阐述了高温合金及其在航空航天和工业动力领域的应用。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1987&quot;}" />
