      <node id="chunk-d6bdb664cd0308fc87bae418c9eaeb6d-e-2" label="Gas turbine engines">
        <attvalues>
          <attvalue for="0" value="Gas turbine engines" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="燃气涡轮发动机（Gas turbine engine）是一种将燃料化学能转化为可用机械功的连续流动内燃机。它通过驱动高温高压燃气流过涡轮叶片使其旋转做功。因其严苛的工作环境，是单晶高温合金等先进材料的重要应用领域，广泛用于飞机发动机和发电站。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-d6bdb664cd0308fc87bae418c9eaeb6d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Gas turbine engine&quot;, &quot;General Electric's dual heat treatment process&quot;, &quot;The gas turbine engine&quot;, &quot;gas turbine engine&quot;, &quot;gas turbine engines&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d6bdb664cd0308fc87bae418c9eaeb6d-e-2&quot;, &quot;chunk-43df518934138ca7d680747b9c908d8b-e-4&quot;, &quot;chunk-562ab8120c986d32d5b96c3da5071063-e-4&quot;, &quot;chunk-d9d4d301605356b62bd308e19ed1fd05-e-2&quot;, &quot;chunk-db0aaf39ddd68495034176be78a2d349-e-6&quot;, &quot;chunk-c1f941cda4f8b36efca8168f378f1be7-e-9&quot;, &quot;chunk-8debf02eecb6d1c5cb6982c6f0228498-e-1&quot;, &quot;chunk-b455c334b535d063bfe8817108154093-e-2&quot;, &quot;chunk-c5980c35223518f9aaec4d49ac82b647-e-8&quot;, &quot;chunk-11623a127f67a421f15bdd1ebd79d8af-e-1&quot;, &quot;chunk-3840a842bb1a54d4d273056bed0dac49-e-2&quot;, &quot;chunk-ab0efb3d9b926e2af6dcfa9258a58f78-e-6&quot;, &quot;chunk-fdfde6e5e53ab8b0bee7b6e14d3acdef-e-2&quot;, &quot;chunk-2582edaf6620b68f12a09bd6df3bb24c-e-2&quot;, &quot;chunk-86425bad56c0d52ed7246eff0fe06dd8-e-5&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-d6bdb664cd0308fc87bae418c9eaeb6d-e-4" label="Chemical degradation">
        <attvalues>
          <attvalue for="0" value="Chemical degradation" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="化学降解指材料与环境发生化学反应（如氧化、腐蚀），导致其化学结构被破坏、性能劣化的现象。高温合金等先进材料因其独特的成分与结构，对此类降解具有优异的抵抗能力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d6bdb664cd0308fc87bae418c9eaeb6d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d6bdb664cd0308fc87bae418c9eaeb6d-e-5" label="This book">
        <attvalues>
          <attvalue for="0" value="This book" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一部系统阐述高温合金冶金原理及其在部件设计、制造中实践应用的专业著作。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d6bdb664cd0308fc87bae418c9eaeb6d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d6bdb664cd0308fc87bae418c9eaeb6d-e-6" label="Metallurgical principles">
        <attvalues>
          <attvalue for="0" value="Metallurgical principles" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="冶金原理是关于从矿物中提取金属并制备成具有特定性能的合金的科学理论体系。它运用物理化学、热力学和动力学等知识，为合金材料的设计、开发与生产提供基础指导。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-d6bdb664cd0308fc87bae418c9eaeb6d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d6bdb664cd0308fc87bae418c9eaeb6d-e-6&quot;, &quot;chunk-ff95c020d0eb3854d47176a924594dbf-e-4&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-23956e10c58e231fcc8e8072af07e6f4-e-1" label="Alloy design">
        <attvalues>
          <attvalue for="0" value="Alloy design" />
          <attvalue for="1" value="Engineering Topic" />
          <attvalue for="2" value="合金设计 (Alloy design) 是材料科学与工程的重要分支，专注于通过系统性地调控化学成分、组织结构和加工工艺，来开发满足特定性能要求的新型金属材料。该领域的研究与材料行为的理解及工艺开发等紧密相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-23956e10c58e231fcc8e8072af07e6f4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;alloy design&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-23956e10c58e231fcc8e8072af07e6f4-e-1&quot;, &quot;chunk-542eb38b71ebf203cb6df08f03ceb063-e-13&quot;, &quot;chunk-ff95c020d0eb3854d47176a924594dbf-e-5&quot;]}]" />
          <attvalue for="9" value="37" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-23956e10c58e231fcc8e8072af07e6f4-e-2" label="Process development">
        <attvalues>
          <attvalue for="0" value="Process development" />
          <attvalue for="1" value="Engineering Topic" />
          <attvalue for="2" value="**工艺开发 (Process development)**&#10;&#10;工程领域中的关键阶段，指将实验室的研究成果（如新材料或技术）转化为稳定、高效且经济的规模化生产过程。它通过定义和优化工艺参数、进行工艺放大、确保产品质量，最终实现商业化生产，是连接科学研究与工业制造的核心桥梁。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-23956e10c58e231fcc8e8072af07e6f4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Process Development&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-23956e10c58e231fcc8e8072af07e6f4-e-2&quot;, &quot;chunk-ff95c020d0eb3854d47176a924594dbf-e-6&quot;, &quot;chunk-0ded602080ef74e810480d8e88484e82-e-2&quot;]}]" />
          <attvalue for="9" value="37" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-23956e10c58e231fcc8e8072af07e6f4-e-3" label="Component Engineering">
        <attvalues>
          <attvalue for="0" value="Component Engineering" />
          <attvalue for="1" value="Field of Study" />
          <attvalue for="2" value="**组件工程 (Component Engineering)** 是一门工程学科，专注于研究、选择、采购、测试和管理构成一个系统的元器件或零部件。其核心目标是确保关键部件的质量、可靠性与合规性，从而保障整个系统的性能、可制造性和生命周期。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-23956e10c58e231fcc8e8072af07e6f4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Component engineering&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-23956e10c58e231fcc8e8072af07e6f4-e-3&quot;, &quot;chunk-ff95c020d0eb3854d47176a924594dbf-e-7&quot;, &quot;chunk-0898547a68d165adae5002ba87d72e05-e-1&quot;, &quot;chunk-0ded602080ef74e810480d8e88484e82-e-3&quot;]}]" />
          <attvalue for="9" value="37" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-23956e10c58e231fcc8e8072af07e6f4-e-4" label="Lifetime estimation">
        <attvalues>
          <attvalue for="0" value="Lifetime estimation" />
          <attvalue for="1" value="Field of Study" />
          <attvalue for="2" value="寿命预测（Lifetime Estimation）是一门旨在预测材料、部件或系统在特定工况下使用寿命的研究领域。它紧密结合了材料行为学与部件工程学的理论与方法，通过分析疲劳、蠕变、腐蚀等因素，对产品的可靠性与安全性进行评估，是工程设计和维护中的关键学科。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-23956e10c58e231fcc8e8072af07e6f4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Lifetime Estimation&quot;, &quot;lifetime estimation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-23956e10c58e231fcc8e8072af07e6f4-e-4&quot;, &quot;chunk-ff95c020d0eb3854d47176a924594dbf-e-8&quot;, &quot;chunk-0898547a68d165adae5002ba87d72e05-e-2&quot;, &quot;chunk-e00b2aac6b639de957a0e986581a8e1c-e-8&quot;, &quot;chunk-f7802da45487754a86d28619b81d1a73-e-3&quot;]}]" />
          <attvalue for="9" value="37" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-23956e10c58e231fcc8e8072af07e6f4-e-5" label="Materials Behaviour">
        <attvalues>
          <attvalue for="0" value="Materials Behaviour" />
          <attvalue for="1" value="Field of Study" />
          <attvalue for="2" value="材料行为是材料科学与工程中的核心概念，指材料在力、温度、化学环境等外部刺激下的响应和表现。该研究旨在理解和预测材料的机械、物理及化学性质（如强度、韧性、腐蚀等），对于工程设计中的材料选择和性能评估至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
