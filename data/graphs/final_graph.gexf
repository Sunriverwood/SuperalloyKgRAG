        <attvalues>
          <attvalue for="0" value="blade" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一个名为“blade”的组件，其英文缩写为“B”。它在所属系统中作为一个基本构成单元而存在。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
