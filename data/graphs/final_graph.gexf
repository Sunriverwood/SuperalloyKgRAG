          <attvalue for="1" value="Person" />
          <attvalue for="2" value="J. C. Schaeffer是一位研究人员，专注于高温合金的微观结构不稳定性领域。他撰写的关于该主题的论文，发表在1996年的《Superalloys 1996》出版物中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
