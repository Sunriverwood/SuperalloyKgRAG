      <node id="chunk-fd0257f35193366950536d3c582b3768-e-6" label="component quality">
        <attvalues>
          <attvalue for="0" value="component quality" />
          <attvalue for="1" value="Attribute" />
          <attvalue for="2" value="组件质量是指衡量一个组件在性能、可靠性、一致性等方面表现的综合属性。它是一项可以通过对相关流程进行再造（re-engineering）等方式来系统性改进和提升的关键特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-fd0257f35193366950536d3c582b3768" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fd0257f35193366950536d3c582b3768-e-7" label="advanced heat-treatment methods">
        <attvalues>
          <attvalue for="0" value="advanced heat-treatment methods" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="作为工艺再造的一个实例，这是一类通过重新设计和优化传统工艺而形成的现代化热处理技术。其核心在于更精确地控制材料的加热与冷却过程，以显著改善材料的微观结构与宏观性能，从而提升其强度、硬度及耐用性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-fd0257f35193366950536d3c582b3768" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ee2c916092b69050b73e7898f576b082-e-2" label="Advanced heat-treatment methods">
        <attvalues>
          <attvalue for="0" value="Advanced heat-treatment methods" />
          <attvalue for="1" value="Process Category" />
          <attvalue for="2" value="一类新兴或持续改进的热处理工艺。它通过精确控制材料的微观结构，旨在显著提升涡轮盘等高性能关键部件的综合性能、可靠性与使用寿命。" />
          <attvalue for="3" value="{&quot;status&quot;: &quot;in active development&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-ee2c916092b69050b73e7898f576b082" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ee2c916092b69050b73e7898f576b082-e-7" label="Computer-controlled cooling">
        <attvalues>
          <attvalue for="0" value="Computer-controlled cooling" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种利用计算机精确控制冷却速率与过程的先进工艺。它通过优化材料（如金属）在热加工后的降温曲线，主动减小其内部因不均匀冷却而产生的残余应力，以提高最终产品的性能、精度和寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ee2c916092b69050b73e7898f576b082" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6261bb103f1582e3eddbed3d2b069224-e-1" label="re-engineered process">
        <attvalues>
          <attvalue for="0" value="re-engineered process" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种经过重新设计的流程。该流程通过引入或优化冷却方法作为其关键环节，旨在降低特定不良效应的强度或影响，以达到预期的工艺改进目标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-6261bb103f1582e3eddbed3d2b069224" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6261bb103f1582e3eddbed3d2b069224-e-2" label="cooling">
        <attvalues>
          <attvalue for="0" value="cooling" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="作为再造工艺的一部分，该冷却工序通过计算机控制的高速气体喷射来执行，旨在降低特定物理效应（如热量）的强度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-6261bb103f1582e3eddbed3d2b069224" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6261bb103f1582e3eddbed3d2b069224-e-3" label="computer-controlled high-velocity gas jets">
        <attvalues>
          <attvalue for="0" value="computer-controlled high-velocity gas jets" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="一种由计算机精确控制的专用设备，通过喷射高速气流，对盘状目标（如圆盘）实现快速、非接触式的强制冷却。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-6261bb103f1582e3eddbed3d2b069224" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6261bb103f1582e3eddbed3d2b069224-e-7" label="thermal mass">
        <attvalues>
          <attvalue for="0" value="thermal mass" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="热质量是一种物理属性，指物体或材料吸收和储存热能的能力。高热质量的物体在吸收或释放大量热量时，自身温度变化较小。因此，它能够有效减缓和稳定温度波动，起到热缓冲的作用，这种特性也常被称为热惯性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-6261bb103f1582e3eddbed3d2b069224" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="25" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6261bb103f1582e3eddbed3d2b069224-e-8" label="Modelling">
        <attvalues>
          <attvalue for="0" value="Modelling" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="建模 (Modelling) 是指建立物理或数学模型来模拟某一过程或系统，并通过分析与计算来推导出所需传热系数的方法。它是一种将复杂物理问题简化，以便于进行工程分析和参数预测的过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-6261bb103f1582e3eddbed3d2b069224" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;modelling&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6261bb103f1582e3eddbed3d2b069224-e-8&quot;, &quot;chunk-523637843506c3574fe003659e8f0b3e-e-2&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-523637843506c3574fe003659e8f0b3e-e-3" label="Optimised heat treatment">
        <attvalues>
          <attvalue for="0" value="Optimised heat treatment" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种先进的热处理工艺，通过使用多个可控气流区，实现比传统油淬更均匀的热量移除。该工艺能显著减少材料内部的热梯度，从而提高淬火质量和零件性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-523637843506c3574fe003659e8f0b3e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-523637843506c3574fe003659e8f0b3e-e-4" label="Traditional oil quenching">
        <attvalues>
          <attvalue for="0" value="Traditional oil quenching" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种传统的热处理工艺，以油为冷却介质，对加热后的金属工件进行快速冷却，以提高其硬度和强度。与优化热处理等先进技术相比，该方法的冷却均匀性较差，可能导致工件产生较大变形或性能不稳定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-523637843506c3574fe003659e8f0b3e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-523637843506c3574fe003659e8f0b3e-e-7" label="Gas-flow zones">
        <attvalues>
          <attvalue for="0" value="Gas-flow zones" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="标准化描述:&#10;优化热处理装置中的可控分区。每个分区内的气体流动、温度和作用时间均可独立调节，旨在对工件的加热或冷却过程实现精确控制，以确保最终处理质量。" />
          <attvalue for="3" value="{&quot;quantity&quot;: &quot;as many as 12&quot;, &quot;control_factors&quot;: &quot;quenching time and part temperature&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-523637843506c3574fe003659e8f0b3e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a7d085459bd54c4dc6eab5e3a7db879c-e-1" label="Controlled Technology">
        <attvalues>
          <attvalue for="0" value="Controlled Technology" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="一种先进的热处理技术，其工艺过程通过精确调控淬火时间和零件温度来实现。该技术通常与双微观结构热处理炉配套使用，是应用于下一代生产设施的核心技术之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-a7d085459bd54c4dc6eab5e3a7db879c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="65" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a7d085459bd54c4dc6eab5e3a7db879c-e-2" label="quenching time">
        <attvalues>
          <attvalue for="0" value="quenching time" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="淬火时间（quenching time）是在材料热处理工艺中，将工件从高温快速冷却所持续的时间。它是一个关键的工艺参数，直接控制材料的相变过程，从而决定其最终的微观结构与机械性能（如硬度、强度和韧性）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a7d085459bd54c4dc6eab5e3a7db879c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="65" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a7d085459bd54c4dc6eab5e3a7db879c-e-3" label="part temperature">
        <attvalues>
          <attvalue for="0" value="part temperature" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="作为一项关键工艺参数，指在特定技术加工过程中对零件本身温度的测量与控制。该参数直接影响材料的物理化学性质、成型质量以及最终产品的性能和可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a7d085459bd54c4dc6eab5e3a7db879c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="65" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a7d085459bd54c4dc6eab5e3a7db879c-e-4" label="dual microstructure heat-treatment furnaces">
        <attvalues>
          <attvalue for="0" value="dual microstructure heat-treatment furnaces" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="一种先进的热处理设备，其核心功能是在单个工件内生成两种不同的微观结构，以实现定制化的材料性能。该设备是下一代先进热处理设施的关键组成部分，需与特定的“受控技术”协同工作。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a7d085459bd54c4dc6eab5e3a7db879c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a7d085459bd54c4dc6eab5e3a7db879c-e-4&quot;]}]" />
          <attvalue for="9" value="65" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a7d085459bd54c4dc6eab5e3a7db879c-e-5" label="next-generation state-of-the-art heat-treatment facilities">
        <attvalues>
          <attvalue for="0" value="next-generation state-of-the-art heat-treatment facilities" />
          <attvalue for="1" value="Facility" />
          <attvalue for="2" value="一种面向未来的尖端热处理设施，其特点是集成先进技术与设备（如双重微观结构热处理炉），旨在通过前沿工艺实现卓越的材料性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a7d085459bd54c4dc6eab5e3a7db879c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a7d085459bd54c4dc6eab5e3a7db879c-e-5&quot;]}]" />
          <attvalue for="9" value="65" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fdfde6e5e53ab8b0bee7b6e14d3acdef-e-3" label="Scientists and engineers">
        <attvalues>
          <attvalue for="0" value="Scientists and engineers" />
          <attvalue for="1" value="Role" />
          <attvalue for="2" value="专门从事镍基高温合金材料及其相关加工工艺研究与开发的科学家和工程师。他们是推动该领域技术进步和应用发展的核心专业群体。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-fdfde6e5e53ab8b0bee7b6e14d3acdef" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fdfde6e5e53ab8b0bee7b6e14d3acdef-e-3&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-fdfde6e5e53ab8b0bee7b6e14d3acdef-e-4" label="Processing methods">
        <attvalues>
          <attvalue for="0" value="Processing methods" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="由科学家和工程师开发的一系列关键工艺方法，是确保镍基高温合金能被成功加工成功能部件，并充分发挥其优越性能的技术保障。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-fdfde6e5e53ab8b0bee7b6e14d3acdef" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-fdfde6e5e53ab8b0bee7b6e14d3acdef-e-5" label="Physical and chemical factors">
        <attvalues>
          <attvalue for="0" value="Physical and chemical factors" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="对镍基高温合金的力学性能、组织稳定性及服役寿命起决定性作用的各类物理与化学因素的总称，涵盖了成分、微观结构、温度、应力及环境等。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-fdfde6e5e53ab8b0bee7b6e14d3acdef" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0ded602080ef74e810480d8e88484e82-e-1" label="Alloys">
        <attvalues>
          <attvalue for="0" value="Alloys" />
          <attvalue for="1" value="Technical Topic" />
          <attvalue for="2" value="Alloys是一个技术主题，特指其设计过程与工艺开发、部件工程协同进行。这意味着新合金的研发与其制造工艺、最终应用的部件设计是紧密结合、相互促进的，而非孤立的环节。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-0ded602080ef74e810480d8e88484e82" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0ded602080ef74e810480d8e88484e82-e-1&quot;]}]" />
          <attvalue for="9" value="37" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0ded602080ef74e810480d8e88484e82-e-5" label="Materials engineered by man">
        <attvalues>
          <attvalue for="0" value="Materials engineered by man" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="指由人类通过科学设计与工程制造，而非自然形成的材料类别。这些材料旨在获得超越天然材料的特定性能，如更高的强度、耐用性或特定的物理化学特性。该类别范围极广，包括从合成塑料到为极端工况设计的超级合金等各种复杂材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-0ded602080ef74e810480d8e88484e82" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-22dadd8677004929f45649f589c98023-e-4" label="Alloy stability">
        <attvalues>
          <attvalue for="0" value="Alloy stability" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种材料属性，指合金在特定工作条件（如温度、应力）下，保持其原有相组成、组织结构和性能稳定的能力。这种稳定性直接影响材料的可靠性与服役寿命，例如，钌元素能显著提升某些合金的稳定性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-22dadd8677004929f45649f589c98023" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-22dadd8677004929f45649f589c98023-e-4&quot;, &quot;chunk-bd63f78238a96a3498c5ca89d8572bea-e-2&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ee8fa246fa35655243004b46a963f27f-e-2" label="Thermal Barrier Coating Systems">
        <attvalues>
          <attvalue for="0" value="Thermal Barrier Coating Systems" />
          <attvalue for="1" value="Technical System" />
          <attvalue for="2" value="热障涂层系统是一种应用于高温合金等基体表面的先进技术系统，用于在极端温度下提供隔热保护。其与基体的相容性由复杂的化学效应所决定，但这些效应的作用机理目前尚未被完全阐明。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-ee8fa246fa35655243004b46a963f27f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ee8fa246fa35655243004b46a963f27f-e-3" label="Chemical Effects">
        <attvalues>
          <attvalue for="0" value="Chemical Effects" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="一种物理现象，指在高温合金与热障涂层系统界面处，决定二者相容性的一系列复杂化学作用及其物理表现。这些效应的内在机理尚无成熟的理论解释。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-ee8fa246fa35655243004b46a963f27f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ee8fa246fa35655243004b46a963f27f-e-3&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ee8fa246fa35655243004b46a963f27f-e-4" label="Bond Coat Chemistries">
        <attvalues>
          <attvalue for="0" value="Bond Coat Chemistries" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="指热障涂层系统中关键中间层——粘结层的特定化学成分。其主要作用是增强基体与陶瓷顶涂层间的结合力，并为基体提供高温抗氧化与抗腐蚀保护。常见的成分体系包括MCrAlY合金和铝化物。" />
          <attvalue for="3" value="{&quot;optimization_status&quot;: &quot;not yet optimised&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-ee8fa246fa35655243004b46a963f27f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="363" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-ee8fa246fa35655243004b46a963f27f-e-5" label="Single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="Single-crystal superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="单晶高温合金是一种整体由单一晶粒构成、完全消除晶界的先进金属材料。由于没有晶界这一在高温下的薄弱环节，其具备卓越的高温蠕变抗力、持久强度和热疲劳性能，是制造航空发动机涡轮叶片等关键热端部件的核心材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ee8fa246fa35655243004b46a963f27f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ee8fa246fa35655243004b46a963f27f-e-7" label="Creep degradation processes">
        <attvalues>
          <attvalue for="0" value="Creep degradation processes" />
          <attvalue for="1" value="Degradation Process" />
          <attvalue for="2" value="蠕变降解过程指材料在高温和持续应力下，因微观结构演化（如筏排效应）而导致性能逐渐劣化的过程。这类现象是限制高温合金等材料服役寿命的关键因素，并直接影响其设计与开发工作。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ee8fa246fa35655243004b46a963f27f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ee8fa246fa35655243004b46a963f27f-e-7&quot;, &quot;chunk-3f4dbcf9aa48b85d20f3fbb2f49b430c-e-1&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-3f4dbcf9aa48b85d20f3fbb2f49b430c-e-2" label="Rafting effect">
        <attvalues>
          <attvalue for="0" value="Rafting effect" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="筏排效应（Rafting effect）是单晶高温合金在高温和应力作用下发生的一种微观结构演化现象。其特征是强化相γ'发生定向粗化，与基体γ相共同形成类似筏排的层状结构。该效应对合金的蠕变性能有重要影响，但其具体作用机制和效果尚存争议。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-3f4dbcf9aa48b85d20f3fbb2f49b430c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;rafting effect&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3f4dbcf9aa48b85d20f3fbb2f49b430c-e-2&quot;, &quot;chunk-25da441a3869f94baa3fcc9048297be3-e-1&quot;, &quot;chunk-8a98946fce80230f54608d957bf8fa18-e-6&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-3f4dbcf9aa48b85d20f3fbb2f49b430c-e-3" label="Creep performance of the disc alloys">
        <attvalues>
          <attvalue for="0" value="Creep performance of the disc alloys" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="盘用合金蠕变性能是指该类合金在高温和应力下抵抗缓慢永久变形的能力。它是评估航空发动机涡轮盘等关键热端部件可靠性与寿命的核心指标。目前，其深层控制因素与物理机理尚不完全明确，是材料科学领域的前沿研究课题。" />
          <attvalue for="3" value="{&quot;controlling_factors_status&quot;: &quot;largely unexplored&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-3f4dbcf9aa48b85d20f3fbb2f49b430c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="122" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3f4dbcf9aa48b85d20f3fbb2f49b430c-e-4" label="Disc alloys">
        <attvalues>
          <attvalue for="0" value="Disc alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="盘状合金是一类专为制造航空发动机和燃气轮机中的涡轮盘等高温承力部件而开发的特种合金。其核心性能是在高温和高应力环境下具有优异的抗蠕变能力，以确保部件在长期服役中的结构稳定性和可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-3f4dbcf9aa48b85d20f3fbb2f49b430c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="122" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3f4dbcf9aa48b85d20f3fbb2f49b430c-e-5" label="Superalloy development work">
        <attvalues>
          <attvalue for="0" value="Superalloy development work" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一项开发和优化高温合金的系统性过程。由于对蠕变退化等复杂物理机制的理解尚不完备，该过程在很大程度上依赖于经验性的实验方法进行材料设计、制备与性能验证。" />
          <attvalue for="3" value="{&quot;methodology&quot;: &quot;highly empirical&quot;, &quot;emphasis&quot;: &quot;trial-and-error&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3f4dbcf9aa48b85d20f3fbb2f49b430c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3f4dbcf9aa48b85d20f3fbb2f49b430c-e-5&quot;, &quot;chunk-a11b164392ee72e1727a4debab9eb766-e-1&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-3f4dbcf9aa48b85d20f3fbb2f49b430c-e-6" label="Future research">
        <attvalues>
          <attvalue for="0" value="Future research" />
          <attvalue for="1" value="Activity" />
          <attvalue for="2" value="一项旨在深入理解盘件合金蠕变性能控制因素的研究活动，其目标是为优化和提升该类合金的性能表现提供科学依据和理论指导。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-3f4dbcf9aa48b85d20f3fbb2f49b430c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="122" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a11b164392ee72e1727a4debab9eb766-e-2" label="Trial-and-error experimentation">
        <attvalues>
          <attvalue for="0" value="Trial-and-error experimentation" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="一种通过反复试验和评估结果来逐步解决问题或获得最优解的研究方法。该方法在高温合金开发等领域应用广泛，但通常被认为成本高昂且耗时较长。" />
          <attvalue for="3" value="{&quot;cost&quot;: &quot;costly&quot;, &quot;duration&quot;: &quot;time-consuming&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a11b164392ee72e1727a4debab9eb766" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a11b164392ee72e1727a4debab9eb766-e-3" label="Screening trials">
        <attvalues>
          <attvalue for="0" value="Screening trials" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="筛选试验 (Screening trials) 是一种实验方法论，旨在从大量候选材料、成分或工艺中快速评估并筛选出少数有前景的方案。该方法在高温合金的研发工作中被广泛采用，用以缩小研究范围，但其通常具有成本高昂、耗时较长的特点。" />
          <attvalue for="3" value="{&quot;cost&quot;: &quot;costly&quot;, &quot;duration&quot;: &quot;time-consuming&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a11b164392ee72e1727a4debab9eb766" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a11b164392ee72e1727a4debab9eb766-e-5" label="Superalloy metallurgists">
        <attvalues>
          <attvalue for="0" value="Superalloy metallurgists" />
          <attvalue for="1" value="Role" />
          <attvalue for="2" value="高温合金冶金学家是应用物理冶金学原理，从事高温合金设计、开发与应用的材料科学家或工程师。他们致力于调控合金的微观结构与成分，以解决材料在极端温度、应力和腐蚀环境下保持卓越机械性能与稳定性的挑战。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a11b164392ee72e1727a4debab9eb766" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="230" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a11b164392ee72e1727a4debab9eb766-e-6" label="Physical metallurgy">
        <attvalues>
          <attvalue for="0" value="Physical metallurgy" />
          <attvalue for="1" value="Field of Study" />
          <attvalue for="2" value="物理冶金学 (Physical Metallurgy) 是材料科学与工程的重要分支，主要研究金属及合金的成分、组织结构、加工工艺与其物理和力学性能之间的关系。该领域旨在揭示材料性能的内在规律，为开发和优化高性能金属材料提供理论基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a11b164392ee72e1727a4debab9eb766" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="230" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-683c24651dbc6713d385ae625ce4aa06-e-1" label="Superalloy Metallurgists">
        <attvalues>
          <attvalue for="0" value="Superalloy Metallurgists" />
          <attvalue for="1" value="Role" />
          <attvalue for="2" value="高温合金冶金学家是专门从事高温合金研究、开发、生产及应用的科学家或工程师。他们致力于提升材料在极端温度和应力下的性能，开发新型合金，以解决航空航天、能源及化工等尖端领域中面临的关键材料挑战。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-683c24651dbc6713d385ae625ce4aa06" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="364" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-683c24651dbc6713d385ae625ce4aa06-e-3" label="Quantitative Basis">
        <attvalues>
          <attvalue for="0" value="Quantitative Basis" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="**定量基础 (Quantitative Basis)** 是指在高温合金物理冶金学领域，为深化理解其性能与微观结构关系而构建的理论框架。它强调以精确的实验数据、数学模型和计算方法为核心，旨在建立一个更为坚实、可预测的研究根基，以取代传统的经验性描述。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-683c24651dbc6713d385ae625ce4aa06" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-683c24651dbc6713d385ae625ce4aa06-e-4" label="Quantitative Modelling">
        <attvalues>
          <attvalue for="0" value="Quantitative Modelling" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="一种方法论，它整合现代电子理论、位错运动动力学等基础理论与过程建模工具，旨在为高温合金的物理冶金学建立定量化的理论基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-683c24651dbc6713d385ae625ce4aa06" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-683c24651dbc6713d385ae625ce4aa06-e-5" label="Modern Electron Theory">
        <attvalues>
          <attvalue for="0" value="Modern Electron Theory" />
          <attvalue for="1" value="Scientific Theory" />
          <attvalue for="2" value="在固体物理学中，指基于量子力学解释电子行为的能带理论。该理论认为固体中电子的能级形成能带结构，并通过引入与电子相对的“空穴”作为正电荷载流子，成功阐释了导体、半导体和绝缘体的电学特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-683c24651dbc6713d385ae625ce4aa06" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;electron theory&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-683c24651dbc6713d385ae625ce4aa06-e-5&quot;, &quot;chunk-fab5556d25e36a12308d5e081229601a-e-14&quot;, &quot;chunk-13f1fdc70fe0c4a699a3307c18f29c33-e-9&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-683c24651dbc6713d385ae625ce4aa06-e-6" label="Kinetics of Dislocation Motion">
        <attvalues>
          <attvalue for="0" value="Kinetics of Dislocation Motion" />
          <attvalue for="1" value="Scientific Concept" />
          <attvalue for="2" value="位错运动动力学是一个材料科学概念，研究晶体中位错（一种线缺陷）的运动速率与机制。它揭示了材料在应力下发生塑性变形的微观过程，为定量建模以预测材料强度、蠕变等宏观力学行为提供了关键的物理基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-683c24651dbc6713d385ae625ce4aa06" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-683c24651dbc6713d385ae625ce4aa06-e-6&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-683c24651dbc6713d385ae625ce4aa06-e-7" label="Process Modelling Tools">
        <attvalues>
          <attvalue for="0" value="Process Modelling Tools" />
          <attvalue for="1" value="Tool" />
          <attvalue for="2" value="过程建模工具 (Process Modelling Tools) 是一类有助于定量建模的工具。其显著特点是模型对合金的化学成分具有高度敏感性，能将材料成分作为关键变量，纳入对工艺过程的模拟、分析与预测中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-683c24651dbc6713d385ae625ce4aa06" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-683c24651dbc6713d385ae625ce4aa06-e-10" label="Next-generation alloys">
        <attvalues>
          <attvalue for="0" value="Next-generation alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="指一类新兴的先进合金材料。其设计与开发借鉴了现有高温合金（Superalloy）的冶金学原理与知识，旨在获得超越传统材料的优异性能，以满足未来更严苛的应用需求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-683c24651dbc6713d385ae625ce4aa06" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9da63ec4314ccee7d0b95b714e1813b3-e-2" label="design of next-generation alloys">
        <attvalues>
          <attvalue for="0" value="design of next-generation alloys" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一个依赖计算硬件和建模工具的研发过程，旨在设计和开发出新型合金，以满足高温合金冶金学等前沿领域对高性能材料的需求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-9da63ec4314ccee7d0b95b714e1813b3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-9da63ec4314ccee7d0b95b714e1813b3-e-3" label="computing hardware">
        <attvalues>
          <attvalue for="0" value="computing hardware" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="计算硬件（Computing hardware）是指构成计算机系统的物理部件集合，包括中央处理器（CPU）、内存（RAM）、存储设备等。它为软件的运行提供基础平台，通过执行指令和进行高速运算，支持从日常应用到复杂的科学模拟等各类计算任务，是实现一切数字功能的物理载体。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-9da63ec4314ccee7d0b95b714e1813b3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9da63ec4314ccee7d0b95b714e1813b3-e-4" label="modelling tools">
        <attvalues>
          <attvalue for="0" value="modelling tools" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="建模工具是一种计算技术，通常指用于模拟和预测材料在不同尺度下结构、性能与行为的软件。通过构建虚拟模型，这类工具能够有效辅助科学家进行新材料的研发，尤其在加速新一代合金的设计与优化过程中发挥关键作用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-9da63ec4314ccee7d0b95b714e1813b3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9da63ec4314ccee7d0b95b714e1813b3-e-5" label="R. Schafrik">
        <attvalues>
          <attvalue for="0" value="R. Schafrik" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="R. Schafrik 是一位作者，以其撰写的文章《The saga of gas turbine materials》（燃气轮机材料的传奇）而闻名。根据现有信息，他是该领域文献的贡献者。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-9da63ec4314ccee7d0b95b714e1813b3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9da63ec4314ccee7d0b95b714e1813b3-e-5&quot;, &quot;chunk-c6e7b6a8ae77f73405b4c1cca62aa7e4-e-13&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9da63ec4314ccee7d0b95b714e1813b3-e-6" label="R. Sprague">
        <attvalues>
          <attvalue for="0" value="R. Sprague" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="R. Sprague是一位作者，作为燃气轮机材料领域的专业著作《The saga of gas turbine materials》的合著者而为人所知。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-9da63ec4314ccee7d0b95b714e1813b3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9da63ec4314ccee7d0b95b714e1813b3-e-6&quot;, &quot;chunk-c6e7b6a8ae77f73405b4c1cca62aa7e4-e-14&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9da63ec4314ccee7d0b95b714e1813b3-e-7" label="The saga of gas turbine materials">
        <attvalues>
          <attvalue for="0" value="The saga of gas turbine materials" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由R. Schafrik和R. Sprague合著的多部分系列文章，于2004年发表在期刊《先进材料与工艺》(Advanced Materials and Processes)上。该文集系统地回顾并阐述了燃气轮机材料的发展历史。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2004&quot;, &quot;parts&quot;: &quot;I, II, III&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-9da63ec4314ccee7d0b95b714e1813b3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9da63ec4314ccee7d0b95b714e1813b3-e-7&quot;, &quot;chunk-c6e7b6a8ae77f73405b4c1cca62aa7e4-e-15&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-9da63ec4314ccee7d0b95b714e1813b3-e-8" label="Advanced Materials and Processes">
        <attvalues>
          <attvalue for="0" value="Advanced Materials and Processes" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="《Advanced Materials and Processes》是由国际材料信息学会（ASM International）出版的旗舰杂志。该期刊专注于材料科学与工程领域，内容涵盖材料的加工、制造、测试及应用的实用信息，面向行业内的科学家、工程师和技术人员。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;162&quot;, &quot;issues&quot;: &quot;3, 4, 5&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-9da63ec4314ccee7d0b95b714e1813b3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9da63ec4314ccee7d0b95b714e1813b3-e-8&quot;, &quot;chunk-311ad4452372c744328957f626b3057d-e-6&quot;, &quot;chunk-c6e7b6a8ae77f73405b4c1cca62aa7e4-e-16&quot;, &quot;chunk-a584f7fe38f352b7318e0169178d3d01-e-6&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-5d1954b761cf7718ff2558f9e10a2fac-e-1" label="B. B. Seth">
        <attvalues>
          <attvalue for="0" value="B. B. Seth" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="B. B. Seth是一位学者，因其撰写的论文《Superalloys: the utility gas turbine perspective》而知名。该论文主要探讨了高温合金在公用事业燃气轮机领域的应用与前景。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-5d1954b761cf7718ff2558f9e10a2fac" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5d1954b761cf7718ff2558f9e10a2fac-e-2" label="Superalloys: the utility gas turbine perspective">
        <attvalues>
          <attvalue for="0" value="Superalloys: the utility gas turbine perspective" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由B. B. Seth撰写的科技论文，标题为《高温合金：工业燃气轮机视角》。该文探讨了高温合金材料在工业燃气轮机领域的应用与发展，并作为其中一篇被收录于论文集《Superalloys 2000》中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-5d1954b761cf7718ff2558f9e10a2fac" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-5d1954b761cf7718ff2558f9e10a2fac-e-4" label="T. M. Pollock">
        <attvalues>
          <attvalue for="0" value="T. M. Pollock" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="T. M. Pollock是一位高温合金（Superalloys）领域的专家。作为该领域的重要学者，他曾担任《Superalloys 2004》学术会议论文集的编辑之一，负责该出版物的编纂工作。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-5d1954b761cf7718ff2558f9e10a2fac" />
