      <node id="chunk-ae682ac4e4eb339bd48233482011cdd1-e-25" label="Nimonic">
        <attvalues>
          <attvalue for="0" value="Nimonic" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="尼蒙尼克合金（Nimonic alloys）是一系列镍铬基高温合金的注册商标。它通过添加钛、铝等元素形成沉淀强化相，从而具备卓越的高温强度、抗蠕变和抗氧化性能。该系列合金主要用于制造航空发动机的涡轮叶片、燃烧室等在极端高温和应力下工作的关键部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-25" />
          <attvalue for="5" value="chunk-ae682ac4e4eb339bd48233482011cdd1" />
