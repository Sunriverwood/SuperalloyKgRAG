        <attvalues>
          <attvalue for="11" value="USED_FOR" />
          <attvalue for="12" value="Waspaloy is used for turbine discs." />
          <attvalue for="13" value="Waspaloy is a polycrystalline superalloy used for the turbine discs required to house the blading." />
