        <attvalues>
          <attvalue for="11" value="IS_A" />
          <attvalue for="12" value="The term (D – d)/D is explicitly identified as a 'harmfulness criterion'." />
          <attvalue for="13" value="The term (D – d)/D should be considered to be a 'harmfulness criterion'" />
