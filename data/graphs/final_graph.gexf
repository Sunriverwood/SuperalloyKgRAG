      <node id="chunk-5e5643debeb7f102ea0f25bf148176a8-e-16" label="University College London">
        <attvalues>
          <attvalue for="0" value="University College London" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="伦敦大学学院 (University College London, UCL) 是一所位于英国伦敦的顶尖公立研究型大学，为伦敦大学联邦的创校学院。它成立于1826年，是伦敦第一所大学，也是英格兰第一所不分宗教信仰招收学生的大学，在众多世界大学排名中位居前列。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-5e5643debeb7f102ea0f25bf148176a8" />
