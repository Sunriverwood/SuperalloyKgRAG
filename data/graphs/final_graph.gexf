      <node id="chunk-8a8245180b98739270d9b9b4befedd30-e-4" label="T. C. Hufnagel">
        <attvalues>
          <attvalue for="0" value="T. C. Hufnagel" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="托德·C·赫夫纳格尔 (Todd C. Hufnagel)，美国材料科学家，约翰斯·霍普金斯大学材料科学与工程系教授。他主要研究金属玻璃、高熵合金及材料的相变行为，在马氏体相变等领域有重要学术贡献。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-8a8245180b98739270d9b9b4befedd30" />
