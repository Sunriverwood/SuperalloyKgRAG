      <node id="chunk-22f7760442ee5013f08b1b2ce224b483-e-4" label="one-course semester">
        <attvalues>
          <attvalue for="0" value="one-course semester" />
          <attvalue for="1" value="EducationalUnit" />
          <attvalue for="2" value="一个教学单元，指在单个学期内完成一门课程所需的时间周期。其课程材料的份量经设计恰好适用于此学期时长，教学活动通常包括课堂作业、习题集和设计练习等。" />
          <attvalue for="3" value="{&quot;duration&quot;: &quot;about 30 hour-long periods&quot;}" />
          <attvalue for="4" value="e-4" />
