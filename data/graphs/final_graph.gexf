      <node id="chunk-28027332c1e907d2b9fb62cbdc68fd6c-e-14" label="G. Wahl">
        <attvalues>
          <attvalue for="0" value="G. Wahl" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="G. Wahl，一位材料科学领域的研究人员。他作为合著者，发表了关于改性MCrAlY铸造材料的氧化与高温腐蚀行为的研究成果。" />
          <attvalue for="3" value="{}" />
