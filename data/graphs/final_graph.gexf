      <node id="chunk-841b2737c18dab16d8441fbf4d0199c2-e-2" label="unzipping condition">
        <attvalues>
          <attvalue for="0" value="unzipping condition" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="在生物物理学中，指DNA或RNA等双螺旋分子的两条链在热力学涨落或外力作用下发生分离或解链的物理状态。它是基因复制和转录等多种关键生命过程的基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-841b2737c18dab16d8441fbf4d0199c2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="252" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-841b2737c18dab16d8441fbf4d0199c2-e-3" label="static equilibrium">
        <attvalues>
          <attvalue for="0" value="static equilibrium" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="静力平衡是物理学中的一种状态，指物体在所有外力的作用下，其合外力与合外力矩均等于零，从而保持静止不动。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-841b2737c18dab16d8441fbf4d0199c2" />
