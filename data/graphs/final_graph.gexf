      </node>
      <node id="chunk-6dac0a4c73567f8946fa9c50957af9ca-e-11" label="G. H. Meier">
        <attvalues>
          <attvalue for="0" value="G. H. Meier" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="G. H. Meier 是一位专注于热障涂层耐久性领域的学者，他是学术论文《Mechanisms controlling the durability of thermal barrier coatings》的作者。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-6dac0a4c73567f8946fa9c50957af9ca" />
