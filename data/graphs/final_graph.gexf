        <attvalues>
          <attvalue for="11" value="INCLUDES" />
          <attvalue for="12" value="Solutioning treatment is a particularly important type of heat treatment for turbine disc alloys." />
          <attvalue for="13" value="particularly the solutioning treatment, which is carried out in the vicinity of the y' solvus." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-54d9cab0bf8e738ae99d8958ce8cd086" />
