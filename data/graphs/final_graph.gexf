        <attvalues>
          <attvalue for="11" value="IS_MORE_DAMAGING_THAN" />
          <attvalue for="12" value="A fully embedded inclusion is explicitly stated to be more damaging than a partially embedded one." />
          <attvalue for="13" value="a fully embedded inclusion is clearly more damaging than one which is only partially embedded to depth d" />
