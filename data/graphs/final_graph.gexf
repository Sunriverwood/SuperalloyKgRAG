      <node id="chunk-556781150646701ac920f4765e92b077-e-4" label="chemistry of single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="chemistry of single-crystal superalloys" />
          <attvalue for="1" value="Field of Study" />
          <attvalue for="2" value="单晶高温合金化学（chemistry of single-crystal superalloys）是研究单晶高温合金化学成分的学科领域。它通过优化和调整合金元素的种类与配比，旨在提升材料的高温强度、抗蠕变和抗氧化等关键性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-556781150646701ac920f4765e92b077" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-556781150646701ac920f4765e92b077-e-5" label="properties">
        <attvalues>
          <attvalue for="0" value="properties" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="指单晶高温合金所展现的一系列可通过优化其化学成分来获得提升的材料性能。这些性能是决定该合金在高温等严苛环境下应用表现的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-556781150646701ac920f4765e92b077" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3219701e460dd07570bedda4067e6548-e-2" label="alloy producers">
        <attvalues>
          <attvalue for="0" value="alloy producers" />
          <attvalue for="1" value="Organization Type" />
          <attvalue for="2" value="指一类通过开发和应用专有化学配方（即独特的合金成分）来生产合金的企业。这些保密的配方能赋予产品独特或优越的性能，从而帮助企业在市场中建立并维持其竞争优势。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-3219701e460dd07570bedda4067e6548" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="44" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3219701e460dd07570bedda4067e6548-e-4" label="proprietary chemistries">
        <attvalues>
          <attvalue for="0" value="proprietary chemistries" />
          <attvalue for="1" value="Technical Concept" />
          <attvalue for="2" value="一种专有的技术概念，指合金生产商等企业开发并使用的、受专利或商业秘密保护的特定合金化学成分。这些独特的配方能赋予产品特殊性能，从而帮助企业保持市场竞争优势。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-3219701e460dd07570bedda4067e6548" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="44" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-3219701e460dd07570bedda4067e6548-e-5" label="competitive advantage">
        <attvalues>
          <attvalue for="0" value="competitive advantage" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="竞争优势 (Competitive Advantage) 是指一个企业在市场竞争中，相较于其竞争对手所拥有的独特能力或条件，使其能够获得更优异的业绩。这种优势可来源于成本控制、技术、品牌或专有资源（如专有化学配方）等方面。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3219701e460dd07570bedda4067e6548" />
