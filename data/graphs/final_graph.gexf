          <attvalue for="16" value="0.004561966714539156" />
          <attvalue for="17" value="0.4027371800287235" />
        </attvalues>
      </edge>
      <edge source="chunk-0fc62816353bfe4473c22a2bef9a696b-e-1" target="chunk-aaf1405fdcaab5726ea1519f7e18e407-e-8" id="chunk-aaf1405fdcaab5726ea1519f7e18e407-r-7" weight="4.0">
        <attvalues>
          <attvalue for="11" value="DEVELOPS" />
          <attvalue for="12" value="The leading dislocation bows to develop a component of line tension." />
          <attvalue for="13" value="It must bow in order to overcome the pinning forces due to the particles, i.e. to develop a component of the line tension in a direction opposite to" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-aaf1405fdcaab5726ea1519f7e18e407" />
          <attvalue for="16" value="0.0008166483624792317" />
          <attvalue for="17" value="0.2671566556841542" />
        </attvalues>
      </edge>
      <edge source="chunk-0fc62816353bfe4473c22a2bef9a696b-e-1" target="chunk-62e0b88322cda2b3939ddacaff16f02d-e-7" id="chunk-62e0b88322cda2b3939ddacaff16f02d-r-4" weight="4.0">
        <attvalues>
          <attvalue for="11" value="HAS_RATIO" />
          <attvalue for="12" value="The ratio 2r₁/λ₁ is associated with the leading dislocation and needs to be estimated." />
          <attvalue for="13" value="The challenge therefore is to estimate the ratio 2r₁/λ₁." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-62e0b88322cda2b3939ddacaff16f02d" />
          <attvalue for="16" value="0.0008307285066599082" />
          <attvalue for="17" value="0.2671651037706626" />
        </attvalues>
      </edge>
      <edge source="chunk-0fc62816353bfe4473c22a2bef9a696b-e-1" target="chunk-62e0b88322cda2b3939ddacaff16f02d-e-5" id="chunk-2863217e233dc47e4fc60478978f8746-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="BREAKS_AWAY_FROM" />
          <attvalue for="12" value="The leading dislocation can break away or 'unzip' from a particle." />
          <attvalue for="13" value="break away or 'unzip' from a particle" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-2863217e233dc47e4fc60478978f8746" />
          <attvalue for="16" value="0.0007908347648146584" />
          <attvalue for="17" value="0.4004745008588888" />
        </attvalues>
      </edge>
      <edge source="chunk-0fc62816353bfe4473c22a2bef9a696b-e-1" target="chunk-2863217e233dc47e4fc60478978f8746-e-3" id="chunk-2863217e233dc47e4fc60478978f8746-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="BREAKS_AWAY_FROM" />
          <attvalue for="12" value="The leading dislocation specifically breaks away from point Y of the initial pinning points." />
          <attvalue for="13" value="breaks away from Y" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-2863217e233dc47e4fc60478978f8746" />
          <attvalue for="16" value="0.0008307285066599082" />
          <attvalue for="17" value="0.40049843710399596" />
        </attvalues>
      </edge>
      <edge source="chunk-0fc62816353bfe4473c22a2bef9a696b-e-1" target="chunk-2863217e233dc47e4fc60478978f8746-e-4" id="chunk-2863217e233dc47e4fc60478978f8746-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_PINNED_AT" />
          <attvalue for="12" value="After breaking away from Y, the dislocation becomes pinned at a new location, Y'." />
          <attvalue for="13" value="and becomes pinned at Y'" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-2863217e233dc47e4fc60478978f8746" />
          <attvalue for="16" value="0.0008307285066599082" />
          <attvalue for="17" value="0.40049843710399596" />
        </attvalues>
      </edge>
      <edge source="chunk-0fc62816353bfe4473c22a2bef9a696b-e-1" target="chunk-ca9e8043d267b5456310acc3e6414a07-e-11" id="chunk-2863217e233dc47e4fc60478978f8746-r-5" weight="4.0">
        <attvalues>
          <attvalue for="11" value="INFLUENCED_BY" />
          <attvalue for="12" value="The dislocation bows out into a new configuration that is compatible with the stress field." />
          <attvalue for="13" value="bowing out to another configuration compatible with the stress field" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-2863217e233dc47e4fc60478978f8746" />
          <attvalue for="17" value="0.26666666666666666" />
        </attvalues>
      </edge>
      <edge source="chunk-0fc62816353bfe4473c22a2bef9a696b-e-1" target="chunk-2863217e233dc47e4fc60478978f8746-e-7" id="chunk-2863217e233dc47e4fc60478978f8746-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="SWEEPS_OUT" />
          <attvalue for="12" value="As the dislocation moves, it sweeps out an area designated as A." />
          <attvalue for="13" value="and sweeping out an area A on the slip plane." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-2863217e233dc47e4fc60478978f8746" />
          <attvalue for="16" value="0.0016614570133198165" />
          <attvalue for="17" value="0.4009968742079919" />
        </attvalues>
      </edge>
      <edge source="chunk-0fc62816353bfe4473c22a2bef9a696b-e-1" target="chunk-04c90a85908ffdd0ad7cdb9fbce55d8b-e-7" id="chunk-2863217e233dc47e4fc60478978f8746-r-8" weight="4.0">
        <attvalues>
          <attvalue for="11" value="HAS_PROPERTY" />
          <attvalue for="12" value="The new configuration of the dislocation has a specific radius of curvature, R." />
          <attvalue for="13" value="The new configuration has a radius of curvature denoted R." />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-2863217e233dc47e4fc60478978f8746" />
          <attvalue for="16" value="0.003322914026639633" />
          <attvalue for="17" value="0.26866041508265043" />
        </attvalues>
      </edge>
      <edge source="chunk-0fc62816353bfe4473c22a2bef9a696b-e-1" target="chunk-19203bda469f6dad8b0600aecd2de043-e-3" id="chunk-19203bda469f6dad8b0600aecd2de043-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_PROPERTY" />
          <attvalue for="12" value="The leading dislocation possesses the property of curvature." />
          <attvalue for="13" value="In practice, the curvature of the leading dislocation is caused by the resistance imparted by the particles" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-19203bda469f6dad8b0600aecd2de043" />
          <attvalue for="16" value="0.0008025682182985554" />
          <attvalue for="17" value="0.40048154093097915" />
        </attvalues>
      </edge>
      <edge source="chunk-0fc62816353bfe4473c22a2bef9a696b-e-6" target="chunk-da09b64f941acad7c5dafb6cd99e1895-e-2" id="chunk-0fc62816353bfe4473c22a2bef9a696b-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="INTERSECTS" />
          <attvalue for="12" value="The second dislocation intersects the γ' particles." />
          <attvalue for="13" value="The particles intersecting the first and second dislocations are assumed to be spaced at intervals λ₁ and λ₂, respectively..." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-0fc62816353bfe4473c22a2bef9a696b" />
          <attvalue for="16" value="0.0008870490833826139" />
          <attvalue for="17" value="0.4005322294500296" />
        </attvalues>
      </edge>
      <edge source="chunk-0fc62816353bfe4473c22a2bef9a696b-e-6" target="chunk-7cf96eceef65bf46495ba2d8c36b9a73-e-5" id="chunk-70bdb361c16d13b8408a365565b5baba-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="REMOVES" />
          <attvalue for="12" value="The second dislocation is responsible for removing the Antiphase Boundary (APB)." />
          <attvalue for="13" value="The terms F₁ and F₂ are of opposite signs since the first dislocation introduces the APB, whereas the second dislocation removes it." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-70bdb361c16d13b8408a365565b5baba" />
          <attvalue for="16" value="0.0018304187434879332" />
          <attvalue for="17" value="0.4010982512460928" />
        </attvalues>
      </edge>
      <edge source="chunk-0fc62816353bfe4473c22a2bef9a696b-e-6" target="chunk-aaf1405fdcaab5726ea1519f7e18e407-e-1" id="chunk-aaf1405fdcaab5726ea1519f7e18e407-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="EXPLAINS" />
          <attvalue for="12" value="The presence of the second dislocation is thought to be the reason for the factor of ½ in the first term of Equation (2.24)." />
          <attvalue for="13" value="r of ½ in the first term of Equation (2.24) can be thought of as arising from the presence of the second dislocation." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-aaf1405fdcaab5726ea1519f7e18e407" />
          <attvalue for="16" value="2.816028836135282e-05" />
          <attvalue for="17" value="0.40001689617301683" />
        </attvalues>
      </edge>
      <edge source="chunk-0fc62816353bfe4473c22a2bef9a696b-e-7" target="chunk-be2e5714ffd15b4d499890769149ecb3-e-16" id="chunk-be2e5714ffd15b4d499890769149ecb3-r-10" weight="4.0">
        <attvalues>
          <attvalue for="11" value="RELATED_TO" />
          <attvalue for="12" value="Friedel spacing is listed as a sub-topic under the general category of strengthening effects." />
          <attvalue for="13" value="strengthening effects 73-90&#10;...&#10;Friedel spacing 77-78" />
          <attvalue for="14" value="r-10" />
          <attvalue for="15" value="chunk-be2e5714ffd15b4d499890769149ecb3" />
          <attvalue for="16" value="5.632057672270564e-05" />
          <attvalue for="17" value="0.2667004590127003" />
        </attvalues>
      </edge>
      <edge source="chunk-0fc62816353bfe4473c22a2bef9a696b-e-8" target="chunk-0fc62816353bfe4473c22a2bef9a696b-e-1" id="chunk-0fc62816353bfe4473c22a2bef9a696b-r-7" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_SPACING_FOR" />
          <attvalue for="12" value="λ₁ is the spacing interval for particles being intersected by the first dislocation." />
          <attvalue for="13" value="The particles intersecting the first and second dislocations are assumed to be spaced at intervals λ₁ and λ₂, respectively..." />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-0fc62816353bfe4473c22a2bef9a696b" />
          <attvalue for="16" value="0.0027033876826898706" />
          <attvalue for="17" value="0.40162203260961393" />
        </attvalues>
