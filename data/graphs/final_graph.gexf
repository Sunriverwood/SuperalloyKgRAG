        <attvalues>
          <attvalue for="11" value="INCREASES_PREVALENCE_OF" />
          <attvalue for="12" value="An increase in temperature leads to {001} facets becoming more common." />
          <attvalue for="13" value="as the temperature increases, {001} facets become increasingly common" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-e25c39cd8ab351fd28e0a5dbe2ae2bbd" />
