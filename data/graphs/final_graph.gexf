      </node>
      <node id="chunk-28027332c1e907d2b9fb62cbdc68fd6c-e-11" label="G. Wuest">
        <attvalues>
          <attvalue for="0" value="G. Wuest" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="G. Wuest是一位研究人员，作为科技著作《Future developments in plasma spray coating》的合著者之一，其研究领域涉及材料科学中的等离子喷涂涂层技术。" />
          <attvalue for="3" value="{}" />
