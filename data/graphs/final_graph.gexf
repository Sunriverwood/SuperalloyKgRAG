        <attvalues>
          <attvalue for="11" value="HAS_PROPERTY" />
          <attvalue for="12" value="Polycrystalline alloys possess elastic properties which are expected to be isotropic." />
          <attvalue for="13" value="For polycrystalline alloys, such as wrought superalloys or equiaxed castings, the elastic properties are expected to be isotropic and thus invariant with crystallographic orientation." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-5e30fb63f189d46677273b5c0f9ed52d" />
          <attvalue for="16" value="6.347997206881229e-05" />
          <attvalue for="17" value="0.4000380879832413" />
        </attvalues>
      </edge>
      <edge source="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-5" target="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-6" id="chunk-5e30fb63f189d46677273b5c0f9ed52d-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_DEFINED_BY" />
          <attvalue for="12" value="The condition for isotropy is defined by the equation S11 - S12 - 1/2 S44 = 0, labeled as (A9)." />
          <attvalue for="13" value="Examination of Equation (A5) reveals that the condition for isotropy is S11 - S12 - 1/2 S44 = 0 (A9)" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-5e30fb63f189d46677273b5c0f9ed52d" />
          <attvalue for="16" value="0.00010307153164296021" />
          <attvalue for="17" value="0.4000618429189858" />
        </attvalues>
      </edge>
      <edge source="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-5" target="chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-20" id="chunk-5e30fb63f189d46677273b5c0f9ed52d-r-6" weight="4.0">
        <attvalues>
          <attvalue for="11" value="RELATES_TO" />
          <attvalue for="12" value="In the case of isotropy, Young's modulus is a relevant material property." />
          <attvalue for="13" value="In this case, the Young's modulus, E, Poisson's ratio, v, and shear modulus" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-5e30fb63f189d46677273b5c0f9ed52d" />
          <attvalue for="16" value="0.00020614306328592042" />
          <attvalue for="17" value="0.26679035250463823" />
        </attvalues>
      </edge>
      <edge source="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-5" target="chunk-59efde3cc28eec2ad611a5941651c5d8-e-2" id="chunk-5e30fb63f189d46677273b5c0f9ed52d-r-7" weight="4.0">
        <attvalues>
          <attvalue for="11" value="RELATES_TO" />
          <attvalue for="12" value="In the case of isotropy, Poisson's ratio is a relevant material property." />
          <attvalue for="13" value="In this case, the Young's modulus, E, Poisson's ratio, v, and shear modulus" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-5e30fb63f189d46677273b5c0f9ed52d" />
          <attvalue for="16" value="0.00041228612657184083" />
          <attvalue for="17" value="0.2669140383426098" />
        </attvalues>
      </edge>
      <edge source="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-5" target="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-9" id="chunk-5e30fb63f189d46677273b5c0f9ed52d-r-8" weight="4.0">
        <attvalues>
          <attvalue for="11" value="RELATES_TO" />
          <attvalue for="12" value="In the case of isotropy, the shear modulus is a relevant material property." />
          <attvalue for="13" value="In this case, the Young's modulus, E, Poisson's ratio, v, and shear modulus" />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-5e30fb63f189d46677273b5c0f9ed52d" />
          <attvalue for="16" value="0.0023706452277880846" />
          <attvalue for="17" value="0.2680890538033395" />
        </attvalues>
      </edge>
      <edge source="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-9" target="chunk-7468b5a535de86347797d4977b885a9e-e-6" id="chunk-488553ca8f86a8be784d625006ec53f4-r-7" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_RECIPROCAL_OF" />
          <attvalue for="12" value="When the angle θ is 0, the shear modulus G is the reciprocal of the compliance constant S44." />
          <attvalue for="13" value="Thus, when θ = 0, G is the reciprocal of S44 and about 119 GPa." />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-488553ca8f86a8be784d625006ec53f4" />
          <attvalue for="16" value="0.012746512746512742" />
          <attvalue for="17" value="0.40764790764790765" />
        </attvalues>
      </edge>
      <edge source="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-9" target="chunk-7468b5a535de86347797d4977b885a9e-e-8" id="chunk-488553ca8f86a8be784d625006ec53f4-r-8" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_RECIPROCAL_OF" />
          <attvalue for="12" value="When the angle θ is π/4, the shear modulus G is the reciprocal of the transformed compliance constant S'44." />
          <attvalue for="13" value="When θ = π/4, G is the reciprocal of S'44" />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-488553ca8f86a8be784d625006ec53f4" />
          <attvalue for="16" value="0.002989074417645846" />
          <attvalue for="17" value="0.40179344465058753" />
        </attvalues>
      </edge>
      <edge source="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-9" target="chunk-f8de8bf5059ef35e8409c085b9ffdb42-e-4" id="chunk-f8de8bf5059ef35e8409c085b9ffdb42-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_VALUE" />
          <attvalue for="12" value="The shear modulus G is about 119 GPa when θ = 0." />
          <attvalue for="13" value="When θ = 0, G is the reciprocal of S44 and about 119 GPa." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-f8de8bf5059ef35e8409c085b9ffdb42" />
          <attvalue for="16" value="0.002886002886002886" />
          <attvalue for="17" value="0.4017316017316018" />
        </attvalues>
      </edge>
      <edge source="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-9" target="chunk-f8de8bf5059ef35e8409c085b9ffdb42-e-6" id="chunk-f8de8bf5059ef35e8409c085b9ffdb42-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_VALUE" />
          <attvalue for="12" value="The shear modulus G is about 26 GPa when θ = π/4." />
          <attvalue for="13" value="When θ = π/4, G is the reciprocal of S'44 and is about 26 GPa." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-f8de8bf5059ef35e8409c085b9ffdb42" />
          <attvalue for="16" value="0.002886002886002886" />
          <attvalue for="17" value="0.4017316017316018" />
        </attvalues>
      </edge>
      <edge source="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-9" target="chunk-f8de8bf5059ef35e8409c085b9ffdb42-e-8" id="chunk-f8de8bf5059ef35e8409c085b9ffdb42-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_VALUE" />
          <attvalue for="12" value="For isotropic, polycrystalline nickel, the value of G is determined to be about 82 GPa." />
          <attvalue for="13" value="For isotropic, polycrystalline nickel, the value of G has been determined to be about 82 GPa, not far from the numerical average of 119 GPa and 26 GPa." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-f8de8bf5059ef35e8409c085b9ffdb42" />
          <attvalue for="16" value="0.005772005772005772" />
          <attvalue for="17" value="0.40346320346320347" />
        </attvalues>
      </edge>
      <edge source="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-9" target="chunk-488553ca8f86a8be784d625006ec53f4-e-5" id="chunk-59efde3cc28eec2ad611a5941651c5d8-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CALCULATED_FROM" />
          <attvalue for="12" value="Shear modulus (G) is related to compliance components S11 and S12 by the identity 2(S11 - S12) = 1/G." />
          <attvalue for="13" value="2(S11 - S12) = 1/G" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-59efde3cc28eec2ad611a5941651c5d8" />
          <attvalue for="16" value="0.011715797430083141" />
          <attvalue for="17" value="0.40702947845804993" />
        </attvalues>
      </edge>
      <edge source="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-9" target="chunk-488553ca8f86a8be784d625006ec53f4-e-6" id="chunk-59efde3cc28eec2ad611a5941651c5d8-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CALCULATED_FROM" />
          <attvalue for="12" value="Shear modulus (G) is related to compliance components S11 and S12 by the identity 2(S11 - S12) = 1/G." />
          <attvalue for="13" value="2(S11 - S12) = 1/G" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-59efde3cc28eec2ad611a5941651c5d8" />
          <attvalue for="16" value="0.012437298151583861" />
          <attvalue for="17" value="0.4074623788909503" />
        </attvalues>
      </edge>
      <edge source="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-9" target="chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-20" id="chunk-91405e06bb69c5ec0eb63c43e028bfc6-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_CALCULATED_FROM" />
          <attvalue for="12" value="The Shear Modulus (G) is calculated from Young's Modulus (E) using the identity G = E/(2(1 + v))." />
          <attvalue for="13" value=", for example, via identities such as G = E/(2(1 + v))." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-91405e06bb69c5ec0eb63c43e028bfc6" />
          <attvalue for="16" value="0.0035044320758606472" />
          <attvalue for="17" value="0.4021026592455164" />
        </attvalues>
      </edge>
      <edge source="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-9" target="chunk-59efde3cc28eec2ad611a5941651c5d8-e-2" id="chunk-91405e06bb69c5ec0eb63c43e028bfc6-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_CALCULATED_FROM" />
          <attvalue for="12" value="The Shear Modulus (G) is calculated from Poisson's Ratio (v) using the identity G = E/(2(1 + v))." />
          <attvalue for="13" value=", for example, via identities such as G = E/(2(1 + v))." />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-91405e06bb69c5ec0eb63c43e028bfc6" />
          <attvalue for="16" value="0.0016491445062873633" />
          <attvalue for="17" value="0.40098948670377244" />
        </attvalues>
      </edge>
      <edge source="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-9" target="chunk-fd08a4d01f900e8f06f5ce2b9d625965-e-6" id="chunk-88fbc7a52ff45f9431f17e23dd2d49a1-r-7" weight="4.0">
        <attvalues>
          <attvalue for="11" value="IS_VARIABLE_IN" />
          <attvalue for="12" value="G is a quantity used in Equation (2.29)." />
          <attvalue for="13" value="It is instructive to introduce some numbers for the quantities in Equation (2.29). With γAPB ~ 0.1 J/m², f = 0.3, r = 25 nm, G = 80 GPa..." />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-88fbc7a52ff45f9431f17e23dd2d49a1" />
          <attvalue for="17" value="0.26666666666666666" />
        </attvalues>
      </edge>
      <edge source="chunk-59efde3cc28eec2ad611a5941651c5d8-e-2" target="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-9" id="chunk-59efde3cc28eec2ad611a5941651c5d8-r-10" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_INTERDEPENDENT_WITH" />
          <attvalue for="12" value="Among Young's modulus (E), Poisson's ratio (v), and Shear modulus (G), only two are independent, and the third can be calculated from the other two." />
          <attvalue for="13" value="only two of E, v and G are independent; the third can be calculated from a knowledge of the other two" />
          <attvalue for="14" value="r-10" />
          <attvalue for="15" value="chunk-59efde3cc28eec2ad611a5941651c5d8" />
          <attvalue for="16" value="0.03475228475228476" />
          <attvalue for="17" value="0.42085137085137087" />
        </attvalues>
      </edge>
      <edge source="chunk-59efde3cc28eec2ad611a5941651c5d8-e-2" target="chunk-bf602d6d22c552a1206d1179123ca1f7-e-7" id="chunk-bf602d6d22c552a1206d1179123ca1f7-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_PROPERTY_OF" />
          <attvalue for="12" value="ν is the Poisson's ratio of the TBC." />
          <attvalue for="13" value="where E and v are the Young's modulus and Poisson's ratio of the TBC, respectively" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-bf602d6d22c552a1206d1179123ca1f7" />
          <attvalue for="16" value="0.0027829313543599257" />
          <attvalue for="17" value="0.40166975881261596" />
        </attvalues>
      </edge>
      <edge source="chunk-59efde3cc28eec2ad611a5941651c5d8-e-2" target="chunk-3b4a29632c8b1d02d0265d40c4880791-e-2" id="chunk-3b4a29632c8b1d02d0265d40c4880791-r-9" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_PROPERTY_OF" />
          <attvalue for="12" value="ν₀ is the Poisson's ratio of the coating." />
          <attvalue for="13" value="and E₀ and ν₀ are the Young's modulus and Poisson's ratio of the coating, respectively." />
          <attvalue for="14" value="r-9" />
          <attvalue for="15" value="chunk-3b4a29632c8b1d02d0265d40c4880791" />
          <attvalue for="16" value="0.0037105751391465673" />
          <attvalue for="17" value="0.402226345083488" />
        </attvalues>
      </edge>
      <edge source="chunk-91405e06bb69c5ec0eb63c43e028bfc6-e-1" target="chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-20" id="chunk-91405e06bb69c5ec0eb63c43e028bfc6-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_PROPERTY" />
          <attvalue for="12" value="Polycrystalline nickel has a measured Young's Modulus (E) of 207 GPa at room temperature." />
          <attvalue for="13" value="Measurements on polycrystalline nickel at room temperature have yielded E = 207 GPa, v = 0.26, and thus G = 82 GPa." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-91405e06bb69c5ec0eb63c43e028bfc6" />
          <attvalue for="16" value="0.00020614306328592042" />
          <attvalue for="17" value="0.4001236858379716" />
        </attvalues>
      </edge>
      <edge source="chunk-91405e06bb69c5ec0eb63c43e028bfc6-e-1" target="chunk-59efde3cc28eec2ad611a5941651c5d8-e-2" id="chunk-91405e06bb69c5ec0eb63c43e028bfc6-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_PROPERTY" />
          <attvalue for="12" value="Polycrystalline nickel has a measured Poisson's Ratio (v) of 0.26 at room temperature." />
          <attvalue for="13" value="Measurements on polycrystalline nickel at room temperature have yielded E = 207 GPa, v = 0.26, and thus G = 82 GPa." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-91405e06bb69c5ec0eb63c43e028bfc6" />
          <attvalue for="16" value="0.00041228612657184083" />
          <attvalue for="17" value="0.40024737167594315" />
        </attvalues>
      </edge>
      <edge source="chunk-91405e06bb69c5ec0eb63c43e028bfc6-e-1" target="chunk-5e30fb63f189d46677273b5c0f9ed52d-e-9" id="chunk-91405e06bb69c5ec0eb63c43e028bfc6-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_PROPERTY" />
          <attvalue for="12" value="Polycrystalline nickel has a calculated Shear Modulus (G) of 82 GPa at room temperature." />
          <attvalue for="13" value="Measurements on polycrystalline nickel at room temperature have yielded E = 207 GPa, v = 0.26, and thus G = 82 GPa." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-91405e06bb69c5ec0eb63c43e028bfc6" />
          <attvalue for="16" value="0.0023706452277880846" />
