      <node id="chunk-3830758e4d7db91f7cb5dcf87141ced7-e-3" label="High-temperature materials">
        <attvalues>
          <attvalue for="0" value="High-temperature materials" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="高温材料 (High-temperature material) 指以高同系温度（τ，即工作温度与熔点之比）为分类依据的一类材料。它们能在接近自身熔点的温度下，长期抵抗蠕变等机械降解。因此，“高温”是一个相对概念，例如，冰在接近其熔点时也属于高温材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-3830758e4d7db91f7cb5dcf87141ced7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;High-temperature material&quot;, &quot;high temperature materials&quot;, &quot;high-temperature materials&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3830758e4d7db91f7cb5dcf87141ced7-e-3&quot;, &quot;chunk-a7dd82186838be32042dd4be6ec7b385-e-1&quot;, &quot;chunk-d5ce586afcf8fd710ae4779854d26909-e-11&quot;, &quot;chunk-19e6563f4b098e6973872824ea3f1dec-e-1&quot;, &quot;chunk-f23239a1bb5839c40c8b54140289d1ce-e-7&quot;, &quot;chunk-569a3d8aec20d9df6a256b4cf4b263a7-e-18&quot;, &quot;chunk-86425bad56c0d52ed7246eff0fe06dd8-e-3&quot;, &quot;chunk-966af38b21cd6fefe9490e0dc9e97393-e-1&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="15" />
        </attvalues>
      </node>
      <node id="chunk-3830758e4d7db91f7cb5dcf87141ced7-e-4" label="remarkable ability">
        <attvalues>
          <attvalue for="0" value="remarkable ability" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="一种特定类型材料（如高温材料）所具备的显著特性或优越性能。它是一种使该材料区别于其他材料的关键属性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-3830758e4d7db91f7cb5dcf87141ced7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a7dd82186838be32042dd4be6ec7b385-e-3" label="Turbines">
        <attvalues>
          <attvalue for="0" value="Turbines" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮机是一种旋转动力机械，能将流体的能量转化为有用的机械功。作为航空发动机、燃气轮机等热机设备的核心部件，其叶片等关键组件因需承受极端高温高压环境，必须采用特种耐高温材料制造。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a7dd82186838be32042dd4be6ec7b385" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a7dd82186838be32042dd4be6ec7b385-e-4" label="Rockets">
        <attvalues>
          <attvalue for="0" value="Rockets" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="火箭（Rockets）是一种利用喷射工质产生反作用力推进的飞行器。由于其发动机在工作时需承受燃料燃烧产生的极端高温与高压，因此喷管、燃烧室等核心组件必须采用特种耐高温材料制造，以确保结构稳定和运行安全。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a7dd82186838be32042dd4be6ec7b385" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a7dd82186838be32042dd4be6ec7b385-e-5" label="Heat exchangers">
        <attvalues>
          <attvalue for="0" value="Heat exchangers" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="换热器是在不同温度的两种或多种流体间传递热量的设备。它通过将热量从高温流体传递给低温流体，来实现加热或冷却等工艺目的，是工业生产中常见的节能部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a7dd82186838be32042dd4be6ec7b385" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a7dd82186838be32042dd4be6ec7b385-e-6" label="Performance characteristics">
        <attvalues>
          <attvalue for="0" value="Performance characteristics" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="指系统或组件在特定工作条件下的一组可衡量表现（如效率、功率、推力）。其性能极限由构成材料的物理耐受性（如耐温、耐压等）所决定和制约。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a7dd82186838be32042dd4be6ec7b385" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a7dd82186838be32042dd4be6ec7b385-e-7" label="Operating conditions">
        <attvalues>
          <attvalue for="0" value="Operating conditions" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="操作条件 (Operating conditions) 指决定一个系统或过程所处环境的一系列外部参数。它通过直接决定系统所经历的温度，进而影响最终结果的利弊。在材料科学等领域中，等温蠕变条件是其一种代表性的具体实例。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a7dd82186838be32042dd4be6ec7b385" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a7dd82186838be32042dd4be6ec7b385-e-7&quot;, &quot;chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc-e-3&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-f23239a1bb5839c40c8b54140289d1ce-e-1" label="Modern aeroengine">
        <attvalues>
          <attvalue for="0" value="Modern aeroengine" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="现代航空发动机是一种为航空器提供动力的先进燃气涡轮发动机。其核心发展趋势和主要特征是不断提高关键性能参数“涡轮前进口温度”（TET），以追求更高的推力、效率和性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-f23239a1bb5839c40c8b54140289d1ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;modern aeroengine&quot;, &quot;modern aeroengines&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f23239a1bb5839c40c8b54140289d1ce-e-1&quot;, &quot;chunk-e7b8406b8d85a1255a692ddd5452a482-e-8&quot;, &quot;chunk-f5c07b55f3d29bb402b546962b69a445-e-6&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f23239a1bb5839c40c8b54140289d1ce-e-4" label="High-temperature strength">
        <attvalues>
          <attvalue for="0" value="High-temperature strength" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**高温强度** (High-temperature strength)&#10;&#10;指材料在高温环境下抵抗外力作用而不发生塑性变形或断裂的能力。它是一项衡量材料热稳定性的关键物理性能指标，其高低直接影响合金等材料的蠕变抗力与持久断裂寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f23239a1bb5839c40c8b54140289d1ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;high-temperature strength&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f23239a1bb5839c40c8b54140289d1ce-e-4&quot;, &quot;chunk-c8bfe4fa64e107ddff8d923b426a8333-e-4&quot;, &quot;chunk-738d5a08a05f18670227192d3b2434f7-e-1&quot;, &quot;chunk-78865a21d21766b0dd173d92dcbbfc0d-e-7&quot;, &quot;chunk-b38b75a018fa569ff580b1d94d62395d-e-4&quot;, &quot;chunk-dc4fc8b9731ff54ceedadcde2ec92655-e-8&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f23239a1bb5839c40c8b54140289d1ce-e-5" label="Nickel-based superalloys">
        <attvalues>
          <attvalue for="0" value="Nickel-based superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍基高温合金是一种以镍为基体的合金材料，以其卓越的高温强度、抗蠕变和抗氧化性能而著称。它们是制造航空发动机、燃气轮机等装备最热部件（如涡轮叶片、燃烧室）的关键结构材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-f23239a1bb5839c40c8b54140289d1ce" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f23239a1bb5839c40c8b54140289d1ce-e-8" label="Loading">
        <attvalues>
          <attvalue for="0" value="Loading" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="指高温材料在特定工作温度下运行时，所必须承受的机械应力。它是一种关键的工况条件，直接影响材料的性能、寿命及可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-f23239a1bb5839c40c8b54140289d1ce" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f23239a1bb5839c40c8b54140289d1ce-e-9" label="Operating temperature">
        <attvalues>
          <attvalue for="0" value="Operating temperature" />
          <attvalue for="1" value="Physical Parameter" />
          <attvalue for="2" value="工作温度 (Operating temperature) 指材料在承受机械载荷时所处的特定温度。作为材料科学中的一个关键物理量，它是定义和计算同系温度的基础，用以评估材料在高温下的蠕变等力学行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-f23239a1bb5839c40c8b54140289d1ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Operating temperatures&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c00332837c903107811c26a0dceec5be-e-3&quot;, &quot;chunk-f23239a1bb5839c40c8b54140289d1ce-e-9&quot;, &quot;chunk-44ba0b547d89e889a875ab5cd81995c8-e-2&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-f23239a1bb5839c40c8b54140289d1ce-e-10" label="Melting point">
        <attvalues>
          <attvalue for="0" value="Melting point" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="熔点（melting point）是物质由固态转变为液态时的特征温度，是一种材料的物理性质。在特定压力下，纯净晶体物质的熔点是固定的，且与其凝固点相同。物质的组分（如合金添加物）会影响该数值，并常导致其在一个温度范围内熔化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-f23239a1bb5839c40c8b54140289d1ce" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Melting temperature&quot;, &quot;Melting temperatures&quot;, &quot;melting point&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f23239a1bb5839c40c8b54140289d1ce-e-10&quot;, &quot;chunk-44ba0b547d89e889a875ab5cd81995c8-e-3&quot;, &quot;chunk-0d8b8971d722c099aa85646d423e67e5-e-8&quot;, &quot;chunk-f76ae1d909a43808db3e1dc38409d881-e-3&quot;, &quot;chunk-1159c2afbaaccc92d505d71fb856dee1-e-8&quot;, &quot;chunk-3b4422ce09cd66eaf6abd58690d6f8ef-e-11&quot;, &quot;chunk-951c3bbe670e3cf4f0dc7a8bc55e7730-e-8&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-44ba0b547d89e889a875ab5cd81995c8-e-1" label="Homologous temperature">
        <attvalues>
          <attvalue for="0" value="Homologous temperature" />
          <attvalue for="1" value="Criterion" />
          <attvalue for="2" value="同系温度（Homologous Temperature）是材料科学中的一个无量纲参数，定义为材料所处的绝对温度（T）与其绝对熔点（Tm）的比值。它通过对温度进行归一化，用于评估和比较不同材料在相似热力学状态下的力学性能，如蠕变、再结晶等热激活行为。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;τ&quot;, &quot;formula&quot;: &quot;Toper/Tm&quot;, &quot;threshold&quot;: &quot;&gt; 0.6&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-44ba0b547d89e889a875ab5cd81995c8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Homologous Temperature&quot;, &quot;Homologous temperature (T/Tm)&quot;, &quot;Homologous temperature (τ)&quot;, &quot;homologous temperature&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-44ba0b547d89e889a875ab5cd81995c8-e-1&quot;, &quot;chunk-966af38b21cd6fefe9490e0dc9e97393-e-3&quot;, &quot;chunk-86425bad56c0d52ed7246eff0fe06dd8-e-7&quot;, &quot;chunk-3b4422ce09cd66eaf6abd58690d6f8ef-e-14&quot;, &quot;chunk-8981e8877dd5635849029e4451056d6d-e-6&quot;, &quot;chunk-ebfa8b7ae005eda909fbe4d14158391d-e-1&quot;, &quot;chunk-5b67fbff0206633355ba0e17d910b688-e-2&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-44ba0b547d89e889a875ab5cd81995c8-e-4" label="High-temperature material">
        <attvalues>
          <attvalue for="0" value="High-temperature material" />
          <attvalue for="1" value="Material Classification" />
          <attvalue for="2" value="高温材料指在较高同系温度（通常大于0.6）下使用的材料分类。同系温度是材料工作温度与其绝对熔点的比值，故此定义是相对的。它既包括了喷气发动机中使用的高温合金，也包括了接近其熔点时（0℃）的冰。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-44ba0b547d89e889a875ab5cd81995c8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-44ba0b547d89e889a875ab5cd81995c8-e-7" label="Ice">
        <attvalues>
          <attvalue for="0" value="Ice" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="冰是水在低温下形成的固态结晶体。通常指标准大气压下0°C及以下存在的普通冰（冰Ih），但在极高压力等特定物理条件下，存在多种可在室温甚至更高温度下稳定存在的“热冰”同质异形体，因此在特定科学语境中可被视为一种高温材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-44ba0b547d89e889a875ab5cd81995c8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-44ba0b547d89e889a875ab5cd81995c8-e-7&quot;, &quot;chunk-966af38b21cd6fefe9490e0dc9e97393-e-2&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-966af38b21cd6fefe9490e0dc9e97393-e-4" label="Mechanical degradation">
        <attvalues>
          <attvalue for="0" value="Mechanical degradation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="指材料在应力、应变、摩擦等机械载荷的持续作用下，其力学性能和结构完整性逐渐劣化并最终失效的过程。这种现象在高温和长时间服役的工况下尤为显著，是关键的材料失效模式之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-966af38b21cd6fefe9490e0dc9e97393" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-966af38b21cd6fefe9490e0dc9e97393-e-4&quot;, &quot;chunk-d6bdb664cd0308fc87bae418c9eaeb6d-e-3&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-966af38b21cd6fefe9490e0dc9e97393-e-5" label="Creep">
        <attvalues>
          <attvalue for="0" value="Creep" />
          <attvalue for="1" value="Material Phenomenon" />
          <attvalue for="2" value="蠕变是一种材料属性，指材料在恒定应力（通常低于其屈服强度）和高温作用下，随时间发生缓慢且持续塑性变形的倾向。对于高温合金而言，抗蠕变性能是其在航空发动机等严苛环境中保持结构稳定性和可靠性的关键指标。" />
          <attvalue for="3" value="{&quot;is_time_dependent&quot;: &quot;true&quot;, &quot;is_inelastic&quot;: &quot;true&quot;, &quot;is_irrecoverable&quot;: &quot;true&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-966af38b21cd6fefe9490e0dc9e97393" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;creep&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-966af38b21cd6fefe9490e0dc9e97393-e-5&quot;, &quot;chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-1&quot;, &quot;chunk-c66ff8a529b9512996f0b3af456f00ce-e-8&quot;, &quot;chunk-f1dbde91fa2668ef8c190d0d43e91e27-e-2&quot;, &quot;chunk-11fd3f8dd428533f2dacdd280d5458c0-e-9&quot;, &quot;chunk-12abccc567e86807dfdcf4f2bea50424-e-6&quot;, &quot;chunk-476c99d22cc46115c3dc1dca1b6b4708-e-8&quot;, &quot;chunk-e0ff1a8ba2325330670b26bb64b4b73d-e-2&quot;, &quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-16&quot;, &quot;chunk-c8fee299c7ba0eef0fb9057ffd13203c-e-7&quot;, &quot;chunk-52c2368c38f01bd3aedce678a81a8dc2-e-5&quot;, &quot;chunk-466225ab73e7ea49ac0af36e5725c4c1-e-11&quot;, &quot;chunk-6961c93f48e22019dc09686be94a57fd-e-3&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="10" />
        </attvalues>
      </node>
      <node id="chunk-966af38b21cd6fefe9490e0dc9e97393-e-6" label="Thermally activated processes">
        <attvalues>
          <attvalue for="0" value="Thermally activated processes" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="一种物理过程，其发生和速率由温度决定。该过程需要原子或分子获得足够的热能（激活能）来克服能垒，从而引发状态变化。它在材料科学中是导致蠕变等现象的根本机制，通常在较高的同源温度下变得显著。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-966af38b21cd6fefe9490e0dc9e97393" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-966af38b21cd6fefe9490e0dc9e97393-e-6&quot;, &quot;chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-2&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-3" label="High τ">
        <attvalues>
          <attvalue for="0" value="High τ" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="高τ (High τ) 是一种能促进热激活过程的物理条件。它通常指高温或高应力环境，该环境能为材料内部的原子扩散、位错运动等过程提供足够能量或降低其活化能垒，从而加速这些过程的进行。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-dedf3a2aead3b83be780a9b424cfc9e5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-4" label="Creep strain (εcreep)">
        <attvalues>
          <attvalue for="0" value="Creep strain (εcreep)" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="蠕变应变(ε_creep)是一种材料属性，指材料在恒定应力（尤其在高温下）作用下，随时间推移而缓慢且持续累积的塑性应变。它反映了材料因时间效应而产生的永久变形。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-dedf3a2aead3b83be780a9b424cfc9e5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-4&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-5" label="Creep accumulation rate (ε̇creep)">
        <attvalues>
          <attvalue for="0" value="Creep accumulation rate (ε̇creep)" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="蠕变累积速率 (ε̇creep) 是一项关键材料属性，指材料在持续应力（尤其在高温下）作用时，其蠕变应变随时间增长的速度。该速率是衡量材料长期尺寸稳定性和抗蠕变性能的重要指标，其数值越低，代表材料的抗蠕变性越好。" />
          <attvalue for="3" value="{&quot;desirable_value&quot;: &quot;low&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-dedf3a2aead3b83be780a9b424cfc9e5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-5&quot;]}]" />
          <attvalue for="9" value="257" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-6" label="Structural materials">
        <attvalues>
          <attvalue for="0" value="Structural materials" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="结构材料是指主要用于承受和传递载荷，并以强度、韧性和刚度等静态力学性能作为关键设计依据的一类材料，常用于建筑、桥梁、机械和车辆等承力构件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-dedf3a2aead3b83be780a9b424cfc9e5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-7" label="Static properties">
        <attvalues>
          <attvalue for="0" value="Static properties" />
          <attvalue for="1" value="Property Category" />
          <attvalue for="2" value="静态性能 (Static properties) 是一类重要的材料力学属性，用于衡量材料在静态载荷下的行为。它主要包括屈服强度、极限抗拉强度和断裂韧性等，是评估结构材料在长期服役中保持其可靠性的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-dedf3a2aead3b83be780a9b424cfc9e5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-7&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-8" label="Yield stress">
        <attvalues>
          <attvalue for="0" value="Yield stress" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="屈服强度是一项关键的材料力学性能，指材料从弹性变形过渡到塑性（永久）变形的临界应力值。当外加应力超过此值，材料将产生不可恢复的永久形变。它是衡量材料抵抗塑性变形能力的指标，也是区分材料弹、塑性行为的界限。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-dedf3a2aead3b83be780a9b424cfc9e5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Yield Stress&quot;, &quot;yield stress&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-8&quot;, &quot;chunk-b90feda161b295cfb50134cb85d41526-e-7&quot;, &quot;chunk-0659b62691281fc5f1e0a0636a9eb57b-e-6&quot;, &quot;chunk-740f6c1fef49d66e9d25ef0e2de914da-e-5&quot;, &quot;chunk-127ccac0bbb9a57ea78fa0e8276b38f5-e-7&quot;, &quot;chunk-6b0fd58b99d0490b98efe29e49c3ef5d-e-5&quot;, &quot;chunk-d9d4e9c6bdfb7df170a8302da4a9bf0c-e-4&quot;, &quot;chunk-d4529d405393ac6d501a33e3c215f2a0-e-7&quot;, &quot;chunk-2457bc4af0771717326f8f8489539e06-e-9&quot;, &quot;chunk-cd3d94aa060b9f37ed32a3ea4c0d3fe6-e-9&quot;, &quot;chunk-db2933278c73b52c5d13817164ccc262-e-4&quot;, &quot;chunk-c2b78e8b376569da6104df59fa66c5ca-e-6&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-10" label="Fracture toughness">
        <attvalues>
          <attvalue for="0" value="Fracture toughness" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="断裂韧性（Fracture toughness）是一项衡量含裂纹材料抵抗裂纹失稳扩展能力的固有静态属性。它量化了裂纹尖端在发生脆性断裂前所能承受的临界应力强度，是评估结构材料安全性和可靠性的关键力学性能指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-dedf3a2aead3b83be780a9b424cfc9e5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-10&quot;, &quot;chunk-84f8e7f39bc8df67a9604e9a01eac9a9-e-5&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-dedf3a2aead3b83be780a9b424cfc9e5-e-11" label="Time">
        <attvalues>
          <attvalue for="0" value="Time" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="在材料科学中，时间是一个关键物理量，在此期间材料的蠕变应变会逐渐累积，同时其静态性能必须保持稳定。它被用作衡量材料长期性能和耐久性的一个重要尺度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-dedf3a2aead3b83be780a9b424cfc9e5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d295b951c69c1dd13ab761ee6a3d62fe-e-1" label="Severe operating environments">
        <attvalues>
          <attvalue for="0" value="Severe operating environments" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="严酷运行环境是指材料、部件或系统在运行时所必须承受的极端物理与化学条件，如高温、高压、强腐蚀、高应力等。这类环境对材料性能和设备可靠性构成严峻挑战，常见于航空发动机、燃气轮机等先进技术领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-d295b951c69c1dd13ab761ee6a3d62fe" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Demanding operating conditions&quot;, &quot;Extreme operating conditions&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d295b951c69c1dd13ab761ee6a3d62fe-e-1&quot;, &quot;chunk-556d820ddbae9c9c730e555ef87312a3-e-2&quot;, &quot;chunk-0911f0446e7a84e6ad1cfebbf249a936-e-9&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-d295b951c69c1dd13ab761ee6a3d62fe-e-2" label="Coal-fired electricity-generating turbine">
        <attvalues>
          <attvalue for="0" value="Coal-fired electricity-generating turbine" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="一种将煤炭燃烧产生的热能转化为电能的核心动力设备。它通过高温高压气体驱动涡轮机旋转，带动发电机发电。因其工作时会产生高腐蚀性热气，故属于在严酷环境下运行的设备。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-d295b951c69c1dd13ab761ee6a3d62fe" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d295b951c69c1dd13ab761ee6a3d62fe-e-3" label="Hot gases">
        <attvalues>
          <attvalue for="0" value="Hot gases" />
          <attvalue for="1" value="Substance" />
          <attvalue for="2" value="燃煤发电涡轮机中产生的高温气体。因其燃烧产物中含硫量高，该气体具有强腐蚀性，会对设备造成损害。" />
          <attvalue for="3" value="{&quot;state&quot;: &quot;highly corrosive&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d295b951c69c1dd13ab761ee6a3d62fe" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d295b951c69c1dd13ab761ee6a3d62fe-e-4" label="High sulphur levels">
        <attvalues>
          <attvalue for="0" value="High sulphur levels" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="指燃煤涡轮机装料（燃料）中硫元素浓度较高的特性。该特性是导致燃料燃烧时所产生的高温气体具有强腐蚀性的直接原因，进而可能对设备造成损害。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d295b951c69c1dd13ab761ee6a3d62fe" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d295b951c69c1dd13ab761ee6a3d62fe-e-5" label="Charge">
        <attvalues>
          <attvalue for="0" value="Charge" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="指用作燃煤涡轮机输入原料的特定材料，其作为燃料或反应物，显著特征是含有高浓度的硫。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d295b951c69c1dd13ab761ee6a3d62fe" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d295b951c69c1dd13ab761ee6a3d62fe-e-6" label="Kerosene">
        <attvalues>
          <attvalue for="0" value="Kerosene" />
          <attvalue for="1" value="Fuel" />
          <attvalue for="2" value="煤油是一种通过分馏石油获得的可燃碳氢化合物液体。作为一种重要燃料，它被广泛用于航空（喷气燃料）、家庭供暖和照明（如煤油灯）。根据其来源和提炼过程，煤油中可能含有钒等杂质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-d295b951c69c1dd13ab761ee6a3d62fe" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d295b951c69c1dd13ab761ee6a3d62fe-e-6&quot;, &quot;chunk-c527d2fb17717642598fb40a49925e7f-e-7&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d295b951c69c1dd13ab761ee6a3d62fe-e-7" label="Aeroengine fuel">
        <attvalues>
          <attvalue for="0" value="Aeroengine fuel" />
          <attvalue for="1" value="Fuel Type" />
          <attvalue for="2" value="航空燃料（Aeroengine Fuel）是为航空发动机提供动力的专用燃料。它是一类由石油提炼的特种燃料，最常见的类型是用于喷气式发动机的航空煤油（Kerosene）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d295b951c69c1dd13ab761ee6a3d62fe" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d295b951c69c1dd13ab761ee6a3d62fe-e-8" label="Corrosion">
        <attvalues>
          <attvalue for="0" value="Corrosion" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="腐蚀是指材料（尤指金属）因与所处环境发生化学或电化学反应而引起的破坏和变质过程。它可在酸性、碱性、高温及熔盐等多种条件下发生，具体类型包括硫化腐蚀、高温腐蚀（Type I）和低温腐蚀（Type II）等。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-d295b951c69c1dd13ab761ee6a3d62fe" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;corrosion&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d295b951c69c1dd13ab761ee6a3d62fe-e-8&quot;, &quot;chunk-7ed243e6959c94b94bb486912a18f1db-e-5&quot;, &quot;chunk-04fc5332fa43dcac6331c45b022dd378-e-4&quot;, &quot;chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-17&quot;, &quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-4&quot;, &quot;chunk-3b4422ce09cd66eaf6abd58690d6f8ef-e-7&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="11" />
        </attvalues>
      </node>
      <node id="chunk-d295b951c69c1dd13ab761ee6a3d62fe-e-9" label="Potassium salts">
        <attvalues>
          <attvalue for="0" value="Potassium salts" />
          <attvalue for="1" value="Impurity" />
          <attvalue for="2" value="钾盐是作为杂质存在于燃料中的一类无机盐。在燃烧过程中，它们会转变为熔融态或气态，沉积在设备金属表面，是引发高温腐蚀和材料损坏的关键有害物质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-d295b951c69c1dd13ab761ee6a3d62fe" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d295b951c69c1dd13ab761ee6a3d62fe-e-10" label="Sea-water">
        <attvalues>
          <attvalue for="0" value="Sea-water" />
          <attvalue for="1" value="Substance" />
          <attvalue for="2" value="海水是海洋中的天然水体，为含有多种盐分的电解质溶液。其高含盐量和氯离子使其对大多数金属具有强烈的腐蚀性，是工业设备腐蚀的常见原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-d295b951c69c1dd13ab761ee6a3d62fe" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d295b951c69c1dd13ab761ee6a3d62fe-e-11" label="High operating temperatures">
        <attvalues>
          <attvalue for="0" value="High operating temperatures" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="**高工作温度 (high operating temperatures)**&#10;&#10;指设备或系统在较高温度下运行的工作状态。这种条件会显著加速氧化反应，通常导致材料降解、部件腐蚀或使用寿命缩短。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-d295b951c69c1dd13ab761ee6a3d62fe" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;high operating temperatures&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d295b951c69c1dd13ab761ee6a3d62fe-e-11&quot;, &quot;chunk-fcad8253b31b7c7ba59fbae2ee05b446-e-2&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-fcad8253b31b7c7ba59fbae2ee05b446-e-1" label="sea-water">
        <attvalues>
          <attvalue for="0" value="sea-water" />
          <attvalue for="1" value="Environmental Contaminant" />
          <attvalue for="2" value="海水 (sea-water)：一种环境污染物，特指在特定作业或设备运行过程中，被意外摄入系统内部的海水。它的进入会造成污染，可能导致设备损坏或流程异常。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-fcad8253b31b7c7ba59fbae2ee05b446" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="149" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fcad8253b31b7c7ba59fbae2ee05b446-e-3" label="Oxidation">
        <attvalues>
          <attvalue for="0" value="Oxidation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="氧化是一种化学过程，特指材料（如镍基高温合金）在高温下与环境反应形成氧化物。其具体类型包括高温、循环、内部及选择性氧化。该过程受涂层保护以及钇、稀土、硫、铂等元素显著影响，是决定材料服役性能与寿命的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-fcad8253b31b7c7ba59fbae2ee05b446" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;oxidation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fcad8253b31b7c7ba59fbae2ee05b446-e-3&quot;, &quot;chunk-7ed243e6959c94b94bb486912a18f1db-e-4&quot;, &quot;chunk-1a10b9ced7aeca4719469cc8e85d9ba9-e-3&quot;, &quot;chunk-751499c91bd84a08839fce6991037b26-e-8&quot;, &quot;chunk-04fc5332fa43dcac6331c45b022dd378-e-3&quot;, &quot;chunk-2dc25af7062fe95786ac7680318cbe70-e-2&quot;, &quot;chunk-fbbf41abcd4950c59415caeec768db40-e-11&quot;, &quot;chunk-e039cb317db23e5137b0d2d1164a7ea9-e-3&quot;, &quot;chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-10&quot;, &quot;chunk-3b4422ce09cd66eaf6abd58690d6f8ef-e-9&quot;, &quot;chunk-64f0b642dc984a92646a132ee856bc18-e-15&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="16" />
        </attvalues>
      </node>
      <node id="chunk-fcad8253b31b7c7ba59fbae2ee05b446-e-4" label="surface degradation">
        <attvalues>
          <attvalue for="0" value="surface degradation" />
          <attvalue for="1" value="Degradation Process" />
          <attvalue for="2" value="表面退化是指材料表面因磨损、腐蚀、疲劳或环境因素作用，导致其物理化学性质变差、性能下降，并最终缩短部件使用寿命的过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-fcad8253b31b7c7ba59fbae2ee05b446" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="97" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fcad8253b31b7c7ba59fbae2ee05b446-e-5" label="component life">
        <attvalues>
          <attvalue for="0" value="component life" />
          <attvalue for="1" value="Component Property" />
          <attvalue for="2" value="组件在规定条件下能够正常工作的总时长或使用周期。作为衡量其可靠性的关键性能指标，该寿命会因表面退化等物理或化学损耗过程而缩短，直至功能失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-fcad8253b31b7c7ba59fbae2ee05b446" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Component lives&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fcad8253b31b7c7ba59fbae2ee05b446-e-5&quot;, &quot;chunk-ef2350bf97175d40c9900d549c35b9f1-e-2&quot;]}]" />
          <attvalue for="9" value="97" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-fcad8253b31b7c7ba59fbae2ee05b446-e-6" label="operation">
        <attvalues>
          <attvalue for="0" value="operation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="指一个以摄入海水为核心特征的特定过程或情境。该术语精确界定了该行为发生的背景，以此区别于外科手术、军事行动等其他类型的“操作”。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-fcad8253b31b7c7ba59fbae2ee05b446" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="149" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8d8d506b8935eb12c19a6c9ce4ae735c-e-1" label="Nickel-base superalloys">
        <attvalues>
          <attvalue for="0" value="Nickel-base superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍基高温合金是一种以镍为基体的高性能材料。它在高温下对静态、疲劳和蠕变载荷具有优异的抵抗力，是航空航天和能源等领域中高温应用的首选材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-8d8d506b8935eb12c19a6c9ce4ae735c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8d8d506b8935eb12c19a6c9ce4ae735c-e-2" label="High-temperature applications">
        <attvalues>
          <attvalue for="0" value="High-temperature applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="高温应用指在高温环境下运行的工程或工业场景。这类应用对材料的耐热性、抗氧化性和高温强度有严苛要求，以确保设备的安全稳定。它常见于航空航天、能源动力等领域，例如使用镍基高温合金制造的燃气轮机叶片。" />
          <attvalue for="3" value="{&quot;operating_temperature&quot;: &quot;beyond about 800°C&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-8d8d506b8935eb12c19a6c9ce4ae735c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;high-temperature applications&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8d8d506b8935eb12c19a6c9ce4ae735c-e-2&quot;, &quot;chunk-bf906ca2cbc8d790d36fdc40a9295b24-e-4&quot;, &quot;chunk-67e83ce412e1a2b3ed6d85749ac58af6-e-2&quot;, &quot;chunk-2f58aaf4e11b140e948152f6a58bcf03-e-2&quot;, &quot;chunk-b2761392d08e0abe002c7c4fcb313ba7-e-1&quot;, &quot;chunk-1ad3d9def6416eb2826a0448d6287c6f-e-13&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-8d8d506b8935eb12c19a6c9ce4ae735c-e-3" label="Static, fatigue and creep conditions">
        <attvalues>
          <attvalue for="0" value="Static, fatigue and creep conditions" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="三种主要的机械载荷工况。静态工况指材料承受恒定载荷；疲劳工况指承受周期性变化的重复载荷；蠕变工况则指在高温和恒定应力下，材料随时间缓慢变形的现象。它们是评估材料（如镍基高温合金）力学性能和寿命的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-8d8d506b8935eb12c19a6c9ce4ae735c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8d8d506b8935eb12c19a6c9ce4ae735c-e-4" label="Gas turbines">
        <attvalues>
          <attvalue for="0" value="Gas turbines" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="燃气轮机是一种旋转式内燃机，也是典型的高温应用。它通过燃烧燃料产生高温燃气，驱动涡轮高速旋转以产生推力或功率。它被广泛用于喷气推进，是现代飞机的核心动力装置，著名实例包括通用电气GE90和劳斯莱斯Trent 800。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-8d8d506b8935eb12c19a6c9ce4ae735c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8d8d506b8935eb12c19a6c9ce4ae735c-e-6" label="Rolls-Royce Trent 800">
        <attvalues>
          <attvalue for="0" value="Rolls-Royce Trent 800" />
          <attvalue for="1" value="Engine Model" />
          <attvalue for="2" value="罗尔斯·罗伊斯遄达800（Rolls-Royce Trent 800）是一款大推力高涵道比涡轮风扇发动机，为波音777飞机提供动力。作为遄达发动机家族的重要成员，其推力级别在75,000至95,000磅力之间，是该机型最受欢迎的发动机选择之一。" />
          <attvalue for="3" value="{&quot;thrust&quot;: &quot;100 000 lb&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-8d8d506b8935eb12c19a6c9ce4ae735c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Rolls-Royce's Trent 800&quot;, &quot;Trent 800&quot;, &quot;Trent 800 aeroengine&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8d8d506b8935eb12c19a6c9ce4ae735c-e-6&quot;, &quot;chunk-ca80bee312e1ad9a585f4b4507e9de12-e-2&quot;, &quot;chunk-a5883cab97f5a9561345af4a639c6bad-e-1&quot;, &quot;chunk-c1f941cda4f8b36efca8168f378f1be7-e-1&quot;, &quot;chunk-6ef562415fc4e831401481f93072dca3-e-6&quot;, &quot;chunk-b505bbe1d912bcde398fe7f44b786cf0-e-10&quot;, &quot;chunk-1176c140725a24bab24c669fe05a7824-e-1&quot;, &quot;chunk-8a64ae02bc80ec0db6abf53700e681de-e-9&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-ca80bee312e1ad9a585f4b4507e9de12-e-1" label="100 000 lb thrust engines">
        <attvalues>
          <attvalue for="0" value="100 000 lb thrust engines" />
          <attvalue for="1" value="Engine Category" />
          <attvalue for="2" value="指推力级别约10万磅力的一类大推力涡扇发动机。该类别专为波音777宽体客机提供动力，是航空史上最强大的发动机之一。其代表型号包括通用电气的GE90系列和罗尔斯·罗伊斯的遄达800系列。" />
          <attvalue for="3" value="{&quot;thrust&quot;: &quot;100 000 lb&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-ca80bee312e1ad9a585f4b4507e9de12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-ca80bee312e1ad9a585f4b4507e9de12-e-4" label="Boeing 777">
        <attvalues>
          <attvalue for="0" value="Boeing 777" />
          <attvalue for="1" value="Aircraft" />
          <attvalue for="2" value="波音777是美国波音公司研制的一款远程宽体双发喷气式客机。作为全球最大的双发客机，它以搭载通用电气GE90等推力超过10万磅的高性能涡扇发动机而著称，是首款完全由计算机辅助设计的民航飞机。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-ca80bee312e1ad9a585f4b4507e9de12" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ca80bee312e1ad9a585f4b4507e9de12-e-4&quot;, &quot;chunk-1c5754d75a0e54b3c65fcb24c11999a4-e-7&quot;, &quot;chunk-6ef562415fc4e831401481f93072dca3-e-5&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-ca80bee312e1ad9a585f4b4507e9de12-e-5" label="1000 lb engines">
        <attvalues>
          <attvalue for="0" value="1000 lb engines" />
          <attvalue for="1" value="Engine Category" />
          <attvalue for="2" value="指主要用于直升机的涡轮轴发动机类别，其功率输出约为1000轴马力（shp）。该命名中的“lb”（磅）通常指代此功率或推力级别，而非发动机的物理重量。这类发动机普遍装备于轻型至中型直升机。" />
          <attvalue for="3" value="{&quot;thrust&quot;: &quot;1000 lb&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ca80bee312e1ad9a585f4b4507e9de12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="150" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ca80bee312e1ad9a585f4b4507e9de12-e-6" label="Helicopter applications">
        <attvalues>
          <attvalue for="0" value="Helicopter applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="指利用直升机垂直起降、空中悬停等独特飞行能力，在军事、民用及商业领域中执行的各种任务。这些应用涵盖了人员运输、搜索救援、医疗急救、执法巡逻、货物吊运和农业作业等多个方面。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-ca80bee312e1ad9a585f4b4507e9de12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="150" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ca80bee312e1ad9a585f4b4507e9de12-e-7" label="Gas turbines">
        <attvalues>
          <attvalue for="0" value="Gas turbines" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="燃气轮机是一种旋转式内燃动力机械，通过燃烧燃料产生高温高压气体，驱动涡轮旋转做功。它被广泛用作飞机发动机和发电厂（如燃气工业电厂）的核心动力装置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ca80bee312e1ad9a585f4b4507e9de12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ca80bee312e1ad9a585f4b4507e9de12-e-9" label="250 MW gas-fired industrial plant">
        <attvalues>
          <attvalue for="0" value="250 MW gas-fired industrial plant" />
          <attvalue for="1" value="Power Plant" />
          <attvalue for="2" value="一座装机容量为250兆瓦(MW)的燃气工业发电厂，是利用燃气轮机进行大规模发电的应用范例。其发电能力足以满足一个百万人口级别大城市的日常电力需求。" />
          <attvalue for="3" value="{&quot;power_output&quot;: &quot;250 MW&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-ca80bee312e1ad9a585f4b4507e9de12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ca80bee312e1ad9a585f4b4507e9de12-e-10" label="A large city of a million people">
        <attvalues>
          <attvalue for="0" value="A large city of a million people" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="一个拥有百万人口的大型城市。根据其能源需求，一座装机容量为250兆瓦（MW）的燃气工业电厂能够为其提供所需电力。" />
          <attvalue for="3" value="{&quot;population&quot;: &quot;a million people&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-ca80bee312e1ad9a585f4b4507e9de12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ca80bee312e1ad9a585f4b4507e9de12-e-11" label="3 MW gas-fired generators">
        <attvalues>
          <attvalue for="0" value="3 MW gas-fired generators" />
          <attvalue for="1" value="Generator" />
          <attvalue for="2" value="一种额定功率为3兆瓦（MW）的燃气发电机设备。它通常作为中小型备用电源，在主电网故障或电力不足时启动，为关键设施提供紧急电力，以保障核心业务的连续性。" />
          <attvalue for="3" value="{&quot;power_output&quot;: &quot;3 MW&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-ca80bee312e1ad9a585f4b4507e9de12" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ca80bee312e1ad9a585f4b4507e9de12-e-11&quot;, &quot;chunk-b2829c09e23d646016766227c07ed334-e-1&quot;]}]" />
          <attvalue for="9" value="151" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ca80bee312e1ad9a585f4b4507e9de12-e-12" label="Back-up facilities">
        <attvalues>
          <attvalue for="0" value="Back-up facilities" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="指在主电源中断时，为保障关键系统（如数据中心、医院）连续运行而启用的独立备用电源设施或应用场景。其目的是维持业务连续性并防止数据或运营损失，3兆瓦燃气发电机是适用于该场景的典型设备。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-ca80bee312e1ad9a585f4b4507e9de12" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ca80bee312e1ad9a585f4b4507e9de12-e-12&quot;, &quot;chunk-b2829c09e23d646016766227c07ed334-e-2&quot;]}]" />
          <attvalue for="9" value="151" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b2829c09e23d646016766227c07ed334-e-3" label="Titanium alloys">
        <attvalues>
          <attvalue for="0" value="Titanium alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="钛合金（Titanium alloys）是以钛为基体，加入其他元素构成的金属材料。它因具有高强度重量比、优异的耐腐蚀性和耐热性等特点，被广泛应用于航空航天领域，例如用于制造航空发动机的风扇和压气机部件。" />
          <attvalue for="3" value="{&quot;oxidation_resistance&quot;: &quot;very poor&quot;, &quot;max_application_temperature&quot;: &quot;below about 700 °C&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-b2829c09e23d646016766227c07ed334" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;titanium alloy&quot;, &quot;titanium alloys&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b2829c09e23d646016766227c07ed334-e-3&quot;, &quot;chunk-a5883cab97f5a9561345af4a639c6bad-e-2&quot;, &quot;chunk-c1f941cda4f8b36efca8168f378f1be7-e-2&quot;, &quot;chunk-f5c07b55f3d29bb402b546962b69a445-e-14&quot;, &quot;chunk-becba5847060251232d4df2b31913a6b-e-2&quot;, &quot;chunk-d190e8215d72110cf452de429687e055-e-2&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-b2829c09e23d646016766227c07ed334-e-4" label="Electricity-generating power plant applications">
        <attvalues>
          <attvalue for="0" value="Electricity-generating power plant applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="指在发电厂中，利用高温（如565°C）过热蒸汽进行发电的一类应用。由于其严苛的运行条件，通常优选高强度抗蠕变铁素体钢等耐高温高压材料来制造其关键部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-b2829c09e23d646016766227c07ed334" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="98" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b2829c09e23d646016766227c07ed334-e-5" label="Super-heated steam">
        <attvalues>
          <attvalue for="0" value="Super-heated steam" />
          <attvalue for="1" value="Substance" />
          <attvalue for="2" value="过热蒸汽（Super-heated steam）是在给定压力下，被加热到高于其饱和温度（沸点）的蒸汽。由于不含液态水滴且拥有很高的热能，它通常被用作工作介质，在发电厂等应用中驱动汽轮机做功以产生电能。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;565 °C&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-b2829c09e23d646016766227c07ed334" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="98" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b2829c09e23d646016766227c07ed334-e-6" label="High-strength creep-resistant ferritic steels">
        <attvalues>
          <attvalue for="0" value="High-strength creep-resistant ferritic steels" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一类具有优异高温蠕变抗力和高强度的铁素体钢。因其良好的性能和相对较低的成本，被广泛用作发电厂在高温高压工况下的关键结构材料，如锅炉管道和汽轮机部件。" />
          <attvalue for="3" value="{&quot;cost&quot;: &quot;lower&quot;, &quot;properties&quot;: [&quot;high-strength&quot;, &quot;creep-resistant&quot;]}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-b2829c09e23d646016766227c07ed334" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="98" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0756721a9e77be5401ded3c9166c47b7-e-1" label="c steels">
        <attvalues>
          <attvalue for="0" value="c steels" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="C steels，即碳钢或碳素钢，是碳作为主要合金元素的铁碳合金。它不含大量其他合金元素，因此成本低廉、应用广泛，是产量和用量最大的钢材。其力学性能主要由碳含量决定，被广泛用于建筑、机械等领域。" />
          <attvalue for="3" value="{&quot;cost&quot;: &quot;lower&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-0756721a9e77be5401ded3c9166c47b7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="258" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-0756721a9e77be5401ded3c9166c47b7-e-2" label="ultra-supercritical steam-generating coal-fired power stations">
        <attvalues>
          <attvalue for="0" value="ultra-supercritical steam-generating coal-fired power stations" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="一种先进的燃煤火力发电站。它利用超高温高压的蒸汽（超超临界状态）驱动涡轮机，发电效率更高。这种极端工况要求其锅炉管道等核心部件必须由特殊材料制成，例如专门为其开发的高温合金，而陶瓷等材料则不适用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-0756721a9e77be5401ded3c9166c47b7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-0756721a9e77be5401ded3c9166c47b7-e-3" label="boiler tubing">
        <attvalues>
          <attvalue for="0" value="boiler tubing" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="锅炉管道是一种用于超超临界燃煤蒸汽发电站的关键部件。它必须在特定的高温、高压及长时工况下运行，对材料性能要求极高，常规铁素体钢无法满足其使用标准。" />
          <attvalue for="3" value="{&quot;lifetime&quot;: &quot;up to 200 000 hours&quot;, &quot;temperature&quot;: &quot;750 °C&quot;, &quot;pressure&quot;: &quot;100 MPa&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-0756721a9e77be5401ded3c9166c47b7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0756721a9e77be5401ded3c9166c47b7-e-4" label="superalloy">
        <attvalues>
          <attvalue for="0" value="superalloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="高温合金（Superalloy）是一种能在高温环境下保持优异机械强度、抗蠕变和抗氧化性能的金属材料。因其出色的高温性能，常被用于制造航空发动机、燃气轮机以及超超临界电站等设备的核心热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0756721a9e77be5401ded3c9166c47b7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0756721a9e77be5401ded3c9166c47b7-e-5" label="ferritic steels">
        <attvalues>
          <attvalue for="0" value="ferritic steels" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="铁素体钢（Ferritic Steels）是一种以铁素体为主要微观组织的不锈钢。其特点是高铬低碳，具有磁性、优良的耐腐蚀性及成形性，但通常不能通过热处理强化。由于其高温强度和抗蠕变性能有限，因此难以满足如新型发电站锅炉管道等对高温性能有严苛要求的应用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-0756721a9e77be5401ded3c9166c47b7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0756721a9e77be5401ded3c9166c47b7-e-6" label="Ceramics">
        <attvalues>
          <attvalue for="0" value="Ceramics" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="陶瓷 (Ceramics) 是一大类无机非金属材料的总称，通常通过高温烧结而成。这类材料普遍具有高硬度、耐高温、耐磨损和化学稳定性好等优异性能。它包含了多种先进工程材料，例如碳化硅、氮化硅以及氧化锆基陶瓷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0756721a9e77be5401ded3c9166c47b7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Ceramic materials&quot;, &quot;ceramic materials&quot;, &quot;ceramics&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0756721a9e77be5401ded3c9166c47b7-e-6&quot;, &quot;chunk-237995b9cf6d28ae47223438bc5c64d5-e-2&quot;, &quot;chunk-db0aaf39ddd68495034176be78a2d349-e-7&quot;, &quot;chunk-502aba15d381acd1fe322927c6f750ed-e-15&quot;, &quot;chunk-ea2d68ee6ba96502ab007d093c1ef915-e-2&quot;, &quot;chunk-f76ae1d909a43808db3e1dc38409d881-e-2&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-0756721a9e77be5401ded3c9166c47b7-e-7" label="silicon carbide">
        <attvalues>
          <attvalue for="0" value="silicon carbide" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="碳化硅（SiC），又名金刚砂，是一种由硅和碳组成的化合物及先进陶瓷材料。它以极高的硬度、优良的导热性、耐高温和抗腐蚀性而著称。作为第三代宽禁带半导体，它被广泛用于磨料、耐火材料、以及汽车和电力电子等领域的高性能器件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-0756721a9e77be5401ded3c9166c47b7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Silicon Carbide&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0756721a9e77be5401ded3c9166c47b7-e-7&quot;, &quot;chunk-db0aaf39ddd68495034176be78a2d349-e-1&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0756721a9e77be5401ded3c9166c47b7-e-8" label="nitride">
        <attvalues>
          <attvalue for="0" value="nitride" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="氮化物是氮与电负性较低元素（如硅、硼、钛）形成的化合物，属于一类先进陶瓷材料。这类材料通常具有极高的硬度、优异的耐高温性、耐磨损性和化学稳定性，常被用于制造切削工具、耐磨涂层及高温环境下的结构部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-0756721a9e77be5401ded3c9166c47b7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-db0aaf39ddd68495034176be78a2d349-e-2" label="Silicon Nitride">
        <attvalues>
          <attvalue for="0" value="Silicon Nitride" />
          <attvalue for="1" value="Ceramic Material" />
          <attvalue for="2" value="氮化硅是一种陶瓷材料，具有出色的抗氧化性和抗蠕变性。尽管具备这些高温优势，但其固有的低韧性和延展性，限制了它在某些需要高断裂韧性的高温结构应用中的使用。" />
          <attvalue for="3" value="{&quot;oxidation resistance&quot;: &quot;excellent&quot;, &quot;creep resistance&quot;: &quot;excellent&quot;, &quot;toughness&quot;: &quot;poor&quot;, &quot;ductility&quot;: &quot;poor&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-db0aaf39ddd68495034176be78a2d349" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-db0aaf39ddd68495034176be78a2d349-e-3" label="Zirconia-based ceramics">
        <attvalues>
          <attvalue for="0" value="Zirconia-based ceramics" />
          <attvalue for="1" value="Ceramic Material" />
          <attvalue for="2" value="氧化锆基陶瓷是一种以氧化锆(ZrO₂)为主要成分的先进陶瓷。因其具有高熔点、优异的高温稳定性、高韧性和极低的导热系数，是理想的热障涂层材料，广泛应用于航空发动机和燃气轮机等领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-db0aaf39ddd68495034176be78a2d349" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-db0aaf39ddd68495034176be78a2d349-e-4" label="Thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="Thermal barrier coatings" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="热障涂层（Thermal Barrier Coating）是一种先进的陶瓷基材料系统，通常应用于航空发动机或燃气轮机等高温部件表面。其主要功能是隔热，保护金属基体免受高温损伤，从而允许更高的运行温度，以提升发动机效率和延长部件寿命。常见的制备方法包括电子束物理气相沉积和等离子喷涂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-db0aaf39ddd68495034176be78a2d349" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;'Layered' form of TBC&quot;, &quot;Layered TBC&quot;, &quot;TBC&quot;, &quot;TBC (Thermal Barrier Coating)&quot;, &quot;TBC systems&quot;, &quot;TBCs&quot;, &quot;Thermal Barrier Coating&quot;, &quot;Thermal Barrier Coating (TBC)&quot;, &quot;Thermal Barrier Coatings&quot;, &quot;Thermal Barrier Coatings (TBCs)&quot;, &quot;Thermal barrier coating (TBC)&quot;, &quot;hafnia-based thermal barrier coating&quot;, &quot;low thermal conductivity thermal barrier coatings&quot;, &quot;plasma-sprayed TBCs&quot;, &quot;plasma-sprayed yttria partially stabilised zirconia TBC&quot;, &quot;thermal barrier coating&quot;, &quot;thermal barrier coatings&quot;, &quot;thermal-barrier coating applications&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e7ffe201a4367e57c9d8b70da74e50b8-e-12&quot;, &quot;chunk-db0aaf39ddd68495034176be78a2d349-e-4&quot;, &quot;chunk-821a3f267f9ff96b58c19914c2c7eff8-e-5&quot;, &quot;chunk-1bf05ee4be604d397765fc4aeef58ab1-e-1&quot;, &quot;chunk-dc948aa78d11700723dfefe1c5756cc9-e-5&quot;, &quot;chunk-6ce78613853147c21bacd4dcc417e01e-e-1&quot;, &quot;chunk-f35df7e25f9cadfabe05aeb0e4fee010-e-1&quot;, &quot;chunk-e619cc9d54ad4b2ac97ef772a3ffcd8c-e-2&quot;, &quot;chunk-6b3f56bd4325c1b8abc874fe75903d49-e-4&quot;, &quot;chunk-a7d8669831007c6978b4f97d67359deb-e-1&quot;, &quot;chunk-411c58f6cae102022f2bf19e1c6ff24d-e-9&quot;, &quot;chunk-c527d2fb17717642598fb40a49925e7f-e-1&quot;, &quot;chunk-897e7353863e7f334da90636833fd561-e-6&quot;, &quot;chunk-237995b9cf6d28ae47223438bc5c64d5-e-1&quot;, &quot;chunk-a9fc67de05915b361fe22b50c698339d-e-1&quot;, &quot;chunk-a6f8ce7a7c55e9b6f962543810b6ee71-e-4&quot;, &quot;chunk-6c012ee00f9a31a25711418938f2f2ba-e-5&quot;, &quot;chunk-9e8ea14457e39729a875ffa2ee3efdb0-e-1&quot;, &quot;chunk-f76ae1d909a43808db3e1dc38409d881-e-4&quot;, &quot;chunk-e408a73fcde801378877f777a7391169-e-14&quot;, &quot;chunk-c2ec04cbf3c90264a785b174dcc622ba-e-2&quot;, &quot;chunk-632d29e490ba842c81dadf45a38731c6-e-5&quot;, &quot;chunk-27fe0e6f1cc64567c0f71ef94ca1d008-e-5&quot;, &quot;chunk-43f7a3d07847f327a8e75bdf9e852f1d-e-13&quot;, &quot;chunk-491e59c42061a40a1fe533ef4ec8d245-e-11&quot;, &quot;chunk-e780ac83d97fe15870adf76ec9226ed9-e-5&quot;, &quot;chunk-be8d9004ced79264b7784b3065b5da94-e-7&quot;, &quot;chunk-3335ffc26fd60180a0fad8ac8e695ea9-e-2&quot;, &quot;chunk-50f39f54006f612a0e1ae1be19a6ae87-e-9&quot;, &quot;chunk-8a8245180b98739270d9b9b4befedd30-e-11&quot;, &quot;chunk-8765b343b5bd5551f3f9be47330d68d2-e-9&quot;, &quot;chunk-22e09ee7f38295f048d1264e0df1823f-e-2&quot;, &quot;chunk-59a3edbbbcb792361a0376e0da5d6d3f-e-11&quot;, &quot;chunk-988c4d7fcff0bc412e7695d08b17502d-e-10&quot;, &quot;chunk-31cd2366f102780cc28ad1a099e8127d-e-5&quot;, &quot;chunk-5508d220f18b6461ca52c2a3d80737ec-e-7&quot;, &quot;chunk-7027df3183981418ce449ee96ef327a1-e-3&quot;, &quot;chunk-6cc9936949c5f333eaac7910b952ef48-e-6&quot;, &quot;chunk-ef2350bf97175d40c9900d549c35b9f1-e-6&quot;, &quot;chunk-5abc3c05849dadfca952537bf1c8dc41-e-2&quot;, &quot;chunk-f7942340b7bda97e3a76f6ceb1d90c75-e-1&quot;, &quot;chunk-8a98946fce80230f54608d957bf8fa18-e-12&quot;, &quot;chunk-502aba15d381acd1fe322927c6f750ed-e-12&quot;, &quot;chunk-e4ee2b4726b7ab716e9f01d209b1fd11-e-2&quot;, &quot;chunk-db7cc890c68f0a43d000b2dba6ecf910-e-3&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="54" />
        </attvalues>
      </node>
      <node id="chunk-d9d4d301605356b62bd308e19ed1fd05-e-6" label="Compressor discs">
        <attvalues>
          <attvalue for="0" value="Compressor discs" />
          <attvalue for="1" value="Engine Sub-component" />
          <attvalue for="2" value="压气机盘 (Compressor discs) 是GE F-101涡扇发动机压气机部分的关键旋转部件。其主要功能是固定压气机叶片，并在高速旋转时与叶片共同作用，对进入发动机的气流进行逐级增压，是承受巨大离心力和高温的核心承力构件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-d9d4d301605356b62bd308e19ed1fd05" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Compressor Discs&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d9d4d301605356b62bd308e19ed1fd05-e-6&quot;, &quot;chunk-bdd419f61b4df7e511da7b854e288ce6-e-7&quot;, &quot;chunk-769ba0c0d24bfa76e90ec2af6878e559-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d9d4d301605356b62bd308e19ed1fd05-e-7" label="Incoming Air">
        <attvalues>
          <attvalue for="0" value="Incoming Air" />
          <attvalue for="1" value="Substance" />
          <attvalue for="2" value="作为一种工作流体，特指被吸入压缩机，并通过压缩作用来提高其压力和密度的空气。它是压缩机的工作对象和能量传递的介质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d9d4d301605356b62bd308e19ed1fd05" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Incoming air&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d9d4d301605356b62bd308e19ed1fd05-e-7&quot;, &quot;chunk-769ba0c0d24bfa76e90ec2af6878e559-e-4&quot;, &quot;chunk-08236d646ea8d17a369306269312b319-e-4&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-769ba0c0d24bfa76e90ec2af6878e559-e-1" label="Compressor">
        <attvalues>
          <attvalue for="0" value="Compressor" />
          <attvalue for="1" value="Engine Component" />
          <attvalue for="2" value="**压气机 (Compressor)**&#10;&#10;燃气轮机发动机的核心部件，其主要功能是压缩进入的气流，从而显著提高气体的压力和平均温度。由于其工作温度与热端部件相比相对较低，因此通常不使用镍基高温合金材料制造。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-769ba0c0d24bfa76e90ec2af6878e559" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-769ba0c0d24bfa76e90ec2af6878e559-e-1&quot;, &quot;chunk-a5883cab97f5a9561345af4a639c6bad-e-4&quot;, &quot;chunk-d9d4d301605356b62bd308e19ed1fd05-e-4&quot;, &quot;chunk-995a2b9cc489b030d64e320f8fc16f28-e-4&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-769ba0c0d24bfa76e90ec2af6878e559-e-2" label="Compressor Blades">
        <attvalues>
          <attvalue for="0" value="Compressor Blades" />
          <attvalue for="1" value="Engine Sub-component" />
          <attvalue for="2" value="压气机叶片是发动机压气机的核心气动部件，通常由多级旋转的动叶和固定的静叶组成。动叶旋转对气流做功，提高其速度和总压；静叶则负责引导气流，并将动能有效转化为压力能，从而共同实现对气体的逐级压缩。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-769ba0c0d24bfa76e90ec2af6878e559" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Compressor blades&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-769ba0c0d24bfa76e90ec2af6878e559-e-2&quot;, &quot;chunk-d9d4d301605356b62bd308e19ed1fd05-e-5&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-769ba0c0d24bfa76e90ec2af6878e559-e-5" label="Pressure">
        <attvalues>
          <attvalue for="0" value="Pressure" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="压强（pressure）是表示物体单位面积上所受到的垂直作用力的物理量，国际单位为帕斯卡（Pa），符号为'p'或'P'。作为描述气体状态的基本物理参数之一，它是理想气体状态方程中的一个关键变量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-769ba0c0d24bfa76e90ec2af6878e559" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;p&quot;, &quot;pressure&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-769ba0c0d24bfa76e90ec2af6878e559-e-5&quot;, &quot;chunk-7e7c6ace2cc9c7181a60293d264541f2-e-9&quot;, &quot;chunk-9b0d001712f3c9617fcf101c325d1706-e-2&quot;, &quot;chunk-995a2b9cc489b030d64e320f8fc16f28-e-8&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-769ba0c0d24bfa76e90ec2af6878e559-e-6" label="Compressed Air">
        <attvalues>
          <attvalue for="0" value="Compressed Air" />
          <attvalue for="1" value="Working Fluid" />
          <attvalue for="2" value="压缩空气是由压缩机产生的高压工质。在热力循环中，它作为氧化剂被送入燃烧室，与燃料混合并参与燃烧，以产生高温高压燃气来驱动涡轮等下游部件做功。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-769ba0c0d24bfa76e90ec2af6878e559" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-769ba0c0d24bfa76e90ec2af6878e559-e-8" label="Fuel">
        <attvalues>
          <attvalue for="0" value="Fuel" />
          <attvalue for="1" value="Substance" />
          <attvalue for="2" value="燃料（fuel）是一种储存有化学能的物质。它通过化学反应（如燃烧）将储存的能量释放出来，转化为热能或动能，从而提供动力或用于做功。常见的燃料包括煤炭、石油和天然气。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-769ba0c0d24bfa76e90ec2af6878e559" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;fuel&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-769ba0c0d24bfa76e90ec2af6878e559-e-8&quot;, &quot;chunk-b455c334b535d063bfe8817108154093-e-4&quot;, &quot;chunk-557dabfd98e07916fb11233921ddc06d-e-14&quot;, &quot;chunk-d0bef0969eda4d511c2167bafe9aeae0-e-2&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-769ba0c0d24bfa76e90ec2af6878e559-e-9" label="Hot Gases">
        <attvalues>
          <attvalue for="0" value="Hot Gases" />
          <attvalue for="1" value="Working Fluid" />
          <attvalue for="2" value="驱动涡轮机做功的高温气体工质。它进入涡轮装置后膨胀，将自身热能转化为机械功。其入口温度是一个被称为“涡轮进口温度(TET)”的关键性能参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-769ba0c0d24bfa76e90ec2af6878e559" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Hot gases&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-769ba0c0d24bfa76e90ec2af6878e559-e-9&quot;, &quot;chunk-8debf02eecb6d1c5cb6982c6f0228498-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-769ba0c0d24bfa76e90ec2af6878e559-e-10" label="Turbine">
        <attvalues>
          <attvalue for="0" value="Turbine" />
          <attvalue for="1" value="Engine Component" />
          <attvalue for="2" value="涡轮是一种旋转式动力机械，作为发动机的关键部件，它将流经自身的高温膨胀气体的能量提取为旋转的机械功，并以此驱动压气机。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-769ba0c0d24bfa76e90ec2af6878e559" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-769ba0c0d24bfa76e90ec2af6878e559-e-11" label="Mechanical Work">
        <attvalues>
          <attvalue for="0" value="Mechanical Work" />
          <attvalue for="1" value="Energy" />
          <attvalue for="2" value="机械功是一种过程产出，指涡轮机装置提取并转换流经气体的热力学能（内能），使其成为可利用的旋转机械能。此能量转换过程会导致气体温度和压力下降。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-769ba0c0d24bfa76e90ec2af6878e559" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Mechanical work&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-769ba0c0d24bfa76e90ec2af6878e559-e-11&quot;, &quot;chunk-8debf02eecb6d1c5cb6982c6f0228498-e-5&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-769ba0c0d24bfa76e90ec2af6878e559-e-12" label="Shaft">
        <attvalues>
          <attvalue for="0" value="Shaft" />
          <attvalue for="1" value="Engine Component" />
          <attvalue for="2" value="涡轮风扇发动机中的核心旋转构件。它由低压涡轮驱动，用于连接并带动风扇和低压压气机，将涡轮产生的旋转功率传递给风扇和压气机段，以实现增压和产生主要推力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-769ba0c0d24bfa76e90ec2af6878e559" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-769ba0c0d24bfa76e90ec2af6878e559-e-12&quot;, &quot;chunk-08236d646ea8d17a369306269312b319-e-8&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-769ba0c0d24bfa76e90ec2af6878e559-e-13" label="Torque">
        <attvalues>
          <attvalue for="0" value="Torque" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="扭矩（Torque），也称为力矩，是一种衡量力使物体绕轴旋转趋势的物理属性。它是导致物体产生角加速度的原因，在机械系统中，通常由轴等部件传递以驱动负载（如压缩机）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-769ba0c0d24bfa76e90ec2af6878e559" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-769ba0c0d24bfa76e90ec2af6878e559-e-13&quot;, &quot;chunk-0f24474e96c9ef42ab24560f2ccf918e-e-7&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-769ba0c0d24bfa76e90ec2af6878e559-e-16" label="Momentum Change">
        <attvalues>
          <attvalue for="0" value="Momentum Change" />
          <attvalue for="1" value="Physical Principle" />
          <attvalue for="2" value="动量改变是一个源于牛顿运动定律的核心物理学原理。它指出当一个物体的动量（质量与速度的乘积）发生变化时，必然会产生一个力。在喷气推进系统中，通过向后高速喷射工质，使其产生动量改变，从而获得一个大小相等、方向相反的反作用力，即推力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-769ba0c0d24bfa76e90ec2af6878e559" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-769ba0c0d24bfa76e90ec2af6878e559-e-16&quot;, &quot;chunk-08236d646ea8d17a369306269312b319-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-08236d646ea8d17a369306269312b319-e-5" label="Exhaust Gas">
        <attvalues>
          <attvalue for="0" value="Exhaust Gas" />
          <attvalue for="1" value="Substance" />
          <attvalue for="2" value="一种气态物质，是进入的空气与燃料在发动机等装置中燃烧后产生的高温高压混合气体。它通常被高速排出，其能量被用来产生推力或驱动涡轮，从而为设备提供动力。" />
          <attvalue for="3" value="{&quot;velocity&quot;: &quot;significantly higher&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-08236d646ea8d17a369306269312b319" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-08236d646ea8d17a369306269312b319-e-6" label="Turbofan Engine">
        <attvalues>
          <attvalue for="0" value="Turbofan Engine" />
          <attvalue for="1" value="Engine Type" />
          <attvalue for="2" value="涡轮风扇发动机（Turbofan Engine）是一种在涡轮喷气发动机基础上发展的航空发动机。其核心特征是前端有一个大型风扇（低压压气机），将吸入的空气分为内外两路。内路空气经核心机燃烧做功，外路空气直接从涵道排出。这种双气流设计显著提高了推进效率和燃油经济性，并降低了噪音。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-08236d646ea8d17a369306269312b319" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Engine&quot;, &quot;Modern Turbofan&quot;, &quot;Modern civil turbofans&quot;, &quot;turbofan&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9c5b2b7dade746247326fc0930d280e0-e-5&quot;, &quot;chunk-8a64ae02bc80ec0db6abf53700e681de-e-8&quot;, &quot;chunk-08236d646ea8d17a369306269312b319-e-6&quot;, &quot;chunk-6ef562415fc4e831401481f93072dca3-e-4&quot;, &quot;chunk-d4872d4d3fa3d8ec025e5fc82bfd4fba-e-1&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="14" />
        </attvalues>
      </node>
      <node id="chunk-08236d646ea8d17a369306269312b319-e-7" label="Low-pressure compressor">
        <attvalues>
          <attvalue for="0" value="Low-pressure compressor" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="低压压气机是涡扇发动机前端的核心部件，其前几级通常就是风扇。它由低压涡轮经传动轴驱动，负责吸入并对空气进行初步压缩，其产生的涵道气流是发动机推力的主要来源。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-08236d646ea8d17a369306269312b319" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-08236d646ea8d17a369306269312b319-e-9" label="Turbine">
        <attvalues>
          <attvalue for="0" value="Turbine" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮是涡扇发动机中的一种旋转式动力组件。它通过吸收高温高压燃气的能量，将其转化为机械功来驱动轴的旋转，从而为低压压气机等部件提供动力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-08236d646ea8d17a369306269312b319" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a5883cab97f5a9561345af4a639c6bad-e-3" label="Fan">
        <attvalues>
          <attvalue for="0" value="Fan" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="风扇是特伦特800（Trent 800）航空发动机的关键组成部件，通常采用钛合金制造。它位于发动机最前端，通过高速旋转吸入大量空气，为发动机提供绝大部分推力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a5883cab97f5a9561345af4a639c6bad" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a5883cab97f5a9561345af4a639c6bad-e-3&quot;, &quot;chunk-c1f941cda4f8b36efca8168f378f1be7-e-3&quot;, &quot;chunk-cdeb193bdb0bc0bd0987151c84c2d210-e-6&quot;, &quot;chunk-995a2b9cc489b030d64e320f8fc16f28-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a5883cab97f5a9561345af4a639c6bad-e-5" label="Turbine">
        <attvalues>
          <attvalue for="0" value="Turbine" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮是一种旋转式动力机械，作为航空发动机（如Trent 800）的核心热力部件。它的主要功能是提取燃烧室产生的高温高压燃气的能量，将其转化为旋转机械功，用以驱动压气机和风扇。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a5883cab97f5a9561345af4a639c6bad" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c1f941cda4f8b36efca8168f378f1be7-e-4" label="Compressor sections">
        <attvalues>
          <attvalue for="0" value="Compressor sections" />
          <attvalue for="1" value="Engine Component" />
          <attvalue for="2" value="作为Trent 800航空发动机的核心组件，负责压缩进入燃烧室的空气。其主要部分由钛合金制造，而为承受更高温度和压力的末级高压阶段则采用超合金材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c1f941cda4f8b36efca8168f378f1be7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c1f941cda4f8b36efca8168f378f1be7-e-8" label="Final (high-pressure) stages of the compressor">
        <attvalues>
          <attvalue for="0" value="Final (high-pressure) stages of the compressor" />
          <attvalue for="1" value="Engine Sub-component" />
          <attvalue for="2" value="压气机高压级是压气机总成的末端部分，负责将空气压缩至最高压力。因其处于极端高温高压的工作环境，为保证结构强度与可靠性，通常由镍基高温合金等先进耐热材料制造。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-c1f941cda4f8b36efca8168f378f1be7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8debf02eecb6d1c5cb6982c6f0228498-e-2" label="Turbine Entry Temperature (TET)">
        <attvalues>
          <attvalue for="0" value="Turbine Entry Temperature (TET)" />
          <attvalue for="1" value="Operating Parameter" />
          <attvalue for="2" value="**TET (Turbine Entry Temperature)**：指燃气轮机等热力发动机中的一个关键运行参数，即高温燃气在进入涡轮做功前的温度。它是决定热机热效率（ηth）和输出功率的核心指标，通常其值越高，热效率也越高，但会受到材料耐热极限的制约。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-8debf02eecb6d1c5cb6982c6f0228498" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;TET&quot;, &quot;TET (Turbine Entry Temperature)&quot;, &quot;Turbine entry temperature&quot;, &quot;Turbine entry temperature (TET)&quot;, &quot;turbine entry temperature&quot;, &quot;turbine entry temperature (TET)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8debf02eecb6d1c5cb6982c6f0228498-e-2&quot;, &quot;chunk-97c05a1094ea39aa5f2616ca79a05f13-e-3&quot;, &quot;chunk-463ddd0dbebb2a2fc18f797d9effe3e6-e-1&quot;, &quot;chunk-5a639fd67a832fc8cf42f11056698bcf-e-2&quot;, &quot;chunk-d0bef0969eda4d511c2167bafe9aeae0-e-12&quot;, &quot;chunk-35e59a51ed8121212e1426f0053ba534-e-1&quot;, &quot;chunk-7655f48240441662095a40f8fdd54d47-e-4&quot;, &quot;chunk-879f6969798c949bf5a7f72d18049a74-e-1&quot;, &quot;chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-7&quot;, &quot;chunk-c5de5e22439ebb3ec48eac8694cd4e84-e-10&quot;, &quot;chunk-f1dbde91fa2668ef8c190d0d43e91e27-e-4&quot;, &quot;chunk-e7b8406b8d85a1255a692ddd5452a482-e-7&quot;, &quot;chunk-9c5b2b7dade746247326fc0930d280e0-e-3&quot;, &quot;chunk-1176c140725a24bab24c669fe05a7824-e-10&quot;, &quot;chunk-b4a23a49ff02000ccb51fce56eab7364-e-3&quot;, &quot;chunk-5ef6f14d86770095e6f2e178382f2c4c-e-3&quot;, &quot;chunk-116daeb47bda22d9815dd14d2f95ed25-e-13&quot;, &quot;chunk-8a64ae02bc80ec0db6abf53700e681de-e-2&quot;, &quot;chunk-77e7186c113af3c719badc55546273f4-e-8&quot;, &quot;chunk-0f24474e96c9ef42ab24560f2ccf918e-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="18" />
        </attvalues>
      </node>
      <node id="chunk-8debf02eecb6d1c5cb6982c6f0228498-e-4" label="Turbine arrangement">
        <attvalues>
          <attvalue for="0" value="Turbine arrangement" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮装置是发动机的一个组件，高温气体进入该装置并驱动其旋转，从而从高速气流中提取机械功，将其转化为发动机的有用动力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-8debf02eecb6d1c5cb6982c6f0228498" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8debf02eecb6d1c5cb6982c6f0228498-e-6" label="Turbomachinery">
        <attvalues>
          <attvalue for="0" value="Turbomachinery" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="**涡轮机械**是指位于涡轮进口处、承受最严苛工况的热端部件。它直接暴露于涡轮进口高温（TET）等极端条件下，为确保其结构完整性和工作可靠性，通常由镍基高温合金等先进耐热材料制成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-8debf02eecb6d1c5cb6982c6f0228498" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-97c05a1094ea39aa5f2616ca79a05f13-e-2" label="engine">
        <attvalues>
          <attvalue for="0" value="engine" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="一种燃气轮机（Gas Turbine Engine）。它是一种利用耐高温的镍基高温合金等材料制成的精密系统。其热效率、功率或推力等关键性能，会随着涡轮前温度（TET）的升高而显著提升。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-97c05a1094ea39aa5f2616ca79a05f13" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-463ddd0dbebb2a2fc18f797d9effe3e6-e-2" label="Large civil aeroengine">
        <attvalues>
          <attvalue for="0" value="Large civil aeroengine" />
          <attvalue for="1" value="Engine" />
          <attvalue for="2" value="指为大型民用飞机提供动力的高推力、高涵道比涡轮风扇发动机。它以高效率、高可靠性和燃油经济性为主要特点，其性能与涡轮前温度（TET）等关键参数密切相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-463ddd0dbebb2a2fc18f797d9effe3e6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-463ddd0dbebb2a2fc18f797d9effe3e6-e-2&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-463ddd0dbebb2a2fc18f797d9effe3e6-e-3" label="Whittle's first engine of 1940">
        <attvalues>
          <attvalue for="0" value="Whittle's first engine of 1940" />
          <attvalue for="1" value="Engine" />
          <attvalue for="2" value="1940年由弗兰克·惠特尔（Frank Whittle）开发的首台发动机。它是一项历史性基准，被用于衡量此后燃气轮机在关键性能指标“涡轮进口温度（TET）”上的显著提升。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1940&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-463ddd0dbebb2a2fc18f797d9effe3e6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-463ddd0dbebb2a2fc18f797d9effe3e6-e-4" label="Flight cycle">
        <attvalues>
          <attvalue for="0" value="Flight cycle" />
          <attvalue for="1" value="Operational Process" />
          <attvalue for="2" value="飞行循环（Flight cycle）指航空发动机从启动、起飞、巡航、着陆到最终关机的完整操作过程。该循环是计算发动机寿命和制定维护计划的基本单位，其间涡轮前温度（TET）等关键运行参数会发生显著变化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-463ddd0dbebb2a2fc18f797d9effe3e6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-463ddd0dbebb2a2fc18f797d9effe3e6-e-5" label="Take-off and climb">
        <attvalues>
          <attvalue for="0" value="Take-off and climb" />
          <attvalue for="1" value="Flight Phase" />
          <attvalue for="2" value="起飞和爬升是指飞机从地面升空并增加高度的飞行阶段。该阶段需要发动机提供最大推力，因此其涡轮进口温度（TET）通常会达到整个飞行周期中的峰值，是发动机负荷最高的阶段之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-463ddd0dbebb2a2fc18f797d9effe3e6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-463ddd0dbebb2a2fc18f797d9effe3e6-e-6" label="Turbines for power-generating applications">
        <attvalues>
          <attvalue for="0" value="Turbines for power-generating applications" />
          <attvalue for="1" value="Engine" />
          <attvalue for="2" value="一种专为发电应用设计的涡轮发动机。与航空发动机不同，它为长时间连续运行而优化，旨在提供稳定、持续的电力输出，因此其启停循环次数显著较少。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-463ddd0dbebb2a2fc18f797d9effe3e6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="152" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-463ddd0dbebb2a2fc18f797d9effe3e6-e-7" label="Start-up/power-down cycles">
        <attvalues>
          <attvalue for="0" value="Start-up/power-down cycles" />
          <attvalue for="1" value="Operational Process" />
          <attvalue for="2" value="指发电机组涡轮机从启动、运行至正常工况，再到停机的完整工作周期。该过程会引起显著的温度和压力变化，是设备热疲劳和机械应力的主要来源，其循环次数是衡量涡轮机损耗和寿命的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-463ddd0dbebb2a2fc18f797d9effe3e6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="152" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5a639fd67a832fc8cf42f11056698bcf-e-1" label="Turbines for power-generating applications">
        <attvalues>
          <attvalue for="0" value="Turbines for power-generating applications" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="发电涡轮机是将流体能量转化为机械功以驱动发电机的旋转动力组件。其设计通常用于基荷发电，特点是能长时间连续运行且启停循环少。涡轮进口温度（TET）是衡量其热效率和性能的关键技术指标。" />
          <attvalue for="3" value="{&quot;operational cycles&quot;: &quot;fewer start-up/power-down&quot;, &quot;operational period&quot;: &quot;very much longer&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-5a639fd67a832fc8cf42f11056698bcf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5a639fd67a832fc8cf42f11056698bcf-e-3" label="Superalloy components">
        <attvalues>
          <attvalue for="0" value="Superalloy components" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="由高温合金材料制造的部件。这类部件通常采用保守设计与高安全系数，以确保在极端工作条件下具有极高的可靠性，因此其失效情况非常罕见。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-5a639fd67a832fc8cf42f11056698bcf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-5a639fd67a832fc8cf42f11056698bcf-e-5" label="Failure of components">
        <attvalues>
          <attvalue for="0" value="Failure of components" />
          <attvalue for="1" value="Event" />
          <attvalue for="2" value="指由高温合金制成的部件发生功能中断或损坏的事件。鉴于这类部件通常采用保守设计并拥有显著的安全系数，该事件被视为一种罕见的发生。" />
          <attvalue for="3" value="{&quot;frequency&quot;: &quot;rare&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-5a639fd67a832fc8cf42f11056698bcf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-5a639fd67a832fc8cf42f11056698bcf-e-6" label="Conservative designs and significant safety factors">
        <attvalues>
          <attvalue for="0" value="Conservative designs and significant safety factors" />
          <attvalue for="1" value="Design Principle" />
          <attvalue for="2" value="一种设计原则，常见于高温合金等关键部件。它通过采用远超预估载荷的设计标准，来确保部件具备极高的可靠性，从而使失效事件变得极为罕见。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-5a639fd67a832fc8cf42f11056698bcf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-79ede9fcd5559df3694674f85ef1484e-e-1" label="Boeing 737">
        <attvalues>
          <attvalue for="0" value="Boeing 737" />
          <attvalue for="1" value="Aircraft" />
          <attvalue for="2" value="波音737是由美国波音公司研制的窄体双发喷气式客机，是世界民航史上最畅销的机型。它被广泛用于中短程航线，其经典型(Classic)和新一代(NG)系列均以通用电气CFM56发动机为主要动力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-79ede9fcd5559df3694674f85ef1484e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-79ede9fcd5559df3694674f85ef1484e-e-1&quot;, &quot;chunk-df97e37a5f8188e07195ed4ca24c7641-e-1&quot;, &quot;chunk-ae7b9636f032afdb12c24ed4774f4c25-e-3&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-79ede9fcd5559df3694674f85ef1484e-e-2" label="CFM56">
        <attvalues>
          <attvalue for="0" value="CFM56" />
          <attvalue for="1" value="Engine" />
          <attvalue for="2" value="CFM56是由通用电气(GE)与赛峰飞机发动机公司合资的CFM国际公司研制的一系列高涵道比涡扇发动机。作为史上最畅销的喷气发动机之一，它是波音737客机的主要动力来源，也广泛应用于空客A320系列等飞机。" />
          <attvalue for="3" value="{&quot;quantity&quot;: &quot;two&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-79ede9fcd5559df3694674f85ef1484e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;General Electric CFM56&quot;, &quot;General Electric CFM56 turbofan engines&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-79ede9fcd5559df3694674f85ef1484e-e-2&quot;, &quot;chunk-df97e37a5f8188e07195ed4ca24c7641-e-2&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-79ede9fcd5559df3694674f85ef1484e-e-3" label="General Electric">
        <attvalues>
          <attvalue for="0" value="General Electric" />
          <attvalue for="1" value="Company" />
          <attvalue for="2" value="GE航空发动机（GE Aircraft Engines），现为GE航空航天（GE Aerospace），是通用电气旗下的核心业务部门。作为全球领先的飞机发动机制造商，该公司为商用及军用飞机提供动力系统，并积极从事涡轮盘高温合金等先进材料的研发工作，以提升发动机的性能与效率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-79ede9fcd5559df3694674f85ef1484e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;GE&quot;, &quot;GE Aircraft Engines&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5e5643debeb7f102ea0f25bf148176a8-e-6&quot;, &quot;chunk-79ede9fcd5559df3694674f85ef1484e-e-3&quot;, &quot;chunk-972c0e045da978a7171f69472773ae6a-e-2&quot;, &quot;chunk-12abccc567e86807dfdcf4f2bea50424-e-3&quot;, &quot;chunk-03e3f6f2736d579e9767469fc63d46a3-e-2&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-79ede9fcd5559df3694674f85ef1484e-e-5" label="Conservative designs">
        <attvalues>
          <attvalue for="0" value="Conservative designs" />
          <attvalue for="1" value="Design Philosophy" />
          <attvalue for="2" value="保守设计是一种审慎的设计理念，旨在通过采用较大的安全裕度、经过验证的成熟技术和方法来应对不确定性，以最大限度地降低关键系统发生失效的概率，从而确保其安全性与可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-79ede9fcd5559df3694674f85ef1484e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-79ede9fcd5559df3694674f85ef1484e-e-6" label="Significant safety factors">
        <attvalues>
          <attvalue for="0" value="Significant safety factors" />
          <attvalue for="1" value="Design Requirement" />
          <attvalue for="2" value="一项设计要求，指在系统设计中为系统性地提升安全性而引入的关键参数、安全裕度或冗余措施。其目标是预防或减轻潜在故障的影响，降低整体运行风险。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-79ede9fcd5559df3694674f85ef1484e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-df97e37a5f8188e07195ed4ca24c7641-e-3" label="Hobart airport">
        <attvalues>
          <attvalue for="0" value="Hobart airport" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="霍巴特机场（Hobart Airport）是位于澳大利亚塔斯马尼亚州的一座主要国际机场，为该州首府霍巴特市提供航空服务。作为塔斯马尼亚最繁忙的机场，它是进出该州的关键航空门户。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-df97e37a5f8188e07195ed4ca24c7641" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-df97e37a5f8188e07195ed4ca24c7641-e-4" label="Tasmania, Australia">
        <attvalues>
          <attvalue for="0" value="Tasmania, Australia" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="塔斯马尼亚是澳大利亚联邦唯一的岛州，位于澳大利亚大陆东南方。该州以其独特的自然风光、广袤的荒野和丰富的生物多样性而闻名，拥有众多国家公园和世界自然遗产。州首府及最大城市为霍巴特。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-df97e37a5f8188e07195ed4ca24c7641" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-df97e37a5f8188e07195ed4ca24c7641-e-5" label="High-pressure (HP) turbine blade">
        <attvalues>
          <attvalue for="0" value="High-pressure (HP) turbine blade" />
          <attvalue for="1" value="Engine Component" />
          <attvalue for="2" value="高压涡轮叶片是一种由“Rene”材料制造的发动机部件。在此特定事件中，它是通用电气CFM56发动机的故障组件，其失效是导致发动机停机的直接原因。" />
          <attvalue for="3" value="{&quot;failure_detail&quot;: &quot;loss of a 15 mm by 20 mm segment from the trailing edge&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-df97e37a5f8188e07195ed4ca24c7641" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3ebda0d0b5d8c59b1e4a1856184280f4-e-1" label="HP turbine blade">
        <attvalues>
          <attvalue for="0" value="HP turbine blade" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一个由Rene 125合金制造的高压涡轮叶片部件。该叶片曾用Rene 80合金修复，后因尾缘出现径向裂纹而失效，进而导致叶片阵列坍塌并损坏了低压涡轮级。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-3ebda0d0b5d8c59b1e4a1856184280f4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-3ebda0d0b5d8c59b1e4a1856184280f4-e-3" label="low-pressure turbine stages">
        <attvalues>
          <attvalue for="0" value="low-pressure turbine stages" />
          <attvalue for="1" value="Component Assembly" />
          <attvalue for="2" value="低压级（LP stage）是涡轮机系统的末级或末几级，包含安装在低压轴上的转动叶片和对应的静止导叶。它的核心功能是在最低压力下，从已经过高压级和中压级的工质（如蒸汽）中提取剩余的可用能量，其叶片通常是整个涡轮机中最长的。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-3ebda0d0b5d8c59b1e4a1856184280f4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Low-Pressure (LP) Stage&quot;, &quot;Low-Pressure (LP) stage&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3ebda0d0b5d8c59b1e4a1856184280f4-e-3&quot;, &quot;chunk-77e7186c113af3c719badc55546273f4-e-7&quot;, &quot;chunk-0f24474e96c9ef42ab24560f2ccf918e-e-2&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-3ebda0d0b5d8c59b1e4a1856184280f4-e-4" label="blade array">
        <attvalues>
          <attvalue for="0" value="blade array" />
          <attvalue for="1" value="Component Assembly" />
          <attvalue for="2" value="一个位于低压涡轮级内的部件组件，由一系列按特定规律排列的叶片构成，是实现能量转换的关键动力部分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-3ebda0d0b5d8c59b1e4a1856184280f4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3ebda0d0b5d8c59b1e4a1856184280f4-e-5" label="radial cracks">
        <attvalues>
          <attvalue for="0" value="radial cracks" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="径向裂纹是一种常见于高压涡轮叶片尖端的失效模式。它是一种由热循环、高热梯度等因素引起的热疲劳所导致的缺陷，通常表现为从叶片边缘向内延伸的裂纹。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3ebda0d0b5d8c59b1e4a1856184280f4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-3ebda0d0b5d8c59b1e4a1856184280f4-e-6" label="thermal cycling">
        <attvalues>
          <attvalue for="0" value="thermal cycling" />
          <attvalue for="1" value="Failure Cause" />
          <attvalue for="2" value="热循环是一种因材料反复经受高低温变化而导致的失效机理。温度的周期性改变使部件内部产生交变热应力，最终引发热疲劳，导致裂纹萌生与扩展。" />
          <attvalue for="3" value="{&quot;severity&quot;: &quot;severe&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-3ebda0d0b5d8c59b1e4a1856184280f4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3ebda0d0b5d8c59b1e4a1856184280f4-e-6&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3ebda0d0b5d8c59b1e4a1856184280f4-e-7" label="high thermal gradients">
        <attvalues>
          <attvalue for="0" value="high thermal gradients" />
          <attvalue for="1" value="Failure Cause" />
          <attvalue for="2" value="一种失效原因，指部件（如高压叶片）内部存在巨大且不均匀的温度差异。这种状况会产生破坏性热应力，是导致径向裂纹的直接原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-3ebda0d0b5d8c59b1e4a1856184280f4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3ebda0d0b5d8c59b1e4a1856184280f4-e-8" label="thermal fatigue">
        <attvalues>
          <attvalue for="0" value="thermal fatigue" />
          <attvalue for="1" value="Failure Cause" />
          <attvalue for="2" value="热疲劳是一种材料失效模式，指材料在反复变化的温度作用下，因热胀冷缩受阻而产生交变热应力，导致裂纹萌生和扩展，并最终造成断裂的现象。它常见于经受急冷急热循环的部件中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-3ebda0d0b5d8c59b1e4a1856184280f4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Thermal Fatigue&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3ebda0d0b5d8c59b1e4a1856184280f4-e-8&quot;, &quot;chunk-7ed243e6959c94b94bb486912a18f1db-e-9&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7ed243e6959c94b94bb486912a18f1db-e-1" label="Failed Blade">
        <attvalues>
          <attvalue for="0" value="Failed Blade" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="指在热疲劳环境下因裂纹扩展而发生故障的叶片形态组件。作为涡轮发动机等高温设备中的关键部件，其失效是评估设备结构完整性与安全寿命的核心研究对象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-7ed243e6959c94b94bb486912a18f1db" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7ed243e6959c94b94bb486912a18f1db-e-3" label="Tip Cracks">
        <attvalues>
          <attvalue for="0" value="Tip Cracks" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="**尖端裂纹 (Tip Cracks)**&#10;&#10;一种发生在叶片尖端的裂纹缺陷。它在氧化、腐蚀和疲劳应力的共同作用下扩展，常发展为V形缺口，最终可导致部件失效。该缺陷可通过修复焊接进行拦截处理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-7ed243e6959c94b94bb486912a18f1db" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-7ed243e6959c94b94bb486912a18f1db-e-6" label="Repair Weld">
        <attvalues>
          <attvalue for="0" value="Repair Weld" />
          <attvalue for="1" value="Component Feature" />
          <attvalue for="2" value="一种由Inconel 625材料制成的深层修复焊缝。作为一种部件特征，该焊缝区域的引入导致了疲劳应力，并最终被尖端裂纹所贯穿。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-7ed243e6959c94b94bb486912a18f1db" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-7ed243e6959c94b94bb486912a18f1db-e-7" label="Inconel 625">
        <attvalues>
          <attvalue for="0" value="Inconel 625" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="IN625，即Inconel 625，是一种固溶强化型镍基高温合金。它以镍为基体，添加铬、钼、铌等元素，具有优异的耐腐蚀性、高强度和出色的高温性能。因其卓越的综合性能，广泛应用于航空航天、化工及海洋工程等严苛环境。" />
          <attvalue for="3" value="{&quot;strength&quot;: &quot;lower&quot;, &quot;class&quot;: &quot;superalloy&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-7ed243e6959c94b94bb486912a18f1db" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;IN625&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7ed243e6959c94b94bb486912a18f1db-e-7&quot;, &quot;chunk-f23caa328479b9d419f0d855b9335eb4-e-8&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7ed243e6959c94b94bb486912a18f1db-e-8" label="Fatigue Stresses">
        <attvalues>
          <attvalue for="0" value="Fatigue Stresses" />
          <attvalue for="1" value="Physical Force" />
          <attvalue for="2" value="疲劳应力是一种作用于材料的周期性或波动性物理力。它会导致材料损伤累积，引发裂纹萌生与扩展，最终在远低于材料静态屈服强度时造成结构性失效或疲劳断裂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-7ed243e6959c94b94bb486912a18f1db" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-18d87a9479e32545e9ff5ebffdeeaf4a-e-1" label="blade">
        <attvalues>
          <attvalue for="0" value="blade" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="指涡轮机、压缩机、风扇等旋转机械的核心部件。它通常具有翼型剖面，通过与气体或液体等流体相互作用，将流体的能量转换成机械功，或将机械功传递给流体，实现能量转换。" />
          <attvalue for="3" value="{&quot;flight_cycles_completed&quot;: &quot;17928&quot;, &quot;cycles_since_repair&quot;: &quot;5332&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-18d87a9479e32545e9ff5ebffdeeaf4a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="259" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-18d87a9479e32545e9ff5ebffdeeaf4a-e-2" label="Manchester Airport">
        <attvalues>
          <attvalue for="0" value="Manchester Airport" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="曼彻斯特机场（IATA代码：MAN）是位于英国英格兰曼彻斯特市的一座主要国际机场，服务于大曼彻斯特地区。按客运量计算，它是英国除伦敦地区外最繁忙的机场，也是全球重要的航空枢纽之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-18d87a9479e32545e9ff5ebffdeeaf4a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Manchester International Airport&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-18d87a9479e32545e9ff5ebffdeeaf4a-e-2&quot;, &quot;chunk-ae7b9636f032afdb12c24ed4774f4c25-e-1&quot;, &quot;chunk-2a7c59397b735114b173a918c874616d-e-6&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-18d87a9479e32545e9ff5ebffdeeaf4a-e-3" label="United Kingdom">
        <attvalues>
          <attvalue for="0" value="United Kingdom" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="英国（UK），全称大不列颠及北爱尔兰联合王国，是位于欧洲大陆西北面的一个主权岛国。它由英格兰、苏格兰、威尔士及北爱尔兰组成，是全球重要经济体及联合国安理会常任理事国之一，首都为伦敦。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-18d87a9479e32545e9ff5ebffdeeaf4a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;UK&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cb57093a6357773efc0ab02b57f76fa1-e-26&quot;, &quot;chunk-8037aec19ea88422e6032e36e14ec0c5-e-5&quot;, &quot;chunk-18d87a9479e32545e9ff5ebffdeeaf4a-e-3&quot;, &quot;chunk-926a036993bc42eccb957e97d54b732e-e-5&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-18d87a9479e32545e9ff5ebffdeeaf4a-e-4" label="British Airways Boeing 737">
        <attvalues>
          <attvalue for="0" value="British Airways Boeing 737" />
          <attvalue for="1" value="Aircraft" />
          <attvalue for="2" value="一架由英国航空公司 (British Airways) 运营的波音737 (Boeing 737) 型客机。此实体特指在曼彻斯特机场发生的一起特定事件中所涉及的飞机。" />
          <attvalue for="3" value="{&quot;passengers_carried&quot;: &quot;131&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-18d87a9479e32545e9ff5ebffdeeaf4a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ae7b9636f032afdb12c24ed4774f4c25-e-2" label="British Airways">
        <attvalues>
          <attvalue for="0" value="British Airways" />
          <attvalue for="1" value="Airline" />
          <attvalue for="2" value="英国的国家航空公司（载旗航空公司），也是英国最大的国际航空公司之一。其主要枢纽为伦敦希思罗机场，运营着覆盖全球的广泛航线网络。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-ae7b9636f032afdb12c24ed4774f4c25" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ae7b9636f032afdb12c24ed4774f4c25-e-4" label="Uncontained engine failure">
        <attvalues>
          <attvalue for="0" value="Uncontained engine failure" />
          <attvalue for="1" value="Event" />
          <attvalue for="2" value="非包容性发动机故障是一种严重的航空发动机故障。在此类事件中，发动机内部的高速旋转部件损坏并穿透保护外壳，其碎片可能对机身、关键系统或客舱造成灾难性的二次损害。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-ae7b9636f032afdb12c24ed4774f4c25" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ae7b9636f032afdb12c24ed4774f4c25-e-5" label="Pratt &amp; Whitney JT8D-15 engine">
        <attvalues>
          <attvalue for="0" value="Pratt &amp; Whitney JT8D-15 engine" />
          <attvalue for="1" value="Engine" />
          <attvalue for="2" value="普惠JT8D-15是一款由美国普拉特·惠特尼公司研制的低涵道比涡轮风扇发动机。它是JT8D系列的一个型号，曾作为早期波音737客机的主要动力装置，安装在机翼下方。" />
          <attvalue for="3" value="{&quot;position&quot;: &quot;port&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ae7b9636f032afdb12c24ed4774f4c25" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ae7b9636f032afdb12c24ed4774f4c25-e-6" label="Fuel tank">
        <attvalues>
          <attvalue for="0" value="Fuel tank" />
          <attvalue for="1" value="Aircraft Component" />
          <attvalue for="2" value="一种飞机燃料储存部件。在该事件中，它被普惠JT8D-15发动机弹出的碎片刺穿，导致燃料泄漏并引发了灾难性火灾。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-ae7b9636f032afdb12c24ed4774f4c25" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ae7b9636f032afdb12c24ed4774f4c25-e-7" label="Catastrophic fire">
        <attvalues>
          <attvalue for="0" value="Catastrophic fire" />
          <attvalue for="1" value="Event" />
          <attvalue for="2" value="一场因油箱被刺穿而引发的灾难性火灾事件，造成了55人死亡。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ae7b9636f032afdb12c24ed4774f4c25" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ae7b9636f032afdb12c24ed4774f4c25-e-8" label="55 persons">
        <attvalues>
          <attvalue for="0" value="55 persons" />
          <attvalue for="1" value="Fatalities" />
          <attvalue for="2" value="在一场灾难性火灾中遇难的55名人员。该数字是此次事故造成的死亡总人数。" />
          <attvalue for="3" value="{&quot;count&quot;: 55}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-ae7b9636f032afdb12c24ed4774f4c25" />
          <attvalue for="6" value="true" />
