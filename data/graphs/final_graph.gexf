        <attvalues>
          <attvalue for="11" value="HAS_PROPERTY_IN_DIRECTION" />
          <attvalue for="12" value="In the (110) direction, pure nickel has a Young's Modulus of 220 GPa." />
          <attvalue for="13" value="...with (110) between the two limits. The values are E(100) = 125 GPa, E(110) = 220 GPa and E(111) = 294 GPa." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-d4ec865719f1815d38483ef812cf9ed2" />
