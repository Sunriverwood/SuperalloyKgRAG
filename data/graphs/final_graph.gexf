        <attvalues>
          <attvalue for="11" value="PROMOTES" />
          <attvalue for="12" value="At higher temperatures and larger AK, slip becomes more homogeneous and 'wavy'." />
          <attvalue for="13" value="At higher temperatures and larger AK... slip is more homogeneous and 'wavy'." />
