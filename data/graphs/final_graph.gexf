          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-7&quot;, &quot;chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-8&quot;]}]" />
          <attvalue for="9" value="273" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-9" label="B">
        <attvalues>
          <attvalue for="0" value="B" />
          <attvalue for="1" value="Abbreviation" />
          <attvalue for="2" value="字母“B”是英文单词“blade”的缩写，通常指代刀片、桨叶或涡轮叶片等具有锋利边缘或扁平形状的部件。" />
