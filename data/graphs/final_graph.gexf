        <attvalues>
          <attvalue for="11" value="MAINTAINS" />
          <attvalue for="12" value="Adjusting the rotational speed (w) allows for maintaining an equivalent stress field when dimensions change." />
          <attvalue for="13" value="For example, if the linear dimensions are doubled at constant b/a, then w must be halved for an equivalent stress field." />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-63b965a50bbef46a7e7134449d064762" />
