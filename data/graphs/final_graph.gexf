        <attvalues>
          <attvalue for="11" value="DEFINES" />
          <attvalue for="12" value="Equation (2.28c) provides a formula for λ₁." />
          <attvalue for="13" value="λ₁ = (2T/F)¹/² × L (2.28c)" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce" />
          <attvalue for="16" value="0.004048582995951417" />
          <attvalue for="17" value="0.4024291497975709" />
