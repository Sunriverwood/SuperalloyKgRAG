          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6dac0a4c73567f8946fa9c50957af9ca-e-12" label="F. S. Pettit">
        <attvalues>
          <attvalue for="0" value="F. S. Pettit" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="F. S. Pettit是一位学者，他作为作者之一撰写了关于热障涂层耐久性机理的科学论文《Mechanisms controlling the durability of thermal barrier coatings》。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-6dac0a4c73567f8946fa9c50957af9ca" />
