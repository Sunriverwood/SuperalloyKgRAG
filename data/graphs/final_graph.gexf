        <attvalues>
          <attvalue for="0" value="H. Gruner" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="H. Gruner是一位等离子喷涂技术领域的研究人员，作为合著者参与撰写了科技著作《等离子喷涂涂层的未来发展》(Future developments in plasma spray coating)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
