      <edge source="chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-9" target="chunk-15be551dd91daaae225854c1bc7fcd9d-e-10" id="chunk-15be551dd91daaae225854c1bc7fcd9d-r-12" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CALCULATED_FROM" />
          <attvalue for="12" value="The useful work (UW) is calculated by subtracting CW from EW." />
          <attvalue for="13" value="It follows that the useful work, UW, is 16.8 – 8.7 = 8.1 MW." />
          <attvalue for="14" value="r-12" />
          <attvalue for="15" value="chunk-15be551dd91daaae225854c1bc7fcd9d" />
          <attvalue for="16" value="0.0051336053705410035" />
          <attvalue for="17" value="0.40308016322232465" />
        </attvalues>
      </edge>
      <edge source="chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-9" target="chunk-15be551dd91daaae225854c1bc7fcd9d-e-8" id="chunk-15be551dd91daaae225854c1bc7fcd9d-r-13" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CALCULATED_FROM" />
          <attvalue for="12" value="The useful work (UW) is calculated by subtracting CW (8.7 MW) from EW." />
          <attvalue for="13" value="It follows that the useful work, UW, is 16.8 – 8.7 = 8.1 MW." />
          <attvalue for="14" value="r-13" />
          <attvalue for="15" value="chunk-15be551dd91daaae225854c1bc7fcd9d" />
          <attvalue for="16" value="0.0037076038787240578" />
          <attvalue for="17" value="0.40222456232723447" />
        </attvalues>
      </edge>
      <edge source="chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-9" target="chunk-15be551dd91daaae225854c1bc7fcd9d-e-13" id="chunk-15be551dd91daaae225854c1bc7fcd9d-r-14" weight="5.0">
        <attvalues>
          <attvalue for="11" value="REPRESENTS" />
          <attvalue for="12" value="The variable UW represents the concept of useful work." />
          <attvalue for="13" value="It follows that the useful work, UW, is 16.8 – 8.7 = 8.1 MW." />
          <attvalue for="14" value="r-14" />
          <attvalue for="15" value="chunk-15be551dd91daaae225854c1bc7fcd9d" />
          <attvalue for="16" value="0.004413291796469367" />
          <attvalue for="17" value="0.40264797507788164" />
        </attvalues>
      </edge>
      <edge source="chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-9" target="chunk-879f6969798c949bf5a7f72d18049a74-e-8" id="chunk-879f6969798c949bf5a7f72d18049a74-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="INCREASES" />
          <attvalue for="12" value="Useful Work (UW) is expended to increase the kinetic energy of the gas stream." />
          <attvalue for="13" value="The useful work, UW, is spent increasing the kinetic energy of the gas stream passing through the engine" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-879f6969798c949bf5a7f72d18049a74" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-9" target="chunk-c5980c35223518f9aaec4d49ac82b647-e-2" id="chunk-c5980c35223518f9aaec4d49ac82b647-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CALCULATED_USING" />
          <attvalue for="12" value="The rate of working (UW) is calculated using the mass flow rate (Ṁ)." />
          <attvalue for="13" value="UW = 1/2 Ṁ[Vjet² - V₀²]" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-c5980c35223518f9aaec4d49ac82b647" />
          <attvalue for="16" value="0.00010055138724350254" />
          <attvalue for="17" value="0.4000603308323461" />
        </attvalues>
      </edge>
      <edge source="chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-9" target="chunk-879f6969798c949bf5a7f72d18049a74-e-10" id="chunk-c5980c35223518f9aaec4d49ac82b647-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CALCULATED_USING" />
          <attvalue for="12" value="The rate of working (UW) is calculated using the jet velocity (Vjet)." />
          <attvalue for="13" value="UW = 1/2 Ṁ[Vjet² - V₀²]" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-c5980c35223518f9aaec4d49ac82b647" />
          <attvalue for="16" value="0.00010969242244745733" />
          <attvalue for="17" value="0.4000658154534685" />
        </attvalues>
      </edge>
      <edge source="chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-9" target="chunk-c25d44ad87f3dc200703221956ca5dd1-e-10" id="chunk-c5980c35223518f9aaec4d49ac82b647-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CALCULATED_USING" />
          <attvalue for="12" value="The rate of working (UW) is calculated using the initial velocity (V₀)." />
          <attvalue for="13" value="UW = 1/2 Ṁ[Vjet² - V₀²]" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-c5980c35223518f9aaec4d49ac82b647" />
          <attvalue for="16" value="0.00021938484489491465" />
          <attvalue for="17" value="0.400131630906937" />
        </attvalues>
      </edge>
      <edge source="chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-9" target="chunk-c5980c35223518f9aaec4d49ac82b647-e-7" id="chunk-c5980c35223518f9aaec4d49ac82b647-r-9" weight="4.0">
        <attvalues>
          <attvalue for="11" value="IS_A_CONVERSION_OF" />
          <attvalue for="12" value="The rate of working (UW) is the result of the conversion of jet kinetic energy." />
          <attvalue for="13" value="The propulsive efficiency is a measure of the proportion of jet kinetic energy (relative to the engine) which is converted to rate of working (by the thrust) on the aeroplane, defined" />
          <attvalue for="14" value="r-9" />
          <attvalue for="15" value="chunk-c5980c35223518f9aaec4d49ac82b647" />
          <attvalue for="16" value="2.1938484489491466e-05" />
          <attvalue for="17" value="0.2666798297573604" />
        </attvalues>
      </edge>
      <edge source="chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-9" target="chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-10" id="chunk-52b9fbfdd63ba4008d7556b754b5ca8c-r-7" weight="4.0">
        <attvalues>
          <attvalue for="11" value="CAUSES" />
          <attvalue for="12" value="Using available useful work (UW) to accelerate air through the engine causes a very high jet velocity." />
          <attvalue for="13" value="Hence, if the available useful work, UW, is used primarily to accelerate the air passing through the engine, then it is inevitable that the jet velocity will be very high" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-52b9fbfdd63ba4008d7556b754b5ca8c" />
          <attvalue for="16" value="0.0026143360683310666" />
          <attvalue for="17" value="0.2682352683076653" />
        </attvalues>
      </edge>
      <edge source="chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-10" target="chunk-35e59a51ed8121212e1426f0053ba534-e-9" id="chunk-52b9fbfdd63ba4008d7556b754b5ca8c-r-8" weight="5.0">
        <attvalues>
          <attvalue for="11" value="INCREASES" />
          <attvalue for="12" value="A very high jet velocity results in the thrust (FN) becoming too large." />
          <attvalue for="13" value="it is inevitable that the jet velocity will be very high, and the thrust, FN, and specific fuel consumption (SFC), too large." />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-52b9fbfdd63ba4008d7556b754b5ca8c" />
          <attvalue for="16" value="0.003031167273631404" />
          <attvalue for="17" value="0.4018187003641789" />
        </attvalues>
      </edge>
      <edge source="chunk-52b9fbfdd63ba4008d7556b754b5ca8c-e-10" target="chunk-cdeb193bdb0bc0bd0987151c84c2d210-e-1" id="chunk-52b9fbfdd63ba4008d7556b754b5ca8c-r-9" weight="5.0">
        <attvalues>
          <attvalue for="11" value="INCREASES" />
          <attvalue for="12" value="A very high jet velocity results in the Specific Fuel Consumption (SFC) becoming too large." />
          <attvalue for="13" value="it is inevitable that the jet velocity will be very high, and the thrust, FN, and specific fuel consumption (SFC), too large." />
          <attvalue for="14" value="r-9" />
          <attvalue for="15" value="chunk-52b9fbfdd63ba4008d7556b754b5ca8c" />
          <attvalue for="16" value="0.0005265236277477952" />
