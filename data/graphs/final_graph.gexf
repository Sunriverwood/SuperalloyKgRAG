        <attvalues>
          <attvalue for="11" value="HAS_PROPERTY" />
          <attvalue for="12" value="A military aeroengine has a low bypass ratio of 1.2:1." />
          <attvalue for="13" value="For a military aeroengine, however, a low bypass ratio of 1.2:1 is more appropriate since a high thrust- to-weight ratio is required;" />
