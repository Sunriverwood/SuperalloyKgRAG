        <attvalues>
          <attvalue for="11" value="USES" />
          <attvalue for="12" value="The 'directed vapour deposition' process utilizes high-velocity gas flows." />
          <attvalue for="13" value="Similar structures have been produced using high-velocity gas flows to focus the vapour plume, a process which has been christened ‘directed vapour deposition'" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-e01b059cc1c9a00298a478f93a9ec05a" />
          <attvalue for="16" value="0.1" />
          <attvalue for="17" value="0.46" />
        </attvalues>
      </edge>
