      <node id="chunk-3f9080fcd7c49e23baf06d3cf81ed207-e-3" label="Surface area of the volume under load">
        <attvalues>
          <attvalue for="0" value="Surface area of the volume under load" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="指材料或构件中承受载荷（load）区域的表面积。作为一个关键物理参数，它对材料的疲劳性能有显著影响。由于疲劳裂纹通常在表面萌生，该面积的大小直接关系到缺陷存在的概率，进而影响材料的疲劳寿命。" />
          <attvalue for="3" value="{&quot;example_value&quot;: &quot;84 000 mm²&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-3f9080fcd7c49e23baf06d3cf81ed207" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3f9080fcd7c49e23baf06d3cf81ed207-e-5" label="Y">
        <attvalues>
          <attvalue for="0" value="Y" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="Y是一个常数参数，用于Rene 95高温合金的相关计算。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;0.67&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3f9080fcd7c49e23baf06d3cf81ed207" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f6f6ff50efa39e806cbac97a51347b5c-e-1" label="Large disc">
        <attvalues>
          <attvalue for="0" value="Large disc" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种具有特定表面积和体积的大尺寸圆盘构件，在失效概率分析中用作性能基准。由于尺寸效应（即更大体积包含缺陷的概率更高），其失效概率通常高于标准疲劳试样或更小的圆盘。" />
          <attvalue for="3" value="{&quot;surface area&quot;: &quot;84000 mm²&quot;, &quot;volume&quot;: &quot;10-2 m&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-f6f6ff50efa39e806cbac97a51347b5c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="83" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-f6f6ff50efa39e806cbac97a51347b5c-e-2" label="Smaller disc">
        <attvalues>
          <attvalue for="0" value="Smaller disc" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种圆盘形组件，其表面积和体积均小于'大圆盘'，但在性能表现上更为优越。" />
          <attvalue for="3" value="{&quot;surface area&quot;: &quot;9300 mm²&quot;, &quot;volume&quot;: &quot;3 × 10-3 m&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-f6f6ff50efa39e806cbac97a51347b5c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="83" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f6f6ff50efa39e806cbac97a51347b5c-e-3" label="Standard fatigue test specimen">
        <attvalues>
          <attvalue for="0" value="Standard fatigue test specimen" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="标准疲劳试样是一种根据特定工业标准（如ASTM、ISO）制造的标准化组件，专用于材料疲劳性能测试。它通过承受循环载荷来评估材料的疲劳寿命和耐久极限，其标准化设计确保了测试结果的可靠性、可重复性与可比性。" />
          <attvalue for="3" value="{&quot;surface area&quot;: &quot;200 mm²&quot;, &quot;volume&quot;: &quot;3.5 × 10-6m&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-f6f6ff50efa39e806cbac97a51347b5c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="83" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f6f6ff50efa39e806cbac97a51347b5c-e-4" label="Probability of failure">
        <attvalues>
          <attvalue for="0" value="Probability of failure" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="指产品、部件或系统在规定时间和条件下无法完成其功能的概率。它是一个关键的性能与可靠性指标，用于评估目标的耐久性和寿命，其数值通常随运行周期或环境应力的变化而改变。" />
          <attvalue for="3" value="{&quot;at &lt; 5000 cycles&quot;: &quot;&lt; 0.01&quot;, &quot;at &gt; 20000 cycles&quot;: &quot;&gt; 0.99&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f6f6ff50efa39e806cbac97a51347b5c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="83" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ac0f1d7e181ea0f31c302d3d4596599b-e-1" label="The model">
        <attvalues>
          <attvalue for="0" value="The model" />
          <attvalue for="1" value="Predictive Model" />
          <attvalue for="2" value="一种预测模型。它通过分析特定参数，识别出最可能引起失效的夹杂物，并基于此评估和计算整体的失效概率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-ac0f1d7e181ea0f31c302d3d4596599b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="195" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ac0f1d7e181ea0f31c302d3d4596599b-e-3" label="Surface to volume ratio">
        <attvalues>
          <attvalue for="0" value="Surface to volume ratio" />
          <attvalue for="1" value="Derived Ratio" />
          <attvalue for="2" value="表面积体积比（S/V）是一个物理量，指物体表面积与自身体积的比值。对于特定形状的物体，其尺寸越小，该比值越大。它是一个关键参数，决定了材料的物质传递、热交换、化学反应速率，以及内部特征（如夹杂物）与表面的相互作用概率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-ac0f1d7e181ea0f31c302d3d4596599b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;S/V&quot;, &quot;Surface to volume ratio, S/V&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a6a0b0d2c85b7b920c33d8bae94d9958-e-8&quot;, &quot;chunk-b5f676dc61935d68cc39272b74bbea4b-e-1&quot;, &quot;chunk-ac0f1d7e181ea0f31c302d3d4596599b-e-3&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-ac0f1d7e181ea0f31c302d3d4596599b-e-4" label="Test specimen">
        <attvalues>
          <attvalue for="0" value="Test specimen" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种测试样本（组件），其典型失效模式是由颗粒尺寸分布下限的微小夹杂物所引发。该样本通常用于研究或验证此类特定的失效机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-ac0f1d7e181ea0f31c302d3d4596599b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ac0f1d7e181ea0f31c302d3d4596599b-e-7" label="Particle-sampling effect">
        <attvalues>
          <attvalue for="0" value="Particle-sampling effect" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="粒子取样效应是材料科学中的一种统计学现象。它描述了材料体积越大，其内部存在足以引发失效的大尺寸夹杂物（缺陷）的概率越高的原理。因此，尺寸更大的构件因更可能“取样”到临界缺陷，在统计上会表现出比同种材料的小尺寸构件更低的强度和可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ac0f1d7e181ea0f31c302d3d4596599b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ac0f1d7e181ea0f31c302d3d4596599b-e-8" label="Probability of failure">
        <attvalues>
          <attvalue for="0" value="Probability of failure" />
          <attvalue for="1" value="Metric" />
          <attvalue for="2" value="一个用于评估模型性能的度量指标，指模型在执行任务时产生错误、有害或其他非预期结果的概率。该指标用于量化模型的失效风险，其值越低通常表示模型的可靠性越高。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-ac0f1d7e181ea0f31c302d3d4596599b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="195" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9e77a589c8fe70a5a486a0c63c76551f-e-1" label="Large particle">
        <attvalues>
          <attvalue for="0" value="Large particle" />
          <attvalue for="1" value="Inclusion" />
          <attvalue for="2" value="一种尺寸较大的夹杂物。尽管其在材料中出现的概率较低，但由于会产生严重的应力集中，因此是引发材料或部件疲劳失效的关键因素。" />
          <attvalue for="3" value="{&quot;likelihood_of_occurrence&quot;: &quot;low&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-9e77a589c8fe70a5a486a0c63c76551f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9e77a589c8fe70a5a486a0c63c76551f-e-6" label="Low-cycle-fatigue (LCF) tests">
        <attvalues>
          <attvalue for="0" value="Low-cycle-fatigue (LCF) tests" />
          <attvalue for="1" value="Test Method" />
          <attvalue for="2" value="低周疲劳（LCF）测试是一种机械测试方法，用于评估材料在高应变、低循环次数下的疲劳寿命。该测试在Udimet 720合金上进行，以确认其疲劳寿命对颗粒尺寸分布的敏感性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-9e77a589c8fe70a5a486a0c63c76551f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9e77a589c8fe70a5a486a0c63c76551f-e-6&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0c0cb15f0b332db0e8b9015221af9b16-e-1" label="Alumina particles">
        <attvalues>
          <attvalue for="0" value="Alumina particles" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="氧化铝颗粒是一种由三氧化二铝（Al₂O₃）构成的颗粒状材料。在此特定研究中，它被用作功能性掺杂剂，有意添加至主体材料中，以调控其物理或化学性能，并用于后续的对比分析。" />
          <attvalue for="3" value="{&quot;sizes&quot;: [&quot;54 µm&quot;, &quot;122 µm&quot;]}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-0c0cb15f0b332db0e8b9015221af9b16" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="196" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0c0cb15f0b332db0e8b9015221af9b16-e-3" label="Particle size">
        <attvalues>
          <attvalue for="0" value="Particle size" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="颗粒尺寸（Particle size）是衡量材料内部微观结构（如晶粒）大小的物理参数。在材料疲劳性能分析中，该参数与疲劳寿命呈负相关关系，即颗粒尺寸的增大会削弱材料在循环载荷下的耐久性，导致其疲劳寿命缩短。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-0c0cb15f0b332db0e8b9015221af9b16" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0c0cb15f0b332db0e8b9015221af9b16-e-3&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0c0cb15f0b332db0e8b9015221af9b16-e-6" label="Turbine disc alloy">
        <attvalues>
          <attvalue for="0" value="Turbine disc alloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="**涡轮盘合金 (Turbine disc alloy)** 是一种用于制造航空发动机及燃气轮机核心旋转部件（涡轮盘）的高性能金属材料。它通常为镍基或钛基高温合金，专为承受极端高温、高应力和循环载荷而设计，具有卓越的高温强度、抗蠕变及抗疲劳性能，以防止疲劳裂纹的萌生与扩展。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0c0cb15f0b332db0e8b9015221af9b16" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0c0cb15f0b332db0e8b9015221af9b16-e-8" label="Fractography">
        <attvalues>
          <attvalue for="0" value="Fractography" />
          <attvalue for="1" value="Analytical Technique" />
          <attvalue for="2" value="标准化描述:&#10;断口学（Fractography）是一门研究材料断裂表面的分析技术。它通过宏观和微观观察断口特征，以确定断裂的起因、机理和扩展路径。在失效分析中，该技术常被用于精确定位疲劳裂纹的起始点，从而帮助理解材料的失效过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-0c0cb15f0b332db0e8b9015221af9b16" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0c0cb15f0b332db0e8b9015221af9b16-e-9" label="Material under study">
        <attvalues>
          <attvalue for="0" value="Material under study" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种为进行对比研究而特意掺杂了氧化铝颗粒的材料。它在实验中通常作为参照样品，用于评估掺杂对材料性能的影响或与未掺杂材料进行比较。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-0c0cb15f0b332db0e8b9015221af9b16" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="196" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b286a29cb9e3f3bd1cd45617831e303b-e-2" label="Turbine Disc Alloy">
        <attvalues>
          <attvalue for="0" value="Turbine Disc Alloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="涡轮盘合金是制造航空发动机和燃气轮机核心部件（涡轮盘）的高性能金属材料。它通常为镍基或钛基高温合金，必须具备优异的高温强度和抗疲劳性能，以承受极端工况并抵抗疲劳裂纹的萌生。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-b286a29cb9e3f3bd1cd45617831e303b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b286a29cb9e3f3bd1cd45617831e303b-e-3" label="Naturally Occurring Particle Size Distributions">
        <attvalues>
          <attvalue for="0" value="Naturally Occurring Particle Size Distributions" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="自然存在的颗粒尺寸分布是一种材料属性，它描述了材料内部固有颗粒（如夹杂物）尺寸的统计分布规律。该属性通常通过疲劳数据推断得出，是进行材料寿命预测等概率建模时的关键输入参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-b286a29cb9e3f3bd1cd45617831e303b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="74" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b286a29cb9e3f3bd1cd45617831e303b-e-4" label="Fatigue Data">
        <attvalues>
          <attvalue for="0" value="Fatigue Data" />
          <attvalue for="1" value="Data" />
          <attvalue for="2" value="一种来源于非晶种材料（Unseeded Material）的数据。它被用于分析和推断材料内部自然产生的颗粒尺寸分布，是研究材料固有缺陷特性的重要信息。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-b286a29cb9e3f3bd1cd45617831e303b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="74" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b286a29cb9e3f3bd1cd45617831e303b-e-5" label="Unseeded Material">
        <attvalues>
          <attvalue for="0" value="Unseeded Material" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种在疲劳分析中使用的材料，特指未经人工预置初始裂纹或缺陷的试样。它主要用于研究疲劳裂纹的自然萌生与扩展过程，是获取材料固有疲劳性能和寿命数据的来源。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-b286a29cb9e3f3bd1cd45617831e303b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="74" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b286a29cb9e3f3bd1cd45617831e303b-e-6" label="Probabilistic Modelling">
        <attvalues>
          <attvalue for="0" value="Probabilistic Modelling" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="概率建模是一种运用概率论来处理不确定性的方法论。此方法特指一类必须依赖“自然产生的颗粒尺寸分布”数据作为必要输入的技术，通过分析这些数据的统计规律来构建模型，以描述或预测相关物理系统的行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-b286a29cb9e3f3bd1cd45617831e303b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="74" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b286a29cb9e3f3bd1cd45617831e303b-e-7" label="Superalloy Industry">
        <attvalues>
          <attvalue for="0" value="Superalloy Industry" />
          <attvalue for="1" value="Industry" />
          <attvalue for="2" value="高温合金产业是研发与生产能在极端高温高压下工作的金属材料（即高温合金）的工业领域。该行业产品是制造航空发动机、燃气轮机等尖端装备核心部件的关键材料，其生产过程高度依赖超纯净熔炼技术以确保最终性能与可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-b286a29cb9e3f3bd1cd45617831e303b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Superalloy industry&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b286a29cb9e3f3bd1cd45617831e303b-e-7&quot;, &quot;chunk-cde5a0fcf48daf01d0e3e3cd1cc4582e-e-1&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b286a29cb9e3f3bd1cd45617831e303b-e-8" label="Superclean Melting Technology">
        <attvalues>
          <attvalue for="0" value="Superclean Melting Technology" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="一项应用于高温合金产业的先进冶金工艺。其核心目标是通过严格控制熔炼过程，最大限度地减少和去除合金中的非金属夹杂物，从而显著提升材料的纯净度、组织均匀性和力学性能，确保最终产品在极端工况下的高可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-b286a29cb9e3f3bd1cd45617831e303b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Superclean melting technology&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b286a29cb9e3f3bd1cd45617831e303b-e-8&quot;, &quot;chunk-cde5a0fcf48daf01d0e3e3cd1cc4582e-e-2&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-cde5a0fcf48daf01d0e3e3cd1cc4582e-e-4" label="Superalloy forging stock">
        <attvalues>
          <attvalue for="0" value="Superalloy forging stock" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="高温合金锻造坯料是一种高性能金属材料，用作制造航空发动机和燃气轮机涡轮盘等关键热端部件的原材料。其内部纯净度至关重要，因为非金属夹杂物等污染物会严重损害材料的力学性能与可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-cde5a0fcf48daf01d0e3e3cd1cc4582e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cde5a0fcf48daf01d0e3e3cd1cc4582e-e-4&quot;]}]" />
          <attvalue for="9" value="29" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cde5a0fcf48daf01d0e3e3cd1cc4582e-e-8" label="Fatigue">
        <attvalues>
          <attvalue for="0" value="Fatigue" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="疲劳（Fatigue）是一种材料属性，指材料在循环应力作用下，结构性能逐渐退化并最终导致断裂的现象。其测量或预测的准确性会受到颗粒大小分布等因素的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-cde5a0fcf48daf01d0e3e3cd1cc4582e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0489a6121ca8cc5c02cc985cc307d8a1-e-3" label="Quantitative metallography">
        <attvalues>
          <attvalue for="0" value="Quantitative metallography" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="定量金相学是一种通过分析材料的平面抛光截面，来定量测定其微观结构特征（如颗粒尺寸分布）的方法。该方法依赖于对显微特征的统计分析，因此在应用于特征稀少的“超洁净”材料时会遇到困难。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-0489a6121ca8cc5c02cc985cc307d8a1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-0489a6121ca8cc5c02cc985cc307d8a1-e-4" label="Plane, polished cross-sections">
        <attvalues>
          <attvalue for="0" value="Plane, polished cross-sections" />
          <attvalue for="1" value="Material Sample" />
          <attvalue for="2" value="为进行定量金相学检验而制备的材料样品。它是一个经过精细抛光的平面横截面，旨在清晰地揭示材料的微观组织结构，以便进行定量分析。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0489a6121ca8cc5c02cc985cc307d8a1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0489a6121ca8cc5c02cc985cc307d8a1-e-5" label="‘Superclean' material">
        <attvalues>
          <attvalue for="0" value="‘Superclean' material" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="“超洁净”材料是一种高纯度材料，其特征是内部的非金属夹杂物数量极少且尺寸微小。由于这种极高的洁净度，使得采用常规的定量金相学方法对其进行准确分析变得非常困难。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-0489a6121ca8cc5c02cc985cc307d8a1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
