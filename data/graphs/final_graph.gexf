        </attvalues>
      </node>
      <node id="chunk-88fbc7a52ff45f9431f17e23dd2d49a1-e-1" label="Cutting Stress (τc)">
        <attvalues>
          <attvalue for="0" value="Cutting Stress (τc)" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="切过应力（Cutting Stress, τc）是在位错运动中，切过有序相或沉淀相等强化粒子时所需的临界解析切应力。该过程常形成反相畴界（APB），是材料的一种重要强化机制，其值可通过反相畴界能（γAPB）与柏氏矢量（b）等参数估算。" />
          <attvalue for="3" value="{&quot;estimate_1&quot;: &quot;90 MPa&quot;, &quot;estimate_2&quot;: &quot;400 MPa&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-88fbc7a52ff45f9431f17e23dd2d49a1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Particle-cutting stress&quot;, &quot;cutting stress&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4f41447104e1101d06dfe6066a69e83c-e-1&quot;, &quot;chunk-fd08a4d01f900e8f06f5ce2b9d625965-e-9&quot;, &quot;chunk-88fbc7a52ff45f9431f17e23dd2d49a1-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="6" />
