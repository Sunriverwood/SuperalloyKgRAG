        </attvalues>
      </node>
      <node id="chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec-e-11" label="Ao">
        <attvalues>
          <attvalue for="0" value="Ao" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="Ao是一个参数，其数值在计算中被设定为保证强度（Proof Strength），用以定义或约束计算模型。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-7a1225bdb4a6e0c3d0f4d9b37fb22aec" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e3a4ba849abe93a2a6728157cbd079b2-e-4" label="1500 cycles">
        <attvalues>
          <attvalue for="0" value="1500 cycles" />
          <attvalue for="1" value="Cycle Count" />
          <attvalue for="2" value="在Waspaloy等高温合金的疲劳寿命测试中，材料表面形成0.375毫米裂纹时所经历的循环次数。该数值是衡量材料抗裂纹萌生能力的关键指标，并被视为一种失效判据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-e3a4ba849abe93a2a6728157cbd079b2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e3a4ba849abe93a2a6728157cbd079b2-e-6" label="Failure">
        <attvalues>
          <attvalue for="0" value="Failure" />
          <attvalue for="1" value="State" />
          <attvalue for="2" value="一种基于“首次裂纹寿命法”定义的失效状态。它特指材料在经历1500次循环后，出现尺寸为0.375毫米裂纹的临界点。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e3a4ba849abe93a2a6728157cbd079b2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-bd5710a1dc51c42dffb282b63e6aaa4f-e-4" label="Stronger alloy">
        <attvalues>
          <attvalue for="0" value="Stronger alloy" />
          <attvalue for="1" value="Alloy Category" />
          <attvalue for="2" value="一类合金。其特点是在应用“初始裂纹寿命”（life-to-first-crack）方法进行设计和寿命预测时，会伴随更高的风险，即裂纹一旦形成可能快速扩展至失效。镍基高温合金Rene 95是其典型代表。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-bd5710a1dc51c42dffb282b63e6aaa4f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bd5710a1dc51c42dffb282b63e6aaa4f-e-5" label="Unnamed Alloy Example">
        <attvalues>
          <attvalue for="0" value="Unnamed Alloy Example" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="一种用于描述疲劳特性的示例合金。其裂纹萌生寿命为1500次循环，占总疲劳寿命的15%，因此其总寿命为10000次循环。" />
          <attvalue for="3" value="{&quot;life-to-first-crack&quot;: &quot;1500 cycles&quot;, &quot;percentage_of_total_life&quot;: &quot;15%&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-bd5710a1dc51c42dffb282b63e6aaa4f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="304" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-d4336056b69d9ed5dd6dd68380e06523-e-1" label="Manufacturing processes">
        <attvalues>
          <attvalue for="0" value="Manufacturing processes" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="指将原材料、零部件转化为最终产品的系列活动与步骤。为确保产品质量，必须对此类过程进行严格控制，以防止缺陷的产生或引入。" />
          <attvalue for="3" value="{}" />
