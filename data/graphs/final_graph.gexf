      <edge source="chunk-488553ca8f86a8be784d625006ec53f4-e-5" target="chunk-be2e5714ffd15b4d499890769149ecb3-e-8" id="chunk-7319e10c21751146ade723f5be6c80d4-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_PROPERTY_OF" />
          <attvalue for="12" value="The value of S11 is a property of pure nickel." />
          <attvalue for="13" value="For pure nickel at room temperature, typical values are S11 = 0.799 × 10−5/MPa, S12 = -0.312 × 10-5/MPa and S44 = 0.844 × 10-5/MPa." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-7319e10c21751146ade723f5be6c80d4" />
          <attvalue for="16" value="0.006287363430220575" />
          <attvalue for="17" value="0.40377241805813235" />
        </attvalues>
      </edge>
      <edge source="chunk-488553ca8f86a8be784d625006ec53f4-e-5" target="chunk-22ef75b1c4655668db62d8db90f9c1bb-e-7" id="chunk-22ef75b1c4655668db62d8db90f9c1bb-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="EQUALS" />
          <attvalue for="12" value="For a cubic crystal, the tensor component S11 is equal to S22." />
          <attvalue for="13" value="For a cubic crystal such as Ni, S11 = S22 = S33" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-22ef75b1c4655668db62d8db90f9c1bb" />
          <attvalue for="16" value="0.005772005772005772" />
          <attvalue for="17" value="0.40346320346320347" />
        </attvalues>
      </edge>
      <edge source="chunk-488553ca8f86a8be784d625006ec53f4-e-5" target="chunk-488553ca8f86a8be784d625006ec53f4-e-4" id="chunk-488553ca8f86a8be784d625006ec53f4-r-4" weight="4.0">
        <attvalues>
          <attvalue for="11" value="IS_INPUT_TO" />
          <attvalue for="12" value="The compliance constant S11 is a variable in Equation A7." />
          <attvalue for="13" value="S'44 = S44 + (2S11 - 2S12 - S44) × 4 sin²θ cos²θ = S44 + (2S11 - 2S12 - S44) × sin²2θ/2 (A7)" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-488553ca8f86a8be784d625006ec53f4" />
          <attvalue for="16" value="0.0008589294303580017" />
          <attvalue for="17" value="0.2671820243248815" />
        </attvalues>
      </edge>
      <edge source="chunk-488553ca8f86a8be784d625006ec53f4-e-5" target="chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-20" id="chunk-59efde3cc28eec2ad611a5941651c5d8-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DEFINED_BY" />
          <attvalue for="12" value="The compliance component S11 is defined as the reciprocal of Young's modulus (E)." />
          <attvalue for="13" value="S11 = 1/E" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-59efde3cc28eec2ad611a5941651c5d8" />
          <attvalue for="16" value="0.006665292379578093" />
          <attvalue for="17" value="0.4039991754277469" />
        </attvalues>
      </edge>
      <edge source="chunk-488553ca8f86a8be784d625006ec53f4-e-6" target="chunk-be2e5714ffd15b4d499890769149ecb3-e-8" id="chunk-7319e10c21751146ade723f5be6c80d4-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_PROPERTY_OF" />
          <attvalue for="12" value="The value of S12 is a property of pure nickel." />
          <attvalue for="13" value="For pure nickel at room temperature, typical values are S11 = 0.799 × 10−5/MPa, S12 = -0.312 × 10-5/MPa and S44 = 0.844 × 10-5/MPa." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-7319e10c21751146ade723f5be6c80d4" />
          <attvalue for="16" value="0.005875077303648734" />
          <attvalue for="17" value="0.4035250463821893" />
        </attvalues>
      </edge>
      <edge source="chunk-488553ca8f86a8be784d625006ec53f4-e-6" target="chunk-7319e10c21751146ade723f5be6c80d4-e-9" id="chunk-7319e10c21751146ade723f5be6c80d4-r-8" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DEFINED_BY" />
          <attvalue for="12" value="The compliance constant S12 is defined by a formula that includes the stiffness constant C11." />
          <attvalue for="13" value="S12 = C12 / ((C11 - C12)(C11 + 2C12))" />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-7319e10c21751146ade723f5be6c80d4" />
          <attvalue for="16" value="0.002886002886002886" />
          <attvalue for="17" value="0.4017316017316018" />
        </attvalues>
      </edge>
      <edge source="chunk-488553ca8f86a8be784d625006ec53f4-e-6" target="chunk-7319e10c21751146ade723f5be6c80d4-e-10" id="chunk-7319e10c21751146ade723f5be6c80d4-r-9" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DEFINED_BY" />
          <attvalue for="12" value="The compliance constant S12 is defined by a formula that includes the stiffness constant C12." />
          <attvalue for="13" value="S12 = C12 / ((C11 - C12)(C11 + 2C12))" />
          <attvalue for="14" value="r-9" />
          <attvalue for="15" value="chunk-7319e10c21751146ade723f5be6c80d4" />
          <attvalue for="16" value="0.002886002886002886" />
