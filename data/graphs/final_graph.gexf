        <attvalues>
          <attvalue for="11" value="CAUSES_DISSOLUTION_OF" />
          <attvalue for="12" value="Interdiffusion with the substrate causes the B-phase to dissolve." />
          <attvalue for="13" value="interdiffusion with the substrate, which causes the B-phase to dissolve" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-c4027f79a0ee2caae7fc9e91bab6483f" />
          <attvalue for="17" value="0.4" />
        </attvalues>
