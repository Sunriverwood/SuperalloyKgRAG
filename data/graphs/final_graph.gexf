      <node id="chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-e-9" label="r₁">
        <attvalues>
          <attvalue for="0" value="r₁" />
          <attvalue for="1" value="Mathematical Variable" />
          <attvalue for="2" value="变量r₁是一个在数学推导或计算过程中使用的中间变量。它在最终方程中被变量“r”所取代，通常此举是为了简化表达式或统一符号。" />
          <attvalue for="3" value="{}" />
