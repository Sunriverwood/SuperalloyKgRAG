      <node id="chunk-cd90df188efe63a1aba2d62ab225c3ae-e-10" label="M. J. Graham">
        <attvalues>
          <attvalue for="0" value="M. J. Graham" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="M. J. Graham是一位研究人员，也是科学论文《Oxidation mechanisms of β-NiAl + Zr determined by SIMS》的作者之一。该论文专注于研究添加了锆(Zr)的β-NiAl金属间化合物的氧化机理。" />
