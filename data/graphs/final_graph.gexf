        <attvalues>
          <attvalue for="11" value="IS_SUPERIOR_IN" />
          <attvalue for="12" value="Tensile data is superior in the bore regions of the ME3 disc." />
          <attvalue for="13" value="with tensile and creep data which are superior in bore and rim regions, respectively" />
          <attvalue for="14" value="r-4" />
