      <node id="chunk-c87d6224a6dfa2402ba4ce5b82dd066c-e-4" label="Catastrophic failure">
        <attvalues>
          <attvalue for="0" value="Catastrophic failure" />
          <attvalue for="1" value="Event" />
          <attvalue for="2" value="指因投入使用时就已存在的、达到临界尺寸的预存缺陷，而导致的系统或结构发生突然、彻底且不可逆的崩溃。这种失效通常是不可预见的，会迅速扩展并造成毁灭性后果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c87d6224a6dfa2402ba4ce5b82dd066c" />
