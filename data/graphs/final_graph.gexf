          <attvalue for="9" value="307" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0-e-11" label="n_v">
        <attvalues>
          <attvalue for="0" value="n_v" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="n_v 是一个数学变量，在用于计算特定概率 p2 的公式中作为一个参数。它代表该概率模型中的一个可变数值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-7a5ff8f8b7c94e5a0b390f0b0fa7aff0" />
