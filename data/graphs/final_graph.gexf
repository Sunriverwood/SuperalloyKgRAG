          <attvalue for="2" value="一个包含了所有内含物（inclusion）类别的集合。该集合的每个元素 Di 代表一种特定的内含物类型。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-82c9ced81969f3e1552c36cf4bd5f22e" />
