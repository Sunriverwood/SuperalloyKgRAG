      <edge source="chunk-9fdfa272aaae5e3c817cad2953b39e4e-e-1" target="chunk-954a43f6bb0bc08cefcb62bd390ac3fa-e-1" id="chunk-9fdfa272aaae5e3c817cad2953b39e4e-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DEFINED_BY" />
          <attvalue for="12" value="Strain components are defined by a linear combination of stress components and compliance constants." />
          <attvalue for="13" value="€22 = S12σ11 + S11σ22 + S12σ33" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-9fdfa272aaae5e3c817cad2953b39e4e" />
          <attvalue for="16" value="0.0006747638326585695" />
          <attvalue for="17" value="0.40040485829959516" />
        </attvalues>
      </edge>
      <edge source="chunk-9fdfa272aaae5e3c817cad2953b39e4e-e-1" target="chunk-9fdfa272aaae5e3c817cad2953b39e4e-e-3" id="chunk-9fdfa272aaae5e3c817cad2953b39e4e-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DEFINED_BY" />
          <attvalue for="12" value="Strain components are defined using compliance constants as coefficients for the stress components." />
          <attvalue for="13" value="€23 = 1/2 S44σ23" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-9fdfa272aaae5e3c817cad2953b39e4e" />
          <attvalue for="16" value="0.002699055330634278" />
          <attvalue for="17" value="0.4016194331983806" />
        </attvalues>
      </edge>
      <edge source="chunk-9fdfa272aaae5e3c817cad2953b39e4e-e-3" target="chunk-9fdfa272aaae5e3c817cad2953b39e4e-e-4" id="chunk-9fdfa272aaae5e3c817cad2953b39e4e-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="EVALUATED_VIA" />
          <attvalue for="12" value="Compliance constants can be calculated from stiffness constants using specific equations." />
          <attvalue for="13" value="S11 = (C11 + C12) / ((C11 - C12)(C11 + 2C12))" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-9fdfa272aaae5e3c817cad2953b39e4e" />
          <attvalue for="16" value="0.002699055330634278" />
          <attvalue for="17" value="0.4016194331983806" />
        </attvalues>
      </edge>
      <edge source="chunk-acebf0b59de1a04e5bd5c03c23e7d583-e-1" target="chunk-488553ca8f86a8be784d625006ec53f4-e-5" id="chunk-acebf0b59de1a04e5bd5c03c23e7d583-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_INVERSE_OF" />
          <attvalue for="12" value="The stiffness along the (100) crystallographic direction, E(100), is derived as the inverse of the compliance matrix component S11." />
          <attvalue for="13" value="E(100) = σ11/€11 = 1/S11" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-acebf0b59de1a04e5bd5c03c23e7d583" />
          <attvalue for="16" value="0.00515357658214801" />
          <attvalue for="17" value="0.4030921459492888" />
        </attvalues>
      </edge>
      <edge source="chunk-acebf0b59de1a04e5bd5c03c23e7d583-e-1" target="chunk-acebf0b59de1a04e5bd5c03c23e7d583-e-4" id="chunk-acebf0b59de1a04e5bd5c03c23e7d583-r-3" weight="4.0">
        <attvalues>
          <attvalue for="11" value="IS_LESS_THAN" />
          <attvalue for="12" value="The stiffness of pure nickel along the (100) direction (E(100) = 125 GPa) is much less than the stiffness value for polycrystalline nickel." />
          <attvalue for="13" value="This is much less than the value for polycrystalline nickel, which, in the absence of texture, is expected to be isotropic, since the many grains average out the elastic properties over the different orientation" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-acebf0b59de1a04e5bd5c03c23e7d583" />
          <attvalue for="16" value="0.002886002886002886" />
          <attvalue for="17" value="0.2683982683982684" />
        </attvalues>
      </edge>
      <edge source="chunk-5d285668cb116d3577030c45282de28e-e-1" target="chunk-5d285668cb116d3577030c45282de28e-e-2" id="chunk-5d285668cb116d3577030c45282de28e-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_HIGHER_ELASTIC_MODULUS_THAN" />
          <attvalue for="12" value="The elastic modulus of polycrystalline nickel is about 66% higher than the elastic modulus along the (100) direction." />
          <attvalue for="13" value="In fact, polycrystalline nickel has an elastic modulus of about 207 GPa, about 66% higher than that along the (100) direction." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-5d285668cb116d3577030c45282de28e" />
          <attvalue for="16" value="1.4736221632773356e-05" />
          <attvalue for="17" value="0.4000088417329797" />
        </attvalues>
      </edge>
      <edge source="chunk-5d285668cb116d3577030c45282de28e-e-4" target="chunk-5d285668cb116d3577030c45282de28e-e-2" id="chunk-5d285668cb116d3577030c45282de28e-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_LEAST_STIFF_DIRECTION" />
          <attvalue for="12" value="For most cubic metals, the (100) direction is the least stiff orientation." />
          <attvalue for="13" value="For nickel, it turns out that the (100) direction is the least stiff, and this is true for most other cubic metals." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-5d285668cb116d3577030c45282de28e" />
          <attvalue for="16" value="1.4736221632773356e-05" />
          <attvalue for="17" value="0.4000088417329797" />
        </attvalues>
      </edge>
