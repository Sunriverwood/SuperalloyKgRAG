      <node id="chunk-28027332c1e907d2b9fb62cbdc68fd6c-e-12" label="S. Keller">
        <attvalues>
          <attvalue for="0" value="S. Keller" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="S. Keller是一位研究人员或学者，其专业领域为等离子喷涂涂层技术。他是学术文章《等离子喷涂涂层技术的未来发展》(Future developments in plasma spray coating) 的合著者之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
