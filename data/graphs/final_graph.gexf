      </node>
      <node id="chunk-d6790fb9c1169445a5d3fb409c8aba9c-e-11" label="Figure 4.44">
        <attvalues>
          <attvalue for="0" value="Figure 4.44" />
          <attvalue for="1" value="Figure" />
          <attvalue for="2" value="图4.44是一张展示颗粒粒径分布的图表。它通过图形方式，直观地呈现了样品中不同尺寸颗粒的数量或质量的相对比例，用于分析材料的物理特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
