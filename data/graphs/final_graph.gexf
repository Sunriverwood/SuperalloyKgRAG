          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c5385f7f28e0875405c91c30084a5d9b-e-5" label="The use of model alloys to understand and improve the performance of Pt-modified aluminide coatings">
        <attvalues>
          <attvalue for="0" value="The use of model alloys to understand and improve the performance of Pt-modified aluminide coatings" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="由B. A. Pint、J. A. Haynes等人合著的学术论文，发表于《Superalloys 2004》会议论文集。该论文旨在研究如何利用模型合金来理解并提升铂改性铝化物涂层(Pt-modified aluminide coatings)的性能。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;597-606&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c5385f7f28e0875405c91c30084a5d9b" />
          <attvalue for="6" value="true" />
