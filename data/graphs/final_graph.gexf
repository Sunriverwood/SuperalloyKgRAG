      <node id="chunk-65817dd1ccad389cffd2a92e861510de-e-2" label="ΔT">
        <attvalues>
          <attvalue for="0" value="ΔT" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="一个物理量，符号为ΔΤ，指温度的变化量或温差。它是在材料科学中，计算由热膨胀不匹配所引起的热应变（εT）或失配应变时所使用的关键参数。" />
          <attvalue for="3" value="{}" />
