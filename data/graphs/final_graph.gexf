      <edge source="chunk-aae63be5befb53cbb763740fd894bee5-e-2" target="chunk-4d2bc3be978842eac31d6c74bc19bb3f-e-5" id="chunk-ae58c0f988aba111d22bb6ff5c500655-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_A_TYPE_OF" />
          <attvalue for="12" value="Al2O3 is a typical example of a ceramic inclusion." />
          <attvalue for="13" value="Second, failure is found to be associated with ceramic inclusions – typically Al2O3 or SiO2 – which are inherited from the processing route." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-ae58c0f988aba111d22bb6ff5c500655" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-aae63be5befb53cbb763740fd894bee5-e-2" target="chunk-2292cbd804c7d75d1e8a3ada6e8b42bd-e-6" id="chunk-2292cbd804c7d75d1e8a3ada6e8b42bd-r-7" weight="5.0">
        <attvalues>
          <attvalue for="11" value="FORMS_IN" />
          <attvalue for="12" value="Al2O3 is found at increasing depths within the substrate, after Cr2O3." />
          <attvalue for="13" value="Cr2O3, and then Al2O3, are found at further increasing depths into the substrate due to their low equilibrium partial pressures of oxygen." />
          <attvalue for="14" value="r-7" />
