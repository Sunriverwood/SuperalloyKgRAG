          <attvalue for="11" value="DESIGNED" />
          <attvalue for="12" value="GE designed the Rene 88DT superalloy to address the shortcomings of Rene 95." />
          <attvalue for="13" value="The lack of damage tolerance displayed by Rene 95 was acknowledged by GE in designing their Rene 88DT superalloy..." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-12abccc567e86807dfdcf4f2bea50424" />
