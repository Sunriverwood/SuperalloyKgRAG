        <attvalues>
          <attvalue for="0" value="Cross-sectional area of material" />
          <attvalue for="1" value="Measurement Parameter" />
          <attvalue for="2" value="一个材料科学中的测量参数，指为通过二维平面检验来估算材料中夹杂物体积分数时，所需要测量的样品横截面面积。" />
          <attvalue for="3" value="{}" />
