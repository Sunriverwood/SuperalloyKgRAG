      <node id="chunk-d246d51e161275b250bc309214ccd241-e-8" label="R. A. Mulford">
        <attvalues>
          <attvalue for="0" value="R. A. Mulford" />
          <attvalue for="1" value="Author" />
          <attvalue for="2" value="R. A. Mulford是一位研究者与作者，其撰写的科学论文《Grain boundary segregation in Ni and binary Ni alloys doped with sulphur》研究了硫在镍及二元镍合金中的晶界偏析现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-d246d51e161275b250bc309214ccd241" />
