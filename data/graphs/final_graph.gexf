        <attvalues>
          <attvalue for="11" value="DEPENDS_ON" />
          <attvalue for="12" value="The calculation of compressive stress (σc) depends on the coating thickness (h) as per Equation 5.3." />
          <attvalue for="13" value="σc = (π² / 12) * (E|| / (1 - ν²)) * (h/b)² (5.3)" />
          <attvalue for="14" value="r-10" />
          <attvalue for="15" value="chunk-2e04fd0a8a6174c1165f0c60c65b783d" />
          <attvalue for="16" value="0.002684563758389262" />
