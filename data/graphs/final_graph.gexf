          <attvalue for="13" value="the grain-boundary-strengthening elements C and B, which were added routinely to the earlier directionally solidified alloys, are no longer present." />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-8cc148c1ca974c554ee456036519b0b3" />
          <attvalue for="17" value="0.4" />
