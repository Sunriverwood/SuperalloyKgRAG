      <edge source="chunk-8debf02eecb6d1c5cb6982c6f0228498-e-2" target="chunk-463ddd0dbebb2a2fc18f797d9effe3e6-e-3" id="chunk-463ddd0dbebb2a2fc18f797d9effe3e6-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="INCREASED_SINCE" />
          <attvalue for="12" value="The Turbine Entry Temperature (TET) has increased by 700°C in the 60 years since Whittle's first engine of 1940." />
          <attvalue for="13" value="the TET of the large civil aeroengine has increased since Whittle's first engine of 1940 (Figure 1.5); a 700°C improvement in a 60-year period has been achieved" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-463ddd0dbebb2a2fc18f797d9effe3e6" />
          <attvalue for="16" value="0.0017112017901803344" />
          <attvalue for="17" value="0.40102672107410825" />
        </attvalues>
      </edge>
