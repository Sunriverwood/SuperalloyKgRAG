        <attvalues>
          <attvalue for="11" value="IS_APPROXIMATED_BY" />
          <attvalue for="12" value="The Friedel spacings (λ₁ and λ₂) can be approximated by the square lattice spacing (L)." />
          <attvalue for="13" value="The Friedel spacings, λ₁ and λ₂, are now equal, and can be approximated by the square lattice spacing, L." />
