        <attvalues>
          <attvalue for="11" value="HAS_LOWER_CONTENT_OF" />
          <attvalue for="12" value="The content of Al is generally lower in wrought superalloys." />
          <attvalue for="13" value="elements Al and Ti are generally lower, and Ta is not generally employed." />
