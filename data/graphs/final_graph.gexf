      <edge source="chunk-2e04fd0a8a6174c1165f0c60c65b783d-e-5" target="chunk-bf602d6d22c552a1206d1179123ca1f7-e-3" id="chunk-2e04fd0a8a6174c1165f0c60c65b783d-r-8" weight="4.0">
        <attvalues>
          <attvalue for="11" value="DEPENDS_ON" />
          <attvalue for="12" value="The calculation of compressive stress (σc) depends on the in-plane Young's Modulus (E||) as per Equation 5.3." />
          <attvalue for="13" value="σc = (π² / 12) * (E|| / (1 - ν²)) * (h/b)² (5.3)" />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-2e04fd0a8a6174c1165f0c60c65b783d" />
          <attvalue for="17" value="0.26666666666666666" />
        </attvalues>
