      <edge source="chunk-9b774f1b41192a64910256e8cc94923b-e-6" target="chunk-4fd900e79f8eed0adbe03897dc24fda9-e-1" id="chunk-4fd900e79f8eed0adbe03897dc24fda9-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_A" />
          <attvalue for="12" value="Carbon is identified as a grain-boundary element by the context of discussing optimum concentrations." />
          <attvalue for="13" value="When added in small quantities, grain-boundary elements such as boron and carbon are beneficial, particularly to the creep and low-cycle-fatigue resistances." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-4fd900e79f8eed0adbe03897dc24fda9" />
          <attvalue for="16" value="0.0017478152309612983" />
          <attvalue for="17" value="0.4010486891385768" />
        </attvalues>
      </edge>
      <edge source="chunk-9b774f1b41192a64910256e8cc94923b-e-6" target="chunk-9b774f1b41192a64910256e8cc94923b-e-2" id="chunk-6007146f18f54e1531784eefc3822dae-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="STRENGTHENS" />
          <attvalue for="12" value="Carbon is described as an element effective at strengthening grain boundaries." />
          <attvalue for="13" value="The optimum concentrations are approximately 0.03 wt%B and 0.025 wt%C; see Table 4.1." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-6007146f18f54e1531784eefc3822dae" />
          <attvalue for="16" value="0.0005617977528089887" />
          <attvalue for="17" value="0.40033707865168544" />
