      <edge source="chunk-8a09d4abdceadaee1556e78882f58629-e-1" target="chunk-8a09d4abdceadaee1556e78882f58629-e-5" id="chunk-8a09d4abdceadaee1556e78882f58629-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="PRODUCED_BY" />
          <attvalue for="12" value="The layering in the structure is produced by oscillating the DC bias." />
          <attvalue for="13" value="the layering being produced in this case by oscillating the d.c. bias applied to the substrate" />
