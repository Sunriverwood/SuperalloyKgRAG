        <attvalues>
          <attvalue for="11" value="EXPLAINS_BREAKDOWN_OF" />
          <attvalue for="12" value="The invalidity of the point obstacle approximation is one reason for the breakdown of the linear dependence." />
          <attvalue for="13" value="First, the point obstacle approximation is no longer valid, since the volume fraction, f, of γ' is then large." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-af1f9e9d18ac9effde532d2b56262cf6" />
