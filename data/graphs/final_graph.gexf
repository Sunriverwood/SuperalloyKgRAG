        <attvalues>
          <attvalue for="11" value="USES_CONVENTION" />
          <attvalue for="12" value="The calculation for S'11 is presented using reduced notation." />
          <attvalue for="13" value="Making use of the reduced notation, the new value of S11, denoted S'11, is given by" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-28445053586870da241f4ba6806f06eb" />
