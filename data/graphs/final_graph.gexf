      </node>
      <node id="chunk-27d4439c082e1df0f703012a02b14ffb-e-9" label="United States Patent 3819338">
        <attvalues>
          <attvalue for="0" value="United States Patent 3819338" />
          <attvalue for="1" value="Patent" />
          <attvalue for="2" value="美国专利US 3819338是由K. Bungardt、G. Lehnert和H. W. Meinhardt共同发明的一项技术专利。该专利公开了一种在镍和/或钴基合金表面形成保护性扩散层的技术，以增强合金材料的防护能力，提高其在高温或腐蚀环境下的耐用性。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;1974&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-27d4439c082e1df0f703012a02b14ffb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="117" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-27d4439c082e1df0f703012a02b14ffb-e-10" label="Protective diffusion layer on nickel and/or cobalt-based alloys">
        <attvalues>
          <attvalue for="0" value="Protective diffusion layer on nickel and/or cobalt-based alloys" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="一种应用于镍基和/或钴基合金的保护性扩散涂层，旨在增强基材在高温环境下的抗氧化与抗腐蚀性能。该涂层的具体成分、结构及制备方法由美国专利US3819338所公开和限定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-27d4439c082e1df0f703012a02b14ffb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="117" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
