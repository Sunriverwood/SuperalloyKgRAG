      <node id="chunk-e3a2ad2f86c91d0494cd03450bd94ade-e-11" label="Udimet 520">
        <attvalues>
          <attvalue for="0" value="Udimet 520" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="Udimet 520是一种可时效硬化的镍基高温合金。它具有卓越的高温强度、抗蠕变和耐腐蚀性能。该合金通常以锻造形式使用，是制造航空发动机和工业燃气轮机中的涡轮盘、叶片及其他关键热端部件的常用材料。" />
