        <attvalues>
          <attvalue for="11" value="REQUIRES" />
          <attvalue for="12" value="The industrial gas turbine sector will require further developments in processing." />
          <attvalue for="13" value="Whatever the balance of power between the aeroengine and industrial gas turbine sectors, it seems certain that further developments in superalloy metallurgy and processing will be required" />
          <attvalue for="14" value="r-9" />
          <attvalue for="15" value="chunk-af0a9cb061b4d858fd5a6c9a30785963" />
          <attvalue for="16" value="0.0018505667360629193" />
          <attvalue for="17" value="0.40111034004163776" />
        </attvalues>
      </edge>
