        </attvalues>
      </edge>
      <edge source="chunk-44ba0b547d89e889a875ab5cd81995c8-e-1" target="chunk-8981e8877dd5635849029e4451056d6d-e-2" id="chunk-5b67fbff0206633355ba0e17d910b688-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_A_RATIO_WITH" />
          <attvalue for="12" value="Homologous temperature (T/Tm) is a ratio calculated using the material's melting temperature (Tm)." />
          <attvalue for="13" value="homologous temperature T/Tm" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-5b67fbff0206633355ba0e17d910b688" />
