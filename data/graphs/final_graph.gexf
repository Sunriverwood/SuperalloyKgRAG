      <edge source="chunk-5c24b22e063be5dfa3ae3afab37099c6-e-5" target="chunk-5c24b22e063be5dfa3ae3afab37099c6-e-6" id="chunk-5c24b22e063be5dfa3ae3afab37099c6-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="EXHIBITS" />
          <attvalue for="12" value="Polycrystalline nickel is found to exhibit a fifth-power-law dependence of applied stress." />
          <attvalue for="13" value="For polycrystalline nickel, a fifth-power-law dependence of the applied stress for the steady-state ‘secondary' regime is found" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-5c24b22e063be5dfa3ae3afab37099c6" />
          <attvalue for="16" value="0.002873563218390805" />
          <attvalue for="17" value="0.4017241379310345" />
        </attvalues>
      </edge>
      <edge source="chunk-5c24b22e063be5dfa3ae3afab37099c6-e-6" target="chunk-5c24b22e063be5dfa3ae3afab37099c6-e-10" id="chunk-5c24b22e063be5dfa3ae3afab37099c6-r-7" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_RATIONALISED_BY" />
          <attvalue for="12" value="The fifth-power-law dependence can be explained by the balancing of dislocation processes." />
          <attvalue for="13" value="this can be rationalised by balancing dislocation annihilation and multiplication processes" />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-5c24b22e063be5dfa3ae3afab37099c6" />
          <attvalue for="16" value="0.041884360849878094" />
