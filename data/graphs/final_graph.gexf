      <edge source="chunk-ac23817ca85b5e2cba9cb1da3a1960fc-e-3" target="chunk-ac23817ca85b5e2cba9cb1da3a1960fc-e-4" id="chunk-ac23817ca85b5e2cba9cb1da3a1960fc-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_RADIUS_OF" />
          <attvalue for="12" value="r₂ is the radius of the particles along the second line." />
          <attvalue for="13" value="The radius of the particles along the first and second lines are r₁ and r₂." />
