      <node id="chunk-225043bdf7b58131b7138652c49cfca0-e-12" label="University of Birmingham">
        <attvalues>
          <attvalue for="0" value="University of Birmingham" />
          <attvalue for="1" value="Institution" />
          <attvalue for="2" value="伯明翰大学（University of Birmingham）是一所位于英国伯明翰的世界知名公立研究型大学，为英国罗素大学集团和“红砖大学”核心成员，在国际上享有崇高声誉。" />
