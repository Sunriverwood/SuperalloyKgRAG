        <attvalues>
          <attvalue for="11" value="DEVELOPS" />
          <attvalue for="12" value="Rolls-Royce is an engine manufacturer that has carried out alloy development work for turbine disc superalloys." />
          <attvalue for="13" value="Most of the alloy development work for turbine disc superalloys has been carried out by the engine manufacturers such as GE Aircraft Engines, Pratt &amp; Whitney, SNECMA and Rolls-Royce." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-972c0e045da978a7171f69472773ae6a" />
