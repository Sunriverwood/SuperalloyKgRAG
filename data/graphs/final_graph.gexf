        <attvalues>
          <attvalue for="11" value="CAUSES_BREAKDOWN_OF" />
          <attvalue for="12" value="When the parameter r¹/² becomes large, it causes the linear dependence to break down." />
          <attvalue for="13" value="However, as r¹/² becomes large, the linear dependence breaks down;" />
