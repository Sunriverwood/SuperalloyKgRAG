      <node id="chunk-398a384cc3aa286c4fab7654b4862802-e-2" label="Alloy system">
        <attvalues>
          <attvalue for="0" value="Alloy system" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="一种材料类别，特指一类能使特定方程（方程3.16）中各项参数保持恒定不变的材料集合。" />
