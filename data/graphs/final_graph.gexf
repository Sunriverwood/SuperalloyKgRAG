        <attvalues>
          <attvalue for="11" value="REQUIRES" />
          <attvalue for="12" value="Ultra-supercritical power stations require boiler tubing that can meet specific performance criteria." />
          <attvalue for="13" value="However, the latest generation of ultra-supercritical steam-generating coal-fired power stations requires boiler tubing that can last up to 200 000 hours at 750 °C and 100 MPa" />
          <attvalue for="14" value="r-1" />
