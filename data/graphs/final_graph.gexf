          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-557dabfd98e07916fb11233921ddc06d-e-4" label="Figure 1.12">
        <attvalues>
          <attvalue for="0" value="Figure 1.12" />
          <attvalue for="1" value="Diagram" />
          <attvalue for="2" value="图1.12是一个阐述特定热力学状况的示意图。该图的核心内容是图解“距离1–3”这一概念，以直观方式展现其在热力学环境中的关系或状态。" />
          <attvalue for="3" value="{}" />
