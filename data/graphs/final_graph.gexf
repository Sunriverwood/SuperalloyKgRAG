        <attvalues>
          <attvalue for="11" value="DOES_NOT_ACCOUNT_FOR" />
          <attvalue for="12" value="The approach relating a quantity to life consumed does not account for the driving force for interfacial crack growth." />
          <attvalue for="13" value="for example, the driving force for interfacial crack growth and the interfacial toughness remain unaccounted for." />
          <attvalue for="14" value="r-2" />
