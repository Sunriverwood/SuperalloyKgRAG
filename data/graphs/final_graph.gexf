      <node id="chunk-6e0983cf58b9c26b71630200f3b8184c-e-5" label="World's prosperity">
        <attvalues>
          <attvalue for="0" value="World's prosperity" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="全球繁荣（World's prosperity）是一个宏观概念，指代世界范围内的经济福祉与健康状态。它通常与全球经济增长、技术创新和生活水平的提高密切相关。例如，高温合金等先进工业材料的进步被认为是实现和维持这种繁荣的重要基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-6e0983cf58b9c26b71630200f3b8184c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6e0983cf58b9c26b71630200f3b8184c-e-6" label="Researchers and technologists">
        <attvalues>
          <attvalue for="0" value="Researchers and technologists" />
          <attvalue for="1" value="Role" />
          <attvalue for="2" value="指通过科学研究和技术应用，致力于开发并提升现代高温合金性能的专业人员群体。他们的工作是推动高温合金材料科学与工程发展的核心力量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-6e0983cf58b9c26b71630200f3b8184c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6e0983cf58b9c26b71630200f3b8184c-e-6&quot;, &quot;chunk-ff95c020d0eb3854d47176a924594dbf-e-1&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ff95c020d0eb3854d47176a924594dbf-e-3" label="Book">
        <attvalues>
          <attvalue for="0" value="Book" />
          <attvalue for="1" value="Document" />
          <attvalue for="2" value="一部介绍冶金学原理的入门著作，阐述了指导合金开发过程的基本原则与方法。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-ff95c020d0eb3854d47176a924594dbf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0898547a68d165adae5002ba87d72e05-e-4" label="The Book">
        <attvalues>
          <attvalue for="0" value="The Book" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一部关于高温材料的学术著作，专为材料科学与工程专业的高年级本科生及研究生编写，对机械工程、航空航天、物理和化学等相关学科的学生也具有重要的参考价值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0898547a68d165adae5002ba87d72e05" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="28" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-0898547a68d165adae5002ba87d72e05-e-6" label="Mechanical Engineering">
        <attvalues>
          <attvalue for="0" value="Mechanical Engineering" />
          <attvalue for="1" value="Academic Discipline" />
          <attvalue for="2" value="机械工程是应用物理学、材料科学等基础科学原理，对各类机械装置及系统进行研究、设计、制造、测试与维护的工程学科。它涉及力学、热力学、动力学等多个领域，是工业和制造业的核心基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0898547a68d165adae5002ba87d72e05" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="28" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0898547a68d165adae5002ba87d72e05-e-7" label="Aerospace Engineering">
        <attvalues>
          <attvalue for="0" value="Aerospace Engineering" />
          <attvalue for="1" value="Academic Discipline" />
          <attvalue for="2" value="航空航天工程是工程学的主要分支，致力于研究、设计、开发和测试在大气层内飞行的航空器（如飞机）与在外层空间运行的航天器（如火箭、卫星）。它综合了空气动力学、推进技术、结构力学和控制理论等多个科学领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-0898547a68d165adae5002ba87d72e05" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="28" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0898547a68d165adae5002ba87d72e05-e-8" label="Physics">
        <attvalues>
          <attvalue for="0" value="Physics" />
          <attvalue for="1" value="Academic Discipline" />
          <attvalue for="2" value="物理学是研究物质、能量、力及其运动规律的自然科学。它致力于理解从微观粒子到宏观宇宙的一切现象，揭示宇宙的基本构成与运行法则。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-0898547a68d165adae5002ba87d72e05" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="28" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0898547a68d165adae5002ba87d72e05-e-9" label="Chemistry">
        <attvalues>
          <attvalue for="0" value="Chemistry" />
          <attvalue for="1" value="Academic Discipline" />
          <attvalue for="2" value="化学是在原子和分子水平上，研究物质的组成、结构、性质、变化及其背后规律的自然科学。它被誉为“中心科学”，是连接物理学、生物学、地质学等其他自然科学的重要桥梁，为材料、能源、医药等领域提供基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-0898547a68d165adae5002ba87d72e05" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="28" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0898547a68d165adae5002ba87d72e05-e-10" label="Final-year undergraduate students">
        <attvalues>
          <attvalue for="0" value="Final-year undergraduate students" />
          <attvalue for="1" value="Audience" />
          <attvalue for="2" value="一个特定的学术受众群体，指处于本科学业最后一年，并选修了“高温材料技术”课程的学生。他们是为该课程开发的特定学术书籍的主要目标读者之一，该书旨在为其课程学习提供支持。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-0898547a68d165adae5002ba87d72e05" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0898547a68d165adae5002ba87d72e05-e-10&quot;]}]" />
          <attvalue for="9" value="28" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0898547a68d165adae5002ba87d72e05-e-11" label="High-temperature materials technology">
        <attvalues>
          <attvalue for="0" value="High-temperature materials technology" />
          <attvalue for="1" value="Academic Course" />
          <attvalue for="2" value="高温材料技术是一门面向高年级本科生的选修学术课程，旨在系统讲授耐高温材料的理论基础、制备工艺、性能表征及在航空航天、能源等领域的工程应用知识。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-0898547a68d165adae5002ba87d72e05" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0898547a68d165adae5002ba87d72e05-e-11&quot;]}]" />
          <attvalue for="9" value="28" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0898547a68d165adae5002ba87d72e05-e-12" label="Students embarking on a high...">
        <attvalues>
          <attvalue for="0" value="Students embarking on a high..." />
          <attvalue for="1" value="Audience" />
          <attvalue for="2" value="《The Book》的两个主要目标受众之一，特指即将开始高级阶段（如高中或大学）教育的学生群体。该书是为满足他们在这一学习阶段的特定需求而开发的。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-0898547a68d165adae5002ba87d72e05" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="28" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c1282ac66fd9c2c8ff0d43cddcd3f8a6-e-1" label="High-temperature materials technology">
        <attvalues>
          <attvalue for="0" value="High-temperature materials technology" />
          <attvalue for="1" value="Field of Study" />
          <attvalue for="2" value="高温材料技术是材料科学与工程的一个分支学科。该领域专注于研究在高温及苛刻环境下能够稳定服役的材料，及其设计、制备、加工、性能评估与应用。它对航空航天、能源、化工等工业至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-c1282ac66fd9c2c8ff0d43cddcd3f8a6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c1282ac66fd9c2c8ff0d43cddcd3f8a6-e-1&quot;]}]" />
          <attvalue for="9" value="60" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c1282ac66fd9c2c8ff0d43cddcd3f8a6-e-2" label="Students">
        <attvalues>
          <attvalue for="0" value="Students" />
          <attvalue for="1" value="Audience" />
          <attvalue for="2" value="指学习《高温材料技术》的特定学生受众。该群体涵盖了选修相关课程的本科生以及攻读更高学位的研究生，他们是该领域教学材料的目标读者，并通过回答问题来检验其学习成果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c1282ac66fd9c2c8ff0d43cddcd3f8a6" />
