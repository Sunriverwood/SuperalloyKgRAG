        <attvalues>
          <attvalue for="11" value="REDUCES" />
          <attvalue for="12" value="The layered structures are claimed to achieve a reduction in thermal conductivity (κ)." />
          <attvalue for="13" value="with reductions of about 40% in κ being claimed" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-8a09d4abdceadaee1556e78882f58629" />
          <attvalue for="16" value="0.0018203502604983992" />
