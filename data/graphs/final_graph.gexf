        <attvalues>
          <attvalue for="11" value="IS_STATE_OF" />
          <attvalue for="12" value="The TBC exists in an as-deposited state where it resists delamination due to insufficient energy density." />
          <attvalue for="13" value="thus in the as-deposited state there is insufficient energy density to delaminate the TBC." />
          <attvalue for="14" value="r-2" />
