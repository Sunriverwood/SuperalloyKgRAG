      <node id="chunk-aaf1405fdcaab5726ea1519f7e18e407-e-6" label="Closely spaced, larger particles">
        <attvalues>
          <attvalue for="0" value="Closely spaced, larger particles" />
          <attvalue for="1" value="Material Microstructure" />
          <attvalue for="2" value="材料微观结构中尺寸较大且间距紧密的颗粒相。它们作为障碍物，通过阻碍前沿位错的移动来产生钉扎力，是实现材料弥散强化（或沉淀强化）的关键机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-aaf1405fdcaab5726ea1519f7e18e407" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-aaf1405fdcaab5726ea1519f7e18e407-e-8" label="Line tension">
        <attvalues>
          <attvalue for="0" value="Line tension" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="线张力是位错线的一种物理性质，指其单位长度所具有的能量。它使位错线表现得像一根拉伸的弹性弦，总倾向于收缩变直以降低自身能量。当位错在钉扎点之间受力弓出时，线张力会产生一个与弯曲方向相反的恢复力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-aaf1405fdcaab5726ea1519f7e18e407" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Line Tension&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-aaf1405fdcaab5726ea1519f7e18e407-e-8&quot;, &quot;chunk-62e0b88322cda2b3939ddacaff16f02d-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-62e0b88322cda2b3939ddacaff16f02d-e-3" label="Trailing Dislocation">
        <attvalues>
          <attvalue for="0" value="Trailing Dislocation" />
          <attvalue for="1" value="Dislocation" />
          <attvalue for="2" value="后行位错（Trailing Dislocation）是一种不全位错，它由一个全位错分解产生。它总是跟在一个前行位错（Leading Dislocation）之后，两者共同包围着一个堆垛层错区域。当位错移动时，后行位错的作用是消除堆垛层错，从而恢复其扫过区域的完整晶体结构。" />
          <attvalue for="3" value="{&quot;shape&quot;: &quot;straight&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-62e0b88322cda2b3939ddacaff16f02d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Second Dislocation&quot;, &quot;Trailing dislocation&quot;, &quot;second trailing dislocation&quot;, &quot;trailing dislocation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6c8bf2ccc7af91368e39bedeb76382ef-e-4&quot;, &quot;chunk-a478184a271f81c44b621f35badc5f0a-e-6&quot;, &quot;chunk-62e0b88322cda2b3939ddacaff16f02d-e-3&quot;, &quot;chunk-02948169a54de26c861e1fa5741b30de-e-2&quot;, &quot;chunk-bc7ac356d3b96aa45f10f8864536d6bf-e-7&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-62e0b88322cda2b3939ddacaff16f02d-e-5" label="Particle">
        <attvalues>
          <attvalue for="0" value="Particle" />
          <attvalue for="1" value="Material Feature" />
          <attvalue for="2" value="在材料科学中，这是一种作为位错运动障碍物的微观结构特征。位错线在运动中会被其暂时钉扎，当外加应力足够大时，位错会从此粒子上挣脱或“解链”式地脱离，这一过程是影响材料强度的关键机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-62e0b88322cda2b3939ddacaff16f02d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-62e0b88322cda2b3939ddacaff16f02d-e-5&quot;, &quot;chunk-2863217e233dc47e4fc60478978f8746-e-2&quot;, &quot;chunk-171c1deb2bffaad5a637104b101eb41f-e-6&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-62e0b88322cda2b3939ddacaff16f02d-e-6" label="2r₂/λ₂">
        <attvalues>
          <attvalue for="0" value="2r₂/λ₂" />
          <attvalue for="1" value="Mathematical Ratio" />
          <attvalue for="2" value="2r₂/λ₂是一个与尾随位错（Trailing Dislocation）相关的数学比率，在特定物理或材料学背景下使用。该比率通常被近似或等同于符号“f”，用于量化位错动力学中的特定关系。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;f&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-62e0b88322cda2b3939ddacaff16f02d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-62e0b88322cda2b3939ddacaff16f02d-e-6&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-62e0b88322cda2b3939ddacaff16f02d-e-7" label="2r₁/λ₁">
        <attvalues>
          <attvalue for="0" value="2r₁/λ₁" />
          <attvalue for="1" value="Mathematical Ratio" />
          <attvalue for="2" value="**2r₁/λ₁** 是一个与前沿位错相关的无量纲数学比率。它通常定义为位错核心直径（2r₁）与某个特征长度（λ₁，如位错间距）的比值，是分析材料微观结构和力学行为的重要估算参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-62e0b88322cda2b3939ddacaff16f02d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-62e0b88322cda2b3939ddacaff16f02d-e-7&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-62e0b88322cda2b3939ddacaff16f02d-e-8" label="f">
        <attvalues>
          <attvalue for="0" value="f" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="变量 f 是一个由公式 f = 2r₂/λ₂ 定义的数学量，代表 r₂ 的两倍与 λ₂ 的比值。" />
          <attvalue for="3" value="{}" />
