        </attvalues>
      </node>
      <node id="chunk-5d1954b761cf7718ff2558f9e10a2fac-e-9" label="Industrial gas turbines: challenges for the future">
        <attvalues>
          <attvalue for="0" value="Industrial gas turbines: challenges for the future" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Industrial gas turbines: challenges for the future》是由F. Carchedi撰写的一篇科技论文。该文探讨了工业燃气轮机未来面临的挑战，并被收录于《Parsons 2003: Engineering Issues in Turbine Machinery, Power Plant and Renewables》会议论文集中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-5d1954b761cf7718ff2558f9e10a2fac" />
