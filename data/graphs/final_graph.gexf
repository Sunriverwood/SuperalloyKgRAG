          <attvalue for="9" value="157" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-12" label="vane">
        <attvalues>
          <attvalue for="0" value="vane" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种名为“vane”的组件，其常用缩写形式为“V”。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-f2dcbd0ede6add46d4e0540d9a794efa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="157" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f2dcbd0ede6add46d4e0540d9a794efa-e-13" label="C">
        <attvalues>
          <attvalue for="0" value="C" />
          <attvalue for="1" value="Symbol" />
          <attvalue for="2" value="作为符号，C是常量的通用表示。在数学中，它常用于指代一个任意常数，特别是在微积分中，C是积分常数的标准符号。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-f2dcbd0ede6add46d4e0540d9a794efa" />
