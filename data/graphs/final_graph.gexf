        <attvalues>
          <attvalue for="11" value="IMPROVES" />
          <attvalue for="12" value="Higher operating conditions result in improved fuel economy." />
          <attvalue for="13" value="since fuel economy is improved and carbon emissions are reduced by the higher operating conditions so afforded." />
