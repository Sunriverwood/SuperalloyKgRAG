        <attvalues>
          <attvalue for="0" value="Dr Bruce Pint" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="Bruce Pint博士，美国科学家，任职于美国橡树岭国家实验室（Oak Ridge National Laboratory）。" />
