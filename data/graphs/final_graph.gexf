        <attvalues>
          <attvalue for="11" value="BEGINS_WITH" />
          <attvalue for="12" value="The oxidation process starts with the formation of Ni(Al, Cr)2O4." />
          <attvalue for="13" value="Oxidation begins with the formation of Ni(Al, Cr)2O4, which is rapidly overtaken by a brittle, outward-growing NiO scale" />
          <attvalue for="14" value="r-4" />
