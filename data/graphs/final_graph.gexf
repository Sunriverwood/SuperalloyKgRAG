          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-65dc63e5f84c9fe26415a54961f65c33-e-8" label="C. Leyens">
        <attvalues>
          <attvalue for="0" value="C. Leyens" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="C. Leyens，材料科学领域的学者，是科技论文《Influence of substrate material on oxidation behaviour and cyclic lifetime of EB-PVD TBC systems》的作者之一，该研究聚焦于热障涂层(TBC)的性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-65dc63e5f84c9fe26415a54961f65c33" />
