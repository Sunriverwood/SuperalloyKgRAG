        <attvalues>
          <attvalue for="11" value="OCCURS_AT" />
          <attvalue for="12" value="Low-cycle-fatigue cracking occurs at sites of stress concentration near the bore." />
          <attvalue for="13" value="Traditionally, superalloy turbine discs were designed to resist general yielding and low- cycle-fatigue cracking at sites of stress concentration near the bore" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-024c36ea3394fc7ba3bfdd8df0168497" />
          <attvalue for="16" value="0.0013574660633484162" />
