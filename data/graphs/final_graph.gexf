        <attvalues>
          <attvalue for="11" value="IS_LARGEST_DURING" />
          <attvalue for="12" value="The Turbine Entry Temperature (TET) is at its maximum during the take-off and climb phases of a flight." />
          <attvalue for="13" value="being largest during the take-off and climb to cruising altitude." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-463ddd0dbebb2a2fc18f797d9effe3e6" />
          <attvalue for="16" value="0.0017112017901803344" />
          <attvalue for="17" value="0.40102672107410825" />
