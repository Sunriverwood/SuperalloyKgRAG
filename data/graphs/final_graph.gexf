      <node id="chunk-225043bdf7b58131b7138652c49cfca0-e-17" label="Professor Tresa Pollock">
        <attvalues>
          <attvalue for="0" value="Professor Tresa Pollock" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="Tresa Pollock是一位美国材料科学家，美国国家工程院院士。她现任加州大学圣巴巴拉分校材料系的ALCOA杰出教授，主要研究领域为先进金属合金和高温材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-17" />
