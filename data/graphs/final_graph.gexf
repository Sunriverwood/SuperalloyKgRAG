        <attvalues>
          <attvalue for="11" value="DEFINES" />
          <attvalue for="12" value="The constitutive equations (A1) define the stress components (e.g., σ11) as a function of strain and elastic constants." />
          <attvalue for="13" value="σ11 = C11€11 + C12€22 + C12€33" />
