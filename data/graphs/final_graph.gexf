        <attvalues>
          <attvalue for="11" value="USED_FOR" />
          <attvalue for="12" value="Powder metallurgy (P/M) superalloys were first introduced for high-pressure turbine discs." />
          <attvalue for="13" value="A consideration of powder metallurgy (P/M) superalloys – first introduced for high- pressure turbine discs" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-2582edaf6620b68f12a09bd6df3bb24c" />
