        <attvalues>
          <attvalue for="11" value="ACCELERATES" />
          <attvalue for="12" value="Most of the useful work from the core is used to accelerate the bypass air via the fan." />
          <attvalue for="13" value="Most of the useful work developed by the core of the engine is used to accelerate a much greater mass of air through a fan to a modest exit velocity." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-cdeb193bdb0bc0bd0987151c84c2d210" />
