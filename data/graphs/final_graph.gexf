      <edge source="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-1" target="chunk-4d2bc3be978842eac31d6c74bc19bb3f-e-5" id="chunk-ae58c0f988aba111d22bb6ff5c500655-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="ASSOCIATED_WITH" />
          <attvalue for="12" value="Failure is linked to the presence of ceramic inclusions." />
          <attvalue for="13" value="Second, failure is found to be associated with ceramic inclusions – typically Al2O3 or SiO2 – which are inherited from the processing route." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-ae58c0f988aba111d22bb6ff5c500655" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-1" target="chunk-dc7beb2c110a0e2f253f174dddd75d00-e-3" id="chunk-8a91b63add4adbc77d4752d41b7c75aa-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="AFFECTS" />
          <attvalue for="12" value="Failure is described as a phenomenon affecting superalloy components in service." />
          <attvalue for="13" value="failure of superalloy components in service 5-8" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-8a91b63add4adbc77d4752d41b7c75aa" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-4" target="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-1" id="chunk-8b5f0089753028d4f74bf5d1c1d40143-r-3" weight="4.0">
        <attvalues>
          <attvalue for="11" value="IS_MECHANISM_OF" />
          <attvalue for="12" value="Localised plastic deformation is the underlying reason for the failure under nominally elastic stresses." />
          <attvalue for="13" value="This is because plastic deformation can occur in a very localised sense, typically near sites of stress concentration" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="17" value="0.26666666666666666" />
        </attvalues>
      </edge>
      <edge source="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-4" target="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-5" id="chunk-8b5f0089753028d4f74bf5d1c1d40143-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="OCCURS_NEAR" />
          <attvalue for="12" value="Plastic deformation typically occurs near sites of stress concentration." />
          <attvalue for="13" value="plastic deformation can occur in a very localised sense, typically near sites of stress concentration" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="16" value="0.00020614306328592042" />
          <attvalue for="17" value="0.4001236858379716" />
        </attvalues>
      </edge>
      <edge source="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-4" target="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-6" id="chunk-8b5f0089753028d4f74bf5d1c1d40143-r-5" weight="4.0">
        <attvalues>
          <attvalue for="11" value="RESULTS_IN" />
          <attvalue for="12" value="Localised plastic deformation leads to fatigue damage in the form of slip." />
          <attvalue for="13" value="This is because plastic deformation can occur in a very localised sense... this fatigue damage is most often in the form of intense, localised slip" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="16" value="0.0006184291898577612" />
          <attvalue for="17" value="0.2670377241805813" />
        </attvalues>
      </edge>
      <edge source="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-4" target="chunk-740f6c1fef49d66e9d25ef0e2de914da-e-3" id="chunk-740f6c1fef49d66e9d25ef0e2de914da-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DRIVES" />
          <attvalue for="12" value="The plastic strain is available to drive the fatigue process." />
          <attvalue for="13" value="the plastic strain available to drive the fatigue process is correspondingly greater" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-740f6c1fef49d66e9d25ef0e2de914da" />
          <attvalue for="16" value="0.00020614306328592042" />
          <attvalue for="17" value="0.4001236858379716" />
        </attvalues>
      </edge>
      <edge source="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-4" target="chunk-740f6c1fef49d66e9d25ef0e2de914da-e-4" id="chunk-740f6c1fef49d66e9d25ef0e2de914da-r-3" weight="4.0">
        <attvalues>
          <attvalue for="11" value="CAUSES" />
          <attvalue for="12" value="Greater plastic strain results in the display of poorer properties." />
          <attvalue for="13" value="the plastic strain available to drive the fatigue process is correspondingly greater, so that poorer properties are displayed." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-740f6c1fef49d66e9d25ef0e2de914da" />
          <attvalue for="16" value="0.00020614306328592042" />
          <attvalue for="17" value="0.26679035250463823" />
        </attvalues>
      </edge>
      <edge source="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-6" target="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-7" id="chunk-8b5f0089753028d4f74bf5d1c1d40143-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="INVOLVES" />
          <attvalue for="12" value="Fatigue damage, in the form of slip, involves dislocation activity." />
          <attvalue for="13" value="this fatigue damage is most often in the form of intense, localised slip with the dislocation activity restricted to a small number of lattice planes" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="16" value="0.003916718202432488" />
          <attvalue for="17" value="0.4023500309214595" />
        </attvalues>
      </edge>
      <edge source="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-7" target="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-8" id="chunk-8b5f0089753028d4f74bf5d1c1d40143-r-7" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_RESTRICTED_TO" />
          <attvalue for="12" value="Dislocation activity is restricted to a small number of lattice planes." />
          <attvalue for="13" value="with the dislocation activity restricted to a small number of lattice planes [68]." />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="16" value="0.0020614306328592042" />
          <attvalue for="17" value="0.40123685837971557" />
        </attvalues>
      </edge>
      <edge source="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-9" target="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-6" id="chunk-8b5f0089753028d4f74bf5d1c1d40143-r-8" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_TERM_FOR" />
          <attvalue for="12" value="'Cyclic slip localisation' is the term for the phenomenon of fatigue damage characterized by intense, localised slip." />
          <attvalue for="13" value="This phenomenon is often referred to as 'cyclic slip localisation'" />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="16" value="0.00494743351886209" />
          <attvalue for="17" value="0.40296846011131726" />
        </attvalues>
      </edge>
      <edge source="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-9" target="chunk-810fb1ebfd1f2112fedd829e635a8739-e-4" id="chunk-ef56fb2a5c4451551a2024d8490545ff-r-1" weight="4.0">
        <attvalues>
          <attvalue for="11" value="INFLUENCES" />
          <attvalue for="12" value="Less intense cyclic slip localisation results in more homogeneous deformation." />
          <attvalue for="13" value="cyclic slip localisation is less intense; thus deformation is more homogeneous" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-ef56fb2a5c4451551a2024d8490545ff" />
          <attvalue for="17" value="0.26666666666666666" />
        </attvalues>
      </edge>
      <edge source="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-9" target="chunk-8a91b63add4adbc77d4752d41b7c75aa-e-5" id="chunk-8a91b63add4adbc77d4752d41b7c75aa-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_A_MECHANISM_OF" />
          <attvalue for="12" value="Cyclic slip localisation is listed as a mechanism under the topic of fatigue." />
          <attvalue for="13" value="fatigue ... cyclic slip localisation 187" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-8a91b63add4adbc77d4752d41b7c75aa" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-10" target="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-9" id="chunk-8b5f0089753028d4f74bf5d1c1d40143-r-9" weight="5.0">
        <attvalues>
          <attvalue for="11" value="ENCOURAGES" />
          <attvalue for="12" value="Temperatures around 700 °C encourage the phenomenon of cyclic slip localisation." />
          <attvalue for="13" value="particularly at temperatures of around 700 °C and when stresses are high this encourages" />
          <attvalue for="14" value="r-9" />
          <attvalue for="15" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="16" value="0.005359719645433931" />
          <attvalue for="17" value="0.4032158317872604" />
        </attvalues>
      </edge>
      <edge source="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-11" target="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-9" id="chunk-8b5f0089753028d4f74bf5d1c1d40143-r-10" weight="5.0">
        <attvalues>
          <attvalue for="11" value="ENCOURAGES" />
          <attvalue for="12" value="High stresses encourage the phenomenon of cyclic slip localisation." />
          <attvalue for="13" value="particularly at temperatures of around 700 °C and when stresses are high this encourages" />
          <attvalue for="14" value="r-10" />
          <attvalue for="15" value="chunk-8b5f0089753028d4f74bf5d1c1d40143" />
          <attvalue for="16" value="0.00041228612657184083" />
          <attvalue for="17" value="0.40024737167594315" />
        </attvalues>
      </edge>
      <edge source="chunk-da09b64f941acad7c5dafb6cd99e1895-e-1" target="chunk-da09b64f941acad7c5dafb6cd99e1895-e-2" id="chunk-da09b64f941acad7c5dafb6cd99e1895-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="SHEARS" />
          <attvalue for="12" value="Persistent Slip Bands (PSBs) shear the γ' particles." />
          <attvalue for="13" value="‘persistent slip bands' (PSBs) which shear the γ' particles [69]; see Figure 3.69." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-da09b64f941acad7c5dafb6cd99e1895" />
          <attvalue for="16" value="0.0027315479710512233" />
          <attvalue for="17" value="0.40163892878263074" />
        </attvalues>
      </edge>
      <edge source="chunk-da09b64f941acad7c5dafb6cd99e1895-e-2" target="chunk-1af21239034eac9b97020a65cbbdcded-e-3" id="chunk-0dac1108ee01fd25c7f627485d2972e6-r-3" weight="4.0">
        <attvalues>
          <attvalue for="11" value="INFLUENCES" />
          <attvalue for="12" value="The increase in FCP rate is attributed to the dissolution of larger γ' particles and the reprecipitation of smaller ones." />
          <attvalue for="13" value="this can be attributed to the dissolution of the larger γ' particles and the reprecipitation of smaller ones upon cooling." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-0dac1108ee01fd25c7f627485d2972e6" />
          <attvalue for="17" value="0.26666666666666666" />
        </attvalues>
      </edge>
      <edge source="chunk-da09b64f941acad7c5dafb6cd99e1895-e-2" target="chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-11" id="chunk-6c8bf2ccc7af91368e39bedeb76382ef-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="STRENGTHENING_ANALYZED_BY" />
          <attvalue for="12" value="The strengthening effect from γ' particles is analyzed by considering the case of 'weakly coupled' dislocations." />
          <attvalue for="13" value="In order to develop expressions for the strengthening expected from γ' particles of volume fraction f, the case of 'weakly coupled' dislocations [48] is considered first" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-6c8bf2ccc7af91368e39bedeb76382ef" />
          <attvalue for="16" value="0.021827743516093605" />
          <attvalue for="17" value="0.4130966461096562" />
        </attvalues>
      </edge>
      <edge source="chunk-da09b64f941acad7c5dafb6cd99e1895-e-2" target="chunk-a478184a271f81c44b621f35badc5f0a-e-1" id="chunk-2a630be2b8090ec92842cc9c1737eb42-r-2" weight="4.0">
        <attvalues>
          <attvalue for="11" value="AFFECTS_SPACING_OF" />
          <attvalue for="12" value="The diameter of large γ' particles becomes comparable to the spacing of dislocation pairs." />
          <attvalue for="13" value="When the γ' particles are large, as will be the case for the over-aged condition, the spacing of the dislocation pairs becomes comparable to the particle diameter." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-2a630be2b8090ec92842cc9c1737eb42" />
          <attvalue for="16" value="0.0007392075694855116" />
          <attvalue for="17" value="0.267110191208358" />
        </attvalues>
      </edge>
      <edge source="chunk-da09b64f941acad7c5dafb6cd99e1895-e-2" target="chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-9" id="chunk-2a630be2b8090ec92842cc9c1737eb42-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CONTAINS" />
          <attvalue for="12" value="A large γ' particle may contain a pair of dislocations, which are then defined as 'strongly coupled'." />
          <attvalue for="13" value="Thus, any given particle may contain a pair of dislocations which are now ‘strongly coupled’" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-2a630be2b8090ec92842cc9c1737eb42" />
          <attvalue for="16" value="0.004774342222597692" />
          <attvalue for="17" value="0.4028646053335586" />
        </attvalues>
      </edge>
      <edge source="chunk-da09b64f941acad7c5dafb6cd99e1895-e-3" target="chunk-8b5f0089753028d4f74bf5d1c1d40143-e-5" id="chunk-da09b64f941acad7c5dafb6cd99e1895-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="ORIGINATES_AT" />
          <attvalue for="12" value="Fatigue initiation can be traced to sites of stress concentration." />
          <attvalue for="13" value="Fatigue initiation can always be traced to sites of stress concentration, for example casting pores or machining marks." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-da09b64f941acad7c5dafb6cd99e1895" />
          <attvalue for="16" value="0.00020614306328592042" />
          <attvalue for="17" value="0.4001236858379716" />
        </attvalues>
      </edge>
      <edge source="chunk-da09b64f941acad7c5dafb6cd99e1895-e-3" target="chunk-ef56fb2a5c4451551a2024d8490545ff-e-5" id="chunk-ef56fb2a5c4451551a2024d8490545ff-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="OCCURS_AT" />
          <attvalue for="12" value="Fatigue initiation can occur at surface pits." />
          <attvalue for="13" value="fatigue initiation occurs at surface pits or cracks in the oxide films" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-ef56fb2a5c4451551a2024d8490545ff" />
          <attvalue for="16" value="0.00020614306328592042" />
          <attvalue for="17" value="0.4001236858379716" />
        </attvalues>
      </edge>
      <edge source="chunk-da09b64f941acad7c5dafb6cd99e1895-e-3" target="chunk-ef56fb2a5c4451551a2024d8490545ff-e-6" id="chunk-ef56fb2a5c4451551a2024d8490545ff-r-4" weight="5.0">
        <attvalues>
          <attvalue for="11" value="OCCURS_AT" />
          <attvalue for="12" value="Fatigue initiation can occur at cracks in the oxide films." />
          <attvalue for="13" value="fatigue initiation occurs at surface pits or cracks in the oxide films" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-ef56fb2a5c4451551a2024d8490545ff" />
          <attvalue for="16" value="0.0018552875695732837" />
          <attvalue for="17" value="0.401113172541744" />
        </attvalues>
      </edge>
      <edge source="chunk-da09b64f941acad7c5dafb6cd99e1895-e-3" target="chunk-97f22587e687782a5433110f85b94c9e-e-7" id="chunk-97f22587e687782a5433110f85b94c9e-r-5" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CONTROLS" />
