          <attvalue for="12" value="The scatter factor of 6, defined as the ratio of fatigue lives at +3σ and -3σ, describes the variability of the number of cycles to failure." />
          <attvalue for="13" value="the ratio of the fatigue lives at the +3σ and −3σ points is 6" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-499702b336b2277c0acd3c75976b9758" />
          <attvalue for="16" value="0.005263157894736842" />
