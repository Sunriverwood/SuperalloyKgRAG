        <attvalues>
          <attvalue for="11" value="RESIDES_IN" />
          <attvalue for="12" value="Carbon (C) is believed to reside primarily in M23C6 carbides within the alloy under study." />
          <attvalue for="13" value="it is probable that in this alloy it resides primarily in chromium-rich M23C6 carbides." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-b674e36d570cafb7928d33912e7c1b02" />
