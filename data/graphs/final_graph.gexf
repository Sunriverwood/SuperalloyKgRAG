      <edge source="chunk-11623a127f67a421f15bdd1ebd79d8af-e-3" target="chunk-35e59a51ed8121212e1426f0053ba534-e-10" id="chunk-cdeb193bdb0bc0bd0987151c84c2d210-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="RESOLVES_ISSUE_OF" />
          <attvalue for="12" value="The bypass design is presented as the solution to the problem of propulsive efficiency being very low." />
          <attvalue for="13" value="The only way around this dilemma is to use a bypass design." />
