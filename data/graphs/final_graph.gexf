      <node id="chunk-d6790fb9c1169445a5d3fb409c8aba9c-e-7" label="p1">
        <attvalues>
          <attvalue for="0" value="p1" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="一个变量，指在特定条件 d=0 成立时，变量 p2 所对应的数值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d6790fb9c1169445a5d3fb409c8aba9c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d6790fb9c1169445a5d3fb409c8aba9c-e-9" label="d/D">
        <attvalues>
          <attvalue for="0" value="d/D" />
          <attvalue for="1" value="Ratio" />
          <attvalue for="2" value="d/D是一个用于量化材料或构件中缺陷相对尺寸的无量纲参数。其值趋近于零表示缺陷的消失，是评估和实现材料无限寿命（Infinite Life）的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-d6790fb9c1169445a5d3fb409c8aba9c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d6790fb9c1169445a5d3fb409c8aba9c-e-9&quot;, &quot;chunk-bf4677fbc731927f738fe825e4a4dab8-e-1&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d6790fb9c1169445a5d3fb409c8aba9c-e-10" label="Figure 4.46">
        <attvalues>
          <attvalue for="0" value="Figure 4.46" />
          <attvalue for="1" value="Figure" />
          <attvalue for="2" value="图4.46是文档中引用的一个示意图，旨在通过可视化的方式，直观阐释特定比例值d/Di的含义、数值关系或变化趋势。" />
          <attvalue for="3" value="{}" />
