      </node>
      <node id="chunk-28027332c1e907d2b9fb62cbdc68fd6c-e-6" label="Physical vapour deposition processes">
        <attvalues>
          <attvalue for="0" value="Physical vapour deposition processes" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Physical vapour deposition processes》是D. H. Boone撰写的文章，1986年发表于期刊《Materials Science and Technology》。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-28027332c1e907d2b9fb62cbdc68fd6c" />
          <attvalue for="6" value="true" />
