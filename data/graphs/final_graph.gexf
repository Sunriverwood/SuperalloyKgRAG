        <attvalues>
          <attvalue for="11" value="ACCOUNTS_FOR" />
          <attvalue for="12" value="Physically based laws should ideally account for microstructural effects." />
          <attvalue for="13" value="physically based laws which... ideally, account for the microstructural effects" />
