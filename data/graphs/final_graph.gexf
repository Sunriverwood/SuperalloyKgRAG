          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e780ac83d97fe15870adf76ec9226ed9-e-7&quot;, &quot;chunk-be8d9004ced79264b7784b3065b5da94-e-1&quot;]}]" />
          <attvalue for="9" value="6" />
