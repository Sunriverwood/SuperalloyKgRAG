      <node id="chunk-cb57093a6357773efc0ab02b57f76fa1-e-20" label="NASA">
        <attvalues>
          <attvalue for="0" value="NASA" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="美国国家航空航天局（National Aeronautics and Space Administration, NASA）是美国联邦政府的一个独立机构，负责制定和实施美国的民用太空计划及航空科学研究。它成立于1958年，致力于太空探索、科学发现和技术创新，主导了阿波罗登月、国际空间站及火星探测等众多里程碑式的任务。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-20" />
          <attvalue for="5" value="chunk-cb57093a6357773efc0ab02b57f76fa1" />
          <attvalue for="6" value="true" />
