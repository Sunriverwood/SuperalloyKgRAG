        <attvalues>
          <attvalue for="11" value="HAS_ALTERABLE_BOUNDARY_WITH" />
          <attvalue for="12" value="The boundary between Group II and Group III alloy behavior can change with temperature, heating rate, and grain size." />
          <attvalue for="13" value="...it should be noted that the I/III, II/III and I/II boundaries can alter with temperature, heating rate and grain size." />
          <attvalue for="14" value="r-12" />
          <attvalue for="15" value="chunk-b01056d7d0ec300f60d9bb3706353f8f" />
