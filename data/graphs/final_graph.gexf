        <attvalues>
          <attvalue for="11" value="CALCULATES" />
          <attvalue for="12" value="The described procedure allows a 'safe life' to be calculated." />
          <attvalue for="13" value="This procedure allows a so-called 'safe life' to be calculated" />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-cae41d8859f876b74046ac829e1e4b4c" />
          <attvalue for="16" value="0.039473684210526314" />
