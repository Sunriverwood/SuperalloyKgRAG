      <node id="chunk-c026408b0eb125d3c56d1ed05d0a0f15-e-4" label="Monocrystalline Ni–Al alloys">
        <attvalues>
          <attvalue for="0" value="Monocrystalline Ni–Al alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="单晶镍铝合金是一种由镍和铝组成的单晶金属材料。作为一种典型的时效硬化合金，其硬化数据证实了材料强化效果与析出相尺寸（r）之间存在r¹/²依赖关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c026408b0eb125d3c56d1ed05d0a0f15" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c026408b0eb125d3c56d1ed05d0a0f15-e-5" label="Data [48]">
        <attvalues>
          <attvalue for="0" value="Data [48]" />
          <attvalue for="1" value="Data Source" />
          <attvalue for="2" value="一个被引证为[48]的数据源。该数据集通过实验数据，证实了在镍铝(Ni-Al)合金中特定物理量与半径的平方根(r¹/²)之间存在依赖关系，为相关理论提供了依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c026408b0eb125d3c56d1ed05d0a0f15" />
