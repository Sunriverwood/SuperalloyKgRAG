      <node id="chunk-ae682ac4e4eb339bd48233482011cdd1-e-8" label="Nimonic 90">
        <attvalues>
          <attvalue for="0" value="Nimonic 90" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="Nimonic 90是一种镍-铬- cobalt基沉淀硬化型高温合金，属于Nimonic合金系列。它具有卓越的高温强度和抗蠕变性能，主要用于制造燃气轮机叶片、碟盘和航空发动机的高温承力部件。" />
