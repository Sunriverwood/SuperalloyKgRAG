      <node id="chunk-257439916abb1d8e8959f74997de355a-e-4" label="Volume fraction of inclusions">
        <attvalues>
          <attvalue for="0" value="Volume fraction of inclusions" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="夹杂物体积分数是一种关键材料属性，定义为材料内部夹杂物所占体积与材料总体积的比值，是衡量材料纯净度的重要指标。该无量纲数值通常通过分析材料的二维横截面来估算，其结果的可靠性由准确度和置信度等指标进行评估。" />
          <attvalue for="3" value="{&quot;example_value&quot;: &quot;10-6&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-257439916abb1d8e8959f74997de355a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-257439916abb1d8e8959f74997de355a-e-5" label="Accuracy">
        <attvalues>
          <attvalue for="0" value="Accuracy" />
          <attvalue for="1" value="Statistical Parameter" />
          <attvalue for="2" value="一个统计参数，用于定义估算“夹杂物体积分数”时所要求达到的精密度。它量化了估算结果与真实值之间的接近程度，是衡量该估算过程可靠性的关键指标。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;greater than 20%&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-257439916abb1d8e8959f74997de355a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-257439916abb1d8e8959f74997de355a-e-6" label="Confidence">
        <attvalues>
          <attvalue for="0" value="Confidence" />
          <attvalue for="1" value="Statistical Parameter" />
          <attvalue for="2" value="一个统计参数，用于量化“夹杂物体积分数”估计结果的可靠程度。它表示在多次重复抽样下，所构造的置信区间包含该参数真实值的概率（即置信水平）。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;80%&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-257439916abb1d8e8959f74997de355a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-257439916abb1d8e8959f74997de355a-e-7" label="Diameter">
        <attvalues>
          <attvalue for="0" value="Diameter" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="直径（Diameter, D）是一个物理属性，指通过球体中心、连接球面上两点的直线段的长度。它被用来精确描述和量化球形物体的尺寸。在此上下文中，它特指尺寸均一的球形夹杂物的大小。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;100 µm&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-257439916abb1d8e8959f74997de355a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Diameter, D&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a6a0b0d2c85b7b920c33d8bae94d9958-e-5&quot;, &quot;chunk-257439916abb1d8e8959f74997de355a-e-7&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0fc2e7bdc755aa4e47c0be4c7ca98b87-e-1" label="electron beam button melting (EBBM)">
        <attvalues>
          <attvalue for="0" value="electron beam button melting (EBBM)" />
          <attvalue for="1" value="Manufacturing Technique" />
          <attvalue for="2" value="电子束纽扣熔炼（EBBM）是一种材料制备技术，它利用高能电子束作为热源，在真空环境中将约1公斤的合金等原材料进行滴熔。该工艺主要用于制备少量高纯度、成分均匀的纽扣状金属铸锭，常应用于新材料的研发与样品分析。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-0fc2e7bdc755aa4e47c0be4c7ca98b87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-0fc2e7bdc755aa4e47c0be4c7ca98b87-e-3" label="electron beam">
        <attvalues>
          <attvalue for="0" value="electron beam" />
          <attvalue for="1" value="Tool" />
          <attvalue for="2" value="一种在真空中被加速的高速、高能量密度定向电子流。当它轰击材料时，其巨大的动能会转化为热能，使其成为一种精确可控的高能热源，广泛用于电子束熔炼（如EBBM）、焊接、蒸发镀膜及增材制造等材料加工领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-0fc2e7bdc755aa4e47c0be4c7ca98b87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0fc2e7bdc755aa4e47c0be4c7ca98b87-e-5" label="vacuum">
        <attvalues>
          <attvalue for="0" value="vacuum" />
          <attvalue for="1" value="Environment" />
          <attvalue for="2" value="指电子束悬浮熔炼（EBBM）工艺中，用于滴熔合金的特定工作环境。高真空状态能防止材料在高温熔炼时被氧化或污染，确保其纯度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-0fc2e7bdc755aa4e47c0be4c7ca98b87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0fc2e7bdc755aa4e47c0be4c7ca98b87-e-6" label="surface of the pool">
        <attvalues>
          <attvalue for="0" value="surface of the pool" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="在冶金或焊接等材料加工过程中，熔融态物质（熔体）顶部的气-液或渣-液界面。由于密度差异，熔体内部的夹杂物等杂质会上浮并聚集在该表面，从而与熔体分离。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0fc2e7bdc755aa4e47c0be4c7ca98b87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8f374054b3af3dbd36329b272a6ab2a1-e-2" label="Molten liquid">
        <attvalues>
          <attvalue for="0" value="Molten liquid" />
          <attvalue for="1" value="Material State" />
          <attvalue for="2" value="熔融液体是一种材料状态，指固体物质（如金属或矿物）被加热至熔点以上所形成的液态。在冶金等工业过程中，它常作为液体基体，其密度通常大于内部的夹杂物，从而实现两者的分离。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-8f374054b3af3dbd36329b272a6ab2a1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8f374054b3af3dbd36329b272a6ab2a1-e-2&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8f374054b3af3dbd36329b272a6ab2a1-e-6" label="EBBM technique">
        <attvalues>
          <attvalue for="0" value="EBBM technique" />
          <attvalue for="1" value="Analytical Method" />
          <attvalue for="2" value="EBBM技术是一种用于分析材料中夹杂物的分析方法。该方法具有良好的应用前景，但其主要局限性在于无法精确测量颗粒的尺寸分布。" />
          <attvalue for="3" value="{&quot;promise&quot;: &quot;some&quot;, &quot;criticism&quot;: &quot;does not provide an accurate measure of the distribution of particle sizes&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-8f374054b3af3dbd36329b272a6ab2a1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="75" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8f374054b3af3dbd36329b272a6ab2a1-e-7" label="Particle size">
        <attvalues>
          <attvalue for="0" value="Particle size" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="颗粒大小（粒度）是表征材料中颗粒尺寸的物理性质。在浮选工艺中，它特指夹杂物的尺寸，是决定浮选效率的关键因素。其尺寸分布的准确测量对工艺控制至关重要，但某些技术（如EBBM）可能无法精确测定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-8f374054b3af3dbd36329b272a6ab2a1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="75" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8f374054b3af3dbd36329b272a6ab2a1-e-8" label="Flotation efficiency">
        <attvalues>
          <attvalue for="0" value="Flotation efficiency" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="浮选效率是衡量在浮选过程中，目标矿物从矿石矿浆中被回收的程度的一个性能指标。它用于评估浮选分离的效果，其数值高低通常是颗粒尺寸的一个函数，特定尺寸范围内的颗粒回收率更高。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-8f374054b3af3dbd36329b272a6ab2a1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;flotation efficiency&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8f374054b3af3dbd36329b272a6ab2a1-e-8&quot;, &quot;chunk-9fd48949e9fa068e1f82454ee4d745a1-e-1&quot;]}]" />
          <attvalue for="9" value="75" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9fd48949e9fa068e1f82454ee4d745a1-e-2" label="particle size">
        <attvalues>
          <attvalue for="0" value="particle size" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="粒径（Particle Size），又称颗粒大小，是表征单个颗粒几何尺寸的物理量。由于颗粒形状常不规则，通常用等效直径来表示。它是决定粉体材料性质和影响工业过程（如浮选效率）的关键物理参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-9fd48949e9fa068e1f82454ee4d745a1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="75" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9fd48949e9fa068e1f82454ee4d745a1-e-5" label="flaws">
        <attvalues>
          <attvalue for="0" value="flaws" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="瑕疵是指存在于涡轮盘内部的缺陷。这类缺陷可能引发裂纹形核，进而缩短部件的疲劳寿命，并对构件的结构完整性构成威胁。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-9fd48949e9fa068e1f82454ee4d745a1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9fd48949e9fa068e1f82454ee4d745a1-e-7" label="integrity of the component">
        <attvalues>
          <attvalue for="0" value="integrity of the component" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="构件完整性是一种属性，指构件在结构上的健全和完好状态。一个具有完整性的构件，其内部不存在足以威胁其预期功能的缺陷或损伤。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-9fd48949e9fa068e1f82454ee4d745a1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0cc0ddc3943d8f2fd7c506b872a6a90c-e-4" label="Manufacturing">
        <attvalues>
          <attvalue for="0" value="Manufacturing" />
          <attvalue for="1" value="Process Stage" />
          <attvalue for="2" value="指产品（如涡轮盘）的初始生产工艺阶段。此阶段的核心是采用无损评估 (NDE) 等方法进行严格的质量控制，以确保产品的完整性和可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0cc0ddc3943d8f2fd7c506b872a6a90c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0cc0ddc3943d8f2fd7c506b872a6a90c-e-5" label="Service">
        <attvalues>
          <attvalue for="0" value="Service" />
          <attvalue for="1" value="Operational Phase" />
          <attvalue for="2" value="在役（Service）指涡轮盘等关键部件投入使用的运行周期。该阶段以无损检测（NDE）为起止标志：始于部件安装前的初始检测，终于其退役拆卸后的最终检测。在此期间，部件承受实际工作载荷，是其生命周期中的核心工作阶段。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-0cc0ddc3943d8f2fd7c506b872a6a90c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f65046762e91bbcc190f459be1701bc4-e-2" label="liquid penetrant method">
        <attvalues>
          <attvalue for="0" value="liquid penetrant method" />
          <attvalue for="1" value="NDE Method" />
          <attvalue for="2" value="液体渗透法是一种常用的无损检测方法。其原理是利用毛细作用，将含有荧光或着色染料的渗透液渗入材料表面开口缺陷中。去除多余渗透液后，通过显像剂将被困的渗透液吸出，从而清晰地显示出裂纹、气孔等缺陷的位置、形状和大小，以评估工件质量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-f65046762e91bbcc190f459be1701bc4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-f65046762e91bbcc190f459be1701bc4-e-3" label="dyes">
        <attvalues>
          <attvalue for="0" value="dyes" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种专用于液体渗透检测法的荧光染料。该物质能在紫外光的照射下发出明亮荧光，从而使材料表面的微小裂纹等缺陷变得清晰可见，以达到无损探伤的目的。" />
          <attvalue for="3" value="{&quot;property&quot;: &quot;fluoresce under ultra-violet light&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-f65046762e91bbcc190f459be1701bc4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f65046762e91bbcc190f459be1701bc4-e-4" label="ultra-violet light">
        <attvalues>
          <attvalue for="0" value="ultra-violet light" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="一种波长比可见光短的电磁辐射。在无损检测技术中，它被用作激发源，使液体渗透检测中的荧光染料发出荧光，从而清晰地显示出材料表面的微小缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f65046762e91bbcc190f459be1701bc4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f65046762e91bbcc190f459be1701bc4-e-5" label="Crack">
        <attvalues>
          <attvalue for="0" value="Crack" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="裂纹是一种材料缺陷，指在应力作用下，材料内部或表面形成的线状或面状断裂。其发展过程通常包含裂纹萌生（initiation）和裂纹扩展（propagation）两个连续阶段，是导致材料或结构失效的主要原因之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-f65046762e91bbcc190f459be1701bc4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Cracks&quot;, &quot;crack&quot;, &quot;cracks&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9fd48949e9fa068e1f82454ee4d745a1-e-6&quot;, &quot;chunk-f65046762e91bbcc190f459be1701bc4-e-5&quot;, &quot;chunk-c8784a1621429d74d3f7495ce7649e88-e-1&quot;, &quot;chunk-d63d2e58612dcf41a9407c0b8dd57bc3-e-2&quot;, &quot;chunk-e3a4ba849abe93a2a6728157cbd079b2-e-2&quot;, &quot;chunk-3ef3a46d5883ceba55b19f3ce086fd54-e-8&quot;, &quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-13&quot;, &quot;chunk-455a426fd56bc0498536fbbc0427ca38-e-7&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-f65046762e91bbcc190f459be1701bc4-e-6" label="Eddy Current Method">
        <attvalues>
          <attvalue for="0" value="Eddy Current Method" />
          <attvalue for="1" value="NDE Method" />
          <attvalue for="2" value="涡流法是一种基于电磁感应原理的无损检测方法。它通过探头在导电材料中激励出涡流，并分析因缺陷或属性变化所引起的涡流信号，以探测构件表面及近表面缺陷、测量涂层厚度或进行材料分选。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-f65046762e91bbcc190f459be1701bc4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;eddy current method&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f65046762e91bbcc190f459be1701bc4-e-6&quot;, &quot;chunk-d63d2e58612dcf41a9407c0b8dd57bc3-e-1&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f65046762e91bbcc190f459be1701bc4-e-7" label="damage-tolerant method">
        <attvalues>
          <attvalue for="0" value="damage-tolerant method" />
          <attvalue for="1" value="Lifing Method" />
          <attvalue for="2" value="损伤容限法是一种寿命评估方法，它假定构件存在初始缺陷。该方法基于断裂力学，通过计算裂纹扩展到临界尺寸的时间来确定安全寿命和检查周期。此方法要求使用无损检测（NDE）手段来监控缺陷状态。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-f65046762e91bbcc190f459be1701bc4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f65046762e91bbcc190f459be1701bc4-e-7&quot;, &quot;chunk-095e7b19e19ba75f3f37b75ed9ca8622-e-1&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f65046762e91bbcc190f459be1701bc4-e-8" label="disc">
        <attvalues>
          <attvalue for="0" value="disc" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="盘（Discs）是一种关键机械部件，特指涡轮发动机或燃气轮机中用于安装和固定涡轮叶片的轮盘。它与叶片共同组成高速旋转的核心组件，需承受巨大的离心力和高温环境，是确保发动机安全运行的核心要素之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-f65046762e91bbcc190f459be1701bc4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Discs&quot;, &quot;discs&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b6d430b58fe5b3336f2235e2e6daa465-e-4&quot;, &quot;chunk-23956e10c58e231fcc8e8072af07e6f4-e-8&quot;, &quot;chunk-f65046762e91bbcc190f459be1701bc4-e-8&quot;, &quot;chunk-542eb38b71ebf203cb6df08f03ceb063-e-11&quot;, &quot;chunk-33a73eedd5f0ffd402fd2e071201f517-e-2&quot;]}]" />
          <attvalue for="9" value="37" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-f65046762e91bbcc190f459be1701bc4-e-9" label="engine">
        <attvalues>
          <attvalue for="0" value="engine" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="一个能够读取或写入光盘（Disc）的系统或核心组件，通常指光驱。其定义性特征是包含一个可供用户移除和插入光盘的机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-f65046762e91bbcc190f459be1701bc4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="37" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d63d2e58612dcf41a9407c0b8dd57bc3-e-3" label="X-ray Radiography">
        <attvalues>
          <attvalue for="0" value="X-ray Radiography" />
          <attvalue for="1" value="Inspection Method" />
          <attvalue for="2" value="X射线照相（X-ray Radiography）是一种无损检测方法，它利用X射线对不同密度物质的穿透和吸收差异来成像，以揭示物体内部结构。该方法穿透力强，适用于检查较厚部件，但分辨率相对有限，可能无法检出最微小的缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d63d2e58612dcf41a9407c0b8dd57bc3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;radiography&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d63d2e58612dcf41a9407c0b8dd57bc3-e-3&quot;, &quot;chunk-dae9be5eb4b7208070b473c392dd0478-e-13&quot;, &quot;chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-17&quot;]}]" />
          <attvalue for="9" value="62" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d63d2e58612dcf41a9407c0b8dd57bc3-e-4" label="Finest Flaws">
        <attvalues>
          <attvalue for="0" value="Finest Flaws" />
          <attvalue for="1" value="Flaw" />
          <attvalue for="2" value="Finest Flaws指一类尺寸极其微小的缺陷。由于其特征通常超出了常规X射线照相术的分辨极限，因此无法被该技术有效检出或识别。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d63d2e58612dcf41a9407c0b8dd57bc3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="62" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d63d2e58612dcf41a9407c0b8dd57bc3-e-5" label="Ultrasonics">
        <attvalues>
          <attvalue for="0" value="Ultrasonics" />
          <attvalue for="1" value="Inspection Method" />
          <attvalue for="2" value="超声检测是一种无损检测方法，它利用高频声波在材料中传播的特性，来探测和定位物体内部的缺陷。该方法常用于发现夹杂物、粗大晶粒、缩孔及裂纹等不连续性缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d63d2e58612dcf41a9407c0b8dd57bc3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Ultrasonics (high-frequency sound waves)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d63d2e58612dcf41a9407c0b8dd57bc3-e-5&quot;, &quot;chunk-bc843e3dfc76a0be097f5be36fb00976-e-1&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-d63d2e58612dcf41a9407c0b8dd57bc3-e-8" label="Coarse grains">
        <attvalues>
          <attvalue for="0" value="Coarse grains" />
          <attvalue for="1" value="Flaw" />
          <attvalue for="2" value="粗晶粒是一种材料的微观结构缺陷，指晶粒尺寸异常粗大，通常会导致材料的强度和韧性等关键力学性能下降。由于粗大的晶粒会引起声波的显著散射，因此它是一种可通过超声波技术检测出的典型缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-d63d2e58612dcf41a9407c0b8dd57bc3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Coarse Grains&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d63d2e58612dcf41a9407c0b8dd57bc3-e-8&quot;, &quot;chunk-bc843e3dfc76a0be097f5be36fb00976-e-3&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d63d2e58612dcf41a9407c0b8dd57bc3-e-9" label="Shrinkage Pipe">
        <attvalues>
          <attvalue for="0" value="Shrinkage Pipe" />
          <attvalue for="1" value="Flaw" />
          <attvalue for="2" value="缩管是一种常见的铸造缺陷，指金属熔液在凝固过程中因体积收缩，在铸件最后凝固部位形成的管状或锥状空腔。作为一种内部缺陷，它无法通过目视检查发现，通常可采用超声波探伤等无损检测方法进行探测。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-d63d2e58612dcf41a9407c0b8dd57bc3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Shrinkage pipe&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d63d2e58612dcf41a9407c0b8dd57bc3-e-9&quot;, &quot;chunk-bc843e3dfc76a0be097f5be36fb00976-e-4&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d63d2e58612dcf41a9407c0b8dd57bc3-e-10" label="Tears">
        <attvalues>
          <attvalue for="0" value="Tears" />
          <attvalue for="1" value="Flaw" />
          <attvalue for="2" value="材料撕裂（Tears）是一种内部材料缺陷，指材料内部发生断裂或分离。由于这种缺陷通常无法通过目视检查发现，因此常使用超声波（高频声波）等无损检测技术进行探测和定位。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-d63d2e58612dcf41a9407c0b8dd57bc3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d63d2e58612dcf41a9407c0b8dd57bc3-e-10&quot;, &quot;chunk-bc843e3dfc76a0be097f5be36fb00976-e-5&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bc843e3dfc76a0be097f5be36fb00976-e-6" label="Seams">
        <attvalues>
          <attvalue for="0" value="Seams" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="一种材料缺陷，通常指金属等材料在加工过程中形成的纵向线性裂缝或折叠。它是一种表面不连续的缺陷，可通过超声波（高频声波）等无损检测方法发现。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-bc843e3dfc76a0be097f5be36fb00976" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bc843e3dfc76a0be097f5be36fb00976-e-8" label="Turbine disc applications">
        <attvalues>
          <attvalue for="0" value="Turbine disc applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="指涡轮盘在航空发动机、燃气轮机等高温高压旋转机械中的应用场景。因其承受极端载荷且为安全关键部件，必须使用超声波等无损检测技术来探查内部缺陷，以确保结构完整性和运行可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-bc843e3dfc76a0be097f5be36fb00976" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bc843e3dfc76a0be097f5be36fb00976-e-10" label="Forged and heat-treated disc">
        <attvalues>
          <attvalue for="0" value="Forged and heat-treated disc" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种盘状部件，依次经过锻造、热处理和机械加工成特定的“声波外形”（sonic shape）。最终应用超声波（高频声波）对其进行无损检测，以确保其内部质量与结构完整性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-bc843e3dfc76a0be097f5be36fb00976" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a0bc17e9304523fcbd1eb1f1e003c749-e-3" label="disc">
        <attvalues>
          <attvalue for="0" value="disc" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种盘状组件毛坯，被加工成特定的“声波形状”。它具备平坦表面和特定的表面光洁度，是添加叶根槽、盖板和法兰等最终特征之前的中间形态。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a0bc17e9304523fcbd1eb1f1e003c749" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-a0bc17e9304523fcbd1eb1f1e003c749-e-4" label="blade root sockets">
        <attvalues>
          <attvalue for="0" value="blade root sockets" />
          <attvalue for="1" value="Component Feature" />
          <attvalue for="2" value="叶根槽是盘(disc)上的加工特征，指用于容纳和固定叶片根部的槽口或型腔。此特征并非在初始“声波外形”的机加工阶段形成，而是在后续工序中引入。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a0bc17e9304523fcbd1eb1f1e003c749" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a0bc17e9304523fcbd1eb1f1e003c749-e-5" label="cover plate">
        <attvalues>
          <attvalue for="0" value="cover plate" />
          <attvalue for="1" value="Component Feature" />
          <attvalue for="2" value="盘状部件上的一种结构特征。它并非在切削“声波外形”的初始加工阶段形成，而是在后续工序中被加工或安装，通常用于覆盖或保护盘面上的特定区域或组件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a0bc17e9304523fcbd1eb1f1e003c749" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="309" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-a0bc17e9304523fcbd1eb1f1e003c749-e-6" label="flanges">
        <attvalues>
          <attvalue for="0" value="flanges" />
          <attvalue for="1" value="Component Feature" />
          <attvalue for="2" value="盘件上的一种环状突出结构特征。其主要功能是连接、紧固其他部件，或作为定位基准和密封面。它通常在机械加工的后期阶段形成，并能有效增强组件的结构刚度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a0bc17e9304523fcbd1eb1f1e003c749" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="310" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-a0bc17e9304523fcbd1eb1f1e003c749-e-7" label="machining process">
        <attvalues>
          <attvalue for="0" value="machining process" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="一种对盘件进行初步成形的制造工艺，用于加工出其基础的“声波外形”（sonic shape）。该工艺处于早期阶段，不涉及加工叶根槽等后续工序所需的复杂几何特征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a0bc17e9304523fcbd1eb1f1e003c749" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a0bc17e9304523fcbd1eb1f1e003c749-e-8" label="flat surfaces">
        <attvalues>
          <attvalue for="0" value="flat surfaces" />
          <attvalue for="1" value="Geometric Feature" />
          <attvalue for="2" value="指在“声波形态”(sonic shape) 阶段下，构成圆盘 (disc) 的主要几何特征。这些平面相互垂直相交，形成90度角，是定义该特定形态的关键结构元素。" />
          <attvalue for="3" value="{&quot;intersection_angle&quot;: &quot;90°&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-a0bc17e9304523fcbd1eb1f1e003c749" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-46519664d1993ec85d3dfda3e39a3468-e-2" label="Ultrasonic waves">
        <attvalues>
          <attvalue for="0" value="Ultrasonic waves" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="超声波（High-frequency sound waves），指频率高于人耳听觉上限的机械波。作为一种物理现象，它在超声学领域被广泛应用，例如利用其良好的方向性和穿透性进行无损探伤、医疗成像和测距。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-46519664d1993ec85d3dfda3e39a3468" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;High-frequency sound waves&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d63d2e58612dcf41a9407c0b8dd57bc3-e-6&quot;, &quot;chunk-46519664d1993ec85d3dfda3e39a3468-e-2&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-46519664d1993ec85d3dfda3e39a3468-e-3" label="Piezoelectric transducers and receivers">
        <attvalues>
          <attvalue for="0" value="Piezoelectric transducers and receivers" />
          <attvalue for="1" value="Device" />
          <attvalue for="2" value="一种基于晶体压电与逆压电效应的设备，通过在电能和超声波声能间相互转换，来产生和测量超声波。它既是发射器也是接收器，常在水中等介质中使用以进行探测或成像。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-46519664d1993ec85d3dfda3e39a3468" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-46519664d1993ec85d3dfda3e39a3468-e-4" label="Crystals">
        <attvalues>
          <attvalue for="0" value="Crystals" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一类表现出强大逆压电效应的材料，如石英、钛酸钡等。该特性使其成为制造压电换能器与接收器的核心组件，这些设备的功能依赖于此种材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-46519664d1993ec85d3dfda3e39a3468" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-46519664d1993ec85d3dfda3e39a3468-e-5" label="Quartz">
        <attvalues>
          <attvalue for="0" value="Quartz" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="石英是一种由二氧化硅组成的结晶矿物，是晶体的一种。它具有显著的压电效应，是制造压电换能器、谐振器（如石英钟）和电子接收器等精密电子元器件的关键材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-46519664d1993ec85d3dfda3e39a3468" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-46519664d1993ec85d3dfda3e39a3468-e-6" label="Barium titanate">
        <attvalues>
          <attvalue for="0" value="Barium titanate" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="钛酸钡（BaTiO₃）是一种具有钙钛矿结构的无机化合物晶体，属于铁电陶瓷材料。它因具有优异的压电效应和高介电常数，被广泛用作制造压电换能器、多层陶瓷电容器和传感器等电子元器件的关键材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-46519664d1993ec85d3dfda3e39a3468" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-46519664d1993ec85d3dfda3e39a3468-e-7" label="Inverse piezoelectric effect">
        <attvalues>
          <attvalue for="0" value="Inverse piezoelectric effect" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="逆压电效应是一种物理现象，指对某些晶体（压电材料）施加电场时，材料会产生机械应变或形变。它是正压电效应的逆过程，是压电换能器、执行器等器件实现电能到机械能转换的核心原理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-46519664d1993ec85d3dfda3e39a3468" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-46519664d1993ec85d3dfda3e39a3468-e-8" label="Air">
        <attvalues>
          <attvalue for="0" value="Air" />
          <attvalue for="1" value="Medium" />
          <attvalue for="2" value="作为一种气体传播介质，空气因其分子稀疏和黏滞性，会对超声波产生强烈的衰减作用，导致波的能量在传播过程中被迅速吸收和耗散。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-46519664d1993ec85d3dfda3e39a3468" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-46519664d1993ec85d3dfda3e39a3468-e-9" label="Water">
        <attvalues>
          <attvalue for="0" value="Water" />
          <attvalue for="1" value="Medium" />
          <attvalue for="2" value="在超声波检测中用作声学耦合介质的液体。检测时，压电换能器和待测工件浸入其中，水能有效传递超声波，防止因空气隙造成的信号衰减，从而确保检测的准确性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-46519664d1993ec85d3dfda3e39a3468" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;water&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-46519664d1993ec85d3dfda3e39a3468-e-9&quot;, &quot;chunk-68f7a0b71220a85295160dc7a5e78412-e-3&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-68f7a0b71220a85295160dc7a5e78412-e-1" label="disc">
        <attvalues>
          <attvalue for="0" value="disc" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="在无损检测装置中，指与换能器耦合的受检部件。它通常浸没在水等耦合剂中，以确保检测信号（如超声波）的有效传输，从而实现对其内部结构或缺陷的精确评估。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-68f7a0b71220a85295160dc7a5e78412" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-68f7a0b71220a85295160dc7a5e78412-e-2" label="transducer">
        <attvalues>
          <attvalue for="0" value="transducer" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="换能器是一种在检测系统中将电能转换为超声波并接收回波的核心组件。它通常浸入水中或通过耦合剂与被测物（如圆盘）紧密接触，以确保声波能有效传播，从而实现对物体的内部探伤或评估。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-68f7a0b71220a85295160dc7a5e78412" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-68f7a0b71220a85295160dc7a5e78412-e-4" label="coupling fluid">
        <attvalues>
          <attvalue for="0" value="coupling fluid" />
          <attvalue for="1" value="Coupling Medium" />
          <attvalue for="2" value="一种用于填充换能器与待测物体（如圆盘）之间微小间隙的流体介质。其主要作用是排除空气，建立有效的能量（如超声波）传输通道，以减少信号损失，确保检测或测量的准确性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-68f7a0b71220a85295160dc7a5e78412" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-68f7a0b71220a85295160dc7a5e78412-e-5" label="waves">
        <attvalues>
          <attvalue for="0" value="waves" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="一种用于无损检测的物理现象。特指为探查材料或部件的内部结构与缺陷，而主动发射并使其穿透目标的能量波，如超声波、X射线等。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-68f7a0b71220a85295160dc7a5e78412" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="197" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-68f7a0b71220a85295160dc7a5e78412-e-6" label="component">
        <attvalues>
          <attvalue for="0" value="component" />
          <attvalue for="1" value="Object of Inspection" />
          <attvalue for="2" value="在无损检测等技术领域中，作为检测对象的材料或工件。通过向其内部发射声波、电磁波等，以分析和识别其是否存在裂纹、夹杂等缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-68f7a0b71220a85295160dc7a5e78412" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="197" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-68f7a0b71220a85295160dc7a5e78412-e-7" label="straight-beam top inspection">
        <attvalues>
          <attvalue for="0" value="straight-beam top inspection" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种无损检测工艺，利用超声波束从工件顶部垂直入射，通过分析回波信号，探测与检测面基本平行的内部平面型缺陷（如分层、裂纹）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-68f7a0b71220a85295160dc7a5e78412" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;top-beam top inspection&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-68f7a0b71220a85295160dc7a5e78412-e-7&quot;, &quot;chunk-cbf9166aa97aa9267da4fcb91793688f-e-1&quot;]}]" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-68f7a0b71220a85295160dc7a5e78412-e-8" label="planar flaws">
        <attvalues>
          <attvalue for="0" value="planar flaws" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="平面缺陷是锻件内部一类缺陷的总称，特指那些呈二维平面状、且其所在平面与锻件轴向基本垂直的缺陷。由于其特定的方向性，这类缺陷能被“顶束顶部检测”等超声波探伤方法有效检出。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-68f7a0b71220a85295160dc7a5e78412" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-68f7a0b71220a85295160dc7a5e78412-e-8&quot;, &quot;chunk-cbf9166aa97aa9267da4fcb91793688f-e-2&quot;]}]" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-68f7a0b71220a85295160dc7a5e78412-e-9" label="surfaces">
        <attvalues>
          <attvalue for="0" value="surfaces" />
          <attvalue for="1" value="Component Feature" />
          <attvalue for="2" value="指构成部件外形的几何边界。它是一种重要的几何特征，通常被用作参考基准，以描述内部缺陷（特别是与之平行的平面状缺陷）的方向和位置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-68f7a0b71220a85295160dc7a5e78412" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cbf9166aa97aa9267da4fcb91793688f-e-3" label="longitudinal ultrasonic beam">
        <attvalues>
          <attvalue for="0" value="longitudinal ultrasonic beam" />
          <attvalue for="1" value="Inspection Medium" />
          <attvalue for="2" value="一种无损检测中使用的超声波束，其介质质点的振动方向与波的传播方向一致。该波束通常垂直于被检测物体表面入射，用于探测内部缺陷或进行测厚。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-cbf9166aa97aa9267da4fcb91793688f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cbf9166aa97aa9267da4fcb91793688f-e-4" label="single pulse-echo transducer">
        <attvalues>
          <attvalue for="0" value="single pulse-echo transducer" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="一种单晶元超声换能器，基于脉冲回波原理工作，即由同一晶元完成超声波的发射与接收。它是无损检测中的常用设备，通过分析回波信号来探测材料内部的缺陷或测量其厚度。" />
          <attvalue for="3" value="{&quot;diameter&quot;: &quot;13–40 mm&quot;, &quot;frequency&quot;: &quot;1–5 MHz&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-cbf9166aa97aa9267da4fcb91793688f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cbf9166aa97aa9267da4fcb91793688f-e-5" label="Cylindrical reference blocks">
        <attvalues>
          <attvalue for="0" value="Cylindrical reference blocks" />
          <attvalue for="1" value="Calibration Standard" />
          <attvalue for="2" value="圆柱形参考试块是一种校准标准器，其内部含有精密的机加工人工缺陷（如平底孔）。它通常成套使用，用于无损检测（尤其是超声检测）中，通过建立校准曲线来评估仪器探测和定量内部缺陷的性能。" />
          <attvalue for="3" value="{&quot;diameter&quot;: &quot;50 mm&quot;, &quot;heights&quot;: &quot;varying&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-cbf9166aa97aa9267da4fcb91793688f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;cylindrical reference blocks&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cbf9166aa97aa9267da4fcb91793688f-e-5&quot;, &quot;chunk-756dde5468e7c6ec5cdd4ef80102f697-e-1&quot;]}]" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-756dde5468e7c6ec5cdd4ef80102f697-e-3" label="Detection sensitivity">
        <attvalues>
          <attvalue for="0" value="Detection sensitivity" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="检测灵敏度是一个关键的检测参数，表征检测系统识别最小缺陷的能力。它通过调节仪器控制器，利用来自标准缺陷（如校准刻槽）的扫查峰值信号来建立，确保检测过程的可重复性和准确性。" />
          <attvalue for="3" value="{&quot;normal_setting&quot;: &quot;10% of the size of the flaw&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-756dde5468e7c6ec5cdd4ef80102f697" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Flaw detection sensitivity&quot;, &quot;sensitivity of flaw detection&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-756dde5468e7c6ec5cdd4ef80102f697-e-3&quot;, &quot;chunk-1c820dd189013434a126857aa92d5bf3-e-5&quot;, &quot;chunk-ecbdb2f69e15219fedba1f6f77faf2ed-e-9&quot;, &quot;chunk-100afba087a43fc5308b3284aa10cb35-e-1&quot;]}]" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-756dde5468e7c6ec5cdd4ef80102f697-e-4" label="ASTM standard E127">
        <attvalues>
          <attvalue for="0" value="ASTM standard E127" />
          <attvalue for="1" value="Standard" />
          <attvalue for="2" value="ASTM E127是由美国材料与试验协会(ASTM)发布的标准，旨在为校准试块（参考块）提供制造和检验规范。该标准详细定义了多种标准试块，例如其中定义的B系列(Series B)试块，就是无损检测领域常用的标准之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-756dde5468e7c6ec5cdd4ef80102f697" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-756dde5468e7c6ec5cdd4ef80102f697-e-5" label="#2 block in Series B">
        <attvalues>
          <attvalue for="0" value="#2 block in Series B" />
          <attvalue for="1" value="Calibration Standard" />
          <attvalue for="2" value="B系列2号试块是一种依据ASTM E127标准定义的校准标准件。它内部含有平底孔，专用于校准超声检测系统的灵敏度，例如设定一个能探测到0.08毫米当量缺陷的灵敏度级别。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-756dde5468e7c6ec5cdd4ef80102f697" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-756dde5468e7c6ec5cdd4ef80102f697-e-6" label="0.08 mm">
        <attvalues>
          <attvalue for="0" value="0.08 mm" />
          <attvalue for="1" value="Value" />
          <attvalue for="2" value="一个预期的探伤灵敏度值。它定义了在使用美国材料与试验协会 (ASTM) E127标准B系列中的#2试块进行系统校准时，所能达到的缺陷检测能力。" />
          <attvalue for="3" value="{&quot;unit&quot;: &quot;mm&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-756dde5468e7c6ec5cdd4ef80102f697" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bcfae038791bf36f3615792a1b3e778b-e-1" label="Flaw detection">
        <attvalues>
          <attvalue for="0" value="Flaw detection" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="探伤是一种用于检查材料或工件内部及表面缺陷，而又不损害其使用性能的无损检测过程。其灵敏度指探测最小缺陷的能力，通常使用平底孔这类标准人工缺陷进行测量和标定。" />
          <attvalue for="3" value="{&quot;sensitivity&quot;: &quot;0.08 mm&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-bcfae038791bf36f3615792a1b3e778b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bcfae038791bf36f3615792a1b3e778b-e-1&quot;]}]" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bcfae038791bf36f3615792a1b3e778b-e-2" label="Flat-bottomed hole">
        <attvalues>
          <attvalue for="0" value="Flat-bottomed hole" />
          <attvalue for="1" value="Calibration Feature" />
          <attvalue for="2" value="平底孔是一种在标准参考试块（如圆柱形试块）中精密加工而成的人工缺陷。它具有平坦的底面，在无损检测中用作标准的参考反射体，以校准和评估检测设备（如超声探伤仪）的灵敏度及分辨率。" />
          <attvalue for="3" value="{&quot;diameter&quot;: &quot;0.8 mm&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-bcfae038791bf36f3615792a1b3e778b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Flat-bottomed holes&quot;, &quot;flat-bottomed holes&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cbf9166aa97aa9267da4fcb91793688f-e-6&quot;, &quot;chunk-756dde5468e7c6ec5cdd4ef80102f697-e-2&quot;, &quot;chunk-bcfae038791bf36f3615792a1b3e778b-e-2&quot;]}]" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-bcfae038791bf36f3615792a1b3e778b-e-3" label="Shear waves">
        <attvalues>
          <attvalue for="0" value="Shear waves" />
          <attvalue for="1" value="Inspection Method" />
          <attvalue for="2" value="一种利用斜探头产生剪切波的无损检测方法。该方法对特定方向的缺陷（尤其是轴向和径向缺陷）敏感，常用于检测锻件等工件的内部瑕疵。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-bcfae038791bf36f3615792a1b3e778b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="84" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-bcfae038791bf36f3615792a1b3e778b-e-4" label="Flaws with axial radial orientation">
        <attvalues>
          <attvalue for="0" value="Flaws with axial radial orientation" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="一种缺陷类型，其断裂面或主要扩展平面位于构件的轴向-径向平面内。因其特定取向，该缺陷是剪切波无损检测方法的主要探测目标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-bcfae038791bf36f3615792a1b3e778b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="84" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bcfae038791bf36f3615792a1b3e778b-e-5" label="Angle-beam transducer">
        <attvalues>
          <attvalue for="0" value="Angle-beam transducer" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="斜探头是一种用于超声无损检测的换能器。它通过内置的楔块，使超声波束以特定角度倾斜入射到被测工件中，从而在材料内部主要激发和接收横波，用于探测焊缝、管道等结构中的缺陷。" />
          <attvalue for="3" value="{&quot;beam_angle&quot;: &quot;45°&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-bcfae038791bf36f3615792a1b3e778b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="84" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bcfae038791bf36f3615792a1b3e778b-e-6" label="Forging">
        <attvalues>
          <attvalue for="0" value="Forging" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种通过锻造工艺制成的金属构件。为确保其内部结构完整性与质量，常采用剪切波等无损检测技术扫描其外围进行探伤。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-bcfae038791bf36f3615792a1b3e778b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="84" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1c820dd189013434a126857aa92d5bf3-e-2" label="Forging">
        <attvalues>
          <attvalue for="0" value="Forging" />
          <attvalue for="1" value="Mechanical Component" />
          <attvalue for="2" value="锻件是一种通过锻造工艺将金属塑造成型的机械部件。此特定工件的内外表面上均加工有用于检测或标定的校准槽。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-1c820dd189013434a126857aa92d5bf3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1c820dd189013434a126857aa92d5bf3-e-3" label="Inner surface">
        <attvalues>
          <attvalue for="0" value="Inner surface" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="指锻件内部加工有校准槽的特定表面区域。该区域上的刻槽是进行尺寸测量、无损检测或设备标定时使用的重要物理基准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-1c820dd189013434a126857aa92d5bf3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;inside surface&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1c820dd189013434a126857aa92d5bf3-e-3&quot;, &quot;chunk-ecbdb2f69e15219fedba1f6f77faf2ed-e-3&quot;]}]" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1c820dd189013434a126857aa92d5bf3-e-4" label="Outer surface">
        <attvalues>
          <attvalue for="0" value="Outer surface" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="指材料或工件的外部表面，其上设有一个或多个校准刻槽（calibration notch），作为测量或定位的基准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1c820dd189013434a126857aa92d5bf3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;outer surface&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1c820dd189013434a126857aa92d5bf3-e-4&quot;, &quot;chunk-ecbdb2f69e15219fedba1f6f77faf2ed-e-2&quot;]}]" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1c820dd189013434a126857aa92d5bf3-e-6" label="Instrument controls">
        <attvalues>
          <attvalue for="0" value="Instrument controls" />
          <attvalue for="1" value="Equipment Component" />
          <attvalue for="2" value="仪器设备上的特定组件，用于调节和设置探测灵敏度。其形式可以是物理旋钮、按钮，或软件界面中的参数设置选项。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-1c820dd189013434a126857aa92d5bf3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1c820dd189013434a126857aa92d5bf3-e-7" label="Sweep-to-peak signal">
        <attvalues>
          <attvalue for="0" value="Sweep-to-peak signal" />
          <attvalue for="1" value="Measurement" />
          <attvalue for="2" value="扫查峰值信号是一种在仪器校准中产生的测量信号。它由探头扫过一个已知的标准校准槽（或缺陷）而生成，其信号响应的峰值幅度被用作基准，以建立或设定仪器的探测灵敏度。" />
          <attvalue for="3" value="{&quot;minimum_height&quot;: &quot;13 mm&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-1c820dd189013434a126857aa92d5bf3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ecbdb2f69e15219fedba1f6f77faf2ed-e-1" label="Calibration notch">
        <attvalues>
          <attvalue for="0" value="Calibration notch" />
          <attvalue for="1" value="Calibration Feature" />
          <attvalue for="2" value="校准刻槽 (Calibration notches) 是一种物理校准特征，指在物体或专用校准板上制作的、具有精确尺寸和位置的凹口或切口。它们作为已知物理基准，用于校准相机等光学测量系统或机械设备，以确保空间测量的准确性、纠正畸变或建立坐标系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-ecbdb2f69e15219fedba1f6f77faf2ed" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Calibration notches&quot;, &quot;calibration notch&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bcfae038791bf36f3615792a1b3e778b-e-7&quot;, &quot;chunk-1c820dd189013434a126857aa92d5bf3-e-1&quot;, &quot;chunk-ecbdb2f69e15219fedba1f6f77faf2ed-e-1&quot;]}]" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-ecbdb2f69e15219fedba1f6f77faf2ed-e-4" label="peaks">
        <attvalues>
          <attvalue for="0" value="peaks" />
          <attvalue for="1" value="Measurement Signal" />
          <attvalue for="2" value="在测量响应信号中，与校准凹口位置相对应的一系列局部最大值（峰值）。这些峰值点被用于共同确立一条参考线，作为后续测量的基准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-ecbdb2f69e15219fedba1f6f77faf2ed" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ecbdb2f69e15219fedba1f6f77faf2ed-e-5" label="reference line">
        <attvalues>
          <attvalue for="0" value="reference line" />
          <attvalue for="1" value="Calibration Standard" />
          <attvalue for="2" value="一种校准标准。它通过连接两个标准凹口的测量峰值而建立，形成的基准线被用作后续测量的评估参考。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ecbdb2f69e15219fedba1f6f77faf2ed" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ecbdb2f69e15219fedba1f6f77faf2ed-e-7" label="background noise">
        <attvalues>
          <attvalue for="0" value="background noise" />
          <attvalue for="1" value="Signal Interference" />
          <attvalue for="2" value="在材料（尤其粗晶材料）的无损检测中，由其内部结构散射等因素引起的干扰信号。这种噪声会掩盖来自真实缺陷的回波信号，降低检测的信噪比和可靠性，从而妨碍缺陷的识别。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ecbdb2f69e15219fedba1f6f77faf2ed" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ecbdb2f69e15219fedba1f6f77faf2ed-e-10" label="Small flaws">
        <attvalues>
          <attvalue for="0" value="Small flaws" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="指材料中存在的微小物理缺陷。作为一类瑕疵，其能否被成功检出与识别，直接取决于所用检测设备或方法的灵敏度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-ecbdb2f69e15219fedba1f6f77faf2ed" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;small flaws&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ecbdb2f69e15219fedba1f6f77faf2ed-e-10&quot;, &quot;chunk-100afba087a43fc5308b3284aa10cb35-e-2&quot;]}]" />
          <attvalue for="9" value="36" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-100afba087a43fc5308b3284aa10cb35-e-4" label="Powder metallurgy (P/M) material">
        <attvalues>
          <attvalue for="0" value="Powder metallurgy (P/M) material" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="粉末冶金(P/M)材料是一种通过压制与烧结金属粉末制成的材料。其组织特征为晶粒尺寸均匀且成分偏析程度低，这使得它相比传统铸锻产品具有更少的内部缺陷和更优异的可检测性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-100afba087a43fc5308b3284aa10cb35" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-100afba087a43fc5308b3284aa10cb35-e-4&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-100afba087a43fc5308b3284aa10cb35-e-5" label="Ultrasonic inspectability">
        <attvalues>
          <attvalue for="0" value="Ultrasonic inspectability" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="声学可检测性是一种材料特性，指该材料利用声学或超声波方法进行有效检测的难易程度。此特性主要取决于材料的内部微观结构，特别是晶粒尺寸，因为它会影响声波在材料中的传播与散射，从而决定检测信号的质量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-100afba087a43fc5308b3284aa10cb35" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;sonic inspectability&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-100afba087a43fc5308b3284aa10cb35-e-5&quot;, &quot;chunk-b7b41d99b7968db6938fc41d4745dc0d-e-14&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-100afba087a43fc5308b3284aa10cb35-e-8" label="Reduced levels of segregation">
        <attvalues>
          <attvalue for="0" value="Reduced levels of segregation" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种材料属性，指材料内部化学成分和微观组织的高度均匀性。它是粉末冶金工艺的一项关键优势，可有效避免传统铸造中因缓慢冷却导致的合金元素宏观偏析，从而获得性能更稳定和一致的最终产品。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-100afba087a43fc5308b3284aa10cb35" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Reduced Levels of Segregation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-100afba087a43fc5308b3284aa10cb35-e-8&quot;, &quot;chunk-0365022a18454a90e4598122a8f449ca-e-3&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0365022a18454a90e4598122a8f449ca-e-4" label="Refining of superalloys">
        <attvalues>
          <attvalue for="0" value="Refining of superalloys" />
          <attvalue for="1" value="Metallurgical Process" />
          <attvalue for="2" value="高温合金精炼是一种二次精炼冶金工艺，通常采用真空感应熔炼(VIM)、电渣重熔(ESR)和真空自耗重熔(VAR)等技术的组合，对高温合金进行提纯。其目的是去除杂质，控制组织结构，以获得高纯净度和优异性能的合金材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0365022a18454a90e4598122a8f449ca" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-0365022a18454a90e4598122a8f449ca-e-7" label="Vacuum Arc Remelting (VAR)">
        <attvalues>
          <attvalue for="0" value="Vacuum Arc Remelting (VAR)" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="VAR process，全称真空电弧重熔（Vacuum Arc Remelting），是一种用于生产高温合金铸锭的最终精炼工艺。该工艺的显著特点是极易产生“白点”（white spots）冶金缺陷，且当前尚无已知方法能完全消除此缺陷，因此严格的过程控制对其至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-0365022a18454a90e4598122a8f449ca" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;VAR&quot;, &quot;VAR method&quot;, &quot;VAR process&quot;, &quot;VAR processing&quot;, &quot;Vacuum arc remelting (VAR)&quot;, &quot;vacuum arc remelting&quot;, &quot;vacuum arc remelting (VAR)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d3b2083853e798b7a5f920d4f0cef70d-e-3&quot;, &quot;chunk-8672ed457160465cfb20b55abb713612-e-3&quot;, &quot;chunk-a8ba62bd8a40bbbf72905fea95785308-e-3&quot;, &quot;chunk-982b3fe24bf9b207729c7cfe8c0d921e-e-4&quot;, &quot;chunk-351e8ba4c7ea5776fa307b38afdc31ab-e-4&quot;, &quot;chunk-434598412a5630b73fc77c4f56954329-e-5&quot;, &quot;chunk-35442490006b7aff468c9227749684e6-e-8&quot;, &quot;chunk-c20cadb2415cd2dfc078d894fd496ac4-e-2&quot;, &quot;chunk-abbdf8441a4bf6e918fd13c6184c324e-e-2&quot;, &quot;chunk-1c645de8358fdb4503314332514003ba-e-3&quot;, &quot;chunk-0365022a18454a90e4598122a8f449ca-e-7&quot;, &quot;chunk-8c811c47750a116467f7951f64cda580-e-2&quot;, &quot;chunk-fab5556d25e36a12308d5e081229601a-e-17&quot;, &quot;chunk-13f1fdc70fe0c4a699a3307c18f29c33-e-2&quot;, &quot;chunk-3d0590efade07af78fea353ef909c7ec-e-4&quot;, &quot;chunk-bd63f78238a96a3498c5ca89d8572bea-e-8&quot;, &quot;chunk-2954a9d8cd39d35e1c2ce761efb0de31-e-1&quot;, &quot;chunk-1522e93c065590bf976748cff2b67e57-e-5&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="13" />
        </attvalues>
      </node>
      <node id="chunk-0365022a18454a90e4598122a8f449ca-e-8" label="Triple-melted stock">
        <attvalues>
          <attvalue for="0" value="Triple-melted stock" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种通过真空感应熔炼(VIM)、电渣重熔(ESR)和真空电弧重熔(VAR)三联工艺生产的高纯度高温合金坯料。该工艺旨在最大限度地去除杂质，获得均匀精细的组织结构，以满足航空航天等领域的严苛性能要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-0365022a18454a90e4598122a8f449ca" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;triple-melted product&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0365022a18454a90e4598122a8f449ca-e-8&quot;, &quot;chunk-0440023a44a202881a859e66f23ec3de-e-7&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-18c533341a9790d5a6a16a72face3f19-e-1" label="Maurer">
        <attvalues>
          <attvalue for="0" value="Maurer" />
          <attvalue for="1" value="Source" />
          <attvalue for="2" value="一份被引用的参考文献。该文献是关于IN718高温合金的信息来源，其中提供了有关该合金锭坯直径（特别是最大直径）的声明或数据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-18c533341a9790d5a6a16a72face3f19" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-18c533341a9790d5a6a16a72face3f19-e-3" label="Aerospace quality">
        <attvalues>
          <attvalue for="0" value="Aerospace quality" />
          <attvalue for="1" value="Quality Standard" />
          <attvalue for="2" value="一种专用于IN718合金的质量等级标准。它规定了该材料在化学成分、微观结构、机械性能和无损检测方面的严格要求，以确保其满足航空航天应用所需的高性能、高可靠性和安全性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-18c533341a9790d5a6a16a72face3f19" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-18c533341a9790d5a6a16a72face3f19-e-5" label="Maximum ingot diameter">
        <attvalues>
          <attvalue for="0" value="Maximum ingot diameter" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="最大铸锭直径是IN718合金的一项关键材料属性，它取决于所采用的二次熔炼工艺。该属性定义了在特定工艺条件下能够生产出的原始铸锭的最大横截面尺寸，并直接限制了后续可制造部件的尺寸上限。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-18c533341a9790d5a6a16a72face3f19" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-18c533341a9790d5a6a16a72face3f19-e-6" label="VIM/ESR ingot">
        <attvalues>
          <attvalue for="0" value="VIM/ESR ingot" />
          <attvalue for="1" value="Product" />
          <attvalue for="2" value="指通过真空感应熔炼(VIM)和电渣重熔(ESR)复合工艺生产的，且尺寸受特定规格限制的金属锭。这种双联熔炼工艺旨在生产出具有高纯净度、低夹杂和组织均匀的高性能合金材料。" />
          <attvalue for="3" value="{&quot;diameter_limit&quot;: &quot;17 inch&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-18c533341a9790d5a6a16a72face3f19" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-18c533341a9790d5a6a16a72face3f19-e-6&quot;, &quot;chunk-ff1788efa63f5e7e3624028146e850d4-e-1&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-18c533341a9790d5a6a16a72face3f19-e-8" label="VIM/ESR">
        <attvalues>
          <attvalue for="0" value="VIM/ESR" />
          <attvalue for="1" value="Melting Process" />
          <attvalue for="2" value="VIM/ESR是一种二次熔炼工艺组合，全称为真空感应熔炼（VIM）/电渣重熔（ESR）。该工艺结合了两种技术的优势，通过双联精炼过程，用于生产具有高纯净度和优异组织性能的特种合金锭。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-18c533341a9790d5a6a16a72face3f19" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-18c533341a9790d5a6a16a72face3f19-e-8&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ff1788efa63f5e7e3624028146e850d4-e-2" label="VIM/VAR ingot">
        <attvalues>
          <attvalue for="0" value="VIM/VAR ingot" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="VIM/VAR锭是一种金属材料，指通过真空感应熔炼(VIM)和真空电弧重熔(VAR)双联工艺生产的金属锭。该工艺结合了两种技术的优点，用于制造高纯净度和组织均匀的高性能合金，并具有特定的尺寸规格限制。" />
          <attvalue for="3" value="{&quot;size_limit&quot;: &quot;20 inch&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-ff1788efa63f5e7e3624028146e850d4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ff1788efa63f5e7e3624028146e850d4-e-2&quot;]}]" />
          <attvalue for="9" value="311" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-ff1788efa63f5e7e3624028146e850d4-e-3" label="VIM/ESR/VAR ingot">
        <attvalues>
          <attvalue for="0" value="VIM/ESR/VAR ingot" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种采用真空感应熔炼(VIM)、电渣重熔(ESR)和真空自耗重熔(VAR)三重冶炼工艺生产的金属锭。此工艺可获得极高的纯净度和均匀的微观结构，是制造航空航天、能源等领域高性能关键部件的优质原材料，其尺寸受特定规格限制。" />
          <attvalue for="3" value="{&quot;size_limit&quot;: &quot;24 inch&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-ff1788efa63f5e7e3624028146e850d4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ff1788efa63f5e7e3624028146e850d4-e-3&quot;]}]" />
          <attvalue for="9" value="312" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-ff1788efa63f5e7e3624028146e850d4-e-6" label="1/4 inch immersion">
        <attvalues>
          <attvalue for="0" value="1/4 inch immersion" />
          <attvalue for="1" value="Parameter Value" />
          <attvalue for="2" value="指在电渣重熔（ESR）精炼工艺中，电极浸入熔渣的建议最佳深度。该参数值为1/4英寸（约6.35毫米），对于确保精炼过程的稳定性和产品质量至关重要。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;1/4 inch&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-ff1788efa63f5e7e3624028146e850d4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8c811c47750a116467f7951f64cda580-e-6" label="Centre position">
        <attvalues>
          <attvalue for="0" value="Centre position" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="指材料内部的一个特定区域，该区域由于成分偏析较轻等原因，相较于其他位置更不易产生或很少出现雀斑（Freckling）缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-8c811c47750a116467f7951f64cda580" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8c811c47750a116467f7951f64cda580-e-7" label="Surface position">
        <attvalues>
          <attvalue for="0" value="Surface position" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="指材料表面的一个特定位置或区域。在冶金学中，它特指那些不易于形成“雀斑”（一种宏观偏析）缺陷的区域，通常与材料的凝固过程和成分分布有关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-8c811c47750a116467f7951f64cda580" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ffe6519a8ab8051b1f17495905d64096-e-1" label="Solidification of the superalloys">
        <attvalues>
          <attvalue for="0" value="Solidification of the superalloys" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="高温合金从液态转变为固态的物理冶金过程。该过程涉及复杂的枝晶生长、严重的成分偏析和多相反应，其形成的凝固组织直接决定了合金的微观结构、缺陷分布及最终的力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-ffe6519a8ab8051b1f17495905d64096" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="313" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-ffe6519a8ab8051b1f17495905d64096-e-2" label="TiN particles">
        <attvalues>
          <attvalue for="0" value="TiN particles" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="氮化钛(TiN)颗粒是在材料凝固过程中，于固/液界面前沿形成的一种硬质相。它们在冶金学中被认为是诱发杂散晶(stray grains)生长的主要非均质形核核心。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-ffe6519a8ab8051b1f17495905d64096" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ffe6519a8ab8051b1f17495905d64096-e-3" label="Solid/liquid interface">
        <attvalues>
          <attvalue for="0" value="Solid/liquid interface" />
          <attvalue for="1" value="Physical Boundary" />
          <attvalue for="2" value="在材料凝固过程中，分隔固相与液相的动态物理边界。此界面会持续向液相区推进，其前沿是溶质再分配和新相（如TiN颗粒）形成的关键区域，对材料最终的微观结构有决定性影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-ffe6519a8ab8051b1f17495905d64096" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ffe6519a8ab8051b1f17495905d64096-e-3&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ffe6519a8ab8051b1f17495905d64096-e-4" label="Nucleation of stray grains">
        <attvalues>
          <attvalue for="0" value="Nucleation of stray grains" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="一种材料凝固现象，指在凝固前沿或熔体中形成取向随机的新晶粒（杂散晶）。该过程常由氮化钛（TiN）等颗粒诱发，是导致材料从柱状晶向等轴晶转变（CET）的关键机制之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-ffe6519a8ab8051b1f17495905d64096" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-ffe6519a8ab8051b1f17495905d64096-e-5" label="Columnar-to-equiaxed transition">
        <attvalues>
          <attvalue for="0" value="Columnar-to-equiaxed transition" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="柱状晶向等轴晶转变（CET）是在材料凝固过程中，晶粒结构从定向排列的柱状晶转变为细小、随机取向的等轴晶的一种微观组织演变现象。该转变通常由凝固前沿的杂散晶形核引发，其发生与否关键取决于温度梯度和生长速率等工艺参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ffe6519a8ab8051b1f17495905d64096" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-ffe6519a8ab8051b1f17495905d64096-e-6" label="Growth velocity">
        <attvalues>
          <attvalue for="0" value="Growth velocity" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="生长速度 (Growth velocity) 指材料凝固过程中固-液界面的推进速率。它是一个关键工艺参数，作为决定凝固组织中柱状晶向等轴晶转变（CET）的核心因素之一，直接影响材料的微观结构和宏观性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-ffe6519a8ab8051b1f17495905d64096" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Growth rate&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ffe6519a8ab8051b1f17495905d64096-e-6&quot;, &quot;chunk-d2428cb3e80954cab38bfce19b363f27-e-10&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ffe6519a8ab8051b1f17495905d64096-e-8" label="Stray grains">
        <attvalues>
          <attvalue for="0" value="Stray grains" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="一种微观结构特征，指在单晶或定向凝固过程中，通过非预期的独立形核而形成的、晶体取向与主晶体不同的多余晶粒。它是一种常见的铸造缺陷，会损害材料的机械性能和高温性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-ffe6519a8ab8051b1f17495905d64096" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3598448f2352e6832a423e2072a2f043-e-2" label="Laves phase">
        <attvalues>
          <attvalue for="0" value="Laves phase" />
          <attvalue for="1" value="Metallurgical Phase" />
          <attvalue for="2" value="拉弗斯相（Laves phase）是一种由镍(Ni)、铁(Fe)和铌(Nb)等元素组成的金属间化合物相，化学式常为(Ni,Fe)₂Nb。它主要在IN718等镍基高温合金的铸造凝固过程中形成，是一种常见的、对材料性能有不利影响的硬脆第二相。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;(Ni, Fe)2Nb&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-3598448f2352e6832a423e2072a2f043" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-3598448f2352e6832a423e2072a2f043-e-3" label="Fe-Nb phase diagram">
        <attvalues>
          <attvalue for="0" value="Fe-Nb phase diagram" />
          <attvalue for="1" value="Phase Diagram" />
          <attvalue for="2" value="Fe-Nb相图是描述铁(Fe)和铌(Nb)二元合金在不同温度与成分下，于平衡状态时相组成的图谱。该图谱揭示了系统中的固溶体、共晶与包晶反应，一个显著特征是存在Fe₂Nb型金属间化合物，即Laves相，它对含铌钢及高温合金的性能有重要影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-3598448f2352e6832a423e2072a2f043" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3598448f2352e6832a423e2072a2f043-e-5" label="Ni">
        <attvalues>
          <attvalue for="0" value="Ni" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="镍（Ni）是一种化学元素，原子序数为28。它是一种坚硬、有延展性的银白色过渡金属，具有铁磁性。因其优良的抗腐蚀性能，被广泛用于制造不锈钢、耐蚀合金、电池以及用作催化剂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3598448f2352e6832a423e2072a2f043" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3598448f2352e6832a423e2072a2f043-e-6" label="Fe">
        <attvalues>
          <attvalue for="0" value="Fe" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="铁是一种化学元素，符号为Fe，原子序数26。它是一种常见的银白色过渡金属，是工业上最重要的金属，广泛用于制造钢材。铁也是构成地球核心的主要成分，并且是包括人类在内的绝大多数生物体所必需的微量营养素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-3598448f2352e6832a423e2072a2f043" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Iron&quot;, &quot;iron&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3598448f2352e6832a423e2072a2f043-e-6&quot;, &quot;chunk-def444476734c5b41ca30b16989718fd-e-7&quot;, &quot;chunk-9f8adabfb1010fa4a4528e361c3f5223-e-2&quot;, &quot;chunk-a9fba026e3b8980c4957dbe16260f585-e-6&quot;, &quot;chunk-23893d297564190aa46fd314ec1e6f0e-e-4&quot;, &quot;chunk-23123c36459ce21f6a8a455f84fb6d73-e-6&quot;, &quot;chunk-5b143324ae92718a4dde1cd69bd72bd2-e-4&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-821a3f267f9ff96b58c19914c2c7eff8-e-1" label="Thermal conductivity">
        <attvalues>
          <attvalue for="0" value="Thermal conductivity" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="导热系数（Thermal conductivity）是表征物质导热能力的物理性质，指在稳定传热条件下，材料内部垂直于热流方向的单位面积、单位温度梯度下所传递的热量。它是材料的固有属性，高热导率物质是热的良导体，而低热导率物质（如热障涂层）则为良好的绝热体。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;κ&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-821a3f267f9ff96b58c19914c2c7eff8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;thermal conductivity&quot;, &quot;κ (Thermal Conductivity)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-821a3f267f9ff96b58c19914c2c7eff8-e-1&quot;, &quot;chunk-e7ffe201a4367e57c9d8b70da74e50b8-e-10&quot;, &quot;chunk-8a09d4abdceadaee1556e78882f58629-e-6&quot;, &quot;chunk-b90367b4b5b4b46e86c0cb9e61cfbb14-e-6&quot;, &quot;chunk-9205fd6987f1eb506eff11a839efe879-e-9&quot;, &quot;chunk-edb9affa83770653e14e4cc8e96d4809-e-5&quot;, &quot;chunk-ea2d68ee6ba96502ab007d093c1ef915-e-4&quot;, &quot;chunk-e4ee2b4726b7ab716e9f01d209b1fd11-e-4&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="12" />
        </attvalues>
      </node>
      <node id="chunk-821a3f267f9ff96b58c19914c2c7eff8-e-2" label="PS">
        <attvalues>
          <attvalue for="0" value="PS" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="等离子喷涂（PS）是一种先进的表面涂层工艺，通过高速喷射熔融材料在基体上沉积涂层。该技术是制备热障涂层（TBCs）的主要方法之一，其工艺过程直接影响涂层的微观结构，从而决定其导热性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-821a3f267f9ff96b58c19914c2c7eff8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-821a3f267f9ff96b58c19914c2c7eff8-e-2&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-821a3f267f9ff96b58c19914c2c7eff8-e-4" label="Porosity">
        <attvalues>
          <attvalue for="0" value="Porosity" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="孔隙度（Porosity），又称孔隙率，是表征材料内部孔隙体积占其总体积比例的物理量。它通常以百分比表示，是衡量材料致密程度的重要指标，并直接影响材料的密度、强度、渗透性及吸附能力等宏观性质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-821a3f267f9ff96b58c19914c2c7eff8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;porosity&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-821a3f267f9ff96b58c19914c2c7eff8-e-4&quot;, &quot;chunk-dddd9f3ab574da5297f93e141b49d4a6-e-4&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-821a3f267f9ff96b58c19914c2c7eff8-e-7" label="Elevated temperatures">
        <attvalues>
          <attvalue for="0" value="Elevated temperatures" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="一种物理条件，在此条件下，材料中晶粒尺寸对热导率的影响减弱，而点缺陷的作用则变得显著。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-821a3f267f9ff96b58c19914c2c7eff8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-821a3f267f9ff96b58c19914c2c7eff8-e-9" label="Dopants">
        <attvalues>
          <attvalue for="0" value="Dopants" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="掺杂剂（Dopants）是一种材料添加剂，指为改变主体材料（如YSZ基陶瓷）的性质而有意引入的微量物质。它们通过促进声子散射等机制来调控材料的物理或化学性能，常见的类型包括稀土元素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-821a3f267f9ff96b58c19914c2c7eff8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-821a3f267f9ff96b58c19914c2c7eff8-e-9&quot;, &quot;chunk-e7ffe201a4367e57c9d8b70da74e50b8-e-2&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-821a3f267f9ff96b58c19914c2c7eff8-e-10" label="YSZ-based ceramics">
        <attvalues>
          <attvalue for="0" value="YSZ-based ceramics" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="YSZ基陶瓷，全称氧化钇稳定氧化锆基陶瓷，是通过在氧化锆(ZrO₂)中掺杂氧化钇(Y₂O₃)作为稳定剂制成的一类先进陶瓷。这种材料具有优异的力学性能、高离子电导率和热稳定性，常被用作固体氧化物燃料电池的电解质、氧传感器、热障涂层及生物牙科材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-821a3f267f9ff96b58c19914c2c7eff8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-821a3f267f9ff96b58c19914c2c7eff8-e-10&quot;, &quot;chunk-e7ffe201a4367e57c9d8b70da74e50b8-e-3&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e7ffe201a4367e57c9d8b70da74e50b8-e-4" label="Phonon dispersion">
        <attvalues>
          <attvalue for="0" value="Phonon dispersion" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="声子色散是固体物理学中的一种基本现象，指晶格振动量子（声子）的频率与其波矢（或波长）之间存在的依赖关系。这种关系决定了晶体的比热、热导率和声速等多种重要的热学与声学性质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-e7ffe201a4367e57c9d8b70da74e50b8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e7ffe201a4367e57c9d8b70da74e50b8-e-5" label="Rare-earth elements">
        <attvalues>
          <attvalue for="0" value="Rare-earth elements" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="稀土元素是一类用作掺杂剂的材料，通常以其氧化物形式（如氧化铒、氧化镱）添加。它们通过作为声子散射中心，阻碍热量传导，从而有效降低主体材料的热导率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e7ffe201a4367e57c9d8b70da74e50b8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-e7ffe201a4367e57c9d8b70da74e50b8-e-6" label="Erbia">
        <attvalues>
          <attvalue for="0" value="Erbia" />
          <attvalue for="1" value="Material Additive" />
          <attvalue for="2" value="氧化铒 (Erbia)，化学式为Er₂O₃，是稀土元素铒 (Erbium) 的氧化物。作为一种重要的材料添加剂，它常被用作光纤放大器和激光器中的掺杂剂，也因其独特的粉红色泽而用作玻璃和陶瓷的着色剂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e7ffe201a4367e57c9d8b70da74e50b8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e7ffe201a4367e57c9d8b70da74e50b8-e-7" label="Ytterbia">
        <attvalues>
          <attvalue for="0" value="Ytterbia" />
          <attvalue for="1" value="Material Additive" />
          <attvalue for="2" value="氧化镱（Ytterbia），化学式为Yb₂O₃，是稀土元素镱的氧化物。作为一种重要的材料添加剂，它常被用作掺杂剂，以调整基质材料的光学、电学等特定性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-e7ffe201a4367e57c9d8b70da74e50b8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e7ffe201a4367e57c9d8b70da74e50b8-e-8" label="Neodymia">
        <attvalues>
          <attvalue for="0" value="Neodymia" />
          <attvalue for="1" value="Material Additive" />
          <attvalue for="2" value="氧化钕（Neodymia），化学式Nd₂O₃，是稀土元素钕的氧化物。作为一种重要的材料添加剂，它常被用作玻璃、陶瓷的着色剂以及激光晶体的掺杂剂，以赋予材料特殊的光学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-e7ffe201a4367e57c9d8b70da74e50b8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e7ffe201a4367e57c9d8b70da74e50b8-e-9" label="Gadolinia">
        <attvalues>
          <attvalue for="0" value="Gadolinia" />
          <attvalue for="1" value="Material Additive" />
          <attvalue for="2" value="氧化钆（Gadolinia），化学式为Gd₂O₃，是一种白色粉末状的稀土金属氧化物。它在材料科学中常被用作掺杂剂或添加剂，以改变主体材料的光学、磁学或热中子吸收等关键性能，应用于闪烁体、激光材料及核工业等领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-e7ffe201a4367e57c9d8b70da74e50b8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e7ffe201a4367e57c9d8b70da74e50b8-e-11" label="Phonon scatterers">
        <attvalues>
          <attvalue for="0" value="Phonon scatterers" />
          <attvalue for="1" value="Functional Role" />
          <attvalue for="2" value="指材料中通过散射声子来阻碍热量传输，从而降低材料热导率的结构或缺陷所扮演的功能角色。例如，作为掺杂剂的稀土元素可在材料中充当声子散射体。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-e7ffe201a4367e57c9d8b70da74e50b8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e7ffe201a4367e57c9d8b70da74e50b8-e-13" label="Sequential Evaporation">
        <attvalues>
          <attvalue for="0" value="Sequential Evaporation" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="**顺序蒸发 (Sequential Evaporation)** 是一种制造工艺，指利用单个电子束，依次蒸发两种不同的陶瓷组分并使其逐层沉积，从而制备出具有层状结构的热障涂层（Layered TBCs）的方法。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-e7ffe201a4367e57c9d8b70da74e50b8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Sequential evaporation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e7ffe201a4367e57c9d8b70da74e50b8-e-13&quot;, &quot;chunk-1bf05ee4be604d397765fc4aeef58ab1-e-2&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1bf05ee4be604d397765fc4aeef58ab1-e-3" label="Single Electron Beam">
        <attvalues>
          <attvalue for="0" value="Single Electron Beam" />
          <attvalue for="1" value="Manufacturing Equipment" />
          <attvalue for="2" value="一种用于顺序蒸发工艺的制造设备。它通过偏转单一电子束，使其在两种不同的陶瓷锭等材料源之间快速切换，从而实现多材料的依次蒸发与沉积。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-1bf05ee4be604d397765fc4aeef58ab1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1bf05ee4be604d397765fc4aeef58ab1-e-4" label="Two Different Ceramic Ingots">
        <attvalues>
          <attvalue for="0" value="Two Different Ceramic Ingots" />
          <attvalue for="1" value="Material Source" />
          <attvalue for="2" value="两种不同成分的陶瓷锭，用作顺序蒸发工艺的源材料。在该工艺中，单一电子束会依次作用于这两种材料，使其加热并蒸发。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1bf05ee4be604d397765fc4aeef58ab1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1bf05ee4be604d397765fc4aeef58ab1-e-5" label="Layer/Layer Boundaries">
        <attvalues>
          <attvalue for="0" value="Layer/Layer Boundaries" />
          <attvalue for="1" value="Material Feature" />
          <attvalue for="2" value="一种材料特征，指层状热障涂层(TBC)中分隔不同陶瓷层的界面。作为层状TBC的典型特征，这些界面的方向通常垂直于涂层的生长方向。" />
          <attvalue for="3" value="{&quot;orientation&quot;: &quot;perpendicular to the TBC growth direction&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1bf05ee4be604d397765fc4aeef58ab1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1bf05ee4be604d397765fc4aeef58ab1-e-6" label="TBC Growth Direction">
        <attvalues>
          <attvalue for="0" value="TBC Growth Direction" />
          <attvalue for="1" value="Directional Property" />
          <attvalue for="2" value="一个描述热障涂层（TBC）在制造过程中材料沉积或生长的矢量属性。该方向通常与涂层的分层及层间边界呈垂直关系，并决定了涂层微观结构（如柱状晶）的取向。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-1bf05ee4be604d397765fc4aeef58ab1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1bf05ee4be604d397765fc4aeef58ab1-e-7" label="Ceria-Zirconia TBCs">
        <attvalues>
          <attvalue for="0" value="Ceria-Zirconia TBCs" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="氧化铈-氧化锆热障涂层（Ceria-Zirconia TBCs）是一种复合材料涂层。它由氧化铈和氧化锆以层状方式混合沉积而成，其典型特征是具有独特的柱状微观结构，属于层状热障涂层的一种。" />
          <attvalue for="3" value="{&quot;structure&quot;: &quot;Columnar, mixed&quot;, &quot;periodicity&quot;: &quot;as small as 0.1 µm&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-1bf05ee4be604d397765fc4aeef58ab1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1bf05ee4be604d397765fc4aeef58ab1-e-7&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1bf05ee4be604d397765fc4aeef58ab1-e-8" label="Alumina-Zirconia TBCs">
        <attvalues>
          <attvalue for="0" value="Alumina-Zirconia TBCs" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="一种由氧化铝和氧化锆混合构成的复合材料涂层，是分层热障涂层（Layered TBC）的一种。该涂层以分层方式生产，具有独特的柱状微观结构。" />
          <attvalue for="3" value="{&quot;structure&quot;: &quot;Columnar, mixed&quot;, &quot;periodicity&quot;: &quot;as small as 0.1 µm&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-1bf05ee4be604d397765fc4aeef58ab1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1bf05ee4be604d397765fc4aeef58ab1-e-8&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a09d4abdceadaee1556e78882f58629-e-1" label="Layered Structures">
        <attvalues>
          <attvalue for="0" value="Layered Structures" />
          <attvalue for="1" value="Material Microstructure" />
          <attvalue for="2" value="一种具有周期性分层特征的材料微观结构。它通常在电子束物理气相沉积（EB-PVD）过程中，通过振荡直流偏压（DC bias）制备而成，其主要作用是有效降低材料的热导率（κ）。" />
          <attvalue for="3" value="{&quot;periodicity&quot;: &quot;as small as 0.1 µm&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-8a09d4abdceadaee1556e78882f58629" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8a09d4abdceadaee1556e78882f58629-e-2" label="Glow Discharge Plasma">
        <attvalues>
          <attvalue for="0" value="Glow Discharge Plasma" />
          <attvalue for="1" value="Process Technology" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;辉光放电等离子体是一种在低压气体中通过电场放电产生的低温等离子体。作为一种核心工艺技术，它被广泛应用于材料表面的薄膜沉积、刻蚀、清洗和改性，通过控制其特性（如密度）来制备特定结构或赋予材料新功能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-8a09d4abdceadaee1556e78882f58629" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="314" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-8a09d4abdceadaee1556e78882f58629-e-3" label="EB-PVD Process">
        <attvalues>
          <attvalue for="0" value="EB-PVD Process" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="电子束物理气相沉积(EB-PVD)工艺是一种先进的物理气相沉积技术。其核心特征是在沉积过程中，通过周期性地振荡直流偏压来控制材料的生长，从而精确制备出具有特定功能的层状结构涂层或薄膜。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-8a09d4abdceadaee1556e78882f58629" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a09d4abdceadaee1556e78882f58629-e-4" label="Substrate">
        <attvalues>
          <attvalue for="0" value="Substrate" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="在电子束物理气相沉积（EB-PVD）等镀膜工艺中，用于承载和生长薄膜的基底材料或工件。通过对其施加直流偏压（DC Bias），可以控制离子轰击的能量，进而调控所沉积薄膜的微观结构与性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-8a09d4abdceadaee1556e78882f58629" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a09d4abdceadaee1556e78882f58629-e-5" label="DC Bias">
        <attvalues>
          <attvalue for="0" value="DC Bias" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="直流偏压（DC Bias）是一种工艺参数，指在电子束物理气相沉积（EB-PVD）等工艺中，施加于基底上的直流电偏压。该偏压在沉积过程中进行周期性振荡，通过调控材料沉积行为，从而制备出具有特定分层特征的层状结构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-8a09d4abdceadaee1556e78882f58629" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8a09d4abdceadaee1556e78882f58629-e-7" label="State-of-the-art TBCs">
        <attvalues>
          <attvalue for="0" value="State-of-the-art TBCs" />
          <attvalue for="1" value="Technology Benchmark" />
          <attvalue for="2" value="指当前实际服役中最先进的热障涂层（TBCs）。它作为一种公认的技术基准，为评估和比较新型涂层材料的性能（如导热系数κ）提供参照标准，是衡量技术进步的标杆。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-8a09d4abdceadaee1556e78882f58629" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a09d4abdceadaee1556e78882f58629-e-8" label="Herringbone Structures">
        <attvalues>
          <attvalue for="0" value="Herringbone Structures" />
          <attvalue for="1" value="Material Microstructure" />
          <attvalue for="2" value="人字形结构（Herringbone Structures）是一种材料微观结构，指晶体、分子或相区以类似鲱鱼骨骼的V形或锯齿形方式紧密堆积而形成的图案。这种高度有序的排列会带来显著的各向异性，从而决定或改善材料的机械、光学及电学等性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-8a09d4abdceadaee1556e78882f58629" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;'herringbone' structures&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8a09d4abdceadaee1556e78882f58629-e-8&quot;, &quot;chunk-077fe9c69fdb63678553adb8495eef57-e-1&quot;]}]" />
          <attvalue for="9" value="198" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-077fe9c69fdb63678553adb8495eef57-e-2" label="substrate">
        <attvalues>
          <attvalue for="0" value="substrate" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="一种在沉积工艺中用作基底的材料组件。通过在沉积过程中对其进行操纵，可以构建出特定的“人字形”结构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-077fe9c69fdb63678553adb8495eef57" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="198" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-077fe9c69fdb63678553adb8495eef57-e-3" label="Coatings with 'herringbone' structures">
        <attvalues>
          <attvalue for="0" value="Coatings with 'herringbone' structures" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="一种通过在沉积过程中操控基底，有意形成人字形微观结构的特种涂层。这种独特的结构使其热导率显著低于传统的直列柱状热障涂层，从而具备更优异的隔热性能。" />
          <attvalue for="3" value="{&quot;thermal_conductivity&quot;: &quot;up to 25% lower than straight-columned TBCs&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-077fe9c69fdb63678553adb8495eef57" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="199" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-077fe9c69fdb63678553adb8495eef57-e-4" label="straight-columned TBCs">
        <attvalues>
          <attvalue for="0" value="straight-columned TBCs" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="一种热障涂层(TBC)，其微观结构特征为相互分离的、垂直于基底的直列柱状晶粒。该结构通常由电子束物理气相沉积(EB-PVD)工艺制备，具有优良的应变容限，用于航空发动机涡轮叶片等高温部件的热防护。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-077fe9c69fdb63678553adb8495eef57" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-077fe9c69fdb63678553adb8495eef57-e-4&quot;, &quot;chunk-e01b059cc1c9a00298a478f93a9ec05a-e-1&quot;]}]" />
          <attvalue for="9" value="199" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e01b059cc1c9a00298a478f93a9ec05a-e-2" label="high-velocity gas flows">
        <attvalues>
          <attvalue for="0" value="high-velocity gas flows" />
          <attvalue for="1" value="Process Medium" />
          <attvalue for="2" value="一种在定向蒸气沉积（directed vapour deposition）工艺中用作过程介质的高速流动气体。它的核心功能是聚焦蒸气羽（vapour plume），从而精确控制材料的沉积方向与位置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-e01b059cc1c9a00298a478f93a9ec05a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="63" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e01b059cc1c9a00298a478f93a9ec05a-e-3" label="vapour plume">
        <attvalues>
          <attvalue for="0" value="vapour plume" />
          <attvalue for="1" value="Material State" />
          <attvalue for="2" value="在材料沉积过程中，被高速气流聚焦和引导而形成的一种特定形态的蒸气流。它的形状、密度和方向决定了沉积材料的最终分布和微观结构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-e01b059cc1c9a00298a478f93a9ec05a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="63" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e01b059cc1c9a00298a478f93a9ec05a-e-4" label="directed vapour deposition">
        <attvalues>
          <attvalue for="0" value="directed vapour deposition" />
          <attvalue for="1" value="Deposition Process" />
          <attvalue for="2" value="定向气相沉积是一种物理气相沉积工艺。它利用高速载气流将蒸气羽流聚焦并引导，使其高速沉积在基底上形成涂层。该技术能精确控制涂层的微观结构，常用于制备具有特定性能的涂层，例如7YSZ热障涂层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-e01b059cc1c9a00298a478f93a9ec05a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="63" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e01b059cc1c9a00298a478f93a9ec05a-e-5" label="7YSZ coatings">
        <attvalues>
          <attvalue for="0" value="7YSZ coatings" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="Coatings produced by 'directed vapour deposition' with conductivities equivalent to those from APS processing." />
          <attvalue for="3" value="{&quot;composition&quot;: &quot;7YSZ&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e01b059cc1c9a00298a478f93a9ec05a" />
          <attvalue for="9" value="63" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e01b059cc1c9a00298a478f93a9ec05a-e-6" label="APS processing">
        <attvalues>
          <attvalue for="0" value="APS processing" />
          <attvalue for="1" value="Deposition Process" />
          <attvalue for="2" value="大气等离子喷涂（Atmospheric Plasma Spraying, APS）是一种热喷涂沉积工艺。它所制备的7YSZ涂层，其电导率常被用作一个基准，以对比评估通过定向气相沉积等其他技术生产的涂层性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e01b059cc1c9a00298a478f93a9ec05a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="63" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e01b059cc1c9a00298a478f93a9ec05a-e-7" label="Overlay coatings">
        <attvalues>
          <attvalue for="0" value="Overlay coatings" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="MCrAlY涂层是一类高温合金防护涂层，其名称代表其主要化学成分：M（通常为镍Ni、钴Co或其合金）、铬（Cr）、铝（Al）和钇（Y）。这类涂层主要应用于航空发动机和燃气轮机的热端部件表面，通过在高温下形成一层致密的氧化铝保护膜，为基体材料提供优异的抗高温氧化和抗热腐蚀性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-e01b059cc1c9a00298a478f93a9ec05a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;AlY overlay coatings&quot;, &quot;Co-based overlay coatings&quot;, &quot;CoCrAlY overlay&quot;, &quot;CoNiCrAlY-type coating&quot;, &quot;MCrAlY Coatings&quot;, &quot;MCrAlY coating&quot;, &quot;MCrAlY coating systems&quot;, &quot;MCrAlY-type coatings&quot;, &quot;NiCrAlY-type overlay coating&quot;, &quot;Nickel-based overlay coatings&quot;, &quot;Ni–20Cr–12Al–Y overlay coating&quot;, &quot;Overlay Coatings&quot;, &quot;Overlay coating&quot;, &quot;Overlays&quot;, &quot;nickel-based overlay coatings&quot;, &quot;overlay coating&quot;, &quot;overlay coatings&quot;, &quot;overlays&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e01b059cc1c9a00298a478f93a9ec05a-e-7&quot;, &quot;chunk-518564762410dd52d42b1aa0d775ef76-e-1&quot;, &quot;chunk-15ec833d634a94516c077a6a065429ad-e-1&quot;, &quot;chunk-a921a108c7811dc9a541483523b2c983-e-1&quot;, &quot;chunk-6f03154ca36cf3915a23738d2e17bbfa-e-5&quot;, &quot;chunk-d55298f42964ce23c30b0bcafa72ab6c-e-11&quot;, &quot;chunk-7ac0ca58bfe13a4f34daf0b8dc6214df-e-4&quot;, &quot;chunk-aeb95c93346b29b2210d9a08444b0239-e-1&quot;, &quot;chunk-a50c448a2f6a7b96ed4e6c60e9286391-e-2&quot;, &quot;chunk-5268439e43d92c2ee6fb5551a0ab1a7d-e-5&quot;, &quot;chunk-203cb57048ee781208098d35869844a7-e-1&quot;, &quot;chunk-e3fb38d02a415446b1548e163c6a6dda-e-5&quot;, &quot;chunk-6f4c84e8661d1e3a5f359969b56cd45d-e-2&quot;, &quot;chunk-15c033042f1da840c39554ca327f7acd-e-4&quot;, &quot;chunk-10bd7f0e07de14852011152b501359da-e-2&quot;, &quot;chunk-9a03b89c4abdb7803daf0ef7320556a8-e-1&quot;, &quot;chunk-b39db212478fb453fe79022a544f44e9-e-2&quot;, &quot;chunk-069e9bb3e2c8dfdab86052450cf45cd2-e-3&quot;, &quot;chunk-be5a585b4779a163f574e99353c822f8-e-1&quot;, &quot;chunk-731dc84802c72d92f71d829e7e01d610-e-1&quot;, &quot;chunk-f84d9415930cf45b94dd88365f7c6b9e-e-7&quot;, &quot;chunk-9205fd6987f1eb506eff11a839efe879-e-10&quot;, &quot;chunk-4bc43156e1a0a7c73048cc8f158c8919-e-1&quot;, &quot;chunk-3ef3a46d5883ceba55b19f3ce086fd54-e-5&quot;, &quot;chunk-3ef3a46d5883ceba55b19f3ce086fd54-e-9&quot;, &quot;chunk-8e4f95988fb5d512b274348d9b3d4dca-e-10&quot;, &quot;chunk-df56dbe04dca860f9b208ab9b4878418-e-10&quot;, &quot;chunk-6eb9964e0070cc2b73d942919084bb21-e-12&quot;, &quot;chunk-f7942340b7bda97e3a76f6ceb1d90c75-e-5&quot;, &quot;chunk-2555e274f1223f9245526a48267868ff-e-9&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="47" />
        </attvalues>
      </node>
      <node id="chunk-e01b059cc1c9a00298a478f93a9ec05a-e-9" label="MCrAlX type">
        <attvalues>
          <attvalue for="0" value="MCrAlX type" />
          <attvalue for="1" value="Coating Composition" />
          <attvalue for="2" value="一种覆盖涂层的通用化学成分类型，其名称代表主要元素：M（通常为镍、钴或其合金）、Cr（铬）、Al（铝）和X（通常为钇等活性元素）。这类涂层主要用于高温环境下的抗氧化和抗腐蚀防护。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-e01b059cc1c9a00298a478f93a9ec05a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e01b059cc1c9a00298a478f93a9ec05a-e-10" label="nickel">
        <attvalues>
          <attvalue for="0" value="nickel" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="镍（Nickel）是一种化学元素，符号Ni，原子序数28。它是一种坚硬、耐腐蚀的银白色过渡金属。在MCrAlX高温防护涂层中，它常作为主要基体金属（M），为涂层提供核心的高温抗氧化与耐腐蚀性能。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;Ni&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-e01b059cc1c9a00298a478f93a9ec05a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-518564762410dd52d42b1aa0d775ef76-e-3" label="MCrAlX">
        <attvalues>
          <attvalue for="0" value="MCrAlX" />
          <attvalue for="1" value="Coating Composition" />
          <attvalue for="2" value="MCrAlX是一类高温防护覆盖涂层的合金成分总称。其名称代表了主要元素：M为基体金属（如镍、钴），Cr为铬，Al为铝，X为活性元素（如钇）。这类涂层主要用于保护航空发动机和燃气轮机的高温部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-518564762410dd52d42b1aa0d775ef76" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-518564762410dd52d42b1aa0d775ef76-e-4" label="M">
        <attvalues>
          <attvalue for="0" value="M" />
          <attvalue for="1" value="Composition Component" />
          <attvalue for="2" value="在MCrAlX涂层体系中，M是一个化学组分符号，代表构成涂层金属基体的元素。它特指镍（Ni）、钴（Co）或由这两种元素任意比例组合而成的合金。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-518564762410dd52d42b1aa0d775ef76" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-518564762410dd52d42b1aa0d775ef76-e-5" label="Nickel (Ni)">
        <attvalues>
          <attvalue for="0" value="Nickel (Ni)" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="镍（Nickel, Ni），一种化学元素，原子序数为28。它是一种坚硬、有延展性的银白色铁磁性金属，具有优良的耐腐蚀和抗氧化性能。因此，它被广泛用于制造不锈钢、电池以及特种高温合金，例如作为MCrAlX涂层中的M组分以提高其性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-518564762410dd52d42b1aa0d775ef76" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-518564762410dd52d42b1aa0d775ef76-e-7" label="X">
        <attvalues>
          <attvalue for="0" value="X" />
          <attvalue for="1" value="Composition Component" />
          <attvalue for="2" value="在MCrAlX高温涂层配方中，“X”是代表少量添加的活性元素的化学符号。该元素通常为钇(Y)，也可为其他稀土元素，其作用是显著提高涂层的抗氧化性能和与基体的附着力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-518564762410dd52d42b1aa0d775ef76" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-518564762410dd52d42b1aa0d775ef76-e-8" label="Yttrium (Y)">
        <attvalues>
          <attvalue for="0" value="Yttrium (Y)" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="钇（Yttrium）是一种化学元素，符号为Y，原子序数39。它是一种银白色的过渡金属，因化学性质与镧系元素相似，常被归类为稀土元素。其重要应用包括制造激光晶体（如YAG激光）、红色荧光粉、高温超导体以及特种合金。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-518564762410dd52d42b1aa0d775ef76" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Y&quot;, &quot;Yttrium&quot;, &quot;yttrium&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-518564762410dd52d42b1aa0d775ef76-e-8&quot;, &quot;chunk-a921a108c7811dc9a541483523b2c983-e-3&quot;, &quot;chunk-d55298f42964ce23c30b0bcafa72ab6c-e-10&quot;, &quot;chunk-a35080278b59ba7a84e2e894c60ccd0c-e-7&quot;, &quot;chunk-1b1d17125a9be9ae98260d7ef4e48178-e-3&quot;, &quot;chunk-2c4f37da3f587d0e8f8c088fdda0d333-e-6&quot;, &quot;chunk-5f8bf38171a410fd46c9accc216760df-e-3&quot;, &quot;chunk-84d1269d81f3d4fb66cfdbb567801e32-e-9&quot;, &quot;chunk-a32309070a2ae9bb93878cff40ade2c7-e-1&quot;, &quot;chunk-ec7c4b2174ee3c0c5d15649dfb3d1582-e-4&quot;, &quot;chunk-7638042a561888cfdce1fb2ee9ad0428-e-5&quot;, &quot;chunk-bc88baa62dfcfaa0545bb367cad979a7-e-7&quot;, &quot;chunk-dbe450c14d87c9df145aceea4a48b35c-e-3&quot;, &quot;chunk-c527d2fb17717642598fb40a49925e7f-e-8&quot;, &quot;chunk-897e7353863e7f334da90636833fd561-e-1&quot;, &quot;chunk-3ef3a46d5883ceba55b19f3ce086fd54-e-2&quot;, &quot;chunk-0873a0a95770ac23ed7add0b0ad4b3c0-e-5&quot;, &quot;chunk-67429b99cdb3121ddbb638d5930365e4-e-10&quot;, &quot;chunk-22dadd8677004929f45649f589c98023-e-6&quot;, &quot;chunk-78c519f8cce4113c48c714a60ca273ce-e-3&quot;, &quot;chunk-e039cb317db23e5137b0d2d1164a7ea9-e-13&quot;, &quot;chunk-c8a13933656ed9f144b18b40f2e9861e-e-1&quot;, &quot;chunk-db7cc890c68f0a43d000b2dba6ecf910-e-4&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="28" />
        </attvalues>
      </node>
      <node id="chunk-518564762410dd52d42b1aa0d775ef76-e-9" label="Substrate">
        <attvalues>
          <attvalue for="0" value="Substrate" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="一种材料组件，指在涂层工艺中用于承载涂层的基底材料。其化学成分独立于上方施加的覆层涂料。例如，高温合金常被用作承载热障涂层的基体。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-518564762410dd52d42b1aa0d775ef76" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-15ec833d634a94516c077a6a065429ad-e-3" label="Cobalt-based Alloy">
        <attvalues>
          <attvalue for="0" value="Cobalt-based Alloy" />
          <attvalue for="1" value="Alloy System" />
          <attvalue for="2" value="以钴为基体的合金体系，通常添加铬、铝、钇等元素，具有优异的高温强度、抗氧化和耐腐蚀性能。它是开发和制备高温防护覆盖涂层（如CoCrAlY）的关键基础材料。" />
          <attvalue for="3" value="{&quot;Cr_wt%&quot;: &quot;20 to 40&quot;, &quot;Al_wt%&quot;: &quot;12 to 20&quot;, &quot;Y_wt%&quot;: &quot;around 0.5&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-15ec833d634a94516c077a6a065429ad" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-15ec833d634a94516c077a6a065429ad-e-4" label="Co–25Cr–14Al–0.5Y">
        <attvalues>
          <attvalue for="0" value="Co–25Cr–14Al–0.5Y" />
          <attvalue for="1" value="Alloy Composition" />
          <attvalue for="2" value="Co–25Cr–14Al–0.5Y是一种钴基合金，其标称成分(按重量计)为25%的铬(Cr)、14%的铝(Al)和0.5%的钇(Y)，余量为钴。它是一种经典的早期罩面涂层材料，因其优异的高温抗氧化和抗腐蚀性能而获得成功应用。" />
          <attvalue for="3" value="{&quot;base_element&quot;: &quot;Co&quot;, &quot;Cr_wt%&quot;: &quot;25&quot;, &quot;Al_wt%&quot;: &quot;14&quot;, &quot;Y_wt%&quot;: &quot;0.5&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-15ec833d634a94516c077a6a065429ad" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-15ec833d634a94516c077a6a065429ad-e-5" label="Desired Surface Properties">
        <attvalues>
          <attvalue for="0" value="Desired Surface Properties" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种材料属性，指通过施加覆层涂料技术，在材料表面形成的能够满足特定应用需求的最佳特性组合。" />
          <attvalue for="3" value="{&quot;examples&quot;: &quot;oxidation and corrosion resistances, strength and ductility&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-15ec833d634a94516c077a6a065429ad" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a921a108c7811dc9a541483523b2c983-e-2" label="Co–25Cr–14Al–0.5Y">
        <attvalues>
          <attvalue for="0" value="Co–25Cr–14Al–0.5Y" />
          <attvalue for="1" value="Material Composition" />
          <attvalue for="2" value="Co–25Cr–14Al–0.5Y 是一种钴基覆盖涂层 (Co-based overlay coating) 的合金材料成分。该合金以钴(Co)为基体，含有按重量百分比计25%的铬(Cr)、14%的铝(Al)和0.5%的钇(Y)。这种特定成分的涂层常用于高温或腐蚀环境中，以保护基底材料。" />
          <attvalue for="3" value="{&quot;Cobalt (Co)&quot;: &quot;Base&quot;, &quot;Chromium (Cr)&quot;: &quot;25 wt%&quot;, &quot;Aluminum (Al)&quot;: &quot;14 wt%&quot;, &quot;Yttrium (Y)&quot;: &quot;0.5 wt%&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a921a108c7811dc9a541483523b2c983" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a921a108c7811dc9a541483523b2c983-e-4" label="Hot-corrosion resistance">
        <attvalues>
          <attvalue for="0" value="Hot-corrosion resistance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="高温耐腐蚀性 (hot corrosion resistance) 是指材料在高温熔盐或气体环境中抵抗化学侵蚀的能力。作为超合金的关键性能之一，它在航空发动机等领域至关重要，但会被钒等杂质元素显著削弱。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a921a108c7811dc9a541483523b2c983" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;hot corrosion resistance&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a921a108c7811dc9a541483523b2c983-e-4&quot;, &quot;chunk-44260d4b7de8c9a00040496e0aad271b-e-6&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a921a108c7811dc9a541483523b2c983-e-8" label="Precious metals">
        <attvalues>
          <attvalue for="0" value="Precious metals" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="贵金属是一类化学元素的统称，此类别下包含铂(Pt)、钯(Pd)、钌(Ru)和铼(Re)等。在材料科学领域，它们可作为合金添加剂，用于改性钴基覆盖涂层以提升其性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-a921a108c7811dc9a541483523b2c983" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-a921a108c7811dc9a541483523b2c983-e-10" label="Pd">
        <attvalues>
          <attvalue for="0" value="Pd" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="钯（Palladium）是一种化学元素，符号为Pd，原子序数为46。它属于铂族金属，是一种稀有、有光泽的银白色过渡金属，以其优异的催化性能而闻名，广泛应用于催化转换器和珠宝制作中。" />
          <attvalue for="3" value="{&quot;name&quot;: &quot;Palladium&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-a921a108c7811dc9a541483523b2c983" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;palladium&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a921a108c7811dc9a541483523b2c983-e-10&quot;, &quot;chunk-6f03154ca36cf3915a23738d2e17bbfa-e-2&quot;, &quot;chunk-cad1eaa9ffb0e731892120bbe3415da7-e-14&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-6f03154ca36cf3915a23738d2e17bbfa-e-6" label="MCrAlY">
        <attvalues>
          <attvalue for="0" value="MCrAlY" />
          <attvalue for="1" value="Coating Concept" />
          <attvalue for="2" value="MCrAlY是一种高温防护涂层概念，其名称代表主要化学成分：金属M（通常为镍Ni、钴Co或其合金）、铬(Cr)、铝(Al)和钇(Y)。该涂层体系旨在抵抗高温环境下的氧化和腐蚀，常作为热障涂层的关键粘结层，并衍生出众多专利变体。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-6f03154ca36cf3915a23738d2e17bbfa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="200" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6f03154ca36cf3915a23738d2e17bbfa-e-7" label="Patented Variations of MCrAlY">
        <attvalues>
          <attvalue for="0" value="Patented Variations of MCrAlY" />
          <attvalue for="1" value="Intellectual Property" />
          <attvalue for="2" value="指对MCrAlY高温防护涂层进行成分或工艺改良，并获得专利保护的创新技术。作为一种知识产权，这些变体旨在通过新颖设计，显著提升涂层在抗氧化、耐腐蚀及热稳定性等方面的关键性能。" />
          <attvalue for="3" value="{&quot;count_as_of_1998&quot;: &quot;at least 40&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-6f03154ca36cf3915a23738d2e17bbfa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="200" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6d7a887b0ad8aa25cf8cb0d2e4a60af2-e-1" label="NiCoCrAlY-type coatings">
        <attvalues>
          <attvalue for="0" value="NiCoCrAlY-type coatings" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="一种以镍钴铬铝钇(NiCoCrAlY)为基础的合金涂层，通常采用等离子喷涂工艺制备。通过添加硅(Si)和铪(Hf)元素进行改性，可显著提升其在高温环境下的循环抗氧化性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-6d7a887b0ad8aa25cf8cb0d2e4a60af2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-6d7a887b0ad8aa25cf8cb0d2e4a60af2-e-4" label="Cyclic oxidation performance">
        <attvalues>
          <attvalue for="0" value="Cyclic oxidation performance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="循环氧化性能指材料在周期性升降温的高温氧化气氛中，抵抗氧化及其表面氧化物层剥落的能力。它是评估高温合金及热防护涂层（如NiCoCrAlY涂层）在热循环工况下长期服役稳定性和寿命的关键性能指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-6d7a887b0ad8aa25cf8cb0d2e4a60af2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6d7a887b0ad8aa25cf8cb0d2e4a60af2-e-4&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d55298f42964ce23c30b0bcafa72ab6c-e-3" label="Low-vapour-pressure elements">
        <attvalues>
          <attvalue for="0" value="Low-vapour-pressure elements" />
          <attvalue for="1" value="Element Category" />
          <attvalue for="2" value="低蒸气压元素 (Low-vapour-pressure elements) 指一类饱和蒸气压极低的化学元素。该特性导致它们在电子束物理气相沉积 (EB-PVD) 等工艺中难以有效蒸发和转移。典型例子包括硅 (Si)、钽 (Ta) 和铪 (Hf)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d55298f42964ce23c30b0bcafa72ab6c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-d55298f42964ce23c30b0bcafa72ab6c-e-7" label="Ni">
        <attvalues>
          <attvalue for="0" value="Ni" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="镍（Ni）是一种化学元素，原子序数28。它是一种坚韧且抗腐蚀的银白色过渡金属，具有铁磁性。因其优异的物理和化学性质，被广泛用于制造不锈钢、特种合金、电池，以及在电镀中用作防腐蚀涂层。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;Ni&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d55298f42964ce23c30b0bcafa72ab6c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="315" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-d55298f42964ce23c30b0bcafa72ab6c-e-12" label="Al₂O₃-based oxide scale">
        <attvalues>
          <attvalue for="0" value="Al₂O₃-based oxide scale" />
          <attvalue for="1" value="Material Scale" />
          <attvalue for="2" value="一种在MCrAlY涂层等材料表面，于高温环境中形成的、以氧化铝(Al2O3)为基底的氧化物层。该氧化层致密且具有强附着力，能作为保护屏障，有效阻止底层金属基体进一步氧化或被腐蚀。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-d55298f42964ce23c30b0bcafa72ab6c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Al2O3-based oxide scale&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d55298f42964ce23c30b0bcafa72ab6c-e-12&quot;, &quot;chunk-7ac0ca58bfe13a4f34daf0b8dc6214df-e-1&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d55298f42964ce23c30b0bcafa72ab6c-e-13" label="Oxidation resistance">
        <attvalues>
          <attvalue for="0" value="Oxidation resistance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="抗氧化性（Oxidation resistance）是一种材料性能，指材料在高温环境中抵抗因与氧或含氧物质发生化学反应而导致的腐蚀、降解或损坏的能力。它是评估和设计高温合金及防护涂层（如镍基涂层）在服役条件下保持化学稳定性和结构完整性的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-d55298f42964ce23c30b0bcafa72ab6c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Oxidation performance&quot;, &quot;Oxidation properties&quot;, &quot;Resistance to oxidation&quot;, &quot;oxidation resistance&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d55298f42964ce23c30b0bcafa72ab6c-e-13&quot;, &quot;chunk-aeb95c93346b29b2210d9a08444b0239-e-3&quot;, &quot;chunk-6ce78613853147c21bacd4dcc417e01e-e-4&quot;, &quot;chunk-e7b8406b8d85a1255a692ddd5452a482-e-5&quot;, &quot;chunk-533ad7cdb770d7bc31f971d5ee333007-e-5&quot;, &quot;chunk-b821a94296e5e31338263fc084ea39d5-e-5&quot;, &quot;chunk-5abc3c05849dadfca952537bf1c8dc41-e-4&quot;, &quot;chunk-22dadd8677004929f45649f589c98023-e-7&quot;, &quot;chunk-151e712d06b4c385e5757120e064b560-e-6&quot;, &quot;chunk-b6d430b58fe5b3336f2235e2e6daa465-e-7&quot;, &quot;chunk-0440023a44a202881a859e66f23ec3de-e-2&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-7ac0ca58bfe13a4f34daf0b8dc6214df-e-2" label="Ni–25Cr–6Al–0.4Y">
        <attvalues>
          <attvalue for="0" value="Ni–25Cr–6Al–0.4Y" />
          <attvalue for="1" value="Material Composition" />
          <attvalue for="2" value="一种以镍为基体，按重量百分比含有25%铬、6%铝和0.4%钇的MCrAlY合金。它通常作为一种罩面涂层材料，用于在高温环境下为基材提供优异的抗氧化和抗腐蚀保护。" />
          <attvalue for="3" value="{&quot;Ni&quot;: &quot;balance&quot;, &quot;Cr&quot;: &quot;25 wt%&quot;, &quot;Al&quot;: &quot;6 wt%&quot;, &quot;Y&quot;: &quot;0.4 wt%&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-7ac0ca58bfe13a4f34daf0b8dc6214df" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7ac0ca58bfe13a4f34daf0b8dc6214df-e-3" label="Ni–22Cr–10Al–1Y">
        <attvalues>
          <attvalue for="0" value="Ni–22Cr–10Al–1Y" />
          <attvalue for="1" value="Material Composition" />
          <attvalue for="2" value="Ni–22Cr–10Al–1Y是一种镍基合金，其成分（重量百分比）为22%铬、10%铝和1%钇。因其卓越的高温抗氧化和抗腐蚀性能，它被广泛用作一种防护性覆层材料，常应用于航空发动机等高温环境中。" />
          <attvalue for="3" value="{&quot;Ni&quot;: &quot;balance&quot;, &quot;Cr&quot;: &quot;22 wt%&quot;, &quot;Al&quot;: &quot;10 wt%&quot;, &quot;Y&quot;: &quot;1 wt%&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-7ac0ca58bfe13a4f34daf0b8dc6214df" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7ac0ca58bfe13a4f34daf0b8dc6214df-e-5" label="Bond coats in TBC systems">
        <attvalues>
          <attvalue for="0" value="Bond coats in TBC systems" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="作为热障涂层（TBC）体系的关键金属中间层，通常是一种覆盖涂层（如MCrAlY）。它位于陶瓷面层与基体之间，主要作用是提供附着力，并保护基体免受高温氧化和腐蚀。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-7ac0ca58bfe13a4f34daf0b8dc6214df" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7ac0ca58bfe13a4f34daf0b8dc6214df-e-6" label="Siemens Company">
        <attvalues>
          <attvalue for="0" value="Siemens Company" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="西门子（Siemens）是一家全球领先的德国技术企业，业务聚焦于工业、基础设施、交通和医疗等领域。在先进材料科学方面，该公司开创性地将铼（Re）元素引入其MCrAlY高温防护涂层技术中，以增强关键部件在极端环境下的性能与耐用性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-7ac0ca58bfe13a4f34daf0b8dc6214df" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7ac0ca58bfe13a4f34daf0b8dc6214df-e-8" label="MCrAlY overlay coatings">
        <attvalues>
          <attvalue for="0" value="MCrAlY overlay coatings" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="MCrAlY覆层涂层是一类高温防护涂层，其名称代表其主要成分（M: Ni/Co, Cr, Al, Y）。它主要用于工业燃气轮机等高温环境，通过在表面形成致密的氧化铝(Al₂O₃)保护层，来抵抗基体合金的高温氧化和腐蚀。可通过添加铼(Re)等元素来提升性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-7ac0ca58bfe13a4f34daf0b8dc6214df" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-7ac0ca58bfe13a4f34daf0b8dc6214df-e-9" label="Industrial gas turbines">
        <attvalues>
          <attvalue for="0" value="Industrial gas turbines" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="工业燃气轮机是一种将燃料的化学能转化为机械功的旋转式内燃动力机械。它通过吸入并压缩空气，与燃料混合燃烧产生高温高压燃气，驱动涡轮机高速旋转。主要用于大规模发电、管道增压及船舶和车辆的机械驱动。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-7ac0ca58bfe13a4f34daf0b8dc6214df" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-aeb95c93346b29b2210d9a08444b0239-e-2" label="Industrial gas turbines">
        <attvalues>
          <attvalue for="0" value="Industrial gas turbines" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="工业燃气轮机是一种旋转式内燃机，将燃料化学能转化为机械功，主要用于大规模发电或驱动工业设备。因其核心部件在高温、高压的严苛环境中运行，常采用AlY叠层涂层等先进材料技术进行保护，以抵抗氧化和腐蚀。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-aeb95c93346b29b2210d9a08444b0239" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-aeb95c93346b29b2210d9a08444b0239-e-4" label="Thermomechanical properties">
        <attvalues>
          <attvalue for="0" value="Thermomechanical properties" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**热机械性能 (Thermomechanical properties)**&#10;&#10;材料在机械应力与热负荷共同作用下所表现出的力学行为与响应。它综合描述了材料的变形、损伤与断裂特性，涵盖热膨胀、蠕变和热疲劳等关键指标，是评估材料在高温或变温环境下服役可靠性的重要依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-aeb95c93346b29b2210d9a08444b0239" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-aeb95c93346b29b2210d9a08444b0239-e-5" label="Microstructure">
        <attvalues>
          <attvalue for="0" value="Microstructure" />
          <attvalue for="1" value="Material Structure" />
          <attvalue for="2" value="AlY熔覆涂层所具有的微观结构，特指一种由ß-NiAl相和y–Ni相组成的双相混合物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-aeb95c93346b29b2210d9a08444b0239" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-aeb95c93346b29b2210d9a08444b0239-e-7" label="y–Ni">
        <attvalues>
          <attvalue for="0" value="y–Ni" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="γ-Ni相是一种固溶体相。在AlY覆盖涂层的微观结构中，它作为两相混合物的一个重要组成相而存在。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-aeb95c93346b29b2210d9a08444b0239" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-aeb95c93346b29b2210d9a08444b0239-e-7&quot;]}]" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-aeb95c93346b29b2210d9a08444b0239-e-8" label="NiCrAlY-type compositions">
        <attvalues>
          <attvalue for="0" value="NiCrAlY-type compositions" />
          <attvalue for="1" value="Material Composition" />
          <attvalue for="2" value="一类以镍(Ni)为基体，添加了铬(Cr)、铝(Al)和钇(Y)的高温合金成分。其作为耐高温和抗氧化的防护涂层，通过在表面形成一层致密、附着力强的氧化铝保护膜来抵御高温氧化和热腐蚀，常被用作热障涂层的粘结层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-aeb95c93346b29b2210d9a08444b0239" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="201" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-aeb95c93346b29b2210d9a08444b0239-e-9" label="Nickel-based overlay coatings">
        <attvalues>
          <attvalue for="0" value="Nickel-based overlay coatings" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="镍基覆盖涂层是一种以镍为主要成分的材料涂层。它通常添加铬(Cr)、铝(Al)等合金元素（如典型的NiCrAlY系），通过热喷涂或堆焊等技术施加于基材表面，旨在提供优异的高温抗氧化、抗腐蚀及耐磨损性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-aeb95c93346b29b2210d9a08444b0239" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="201" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a50c448a2f6a7b96ed4e6c60e9286391-e-1" label="AlY-type compositions">
        <attvalues>
          <attvalue for="0" value="AlY-type compositions" />
          <attvalue for="1" value="Material Composition" />
          <attvalue for="2" value="AlY型成分是一类含有铝(Al)和钇(Y)的镍基合金，通常用作高温防护的覆层涂层。其防护机制在于，铝在高温下形成致密的氧化铝保护膜，而钇能显著提高该氧化膜与基体的结合力，从而赋予材料优异的抗高温氧化和抗腐蚀性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-a50c448a2f6a7b96ed4e6c60e9286391" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a50c448a2f6a7b96ed4e6c60e9286391-e-3" label="Pettit and co-workers">
        <attvalues>
          <attvalue for="0" value="Pettit and co-workers" />
          <attvalue for="1" value="Research Group" />
          <attvalue for="2" value="Pettit and co-workers是一个以其在高温合金领域的早期开创性研究而闻名的研究团队。该团队发表了多篇关键论文，深入探讨了特定合金在高温下的行为，特别是对镍铬铝（Ni–Cr–Al）三元合金的研究，为理解其性能和机理提供了重要见解。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a50c448a2f6a7b96ed4e6c60e9286391" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a50c448a2f6a7b96ed4e6c60e9286391-e-4" label="Ni–Cr–Al ternary alloys">
        <attvalues>
          <attvalue for="0" value="Ni–Cr–Al ternary alloys" />
          <attvalue for="1" value="Alloy System" />
          <attvalue for="2" value="镍铬铝三元合金体系 (Ni–Cr–Al ternary alloys) 是指以镍(Ni)、铬(Cr)和铝(Al)为基础元素构成的一类合金。其关键特性是，根据合金成分的不同，它在高温下能选择性地形成致密的氧化铝(Al2O3)或氧化铬(Cr2O3)保护层，从而具备优异的抗氧化性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a50c448a2f6a7b96ed4e6c60e9286391" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a50c448a2f6a7b96ed4e6c60e9286391-e-5" label="alumina (Al2O3)">
        <attvalues>
          <attvalue for="0" value="alumina (Al2O3)" />
          <attvalue for="1" value="Oxide Scale" />
          <attvalue for="2" value="氧化铝（Al2O3）是一种氧化皮，特指在高温环境下，专门在镍铬铝（Ni-Cr-Al）三元合金表面形成的一层致密的氧化物保护膜。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;Al2O3&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a50c448a2f6a7b96ed4e6c60e9286391" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a50c448a2f6a7b96ed4e6c60e9286391-e-7" label="high temperatures">
        <attvalues>
          <attvalue for="0" value="high temperatures" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="高温是一种环境条件，特指在材料科学中，足以在金属或合金表面引发氧化反应，从而形成氧化皮（如氧化铝、氧化铬）的温度范围。此条件是评估和设计耐高温材料及其腐蚀行为的核心。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a50c448a2f6a7b96ed4e6c60e9286391" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a50c448a2f6a7b96ed4e6c60e9286391-e-7&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ece6784fcf1477ccfde9cea53ba36774-e-2" label="High temperatures">
        <attvalues>
          <attvalue for="0" value="High temperatures" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="一种以显著升高的温度（在此特指1000°C）为特征的环境条件。该条件是诱发材料发生特定物理和化学变化的关键因素，例如促使三氧化二铬（Cr2O3）氧化皮的形成，以及能观察到不同组别的材料行为。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;1000 °C&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-ece6784fcf1477ccfde9cea53ba36774" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ece6784fcf1477ccfde9cea53ba36774-e-3" label="Nickel">
        <attvalues>
          <attvalue for="0" value="Nickel" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍是一种化学元素，符号为Ni，原子序数28。它是一种银白色的过渡金属，具有良好的延展性、磁性和耐腐蚀性，是制造不锈钢和其他多种重要合金的主要成分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-ece6784fcf1477ccfde9cea53ba36774" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ece6784fcf1477ccfde9cea53ba36774-e-5" label="Selective oxidation">
        <attvalues>
          <attvalue for="0" value="Selective oxidation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种合金高温氧化过程。指合金中热力学上更稳定的组分（如铬）被优先氧化，在表面排他性地形成一层致密且有保护性的氧化膜（如三氧化二铬），即使该组分在合金中并非主要成分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ece6784fcf1477ccfde9cea53ba36774" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ece6784fcf1477ccfde9cea53ba36774-e-6" label="Ternary diagram in Figure 5.25">
        <attvalues>
          <attvalue for="0" value="Ternary diagram in Figure 5.25" />
          <attvalue for="1" value="Diagram" />
          <attvalue for="2" value="一个在1000°C条件下，阐释氧化皮形成行为的三元相图。它根据合金成分将氧化行为划分为三个不同的区域（第一组、第二组和第三组），直观地展示了各类氧化皮的生成范围。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-ece6784fcf1477ccfde9cea53ba36774" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ece6784fcf1477ccfde9cea53ba36774-e-7" label="Group I, Group II and Group III behaviour">
        <attvalues>
          <attvalue for="0" value="Group I, Group II and Group III behaviour" />
          <attvalue for="1" value="Classification" />
          <attvalue for="2" value="一个将合金在1000°C高温下的氧化行为，根据所形成表面氧化皮的类型，划分为I、II、III三种模式的分类。这些模式分别对应三元相图中的特定成分区域，用以表征不同组分下的氧化机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ece6784fcf1477ccfde9cea53ba36774" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b01056d7d0ec300f60d9bb3706353f8f-e-1" label="Group I alloys">
        <attvalues>
          <attvalue for="0" value="Group I alloys" />
          <attvalue for="1" value="Alloy Group" />
          <attvalue for="2" value="I类合金 (Group I alloys) 是一类富含镍（Ni），且铝（Al）和钛（Ti）含量较低的合金。其主要特征是在氧化时，表面会形成连续的外部氧化镍（NiO）层，并在其下形成由其他氧化物组成的亚层。" />
          <attvalue for="3" value="{&quot;Composition&quot;: &quot;Rich in Ni, low levels of Al and Ti&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-b01056d7d0ec300f60d9bb3706353f8f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b01056d7d0ec300f60d9bb3706353f8f-e-1&quot;, &quot;chunk-bb636c80a00702ec9bbe14461e908287-e-7&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-b01056d7d0ec300f60d9bb3706353f8f-e-2" label="Ni">
        <attvalues>
          <attvalue for="0" value="Ni" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="镍（Ni）是一种化学元素，原子序数为28。它是一种银白色的过渡金属，质地坚硬，具有高延展性和优异的抗腐蚀性。被广泛用于制造不锈钢、高温合金等多种合金，也常用于电镀和电池制造。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-b01056d7d0ec300f60d9bb3706353f8f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b01056d7d0ec300f60d9bb3706353f8f-e-6" label="Cr2O3">
        <attvalues>
          <attvalue for="0" value="Cr2O3" />
          <attvalue for="1" value="Oxide Scale" />
          <attvalue for="2" value="三氧化二铬(Cr2O3)是在含铬合金表面高温氧化时形成的氧化皮。它能在一定温度范围内提供抗氧化保护，但与致密稳定的氧化铝(Al2O3)相比，其在更高温度下（如&gt;1000°C）易挥发而失效，保护性较差，因此在现代高温合金中并非理想的保护层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-b01056d7d0ec300f60d9bb3706353f8f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Chromia&quot;, &quot;Chromia (Cr2O3) oxide scale&quot;, &quot;Cr2O3 (Chromium Oxide)&quot;, &quot;chromia&quot;, &quot;chromia (Cr2O3)&quot;, &quot;chromia scales&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a50c448a2f6a7b96ed4e6c60e9286391-e-6&quot;, &quot;chunk-ece6784fcf1477ccfde9cea53ba36774-e-1&quot;, &quot;chunk-b01056d7d0ec300f60d9bb3706353f8f-e-6&quot;, &quot;chunk-2292cbd804c7d75d1e8a3ada6e8b42bd-e-2&quot;, &quot;chunk-fda27af1d78f24b216020258d3d0926f-e-4&quot;, &quot;chunk-2dc25af7062fe95786ac7680318cbe70-e-6&quot;, &quot;chunk-ece73a04275b10b6ad2874686306213a-e-6&quot;, &quot;chunk-fbbf41abcd4950c59415caeec768db40-e-10&quot;, &quot;chunk-fbbf41abcd4950c59415caeec768db40-e-12&quot;, &quot;chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-7&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="13" />
        </attvalues>
      </node>
      <node id="chunk-b01056d7d0ec300f60d9bb3706353f8f-e-8" label="Ni spinel">
        <attvalues>
          <attvalue for="0" value="Ni spinel" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="镍尖晶石是一种含镍的、具有尖晶石（spinel）晶体结构的复合氧化物。在材料科学中，它特指某些含镍合金在高温氧化时，于金属表面之下形成的内氧化产物（亚表层），其形成会影响合金的整体性能和寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-b01056d7d0ec300f60d9bb3706353f8f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b01056d7d0ec300f60d9bb3706353f8f-e-8&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b01056d7d0ec300f60d9bb3706353f8f-e-9" label="External scale">
        <attvalues>
          <attvalue for="0" value="External scale" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="一种在I族合金表面形成的连续材料层，是表征该类合金的特征之一。它主要由氧化镍(NiO)构成，并常与内生长层（Sub-scale）相伴共存。" />
          <attvalue for="3" value="{&quot;Continuity&quot;: &quot;continuous&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-b01056d7d0ec300f60d9bb3706353f8f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b01056d7d0ec300f60d9bb3706353f8f-e-9&quot;, &quot;chunk-2dc25af7062fe95786ac7680318cbe70-e-3&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-b01056d7d0ec300f60d9bb3706353f8f-e-10" label="Sub-scale">
        <attvalues>
          <attvalue for="0" value="Sub-scale" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="一种在I族合金上，于外氧化层（External scale）下方形成的内部氧化物层。它由多种氧化物构成，主要包括三氧化二铬（Cr2O3）、三氧化二铝（Al2O3）和镍尖晶石（Ni spinel）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-b01056d7d0ec300f60d9bb3706353f8f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b01056d7d0ec300f60d9bb3706353f8f-e-10&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-b01056d7d0ec300f60d9bb3706353f8f-e-11" label="Group II alloys">
        <attvalues>
          <attvalue for="0" value="Group II alloys" />
          <attvalue for="1" value="Alloy Group" />
          <attvalue for="2" value="第二组合金是一类合金分类，其与第一组和第三组合金的行为边界并非固定，会因温度、加热速率及晶粒尺寸等条件的变化而移动或改变。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-b01056d7d0ec300f60d9bb3706353f8f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b01056d7d0ec300f60d9bb3706353f8f-e-12" label="Group III alloys">
        <attvalues>
          <attvalue for="0" value="Group III alloys" />
          <attvalue for="1" value="Alloy Group" />
          <attvalue for="2" value="第三族合金 (Group III alloys) 是一类富含铬和铝的合金。其突出特点是在氧化时能形成一层纯净、单一的外部三氧化二铝 (Al₂O₃) 保护层，且不产生内部亚表层析出物。在形成此稳定氧化层之前，其表面会先短暂生成 NiO/Ni(Al, Cr)₂O₄。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-b01056d7d0ec300f60d9bb3706353f8f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b01056d7d0ec300f60d9bb3706353f8f-e-12&quot;, &quot;chunk-bb636c80a00702ec9bbe14461e908287-e-3&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-2292cbd804c7d75d1e8a3ada6e8b42bd-e-1" label="Nickel oxide (NiO)">
        <attvalues>
          <attvalue for="0" value="Nickel oxide (NiO)" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="氧化镍（NiO），又称氧化亚镍，是一种由镍和氧组成的无机化合物。它通常为绿色粉末，是重要的碱性氧化物。在冶金学中，它常作为镍或镍基合金在高温下氧化时形成的外部氧化皮（external scale）的主要成分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-2292cbd804c7d75d1e8a3ada6e8b42bd" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;NiO&quot;, &quot;Nickel oxide&quot;, &quot;nickel oxide&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ece6784fcf1477ccfde9cea53ba36774-e-4&quot;, &quot;chunk-b01056d7d0ec300f60d9bb3706353f8f-e-5&quot;, &quot;chunk-2292cbd804c7d75d1e8a3ada6e8b42bd-e-1&quot;, &quot;chunk-db8701f768a162b189950d821beb70d9-e-1&quot;, &quot;chunk-2dc25af7062fe95786ac7680318cbe70-e-4&quot;, &quot;chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-4&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-2292cbd804c7d75d1e8a3ada6e8b42bd-e-4" label="Ni(Al, Cr)2O4">
        <attvalues>
          <attvalue for="0" value="Ni(Al, Cr)2O4" />
          <attvalue for="1" value="Spinel" />
          <attvalue for="2" value="一种具有尖晶石(Spinel)结构的镍铝铬复合氧化物。在特定氧化过程中，它作为初始产物形成亚氧化层，其生成标志着氧化的开始，并随后会被外层的氧化镍(NiO)所覆盖或取代。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-2292cbd804c7d75d1e8a3ada6e8b42bd" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2292cbd804c7d75d1e8a3ada6e8b42bd-e-4&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-2292cbd804c7d75d1e8a3ada6e8b42bd-e-5" label="Oxidation">
        <attvalues>
          <attvalue for="0" value="Oxidation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种合金在氧化环境中发生的化学过程。该过程导致合金表面形成由瞬态氧化物（如Ni(Al, Cr)2O4）向稳定氧化皮（如Cr2O3）演变的氧化层，并可同时在合金内部引发氧化物沉淀（即内部氧化）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2292cbd804c7d75d1e8a3ada6e8b42bd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2292cbd804c7d75d1e8a3ada6e8b42bd-e-6" label="Substrate">
        <attvalues>
          <attvalue for="0" value="Substrate" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种基底材料，是形成三氧化二铬（Cr2O3）和三氧化二铝（Al2O3）这类亚表层氧化物的载体或基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-2292cbd804c7d75d1e8a3ada6e8b42bd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-2292cbd804c7d75d1e8a3ada6e8b42bd-e-7" label="Group II alloys">
        <attvalues>
          <attvalue for="0" value="Group II alloys" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="II类合金 (Group II alloys) 是一类金属材料，其定义性特征是会发生内部亚表层沉淀 (internal sub-scale precipitation) 现象。该过程指在合金基体内部、紧邻主表面氧化皮下方形成细小的新相颗粒，通常发生在高温氧化或腐蚀过程中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-2292cbd804c7d75d1e8a3ada6e8b42bd" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2292cbd804c7d75d1e8a3ada6e8b42bd-e-7&quot;, &quot;chunk-fda27af1d78f24b216020258d3d0926f-e-1&quot;, &quot;chunk-bb636c80a00702ec9bbe14461e908287-e-8&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-2292cbd804c7d75d1e8a3ada6e8b42bd-e-9" label="Internal precipitation">
        <attvalues>
          <attvalue for="0" value="Internal precipitation" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="内部析出是在特定合金（如II族合金）的高温氧化过程中，氧化剂向内扩散并与合金内部较活泼的溶质元素反应，在金属基体内部形成弥散分布的氧化物颗粒的现象。该现象通常与金属表面的外部氧化皮形成同时发生。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-2292cbd804c7d75d1e8a3ada6e8b42bd" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Internal sub-scale precipitation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2292cbd804c7d75d1e8a3ada6e8b42bd-e-9&quot;, &quot;chunk-bb636c80a00702ec9bbe14461e908287-e-9&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-fda27af1d78f24b216020258d3d0926f-e-6" label="NiO/Ni(Al, Cr)2O4 mixed external scale">
        <attvalues>
          <attvalue for="0" value="NiO/Ni(Al, Cr)2O4 mixed external scale" />
          <attvalue for="1" value="Compound Scale" />
          <attvalue for="2" value="一种由氧化镍(NiO)和镍铝/铬尖晶石(Ni(Al, Cr)2O4)组成的瞬态外部氧化皮。它在高温氧化初期形成，先于更稳定的氧化铝(Al2O3)层，并最终被其取代或因自身不稳定而剥落。" />
          <attvalue for="3" value="{&quot;state&quot;: &quot;transient&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-fda27af1d78f24b216020258d3d0926f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;NiO/Ni(Al, Cr)2O4&quot;, &quot;NiO/Ni(Al, Cr)2O4 external scale&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fda27af1d78f24b216020258d3d0926f-e-6&quot;, &quot;chunk-bb636c80a00702ec9bbe14461e908287-e-2&quot;, &quot;chunk-aae63be5befb53cbb763740fd894bee5-e-1&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-bb636c80a00702ec9bbe14461e908287-e-1" label="Cr2O3 sub-scale">
        <attvalues>
          <attvalue for="0" value="Cr2O3 sub-scale" />
          <attvalue for="1" value="Compound Scale" />
          <attvalue for="2" value="一种由三氧化二铬(Cr2O3)构成的连续内氧化层。它在高温氧化过程中，于基体表面初始形成的NiO/Ni(Al,Cr)2O4氧化层下方逐渐生成，并最终将其取代，形成一层更致密、稳定的保护膜。" />
          <attvalue for="3" value="{&quot;type&quot;: &quot;sub-scale&quot;, &quot;characteristic&quot;: &quot;continuous&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-bb636c80a00702ec9bbe14461e908287" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Continuous Cr2O3 sub-scale&quot;, &quot;Cr2O3/Al2O3 sub-scale&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fda27af1d78f24b216020258d3d0926f-e-7&quot;, &quot;chunk-fda27af1d78f24b216020258d3d0926f-e-8&quot;, &quot;chunk-bb636c80a00702ec9bbe14461e908287-e-1&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-bb636c80a00702ec9bbe14461e908287-e-5" label="Aluminium">
        <attvalues>
          <attvalue for="0" value="Aluminium" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="铝是一种化学元素，作为组分之一构成III族合金。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-bb636c80a00702ec9bbe14461e908287" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-aae63be5befb53cbb763740fd894bee5-e-2" label="Al₂O₃">
        <attvalues>
          <attvalue for="0" value="Al₂O₃" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="三氧化二铝（Al₂O₃），又称氧化铝，是一种高硬度、高熔点的白色固体化合物，也是一种两性氧化物。它是生产金属铝的主要原料，并广泛用作陶瓷、磨料和耐火材料。在特定条件下，硫（Sulphur）的存在会促进其发生剥落（spallation）现象。" />
          <attvalue for="3" value="{&quot;thermodynamic_stability&quot;: &quot;greater&quot;, &quot;growth_kinetics&quot;: &quot;slower&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-aae63be5befb53cbb763740fd894bee5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Al2O3&quot;, &quot;Al2O3 (Aluminum Oxide)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ae58c0f988aba111d22bb6ff5c500655-e-3&quot;, &quot;chunk-157f6129afe364a84d6ecbefe4df9e7a-e-7&quot;, &quot;chunk-b01056d7d0ec300f60d9bb3706353f8f-e-7&quot;, &quot;chunk-2292cbd804c7d75d1e8a3ada6e8b42bd-e-3&quot;, &quot;chunk-fda27af1d78f24b216020258d3d0926f-e-5&quot;, &quot;chunk-aae63be5befb53cbb763740fd894bee5-e-2&quot;, &quot;chunk-a35080278b59ba7a84e2e894c60ccd0c-e-3&quot;, &quot;chunk-2c4f37da3f587d0e8f8c088fdda0d333-e-1&quot;, &quot;chunk-bc10585f3ad1de63f724705efe275831-e-2&quot;, &quot;chunk-1a10b9ced7aeca4719469cc8e85d9ba9-e-8&quot;, &quot;chunk-0e56d036a3d2e550af5ea66665ba607a-e-1&quot;, &quot;chunk-5354da7deedb75e784b4ab18d7e8dbe0-e-6&quot;, &quot;chunk-ece73a04275b10b6ad2874686306213a-e-5&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="15" />
        </attvalues>
      </node>
      <node id="chunk-aae63be5befb53cbb763740fd894bee5-e-3" label="Pettit theory">
        <attvalues>
          <attvalue for="0" value="Pettit theory" />
          <attvalue for="1" value="Theory" />
          <attvalue for="2" value="一种关于高温选择性氧化的理论。该理论认为，所有潜在氧化物组分的晶核在高温下都会形成，但其中热力学稳定性最高的氧化物（如Al₂O₃和Cr₂O₃）会优先生长，最终形成占主导地位的连续保护性氧化层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-aae63be5befb53cbb763740fd894bee5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-aae63be5befb53cbb763740fd894bee5-e-4" label="Cr2O3">
        <attvalues>
          <attvalue for="0" value="Cr2O3" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="三氧化二铬（Cr2O3）是一种具有高热力学稳定性的材料。根据佩蒂特理论，这种优越的稳定性是其在特定条件下能够成为主导相或主要腐蚀产物的原因。" />
          <attvalue for="3" value="{&quot;thermodynamic_stability&quot;: &quot;greater&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-aae63be5befb53cbb763740fd894bee5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-aae63be5befb53cbb763740fd894bee5-e-5" label="oxide constituents">
        <attvalues>
          <attvalue for="0" value="oxide constituents" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="一类以其形成机制为根本特征的氧化物材料。根据佩蒂特理论（Pettit theory），这类材料的晶核在特定温度下生成。三氧化二铝（Al2O3）是该类别下的一个典型实例。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-aae63be5befb53cbb763740fd894bee5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-db8701f768a162b189950d821beb70d9-e-2" label="Group III morphologies">
        <attvalues>
          <attvalue for="0" value="Group III morphologies" />
          <attvalue for="1" value="Material Structure" />
          <attvalue for="2" value="Group III morphologies是一种材料结构，可在三元体系等特定合金中形成。其特征在于，所伴生的氧化物相比于氧化镍(NiO)，具有更高的热力学稳定性和更慢的生长动力学。" />
          <attvalue for="3" value="{&quot;thermodynamic_stability&quot;: &quot;greater&quot;, &quot;growth_kinetics&quot;: &quot;much slower than for NiO&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-db8701f768a162b189950d821beb70d9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-db8701f768a162b189950d821beb70d9-e-3" label="Ternary system">
        <attvalues>
          <attvalue for="0" value="Ternary system" />
          <attvalue for="1" value="Alloy System" />
          <attvalue for="2" value="一种由三种组元构成的合金体系。其核心特点是，与镍铝二元体系不同，该体系在铝浓度较低时也能形成III族形貌。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-db8701f768a162b189950d821beb70d9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-db8701f768a162b189950d821beb70d9-e-4" label="Ni–Al binary system">
        <attvalues>
          <attvalue for="0" value="Ni–Al binary system" />
          <attvalue for="1" value="Alloy System" />
          <attvalue for="2" value="镍铝二元体系（Ni-Al binary system）是一种由镍（Ni）和铝（Al）两种元素构成的合金系统。在该体系中，铝的相对浓度是决定合金相结构与微观形貌的关键因素。与更复杂的三元体系相比，它在形成某些特定微观结构时对铝的浓度有着不同的要求，常被用作比较研究的基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-db8701f768a162b189950d821beb70d9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-948eb47dbdfa551b6fd68c0a7d42b94a-e-1" label="Ni–Al binary system">
        <attvalues>
          <attvalue for="0" value="Ni–Al binary system" />
          <attvalue for="1" value="Alloy System" />
          <attvalue for="2" value="一种由镍（Ni）和铝（Al）组成的二元合金体系。其特点是能形成NiAl、Ni₃Al等具有优异高温性能的金属间化合物，这些化合物是镍基高温超合金的核心基础和重要强化相，广泛应用于航空航天等领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-948eb47dbdfa551b6fd68c0a7d42b94a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-948eb47dbdfa551b6fd68c0a7d42b94a-e-4" label="gettering effect">
        <attvalues>
          <attvalue for="0" value="gettering effect" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="第三元素效应（third-element effect）是“吸杂效应”（gettering effect）的别称。它是一种物理化学现象，指在体系（如合金熔体）中，通过添加第三种组元来改变某一特定元素（如铝）的化学活度，进而影响其除杂能力的现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-948eb47dbdfa551b6fd68c0a7d42b94a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Gettering effect&quot;, &quot;third-element effect&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-948eb47dbdfa551b6fd68c0a7d42b94a-e-4&quot;, &quot;chunk-948eb47dbdfa551b6fd68c0a7d42b94a-e-5&quot;, &quot;chunk-e039cb317db23e5137b0d2d1164a7ea9-e-7&quot;, &quot;chunk-db7cc890c68f0a43d000b2dba6ecf910-e-5&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-948eb47dbdfa551b6fd68c0a7d42b94a-e-6" label="Al2O3">
        <attvalues>
          <attvalue for="0" value="Al2O3" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="氧化铝（Al₂O₃）是一种无机化合物，化学式为Al₂O₃。它是一种高硬度的两性氧化物，熔点高、化学性质稳定。其晶体形态“刚玉”的硬度仅次于金刚石，因含不同杂质而形成红宝石、蓝宝石等。工业上广泛用作冶炼铝的原料、耐火材料和研磨剂。" />
          <attvalue for="3" value="{&quot;name&quot;: &quot;Aluminium Oxide&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-948eb47dbdfa551b6fd68c0a7d42b94a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="316" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-948eb47dbdfa551b6fd68c0a7d42b94a-e-7" label="binary Ni–Al alloy">
        <attvalues>
          <attvalue for="0" value="binary Ni–Al alloy" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="一种镍铝二元合金，特指铝含量为20 wt%的特定成分。该成分可确保合金在氧化时，能专门形成一层纯净的氧化铝（Al₂O₃）保护层，从而避免生成镍的氧化物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-948eb47dbdfa551b6fd68c0a7d42b94a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a35080278b59ba7a84e2e894c60ccd0c-e-1" label="20 wt%Al">
        <attvalues>
          <attvalue for="0" value="20 wt%Al" />
          <attvalue for="1" value="Material Composition" />
          <attvalue for="2" value="20 wt%Al是指在镍铝二元合金中，为确保其在高温氧化时能专门（或排他性地）形成一层致密的、具有保护性的三氧化二铝（Al₂O₃）氧化膜，所必需的铝元素的临界重量百分比含量。" />
          <attvalue for="3" value="{&quot;element&quot;: &quot;Aluminum&quot;, &quot;concentration&quot;: &quot;20 wt%&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-a35080278b59ba7a84e2e894c60ccd0c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a35080278b59ba7a84e2e894c60ccd0c-e-2" label="Ni–Al alloy">
        <attvalues>
          <attvalue for="0" value="Ni–Al alloy" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="一种镍铝二元合金，特指铝含量为20%（重量百分比）的特定成分。该成分的特点是在氧化时能专门形成一层纯净、致密的氧化铝（Al₂O₃）保护层，以提高其抗氧化性能。" />
          <attvalue for="3" value="{&quot;components&quot;: [&quot;Nickel&quot;, &quot;Aluminum&quot;]}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a35080278b59ba7a84e2e894c60ccd0c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a35080278b59ba7a84e2e894c60ccd0c-e-4" label="5 wt%Al">
        <attvalues>
          <attvalue for="0" value="5 wt%Al" />
          <attvalue for="1" value="Material Composition" />
          <attvalue for="2" value="一种材料成分，指在合金中添加5 wt%铬（Cr）后，形成氧化铝（Al2O3）保护层所需的、已被降低的铝（Al）的临界重量百分比。" />
          <attvalue for="3" value="{&quot;element&quot;: &quot;Aluminum&quot;, &quot;concentration&quot;: &quot;5 wt%&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a35080278b59ba7a84e2e894c60ccd0c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a35080278b59ba7a84e2e894c60ccd0c-e-4&quot;]}]" />
          <attvalue for="9" value="202" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a35080278b59ba7a84e2e894c60ccd0c-e-5" label="5 wt%Cr">
        <attvalues>
          <attvalue for="0" value="5 wt%Cr" />
          <attvalue for="1" value="Material Composition" />
          <attvalue for="2" value="一种材料成分，指在镍铝(Ni-Al)合金中添加了5%重量比的铬(Cr)。该添加可将形成保护性氧化铝(Al2O3)层所需的铝含量从更高水平降低至5 wt%。" />
          <attvalue for="3" value="{&quot;element&quot;: &quot;Chromium&quot;, &quot;concentration&quot;: &quot;5 wt%&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a35080278b59ba7a84e2e894c60ccd0c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a35080278b59ba7a84e2e894c60ccd0c-e-5&quot;]}]" />
          <attvalue for="9" value="202" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a35080278b59ba7a84e2e894c60ccd0c-e-6" label="NiCrAlY-type coatings">
        <attvalues>
          <attvalue for="0" value="NiCrAlY-type coatings" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="NiCrAlY系涂层是一种以镍、铬、铝为基体，并添加活性元素钇(Y)的高温防护涂层。它在高温下可形成一层致密、稳定的氧化铝(Al2O3)保护膜，而钇能显著提高该氧化膜的附着力与稳定性。" />
          <attvalue for="3" value="{&quot;components&quot;: [&quot;Nickel&quot;, &quot;Chromium&quot;, &quot;Aluminum&quot;, &quot;Yttrium&quot;]}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a35080278b59ba7a84e2e894c60ccd0c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a35080278b59ba7a84e2e894c60ccd0c-e-8" label="reactive element effect">
        <attvalues>
          <attvalue for="0" value="reactive element effect" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="活性元素效应（reactive-element effect），又称稀土效应（rare-earth effect），是材料科学中的一种现象。它指在耐高温合金中添加微量活性元素（如钇、铈等），能显著提高其表面保护性氧化膜与基体的结合力，从而大幅提升材料的高温抗氧化和抗剥落性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-a35080278b59ba7a84e2e894c60ccd0c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Reactive (rare) element effect&quot;, &quot;Reactive element effect&quot;, &quot;rare-earth effect&quot;, &quot;reactive-element effect&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a35080278b59ba7a84e2e894c60ccd0c-e-8&quot;, &quot;chunk-1b1d17125a9be9ae98260d7ef4e48178-e-1&quot;, &quot;chunk-5f8bf38171a410fd46c9accc216760df-e-6&quot;, &quot;chunk-5f8bf38171a410fd46c9accc216760df-e-7&quot;, &quot;chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-9&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-1b1d17125a9be9ae98260d7ef4e48178-e-2" label="Al₂O₃ scale">
        <attvalues>
          <attvalue for="0" value="Al₂O₃ scale" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="氧化铝皮（Alumina scale）是一种形成于材料表面的、主要成分为氧化铝（Al₂O₃）的物质层。在特定物理过程中，它的生长虽然不是导致表面褶皱（rumpling）的必要条件，但可能会对褶皱的形成起到促进作用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-1b1d17125a9be9ae98260d7ef4e48178" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Al2O3 scale&quot;, &quot;Al2O3 scales&quot;, &quot;Alumina scale&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bb636c80a00702ec9bbe14461e908287-e-6&quot;, &quot;chunk-1b1d17125a9be9ae98260d7ef4e48178-e-2&quot;, &quot;chunk-0ae4835eab33f3ed749188c7a5dff87b-e-5&quot;, &quot;chunk-1abe15e2f2db1602f97ac75bb847ef30-e-7&quot;, &quot;chunk-ba3c7d1b88adc32b3ab9a1e047094bdc-e-6&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-1b1d17125a9be9ae98260d7ef4e48178-e-4" label="Lanthanum (La)">
        <attvalues>
          <attvalue for="0" value="Lanthanum (La)" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="镧（La）是一种化学元素，原子序数57，为银白色软金属。它是一种典型的活性元素（RE），常作为合金添加剂，用以显著提高材料表面氧化铝（Al2O3）保护层的附着力，从而增强其高温抗氧化性能。" />
          <attvalue for="3" value="{&quot;typical amount&quot;: &quot;less than 1 wt%&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1b1d17125a9be9ae98260d7ef4e48178" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;La&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1b1d17125a9be9ae98260d7ef4e48178-e-4&quot;, &quot;chunk-7638042a561888cfdce1fb2ee9ad0428-e-7&quot;, &quot;chunk-bc88baa62dfcfaa0545bb367cad979a7-e-8&quot;, &quot;chunk-dbe450c14d87c9df145aceea4a48b35c-e-2&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-1b1d17125a9be9ae98260d7ef4e48178-e-7" label="Group 3 elements">
        <attvalues>
          <attvalue for="0" value="Group 3 elements" />
          <attvalue for="1" value="Element Group" />
          <attvalue for="2" value="指元素周期表第3族的化学元素，包含钪(Sc)、钇(Y)等过渡金属。它们是化学性质活泼的金属，在材料科学中被归为一类活性元素添加剂（RE additions），用于改善材料的性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-1b1d17125a9be9ae98260d7ef4e48178" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1b1d17125a9be9ae98260d7ef4e48178-e-8" label="Group 4 elements">
        <attvalues>
          <attvalue for="0" value="Group 4 elements" />
          <attvalue for="1" value="Element Group" />
          <attvalue for="2" value="第4族元素是元素周期表中的一列，包含钛(Ti)、锆(Zr)、铪(Hf)等过渡金属。因其化学活性，它们可作为活性元素添加剂（RE additions）用于改善材料（如高温合金）的性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-1b1d17125a9be9ae98260d7ef4e48178" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1b1d17125a9be9ae98260d7ef4e48178-e-9" label="Lanthanide series">
        <attvalues>
          <attvalue for="0" value="Lanthanide series" />
          <attvalue for="1" value="Element Group" />
          <attvalue for="2" value="镧系元素（Lanthanide series）是元素周期表中原子序数从57到71的15种金属元素的统称，均属于稀土元素。它们是典型的活性元素（RE），在材料科学中常被用作添加剂，以产生“活性元素效应”，显著提升材料的高温抗氧化性等性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-1b1d17125a9be9ae98260d7ef4e48178" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1b1d17125a9be9ae98260d7ef4e48178-e-10" label="Actinide series">
        <attvalues>
          <attvalue for="0" value="Actinide series" />
          <attvalue for="1" value="Element Group" />
          <attvalue for="2" value="锕系元素是元素周期表中原子序数从89号的锕到103号的铹共15种化学元素的统称。它们均为位于f区的放射性金属元素，化学性质相似，电子构型中逐一填充5f轨道。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-1b1d17125a9be9ae98260d7ef4e48178" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1b1d17125a9be9ae98260d7ef4e48178-e-11" label="Reactive-element (RE) additions">
        <attvalues>
          <attvalue for="0" value="Reactive-element (RE) additions" />
          <attvalue for="1" value="Material Additive" />
          <attvalue for="2" value="作为一种材料添加剂，指少量添加的钇(Y)、镧(La)、锆(Zr)等化学活性元素。它们能显著提高高温合金表面氧化皮(如Al₂O₃)的附着力，这种积极作用被称为“活性元素效应”。这类元素通常属于第3、4族及镧系、锕系元素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-1b1d17125a9be9ae98260d7ef4e48178" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1b1d17125a9be9ae98260d7ef4e48178-e-11&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-1b1d17125a9be9ae98260d7ef4e48178-e-12" label="Overlay coatings">
        <attvalues>
          <attvalue for="0" value="Overlay coatings" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="覆层涂层是一种材料涂层，其特点是添加了活性元素（RE），其中钇（Y）是最常见的添加物。它通常直接沉积在基体材料表面，用于显著提高材料的高温抗氧化与抗腐蚀性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-1b1d17125a9be9ae98260d7ef4e48178" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f61cdab914bad0a421a3603e3cce6172-e-2" label="Weight gain">
        <attvalues>
          <attvalue for="0" value="Weight gain" />
          <attvalue for="1" value="Measurement" />
          <attvalue for="2" value="一项用于衡量材料高温抗氧化性能的关键指标，特指材料在热循环等高温环境中，因表面形成氧化层而产生的质量增加。增重值越小，通常表明材料的抗氧化性能越好。" />
          <attvalue for="3" value="{&quot;observed_in&quot;: &quot;Doped Ni-Cr-Al&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-f61cdab914bad0a421a3603e3cce6172" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f61cdab914bad0a421a3603e3cce6172-e-3" label="Thermal cycling">
        <attvalues>
          <attvalue for="0" value="Thermal cycling" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="热循环（Thermal cycling）是指材料或系统反复经受高低温交替变化的过程。该过程会诱发热应力与热疲劳，导致材料性能退化、产生微裂纹甚至失效，是评估材料在变温工况下可靠性与寿命的关键测试方法。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-f61cdab914bad0a421a3603e3cce6172" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Thermal Cycling&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f61cdab914bad0a421a3603e3cce6172-e-3&quot;, &quot;chunk-0d900d0d4731636b239cbd9f79877db4-e-3&quot;, &quot;chunk-4f1eb842a2e3520e40274bedacb6597f-e-3&quot;, &quot;chunk-23df60e783372fb64b1a5a9966ec4edc-e-4&quot;, &quot;chunk-c88b048c96dc246f3cddc3e769c47af8-e-8&quot;, &quot;chunk-25a792195888d0ec7e1a3d86f8775f12-e-5&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-f61cdab914bad0a421a3603e3cce6172-e-4" label="Doped Ni-Cr-Al">
        <attvalues>
          <attvalue for="0" value="Doped Ni-Cr-Al" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种改性镍铬铝（Ni-Cr-Al）基高温合金，常通过添加锆（Zirconium）等活性元素来提升性能。其核心特性是在高温下形成一层附着性强的保护性氧化膜，该膜的生长遵循抛物线规律，因此材料表现出优异的抗氧化性与极小的重量增加。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f61cdab914bad0a421a3603e3cce6172" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f61cdab914bad0a421a3603e3cce6172-e-5" label="Adherent Scale">
        <attvalues>
          <attvalue for="0" value="Adherent Scale" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="一种由掺铪镍铝合金（Hafnium-doped NiAl）形成的保护性氧化层。该氧化层与基体结合紧密（即黏附性好），生长速度极其缓慢，能有效阻止基体材料的进一步氧化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-f61cdab914bad0a421a3603e3cce6172" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Adherent scale&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f61cdab914bad0a421a3603e3cce6172-e-5&quot;, &quot;chunk-dceb4b755a836df5a6b40aba440100ba-e-5&quot;, &quot;chunk-bc88baa62dfcfaa0545bb367cad979a7-e-2&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-f61cdab914bad0a421a3603e3cce6172-e-6" label="Parabolic growth">
        <attvalues>
          <attvalue for="0" value="Parabolic growth" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="一种由扩散控制的生长规律，指产物层（如氧化皮）厚度的平方与时间成正比。在此过程中，随着产物层增厚，反应物扩散路径变长，从而导致生长速率随时间推移而逐渐降低。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-f61cdab914bad0a421a3603e3cce6172" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f61cdab914bad0a421a3603e3cce6172-e-7" label="Undoped material">
        <attvalues>
          <attvalue for="0" value="Undoped material" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="未掺杂材料（Undoped material）指未被人为引入特定杂质（掺杂剂）以调控其电学、光学等性能的纯净材料。它展现的是材料的本征特性，常作为研究掺杂效应的基准或对照物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-f61cdab914bad0a421a3603e3cce6172" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f61cdab914bad0a421a3603e3cce6172-e-8" label="Mass loss">
        <attvalues>
          <attvalue for="0" value="Mass loss" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="质量损失 (Mass loss) 是在未掺杂材料中观察到的一种显著质量减少现象。此现象的出现与材料发生剥落（spalling）后的再氧化过程相符。" />
          <attvalue for="3" value="{&quot;rate&quot;: &quot;approximately linear with time&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-f61cdab914bad0a421a3603e3cce6172" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f61cdab914bad0a421a3603e3cce6172-e-9" label="Re-oxidation">
        <attvalues>
          <attvalue for="0" value="Re-oxidation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="再氧化（Re-oxidation）是一种在未掺杂材料中，于剥落（spalling）现象发生后高速进行的化学过程。该过程是导致材料进一步质量损失（mass loss）的主要原因之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-f61cdab914bad0a421a3603e3cce6172" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-20a5e5852746b95b7f73b789f682a395-e-1" label="Reactive-element dopant">
        <attvalues>
          <attvalue for="0" value="Reactive-element dopant" />
          <attvalue for="1" value="Material Additive" />
          <attvalue for="2" value="**活性元素掺杂剂 (Reactive-element dopant)**&#10;&#10;一种材料添加剂，其核心作用是优化材料表面氧化皮的附着力。它通过减少生长应力与氧化皮屈曲效应，并降低氧化物（如Al₂O₃）的生长速率，从而显著提升材料的高温抗氧化性能。" />
          <attvalue for="3" value="{&quot;low_concentration&quot;: &quot;less than 100 ppm&quot;, &quot;optimal_concentration&quot;: &quot;around 0.1 wt%&quot;, &quot;high_concentration&quot;: &quot;greater than about 0.5&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-20a5e5852746b95b7f73b789f682a395" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-20a5e5852746b95b7f73b789f682a395-e-1&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-20a5e5852746b95b7f73b789f682a395-e-2" label="Scale adhesion">
        <attvalues>
          <attvalue for="0" value="Scale adhesion" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="氧化皮附着性（Scale Adherence）是一种材料性能，指合金在高温下形成的保护性氧化皮与其基体结合的牢固程度。该性能受合金成分影响，降低硫（Sulphur）含量能显著改善其附着力，而钇硫比（Y/S Ratio）是决定附着效果的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-20a5e5852746b95b7f73b789f682a395" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Scale Adherence&quot;, &quot;scale adhesion&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-20a5e5852746b95b7f73b789f682a395-e-2&quot;, &quot;chunk-ec7c4b2174ee3c0c5d15649dfb3d1582-e-3&quot;, &quot;chunk-5268439e43d92c2ee6fb5551a0ab1a7d-e-3&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-20a5e5852746b95b7f73b789f682a395-e-3" label="Growth stresses">
        <attvalues>
          <attvalue for="0" value="Growth stresses" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="生长应力 (Growth stresses) 是一种在材料（如薄膜、涂层）生长过程中产生的内应力。作为一种力学现象，其显著特征是可以通过掺杂低浓度的活性元素来有效降低。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-20a5e5852746b95b7f73b789f682a395" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Growth Stresses&quot;, &quot;Transformation ‘growth' stresses&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e66fbe12748379e18cc5f75f5238013e-e-5&quot;, &quot;chunk-20a5e5852746b95b7f73b789f682a395-e-3&quot;, &quot;chunk-c88b048c96dc246f3cddc3e769c47af8-e-4&quot;, &quot;chunk-93d10ba2903ae8b18e5582634fca4a8c-e-4&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-20a5e5852746b95b7f73b789f682a395-e-4" label="Scale-buckling effects">
        <attvalues>
          <attvalue for="0" value="Scale-buckling effects" />
          <attvalue for="1" value="Mechanical Phenomenon" />
          <attvalue for="2" value="一种力学现象，指材料表面的氧化皮因其比体积大于基体而产生巨大压应力，进而导致的褶皱、弯曲或剥落。这种效应可通过在材料中添加低浓度的活性元素掺杂剂来抑制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-20a5e5852746b95b7f73b789f682a395" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-20a5e5852746b95b7f73b789f682a395-e-5" label="Higher specific volume of the scale">
        <attvalues>
          <attvalue for="0" value="Higher specific volume of the scale" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="指材料表面氧化皮的比容（单位质量的体积）大于其所消耗的基体金属，导致氧化皮总体积膨胀。这种体积不匹配会在氧化皮层内产生压缩应力，是引起其发生屈曲、鼓包或剥落等现象的根本物理属性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-20a5e5852746b95b7f73b789f682a395" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-20a5e5852746b95b7f73b789f682a395-e-6" label="Al2O3 growth rates">
        <attvalues>
          <attvalue for="0" value="Al2O3 growth rates" />
          <attvalue for="1" value="Process Rate" />
          <attvalue for="2" value="指氧化铝（Al2O3）氧化膜在材料表面形成的速率。该速率是衡量材料高温抗氧化性能的关键指标，它会受到活性元素掺杂的影响。通过优化掺杂剂的含量，可以将此生长速率降至最低，从而显著提升材料的防护能力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-20a5e5852746b95b7f73b789f682a395" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2c4f37da3f587d0e8f8c088fdda0d333-e-2" label="RE dopants">
        <attvalues>
          <attvalue for="0" value="RE dopants" />
          <attvalue for="1" value="Material Additive" />
          <attvalue for="2" value="RE dopants（稀土掺杂剂）是一种物质添加剂，能够提高Al2O3的生长速率。当其溶解度超过极限时，该掺杂剂会形成自身的氧化物。" />
          <attvalue for="3" value="{&quot;concentration_threshold&quot;: &quot;&gt; 0.5 wt%&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-2c4f37da3f587d0e8f8c088fdda0d333" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2c4f37da3f587d0e8f8c088fdda0d333-e-2&quot;, &quot;chunk-bc88baa62dfcfaa0545bb367cad979a7-e-5&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-2c4f37da3f587d0e8f8c088fdda0d333-e-3" label="Oxides of the RE dopants">
        <attvalues>
          <attvalue for="0" value="Oxides of the RE dopants" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="稀土掺杂剂氧化物是一类由稀土掺杂元素氧化形成的化合物，例如是Ni5Y和Ni2AlZr等合金氧化后的产物。当稀土掺杂剂的含量超过约0.5 wt%时，此类氧化物会大量生成，其主要作用是提高三氧化二铝（Al2O3）的生长速率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-2c4f37da3f587d0e8f8c088fdda0d333" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2c4f37da3f587d0e8f8c088fdda0d333-e-3&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-2c4f37da3f587d0e8f8c088fdda0d333-e-4" label="Ni5Y">
        <attvalues>
          <attvalue for="0" value="Ni5Y" />
          <attvalue for="1" value="Precipitate" />
          <attvalue for="2" value="Ni5Y是一种由镍(Ni)和钇(Y)组成的金属间化合物，通常作为一种析出相存在于合金中。在特定条件下，该相会发生氧化，其组分中的钇元素会转变为稀土掺杂氧化物（如氧化钇），从而影响材料性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-2c4f37da3f587d0e8f8c088fdda0d333" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-2c4f37da3f587d0e8f8c088fdda0d333-e-5" label="Ni2AlZr">
        <attvalues>
          <attvalue for="0" value="Ni2AlZr" />
          <attvalue for="1" value="Precipitate" />
          <attvalue for="2" value="Ni2AlZr是一种由镍(Ni)、铝(Al)和锆(Zr)组成的金属间化合物析出相。在特定条件下，其氧化过程是形成稀土(RE)掺杂剂氧化物的前驱反应。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2c4f37da3f587d0e8f8c088fdda0d333" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5f8bf38171a410fd46c9accc216760df-e-1" label="air plasma spraying">
        <attvalues>
          <attvalue for="0" value="air plasma spraying" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="大气等离子喷涂是一种利用等离子炬的热喷涂技术。该工艺在大气环境下进行，将材料加热至熔融或半熔融态并高速喷向基材形成涂层。由于喷涂过程中材料会与空气接触而氧化，因此与在受控气氛中进行的真空等离子喷涂形成对比，常用于喷涂不易氧化或氧化物性能优良的材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-5f8bf38171a410fd46c9accc216760df" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5f8bf38171a410fd46c9accc216760df-e-1&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-5f8bf38171a410fd46c9accc216760df-e-2" label="coating material">
        <attvalues>
          <attvalue for="0" value="coating material" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种专用于空气等离子喷涂工艺的涂层材料。其成分中含有约1 wt%（重量百分比）的钇，该元素是确保材料在该工艺下获得最佳性能和涂层效果的关键添加剂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-5f8bf38171a410fd46c9accc216760df" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5f8bf38171a410fd46c9accc216760df-e-4" label="plasma torch">
        <attvalues>
          <attvalue for="0" value="plasma torch" />
          <attvalue for="1" value="Equipment Component" />
          <attvalue for="2" value="等离子喷枪（plasma torch）是一种产生高温等离子射流的装置。作为大气等离子喷涂等系统的核心设备组件，它用于熔化并高速喷射粉末材料以制备涂层。其高温反应环境可导致工作材料（如钇）发生氧化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-5f8bf38171a410fd46c9accc216760df" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-5f8bf38171a410fd46c9accc216760df-e-5" label="vacuum plasma spraying">
        <attvalues>
          <attvalue for="0" value="vacuum plasma spraying" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="真空等离子喷涂（VPS）是一种在低压或真空室中进行的等离子喷涂技术。该工艺通过隔绝空气来防止喷涂材料（尤其是活性金属）在高温下氧化，可获得比大气等离子喷涂更纯净、致密的涂层，适用于制备高性能防护涂层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-5f8bf38171a410fd46c9accc216760df" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c67f7511c5e1ddf25141e607b1f96ad7-e-1" label="Protective pegs">
        <attvalues>
          <attvalue for="0" value="Protective pegs" />
          <attvalue for="1" value="Mechanism" />
          <attvalue for="2" value="保护性销钉是一种旨在提高氧化皮或涂层与基体附着力的机制。它通过在基体表面形成微小的销钉状突起，将氧化皮/涂层物理锚定，产生机械锁定效应，从而有效防止其在使用过程中因应力等因素而开裂或剥落。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-c67f7511c5e1ddf25141e607b1f96ad7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="112" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c67f7511c5e1ddf25141e607b1f96ad7-e-2" label="Scale">
        <attvalues>
          <attvalue for="0" value="Scale" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="一种材料层，其通过保护性销钉（pegs）的钉扎效应，以机械方式锚定在基底金属合金上，从而确保该层与基体之间形成牢固的附着力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c67f7511c5e1ddf25141e607b1f96ad7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="112" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c67f7511c5e1ddf25141e607b1f96ad7-e-3" label="Substrate metal alloy">
        <attvalues>
          <attvalue for="0" value="Substrate metal alloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种用作基底的金属合金，在其表面可形成、沉积或附着另一层材料（如氧化皮、涂层）。它为附着层提供物理支撑和结合界面，是整个复合结构或系统的基础部分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c67f7511c5e1ddf25141e607b1f96ad7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="112" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c67f7511c5e1ddf25141e607b1f96ad7-e-4" label="Vacancy coalescence">
        <attvalues>
          <attvalue for="0" value="Vacancy coalescence" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="空位合并是一种物理过程，指晶体材料中的多个原子空位（点缺陷）迁移并聚集，形成更大尺寸的空洞或孔隙。该过程常发生在金属/氧化皮等界面处，是导致界面分离和材料失效的重要机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c67f7511c5e1ddf25141e607b1f96ad7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Vacancy Coalescence&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c67f7511c5e1ddf25141e607b1f96ad7-e-4&quot;, &quot;chunk-112008d7c3699f7544a4f75421759b99-e-1&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c67f7511c5e1ddf25141e607b1f96ad7-e-5" label="Metal/scale interface">
        <attvalues>
          <attvalue for="0" value="Metal/scale interface" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="氧化皮/金属界面是指在金属基体与其表面氧化皮（Scale）之间的边界区域。该界面通常是钇（Yttrium）等合金元素富集的位置，但也可能因发生硫化反应，导致钇浓度降低或被消耗。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c67f7511c5e1ddf25141e607b1f96ad7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Metal/Scale Interface&quot;, &quot;Metal/scale interfaces&quot;, &quot;Scale/metal interface&quot;, &quot;scale-metal interface&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c67f7511c5e1ddf25141e607b1f96ad7-e-5&quot;, &quot;chunk-112008d7c3699f7544a4f75421759b99-e-2&quot;, &quot;chunk-84d1269d81f3d4fb66cfdbb567801e32-e-8&quot;, &quot;chunk-a32309070a2ae9bb93878cff40ade2c7-e-6&quot;, &quot;chunk-5268439e43d92c2ee6fb5551a0ab1a7d-e-4&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-c67f7511c5e1ddf25141e607b1f96ad7-e-6" label="Alternative sites">
        <attvalues>
          <attvalue for="0" value="Alternative sites" />
          <attvalue for="1" value="Mechanism" />
          <attvalue for="2" value="在金属/氧化层界面上提供的一种特殊位点。其作为空位的替代湮灭点，通过捕获空位来阻止其聚集成宏观孔洞，从而有效抑制界面分离，改善氧化层的附着性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c67f7511c5e1ddf25141e607b1f96ad7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-112008d7c3699f7544a4f75421759b99-e-3" label="Alternative Sites for Coalescence">
        <attvalues>
          <attvalue for="0" value="Alternative Sites for Coalescence" />
          <attvalue for="1" value="Mechanism" />
          <attvalue for="2" value="一种材料学机制，指通过提供晶界、杂质原子等可充当“陷阱”的替代位置，来捕获并固定原子空位，从而有效抑制多个空位聚并形成更大尺寸缺陷（如孔洞）的过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-112008d7c3699f7544a4f75421759b99" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-112008d7c3699f7544a4f75421759b99-e-4" label="Scale Plasticity">
        <attvalues>
          <attvalue for="0" value="Scale Plasticity" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**尺度塑性 (Scale Plasticity)**&#10;&#10;一种材料属性，指材料的塑性行为（如屈服强度和硬度）依赖于其特征长度尺度的现象。该属性主要在微米和纳米尺度上表现显著，通常体现为随着样品物理尺寸的减小，材料强度反而增强的尺寸效应，即“越小越强”。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-112008d7c3699f7544a4f75421759b99" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="317" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-112008d7c3699f7544a4f75421759b99-e-5" label="Cohesive Energy between Metal and Scale">
        <attvalues>
          <attvalue for="0" value="Cohesive Energy between Metal and Scale" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="金属与氧化皮间的结合能 (Cohesive Energy between Metal and Scale) 是一种界面材料属性，指将单位面积的氧化皮层从金属基体上完全分离所需要做的功。该物理量用于衡量金属与氧化皮界面结合的牢固程度，数值越高，代表界面结合越强，氧化皮越不易剥落。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-112008d7c3699f7544a4f75421759b99" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-112008d7c3699f7544a4f75421759b99-e-6" label="Mechanisms">
        <attvalues>
          <attvalue for="0" value="Mechanisms" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="指一组观念的集合。其内部各组成部分的重要性、合理性以及彼此间的相互作用充满争议，尚未形成明确共识。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-112008d7c3699f7544a4f75421759b99" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="318" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-bc10585f3ad1de63f724705efe275831-e-1" label="Sulfur">
        <attvalues>
          <attvalue for="0" value="Sulfur" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="硫（S）是一种原子序数为16的非金属化学元素。它对生命至关重要，但在冶金等工业领域中，常作为一种有害的杂质（“残余元素”）存在，会降低材料性能。锆（Zirconium）等物质可作为其吸除剂（Getter）来消除其不良影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-bc10585f3ad1de63f724705efe275831" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Sulphur&quot;, &quot;sulphur&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-434598412a5630b73fc77c4f56954329-e-9&quot;, &quot;chunk-6007146f18f54e1531784eefc3822dae-e-6&quot;, &quot;chunk-c000c9e441af2d51c033dcc75d8753cc-e-3&quot;, &quot;chunk-bc10585f3ad1de63f724705efe275831-e-1&quot;, &quot;chunk-84d1269d81f3d4fb66cfdbb567801e32-e-3&quot;, &quot;chunk-a32309070a2ae9bb93878cff40ade2c7-e-2&quot;, &quot;chunk-ec7c4b2174ee3c0c5d15649dfb3d1582-e-2&quot;, &quot;chunk-728b3dfb00a054eed0104e938dfae641-e-7&quot;, &quot;chunk-c577786ed818c3adfe9e2cc146b9c0be-e-5&quot;, &quot;chunk-62f2a69b28a3f59402f17b59e67f8707-e-6&quot;, &quot;chunk-1abe15e2f2db1602f97ac75bb847ef30-e-13&quot;, &quot;chunk-cd90df188efe63a1aba2d62ab225c3ae-e-4&quot;, &quot;chunk-e039cb317db23e5137b0d2d1164a7ea9-e-16&quot;, &quot;chunk-0625d83d7200f989528119d9ba61865a-e-13&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="14" />
        </attvalues>
      </node>
      <node id="chunk-bc10585f3ad1de63f724705efe275831-e-3" label="Nickel">
        <attvalues>
          <attvalue for="0" value="Nickel" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="镍是一种化学元素，符号Ni，原子序数28。它是一种坚硬、有磁性的银白色过渡金属，在高温下易被硫等杂质脆化。γ-Ni（伽马镍）是其重要的面心立方结构晶相，常见于高温合金中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-bc10585f3ad1de63f724705efe275831" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-bc10585f3ad1de63f724705efe275831-e-4" label="Nickel alloys">
        <attvalues>
          <attvalue for="0" value="Nickel alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="以镍为主要成分并添加其他元素组成的合金。通常具有优异的高温强度和耐腐蚀性，但在含硫环境下易被硫元素脆化，导致材料性能下降。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-bc10585f3ad1de63f724705efe275831" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bc10585f3ad1de63f724705efe275831-e-6" label="y–Ni">
        <attvalues>
          <attvalue for="0" value="y–Ni" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="γ-Ni（伽马镍）是元素镍的一种物相。其关键特征是，作为溶剂，硫（Sulphur）在其中的溶解度会随温度变化而显著改变，具有强烈的温度依赖性。" />
          <attvalue for="3" value="{&quot;sulphur_solubility&quot;: &quot;decreasing from about 500 ppm by atom at 1200 K&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-bc10585f3ad1de63f724705efe275831" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-84d1269d81f3d4fb66cfdbb567801e32-e-1" label="Sulphur solubility in y–Ni">
        <attvalues>
          <attvalue for="0" value="Sulphur solubility in y–Ni" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="硫在γ-Ni相中的溶解度，指硫元素能固溶于γ-Ni（奥氏体镍）相中的最大极限浓度。该性质对温度有强烈的依赖性，通常随温度升高而增加。此外，合金元素也会影响其数值，例如铬（Cr）和铪（Hf）的存在会显著降低硫的溶解度。" />
          <attvalue for="3" value="{&quot;at_1200K&quot;: &quot;about 500 ppm by atom&quot;, &quot;at_700K&quot;: &quot;less than 10 ppm&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-84d1269d81f3d4fb66cfdbb567801e32" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-84d1269d81f3d4fb66cfdbb567801e32-e-6" label="Grain-boundary segregation">
        <attvalues>
          <attvalue for="0" value="Grain-boundary segregation" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="晶界偏析是一种材料科学现象，指多晶材料中的溶质或杂质原子（如硫）优先聚集、富集在晶界区域。这种偏析会显著改变材料的性能，常导致晶间脆化。添加某些合金元素（如铬、铪）可以有效抑制该现象，从而改善材料的性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-84d1269d81f3d4fb66cfdbb567801e32" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-84d1269d81f3d4fb66cfdbb567801e32-e-7" label="Auger spectroscopy">
        <attvalues>
          <attvalue for="0" value="Auger spectroscopy" />
          <attvalue for="1" value="Analytical Technique" />
          <attvalue for="2" value="俄歇电子能谱是一种高表面灵敏度的分析技术。它利用电子束轰击样品，通过分析其表面发射出的俄歇电子的能量与强度，来确定材料最表层几个原子层内的元素组成、含量及化学态。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-84d1269d81f3d4fb66cfdbb567801e32" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a32309070a2ae9bb93878cff40ade2c7-e-3" label="Refractory sulphides">
        <attvalues>
          <attvalue for="0" value="Refractory sulphides" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="一类由钇(Y)和硫(S)组成的难熔化合物。因其化学性质稳定且耐高温，会降低体系中钇的有效性。该类别包括硫化亚钇(YS)和三硫化二钇(Y2S3)等具体物质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a32309070a2ae9bb93878cff40ade2c7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Y2S3&quot;, &quot;YS&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a32309070a2ae9bb93878cff40ade2c7-e-3&quot;, &quot;chunk-a32309070a2ae9bb93878cff40ade2c7-e-4&quot;, &quot;chunk-a32309070a2ae9bb93878cff40ade2c7-e-5&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a32309070a2ae9bb93878cff40ade2c7-e-8" label="5%H2/Ar flowing gas mixture">
        <attvalues>
          <attvalue for="0" value="5%H2/Ar flowing gas mixture" />
          <attvalue for="1" value="Gas Mixture" />
          <attvalue for="2" value="一种经吸气剂提纯的气体混合物，由5%的氢气（H2）和95%的氩气（Ar）组成。它在流动状态下被用作保护气氛，专用于对PWA1480单晶高温合金进行氢退火处理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-a32309070a2ae9bb93878cff40ade2c7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ec7c4b2174ee3c0c5d15649dfb3d1582-e-1" label="Hydrogen Annealing">
        <attvalues>
          <attvalue for="0" value="Hydrogen Annealing" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="氢退火是一种热处理工艺，在含5%氢气的氢氩混合保护气氛中进行，通过化学反应，旨在有效降低目标合金中的硫含量，以改善其材料性能。" />
          <attvalue for="3" value="{&quot;gas_mixture&quot;: &quot;gettered 5%H2/Ar&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-ec7c4b2174ee3c0c5d15649dfb3d1582" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ec7c4b2174ee3c0c5d15649dfb3d1582-e-5" label="Y/S Ratio">
        <attvalues>
          <attvalue for="0" value="Y/S Ratio" />
          <attvalue for="1" value="Material Parameter" />
          <attvalue for="2" value="**Y/S Ratio**&#10;&#10;指材料中元素钇(Y)与硫(S)的含量比值，是一个关键的材料参数。该比值的临界点决定了材料表面氧化皮的附着性能，因此也为通过钢水脱硫等方式来改善材料性能提供了理论依据。" />
          <attvalue for="3" value="{&quot;atomic_ratio&quot;: &quot;~1:1&quot;, &quot;weight_ratio&quot;: &quot;3:1&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ec7c4b2174ee3c0c5d15649dfb3d1582" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-ec7c4b2174ee3c0c5d15649dfb3d1582-e-6" label="Melt Desulphurisation">
        <attvalues>
          <attvalue for="0" value="Melt Desulphurisation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种应用于高温合金熔炼的冶金工艺。该工艺旨在从金属熔体中去除有害的硫元素，以消除其对材料附着力的负面影响。钇硫比（Y/S Ratio）是证明该工艺合理性并指导其实施的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-ec7c4b2174ee3c0c5d15649dfb3d1582" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;desulphurisation&quot;, &quot;melt desulphurisation methods&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ec7c4b2174ee3c0c5d15649dfb3d1582-e-6&quot;, &quot;chunk-728b3dfb00a054eed0104e938dfae641-e-2&quot;, &quot;chunk-b6d430b58fe5b3336f2235e2e6daa465-e-5&quot;, &quot;chunk-1522e93c065590bf976748cff2b67e57-e-10&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-728b3dfb00a054eed0104e938dfae641-e-1" label="superalloy melting community">
        <attvalues>
          <attvalue for="0" value="superalloy melting community" />
          <attvalue for="1" value="Community" />
          <attvalue for="2" value="一个专注于高温合金熔炼领域的专业社群。该社群致力于推行与应用新型熔体脱硫方法，旨在通过去除熔融金属中的硫杂质，以提升高温合金的纯净度、质量与综合性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-728b3dfb00a054eed0104e938dfae641" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-728b3dfb00a054eed0104e938dfae641-e-3" label="superclean casting stock">
        <attvalues>
          <attvalue for="0" value="superclean casting stock" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种高纯度铸造原料，通过熔体脱硫等精炼工艺处理，使其硫等杂质含量降至极低水平。这种材料具有极高的洁净度，是生产高质量、高性能铸件的关键基础材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-728b3dfb00a054eed0104e938dfae641" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-728b3dfb00a054eed0104e938dfae641-e-4" label="reactive elements">
        <attvalues>
          <attvalue for="0" value="reactive elements" />
          <attvalue for="1" value="Element Class" />
          <attvalue for="2" value="活性元素 (Reactive elements, REs) 是一类化学性质活泼的金属元素，如钇(Y)、铪(Hf)、镧(La)和锆(Zr)。它们常作为微量掺杂剂，因其易在晶界发生偏聚，能有效改变氧化膜的生长机制，从而显著提高材料的高温抗氧化性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-728b3dfb00a054eed0104e938dfae641" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Reactive elements&quot;, &quot;Reactive elements (REs)&quot;, &quot;reactive element&quot;, &quot;reactive elements (REs)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-728b3dfb00a054eed0104e938dfae641-e-4&quot;, &quot;chunk-5268439e43d92c2ee6fb5551a0ab1a7d-e-1&quot;, &quot;chunk-3de7fb49bbb1a56b800f051f299d5884-e-10&quot;, &quot;chunk-7638042a561888cfdce1fb2ee9ad0428-e-4&quot;, &quot;chunk-0ae4835eab33f3ed749188c7a5dff87b-e-1&quot;, &quot;chunk-22dadd8677004929f45649f589c98023-e-5&quot;, &quot;chunk-3ef3a46d5883ceba55b19f3ce086fd54-e-1&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="16" />
        </attvalues>
      </node>
      <node id="chunk-728b3dfb00a054eed0104e938dfae641-e-5" label="sulphur-free coating material">
        <attvalues>
          <attvalue for="0" value="sulphur-free coating material" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种不含硫的特种涂层材料。其配方中特意添加了活性元素（如钇、锆等），旨在显著提高涂层的附着力、高温抗氧化性或抗腐蚀性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-728b3dfb00a054eed0104e938dfae641" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-728b3dfb00a054eed0104e938dfae641-e-6" label="scale adherence">
        <attvalues>
          <attvalue for="0" value="scale adherence" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一项材料性能，指在高温环境下，材料表面形成的氧化皮（或氧化层）与其基体之间结合的牢固程度。良好的氧化皮附着性对材料的高温防护能力和使用寿命至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-728b3dfb00a054eed0104e938dfae641" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-728b3dfb00a054eed0104e938dfae641-e-8" label="ref. [77]">
        <attvalues>
          <attvalue for="0" value="ref. [77]" />
          <attvalue for="1" value="Reference" />
          <attvalue for="2" value="参考文献[77]，一篇阐述关于添加活性元素（reactive elements）研究成果的引证文献。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-728b3dfb00a054eed0104e938dfae641" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5268439e43d92c2ee6fb5551a0ab1a7d-e-2" label="low-sulphur containing systems">
        <attvalues>
          <attvalue for="0" value="low-sulphur containing systems" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="指硫含量较低，并通过添加活性元素来改善其表面氧化皮附着性能的一类系统。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-5268439e43d92c2ee6fb5551a0ab1a7d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5268439e43d92c2ee6fb5551a0ab1a7d-e-6" label="mechanical performance">
        <attvalues>
          <attvalue for="0" value="mechanical performance" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="机械性能指材料、构件或结构在力学载荷作用下所表现出的特性。它是一组衡量其抵抗变形与断裂能力的综合指标，包括强度、刚度、韧性、硬度和疲劳强度等，是评估其可靠性与使用寿命的关键。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-5268439e43d92c2ee6fb5551a0ab1a7d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5268439e43d92c2ee6fb5551a0ab1a7d-e-6&quot;, &quot;chunk-61a441c3ea495edfbd1f923ab25e12c9-e-20&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5268439e43d92c2ee6fb5551a0ab1a7d-e-7" label="superalloy turbine blade component">
        <attvalues>
          <attvalue for="0" value="superalloy turbine blade component" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种由高温合金材料制成的涡轮叶片部件。其表面施加了覆盖涂层，旨在增强其在高温、高应力等极端工作环境下的抗氧化、抗腐蚀能力与整体机械性能，从而延长服役寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-5268439e43d92c2ee6fb5551a0ab1a7d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-db2933278c73b52c5d13817164ccc262-e-1" label="superalloy turbine blade component">
        <attvalues>
          <attvalue for="0" value="superalloy turbine blade component" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="由超合金制成的涡轮发动机关键部件。它在高温、高压及高离心力下工作，将高温气体的能量转化为转子旋转的机械能。其材料性能和结构完整性对发动机的推力、效率和寿命有决定性影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-db2933278c73b52c5d13817164ccc262" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-db2933278c73b52c5d13817164ccc262-e-2" label="coating">
        <attvalues>
          <attvalue for="0" value="coating" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="一种覆盖在高温合金基体上的材料层。其特点是高温强度低于基体合金，在结构承载时，其内部应力会超过屈服极限而发生塑性变形。" />
          <attvalue for="3" value="{&quot;high-temperature strength&quot;: &quot;lower than that of the superalloy&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-db2933278c73b52c5d13817164ccc262" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Coating&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-db2933278c73b52c5d13817164ccc262-e-2&quot;, &quot;chunk-12839dddacb541f1c423c238ab49ba6e-e-8&quot;, &quot;chunk-1297af8788c2be7a2a158412cd2652f3-e-11&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-db2933278c73b52c5d13817164ccc262-e-3" label="superalloy">
        <attvalues>
          <attvalue for="0" value="superalloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="超合金是一种具有优异高温强度的金属材料，通常用作涡轮叶片等高温核心部件的基体。它承载表面涂层，共同构成零部件，且自身强度高于涂层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-db2933278c73b52c5d13817164ccc262" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-db2933278c73b52c5d13817164ccc262-e-5" label="loading">
        <attvalues>
          <attvalue for="0" value="loading" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="在材料科学领域，指对涂层施加外力或应力的过程，其强度足以超过涂层的屈服极限。该过程会导致涂层发生不可恢复的塑性变形、开裂或其它形式的失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-db2933278c73b52c5d13817164ccc262" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc-e-1" label="Beneficial or Detrimental Outcome">
        <attvalues>
          <attvalue for="0" value="Beneficial or Detrimental Outcome" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="指一个过程最终产生的利弊结果。该结果由环境腐蚀性、操作条件、载荷性质、表面微观结构及应力状态等多种因素共同决定，综合体现为正面或负面效应。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc-e-2" label="Corrosiveness of the environment">
        <attvalues>
          <attvalue for="0" value="Corrosiveness of the environment" />
          <attvalue for="1" value="Factor" />
          <attvalue for="2" value="指环境对其内部实体（如材料、设备或组织）造成损害、退化或负面影响的程度。作为一个关键因素，环境腐蚀性的强弱，直接影响并决定了最终结果是有益的还是有害的。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc-e-5" label="Nature of the loading">
        <attvalues>
          <attvalue for="0" value="Nature of the loading" />
          <attvalue for="1" value="Factor" />
          <attvalue for="2" value="载荷性质（Nature of the loading）指机械力随时间变化的施加方式，如静态或循环加载。作为一个关键因素，它直接影响并决定最终结果是有益还是有害，并且特定的加载方式（如循环加载）会促进材料内部裂纹的萌生。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc-e-6" label="Crack nucleation">
        <attvalues>
          <attvalue for="0" value="Crack nucleation" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="裂纹形核（Crack nucleation）是在应力作用下，固体材料内部或表面形成一个新裂纹的初始物理过程。该现象常发生于材料的应力集中区域（如微观缺陷），是宏观断裂的前奏。加载的性质（如静态或疲劳加载）是促进裂纹形核并决定其机制的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc-e-7" label="Surface microstructure">
        <attvalues>
          <attvalue for="0" value="Surface microstructure" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="表面微观结构 (Surface microstructure) 是一种材料属性，指材料表面在微观尺度下的组织形态，包括晶粒、物相、缺陷等的尺寸、形状及分布。其状态与变化直接决定了材料的宏观性能和最终使用效果，是导致有益或有害结果的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc-e-8" label="Stress state">
        <attvalues>
          <attvalue for="0" value="Stress state" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种材料属性，特指物体表面的内部受力状况。该应力状态的改变（如拉伸或压缩应力的增减）是影响材料性能和使用寿命的关键因素，并直接决定最终结果是有益的还是有害的。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc-e-9" label="Isothermal creep conditions">
        <attvalues>
          <attvalue for="0" value="Isothermal creep conditions" />
          <attvalue for="1" value="Operating Condition" />
          <attvalue for="2" value="**热蠕变条件 (Thermal creep conditions)**: 指在高温和持续机械应力共同作用下，导致材料发生缓慢永久变形的工况。这种条件是工业燃气轮机叶片等高温承力部件的典型工作环境，是评估其材料性能和服役寿命的关键依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Thermal creep conditions&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc-e-9&quot;, &quot;chunk-41ece59584e1285edb645f1d6e7f35cf-e-1&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc-e-10" label="Blading">
        <attvalues>
          <attvalue for="0" value="Blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="Blading（叶片组）是涡轮机或压缩机等旋转机械中的核心组件，由一系列叶片构成。它在高温、高应力的严苛工况下运行，是承受等温蠕变等现象的关键承载部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-fc2cb5fef3be3a5ee0d93ddaafe33dfc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-41ece59584e1285edb645f1d6e7f35cf-e-2" label="Blading">
        <attvalues>
          <attvalue for="0" value="Blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="**Blading**：工业燃气轮机的关键旋转部件，指涡轮和压气机中一系列翼型叶片的总称。它负责将气流的能量转换为机械功，因长期在高温高压下运行，是承受热蠕变效应的主要构件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-41ece59584e1285edb645f1d6e7f35cf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-41ece59584e1285edb645f1d6e7f35cf-e-3" label="Industrial (land-based) gas turbine">
        <attvalues>
          <attvalue for="0" value="Industrial (land-based) gas turbine" />
          <attvalue for="1" value="Equipment" />
          <attvalue for="2" value="一种用于地面工业应用的旋转式内燃动力设备。它将燃料的化学能转化为机械功，通过燃烧产生高温高压燃气，驱动由叶片组成的涡轮高速旋转，主要用于发电和提供机械驱动。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-41ece59584e1285edb645f1d6e7f35cf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-41ece59584e1285edb645f1d6e7f35cf-e-4" label="Tamarin and co-workers [1]">
        <attvalues>
          <attvalue for="0" value="Tamarin and co-workers [1]" />
          <attvalue for="1" value="Researcher" />
          <attvalue for="2" value="由研究员Tamarin领导的科研团队，该团队对JS6U高温合金进行了研究。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-41ece59584e1285edb645f1d6e7f35cf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="47" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-41ece59584e1285edb645f1d6e7f35cf-e-5" label="JS6U superalloy">
        <attvalues>
          <attvalue for="0" value="JS6U superalloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="JS6U是一种高温合金，其关键性能“应力断裂寿命”在800°C和900°C的高温及燃气轮机燃料合成灰的腐蚀环境下被研究。相关研究也涉及在其表面施加Ni-20Co–20Cr–12Al-Y覆层涂料以进行测试。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-41ece59584e1285edb645f1d6e7f35cf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="47" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-41ece59584e1285edb645f1d6e7f35cf-e-6" label="Stress rupture life">
        <attvalues>
          <attvalue for="0" value="Stress rupture life" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="应力蠕变断裂寿命 (Stress Rupture Life) 是一项关键材料性能，指材料在高温和恒定应力作用下，从开始加载到发生断裂所能持续的时间。它是评估高温合金（如JS6U）在燃气轮机等严苛环境中长期服役可靠性的核心指标，其性能会受腐蚀介质影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-41ece59584e1285edb645f1d6e7f35cf" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-41ece59584e1285edb645f1d6e7f35cf-e-6&quot;]}]" />
          <attvalue for="9" value="47" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-41ece59584e1285edb645f1d6e7f35cf-e-7" label="Gas turbine fuel (GZT) synthetic ash">
        <attvalues>
          <attvalue for="0" value="Gas turbine fuel (GZT) synthetic ash" />
          <attvalue for="1" value="Corrosive Agent" />
          <attvalue for="2" value="燃气轮机燃料(GZT)合成灰是一种人造腐蚀剂，用于在实验中模拟真实燃料灰分。它通常被涂覆在高温合金试样上，以测试其在高温下对材料的腐蚀作用，这种作用会严重损害并缩短材料的持久蠕变寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-41ece59584e1285edb645f1d6e7f35cf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="47" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-41ece59584e1285edb645f1d6e7f35cf-e-8" label="Ni-20Co–20Cr–12Al-Y overlay coating">
        <attvalues>
          <attvalue for="0" value="Ni-20Co–20Cr–12Al-Y overlay coating" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="一种以镍为基体，含有20%钴、20%铬、12%铝和钇的防护覆层。该涂层专门应用于JS6U高温合金表面，旨在有效恢复其关键的持久断裂寿命性能，从而提高合金在高温环境下的服役可靠性。" />
          <attvalue for="3" value="{&quot;composition&quot;: &quot;Ni-20Co–20Cr–12Al-Y&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-41ece59584e1285edb645f1d6e7f35cf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="47" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-41ece59584e1285edb645f1d6e7f35cf-e-9" label="800 °C">
        <attvalues>
          <attvalue for="0" value="800 °C" />
          <attvalue for="1" value="Test Parameter" />
          <attvalue for="2" value="摄氏800度（800 °C）是一个试验参数，特指在评估JS6U高温合金的应力持久寿命（Stress Rupture Life）时所采用的特定环境温度。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;800&quot;, &quot;unit&quot;: &quot;°C&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-41ece59584e1285edb645f1d6e7f35cf" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-41ece59584e1285edb645f1d6e7f35cf-e-9&quot;]}]" />
          <attvalue for="9" value="47" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-41ece59584e1285edb645f1d6e7f35cf-e-10" label="900 °C">
        <attvalues>
          <attvalue for="0" value="900 °C" />
          <attvalue for="1" value="Test Parameter" />
          <attvalue for="2" value="一个测试参数，指用于评估JS6U高温合金持久寿命的特定实验温度。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;900&quot;, &quot;unit&quot;: &quot;°C&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-41ece59584e1285edb645f1d6e7f35cf" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-41ece59584e1285edb645f1d6e7f35cf-e-10&quot;]}]" />
          <attvalue for="9" value="47" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-203cb57048ee781208098d35869844a7-e-2" label="thermal-mechanical fatigue (TMF) loading">
        <attvalues>
          <attvalue for="0" value="thermal-mechanical fatigue (TMF) loading" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种作为性能比较基准的参考材料。在涂层技术中，其固有的属性水平是覆盖涂层旨在为被涂覆材料恢复或达到的目标标准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-203cb57048ee781208098d35869844a7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;uncoated material&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-203cb57048ee781208098d35869844a7-e-2&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-203cb57048ee781208098d35869844a7-e-4" label="thermal-mechanical fatigue (TMF) loading">
        <attvalues>
          <attvalue for="0" value="thermal-mechanical fatigue (TMF) loading" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="热机疲劳加载（TMF）是一种复杂的加载工况，指材料同时承受周期性变化的温度和机械应变。该条件旨在模拟高温部件（如燃气轮机叶片）的实际服役环境，用于评估材料在热应力和机械应力联合作用下的疲劳性能及损伤机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-203cb57048ee781208098d35869844a7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="319" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-203cb57048ee781208098d35869844a7-e-5" label="isothermal LCF conditions">
        <attvalues>
          <attvalue for="0" value="isothermal LCF conditions" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="一种在600°C恒定温度下进行的低周疲劳（LCF）测试条件。在此环境下，已证明铝化物涂层会损害材料的疲劳寿命，因此该条件常用于评估高温涂层对基体性能的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-203cb57048ee781208098d35869844a7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-203cb57048ee781208098d35869844a7-e-5&quot;]}]" />
          <attvalue for="9" value="320" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-203cb57048ee781208098d35869844a7-e-7" label="Ductile-to-Brittle Transition Temperature (DBTT)">
        <attvalues>
          <attvalue for="0" value="Ductile-to-Brittle Transition Temperature (DBTT)" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="韧性-脆性转变温度（Ductile-to-Brittle Transition Temperature, DBTT），指材料的力学行为由韧性转变为脆性的临界温度。低于此温度，材料在受力时几乎不发生塑性变形，而会像玻璃一样突然发生脆性断裂。它是衡量金属等材料低温使用安全性的关键性能指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-203cb57048ee781208098d35869844a7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;DBTT&quot;, &quot;DBTT (Ductile-to-Brittle Transition Temperature)&quot;, &quot;Ductile-to-Brittle Transition temperature (DBTT)&quot;, &quot;ductile-to-brittle transition temperature (DBTT)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-203cb57048ee781208098d35869844a7-e-7&quot;, &quot;chunk-e3fb38d02a415446b1548e163c6a6dda-e-1&quot;, &quot;chunk-5d7f538c5d3017feeaf09d39e949ccdc-e-3&quot;, &quot;chunk-15c033042f1da840c39554ca327f7acd-e-7&quot;, &quot;chunk-10bd7f0e07de14852011152b501359da-e-1&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-203cb57048ee781208098d35869844a7-e-8" label="600 °C">
        <attvalues>
          <attvalue for="0" value="600 °C" />
          <attvalue for="1" value="Temperature" />
          <attvalue for="2" value="600 °C 是一个低于铝化物涂层韧脆转变温度（DBTT）的特定温度点。在此温度下，涂层会因呈现脆性而对基材的疲劳寿命产生显著的有害影响。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;600&quot;, &quot;unit&quot;: &quot;Celsius&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-203cb57048ee781208098d35869844a7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-203cb57048ee781208098d35869844a7-e-9" label="ash">
        <attvalues>
          <attvalue for="0" value="ash" />
          <attvalue for="1" value="Contaminant" />
          <attvalue for="2" value="一种在特定测试环境中存在的污染物。其关键特征是，它的存在不会阻碍“覆盖涂层”发挥其恢复材料性能的功效，表明该涂层在这种污染物存在时依然有效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-203cb57048ee781208098d35869844a7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e3fb38d02a415446b1548e163c6a6dda-e-3" label="Fatigue loading">
        <attvalues>
          <attvalue for="0" value="Fatigue loading" />
          <attvalue for="1" value="Mechanical Condition" />
          <attvalue for="2" value="疲劳载荷是一种使材料或结构承受重复或循环变化的载荷工况。该载荷可导致累积性损伤，并最终在远低于材料静强度极限的应力水平下引发疲劳断裂。它是航空发动机等承受复杂周期性载荷的设备设计中需要考虑的典型工况。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-e3fb38d02a415446b1548e163c6a6dda" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e3fb38d02a415446b1548e163c6a6dda-e-4" label="Aeroengine">
        <attvalues>
          <attvalue for="0" value="Aeroengine" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="航空发动机（Aeroengine）是为飞行器提供推力的热力发动机。它在高温、高压和高速旋转的极端条件下运行，其关键部件承受着复杂的循环应力，因此严重的疲劳载荷是其设计、制造和服役过程中需要重点关注的典型工况特征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-e3fb38d02a415446b1548e163c6a6dda" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Aeroengines&quot;, &quot;aeroengine&quot;, &quot;aeroengines&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b3a801531784aa7ab699c1b1f24edd83-e-2&quot;, &quot;chunk-d190e8215d72110cf452de429687e055-e-1&quot;, &quot;chunk-e3fb38d02a415446b1548e163c6a6dda-e-4&quot;, &quot;chunk-a6f8ce7a7c55e9b6f962543810b6ee71-e-2&quot;, &quot;chunk-a55ba38301e56c486550e13f957970e0-e-2&quot;, &quot;chunk-fb2344899d3b3a491819f8a96ffd95f7-e-13&quot;, &quot;chunk-af0a9cb061b4d858fd5a6c9a30785963-e-1&quot;, &quot;chunk-3580e24626fc58694eb8b9e80eb9ed69-e-8&quot;, &quot;chunk-471c3b3783689510c8ddf1dbb87d4b46-e-3&quot;, &quot;chunk-23df60e783372fb64b1a5a9966ec4edc-e-7&quot;, &quot;chunk-b505bbe1d912bcde398fe7f44b786cf0-e-5&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="14" />
        </attvalues>
      </node>
      <node id="chunk-e3fb38d02a415446b1548e163c6a6dda-e-9" label="Surface roughness">
        <attvalues>
          <attvalue for="0" value="Surface roughness" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="表面粗糙度（旧称表面光洁度）是表征零件表面微观几何特征的技术指标。它通过量化表面上微小峰谷的高度和间距（如粗糙度、波纹度）来评价其光滑程度。该属性直接影响工件的摩擦、磨损、配合精度和抗疲劳性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-e3fb38d02a415446b1548e163c6a6dda" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Surface finish&quot;, &quot;surface finish&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a0bc17e9304523fcbd1eb1f1e003c749-e-9&quot;, &quot;chunk-46519664d1993ec85d3dfda3e39a3468-e-1&quot;, &quot;chunk-e3fb38d02a415446b1548e163c6a6dda-e-9&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e3fb38d02a415446b1548e163c6a6dda-e-10" label="Brittleness">
        <attvalues>
          <attvalue for="0" value="Brittleness" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="脆性是一种材料力学性能，指材料在受外力作用时，没有发生显著塑性变形就突然断裂的性质。它是与延展性或韧性相对的概念，通常表现为低冲击吸收能和低断裂伸长率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-e3fb38d02a415446b1548e163c6a6dda" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e3fb38d02a415446b1548e163c6a6dda-e-10&quot;, &quot;chunk-466225ab73e7ea49ac0af36e5725c4c1-e-3&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6f4c84e8661d1e3a5f359969b56cd45d-e-4" label="Isothermal low-cycle-fatigue (LCF) testing">
        <attvalues>
          <attvalue for="0" value="Isothermal low-cycle-fatigue (LCF) testing" />
          <attvalue for="1" value="Test" />
          <attvalue for="2" value="恒温低周疲劳试验是一种在恒定温度下评定材料性能的力学测试。它通过施加足以引起循环塑性变形的高应力或应变载荷，来测定材料在较少循环次数下的疲劳寿命、变形和断裂行为，常用于评估高温合金等。" />
          <attvalue for="3" value="{&quot;temperature_1&quot;: &quot;20 °C&quot;, &quot;temperature_2&quot;: &quot;800 °C&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-6f4c84e8661d1e3a5f359969b56cd45d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6f4c84e8661d1e3a5f359969b56cd45d-e-4&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6f4c84e8661d1e3a5f359969b56cd45d-e-5" label="Increased surface roughness">
        <attvalues>
          <attvalue for="0" value="Increased surface roughness" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="指Ni–20Cr–12Al–Y覆盖涂层表面微观不平整度的增高。它是一种有害的物理特性，是涂层性能退化的表征。该特性的增大会加速涂层的氧化与开裂，从而降低其整体保护性能与使用寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-6f4c84e8661d1e3a5f359969b56cd45d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6f4c84e8661d1e3a5f359969b56cd45d-e-6" label="Inherent brittleness">
        <attvalues>
          <attvalue for="0" value="Inherent brittleness" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="指材料或涂层（如Ni-20Cr-12Al-Y涂层）自身固有的、在几乎无塑性变形下即发生断裂的一种物理性质。此特性是导致涂层过早开裂、剥落等失效模式的关键因素，通常被视为一种有害属性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-6f4c84e8661d1e3a5f359969b56cd45d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5d7f538c5d3017feeaf09d39e949ccdc-e-1" label="Overlay coatings">
        <attvalues>
          <attvalue for="0" value="Overlay coatings" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="Overlay coatings是一种覆盖在基材表面的材料涂层。其一个关键特性是，当环境温度低于材料自身的韧脆转变温度（DBTT）时，涂层会因脆性增加而极易产生开裂现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-5d7f538c5d3017feeaf09d39e949ccdc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5d7f538c5d3017feeaf09d39e949ccdc-e-4" label="Coating composition">
        <attvalues>
          <attvalue for="0" value="Coating composition" />
          <attvalue for="1" value="Material Attribute" />
          <attvalue for="2" value="指构成涂层的化学组分及其含量配比。作为一项决定涂层性能的关键材料属性，它直接影响涂层的韧脆转变温度（DBTT），即材料由韧性状态转变为脆性状态的临界温度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-5d7f538c5d3017feeaf09d39e949ccdc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5d7f538c5d3017feeaf09d39e949ccdc-e-5" label="In-service fatigue problems">
        <attvalues>
          <attvalue for="0" value="In-service fatigue problems" />
          <attvalue for="1" value="Engineering Problem" />
          <attvalue for="2" value="一种工程问题，指零部件在服役期间因循环载荷作用而产生裂纹。这类问题的关键控制方法是应用材料的韧脆转变温度(DBTT)理论来预测和防止其在特定温度下发生脆性断裂。该问题常见于带有铝化物扩散涂层的构件中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-5d7f538c5d3017feeaf09d39e949ccdc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-15c033042f1da840c39554ca327f7acd-e-2" label="Rolls-Royce's Pegasus engine">
        <attvalues>
          <attvalue for="0" value="Rolls-Royce's Pegasus engine" />
          <attvalue for="1" value="Engine" />
          <attvalue for="2" value="罗尔斯·罗伊斯飞马发动机是一款为“鹞”式（Harrier）战斗机提供动力的涡扇发动机。其关键技术特征是发动机叶片上应用了铝化物扩散涂层，以增强性能与耐用性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-15c033042f1da840c39554ca327f7acd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-15c033042f1da840c39554ca327f7acd-e-3" label="Harrier">
        <attvalues>
          <attvalue for="0" value="Harrier" />
          <attvalue for="1" value="Aircraft" />
          <attvalue for="2" value="鹞式（Harrier）是一款著名的喷气式飞机系列，是垂直/短距起降（V/STOL）技术的开创者。其独特飞行能力的核心是采用了罗尔斯·罗伊斯的“飞马”矢量推力发动机，使其无需传统跑道即可作战。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-15c033042f1da840c39554ca327f7acd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-15c033042f1da840c39554ca327f7acd-e-6" label="VTOL (vertical take-off/landing)">
        <attvalues>
          <attvalue for="0" value="VTOL (vertical take-off/landing)" />
          <attvalue for="1" value="Capability" />
          <attvalue for="2" value="VTOL（垂直起降）指飞行器无需依赖跑道即可垂直起飞和降落的一种能力。它极大地增强了飞行器的作战灵活性和部署范围，这一革命性能力由著名的“鹞”式战斗机率先实现并闻名于世。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-15c033042f1da840c39554ca327f7acd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-10bd7f0e07de14852011152b501359da-e-4" label="Thermal-mechanical fatigue (TMF) rig">
        <attvalues>
          <attvalue for="0" value="Thermal-mechanical fatigue (TMF) rig" />
          <attvalue for="1" value="Test Equipment" />
          <attvalue for="2" value="热机械疲劳（TMF）试验台是一种用于模拟循环热载荷与机械载荷耦合作用的试验设备。它采用载荷控制等方式，对高温合金（如CMSX-4）等材料进行测试，以评估其在苛刻服役环境下的疲劳性能与寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-10bd7f0e07de14852011152b501359da" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-10bd7f0e07de14852011152b501359da-e-4&quot;]}]" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-10bd7f0e07de14852011152b501359da-e-5" label="Cobalt-based overlays">
        <attvalues>
          <attvalue for="0" value="Cobalt-based overlays" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="钴基熔覆层是一种以钴为主要成分的熔覆涂层。根据上下文，相较于镍基熔覆层，其对试样寿命的损害性更大。" />
          <attvalue for="3" value="{&quot;brittleness&quot;: &quot;greater&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-10bd7f0e07de14852011152b501359da" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-10bd7f0e07de14852011152b501359da-e-6" label="Nickel-based overlays">
        <attvalues>
          <attvalue for="0" value="Nickel-based overlays" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="镍基堆焊涂层（Nickel-based overlays）是一种以镍为主要成分的材料表层涂层。它通过堆焊工艺施加于工件表面，用于提高耐磨、耐腐蚀等性能。与钴基涂层相比，其对基材部件使用寿命的负面影响更小。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-10bd7f0e07de14852011152b501359da" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-10bd7f0e07de14852011152b501359da-e-7" label="Specimen life">
        <attvalues>
          <attvalue for="0" value="Specimen life" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="一项性能指标，用于衡量测试试样在热机械疲劳（TMF）测试中直至失效的寿命。在特定实验条件下，施加覆盖涂层（Overlay coating）会缩短该试样的寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-10bd7f0e07de14852011152b501359da" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9a03b89c4abdb7803daf0ef7320556a8-e-2" label="IN738LC">
        <attvalues>
          <attvalue for="0" value="IN738LC" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="IN738LC是一种沉淀硬化型镍基铸造高温合金，是IN738的低碳(LC)改型。它兼具卓越的高温强度、抗蠕变和抗热腐蚀性能，低碳含量改善了其延展性。主要用于制造工业和航空燃气轮机的涡轮叶片及其他热端部件。" />
          <attvalue for="3" value="{&quot;casting_method&quot;: &quot;conventionally cast&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-9a03b89c4abdb7803daf0ef7320556a8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9a03b89c4abdb7803daf0ef7320556a8-e-2&quot;, &quot;chunk-f23caa328479b9d419f0d855b9335eb4-e-11&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9a03b89c4abdb7803daf0ef7320556a8-e-3" label="Strain-controlled TMF">
        <attvalues>
          <attvalue for="0" value="Strain-controlled TMF" />
          <attvalue for="1" value="Test Method" />
          <attvalue for="2" value="应变控制热机械疲劳 (Strain-controlled TMF) 是一种材料测试方法。它通过对试样同步施加循环变化的温度和机械应变，来模拟零部件在高温、变载荷环境下的真实服役工况，从而评估材料的疲劳性能、损伤机制并预测其使用寿命。" />
          <attvalue for="3" value="{&quot;min_temperature&quot;: &quot;300 °C&quot;, &quot;max_temperature&quot;: &quot;900 °C&quot;, &quot;dwell_period&quot;: &quot;two-minute dwell period after heating and cooling&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-9a03b89c4abdb7803daf0ef7320556a8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9a03b89c4abdb7803daf0ef7320556a8-e-4" label="Extensive cracking">
        <attvalues>
          <attvalue for="0" value="Extensive cracking" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="一种失效模式，指CoNiCrAlY型涂层在测试过程中，于最终断裂失效前呈现出大面积的裂纹现象。这种现象是材料即将发生灾难性破坏的关键前兆。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-9a03b89c4abdb7803daf0ef7320556a8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9a03b89c4abdb7803daf0ef7320556a8-e-4&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dc948aa78d11700723dfefe1c5756cc9-e-2" label="Coated specimens">
        <attvalues>
          <attvalue for="0" value="Coated specimens" />
          <attvalue for="1" value="Test Sample" />
          <attvalue for="2" value="**涂层试样**是一种表面附有特定涂层的测试样品。它主要用于疲劳寿命评估实验，通过与未涂层试样进行性能对比，来研究和验证涂层对材料基体疲劳性能的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-dc948aa78d11700723dfefe1c5756cc9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dc948aa78d11700723dfefe1c5756cc9-e-2&quot;]}]" />
          <attvalue for="9" value="203" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dc948aa78d11700723dfefe1c5756cc9-e-3" label="Uncoated specimens">
        <attvalues>
          <attvalue for="0" value="Uncoated specimens" />
          <attvalue for="1" value="Test Sample" />
          <attvalue for="2" value="一种表面无涂层的测试样品。在材料性能测试中，它通常作为对照组，用于和涂层试样进行性能（如疲劳寿命）的对比，以评估涂层所带来的影响，并为性能变化提供一个基准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-dc948aa78d11700723dfefe1c5756cc9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dc948aa78d11700723dfefe1c5756cc9-e-3&quot;]}]" />
          <attvalue for="9" value="203" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dc948aa78d11700723dfefe1c5756cc9-e-6" label="Resistance to thermal cycling">
        <attvalues>
          <attvalue for="0" value="Resistance to thermal cycling" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="抗热循环性 (Resistance to thermal cycling) 是一项材料性能，指材料（特别是热障涂层）在经受反复的剧烈温度变化时，抵抗因热失配应力导致的开裂、剥落等损伤的能力。该性能通常通过燃烧器试验等方法评估，并受到覆盖涂层等因素的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-dc948aa78d11700723dfefe1c5756cc9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-dc948aa78d11700723dfefe1c5756cc9-e-7" label="Burner rig test">
        <attvalues>
          <attvalue for="0" value="Burner rig test" />
          <attvalue for="1" value="Test Method" />
          <attvalue for="2" value="一种高温加速测试方法，通过使用高速火焰喷烧和强制冷却，使材料样品经受快速、剧烈的温度循环。该方法主要用于模拟燃气轮机叶片等部件在严酷工况下的服役环境，以评估材料，特别是热障涂层，抗热循环疲劳、氧化和剥落的性能与寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-dc948aa78d11700723dfefe1c5756cc9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dc948aa78d11700723dfefe1c5756cc9-e-7&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dc948aa78d11700723dfefe1c5756cc9-e-8" label="Overlay coating">
        <attvalues>
          <attvalue for="0" value="Overlay coating" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="覆盖涂层是一种位于基体与热障涂层(TBC)之间的关键材料层。它的主要功能是作为粘结层，其化学成分和微观结构直接影响整个涂层系统的抗热循环能力。因此，该涂层的质量与热障涂层的整体性能和最终使用寿命密切相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-dc948aa78d11700723dfefe1c5756cc9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-dc948aa78d11700723dfefe1c5756cc9-e-9" label="TBC life">
        <attvalues>
          <attvalue for="0" value="TBC life" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="热障涂层寿命（TBC life）是一项材料属性，指热障涂层（Thermal Barrier Coating）在特定工况下能够有效工作的持续时间。该属性与覆盖涂层（Overlay coating）的化学成分等因素密切相关，是衡量涂层系统耐久性和可靠性的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-dc948aa78d11700723dfefe1c5756cc9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6ce78613853147c21bacd4dcc417e01e-e-2" label="Overlay Coating">
        <attvalues>
          <attvalue for="0" value="Overlay Coating" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="一种致密的金属基涂层，通常为MCrAlY合金（如NiCrAlY），在热障涂层（TBC）系统中充当结合层。其核心功能是为陶瓷顶层提供附着基础，并凭借其关键的抗高温氧化性能来保护基体材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-6ce78613853147c21bacd4dcc417e01e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-6ce78613853147c21bacd4dcc417e01e-e-3" label="TBC life">
        <attvalues>
          <attvalue for="0" value="TBC life" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="TBC寿命 (TBC life) 指热障涂层从服役到发生剥落失效的时间，也称剥落寿命。它是衡量涂层耐久性的关键指标，其长短与粘结层的抗氧化性能密切相关，通常可通过氧化增重来评估。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-6ce78613853147c21bacd4dcc417e01e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6ce78613853147c21bacd4dcc417e01e-e-5" label="Bond Coat">
        <attvalues>
          <attvalue for="0" value="Bond Coat" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="粘结涂层是一种施加在基体与顶层涂层（如热障涂层）之间的功能性中间层。其主要作用是增强涂层体系的附着力，并为下方基体提供抗高温氧化和腐蚀的保护。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-6ce78613853147c21bacd4dcc417e01e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6ce78613853147c21bacd4dcc417e01e-e-6" label="ZrO2–6.1 wt%Y2O3">
        <attvalues>
          <attvalue for="0" value="ZrO2–6.1 wt%Y2O3" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种氧化钇稳定氧化锆(YSZ)陶瓷材料，由氧化锆(ZrO2)基体和6.1 wt%的氧化钇(Y2O3)稳定剂构成。因其优异的高温稳定性和低导热性，常被用作热障涂层(TBC)的核心材料，以保护基材免受高温影响。" />
          <attvalue for="3" value="{&quot;composition&quot;: &quot;ZrO2–6.1 wt%Y2O3&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-6ce78613853147c21bacd4dcc417e01e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6ce78613853147c21bacd4dcc417e01e-e-6&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6ce78613853147c21bacd4dcc417e01e-e-7" label="NiCrAlY">
        <attvalues>
          <attvalue for="0" value="NiCrAlY" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="NiCrAlY是一种由镍(Ni)、铬(Cr)、铝(Al)、钇(Y)组成的合金。作为一种高温防护覆层涂料，它常被涂敷在高温合金（如Mar-M200+Hf）表面，以提供抗高温氧化和耐腐蚀保护。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-6ce78613853147c21bacd4dcc417e01e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6ce78613853147c21bacd4dcc417e01e-e-8" label="Mar-M200+Hf superalloy">
        <attvalues>
          <attvalue for="0" value="Mar-M200+Hf superalloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="Mar-M200+Hf是一种镍基高温合金，为Mar-M200合金添加铪(Hf)后的改良型号。铪能改善其晶界强度和高温蠕变抗力。该合金因其优异的性能，主要用作航空发动机或燃气轮机涡轮叶片等高温结构部件的基底材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-6ce78613853147c21bacd4dcc417e01e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6ce78613853147c21bacd4dcc417e01e-e-8&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6ce78613853147c21bacd4dcc417e01e-e-9" label="Specific weight gain due to oxidation">
        <attvalues>
          <attvalue for="0" value="Specific weight gain due to oxidation" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="氧化比增重是一种物理现象，指材料因氧化反应导致的单位面积质量增加，是量化氧化程度的关键指标。在热障涂层(TBC)领域，该数值与涂层的剥落寿命存在强相关性，因此被广泛用作评估和预测TBC系统可靠性与剩余服役寿命的重要依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-6ce78613853147c21bacd4dcc417e01e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6ce78613853147c21bacd4dcc417e01e-e-9&quot;, &quot;chunk-005fa05cc92b868ff65d4cf5445802b2-e-2&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-005fa05cc92b868ff65d4cf5445802b2-e-1" label="TBC spallation life">
        <attvalues>
          <attvalue for="0" value="TBC spallation life" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="热障涂层（TBC）在高温环境下因氧化等因素导致剥落失效之前能够服役的时间。作为一项关键材料属性，其寿命长短通常与氧化速率成反比，并与失效时的临界氧化增重密切相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-005fa05cc92b868ff65d4cf5445802b2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-005fa05cc92b868ff65d4cf5445802b2-e-3" label="Rate of oxidation">
        <attvalues>
          <attvalue for="0" value="Rate of oxidation" />
          <attvalue for="1" value="Process Rate" />
          <attvalue for="2" value="氧化速率（Rate of oxidation）指氧化反应进行的快慢程度，是衡量单位时间内反应物消耗或产物生成量的物理量。此速率是影响材料性能和寿命的关键因素，例如在热障涂层（TBC）中，它与涂层的剥落寿命成反比，速率越快则寿命越短。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-005fa05cc92b868ff65d4cf5445802b2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-005fa05cc92b868ff65d4cf5445802b2-e-5" label="Microstructural degradation">
        <attvalues>
          <attvalue for="0" value="Microstructural degradation" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="微观结构退化是一种材料失效模式，特指铝化物涂层在服役期间，因高温下的相变、元素相互扩散等原因，导致其内部组织结构发生劣化，从而降低涂层原有保护性能的过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-005fa05cc92b868ff65d4cf5445802b2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5682b41ca5ff8b266cfe8297070b22b7-e-2" label="β–NiAl phase">
        <attvalues>
          <attvalue for="0" value="β–NiAl phase" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="β–NiAl相是铝化物涂层中的一种主要初始物相。随着时间推移，该相会逐渐被消耗并转化为γ'相，导致其含量减少，同时它也变得易于发生马氏体相变。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-5682b41ca5ff8b266cfe8297070b22b7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-5682b41ca5ff8b266cfe8297070b22b7-e-3" label="Superalloy substrate">
        <attvalues>
          <attvalue for="0" value="Superalloy substrate" />
          <attvalue for="1" value="Material Substrate" />
          <attvalue for="2" value="一种由高温合金构成的基体材料，是制备铝化物涂层的基础。它通过与涂层发生元素互扩散，形成冶金结合的保护层，以提升材料在高温环境下的抗氧化与抗腐蚀性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-5682b41ca5ff8b266cfe8297070b22b7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5682b41ca5ff8b266cfe8297070b22b7-e-4" label="Aluminium">
        <attvalues>
          <attvalue for="0" value="Aluminium" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="铝是一种化学元素，在特定涂层中作为关键组分。其浓度会因相互扩散而随时间降低，这一过程会促进'y'相的形成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-5682b41ca5ff8b266cfe8297070b22b7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5682b41ca5ff8b266cfe8297070b22b7-e-6" label="Martensitic transformation">
        <attvalues>
          <attvalue for="0" value="Martensitic transformation" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="马氏体相变是一种无扩散型固态相变。在此过程中，原子通过协同的剪切位移进行重排，导致晶格结构发生瞬时改变。该过程通常由快速冷却或外加应力触发，是钢和形状记忆合金等材料获得高强度等特殊性能的关键物理机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-5682b41ca5ff8b266cfe8297070b22b7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Martensitic reaction&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5682b41ca5ff8b266cfe8297070b22b7-e-6&quot;, &quot;chunk-ba3c7d1b88adc32b3ab9a1e047094bdc-e-5&quot;, &quot;chunk-8a8245180b98739270d9b9b4befedd30-e-9&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-04f7985cbfd683d851bd2e54d7fa0470-e-1" label="β">
        <attvalues>
          <attvalue for="0" value="β" />
          <attvalue for="1" value="Phase" />
          <attvalue for="2" value="ß相是一种物相。当其化学计量偏离时，该相会变得不稳定，并能通过马氏体相变转变为β'相。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-04f7985cbfd683d851bd2e54d7fa0470" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;ß&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-04f7985cbfd683d851bd2e54d7fa0470-e-1&quot;]}]" />
          <attvalue for="9" value="204" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-04f7985cbfd683d851bd2e54d7fa0470-e-2" label="β'">
        <attvalues>
          <attvalue for="0" value="β'" />
          <attvalue for="1" value="Phase" />
          <attvalue for="2" value="β'相是由其母相β相通过马氏体相变而形成的一种马氏体物相。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-04f7985cbfd683d851bd2e54d7fa0470" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-04f7985cbfd683d851bd2e54d7fa0470-e-2&quot;]}]" />
          <attvalue for="9" value="204" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-04f7985cbfd683d851bd2e54d7fa0470-e-3" label="interdiffusion">
        <attvalues>
          <attvalue for="0" value="interdiffusion" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="互扩散（interdiffusion）是一种材料在接触界面处，不同组分的原子因浓度梯度驱动而发生相互迁移、混合的过程。由于各组分原子通量（扩散速率）不相等，该过程可引发柯肯达尔效应，导致柯肯达尔空洞的形成，并能促进界面处新物相的生成，即二次反应区（SRZ）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-04f7985cbfd683d851bd2e54d7fa0470" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-04f7985cbfd683d851bd2e54d7fa0470-e-3&quot;, &quot;chunk-1297af8788c2be7a2a158412cd2652f3-e-10&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-04f7985cbfd683d851bd2e54d7fa0470-e-5" label="coating/substrate combinations">
        <attvalues>
          <attvalue for="0" value="coating/substrate combinations" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="一种由涂层和基底构成的材料体系。在此类组合中，由于两种材料的原子在界面处扩散速率不平衡，导致空位聚集，从而形成可能损害材料结合强度的柯肯达尔空洞。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-04f7985cbfd683d851bd2e54d7fa0470" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-04f7985cbfd683d851bd2e54d7fa0470-e-6" label="third-generation single-crystal superalloys">
        <attvalues>
          <attvalue for="0" value="third-generation single-crystal superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="第三代单晶高温合金是一类富含铼（Re）的先进材料。其高铼含量特点会促进元素间的相互扩散，从而在微观结构中形成二次反应区（Secondary Reaction Zone, SRZ），这对材料的组织稳定性和性能有重要影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-04f7985cbfd683d851bd2e54d7fa0470" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-04f7985cbfd683d851bd2e54d7fa0470-e-8" label="secondary reaction zone (SRZ)">
        <attvalues>
          <attvalue for="0" value="secondary reaction zone (SRZ)" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="二次反应区 (Secondary reaction zones, SRZs) 是一种微观结构区域，特指位于铝化物涂层下方，其中会形成拓扑密排相（Topologically close-packed phases, TCP）的特定区域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-04f7985cbfd683d851bd2e54d7fa0470" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;SRZ&quot;, &quot;Secondary reaction zone (SRZ)&quot;, &quot;Secondary reaction zones (SRZs)&quot;, &quot;secondary reaction zone&quot;, &quot;secondary reaction zones&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-04f7985cbfd683d851bd2e54d7fa0470-e-8&quot;, &quot;chunk-1a93cf0e7220cae761fdbf08f5ce260b-e-1&quot;, &quot;chunk-2947345c06e9b1b937f82bc1b2da5774-e-1&quot;, &quot;chunk-be5a585b4779a163f574e99353c822f8-e-6&quot;, &quot;chunk-98dc45a2c81a5783151664ba74c4681e-e-5&quot;, &quot;chunk-e59e76ae369265e25373e5545e9102c3-e-6&quot;, &quot;chunk-f7942340b7bda97e3a76f6ceb1d90c75-e-9&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-04f7985cbfd683d851bd2e54d7fa0470-e-9" label="interdiffusion zone (IDZ)">
        <attvalues>
          <attvalue for="0" value="interdiffusion zone (IDZ)" />
          <attvalue for="1" value="Microstructural Zone" />
          <attvalue for="2" value="互扩散区 (IDZ) 是一种微观结构特征，指在不同材料的界面处，因原子相互扩散而形成的过渡区域。在特定的多层结构中，该区域通常位于次级反应区 (SRZ) 的上方。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-04f7985cbfd683d851bd2e54d7fa0470" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-04f7985cbfd683d851bd2e54d7fa0470-e-9&quot;, &quot;chunk-1a93cf0e7220cae761fdbf08f5ce260b-e-2&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1a93cf0e7220cae761fdbf08f5ce260b-e-3" label="discontinuous phase transformation">
        <attvalues>
          <attvalue for="0" value="discontinuous phase transformation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种固态相变机制。其特征是新相在母相的晶界等高能界面处形核，并通过一个移动的反应界面迁移长大。当界面扫过母相时，会引起材料的化学成分和/或晶体结构发生不连续的突变，常形成胞状组织。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-1a93cf0e7220cae761fdbf08f5ce260b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1a93cf0e7220cae761fdbf08f5ce260b-e-4" label="y' matrix">
        <attvalues>
          <attvalue for="0" value="y' matrix" />
          <attvalue for="1" value="Phase" />
          <attvalue for="2" value="y'基体是一种形成于二次反应区(SRZ)中的基体相，其内部包含呈针状析出的γ相与拓扑密排P相。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1a93cf0e7220cae761fdbf08f5ce260b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-1a93cf0e7220cae761fdbf08f5ce260b-e-7" label="recrystallisation">
        <attvalues>
          <attvalue for="0" value="recrystallisation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="由二次反应区（SRZ）的形成所引发的一种材料内部过程，该过程会对合金的γ/γ'微观结构产生影响，改变其性能。" />
          <attvalue for="3" value="{&quot;texture_induction&quot;: &quot;not significant&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-1a93cf0e7220cae761fdbf08f5ce260b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1a93cf0e7220cae761fdbf08f5ce260b-e-7&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2947345c06e9b1b937f82bc1b2da5774-e-2" label="TCP precipitation">
        <attvalues>
          <attvalue for="0" value="TCP precipitation" />
          <attvalue for="1" value="Metallurgical Phenomenon" />
          <attvalue for="2" value="TCP相析出（Topologically Close-Packed precipitation）是一种冶金现象，指在合金（尤指高温合金）中形成具有复杂晶体结构的脆性金属间相。由于这些相会消耗基体中的强化元素，通常被视为有害相，会显著降低材料的力学性能和高温稳定性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-2947345c06e9b1b937f82bc1b2da5774" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;precipitation of topologically close-packed phases&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2947345c06e9b1b937f82bc1b2da5774-e-2&quot;, &quot;chunk-1297af8788c2be7a2a158412cd2652f3-e-9&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-b6c046cc51d2c72553ce28c1316afa3c-e-1" label="SRZ reaction">
        <attvalues>
          <attvalue for="0" value="SRZ reaction" />
          <attvalue for="1" value="Metallurgical Process" />
          <attvalue for="2" value="SRZ反应是一种发生在高温合金中的冶金过程，其形核与合金的表面处理方式密切相关。例如，喷丸处理会促进此反应的发生，而电解抛光等工艺则能有效抑制它。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-b6c046cc51d2c72553ce28c1316afa3c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-b6c046cc51d2c72553ce28c1316afa3c-e-2" label="Surface preparation">
        <attvalues>
          <attvalue for="0" value="Surface preparation" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="表面处理是一种制造工艺，指在进行涂层等后续工序前，对超合金等基材表面进行的预处理。它通过喷砂、打磨等方法改变表面特性，以优化涂层附着力与性能，并对二次反应区（SRZ）等微观结构反应产生关键影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-b6c046cc51d2c72553ce28c1316afa3c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-b6c046cc51d2c72553ce28c1316afa3c-e-3" label="Superalloy">
        <attvalues>
          <attvalue for="0" value="Superalloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="高温合金（Superalloy）是一类金属材料，通常以铁、镍、钴为基。它能在高温和极端应力下，仍保持优异的机械强度、抗蠕变性、表面稳定性及抗氧化腐蚀能力，是航空航天等领域的关键材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-b6c046cc51d2c72553ce28c1316afa3c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b6c046cc51d2c72553ce28c1316afa3c-e-4" label="Electropolishing">
        <attvalues>
          <attvalue for="0" value="Electropolishing" />
          <attvalue for="1" value="Surface Preparation Method" />
          <attvalue for="2" value="电解抛光是一种电化学精加工工艺，通过电解原理选择性地移除金属表面材料，以实现去毛刺、提高平滑度和光亮度的目的。该工艺能形成钝化层以增强耐腐蚀性，并可防止SRZ反应。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-b6c046cc51d2c72553ce28c1316afa3c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b6c046cc51d2c72553ce28c1316afa3c-e-5" label="Shot peening">
        <attvalues>
          <attvalue for="0" value="Shot peening" />
          <attvalue for="1" value="Surface Preparation Method" />
          <attvalue for="2" value="喷丸是一种冷加工工艺，利用高速丸粒流冲击金属表面，产生残余压应力层，从而提高部件的疲劳寿命、强度和抗应力腐蚀性能。它常用于航空航天、汽车等领域的关键承载部件的表面强化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-b6c046cc51d2c72553ce28c1316afa3c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b6c046cc51d2c72553ce28c1316afa3c-e-7" label="Grinding">
        <attvalues>
          <attvalue for="0" value="Grinding" />
          <attvalue for="1" value="Surface Preparation Method" />
          <attvalue for="2" value="磨削（Grinding）是一种利用磨料磨具对工件进行切削的精密加工与表面处理方法。它主要用于获得极高的尺寸精度和优良的表面光洁度，其机械与热效应会在工件表层引入一定的塑性变形和残余应力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-b6c046cc51d2c72553ce28c1316afa3c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b6c046cc51d2c72553ce28c1316afa3c-e-8" label="Degradation">
        <attvalues>
          <attvalue for="0" value="Degradation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="降解（Degradation）是指一个可循多种模式进行的过程。该过程的特定表现之一是，它会直接引起并导致氧化铝层（Alumina scale）的形成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-b6c046cc51d2c72553ce28c1316afa3c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b6c046cc51d2c72553ce28c1316afa3c-e-8&quot;, &quot;chunk-1a10b9ced7aeca4719469cc8e85d9ba9-e-1&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-b6c046cc51d2c72553ce28c1316afa3c-e-9" label="Alumina scale">
        <attvalues>
          <attvalue for="0" value="Alumina scale" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="一种主要由氧化铝（Al₂O₃）构成的致密材料层。它通常是在含铝合金等材料的表面，因高温氧化等降解过程而形成的产物。该氧化皮结构稳定，能作为有效的扩散屏障，从而保护基体材料免受进一步的氧化或腐蚀。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-b6c046cc51d2c72553ce28c1316afa3c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1a10b9ced7aeca4719469cc8e85d9ba9-e-2" label="Alumina scale formation">
        <attvalues>
          <attvalue for="0" value="Alumina scale formation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种由氧化作用导致的材料降解模式。在此过程中，材料（通常是含铝合金）的表面会生成一层致密的氧化铝（Al₂O₃）垢层，这层物质有时也起保护作用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-1a10b9ced7aeca4719469cc8e85d9ba9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1a10b9ced7aeca4719469cc8e85d9ba9-e-2&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1a10b9ced7aeca4719469cc8e85d9ba9-e-4" label="Al">
        <attvalues>
          <attvalue for="0" value="Al" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="铝（Aluminum），化学符号Al，是一种金属元素。在当前上下文中，它特指作为涂层的一种组分，会因涂层发生降解而被逐渐消耗或损耗。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1a10b9ced7aeca4719469cc8e85d9ba9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1a10b9ced7aeca4719469cc8e85d9ba9-e-5" label="Coating">
        <attvalues>
          <attvalue for="0" value="Coating" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="一种材料层，其有效使用寿命因其关键组分铝（Al）的耗尽而终结。铝的消耗是导致该涂层功能失效并达到寿命终点的直接原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1a10b9ced7aeca4719469cc8e85d9ba9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1a10b9ced7aeca4719469cc8e85d9ba9-e-6" label="β–NiAl phase">
        <attvalues>
          <attvalue for="0" value="β–NiAl phase" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="β–NiAl相是一种具有B2有序体心立方结构的镍铝金属间化合物。它通常是铝化物涂层中的主要功能相，因其优异的高温稳定性和抗氧化性能，为航空发动机涡轮叶片等高温合金部件提供关键的防护作用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-1a10b9ced7aeca4719469cc8e85d9ba9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1a10b9ced7aeca4719469cc8e85d9ba9-e-9" label="'model' NiAl-based alloys">
        <attvalues>
          <attvalue for="0" value="'model' NiAl-based alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种镍铝基模型合金，用于研究其表面三氧化二铝（Al2O3）氧化膜的形成机理，以及掺杂元素对该过程和合金性能的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-1a10b9ced7aeca4719469cc8e85d9ba9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1a10b9ced7aeca4719469cc8e85d9ba9-e-10" label="Doping elements">
        <attvalues>
          <attvalue for="0" value="Doping elements" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="指一类被有意引入（掺杂）到模型镍铝基合金中的化学元素。其目的是通过改变合金的微量成分，系统地研究、调控并优化该合金的物理、化学或力学等关键性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-1a10b9ced7aeca4719469cc8e85d9ba9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-de80f6907a699addef0ea7d8827deb59-e-1" label="'model' NiAl-based alloys">
        <attvalues>
          <attvalue for="0" value="'model' NiAl-based alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种以金属间化合物NiAl为基础的合金体系。它们通常作为成分简化的理想化研究平台（即“模型”），用于系统性地探究不同元素掺杂对其微观结构、高温强度及室温韧性等性能的影响规律。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-de80f6907a699addef0ea7d8827deb59" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="321" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-de80f6907a699addef0ea7d8827deb59-e-2" label="β–NiAl">
        <attvalues>
          <attvalue for="0" value="β–NiAl" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="β–NiAl (β相镍铝化物) 是一种有序金属间化合物。其显著特性为，在特定条件下（如高温氧化），其表面能够形成一层亚稳态的立方氧化铝。" />
          <attvalue for="3" value="{&quot;purity&quot;: &quot;pure&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-de80f6907a699addef0ea7d8827deb59" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-de80f6907a699addef0ea7d8827deb59-e-3" label="metastable cubic aluminas">
        <attvalues>
          <attvalue for="0" value="metastable cubic aluminas" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="一类在β-NiAl基体上形成的亚稳态过渡氧化铝，如γ、δ、θ-Al2O3。它以其特有的晶须状微观形貌为主要物理特征。" />
          <attvalue for="3" value="{&quot;alias&quot;: &quot;'transition' aluminas&quot;, &quot;crystal_structure&quot;: &quot;cubic&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-de80f6907a699addef0ea7d8827deb59" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-de80f6907a699addef0ea7d8827deb59-e-4" label="γ-Al2O3">
        <attvalues>
          <attvalue for="0" value="γ-Al2O3" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="γ-Al2O3，即γ-氧化铝，是氧化铝的一种亚稳态同质异形体，具有缺陷尖晶石型立方结构。因其高比表面积、多孔性和良好的热稳定性，被广泛用作工业催化剂、催化剂载体及吸附剂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-de80f6907a699addef0ea7d8827deb59" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-de80f6907a699addef0ea7d8827deb59-e-5" label="δ-Al2O3">
        <attvalues>
          <attvalue for="0" value="δ-Al2O3" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="δ-Al₂O₃ (δ-氧化铝) 是氧化铝 (Al₂O₃) 的一种亚稳态同质异形体，属于过渡氧化铝。它具有立方晶体结构，在高温下会转变为更稳定的α-Al₂O₃相。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-de80f6907a699addef0ea7d8827deb59" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-de80f6907a699addef0ea7d8827deb59-e-6" label="θ-Al2O3">
        <attvalues>
          <attvalue for="0" value="θ-Al2O3" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="θ-Al2O3，又称θ-氧化铝，是一种亚稳态的过渡氧化铝。它具有立方晶体结构，是氧化铝在特定热处理条件下形成的一种重要的同质异形体，可进一步转变为热力学上最稳定的α-Al2O3。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-de80f6907a699addef0ea7d8827deb59" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-de80f6907a699addef0ea7d8827deb59-e-7" label="whiskers">
        <attvalues>
          <attvalue for="0" value="whiskers" />
          <attvalue for="1" value="Morphology" />
          <attvalue for="2" value="一种ic氧化铝所呈现的特殊晶须状形貌。它的出现表明材料遵循一种特定的生长机制，该机制由铝阳离子（Al3+）的活动所主导。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-de80f6907a699addef0ea7d8827deb59" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-de80f6907a699addef0ea7d8827deb59-e-7&quot;, &quot;chunk-3b9fc12d9e53d6f182e075b23403b4d9-e-2&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3b9fc12d9e53d6f182e075b23403b4d9-e-1" label="ic aluminas">
        <attvalues>
          <attvalue for="0" value="ic aluminas" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="ic aluminas是一种在高温合金基底上外延生长的、具有晶须形态的氧化铝。它是一种亚稳相，其相变始于金属-氧化物界面，最终会转化为稳定的α-Al2O3。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-3b9fc12d9e53d6f182e075b23403b4d9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-3b9fc12d9e53d6f182e075b23403b4d9-e-3" label="Al³⁺ cation">
        <attvalues>
          <attvalue for="0" value="Al³⁺ cation" />
          <attvalue for="1" value="Ion" />
          <attvalue for="2" value="三价铝阳离子 (Al³⁺)，一种金属阳离子。在特定氧化铝（如晶须）的生长过程中，其向外迁移是控制整个生长机制的核心因素。这种由阳离子扩散主导的生长模式已通过¹⁸O₂示踪研究等实验方法证实。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-3b9fc12d9e53d6f182e075b23403b4d9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Al3+&quot;, &quot;Al3+ cation&quot;, &quot;Al³+ cation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3b9fc12d9e53d6f182e075b23403b4d9-e-3&quot;, &quot;chunk-455a426fd56bc0498536fbbc0427ca38-e-5&quot;, &quot;chunk-7638042a561888cfdce1fb2ee9ad0428-e-1&quot;, &quot;chunk-4e1df0fa0fa7afa66a5ee088dbcbc837-e-4&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-3b9fc12d9e53d6f182e075b23403b4d9-e-4" label="18O2 tracer studies">
        <attvalues>
          <attvalue for="0" value="18O2 tracer studies" />
          <attvalue for="1" value="Experimental Method" />
          <attvalue for="2" value="¹⁸O₂示踪研究是一种同位素标记实验方法。它利用氧的稳定同位素¹⁸O作为示踪剂，通过追踪其在氧化物生长过程中的分布，来精确揭示材料的氧化机理。例如，该方法证实了氧化铝的生长是由Al³⁺阳离子的向外迁移所主导。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-3b9fc12d9e53d6f182e075b23403b4d9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3b9fc12d9e53d6f182e075b23403b4d9-e-5" label="superalloy substrate">
        <attvalues>
          <attvalue for="0" value="superalloy substrate" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种高温合金基底材料。其晶体结构与ic氧化铝（ic aluminas）具有外延取向关系，即两者晶格能够对齐生长，但与α-Al2O3化合物不具有这种关系。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3b9fc12d9e53d6f182e075b23403b4d9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3b9fc12d9e53d6f182e075b23403b4d9-e-7" label="metal-oxide interface">
        <attvalues>
          <attvalue for="0" value="metal-oxide interface" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="氧化物与金属材料之间的边界区域。该界面通常是材料内部的薄弱环节，是空洞、裂纹等缺陷常见的形核与生长位置，其结构与稳定性对材料的整体性能和服役可靠性至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-3b9fc12d9e53d6f182e075b23403b4d9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Oxide/metal interface&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3b9fc12d9e53d6f182e075b23403b4d9-e-7&quot;, &quot;chunk-c577786ed818c3adfe9e2cc146b9c0be-e-7&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-455a426fd56bc0498536fbbc0427ca38-e-1" label="Polycrystalline scale">
        <attvalues>
          <attvalue for="0" value="Polycrystalline scale" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="一种在未掺杂的NiAl基体上形成的多晶材料层。其表面呈现特征性的“脊状”形貌，内部微观结构则包含小角度晶界、裂纹与孔隙等缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-455a426fd56bc0498536fbbc0427ca38" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-455a426fd56bc0498536fbbc0427ca38-e-2" label="undoped NiAl">
        <attvalues>
          <attvalue for="0" value="undoped NiAl" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="未掺杂镍铝(undoped NiAl)是一种由镍和铝组成的金属间化合物。作为一种基底材料，其表面在特定条件下会生长形成一层多晶结构的氧化膜（或称氧化皮）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-455a426fd56bc0498536fbbc0427ca38" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-455a426fd56bc0498536fbbc0427ca38-e-3" label="'ridged' morphology">
        <attvalues>
          <attvalue for="0" value="'ridged' morphology" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="一种微观结构特征，指在多晶氧化膜中，因Al³⁺阳离子沿大角度晶界优先向外扩散，而在其表面形成的具有山脊状或棱状外观的特定形态。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-455a426fd56bc0498536fbbc0427ca38" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-455a426fd56bc0498536fbbc0427ca38-e-4" label="high angle boundaries">
        <attvalues>
          <attvalue for="0" value="high angle boundaries" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="大角度晶界（high angle boundaries）是一种微观结构特征，指多晶材料中取向差较大的相邻晶粒间的界面。该区域常呈现“脊状”形貌，并作为关键的扩散通道，例如，Al3+阳离子会沿其进行快速扩散。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-455a426fd56bc0498536fbbc0427ca38" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;high angle boundaries (HAB)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-455a426fd56bc0498536fbbc0427ca38-e-4&quot;, &quot;chunk-569a3d8aec20d9df6a256b4cf4b263a7-e-15&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-455a426fd56bc0498536fbbc0427ca38-e-6" label="low-angle grain boundaries">
        <attvalues>
          <attvalue for="0" value="low-angle grain boundaries" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="小角度晶界（low angle grain boundaries）是一种微观结构特征，指相邻晶粒间晶体学取向差极小（通常小于15°）的界面。在单晶高温合金等材料中，它被视为一种缺陷，会成为应力集中点和裂纹萌生源，从而对材料的蠕变断裂性能和寿命产生关键影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-455a426fd56bc0498536fbbc0427ca38" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Low angle boundaries&quot;, &quot;low angle grain boundaries&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-455a426fd56bc0498536fbbc0427ca38-e-6&quot;, &quot;chunk-98dc45a2c81a5783151664ba74c4681e-e-8&quot;, &quot;chunk-d9d581e86b96c92ccf2b9c353b4e4e11-e-6&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-455a426fd56bc0498536fbbc0427ca38-e-9" label="Zr-doped NiAl">
        <attvalues>
          <attvalue for="0" value="Zr-doped NiAl" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="掺锆镍铝(Zr-doped NiAl)是一种通过向镍铝(NiAl)金属间化合物基体中掺杂锆(Zr)元素而形成的改性合金。此方法旨在改善材料的机械性能，例如提高其室温延展性与高温强度，以克服NiAl固有的脆性问题。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-455a426fd56bc0498536fbbc0427ca38" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="322" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-b97c646fdd3d882523c919f4eb1503cb-e-1" label="Zr-doped NiAl">
        <attvalues>
          <attvalue for="0" value="Zr-doped NiAl" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="Zr-doped NiAl是一种锆掺杂的镍铝金属间化合物。根据Prescott等人的研究，该材料在1200 °C下，使用¹⁶O₂和¹⁸O₂同位素进行氧化处理，以分析其高温氧化机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-b97c646fdd3d882523c919f4eb1503cb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-b97c646fdd3d882523c919f4eb1503cb-e-2" label="16O2">
        <attvalues>
          <attvalue for="0" value="16O2" />
          <attvalue for="1" value="Oxidizing Agent" />
          <attvalue for="2" value="一种由氧最常见的稳定同位素¹⁶O构成的氧气分子(O₂)。作为一种氧化剂，它在特定实验中被用作反应物，使锆掺杂的镍铝合金（Zr-doped NiAl）发生氧化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-b97c646fdd3d882523c919f4eb1503cb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b97c646fdd3d882523c919f4eb1503cb-e-3" label="18O2">
        <attvalues>
          <attvalue for="0" value="18O2" />
          <attvalue for="1" value="Oxidizing Agent" />
          <attvalue for="2" value="18O2是由稳定重氧同位素¹⁸O构成的氧气分子，是一种氧化剂。因其原子质量可区分，常在科学实验中作为同位素示踪剂，用于标记和研究材料氧化等化学反应的微观机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-b97c646fdd3d882523c919f4eb1503cb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b97c646fdd3d882523c919f4eb1503cb-e-4" label="1200 °C">
        <attvalues>
          <attvalue for="0" value="1200 °C" />
          <attvalue for="1" value="Temperature" />
          <attvalue for="2" value="1200 °C是一个特定的实验温度，在该温度条件下，对锆掺杂镍铝化物（Zr-doped NiAl）进行了氧化处理。它是研究该材料氧化行为的一个关键热力学参数。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;1200&quot;, &quot;unit&quot;: &quot;°C&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-b97c646fdd3d882523c919f4eb1503cb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b97c646fdd3d882523c919f4eb1503cb-e-6" label="Secondary Ion Mass Spectrometry (SIMS)">
        <attvalues>
          <attvalue for="0" value="Secondary Ion Mass Spectrometry (SIMS)" />
          <attvalue for="1" value="Analysis Technique" />
          <attvalue for="2" value="二次离子质谱（Secondary Ion Mass Spectrometry, SIMS）是一种高灵敏度的表面分析技术。它通过聚焦的初级离子束轰击样品表面，并对溅射出的次级离子进行质谱分析，从而确定样品表面及近表层的元素、同位素和分子组成信息。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-b97c646fdd3d882523c919f4eb1503cb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;SIMS&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b97c646fdd3d882523c919f4eb1503cb-e-6&quot;, &quot;chunk-cd90df188efe63a1aba2d62ab225c3ae-e-16&quot;]}]" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-b97c646fdd3d882523c919f4eb1503cb-e-7" label="0-Al2O3">
        <attvalues>
          <attvalue for="0" value="0-Al2O3" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="0-Al2O3是一种未转变的氧化铝(Al2O3)材料相。其特点是富含¹⁸O同位素，并通过二次离子质谱法(SIMS)技术对其进行深度剖面分析，以研究其成分分布。" />
          <attvalue for="3" value="{&quot;state&quot;: &quot;untransformed&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-b97c646fdd3d882523c919f4eb1503cb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b97c646fdd3d882523c919f4eb1503cb-e-9" label="18O">
        <attvalues>
          <attvalue for="0" value="18O" />
          <attvalue for="1" value="Isotope" />
          <attvalue for="2" value="氧-18（¹⁸O）是氧元素的一种稳定重同位素，其原子核由8个质子和10个中子构成。它在自然界中含量稀少，因其质量特性被广泛用作示踪剂，以研究水文循环、古气候变化及材料科学中的物理化学过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-b97c646fdd3d882523c919f4eb1503cb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b97c646fdd3d882523c919f4eb1503cb-e-10" label="16O">
        <attvalues>
          <attvalue for="0" value="16O" />
          <attvalue for="1" value="Isotope" />
          <attvalue for="2" value="氧-16 (¹⁶O) 是氧元素最常见且最丰富的稳定同位素，约占自然界氧总量的99.76%。在稳定同位素分析中，其丰度常作为基准，与较重的氧-18 (¹⁸O) 进行比较，二者的比值是古气候学、水文学等领域的重要指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-b97c646fdd3d882523c919f4eb1503cb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b97c646fdd3d882523c919f4eb1503cb-e-10&quot;, &quot;chunk-3de7fb49bbb1a56b800f051f299d5884-e-2&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3de7fb49bbb1a56b800f051f299d5884-e-1" label="18O signal">
        <attvalues>
          <attvalue for="0" value="18O signal" />
          <attvalue for="1" value="Isotopic Signal" />
          <attvalue for="2" value="¹⁸O信号指稳定同位素氧-18（¹⁸O）丰度的测量指标，常与更常见的氧-16（¹⁶O）进行比较。在特定深度，当¹⁸O信号高于¹⁶O信号时，表明重同位素¹⁸O的相对富集。这一同位素比率是古气候学等领域重建古温度和水循环变化的关键代用指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-3de7fb49bbb1a56b800f051f299d5884" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3de7fb49bbb1a56b800f051f299d5884-e-3" label="Zr signal">
        <attvalues>
          <attvalue for="0" value="Zr signal" />
          <attvalue for="1" value="Elemental Signal" />
          <attvalue for="2" value="一种代表锆（Zr）元素的分析信号，用于表征其浓度与分布。在特定材料分析中，该信号在氧化物/氧化皮界面处的强度达到峰值，通常表明锆在该位置富集。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-3de7fb49bbb1a56b800f051f299d5884" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="205" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3de7fb49bbb1a56b800f051f299d5884-e-4" label="Oxide/scale interface">
        <attvalues>
          <attvalue for="0" value="Oxide/scale interface" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="氧化物/氧化皮界面 (oxide/scale interface)&#10;&#10;指覆盖在材料表面的氧化物或氧化皮层与内部基体材料之间的边界区域。在特定分析中，该界面的精确位置由锆(Zr)元素信号强度达到峰值的点来定义，表明该处锆元素富集。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-3de7fb49bbb1a56b800f051f299d5884" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;oxide/scale interface&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3de7fb49bbb1a56b800f051f299d5884-e-4&quot;]}]" />
          <attvalue for="9" value="205" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3de7fb49bbb1a56b800f051f299d5884-e-6" label="O²- anion transport">
        <attvalues>
          <attvalue for="0" value="O²- anion transport" />
          <attvalue for="1" value="Transport Mechanism" />
          <attvalue for="2" value="一种传输机制，指氧阴离子(O²⁻)向内移动的过程。该过程是α-Al₂O₃（氧化铝）生长的关键环节，通常沿材料的晶界进行，是晶界传输的一种主要形式。" />
          <attvalue for="3" value="{&quot;direction&quot;: &quot;inwards&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-3de7fb49bbb1a56b800f051f299d5884" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3de7fb49bbb1a56b800f051f299d5884-e-7" label="ridged morphology">
        <attvalues>
          <attvalue for="0" value="ridged morphology" />
          <attvalue for="1" value="Surface Feature" />
          <attvalue for="2" value="**脊状形貌 (Ridged morphology)**&#10;&#10;一种在化学气相沉积（CVD）过程中形成的表面特征。其形貌呈现为高低起伏的脊状或棱状结构，通常被视为一种工艺缺陷，可通过后续的抛光工序将其去除。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-3de7fb49bbb1a56b800f051f299d5884" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Ridged morphology&quot;, &quot;ridged surface morphology&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3de7fb49bbb1a56b800f051f299d5884-e-7&quot;, &quot;chunk-56221da56587b6ebb1c6eef7e8ed2a6e-e-5&quot;, &quot;chunk-8e4f95988fb5d512b274348d9b3d4dca-e-6&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-3de7fb49bbb1a56b800f051f299d5884-e-8" label="Al³+ cation transport">
        <attvalues>
          <attvalue for="0" value="Al³+ cation transport" />
          <attvalue for="1" value="Transport Mechanism" />
          <attvalue for="2" value="一种晶界输运机制，指Al³+阳离子（铝离子）沿材料晶界迁移，从而驱动α-氧化铝（α-Al₂O₃）晶粒生长的过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-3de7fb49bbb1a56b800f051f299d5884" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3de7fb49bbb1a56b800f051f299d5884-e-9" label="grain-boundary transport">
        <attvalues>
          <attvalue for="0" value="grain-boundary transport" />
          <attvalue for="1" value="Transport Pathway" />
          <attvalue for="2" value="晶界输运是一种发生在多晶材料中的物质迁移路径。它是指原子、离子等粒子沿着晶体颗粒间的界面（晶界）进行的扩散过程。由于晶界结构较为疏松，常作为高扩散率通道，在材料生长和烧结等现象中起关键作用，例如构成α-Al₂O₃生长时Al³⁺阳离子与O²⁻阴离子的主要混合输运路径。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-3de7fb49bbb1a56b800f051f299d5884" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7638042a561888cfdce1fb2ee9ad0428-e-2" label="O²- anion">
        <attvalues>
          <attvalue for="0" value="O²- anion" />
          <attvalue for="1" value="Ion" />
          <attvalue for="2" value="氧化物离子（O²⁻ anion）是氧原子获得两个电子后形成的阴离子，带有-2电荷。在固体材料中，它是一种关键的电荷载体，其在晶界等微观结构中的输运行为，对材料的离子电导率和整体性能有重要影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-7638042a561888cfdce1fb2ee9ad0428" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7638042a561888cfdce1fb2ee9ad0428-e-10" label="Columnar morphology">
        <attvalues>
          <attvalue for="0" value="Columnar morphology" />
          <attvalue for="1" value="Morphology" />
          <attvalue for="2" value="一种在厚氧化皮中常见的微观结构形貌。其特征是氧化物晶粒沿垂直于基体的方向生长，形成彼此平行、类似柱子或圆柱的阵列。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-7638042a561888cfdce1fb2ee9ad0428" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7638042a561888cfdce1fb2ee9ad0428-e-10&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7638042a561888cfdce1fb2ee9ad0428-e-12" label="Dynamic segregation theory">
        <attvalues>
          <attvalue for="0" value="Dynamic segregation theory" />
          <attvalue for="1" value="Theory" />
          <attvalue for="2" value="动态偏析理论是一种材料科学理论，它阐述了活性元素（REs）在材料中受热力学和动力学共同驱动，动态地迁移并最终在晶界、相界等缺陷处聚集（即偏析）的物理过程和机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-7638042a561888cfdce1fb2ee9ad0428" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4e1df0fa0fa7afa66a5ee088dbcbc837-e-1" label="REs">
        <attvalues>
          <attvalue for="0" value="REs" />
          <attvalue for="1" value="Chemical Element Group" />
          <attvalue for="2" value="稀土元素 (REs) 是一组化学元素的统称。它们常在材料共掺杂中用作掺杂剂，能够产生协同效应以改善材料性能，其溶解度是影响该过程效果的关键性质之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-4e1df0fa0fa7afa66a5ee088dbcbc837" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4e1df0fa0fa7afa66a5ee088dbcbc837-e-1&quot;, &quot;chunk-dbe450c14d87c9df145aceea4a48b35c-e-1&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-4e1df0fa0fa7afa66a5ee088dbcbc837-e-5" label="Oxygen">
        <attvalues>
          <attvalue for="0" value="Oxygen" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="氧（Oxygen）是一种化学元素，符号为O，原子序数为8。作为一种高活性非金属，它为大多数生物呼吸所必需。在冶金等工业过程中，它常作为有害的气体或杂质存在于材料中，其含量需要被严格控制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-4e1df0fa0fa7afa66a5ee088dbcbc837" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;oxygen&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4e1df0fa0fa7afa66a5ee088dbcbc837-e-5&quot;, &quot;chunk-1522e93c065590bf976748cff2b67e57-e-12&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4e1df0fa0fa7afa66a5ee088dbcbc837-e-6" label="Rare-earth oxides">
        <attvalues>
          <attvalue for="0" value="Rare-earth oxides" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="稀土氧化物是稀土元素与氧形成的化合物的总称，化学通式通常为RE₂O₃。它们是化学性质稳定的陶瓷状固体，具有高熔点和优异的光、电、磁性能，作为一类重要的功能材料，被广泛应用于冶金、石化、玻璃陶瓷和发光材料等领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-4e1df0fa0fa7afa66a5ee088dbcbc837" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="206" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4e1df0fa0fa7afa66a5ee088dbcbc837-e-7" label="Scale/gas interface">
        <attvalues>
          <attvalue for="0" value="Scale/gas interface" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="指材料表面的固态氧化皮（Scale）与周围气体（Gas）环境接触的物理界面。在高温氧化等化学过程中，它是反应物输运和发生反应的关键场所，例如是稀土氧化物的形成位置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-4e1df0fa0fa7afa66a5ee088dbcbc837" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4e1df0fa0fa7afa66a5ee088dbcbc837-e-7&quot;]}]" />
          <attvalue for="9" value="206" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0e56d036a3d2e550af5ea66665ba607a-e-2" label="NiAl">
        <attvalues>
          <attvalue for="0" value="NiAl" />
          <attvalue for="1" value="Substrate Material" />
          <attvalue for="2" value="镍铝化物（NiAl），一种由镍和铝构成的金属间化合物，常用作高温基底材料。它通过在表面生成三氧化二铝（Al2O3）保护层来抵抗氧化，但该氧化层易发生剥落。β-NiAl是其重要的物相之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-0e56d036a3d2e550af5ea66665ba607a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0e56d036a3d2e550af5ea66665ba607a-e-3" label="Interfacial voids">
        <attvalues>
          <attvalue for="0" value="Interfacial voids" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="一种因柯肯达尔效应在氧化膜/金属界面处形成的冶金缺陷。这些空洞会降低界面结合强度，是导致Al2O3氧化膜从NiAl基体上剥落的主要机制。添加活性元素（RE）可以有效抑制其形成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-0e56d036a3d2e550af5ea66665ba607a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0e56d036a3d2e550af5ea66665ba607a-e-3&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0e56d036a3d2e550af5ea66665ba607a-e-4" label="Kirkendall effect">
        <attvalues>
          <attvalue for="0" value="Kirkendall effect" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="柯肯达尔效应是一种物理机制，指在扩散偶中，两种不同物质的原子扩散速率不相等，导致空位（Vacancies）向扩散较快的一侧净流动并聚集，最终在界面处形成柯肯达尔空洞（Kirkendall Voids）的现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0e56d036a3d2e550af5ea66665ba607a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Kirkendall voiding&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-04f7985cbfd683d851bd2e54d7fa0470-e-4&quot;, &quot;chunk-0e56d036a3d2e550af5ea66665ba607a-e-4&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-dceb4b755a836df5a6b40aba440100ba-e-4" label="Hafnium-doped NiAl">
        <attvalues>
          <attvalue for="0" value="Hafnium-doped NiAl" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="掺铪镍铝（Hafnium-doped NiAl）是一种通过向镍铝（NiAl）金属间化合物中添加铪（Hafnium）作为掺杂剂而改性的材料。它能在高温下形成一层生长缓慢且附着力强的保护性氧化膜，从而显著提高其高温抗氧化性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-dceb4b755a836df5a6b40aba440100ba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-dceb4b755a836df5a6b40aba440100ba-e-7" label="Aluminum Concentration">
        <attvalues>
          <attvalue for="0" value="Aluminum Concentration" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种材料属性，指镍铝(NiAl)合金中铝的原子百分比含量。该浓度是决定Ni3Al相形成的关键因素，并进而影响材料的剥落性能。" />
          <attvalue for="3" value="{&quot;threshold&quot;: &quot;&lt; ~40at%&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-dceb4b755a836df5a6b40aba440100ba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bc88baa62dfcfaa0545bb367cad979a7-e-1" label="NiAl">
        <attvalues>
          <attvalue for="0" value="NiAl" />
          <attvalue for="1" value="Substrate" />
          <attvalue for="2" value="NiAl是一种镍铝金属间化合物基材。它通过在表面形成一层生长缓慢且附着性好的保护性氧化铝膜，从而表现出优异的抗氧化性。掺杂铪(Hf)可显著增强此性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-bc88baa62dfcfaa0545bb367cad979a7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-bc88baa62dfcfaa0545bb367cad979a7-e-9" label="Synergistic Effect">
        <attvalues>
          <attvalue for="0" value="Synergistic Effect" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="协同效应是一种现象，指将两种或多种稀土元素作为共掺杂剂引入材料时，其共同作用产生的整体效果（如发光增强）显著优于各元素单独掺杂时效果的简单加和。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-bc88baa62dfcfaa0545bb367cad979a7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dbe450c14d87c9df145aceea4a48b35c-e-5" label="β–NiAl diffusion coatings">
        <attvalues>
          <attvalue for="0" value="β–NiAl diffusion coatings" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="β–NiAl扩散涂层是一种基于β-NiAl金属间化合物的防护涂层。通过添加镧(La)、钇(Y)、锆(Zr)等活性元素可提升其性能，其中，锆(Zr)的强化效果显著优于镧和钇。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-dbe450c14d87c9df145aceea4a48b35c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-dbe450c14d87c9df145aceea4a48b35c-e-6" label="MCrAlY overlay coatings">
        <attvalues>
          <attvalue for="0" value="MCrAlY overlay coatings" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="MCrAlY覆层涂层是一种高温防护涂层，主要由M（镍、钴或其合金）、铬（Cr）、铝（Al）、钇（Y）组成。它通过在高温下形成稳定的氧化铝保护膜，为基材提供抗氧化与抗腐蚀保护。添加钇（Y）、镧（La）等活性元素可显著提升保护膜的附着力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-dbe450c14d87c9df145aceea4a48b35c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-dbe450c14d87c9df145aceea4a48b35c-e-7" label="Solubility">
        <attvalues>
          <attvalue for="0" value="Solubility" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="溶解度是一种物质属性，指一种物质（溶质）在特定溶剂中溶解以形成均匀溶液的能力。作为一项关键的物理化学性质，它直接影响组分（如稀土元素）在涂层等材料中的分散效果和均匀性，从而决定其最终的宏观性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-dbe450c14d87c9df145aceea4a48b35c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dbe450c14d87c9df145aceea4a48b35c-e-9" label="Diffusion Barrier">
        <attvalues>
          <attvalue for="0" value="Diffusion Barrier" />
          <attvalue for="1" value="Functional Role" />
          <attvalue for="2" value="扩散阻挡层是一种功能性角色，通常指一层置于不同材料之间的薄膜，用以阻止或减缓原子、离子的相互扩散，从而提高多层结构器件（如集成电路）的稳定性与可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-dbe450c14d87c9df145aceea4a48b35c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2a84c8f3deba57fec16eeb3e18ab4ff5-e-3" label="RE">
        <attvalues>
          <attvalue for="0" value="RE" />
          <attvalue for="1" value="Element Category" />
          <attvalue for="2" value="RE是“活性元素”（Reactive Element）的缩写，一个用于化学元素的分类。该类别指化学性质活泼、易于发生化学反应的元素，与铂（Pt）等化学性质稳定的惰性元素相对。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-2a84c8f3deba57fec16eeb3e18ab4ff5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2a84c8f3deba57fec16eeb3e18ab4ff5-e-5" label="NiAl">
        <attvalues>
          <attvalue for="0" value="NiAl" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="NiAl是一种近化学计量的镍铝金属间化合物，具有优异的高温抗氧化性能。通过添加铂(Pt)、铪(Hf)等活性元素可进一步改善其氧化皮附着力，常被用作航空发动机涡轮叶片等高温部件的防护涂层材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2a84c8f3deba57fec16eeb3e18ab4ff5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2a84c8f3deba57fec16eeb3e18ab4ff5-e-6" label="Ni-Al-Pt alloys">
        <attvalues>
          <attvalue for="0" value="Ni-Al-Pt alloys" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="一种由镍（Ni）、铝（Al）和铂（Pt）为主要元素构成的三元合金。因其优异的高温抗氧化性能而成为近期科学研究的热点，常被用作航空发动机涡轮叶片等高温部件的防护涂层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-2a84c8f3deba57fec16eeb3e18ab4ff5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="207" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2a84c8f3deba57fec16eeb3e18ab4ff5-e-7" label="Recent studies">
        <attvalues>
          <attvalue for="0" value="Recent studies" />
          <attvalue for="1" value="Research Activity" />
          <attvalue for="2" value="指近期进行的一系列科学研究，专注于系统性地探讨三元镍铝铂（Ni-Al-Pt）合金的氧化行为，即其在特定环境下的化学反应过程与性能变化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-2a84c8f3deba57fec16eeb3e18ab4ff5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="207" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-306c5bd949573532d99c69946ae2e6b5-e-1" label="Ternary Ni-Al-Pt alloys">
        <attvalues>
          <attvalue for="0" value="Ternary Ni-Al-Pt alloys" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="一种主要由镍(Ni)、铝(Al)和铂(Pt)三种金属元素构成的三元合金体系。该材料类别涵盖了这三种元素在不同原子配比下的多种具体合金。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-306c5bd949573532d99c69946ae2e6b5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-306c5bd949573532d99c69946ae2e6b5-e-2" label="Pure Ni-Al">
        <attvalues>
          <attvalue for="0" value="Pure Ni-Al" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种未添加铂（Pt）的镍铝（Ni-Al）二元合金。在循环氧化研究中，它被用作基准对比材料。其氧化行为的特点是会形成富镍氧化皮，并有潜力生成具有保护性的α-Al2O3氧化皮。" />
          <attvalue for="3" value="{&quot;Al_threshold_for_Al2O3_scale&quot;: &quot;between 40.0 and 42.5 at%Al&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-306c5bd949573532d99c69946ae2e6b5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-306c5bd949573532d99c69946ae2e6b5-e-3" label="Ni-rich scale">
        <attvalues>
          <attvalue for="0" value="Ni-rich scale" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="富镍氧化皮 (Ni-rich scale) 是一种材料相，指在铝含量不足的纯镍铝（Ni-Al）合金表面经高温氧化后形成的、富含镍氧化物的氧化皮层。它的形成通常表明合金未能生成具有更强保护性的富铝氧化皮（如Al₂O₃）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-306c5bd949573532d99c69946ae2e6b5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Ni-rich oxides&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-306c5bd949573532d99c69946ae2e6b5-e-3&quot;, &quot;chunk-8fe8d1c616def00dd2818c380aea80d6-e-2&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-306c5bd949573532d99c69946ae2e6b5-e-5" label="Cyclic oxidation">
        <attvalues>
          <attvalue for="0" value="Cyclic oxidation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="循环氧化是一种高温腐蚀测试方法。它通过反复的加热和冷却循环，来评估材料（尤其是涂层）在热应力下的抗氧化性能和热稳定性。此过程产生的应力可能导致涂层表面出现“皱褶”或“扇形褶皱”等失效现象。" />
          <attvalue for="3" value="{&quot;duration&quot;: &quot;500 h&quot;, &quot;temperature_range&quot;: &quot;between ambient and 1000 °C&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-306c5bd949573532d99c69946ae2e6b5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Cyclic Oxidation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-306c5bd949573532d99c69946ae2e6b5-e-5&quot;, &quot;chunk-0d900d0d4731636b239cbd9f79877db4-e-5&quot;, &quot;chunk-1850c2ae231fdcb9fe7ba03b78412841-e-3&quot;, &quot;chunk-12839dddacb541f1c423c238ab49ba6e-e-2&quot;, &quot;chunk-e039cb317db23e5137b0d2d1164a7ea9-e-6&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-306c5bd949573532d99c69946ae2e6b5-e-7" label="Ni–38.7 at%Al with 5.6 at%Pt">
        <attvalues>
          <attvalue for="0" value="Ni–38.7 at%Al with 5.6 at%Pt" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种特定的镍基三元合金，原子百分比组成为Ni-38.7%Al-5.6%Pt。该合金通过添加铂进行改性，其关键特性是在氧化过程中能够抑制富镍氧化层的形成。" />
          <attvalue for="3" value="{&quot;oxidation_behavior&quot;: &quot;low rates of mass gain&quot;, &quot;scale_formation&quot;: &quot;no Ni-rich scale&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-306c5bd949573532d99c69946ae2e6b5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8fe8d1c616def00dd2818c380aea80d6-e-5" label="Ni–Al–Pt ternary alloys">
        <attvalues>
          <attvalue for="0" value="Ni–Al–Pt ternary alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种由镍(Ni)、铝(Al)和铂(Pt)构成的三元合金材料体系。其关键特性及研究重点在于，铂(Pt)元素的添加会对合金中铝(Al)的行为和性能产生显著影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-8fe8d1c616def00dd2818c380aea80d6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8fe8d1c616def00dd2818c380aea80d6-e-6" label="Gleeson and co-workers">
        <attvalues>
          <attvalue for="0" value="Gleeson and co-workers" />
          <attvalue for="1" value="Research Group" />
          <attvalue for="2" value="由Gleeson领导的一个科研团队。其研究证实了在特定合金中，铂(Pt)对铝(Al)行为具有影响，并报告了铝的扩散现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-8fe8d1c616def00dd2818c380aea80d6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c577786ed818c3adfe9e2cc146b9c0be-e-3" label="Platinum">
        <attvalues>
          <attvalue for="0" value="Platinum" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="铂 (Pt) 是一种化学元素，在材料科学中用作扩散阻挡层。它能有效降低α-Al2O3氧化层的生长速率，并提升其在镍铝(NiAl)合金上的附着力，但效果弱于铪(Hf)。与活性元素(RE)不同，它不改变氧化层形貌，自身也不被归类为活性元素。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;Pt&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c577786ed818c3adfe9e2cc146b9c0be" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Platinum (Pt)&quot;, &quot;Pt&quot;, &quot;platinum&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c577786ed818c3adfe9e2cc146b9c0be-e-3&quot;, &quot;chunk-04a3cb746085dbc29f8c34f061cca5f6-e-4&quot;, &quot;chunk-e039cb317db23e5137b0d2d1164a7ea9-e-12&quot;, &quot;chunk-a921a108c7811dc9a541483523b2c983-e-9&quot;, &quot;chunk-6f03154ca36cf3915a23738d2e17bbfa-e-1&quot;, &quot;chunk-1abe15e2f2db1602f97ac75bb847ef30-e-14&quot;, &quot;chunk-2a84c8f3deba57fec16eeb3e18ab4ff5-e-1&quot;, &quot;chunk-cad1eaa9ffb0e731892120bbe3415da7-e-8&quot;, &quot;chunk-dbe450c14d87c9df145aceea4a48b35c-e-8&quot;, &quot;chunk-cd90df188efe63a1aba2d62ab225c3ae-e-5&quot;, &quot;chunk-e09ab40c542042f5c2612bfc3901180e-e-3&quot;, &quot;chunk-306c5bd949573532d99c69946ae2e6b5-e-6&quot;, &quot;chunk-b740c8122a3674caed65056e75488d1f-e-12&quot;, &quot;chunk-8fe8d1c616def00dd2818c380aea80d6-e-1&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="12" />
        </attvalues>
      </node>
      <node id="chunk-c577786ed818c3adfe9e2cc146b9c0be-e-4" label="B-phase">
        <attvalues>
          <attvalue for="0" value="B-phase" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="B相（B-phase）是一种材料相，特指在材料系统中，因与基体（Substrate）发生相互扩散作用（interdiffusion）而导致其自身被逐渐溶解和消耗的特定物相。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c577786ed818c3adfe9e2cc146b9c0be" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c577786ed818c3adfe9e2cc146b9c0be-e-4&quot;, &quot;chunk-c4027f79a0ee2caae7fc9e91bab6483f-e-4&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c577786ed818c3adfe9e2cc146b9c0be-e-6" label="Voids">
        <attvalues>
          <attvalue for="0" value="Voids" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="一种材料缺陷，指在氧化物与金属的界面处形成的空洞。根据上下文，这类特定空洞的形成可以被铂（Platinum）的引入或改性所抑制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c577786ed818c3adfe9e2cc146b9c0be" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c577786ed818c3adfe9e2cc146b9c0be-e-6&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0d900d0d4731636b239cbd9f79877db4-e-1" label="Gradual surface roughening">
        <attvalues>
          <attvalue for="0" value="Gradual surface roughening" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="渐进表面粗糙化（Gradual surface roughening），又称“皱褶”（rumpling），是一种发生在铝化物粘结层上的表面劣化现象。它在热循环过程中，因氧化物生长应变及热膨胀失配而产生，并对热障涂层（TBC）的服役寿命造成影响。" />
          <attvalue for="3" value="{&quot;synonym&quot;: &quot;rumpling&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-0d900d0d4731636b239cbd9f79877db4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-0d900d0d4731636b239cbd9f79877db4-e-2" label="Aluminide bond coat">
        <attvalues>
          <attvalue for="0" value="Aluminide bond coat" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="铝化物粘结涂层是一种用于热障涂层系统中的关键中间层，通常施加于高温合金基体上。它通过在高温下形成稳定的氧化铝保护膜来抵抗基体氧化，并为陶瓷面层提供附着力。其表面粗糙化是影响涂层寿命的主要退化机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-0d900d0d4731636b239cbd9f79877db4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Aluminide bond coats&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0d900d0d4731636b239cbd9f79877db4-e-2&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0d900d0d4731636b239cbd9f79877db4-e-4" label="TBC life">
        <attvalues>
          <attvalue for="0" value="TBC life" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="热障涂层寿命（TBC life）是一项关键性能指标，指热障涂层从开始服役到因热腐蚀或剥落而失效的持续时间。该寿命会受到涂层渐进的表面粗糙化等因素的显著影响，是评估涂层可靠性与耐久性的核心参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0d900d0d4731636b239cbd9f79877db4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0d900d0d4731636b239cbd9f79877db4-e-7" label="Growth strains in the oxide">
        <attvalues>
          <attvalue for="0" value="Growth strains in the oxide" />
          <attvalue for="1" value="Mechanism" />
          <attvalue for="2" value="氧化物在生长过程中，因体积变化或晶格失配等因素产生的内部应变。这种应变是一种被提出的力学机理，它通过引起材料表面失稳，从而导致氧化层出现“起皱效应”(rumpling)和渐进式的表面粗糙化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-0d900d0d4731636b239cbd9f79877db4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0d900d0d4731636b239cbd9f79877db4-e-7&quot;, &quot;chunk-990ae120c57a6cc7feeb5d1056be0fc9-e-1&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0d900d0d4731636b239cbd9f79877db4-e-8" label="Oxide/metal thermal expansion mismatch">
        <attvalues>
          <attvalue for="0" value="Oxide/metal thermal expansion mismatch" />
          <attvalue for="1" value="Mechanism" />
          <attvalue for="2" value="指氧化物层与金属基体因热膨胀系数不同，在温度变化时产生应力的现象。这种失配应力常与生长应变共同作用，是导致材料表面发生褶皱（rumpling）和渐进式粗糙化的关键机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-0d900d0d4731636b239cbd9f79877db4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0d900d0d4731636b239cbd9f79877db4-e-8&quot;, &quot;chunk-990ae120c57a6cc7feeb5d1056be0fc9-e-2&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-990ae120c57a6cc7feeb5d1056be0fc9-e-3" label="Transformation strains">
        <attvalues>
          <attvalue for="0" value="Transformation strains" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="**相变应变 (Transformation strains)**&#10;&#10;一种物理现象，指材料的B相在发生马氏体相变时所产生的内部应变。这种应变是影响并导致材料表面出现褶皱效应（Rumpling effect）的一个关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-990ae120c57a6cc7feeb5d1056be0fc9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-990ae120c57a6cc7feeb5d1056be0fc9-e-4" label="Martensitic reaction of the B-phase">
        <attvalues>
          <attvalue for="0" value="Martensitic reaction of the B-phase" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="B相（通常为高温母相）发生的一种非扩散型固态相变。它通过原子协同切变转变为马氏体相，此过程伴随着显著的相变应变，是形状记忆效应和超弹性的微观基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-990ae120c57a6cc7feeb5d1056be0fc9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-990ae120c57a6cc7feeb5d1056be0fc9-e-4&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-990ae120c57a6cc7feeb5d1056be0fc9-e-5" label="Rumpling effect">
        <attvalues>
          <attvalue for="0" value="Rumpling effect" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="褶皱机制 (Rumpling mechanism) 是指镍铝涂层在高温环境下发生的一种表面失稳现象。在热循环过程中，因涂层与基体间的热膨胀失配及氧化等因素产生压缩应力，导致涂层表面形成波浪状的宏观褶皱，进而影响其性能和寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-990ae120c57a6cc7feeb5d1056be0fc9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;'Rumpling' / 'Scalloping'&quot;, &quot;Rumpling&quot;, &quot;Rumpling mechanism&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-990ae120c57a6cc7feeb5d1056be0fc9-e-5&quot;, &quot;chunk-ba3c7d1b88adc32b3ab9a1e047094bdc-e-4&quot;, &quot;chunk-dde5366a87c0d6eb632ea242ae19554c-e-3&quot;, &quot;chunk-1850c2ae231fdcb9fe7ba03b78412841-e-2&quot;, &quot;chunk-8a8245180b98739270d9b9b4befedd30-e-12&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="16" />
        </attvalues>
      </node>
      <node id="chunk-990ae120c57a6cc7feeb5d1056be0fc9-e-6" label="Thermal cycling in vacuum">
        <attvalues>
          <attvalue for="0" value="Thermal cycling in vacuum" />
          <attvalue for="1" value="Experimental Condition" />
          <attvalue for="2" value="一种实验条件，指在真空环境中对材料或器件进行周期性的高低温交替处理。该方法用于评估其在热应力下的性能、可靠性和结构稳定性，例如，在此条件下观察到褶皱效应（rumpling effect）的持续存在。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-990ae120c57a6cc7feeb5d1056be0fc9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-990ae120c57a6cc7feeb5d1056be0fc9-e-7" label="Thermal cycling between 1150 °C and 750 °C">
        <attvalues>
          <attvalue for="0" value="Thermal cycling between 1150 °C and 750 °C" />
          <attvalue for="1" value="Experimental Condition" />
          <attvalue for="2" value="一种实验条件，指在1150°C与750°C的温度区间内进行反复加热和冷却的热循环处理。在此特定条件下，“褶皱效应”（rumpling effect）被发现会持续存在。" />
          <attvalue for="3" value="{&quot;upper_temperature&quot;: &quot;1150 °C&quot;, &quot;lower_temperature&quot;: &quot;750 °C&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-990ae120c57a6cc7feeb5d1056be0fc9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ba3c7d1b88adc32b3ab9a1e047094bdc-e-1" label="Cycling">
        <attvalues>
          <attvalue for="0" value="Cycling" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种在真空中进行的热循环工艺，指在两个特定温度之间对材料进行反复加热和冷却。该工艺的特点是，其循环温度的下限高于材料的马氏体相变起始温度。" />
          <attvalue for="3" value="{&quot;upper_temperature&quot;: &quot;1150 °C&quot;, &quot;lower_temperature&quot;: &quot;750 °C&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-ba3c7d1b88adc32b3ab9a1e047094bdc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="113" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ba3c7d1b88adc32b3ab9a1e047094bdc-e-2" label="Vacuum">
        <attvalues>
          <attvalue for="0" value="Vacuum" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="真空是一种物理状态，指特定空间内气体压力远低于一个标准大气压的环境。作为一种重要的工艺条件，它通过排除空气或其他气体来防止氧化和污染，为特定的物理或化学过程（如“循环”过程）创造一个纯净、无干扰的环境。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-ba3c7d1b88adc32b3ab9a1e047094bdc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="113" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ba3c7d1b88adc32b3ab9a1e047094bdc-e-3" label="Martensite start temperature">
        <attvalues>
          <attvalue for="0" value="Martensite start temperature" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="马氏体起始温度（Ms），是一种材料固有的物理性能，指材料在冷却过程中，其内部的奥氏体组织开始向马氏体组织转变的临界温度。它决定了马氏体相变的发生条件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-ba3c7d1b88adc32b3ab9a1e047094bdc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="113" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dde5366a87c0d6eb632ea242ae19554c-e-1" label="Bulk (Ni, Pt)Al alloys">
        <attvalues>
          <attvalue for="0" value="Bulk (Ni, Pt)Al alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种以镍(Ni)、铂(Pt)和铝(Al)为主要成分的块体金属间化合物合金。其化学成分与铂铝(Pt-Al)粘结层相似，但作为一种整体材料，其关键特性在于表面在热循环等条件下不会出现“褶皱效应”(Rumpling effect)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-dde5366a87c0d6eb632ea242ae19554c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dde5366a87c0d6eb632ea242ae19554c-e-1&quot;, &quot;chunk-ba3c7d1b88adc32b3ab9a1e047094bdc-e-7&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-dde5366a87c0d6eb632ea242ae19554c-e-4" label="Superalloy substrate">
        <attvalues>
          <attvalue for="0" value="Superalloy substrate" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种以镍基或钴基高温合金为材料的基底，是热障涂层系统的核心承载部分。它在高温下与上方的金属粘结层（如Pt-Al涂层）发生复杂的物理化学相互作用，这种相互作用是导致涂层表面产生“褶皱效应”的关键原因之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-dde5366a87c0d6eb632ea242ae19554c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-dde5366a87c0d6eb632ea242ae19554c-e-5" label="β → γ' transformation">
        <attvalues>
          <attvalue for="0" value="β → γ' transformation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="β → γ' 相变是一种在渗铝涂层中发生的冶金相变。该过程通过 γ' 相从 β 相基体中析出而实现，是涂层内部结构演变的关键环节。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-dde5366a87c0d6eb632ea242ae19554c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dde5366a87c0d6eb632ea242ae19554c-e-5&quot;, &quot;chunk-1f9144440e619377d400c98debe3a6dc-e-2&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-1f9144440e619377d400c98debe3a6dc-e-4" label="β-grain boundaries">
        <attvalues>
          <attvalue for="0" value="β-grain boundaries" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="存在于铝化物涂层中的一种微观结构特征，是构成该涂层的β晶粒之间的界面（晶界）。在特定条件下，这些晶界是γ'相发生沉淀析出的位置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1f9144440e619377d400c98debe3a6dc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1f9144440e619377d400c98debe3a6dc-e-5" label="Thermal barrier coating (TBC) system">
        <attvalues>
          <attvalue for="0" value="Thermal barrier coating (TBC) system" />
          <attvalue for="1" value="Engineering System" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;热障涂层（TBC）系统是一种应用于高温环境的先进多层材料系统。它通常由陶瓷面层和金属粘结层构成，为航空发动机、燃气轮机等的热端金属部件提供隔热与抗氧化保护，但其性能易受热循环影响而发生失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1f9144440e619377d400c98debe3a6dc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="208" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1f9144440e619377d400c98debe3a6dc-e-6" label="Thermal cycling">
        <attvalues>
          <attvalue for="0" value="Thermal cycling" />
          <attvalue for="1" value="Process Condition" />
          <attvalue for="2" value="热循环 (Thermal cycling) 是指材料或系统在高温和低温之间经历反复温度变化的过程。该过程引起的热应力与热疲劳，是导致热障涂层（TBC）等先进材料系统产生损伤和最终失效的关键机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-1f9144440e619377d400c98debe3a6dc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1f9144440e619377d400c98debe3a6dc-e-6&quot;]}]" />
          <attvalue for="9" value="208" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-81338b3114de6771de08181ee402e596-e-1" label="Delamination">
        <attvalues>
          <attvalue for="0" value="Delamination" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="分层是一种涂层失效模式，指在冷却过程中，发生在结合层与陶瓷顶涂层界面处或其附近的材料分离现象。此现象是导致涂层失效的一种形式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-81338b3114de6771de08181ee402e596" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-81338b3114de6771de08181ee402e596-e-2" label="Bond coat">
        <attvalues>
          <attvalue for="0" value="Bond coat" />
          <attvalue for="1" value="Coating Layer" />
          <attvalue for="2" value="粘结层是一种位于涂层系统基体与陶瓷面层之间的金属或合金涂层。其主要作用是增强面层与基体的结合强度，缓解二者因热膨胀系数不匹配产生的应力，并为基体提供抗氧化和抗腐蚀保护，以提高涂层系统的整体寿命和可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-81338b3114de6771de08181ee402e596" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-81338b3114de6771de08181ee402e596-e-3" label="Ceramic top coat">
        <attvalues>
          <attvalue for="0" value="Ceramic top coat" />
          <attvalue for="1" value="Coating Layer" />
          <attvalue for="2" value="陶瓷顶涂层是一种多层涂层系统（如热障涂层）的关键组成部分。它通常沉积在粘结层之上，两者间形成界面。作为直接暴露于外部环境的最外层，其主要功能是提供优异的隔热、抗磨损以及抗高温氧化和腐蚀性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-81338b3114de6771de08181ee402e596" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-81338b3114de6771de08181ee402e596-e-4" label="Interface">
        <attvalues>
          <attvalue for="0" value="Interface" />
          <attvalue for="1" value="Location" />
          <attvalue for="2" value="指位于粘结层与陶瓷顶涂层之间的边界区域。在材料科学，特别是热障涂层中，该界面是决定涂层结合强度的关键，也是分层失效现象发生的主要位置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-81338b3114de6771de08181ee402e596" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-81338b3114de6771de08181ee402e596-e-5" label="Cooling">
        <attvalues>
          <attvalue for="0" value="Cooling" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="**标准化描述:**&#10;指材料在降温过程中，因热应力等因素导致其内部结构或层间发生分离（即分层）的物理过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-81338b3114de6771de08181ee402e596" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;cooling&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-81338b3114de6771de08181ee402e596-e-5&quot;, &quot;chunk-3b4a29632c8b1d02d0265d40c4880791-e-4&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-81338b3114de6771de08181ee402e596-e-6" label="Ambient conditions">
        <attvalues>
          <attvalue for="0" value="Ambient conditions" />
          <attvalue for="1" value="State" />
          <attvalue for="2" value="指物体在冷却过程后达到的、与周围环境（通常为室温和常压）相平衡的状态。在此状态下，材料可能因内应力释放而发生分层等现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-81338b3114de6771de08181ee402e596" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4f1eb842a2e3520e40274bedacb6597f-e-1" label="Delamination">
        <attvalues>
          <attvalue for="0" value="Delamination" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="分层（Delamination）是一种材料失效机制，指层状复合材料的相邻铺层之间发生分离。该现象通常由温度梯度和材料各组分间热膨胀系数的差异共同驱动，由此产生的热应力是导致分层的根本原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-4f1eb842a2e3520e40274bedacb6597f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-4f1eb842a2e3520e40274bedacb6597f-e-5" label="Superalloy substrate">
        <attvalues>
          <attvalue for="0" value="Superalloy substrate" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="一种由镍基、钴基等高温合金制成的基体部件，常用于航空发动机等严苛环境中，为热障涂层等功能层提供结构支撑。其热膨胀系数是核心设计参数，与涂层等材料的系数差异是决定整个材料系统热机械稳定性和服役寿命的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-4f1eb842a2e3520e40274bedacb6597f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4f1eb842a2e3520e40274bedacb6597f-e-6" label="Bond coat">
        <attvalues>
          <attvalue for="0" value="Bond coat" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="一种应用于热障涂层系统中的金属中间层，位于陶瓷顶涂层与金属基材之间。它不仅能增强涂层与基材的结合力，还能作为过渡层，缓解两者因热膨胀系数差异产生的应力，并保护基材免受高温氧化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-4f1eb842a2e3520e40274bedacb6597f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4f1eb842a2e3520e40274bedacb6597f-e-7" label="Ceramic top coat">
        <attvalues>
          <attvalue for="0" value="Ceramic top coat" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="一种作为材料系统组成部分的陶瓷涂层，通常覆盖在最外层。其关键特性是具有与系统内其他组分不同的热膨胀系数，这种差异对材料系统的热机械性能和结构完整性有重要影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-4f1eb842a2e3520e40274bedacb6597f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4f1eb842a2e3520e40274bedacb6597f-e-8" label="Degradation mechanisms">
        <attvalues>
          <attvalue for="0" value="Degradation mechanisms" />
          <attvalue for="1" value="Failure Process" />
          <attvalue for="2" value="指在热循环等外部应力作用下，导致材料或系统性能发生不可逆、渐进性劣化的一系列物理与化学过程。这些过程是引发组件或设备最终失效的根本原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-4f1eb842a2e3520e40274bedacb6597f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4f1eb842a2e3520e40274bedacb6597f-e-8&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-86085af24c3d22aa7ef748be1713da2e-e-1" label="Degradation mechanisms">
        <attvalues>
          <attvalue for="0" value="Degradation mechanisms" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="指导致热障涂层（TBC）在服役过程中性能逐渐劣化、损伤累积并最终失效的一系列物理与化学作用机制。这些机制的发生与发展是涂层失效的根本原因和必要前提。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-86085af24c3d22aa7ef748be1713da2e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-86085af24c3d22aa7ef748be1713da2e-e-2" label="TBC failure">
        <attvalues>
          <attvalue for="0" value="TBC failure" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="指热障涂层（TBC）在经历一系列退化机制后，由特定失效条件触发的最终功能丧失事件。该事件标志着涂层隔热保护能力的终结，常表现为涂层剥落。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-86085af24c3d22aa7ef748be1713da2e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-86085af24c3d22aa7ef748be1713da2e-e-3" label="Failure conditions">
        <attvalues>
          <attvalue for="0" value="Failure conditions" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="指燃气轮机中导致热障涂层（TBC）失效的一系列关键工况。这些工况（如温度梯度、循环时间）因其复杂性，通常难以在实验室环境中被精确复现。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-86085af24c3d22aa7ef748be1713da2e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-86085af24c3d22aa7ef748be1713da2e-e-5" label="Cycling times">
        <attvalues>
          <attvalue for="0" value="Cycling times" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="指燃气轮机的一种故障工况，表示设备经历的启动、运行至停机完整循环的次数。由于频繁启停会造成严重的热应力和机械疲劳，因此过多的循环次数是预测和评估燃气轮机部件寿命及潜在失效风险的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-86085af24c3d22aa7ef748be1713da2e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-86085af24c3d22aa7ef748be1713da2e-e-6" label="Gas turbine">
        <attvalues>
          <attvalue for="0" value="Gas turbine" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="燃气轮机是一种以连续流动的气体为工质的旋转式动力机械。它将燃料的化学能转化为叶轮高速旋转的机械功，主要由压气机、燃烧室和涡轮机组成，广泛应用于发电、航空航天和工业驱动领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-86085af24c3d22aa7ef748be1713da2e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f35df7e25f9cadfabe05aeb0e4fee010-e-2" label="Turbine Engine">
        <attvalues>
          <attvalue for="0" value="Turbine Engine" />
          <attvalue for="1" value="Mechanical System" />
          <attvalue for="2" value="涡轮发动机，又称燃气轮机，是一种将燃料化学能转化为机械功的旋转式内燃机。其在高温环境下运行，关键部件常需热障涂层(TBC)保护，涂层失效会严重威胁其结构完整性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-f35df7e25f9cadfabe05aeb0e4fee010" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f35df7e25f9cadfabe05aeb0e4fee010-e-3" label="TBC life">
        <attvalues>
          <attvalue for="0" value="TBC life" />
          <attvalue for="1" value="System Property" />
          <attvalue for="2" value="热障涂层（TBC）寿命，是衡量其系统可靠性与服役时长的关键性能指标。作为一个系统属性，该寿命高度依赖于整个涂层系统的材料组合（如基体、粘结层、陶瓷层）与制备工艺（如等离子喷涂、EB-PVD）的综合影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-f35df7e25f9cadfabe05aeb0e4fee010" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-f35df7e25f9cadfabe05aeb0e4fee010-e-4" label="Substrate">
        <attvalues>
          <attvalue for="0" value="Substrate" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="作为热障涂层（TBC）的承载基底的材料组件。其物理与化学特性、工作状态是决定TBC系统整体服役寿命、耐久性与可靠性的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f35df7e25f9cadfabe05aeb0e4fee010" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f35df7e25f9cadfabe05aeb0e4fee010-e-5" label="Bond Coat">
        <attvalues>
          <attvalue for="0" value="Bond Coat" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="粘结层（Bond Coat）是热障涂层（TBC）系统中的关键金属涂层，位于陶瓷面层与基体之间。它的主要功能是增强两者附着力，并为基体提供高温抗氧化保护，其性能对TBC的整体服役寿命起决定性作用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-f35df7e25f9cadfabe05aeb0e4fee010" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f35df7e25f9cadfabe05aeb0e4fee010-e-6" label="Ceramic">
        <attvalues>
          <attvalue for="0" value="Ceramic" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="作为热障涂层（TBC）的关键材料组分，其性能、成分和微观结构是决定涂层隔热性能、稳定性及最终服役寿命（TBC life）的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-f35df7e25f9cadfabe05aeb0e4fee010" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f35df7e25f9cadfabe05aeb0e4fee010-e-9" label="TBC Failure">
        <attvalues>
          <attvalue for="0" value="TBC Failure" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="TBC失效，即热障涂层（Thermal Barrier Coating）失效，是一种关键的失效模式。它指涡轮发动机高温部件（如叶片）的保护涂层发生剥落或开裂，导致基体金属过热损伤，从而严重威胁发动机的结构完整性与运行安全。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-f35df7e25f9cadfabe05aeb0e4fee010" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e619cc9d54ad4b2ac97ef772a3ffcd8c-e-1" label="Turbine engine">
        <attvalues>
          <attvalue for="0" value="Turbine engine" />
          <attvalue for="1" value="Mechanical System" />
          <attvalue for="2" value="一种将燃料化学能转化为高温高压燃气动能，并利用燃气驱动涡轮高速旋转以输出推力或轴功率的内燃式热机。因其在极端温度下运行，常使用热障涂层（TBC）等技术来确保结构完整性，广泛应用于航空航天和发电领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-e619cc9d54ad4b2ac97ef772a3ffcd8c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e619cc9d54ad4b2ac97ef772a3ffcd8c-e-3" label="Predictive capability">
        <attvalues>
          <attvalue for="0" value="Predictive capability" />
          <attvalue for="1" value="Engineering Goal" />
          <attvalue for="2" value="Predictive capability是一种工程目标，指通过计算模型和仿真，准确预测热障涂层（TBCs）在实际工作应力下的性能、退化过程及剩余使用寿命的能力。实现该能力对于优化涂层设计、制定维护策略至关重要，从而确保TBCs在高温应用中的潜能得到充分、安全且可靠的利用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-e619cc9d54ad4b2ac97ef772a3ffcd8c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e619cc9d54ad4b2ac97ef772a3ffcd8c-e-4" label="Prime-reliant mode">
        <attvalues>
          <attvalue for="0" value="Prime-reliant mode" />
          <attvalue for="1" value="Operational Mode" />
          <attvalue for="2" value="Prime-reliant mode是一种专为热障涂层（TBC）设计的理想运行模式。该模式旨在充分发挥涂层的全部设计能力，以实现最佳的热防护效果。它与代表临时性或功能受限解决方案的“Band-aid mode”形成鲜明对比，是TBC应用中所追求的目标状态。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-e619cc9d54ad4b2ac97ef772a3ffcd8c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e619cc9d54ad4b2ac97ef772a3ffcd8c-e-5" label="Band-aid mode">
        <attvalues>
          <attvalue for="0" value="Band-aid mode" />
          <attvalue for="1" value="Operational Mode" />
          <attvalue for="2" value="TBC的一种非理想运行模式，通常作为临时应急方案使用。该模式的特点是治标不治本，旨在快速解决表面问题，与更稳定、更受推荐的“prime-reliant”模式形成对比，并非长久之计。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e619cc9d54ad4b2ac97ef772a3ffcd8c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6b3f56bd4325c1b8abc874fe75903d49-e-1" label="chemical factors">
        <attvalues>
          <attvalue for="0" value="chemical factors" />
          <attvalue for="1" value="Causal Factor" />
          <attvalue for="2" value="化学因素是指可导致材料、组件或系统失效的、与化学成分、反应或环境相关的因果因素。它们是失效的前体，在工程和科学分析中，通常需要对这些因素进行识别与量化，以评估风险并预防失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-6b3f56bd4325c1b8abc874fe75903d49" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6b3f56bd4325c1b8abc874fe75903d49-e-2" label="mechanical factors">
        <attvalues>
          <attvalue for="0" value="mechanical factors" />
          <attvalue for="1" value="Causal Factor" />
          <attvalue for="2" value="指导致材料、部件或系统失效的物理性作用因素，如应力、应变、振动、载荷等。这些因素是需要被识别和量化的失效前兆，对其进行分析和控制是预测与预防工程故障的关键。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-6b3f56bd4325c1b8abc874fe75903d49" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6b3f56bd4325c1b8abc874fe75903d49-e-5" label="microstructural degradation effects">
        <attvalues>
          <attvalue for="0" value="microstructural degradation effects" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="在热障涂层（TBC）系统中，材料微观结构因长期处于高温等苛刻环境而发生劣化的现象。这通常涉及陶瓷层烧结、界面氧化等过程，会导致涂层隔热性能下降、产生裂纹，并最终引发剥落失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-6b3f56bd4325c1b8abc874fe75903d49" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6b3f56bd4325c1b8abc874fe75903d49-e-6" label="failure mechanisms">
        <attvalues>
          <attvalue for="0" value="failure mechanisms" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="指在热障涂层（TBC）系统中，导致涂层性能退化、结构损坏直至最终失效的一系列潜在物理或化学过程。这些过程是分析涂层可靠性与预测其服役寿命的基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-6b3f56bd4325c1b8abc874fe75903d49" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b5c5988ef25b1d82cffcb2320a89119f-e-1" label="Ceramic top coat">
        <attvalues>
          <attvalue for="0" value="Ceramic top coat" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="陶瓷面层是热障涂层（TBC）系统中的关键隔热层。它由多孔陶瓷材料构成，在提供高温隔热保护的同时，其结构特性允许氧气渗透，无法阻止氧气的进入。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-b5c5988ef25b1d82cffcb2320a89119f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b5c5988ef25b1d82cffcb2320a89119f-e-2" label="Oxygen">
        <attvalues>
          <attvalue for="0" value="Oxygen" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="氧是一种化学元素（O），作为氧化剂。在特定工况下，它能穿透陶瓷顶涂层，与下方材料发生氧化反应，从而生成一层作为氧化产物的热生长氧化物（TGO）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-b5c5988ef25b1d82cffcb2320a89119f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b5c5988ef25b1d82cffcb2320a89119f-e-4" label="Bond coat">
        <attvalues>
          <attvalue for="0" value="Bond coat" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="粘结层是热障涂层系统中的一个关键功能层，位于陶瓷顶层与金属基体之间。它能增强顶层与基体的结合力，并通过在高温下于其表界面生长出一层致密、稳定的热生长氧化物(TGO)，为基体提供抗氧化保护。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-b5c5988ef25b1d82cffcb2320a89119f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b5c5988ef25b1d82cffcb2320a89119f-e-6" label="Time">
        <attvalues>
          <attvalue for="0" value="Time" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="时间是一种基本的物理量，用于度量事件发生的先后顺序和持续时长。它是国际单位制中的七个基本物理量之一，常作为描述其他物理量如何随之变化的自变量，其标准单位为秒（s）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-b5c5988ef25b1d82cffcb2320a89119f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8ae2a6e700e675a50e2388df07f07883-e-2" label="TBC (Thermal Barrier Coating)">
        <attvalues>
          <attvalue for="0" value="TBC (Thermal Barrier Coating)" />
          <attvalue for="1" value="Coating System" />
          <attvalue for="2" value="热障涂层 (TBC) 是一种应用于高温部件表面的先进涂层系统，旨在提供隔热保护。其性能衰退及最终失效与界面处热生长氧化物 (TGO) 层的增厚密切相关，TGO厚度是衡量其寿命的关键指标。" />
          <attvalue for="3" value="{&quot;failure_condition&quot;: &quot;Usually occurs when TGO thickness reaches 10 µm&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-8ae2a6e700e675a50e2388df07f07883" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8ae2a6e700e675a50e2388df07f07883-e-3" label="Bond Coat">
        <attvalues>
          <attvalue for="0" value="Bond Coat" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="一种用于热障涂层系统中的金属粘结层。它在高温下通过消耗自身的铝形成一层致密的、起保护作用的热生长氧化物（TGO），同时为顶部的陶瓷层提供附着力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-8ae2a6e700e675a50e2388df07f07883" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c4027f79a0ee2caae7fc9e91bab6483f-e-3" label="Substrate">
        <attvalues>
          <attvalue for="0" value="Substrate" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种材料组分。作为涂层的基体，其内部元素会通过相互扩散迁移至涂层中，从而诱发涂层产生相变，具体表现为导致B相溶解并促进y'相的形成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c4027f79a0ee2caae7fc9e91bab6483f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c4027f79a0ee2caae7fc9e91bab6483f-e-5" label="y'">
        <attvalues>
          <attvalue for="0" value="y'" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="y'是一种材料相，其形成是由材料与基体（Substrate）之间发生的原子相互扩散作用所促进或导致的。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c4027f79a0ee2caae7fc9e91bab6483f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c4027f79a0ee2caae7fc9e91bab6483f-e-6" label="Elements not present in the coating">
        <attvalues>
          <attvalue for="0" value="Elements not present in the coating" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种非涂层固有的化学元素。它在高温服役环境下，从基体（Substrate）扩散并迁移至粘结层/热生长氧化物（Bond coat/TGO）界面，其聚集和反应会影响热障涂层（TBC）的整体寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c4027f79a0ee2caae7fc9e91bab6483f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c4027f79a0ee2caae7fc9e91bab6483f-e-8" label="TBC life">
        <attvalues>
          <attvalue for="0" value="TBC life" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="TBC life指热障涂层（Thermal Barrier Coating）在特定工作环境下，能有效维持其隔热保护功能和结构完整性的总时长。该寿命不仅取决于涂层自身，也受到外部环境因素（如涂层中不存在的元素）的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-c4027f79a0ee2caae7fc9e91bab6483f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c4027f79a0ee2caae7fc9e91bab6483f-e-9" label="Thermal stresses">
        <attvalues>
          <attvalue for="0" value="Thermal stresses" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="热应力是当物体因温度变化发生热胀冷缩，但其自由形变受到约束时，于其内部产生的应力。这种约束可来自外部限制，或由材料不同部分（如不同材料间）的热膨胀系数不匹配所引起。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-c4027f79a0ee2caae7fc9e91bab6483f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c4027f79a0ee2caae7fc9e91bab6483f-e-9&quot;, &quot;chunk-c88b048c96dc246f3cddc3e769c47af8-e-3&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c88b048c96dc246f3cddc3e769c47af8-e-2" label="Biaxial in-plane compressive stress">
        <attvalues>
          <attvalue for="0" value="Biaxial in-plane compressive stress" />
          <attvalue for="1" value="Mechanical Stress" />
          <attvalue for="2" value="双轴面内压应力（Biaxial in-plane compressive stress）是一种存在于热生长氧化物（TGO）层中的显著机械应力。它主要由热应力和生长应力共同作用产生，应力值可高达4 GPa，而热循环过程可使其得到释放和降低。" />
          <attvalue for="3" value="{&quot;magnitude&quot;: &quot;approaches 4 GPa&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c88b048c96dc246f3cddc3e769c47af8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;biaxial compressive in-plane stress&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c88b048c96dc246f3cddc3e769c47af8-e-2&quot;, &quot;chunk-3b4a29632c8b1d02d0265d40c4880791-e-1&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-c88b048c96dc246f3cddc3e769c47af8-e-5" label="Mismatch in thermal expansion coefficients">
        <attvalues>
          <attvalue for="0" value="Mismatch in thermal expansion coefficients" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;热膨胀系数是表征物质尺寸随温度变化的物理量。在由不同材料或相组成的复合结构中，各组分热膨胀系数的差异（失配）是导致其在温度变化过程中产生内部残余应力的主要原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c88b048c96dc246f3cddc3e769c47af8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Differing thermal expansion coefficients&quot;, &quot;Mismatch in thermal expansion coefficient&quot;, &quot;Thermal expansion coefficients&quot;, &quot;thermal expansion coefficient difference&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c4027f79a0ee2caae7fc9e91bab6483f-e-10&quot;, &quot;chunk-c88b048c96dc246f3cddc3e769c47af8-e-5&quot;, &quot;chunk-3b4a29632c8b1d02d0265d40c4880791-e-6&quot;, &quot;chunk-e3bf4592567fa4c79f22955763ff9714-e-5&quot;, &quot;chunk-4f1eb842a2e3520e40274bedacb6597f-e-4&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-a489ad53b1434170d93d0b020b96b655-e-2" label="Compressive stress">
        <attvalues>
          <attvalue for="0" value="Compressive stress" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="**压缩应力 (Compressive stress)**&#10;&#10;一种基本的力学性能，指物体受到外部压力作用时，其内部单位面积上所承受的法向力。它会导致材料被压缩、长度缩短，是衡量材料抵抗压缩变形或破坏能力的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a489ad53b1434170d93d0b020b96b655" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Compressive Stress&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a489ad53b1434170d93d0b020b96b655-e-2&quot;, &quot;chunk-93d10ba2903ae8b18e5582634fca4a8c-e-2&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-a489ad53b1434170d93d0b020b96b655-e-3" label="TBC (Thermal Barrier Coating)">
        <attvalues>
          <attvalue for="0" value="TBC (Thermal Barrier Coating)" />
          <attvalue for="1" value="Coating System" />
          <attvalue for="2" value="热障涂层（TBC）是一种先进的涂层体系，应用于高温部件表面起隔热作用。它可通过电子束物理气相沉积（EB-PVD）工艺制备。在热循环工况下，其寿命会逐渐消耗，涂层内的缺陷也会被放大，最终影响其服役可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a489ad53b1434170d93d0b020b96b655" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a489ad53b1434170d93d0b020b96b655-e-6" label="y'">
        <attvalues>
          <attvalue for="0" value="y'" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="y'相是一种材料相，其在热生长氧化物（TGO）层或其附近区域的形成过程，是导致结构缺陷产生的原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a489ad53b1434170d93d0b020b96b655" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a489ad53b1434170d93d0b020b96b655-e-7" label="Chemical reactions">
        <attvalues>
          <attvalue for="0" value="Chemical reactions" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种在材料中生成新物相的化学过程。该过程会产生尖晶石、石榴石等次生相，这些新相的存在通常被视为材料内部的结构缺陷，可能影响其性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a489ad53b1434170d93d0b020b96b655" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a489ad53b1434170d93d0b020b96b655-e-8" label="spinels">
        <attvalues>
          <attvalue for="0" value="spinels" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="尖晶石（spinels）是一种氧化物相。在材料科学领域，特指在NiCrAlY型粘结层等合金于高温环境下氧化时，形成的一类具有特定晶体结构（尖晶石结构）的氧化产物，对涂层性能有重要影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-a489ad53b1434170d93d0b020b96b655" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a489ad53b1434170d93d0b020b96b655-e-8&quot;, &quot;chunk-db78ddbf62abad0b3c908872d469b5fa-e-8&quot;, &quot;chunk-489a70985937a8298a8310efcc20db59-e-1&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-a489ad53b1434170d93d0b020b96b655-e-9" label="garnets">
        <attvalues>
          <attvalue for="0" value="garnets" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="石榴石是一种具有特定立方晶体结构的材料相，通常为一类硅酸盐矿物。在此上下文中，它特指由不期望的化学反应生成、并作为缺陷或夹杂物存在的相，会损害主体材料的完整性或性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-a489ad53b1434170d93d0b020b96b655" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a489ad53b1434170d93d0b020b96b655-e-9&quot;, &quot;chunk-489a70985937a8298a8310efcc20db59-e-4&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a489ad53b1434170d93d0b020b96b655-e-11" label="Undulations">
        <attvalues>
          <attvalue for="0" value="Undulations" />
          <attvalue for="1" value="Surface Feature" />
          <attvalue for="2" value="在采用电子束物理气相沉积(EB-PVD)工艺制备的热障涂层(TBC)中，其热生长氧化物(TGO)层上随时间演化而形成的波浪状表面形貌。这种起伏是影响涂层性能和寿命的关键微观结构特征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-a489ad53b1434170d93d0b020b96b655" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;undulations&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a489ad53b1434170d93d0b020b96b655-e-11&quot;, &quot;chunk-047adffb203a8742a16f24b4f8936843-e-4&quot;, &quot;chunk-df31d8a0cc69400a7fd30dcdb24ab502-e-8&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a489ad53b1434170d93d0b020b96b655-e-12" label="Processing-related variations in thickness">
        <attvalues>
          <attvalue for="0" value="Processing-related variations in thickness" />
          <attvalue for="1" value="Process Flaw" />
          <attvalue for="2" value="一种工艺缺陷，指在制造过程中，涂层（尤其在热生长氧化物层TGO附近）的厚度呈现不均匀的变化。这种非均匀性是导致该区域产生应力集中并引发其它结构缺陷的直接原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-a489ad53b1434170d93d0b020b96b655" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-047adffb203a8742a16f24b4f8936843-e-1" label="TBCs">
        <attvalues>
          <attvalue for="0" value="TBCs" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="热障涂层（Thermal Barrier Coatings, TBCs）是一种先进的材料系统，通常涂覆在金属基体表面，用于在高温环境下提供隔热保护，以降低基体温度、延长部件寿命。该涂层系统常采用电子束物理气相沉积（EB-PVD）或等离子喷涂（PS）等技术制备。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-047adffb203a8742a16f24b4f8936843" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="323" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-047adffb203a8742a16f24b4f8936843-e-5" label="PS">
        <attvalues>
          <attvalue for="0" value="PS" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="PS是一种应用于热障涂层(TBC)的加工方法，其作用是使生成的热生长氧化物(TGO)层具有较高的初始表面粗糙度，从而影响其微观形貌。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-047adffb203a8742a16f24b4f8936843" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-047adffb203a8742a16f24b4f8936843-e-7" label="Imperfections">
        <attvalues>
          <attvalue for="0" value="Imperfections" />
          <attvalue for="1" value="Defect Location" />
          <attvalue for="2" value="指材料内部存在的结构不规则或不连续的物理位置。这些位置通常会引起应力集中，从而成为初始裂纹（incipient cracks）萌生与扩展的形核点。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-047adffb203a8742a16f24b4f8936843" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-047adffb203a8742a16f24b4f8936843-e-7&quot;, &quot;chunk-c9321383d9d47ce5d22357e665813ccd-e-4&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-047adffb203a8742a16f24b4f8936843-e-8" label="Elastic strain energy">
        <attvalues>
          <attvalue for="0" value="Elastic strain energy" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="应变能（strain energy）是物体因弹性变形而储存在其内部的势能，是固体力学中的一个基本物理量。它常被用作材料的失效判据，例如在当前上下文中，它被用来估算热生长氧化物（TGO）层发生脱聚时的临界厚度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-047adffb203a8742a16f24b4f8936843" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;strain energy&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-047adffb203a8742a16f24b4f8936843-e-8&quot;, &quot;chunk-83ca3f8149515d0fbab6094084e6dc12-e-12&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c8784a1621429d74d3f7495ce7649e88-e-2" label="Final failure">
        <attvalues>
          <attvalue for="0" value="Final failure" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="一种结构失效现象。在初始屈曲之后，当裂纹的尺寸足以支持屈曲扩展时，由该扩展过程所导致的最终、彻底的结构性破坏。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c8784a1621429d74d3f7495ce7649e88" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c8784a1621429d74d3f7495ce7649e88-e-3" label="Buckle propagation">
        <attvalues>
          <attvalue for="0" value="Buckle propagation" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="屈曲传播是一种失效模式，指在裂纹扩展至临界尺寸的促进下，结构上产生的局部初始屈曲不断向前传播，是一种渐进式的破坏过程，并最终导致结构发生整体的最终失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c8784a1621429d74d3f7495ce7649e88" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c8784a1621429d74d3f7495ce7649e88-e-4" label="Ceramic layer">
        <attvalues>
          <attvalue for="0" value="Ceramic layer" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="作为一种材料组件，陶瓷层是一种陶瓷薄层，其关键特征是在制造（尤其是在冷却过程）中被置于压缩状态。这种预置的压应力旨在提高该组件的机械强度、断裂韧性及抗热冲击等性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c8784a1621429d74d3f7495ce7649e88" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="209" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c8784a1621429d74d3f7495ce7649e88-e-5" label="Compression">
        <attvalues>
          <attvalue for="0" value="Compression" />
          <attvalue for="1" value="Mechanical State" />
          <attvalue for="2" value="一种力学上的压应力状态，指材料（如陶瓷层）在冷却等工艺后，其内部产生并承受向内挤压的应力，通常用于改善材料的强度和抗断裂性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c8784a1621429d74d3f7495ce7649e88" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c8784a1621429d74d3f7495ce7649e88-e-5&quot;]}]" />
          <attvalue for="9" value="209" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c8784a1621429d74d3f7495ce7649e88-e-6" label="Delaminations of the TBC">
        <attvalues>
          <attvalue for="0" value="Delaminations of the TBC" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="热障涂层分层是一种发生在热障涂层（TBC）中的缺陷，指涂层内部发生的层状分离损伤。该缺陷是结构最终失效的前兆，通常表现为初期屈曲形态。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c8784a1621429d74d3f7495ce7649e88" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c8784a1621429d74d3f7495ce7649e88-e-7" label="Incipient buckles">
        <attvalues>
          <attvalue for="0" value="Incipient buckles" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="早期鼓包（Incipient buckles）是一种热障涂层（TBC）缺陷，特指在涂层发生最终失效前出现的一种早期分层现象。该缺陷的核心特征是其能够以稳定的方式逐步扩展，是涂层退化的前兆。" />
          <attvalue for="3" value="{&quot;growth_behavior&quot;: &quot;stable&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c8784a1621429d74d3f7495ce7649e88" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c8784a1621429d74d3f7495ce7649e88-e-8" label="TBC">
        <attvalues>
          <attvalue for="0" value="TBC" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="TBC，全称热障涂层（Thermal Barrier Coating），是一种应用于高温部件（如航空发动机叶片）表面的先进材料系统。它通过陶瓷层的优异隔热性能，保护内部金属基体免受高温环境的损伤。涂层分层或剥落是其在服役过程中常见的失效形式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-c8784a1621429d74d3f7495ce7649e88" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a7d8669831007c6978b4f97d67359deb-e-2" label="Substrate">
        <attvalues>
          <attvalue for="0" value="Substrate" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="在热障涂层(TBC)系统中，指被涂层覆盖和保护的基底材料或部件。它通常为高温合金，是整个涂层系统赖以附着的结构基础，承受着主要的热和机械载荷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a7d8669831007c6978b4f97d67359deb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a7d8669831007c6978b4f97d67359deb-e-3" label="Bond coat">
        <attvalues>
          <attvalue for="0" value="Bond coat" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="粘结层是热障涂层（TBC）系统中的关键金属层，位于基体与陶瓷面层之间。其主要功能是增强二者的结合强度，保护基体免受高温氧化腐蚀，并缓解因热膨胀系数差异产生的应力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a7d8669831007c6978b4f97d67359deb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a7d8669831007c6978b4f97d67359deb-e-4" label="Top coat">
        <attvalues>
          <attvalue for="0" value="Top coat" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="面涂层是热障涂层（TBC）系统的关键组件，通常是由陶瓷材料构成的最外层。它的主要功能是为底层金属部件提供优异的隔热性能，以抵御高温工作环境的侵蚀，从而延长整个部件的使用寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a7d8669831007c6978b4f97d67359deb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a7d8669831007c6978b4f97d67359deb-e-5" label="Ceramic top coat">
        <attvalues>
          <attvalue for="0" value="Ceramic top coat" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="陶瓷顶涂层是热障涂层（TBC）系统的最外层功能层，由低热导率的陶瓷构成。它直接承受高温环境，为金属基体提供关键的隔热与抗腐蚀保护。常见的制备技术包括等离子喷涂与电子束物理气相沉积（EB-PVD）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a7d8669831007c6978b4f97d67359deb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-411c58f6cae102022f2bf19e1c6ff24d-e-2" label="Strain tolerance">
        <attvalues>
          <attvalue for="0" value="Strain tolerance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="应变容限是某些材料（尤指涂层）的一种优越性能。该性能由材料内部的微裂纹引起，这些微裂纹通过耗散应力、抑制主裂纹扩展，从而使材料在较大变形下仍能保持结构完整性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-411c58f6cae102022f2bf19e1c6ff24d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="114" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-411c58f6cae102022f2bf19e1c6ff24d-e-3" label="Microcracks">
        <attvalues>
          <attvalue for="0" value="Microcracks" />
          <attvalue for="1" value="Material Feature" />
          <attvalue for="2" value="微裂纹是在涂层工艺中形成的一种材料特征。这些微观裂纹结构并非缺陷，而是通过提升材料的整体韧性，从而赋予其优异应变容限的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-411c58f6cae102022f2bf19e1c6ff24d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="114" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-411c58f6cae102022f2bf19e1c6ff24d-e-4" label="Bond coat">
        <attvalues>
          <attvalue for="0" value="Bond coat" />
          <attvalue for="1" value="Coating Layer" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;粘结层是高温防护涂层系统（如热障涂层）中的一个关键中间层。它位于金属基体与功能面层之间，主要作用是提高二者的结合强度，并为基体提供高温抗氧化和抗腐蚀保护。常见的粘结层包括MCrAlY和铝化物涂层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-411c58f6cae102022f2bf19e1c6ff24d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-411c58f6cae102022f2bf19e1c6ff24d-e-5" label="Aluminide">
        <attvalues>
          <attvalue for="0" value="Aluminide" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="铝化物 (Aluminide) 是一种由铝与其它金属元素形成的金属间化合物。它是一种重要的粘结涂层材料，可以通过化学气相沉积 (CVD) 等工艺制备，用于提高基材的抗高温氧化和耐腐蚀性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-411c58f6cae102022f2bf19e1c6ff24d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Aluminides&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-411c58f6cae102022f2bf19e1c6ff24d-e-5&quot;, &quot;chunk-ef56fb2a5c4451551a2024d8490545ff-e-9&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-411c58f6cae102022f2bf19e1c6ff24d-e-7" label="MCrAlY">
        <attvalues>
          <attvalue for="0" value="MCrAlY" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="MCrAlY是一种高温合金涂层材料（M为镍、钴或其组合），通常在热障涂层体系中用作粘结层。其主要功能是在高温环境下提供优异的抗氧化和抗腐蚀性能，以保护基体合金并增强顶涂层的附着力。该材料可通过电子束物理气相沉积（EB-PVD）等工艺制备。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-411c58f6cae102022f2bf19e1c6ff24d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-411c58f6cae102022f2bf19e1c6ff24d-e-10" label="Foreign Object Damage (FOD)">
        <attvalues>
          <attvalue for="0" value="Foreign Object Damage (FOD)" />
          <attvalue for="1" value="Damage Mechanism" />
          <attvalue for="2" value="外来物损伤（Foreign object damage, FOD）是一种损伤机制，指结构因受到外来物体（如沙石、跑道碎屑等空中物质）的物理撞击而产生的损伤。该机制在航空航天领域尤为常见，可导致热障涂层（TBCs）等关键部件的开裂、剥落或失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-411c58f6cae102022f2bf19e1c6ff24d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Foreign object damage (FOD)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-411c58f6cae102022f2bf19e1c6ff24d-e-10&quot;, &quot;chunk-c527d2fb17717642598fb40a49925e7f-e-2&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-411c58f6cae102022f2bf19e1c6ff24d-e-11" label="Airborne matter">
        <attvalues>
          <attvalue for="0" value="Airborne matter" />
          <attvalue for="1" value="Object" />
          <attvalue for="2" value="指悬浮或飞散于空气中的任何外来物体、碎片或物质。在航空等领域，这类物质通过撞击或被吸入设备内部，是造成外来物损伤（Foreign Object Damage, FOD）的直接原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-411c58f6cae102022f2bf19e1c6ff24d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Airborne Matter&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-411c58f6cae102022f2bf19e1c6ff24d-e-11&quot;, &quot;chunk-c527d2fb17717642598fb40a49925e7f-e-3&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-411c58f6cae102022f2bf19e1c6ff24d-e-12" label="Coating process">
        <attvalues>
          <attvalue for="0" value="Coating process" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="涂层工艺是一种在基材表面施加一层特殊材料以形成覆盖层的制造过程，旨在改善工件的防护性、装饰性或功能性。该工艺是产生或引入微裂纹等结构缺陷的潜在来源。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-411c58f6cae102022f2bf19e1c6ff24d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="114" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c527d2fb17717642598fb40a49925e7f-e-4" label="Engine">
        <attvalues>
          <attvalue for="0" value="Engine" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="一种燃气涡轮发动机系统，通过吸入大量空气以产生推力或动力。其运行中吸入的空气悬浮物可导致内部件（如热障涂层）发生外来物损伤（FOD）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c527d2fb17717642598fb40a49925e7f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c527d2fb17717642598fb40a49925e7f-e-5" label="CMAS">
        <attvalues>
          <attvalue for="0" value="CMAS" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="CMAS是由氧化钙（Calcia）、氧化镁（Magnesia）、氧化铝（Alumina）和氧化硅（Silica）组成的混合沉积物的英文缩写。在高温下，它以熔融状态渗透并腐蚀热障涂层（TBCs），通过导致涂层溶解、刚度增加和应变容限降低，最终引发涂层失效。" />
          <attvalue for="3" value="{&quot;composition&quot;: &quot;calcia, magnesia, alumina and silica&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c527d2fb17717642598fb40a49925e7f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c527d2fb17717642598fb40a49925e7f-e-6" label="Vanadium impurities">
        <attvalues>
          <attvalue for="0" value="Vanadium impurities" />
          <attvalue for="1" value="Chemical Impurity" />
          <attvalue for="2" value="钒杂质（Vanadium impurities）是一种存在于煤油等燃料中的化学杂质。它能够从氧化钇稳定氧化锆（YSZ）涂层中浸出钇（Y）元素，这种腐蚀作用会导致热障涂层性能退化和失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c527d2fb17717642598fb40a49925e7f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c527d2fb17717642598fb40a49925e7f-e-9" label="YSZ coating">
        <attvalues>
          <attvalue for="0" value="YSZ coating" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="YSZ涂层，全称氧化钇稳定氧化锆（Yttria-stabilized zirconia）涂层，是一种先进陶瓷涂层。它是在氧化锆（ZrO₂）中掺入氧化钇（Y₂O₃）作为稳定剂，以维持其在高温下的晶体结构稳定。该涂层具有优异的耐高温、抗热震、耐腐蚀和低导热性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-c527d2fb17717642598fb40a49925e7f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c527d2fb17717642598fb40a49925e7f-e-9&quot;, &quot;chunk-897e7353863e7f334da90636833fd561-e-2&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-897e7353863e7f334da90636833fd561-e-3" label="Substrate geometry">
        <attvalues>
          <attvalue for="0" value="Substrate geometry" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="基底几何形状（Substrate geometry）是一项物理属性，指基材的宏观外形、尺寸、曲率及表面粗糙度等几何特征。它通过影响涂层沉积时的应力分布和结合强度，对热障涂层等表面涂层的附着性、性能及服役寿命有重要影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-897e7353863e7f334da90636833fd561" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-897e7353863e7f334da90636833fd561-e-4" label="Local radius of curvature">
        <attvalues>
          <attvalue for="0" value="Local radius of curvature" />
          <attvalue for="1" value="Geometric Property" />
          <attvalue for="2" value="局部曲率半径是衡量材料基底表面在特定点上弯曲程度的几何参数。在热障涂层（TBC）应用中，它是影响涂层寿命的关键几何因素，较小的曲率半径（即更尖锐的表面）通常会导致应力集中，从而缩短涂层的使用寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-897e7353863e7f334da90636833fd561" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-897e7353863e7f334da90636833fd561-e-4&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-897e7353863e7f334da90636833fd561-e-5" label="Testing method">
        <attvalues>
          <attvalue for="0" value="Testing method" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="用于评价热障涂层(TBC)服役寿命的特定规程。其具体的条件和参数，是影响涂层寿命评估结果和准确性的一个关键可变因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-897e7353863e7f334da90636833fd561" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-897e7353863e7f334da90636833fd561-e-8" label="Superalloy">
        <attvalues>
          <attvalue for="0" value="Superalloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="高温合金（Superalloy）是一种能在极高温度下保持优异机械强度、抗蠕变和抗腐蚀性能的金属材料。它通常作为基底，用于制造航空发动机和燃气轮机等核心热端部件，常与热障涂层（TBC）结合使用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-897e7353863e7f334da90636833fd561" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-897e7353863e7f334da90636833fd561-e-9" label="Cylindrical testpieces">
        <attvalues>
          <attvalue for="0" value="Cylindrical testpieces" />
          <attvalue for="1" value="Test Specimen" />
          <attvalue for="2" value="一种用于评估热障涂层(TBCs)寿命的圆柱形标准试件。它在燃烧器试验台上经受高温等模拟工况，其失效数据被用于建立和验证寿命预测模型。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-897e7353863e7f334da90636833fd561" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-5423bf2afd28acca7cc612d33b8885b0-e-1" label="Cylindrical testpieces">
        <attvalues>
          <attvalue for="0" value="Cylindrical testpieces" />
          <attvalue for="1" value="Test Specimen" />
          <attvalue for="2" value="一种圆柱形试件，通常用于燃烧器试验台等设备中，以测试材料在高温、腐蚀等模拟环境下的性能表现。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-5423bf2afd28acca7cc612d33b8885b0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5423bf2afd28acca7cc612d33b8885b0-e-3" label="Full-scale engine ‘type' tests">
        <attvalues>
          <attvalue for="0" value="Full-scale engine ‘type' tests" />
          <attvalue for="1" value="Test Method" />
          <attvalue for="2" value="一种针对新设计的全尺寸发动机进行的定型试验。该试验旨在全面验证发动机在模拟或真实工况下的性能、耐久性和可靠性，确保其满足所有设计规范、安全标准及适航要求。它是发动机获得型号认证、投入批量生产和使用的先决条件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-5423bf2afd28acca7cc612d33b8885b0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="324" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-5423bf2afd28acca7cc612d33b8885b0-e-4" label="Critical thickness of the TGO (δc)">
        <attvalues>
          <attvalue for="0" value="Critical thickness of the TGO (δc)" />
          <attvalue for="1" value="Failure Criterion" />
          <attvalue for="2" value="TGO临界厚度(δc)是判断热障涂层(TBC)失效的工程判据。它定义了热生长氧化物(TGO)层的厚度阈值，当TGO实际厚度达到该值时，即判定TBC失效。此判据常与损伤累积模型（如迈纳定律）结合，通过计算当前厚度(δ)与临界厚度的比值来评估和预测TBC的服役寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-5423bf2afd28acca7cc612d33b8885b0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5423bf2afd28acca7cc612d33b8885b0-e-4&quot;]}]" />
          <attvalue for="9" value="56" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-5423bf2afd28acca7cc612d33b8885b0-e-5" label="TBC failure">
        <attvalues>
          <attvalue for="0" value="TBC failure" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="TBC失效是一种失效模式，指热障涂层（TBC）因其界面处的热生长氧化物（TGO）层不断增厚而发生的剥落或分层。当TGO层厚度达到其临界值（δc）时，失效即发生，该临界厚度是判断TBC失效的关键判据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-5423bf2afd28acca7cc612d33b8885b0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="56" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5423bf2afd28acca7cc612d33b8885b0-e-6" label="Miner's law">
        <attvalues>
          <attvalue for="0" value="Miner's law" />
          <attvalue for="1" value="Engineering Rule" />
          <attvalue for="2" value="迈纳斯定律（Miner's law）是一项工程准则，用于估算变幅载荷下的材料疲劳寿命，也称线性损伤累积法则。在特定应用中，该法则被修改，通过引入热生长氧化物（TGO）的临界厚度（δc）作为关键参数，以预测由该氧化层增长驱动的材料或涂层失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-5423bf2afd28acca7cc612d33b8885b0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="56" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5423bf2afd28acca7cc612d33b8885b0-e-7" label="Sub-critical TGO thickness (δ)">
        <attvalues>
          <attvalue for="0" value="Sub-critical TGO thickness (δ)" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="亚临界热障涂层氧化层厚度（δ）指热障涂层（TBC）在服役过程中，其热生长氧化物（TGO）层尚未达到临界失效厚度（δc）时的瞬时厚度。它是评估涂层损伤和预测寿命的关键参数，其与临界厚度的比值（δ/δc）常用于量化寿命消耗程度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-5423bf2afd28acca7cc612d33b8885b0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5423bf2afd28acca7cc612d33b8885b0-e-7&quot;]}]" />
          <attvalue for="9" value="56" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-5423bf2afd28acca7cc612d33b8885b0-e-8" label="Life consumed">
        <attvalues>
          <attvalue for="0" value="Life consumed" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="已消耗寿命 (Life consumed) 是工程学和材料科学中的一个概念，用于量化材料或结构在循环载荷下累积的疲劳损伤。它通常表示为已用寿命与总寿命的分数或百分比，是预测和评估结构剩余寿命及可靠性的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-5423bf2afd28acca7cc612d33b8885b0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5423bf2afd28acca7cc612d33b8885b0-e-8&quot;, &quot;chunk-72d2b781ce509c8d28bf7d43bac6d2b1-e-1&quot;]}]" />
          <attvalue for="9" value="56" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-72d2b781ce509c8d28bf7d43bac6d2b1-e-2" label="Fracture mechanics">
        <attvalues>
          <attvalue for="0" value="Fracture mechanics" />
          <attvalue for="1" value="Scientific Field" />
          <attvalue for="2" value="断裂力学是固体力学的一个分支，研究材料中裂纹的扩展行为。它通过分析裂纹尖端的应力状态，并结合材料的断裂韧性等参数，来预测含缺陷的构件何时会发生断裂失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-72d2b781ce509c8d28bf7d43bac6d2b1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-72d2b781ce509c8d28bf7d43bac6d2b1-e-3" label="Driving force for interfacial crack growth">
        <attvalues>
          <attvalue for="0" value="Driving force for interfacial crack growth" />
          <attvalue for="1" value="Physical Parameter" />
          <attvalue for="2" value="一个源自断裂力学的物理参数，用于量化驱动不同材料界面处裂纹扩展的能量释放率或应力强度因子，是评估复合结构界面完整性和预测其寿命的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-72d2b781ce509c8d28bf7d43bac6d2b1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-72d2b781ce509c8d28bf7d43bac6d2b1-e-4" label="Interfacial toughness">
        <attvalues>
          <attvalue for="0" value="Interfacial toughness" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="界面韧性是一种材料属性，用于衡量两种不同材料的结合界面抵抗裂纹扩展或分层的能力。它量化了使界面发生断裂所需的能量，是评估复合材料、涂层及粘合结构可靠性的关键力学性能参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-72d2b781ce509c8d28bf7d43bac6d2b1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Interface toughness&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-72d2b781ce509c8d28bf7d43bac6d2b1-e-4&quot;, &quot;chunk-988c4d7fcff0bc412e7695d08b17502d-e-13&quot;]}]" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-72d2b781ce509c8d28bf7d43bac6d2b1-e-5" label="Physically based laws">
        <attvalues>
          <attvalue for="0" value="Physically based laws" />
          <attvalue for="1" value="Model" />
          <attvalue for="2" value="基于物理的定律是一种依据基本物理原理建立的模型，用于模拟和预测材料的失效机制。该模型能够计入微观结构对材料性能和失效行为的影响，从而更精准地揭示材料的损伤演化过程，提高预测的准确性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-72d2b781ce509c8d28bf7d43bac6d2b1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="69" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-72d2b781ce509c8d28bf7d43bac6d2b1-e-6" label="Failure mechanisms">
        <attvalues>
          <attvalue for="0" value="Failure mechanisms" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="失效机制是指导致材料或结构性能退化并最终失效的根本物理过程。其行为和演化可通过基于物理的定律进行建模与预测，并受到微观结构效应的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-72d2b781ce509c8d28bf7d43bac6d2b1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="69" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-72d2b781ce509c8d28bf7d43bac6d2b1-e-8" label="An approach relating a quantity to life consumed">
        <attvalues>
          <attvalue for="0" value="An approach relating a quantity to life consumed" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="一种将特定量值与寿命消耗相关联的寿命评估方法。其核心特征是不基于断裂力学理论，因此在预测时会忽略界面裂纹扩展驱动力及界面韧性等关键断裂参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-72d2b781ce509c8d28bf7d43bac6d2b1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="6" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c103eb5c79771084636740a3626eaa06-e-1" label="Evans and co-workers">
        <attvalues>
          <attvalue for="0" value="Evans and co-workers" />
          <attvalue for="1" value="Group" />
          <attvalue for="2" value="一个由Evans领导的研究团队。该团队在热障涂层（TBC）系统领域取得了进展，其主要贡献是创建了“失效图”（failure maps），用于分析和预测材料的失效模式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-c103eb5c79771084636740a3626eaa06" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c103eb5c79771084636740a3626eaa06-e-3" label="mathematical analysis of the micromechanics of TBC systems">
        <attvalues>
          <attvalue for="0" value="mathematical analysis of the micromechanics of TBC systems" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="一种基于数学模型的分析方法，专注于研究热障涂层（TBC）系统的微观力学行为。该方法旨在通过计算预测材料的失效模式，并以“失效图”（failure maps）的形式直观呈现其分析结果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c103eb5c79771084636740a3626eaa06" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c103eb5c79771084636740a3626eaa06-e-4" label="TBC systems">
        <attvalues>
          <attvalue for="0" value="TBC systems" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="TBC系统，即热障涂层系统（Thermal Barrier Coating systems），是一种应用于航空发动机、燃气轮机等高温部件表面的先进多层防护涂层。它通过热隔离作用保护金属基材，其复杂的微观力学行为是决定其服役寿命和可靠性的关键，也是重要的力学分析研究对象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c103eb5c79771084636740a3626eaa06" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c103eb5c79771084636740a3626eaa06-e-5" label="delamination from edges">
        <attvalues>
          <attvalue for="0" value="delamination from edges" />
          <attvalue for="1" value="Failure_Mechanism" />
          <attvalue for="2" value="边缘分层是一种发生在热障涂层（TBC）体系中的失效机制，指涂层从部件或试样的自由边缘处开始发生的层状剥离。作为一种主要的竞争性失效模式，它是构建和分析材料“失效图谱”时所考量的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c103eb5c79771084636740a3626eaa06" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a9b18faea9fc2dc16504c23ff224a743-e-1" label="Delamination from edges">
        <attvalues>
          <attvalue for="0" value="Delamination from edges" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="边缘分层是一种失效机制，指层状材料从部件边缘（如涡轮叶片后缘）开始发生分离的现象。它与热生长氧化物（TGO）的屈曲是两种相互竞争的失效模式，其发生会受到材料的II型界面断裂韧性的抑制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-a9b18faea9fc2dc16504c23ff224a743" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a9b18faea9fc2dc16504c23ff224a743-e-3" label="Mode II interfacial fracture toughness">
        <attvalues>
          <attvalue for="0" value="Mode II interfacial fracture toughness" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="Mode II 界面韧性（II型界面断裂韧性）是衡量材料（尤指复合材料）界面抵抗面内剪切（滑移型）裂纹扩展能力的材料属性。该值越高，代表界面在断裂前能吸收更多能量，因此能有效减小高应力区的范围，抑制边缘分层现象的发生与扩展。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;ΓII&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a9b18faea9fc2dc16504c23ff224a743" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Fracture toughness, ΓⅡ&quot;, &quot;Mode II interfacial toughness&quot;, &quot;mode II fracture toughness (ΓⅡ)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a9b18faea9fc2dc16504c23ff224a743-e-3&quot;, &quot;chunk-2ac3d73c1ded0ce49421b66e585b5916-e-4&quot;, &quot;chunk-5395b7a3b731615ee1a2521907378b84-e-10&quot;, &quot;chunk-40762f1b619063834a1784b067d301ee-e-1&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a9b18faea9fc2dc16504c23ff224a743-e-4" label="Buckling of the TGO">
        <attvalues>
          <attvalue for="0" value="Buckling of the TGO" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="热生长氧化物（TGO）的屈曲是一种失效机制。该过程由预先存在的界面分离所引发，是一种与从边缘开始的分层（delamination）现象相竞争的失效模式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a9b18faea9fc2dc16504c23ff224a743" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a9b18faea9fc2dc16504c23ff224a743-e-6" label="Pre-existing interfacial separations">
        <attvalues>
          <attvalue for="0" value="Pre-existing interfacial separations" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="一种材料界面缺陷，指在热循环或服役前就已存在的微小分离或空隙。它是热生长氧化物（TGO）层在后续应力作用下发生屈曲失效的起源和关键诱因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a9b18faea9fc2dc16504c23ff224a743" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a9b18faea9fc2dc16504c23ff224a743-e-7" label="Failure maps">
        <attvalues>
          <attvalue for="0" value="Failure maps" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="失效图（Failure maps）是在材料科学和工程学中使用的一种图表。它通常将应力、温度等外部条件作为坐标，标示出材料在不同条件下所对应的主导失效机制区域（如蠕变、疲劳、脆性断裂等）。该图用于预测材料的失效行为，并指导结构的抗失效设计。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a9b18faea9fc2dc16504c23ff224a743" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;'failure maps'&quot;, &quot;Failure Map&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c103eb5c79771084636740a3626eaa06-e-2&quot;, &quot;chunk-a9b18faea9fc2dc16504c23ff224a743-e-7&quot;, &quot;chunk-9d4090cefd14aa31985c686534f57a73-e-10&quot;, &quot;chunk-31c18b0689504fd2041e550630408d61-e-1&quot;, &quot;chunk-80545b960495f33fd33c6ee9963001b5-e-10&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-a9b18faea9fc2dc16504c23ff224a743-e-8" label="Calculations">
        <attvalues>
          <attvalue for="0" value="Calculations" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="指生成“失效图谱”的计算过程。它是一系列分析与运算步骤的集合，作为创建失效图谱的直接来源。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-a9b18faea9fc2dc16504c23ff224a743" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a9b18faea9fc2dc16504c23ff224a743-e-9" label="Durability">
        <attvalues>
          <attvalue for="0" value="Durability" />
          <attvalue for="1" value="System Property" />
          <attvalue for="2" value="耐久性 (Durability) 是一种系统属性，指系统在特定负载和环境条件下抵抗失效、维持其功能的能力。其性能边界和关键控制因素可以通过失效图（Failure maps）进行分析与理解。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-a9b18faea9fc2dc16504c23ff224a743" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a9b18faea9fc2dc16504c23ff224a743-e-9&quot;, &quot;chunk-e0eaec940932f96aaacae0dab5000c8c-e-2&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e0eaec940932f96aaacae0dab5000c8c-e-1" label="Ceramic top coat">
        <attvalues>
          <attvalue for="0" value="Ceramic top coat" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="**陶瓷顶涂层**是一种由陶瓷材料构成的表层组件。它的物理属性，特别是厚度(h)和模量各向异性，是控制其所应用的系统或部件整体耐久性的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-e0eaec940932f96aaacae0dab5000c8c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e0eaec940932f96aaacae0dab5000c8c-e-3" label="Thickness (h)">
        <attvalues>
          <attvalue for="0" value="Thickness (h)" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="厚度(h)是指陶瓷面层的厚度，是一项关键的物理属性。该厚度的大小是决定和控制涂层整体耐久性的重要因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-e0eaec940932f96aaacae0dab5000c8c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e0eaec940932f96aaacae0dab5000c8c-e-4" label="Modulus Anisotropy">
        <attvalues>
          <attvalue for="0" value="Modulus Anisotropy" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="模量各向异性是一种材料属性，定义为材料在面内与面外方向上杨氏模量(E||/E⊥)的比值。该特性通常由柱状微观结构引起，是陶瓷顶涂层的一个关键属性，直接影响其耐久性。" />
          <attvalue for="3" value="{&quot;definition&quot;: &quot;E||/E⊥&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-e0eaec940932f96aaacae0dab5000c8c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-e0eaec940932f96aaacae0dab5000c8c-e-5" label="YSZ">
        <attvalues>
          <attvalue for="0" value="YSZ" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="氧化钇稳定氧化锆（YSZ）是一种先进陶瓷材料，常作为热障涂层的陶瓷面层。它可通过电子束物理气相沉积（EB-PVD）等工艺制备，具有优异的高温稳定性和低热导率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e0eaec940932f96aaacae0dab5000c8c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e0eaec940932f96aaacae0dab5000c8c-e-5&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2ac3d73c1ded0ce49421b66e585b5916-e-2" label="Elastic strain energy density">
        <attvalues>
          <attvalue for="0" value="Elastic strain energy density" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="弹性应变能密度是一种力学性能，指材料发生弹性变形时，其单位体积内储存的能量。在厚度大、面内模量高的区域，该能量会显著集中，是导致材料结构发生边缘分层等失效模式的驱动力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-2ac3d73c1ded0ce49421b66e585b5916" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2ac3d73c1ded0ce49421b66e585b5916-e-2&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2ac3d73c1ded0ce49421b66e585b5916-e-3" label="Edge delamination">
        <attvalues>
          <attvalue for="0" value="Edge delamination" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="边缘分层是一种发生在材料或结构自由边缘的失效机制。它由材料内部的高残余应力和弹性应变能密度共同驱动，导致材料发生层间分离或开裂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-2ac3d73c1ded0ce49421b66e585b5916" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-2ac3d73c1ded0ce49421b66e585b5916-e-5" label="Buckling">
        <attvalues>
          <attvalue for="0" value="Buckling" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="屈曲（Buckling），又称结构失稳，是一种因压应力导致的结构失效机制。当细长或薄壁构件所受压力达到临界值时，会突然发生显著的侧向弯曲变形。构件的厚度与面内模量是决定其抗屈曲能力的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2ac3d73c1ded0ce49421b66e585b5916" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;buckling&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2ac3d73c1ded0ce49421b66e585b5916-e-5&quot;, &quot;chunk-80545b960495f33fd33c6ee9963001b5-e-6&quot;, &quot;chunk-93d10ba2903ae8b18e5582634fca4a8c-e-6&quot;, &quot;chunk-25a792195888d0ec7e1a3d86f8775f12-e-2&quot;, &quot;chunk-6dac0a4c73567f8946fa9c50957af9ca-e-2&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-2ac3d73c1ded0ce49421b66e585b5916-e-6" label="Thickness">
        <attvalues>
          <attvalue for="0" value="Thickness" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="h是一个物理量符号，通常用于表示层厚度(layer thickness)。在特定科学模型或工程方程（如计算Go的公式）中，它作为一个关键变量，用于量化和描述一个物体或材料在特定维度上的几何尺寸。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-2ac3d73c1ded0ce49421b66e585b5916" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Thickness (h)&quot;, &quot;h&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2ac3d73c1ded0ce49421b66e585b5916-e-6&quot;, &quot;chunk-bf602d6d22c552a1206d1179123ca1f7-e-6&quot;, &quot;chunk-5395b7a3b731615ee1a2521907378b84-e-8&quot;, &quot;chunk-40762f1b619063834a1784b067d301ee-e-5&quot;, &quot;chunk-2e04fd0a8a6174c1165f0c60c65b783d-e-6&quot;, &quot;chunk-80545b960495f33fd33c6ee9963001b5-e-4&quot;, &quot;chunk-c929de8b876cec7f9e52b5cbc0ebb2c8-e-1&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-2ac3d73c1ded0ce49421b66e585b5916-e-7" label="In-plane modulus">
        <attvalues>
          <attvalue for="0" value="In-plane modulus" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**面内刚度 (E||)**&#10;&#10;一个力学性能，表征材料或结构抵抗其自身平面内变形的能力。它是分析结构稳定性的关键参数，较低的数值会显著增加结构发生屈曲的风险。该属性被用于计算临界屈曲应力(σc)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-2ac3d73c1ded0ce49421b66e585b5916" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;In-plane Stiffness (E||)&quot;, &quot;in-plane modulus&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2ac3d73c1ded0ce49421b66e585b5916-e-7&quot;, &quot;chunk-9d4090cefd14aa31985c686534f57a73-e-7&quot;, &quot;chunk-80545b960495f33fd33c6ee9963001b5-e-2&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-2ac3d73c1ded0ce49421b66e585b5916-e-8" label="Characteristic width, b">
        <attvalues>
          <attvalue for="0" value="Characteristic width, b" />
          <attvalue for="1" value="Geometric Property" />
          <attvalue for="2" value="特征宽度（b）是一项关键的几何属性，指决定结构中易屈曲区域（Buckling Region）范围的物理尺寸。该宽度的增加会直接导致潜在屈曲区域的范围扩大。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-2ac3d73c1ded0ce49421b66e585b5916" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;characteristic width, b&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2ac3d73c1ded0ce49421b66e585b5916-e-8&quot;, &quot;chunk-9d4090cefd14aa31985c686534f57a73-e-2&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-2ac3d73c1ded0ce49421b66e585b5916-e-9" label="High Stress/Energy Region">
        <attvalues>
          <attvalue for="0" value="High Stress/Energy Region" />
          <attvalue for="1" value="Geographic Region" />
          <attvalue for="2" value="高应力/能量区指材料或工艺图中，因同时具有高厚度、高面内模量、高应力与高能量，而极易引发材料分层失效的特定区域。该区域的范围可以通过提高材料的II型界面韧性来有效减小。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-2ac3d73c1ded0ce49421b66e585b5916" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2ac3d73c1ded0ce49421b66e585b5916-e-10" label="Buckling Region">
        <attvalues>
          <attvalue for="0" value="Buckling Region" />
          <attvalue for="1" value="Geographic Region" />
          <attvalue for="2" value="屈曲区域指因厚度与面内模量较低，而在受压时易发生屈曲失稳的特定物理区域。该区域的范围通常会随着特征宽度b的增加而扩大。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-2ac3d73c1ded0ce49421b66e585b5916" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-9d4090cefd14aa31985c686534f57a73-e-1" label="second region">
        <attvalues>
          <attvalue for="0" value="second region" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="一个特定概念区域，其范围与“特征宽度b”这一参数呈正相关关系。当特征宽度b增加时，该区域的广度也随之扩大。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-9d4090cefd14aa31985c686534f57a73" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9d4090cefd14aa31985c686534f57a73-e-3" label="'fail-safe' regime">
        <attvalues>
          <attvalue for="0" value="'fail-safe' regime" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="一种在材料或结构设计中能防止失效发生的特定参数区间。该区间的边界依赖于热生长氧化物(TGO)层厚度等变量，其存在也意味着结构具备了实现安全运行所需的最佳厚度与面内模量等条件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-9d4090cefd14aa31985c686534f57a73" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-9d4090cefd14aa31985c686534f57a73-e-4" label="Failure">
        <attvalues>
          <attvalue for="0" value="Failure" />
          <attvalue for="1" value="Event" />
          <attvalue for="2" value="指系统或组件丧失其规定功能，导致其无法正常运行的现象。它是一种在“故障安全”机制的保护下，被预期不会发生的事件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-9d4090cefd14aa31985c686534f57a73" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Failures&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-79ede9fcd5559df3694674f85ef1484e-e-4&quot;, &quot;chunk-9d4090cefd14aa31985c686534f57a73-e-4&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-9d4090cefd14aa31985c686534f57a73-e-5" label="TBC">
        <attvalues>
          <attvalue for="0" value="TBC" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="TBC，即热障涂层（Thermal Barrier Coating），是一种应用于金属基底表面的先进材料体系。它主要用于航空发动机、燃气轮机等高温部件，提供隔热保护，以提高其工作温度和使用寿命。其涂层厚度和面内模量是影响其隔热性能和结构稳定性的关键物理属性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-9d4090cefd14aa31985c686534f57a73" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9d4090cefd14aa31985c686534f57a73-e-6" label="optimum thickness">
        <attvalues>
          <attvalue for="0" value="optimum thickness" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="指在“失效安全”机制下，热障涂层（TBC）所具有的一个能平衡性能与寿命、从而实现最优综合效果的理想厚度。该厚度若过薄则防护不足，若过厚则易因内应力而剥落。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-9d4090cefd14aa31985c686534f57a73" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-31c18b0689504fd2041e550630408d61-e-2" label="TBC system">
        <attvalues>
          <attvalue for="0" value="TBC system" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="热障涂层（TBC）系统是一种先进的多层复合材料系统，通常由基体、粘结层、热生长氧化物(TGO)和陶瓷顶层构成。其核心功能是在高温环境下为基体提供优异的隔热保护，以防止部件发生热致失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-31c18b0689504fd2041e550630408d61" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-31c18b0689504fd2041e550630408d61-e-3" label="Substrate">
        <attvalues>
          <attvalue for="0" value="Substrate" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="Substrate是热障涂层（TBC）系统中的一个结构层，是整个系统的基础。它作为基底材料，用于承载其上方的涂层（如单层薄膜），为其提供附着和支撑。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-31c18b0689504fd2041e550630408d61" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-31c18b0689504fd2041e550630408d61-e-4" label="Bond coat">
        <attvalues>
          <attvalue for="0" value="Bond coat" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="粘结层（Bond Coat）是热障涂层（TBC）系统中的关键中间层，通常为金属材质。它位于陶瓷顶层与金属基体之间，主要作用是增强二者结合力，并为基体提供抗高温氧化保护。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-31c18b0689504fd2041e550630408d61" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-31c18b0689504fd2041e550630408d61-e-6" label="Ceramic top coat">
        <attvalues>
          <attvalue for="0" value="Ceramic top coat" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="陶瓷顶涂层是热障涂层（TBC）系统的一个关键组件层。在进行理论分析或建模时，为简化问题，该涂层系统在物理上可被近似为一层均匀的单层薄膜。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-31c18b0689504fd2041e550630408d61" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-31c18b0689504fd2041e550630408d61-e-7" label="Single layer film">
        <attvalues>
          <attvalue for="0" value="Single layer film" />
          <attvalue for="1" value="Model" />
          <attvalue for="2" value="一种简化模型，它将涂覆在基底上的陶瓷顶涂层近似为单层薄膜，用于对材料的失效图进行理论解释和分析。" />
          <attvalue for="3" value="{&quot;thickness&quot;: &quot;h&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-31c18b0689504fd2041e550630408d61" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-31c18b0689504fd2041e550630408d61-e-8" label="Edge delamination">
        <attvalues>
          <attvalue for="0" value="Edge delamination" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="一种发生在复合材料或层状结构边缘的失效模式，指相邻材料层之间发生分离。作为一种断裂现象，通常使用能量释放率这一关键参数来描述和分析其扩展行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-31c18b0689504fd2041e550630408d61" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-31c18b0689504fd2041e550630408d61-e-10" label="Crack length">
        <attvalues>
          <attvalue for="0" value="Crack length" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="在断裂力学中，裂纹长度是表征裂纹几何尺寸的关键参数。在特定条件下（如稳态扩展），作为裂纹扩展驱动力的能量释放率会变得与裂纹长度无关，此时该参数是评估材料断裂韧性的重要指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-31c18b0689504fd2041e550630408d61" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-31c18b0689504fd2041e550630408d61-e-11" label="Figures 5.54(a) and 5.54(b)">
        <attvalues>
          <attvalue for="0" value="Figures 5.54(a) and 5.54(b)" />
          <attvalue for="1" value="Reference" />
          <attvalue for="2" value="文献中的一对关联图示，编号为5.54(a)和5.54(b)。它们在文本开篇被引用，旨在为后续的论述或数据分析提供一个直观的比较基准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-31c18b0689504fd2041e550630408d61" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="325" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-bf602d6d22c552a1206d1179123ca1f7-e-1" label="Go">
        <attvalues>
          <attvalue for="0" value="Go" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="Go，物理量，指应变能释放率（strain energy release rate），一个表征裂纹扩展驱动力的计算值。其数值基于材料弹性模量(E||)、泊松比(ν)、失配应变(єT)和几何尺寸(h)等参数计算得出。通过将其与材料的断裂韧性(ΓⅡ)对比，可预测断裂风险。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;Go = 1/2 (1 - ν² / E||) σ₀²h&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-bf602d6d22c552a1206d1179123ca1f7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Energy release rate, Go&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-31c18b0689504fd2041e550630408d61-e-9&quot;, &quot;chunk-bf602d6d22c552a1206d1179123ca1f7-e-1&quot;, &quot;chunk-5395b7a3b731615ee1a2521907378b84-e-9&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-bf602d6d22c552a1206d1179123ca1f7-e-2" label="b">
        <attvalues>
          <attvalue for="0" value="b" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="在断裂力学中，b是表示裂纹长度的物理量，为一个关键的几何参数。它与材料的固有属性（如断裂能Go）相区别，后者被视为常数，不随裂纹长度的变化而改变。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-bf602d6d22c552a1206d1179123ca1f7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bf602d6d22c552a1206d1179123ca1f7-e-3" label="E||">
        <attvalues>
          <attvalue for="0" value="E||" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="E||是一种材料属性，特指各向异性材料在平行于其主方向（如纤维或晶格方向）上测得的杨氏模量。它衡量材料在该方向抵抗弹性变形的刚度，并被用作计算剪切模量Go等其他物理量的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-bf602d6d22c552a1206d1179123ca1f7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bf602d6d22c552a1206d1179123ca1f7-e-3&quot;, &quot;chunk-5395b7a3b731615ee1a2521907378b84-e-6&quot;, &quot;chunk-2e04fd0a8a6174c1165f0c60c65b783d-e-3&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-bf602d6d22c552a1206d1179123ca1f7-e-5" label="σ₀ (interfacial misfit stress)">
        <attvalues>
          <attvalue for="0" value="σ₀ (interfacial misfit stress)" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="σ₀是一种物理量，指材料层间（如薄膜与基底）因晶格常数或热膨胀系数不匹配而产生的压缩性双轴错配应力。它的大小由错配应变(εT)以及材料的弹性性质（如平面杨氏模量E||和泊松比ν）共同决定，是影响界面结合能(Go)和系统稳定性的关键参数。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;σ₀ = E||εT/(1 − ν²)&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-bf602d6d22c552a1206d1179123ca1f7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;σ₀&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bf602d6d22c552a1206d1179123ca1f7-e-5&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-bf602d6d22c552a1206d1179123ca1f7-e-7" label="TBC">
        <attvalues>
          <attvalue for="0" value="TBC" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="TBC，全称热障涂层(Thermal Barrier Coating)，是一种先进的涂层材料系统。它通常应用于航空发动机、燃气轮机等高温部件表面，起隔热作用，以保护基体材料。其力学行为由杨氏模量(E||)和泊松比(ν)等关键性能参数来表征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-bf602d6d22c552a1206d1179123ca1f7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-bf602d6d22c552a1206d1179123ca1f7-e-8" label="εT">
        <attvalues>
          <attvalue for="0" value="εT" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="εT是一种物理量，专指热失配应变（Thermal Misfit Strain）。它由不同材料的热膨胀系数差异（Δα）与温度变化（ΔΤ）共同决定，是导致材料内部产生热应力或残余应力（σ₀）的直接原因。" />
          <attvalue for="3" value="{&quot;equation&quot;: &quot;εT = Δα × ΔΤ&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-bf602d6d22c552a1206d1179123ca1f7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-bf602d6d22c552a1206d1179123ca1f7-e-9" label="Δα">
        <attvalues>
          <attvalue for="0" value="Δα" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="一个物理量，指不同材料之间热膨胀系数的差值。它被用来计算复合材料或异质结构在温度变化时，由于热膨胀失配而产生的热应变(εT)或失配应变，是评估结构热稳定性的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-bf602d6d22c552a1206d1179123ca1f7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bf602d6d22c552a1206d1179123ca1f7-e-9&quot;, &quot;chunk-5395b7a3b731615ee1a2521907378b84-e-2&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-5395b7a3b731615ee1a2521907378b84-e-4" label="TBC">
        <attvalues>
          <attvalue for="0" value="TBC" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="热障涂层（TBC）是一种先进的涂层材料，应用于高温部件表面以提供隔热保护，从而延长其服役寿命。其热膨胀系数是评估涂层与基体间热机械兼容性的关键参数，用于计算热膨胀失配（Δα）等指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-5395b7a3b731615ee1a2521907378b84" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5395b7a3b731615ee1a2521907378b84-e-5" label="substrate">
        <attvalues>
          <attvalue for="0" value="substrate" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种用作基底的组件材料，其热膨胀系数是关键物理特性。该系数常用于计算与其他材料的热膨胀失配度(Δα)，以分析和评估器件在温度变化下的热机械应力与可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-5395b7a3b731615ee1a2521907378b84" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-40762f1b619063834a1784b067d301ee-e-2" label="TBC">
        <attvalues>
          <attvalue for="0" value="TBC" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="TBC (Thermal Barrier Coating)，即热障涂层，是一种材料涂层，其主要失效模式为分层。失配应变是导致其失效的关键因素，而能量密度会影响分层过程。其断裂韧性是衡量其抗分层能力的重要性能指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-40762f1b619063834a1784b067d301ee" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-40762f1b619063834a1784b067d301ee-e-3" label="As-deposited state">
        <attvalues>
          <attvalue for="0" value="As-deposited state" />
          <attvalue for="1" value="Material State" />
          <attvalue for="2" value="沉积态(As-deposited state)是材料（特指热障涂层TBC）在沉积工艺完成后，未经任何后续热处理或投入服役前的初始物理与微观结构状态。此状态下，涂层保持着其制备完成时的原始形态和性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-40762f1b619063834a1784b067d301ee" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-40762f1b619063834a1784b067d301ee-e-4" label="Energy density">
        <attvalues>
          <attvalue for="0" value="Energy density" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="能量密度是衡量单位体积或质量内储存能量的物理属性。在材料涂层领域，它是决定热障涂层（TBC）稳定性的关键因素，其在沉积态的数值直接影响涂层是否会因内应力而发生分层剥离。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-40762f1b619063834a1784b067d301ee" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-40762f1b619063834a1784b067d301ee-e-6" label="Edge-delamination regime">
        <attvalues>
          <attvalue for="0" value="Edge-delamination regime" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="一种应用于热障涂层(TBC)的失效模式。当特定变量'h'增加时，系统会进入该模式，其特征是涂层从边缘处开始发生分层，并最终导致整体失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-40762f1b619063834a1784b067d301ee" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-40762f1b619063834a1784b067d301ee-e-9" label="Sintering of the TBC">
        <attvalues>
          <attvalue for="0" value="Sintering of the TBC" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="热障涂层(TBC)在高温服役环境中，其内部陶瓷颗粒发生粘结、孔隙减少并逐渐致密化的过程。该过程会改变涂层的机械性能和热物理性能，是导致失配应变增大的原因之一，进而影响涂层的可靠性与寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-40762f1b619063834a1784b067d301ee" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2e04fd0a8a6174c1165f0c60c65b783d-e-1" label="TBC">
        <attvalues>
          <attvalue for="0" value="TBC" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="TBC（Thermal Barrier Coating），即热障涂层，是一种应用于材料表面的先进涂层系统，旨在为高温环境下的部件提供隔热保护。其在服役过程中会发生烧结现象导致性能下降，并可能最终因分层剥落而失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-2e04fd0a8a6174c1165f0c60c65b783d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2e04fd0a8a6174c1165f0c60c65b783d-e-2" label="Sintering">
        <attvalues>
          <attvalue for="0" value="Sintering" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="烧结（Sintering）指热障涂层（TBC）在高温下发生的一种材料致密化过程。该过程通过增强颗粒间连接，导致涂层的面内杨氏模量（E||）升高，是影响其力学性能和寿命的关键机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-2e04fd0a8a6174c1165f0c60c65b783d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-2e04fd0a8a6174c1165f0c60c65b783d-e-4" label="Buckle Delamination">
        <attvalues>
          <attvalue for="0" value="Buckle Delamination" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="屈曲分层(Buckle Delamination)是一种失效模式，指材料在压缩应力(σc)作用下，其内部形似直边气泡的分层区域因失稳而发生屈曲的现象。该分层区域的几何形态通常由宽度(2b)和高度(h)等尺寸参数来表征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-2e04fd0a8a6174c1165f0c60c65b783d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2e04fd0a8a6174c1165f0c60c65b783d-e-5" label="σc">
        <attvalues>
          <attvalue for="0" value="σc" />
          <attvalue for="1" value="Mechanical Stress" />
          <attvalue for="2" value="σc指涂层内的临界压缩应力，是导致其发生屈曲分层的应力阈值。作为一项关键力学参数，其数值由材料的杨氏模量(E||)、泊松比(ν)、涂层厚度(h)以及分层区域的宽度(2b)共同决定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2e04fd0a8a6174c1165f0c60c65b783d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-2e04fd0a8a6174c1165f0c60c65b783d-e-7" label="2b">
        <attvalues>
          <attvalue for="0" value="2b" />
          <attvalue for="1" value="Geometric Parameter" />
          <attvalue for="2" value="几何参数“2b”，指直边气泡或屈曲分层的宽度。它是一个关键尺寸，在材料力学分析中，被用于确定该类缺陷的稳定性以及发生扩展所需的临界应力(σc)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-2e04fd0a8a6174c1165f0c60c65b783d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-2e04fd0a8a6174c1165f0c60c65b783d-e-10" label="Buckling Theory">
        <attvalues>
          <attvalue for="0" value="Buckling Theory" />
          <attvalue for="1" value="Scientific Theory" />
          <attvalue for="2" value="屈曲理论是研究结构稳定性的力学理论。它主要分析细长构件在压力作用下达到临界载荷时，突然发生大变形的失稳现象，并为计算屈曲应力等关键参数提供理论基础和推导依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-2e04fd0a8a6174c1165f0c60c65b783d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2e04fd0a8a6174c1165f0c60c65b783d-e-10&quot;, &quot;chunk-80545b960495f33fd33c6ee9963001b5-e-8&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-80545b960495f33fd33c6ee9963001b5-e-1" label="Critical Buckling Stress (σc)">
        <attvalues>
          <attvalue for="0" value="Critical Buckling Stress (σc)" />
          <attvalue for="1" value="Formula" />
          <attvalue for="2" value="临界屈曲应力(σc)是在结构力学中，指受压构件因失稳而发生突然横向变形（即屈曲）时的临界应力值。它是一个预测结构稳定性的关键物理量，其值基于屈曲理论，由材料的平面内刚度(E||)及构件的厚度(h)、宽度(b)等几何尺寸计算确定。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;σc = (π² / 12) * (E|| / (1 - ν²)) * (h/b)²&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-80545b960495f33fd33c6ee9963001b5" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Equation 5.3&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2e04fd0a8a6174c1165f0c60c65b783d-e-9&quot;, &quot;chunk-80545b960495f33fd33c6ee9963001b5-e-1&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-80545b960495f33fd33c6ee9963001b5-e-5" label="Width/Length (b)">
        <attvalues>
          <attvalue for="0" value="Width/Length (b)" />
          <attvalue for="1" value="Geometric Parameter" />
          <attvalue for="2" value="**宽长比 (b)**&#10;&#10;一个在结构力学中描述构件几何特征的无量纲参数，定义为宽度与长度的比值。它是影响结构稳定性的关键因素，并被用于计算临界屈曲应力(σc)。通常，较大的宽长比会降低构件的抗屈曲能力，使其在受压时更容易发生失稳。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-80545b960495f33fd33c6ee9963001b5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-80545b960495f33fd33c6ee9963001b5-e-9" label="Euler Column">
        <attvalues>
          <attvalue for="0" value="Euler Column" />
          <attvalue for="1" value="Theoretical Model" />
          <attvalue for="2" value="欧拉柱是结构力学中的一个理想化理论模型，用于计算细长压杆在轴向压力下发生失稳（即屈曲）的临界载荷。作为屈曲理论的经典范例，该模型分析基于完美直杆、均匀材料和轴心受压等理想化假设。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-80545b960495f33fd33c6ee9963001b5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-80545b960495f33fd33c6ee9963001b5-e-11" label="TBCs">
        <attvalues>
          <attvalue for="0" value="TBCs" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="热障涂层（TBCs）是一种先进的材料系统，用于为金属基体提供隔热保护，使其能在高温环境下工作。其服役耐久性是评估其性能的关键指标，并容易受到材料内部缺陷的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-80545b960495f33fd33c6ee9963001b5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-88706c8690b0d2b2ae8b3e515c553936-e-1" label="TBCs">
        <attvalues>
          <attvalue for="0" value="TBCs" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="热障涂层（TBCs）是一种先进的材料系统，常用于航空发动机等高温部件表面，起隔热保护作用。其服役耐久性是衡量其性能的关键指标，并极易受到涂层内部存在的各类缺陷影响而降低。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-88706c8690b0d2b2ae8b3e515c553936" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-88706c8690b0d2b2ae8b3e515c553936-e-3" label="Imperfections">
        <attvalues>
          <attvalue for="0" value="Imperfections" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="Imperfections是一种在热障涂层(TBCs)中，于热生长氧化物(TGO)层附近生长的物理和化学缺陷。它们是导致涂层发生分层与最终剥落的先决条件，从而直接影响TBCs的耐久性。对这类缺陷的量化估算是建立寿命预测模型的关键输入。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-88706c8690b0d2b2ae8b3e515c553936" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-88706c8690b0d2b2ae8b3e515c553936-e-3&quot;, &quot;chunk-80545b960495f33fd33c6ee9963001b5-e-13&quot;, &quot;chunk-a489ad53b1434170d93d0b020b96b655-e-4&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-88706c8690b0d2b2ae8b3e515c553936-e-4" label="Delamination">
        <attvalues>
          <attvalue for="0" value="Delamination" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="一种发生在层状材料（如复合材料）中的失效模式，指材料内部相邻的层发生分离。这种失效通常由初始缺陷在应力作用下扩展而引发，是导致结构完整性破坏的主要原因之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-88706c8690b0d2b2ae8b3e515c553936" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-88706c8690b0d2b2ae8b3e515c553936-e-5" label="Spallation">
        <attvalues>
          <attvalue for="0" value="Spallation" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="**剥落 (Spallation)**：热障涂层（TBC）的一种关键失效模式，指涂层因附着力丧失而从基体上成片碎裂或剥离。该现象通常由热循环过程中的应力所致，它会使受保护的基体暴露于高温中，导致TBC丧失其隔热功能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-88706c8690b0d2b2ae8b3e515c553936" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;spallation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-88706c8690b0d2b2ae8b3e515c553936-e-5&quot;, &quot;chunk-dceb4b755a836df5a6b40aba440100ba-e-3&quot;, &quot;chunk-356a95a5ba9ccf9ed595619218c5107b-e-12&quot;, &quot;chunk-a9fc67de05915b361fe22b50c698339d-e-3&quot;, &quot;chunk-a6f8ce7a7c55e9b6f962543810b6ee71-e-5&quot;, &quot;chunk-5508d220f18b6461ca52c2a3d80737ec-e-5&quot;, &quot;chunk-355e3199ba9477d489a169627728bb4e-e-5&quot;, &quot;chunk-069e9bb3e2c8dfdab86052450cf45cd2-e-6&quot;, &quot;chunk-12839dddacb541f1c423c238ab49ba6e-e-4&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-88706c8690b0d2b2ae8b3e515c553936-e-6" label="Lifetime prediction model">
        <attvalues>
          <attvalue for="0" value="Lifetime prediction model" />
          <attvalue for="1" value="Analytical Tool" />
          <attvalue for="2" value="一种分析工具，用于预测材料或组件的运行寿命及失效时间。该模型的准确性关键依赖于对内部缺陷（Imperfections）形核速率的精确估算，因为这些缺陷的产生与扩展是导致材料性能退化并最终失效的关键驱动因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-88706c8690b0d2b2ae8b3e515c553936" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-88706c8690b0d2b2ae8b3e515c553936-e-6&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c9321383d9d47ce5d22357e665813ccd-e-1" label="Quantitative Theory">
        <attvalues>
          <attvalue for="0" value="Quantitative Theory" />
          <attvalue for="1" value="Scientific Concept" />
          <attvalue for="2" value="一个尚待建立的、用以定量描述成核过程的理论框架。由于该理论的缺失，诸如热障涂层（TBC）寿命预测等相关模型的建立和发展受到了极大限制。" />
          <attvalue for="3" value="{&quot;status&quot;: &quot;unavailable&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-c9321383d9d47ce5d22357e665813ccd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="42" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c9321383d9d47ce5d22357e665813ccd-e-2" label="TBC Lifetime Estimation Models">
        <attvalues>
          <attvalue for="0" value="TBC Lifetime Estimation Models" />
          <attvalue for="1" value="Engineering Model" />
          <attvalue for="2" value="**TBC寿命估算方法 (TBC lifetime estimation methods)**&#10;&#10;指一系列应用于热障涂层（TBC）系统、用以预测其服役寿命的技术方法。这些方法目前尚处发展阶段，其目标是通过精准的寿命预测，来充分挖掘和利用TBC的防护潜力，以提升整个系统的可靠性与经济性。" />
          <attvalue for="3" value="{&quot;basis&quot;: &quot;physically based&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c9321383d9d47ce5d22357e665813ccd" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;TBC lifetime estimation methods&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c9321383d9d47ce5d22357e665813ccd-e-2&quot;, &quot;chunk-d1fe7409ba7204cdc10b650e7502783c-e-9&quot;]}]" />
          <attvalue for="9" value="42" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c9321383d9d47ce5d22357e665813ccd-e-3" label="Defects">
        <attvalues>
          <attvalue for="0" value="Defects" />
          <attvalue for="1" value="Material Imperfection" />
          <attvalue for="2" value="指材料中存在的各类瑕疵或不完美之处。这类缺陷会随时间演变，其发展过程是决定热障涂层（TBC）使用寿命的关键因素，也是相关寿命预测模型必须考虑的核心变量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c9321383d9d47ce5d22357e665813ccd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="42" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c9321383d9d47ce5d22357e665813ccd-e-5" label="Substrate/Bond Coat">
        <attvalues>
          <attvalue for="0" value="Substrate/Bond Coat" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="一种材料组件，特指涂层系统中的基底（Substrate）或其上的粘结层（Bond Coat）。基底是承受涂层的本体材料，粘结层则用于增强附着力。作为基础结构，它们的物理和化学性质是影响最终涂层产生缺陷的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c9321383d9d47ce5d22357e665813ccd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-df31d8a0cc69400a7fd30dcdb24ab502-e-1" label="substrate/bond coat/ceramic combination">
        <attvalues>
          <attvalue for="0" value="substrate/bond coat/ceramic combination" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="一种典型的热障涂层（TBC）系统结构，由基体、粘结层和陶瓷面层构成。此多层材料体系的综合物理与化学性能，共同决定了涂层在高温工况下的损伤机制、可靠性与寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-df31d8a0cc69400a7fd30dcdb24ab502" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-df31d8a0cc69400a7fd30dcdb24ab502-e-3" label="damage mechanisms">
        <attvalues>
          <attvalue for="0" value="damage mechanisms" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="损伤机制是在热循环作用下，热障涂层(TBC)系统内部发生的一系列材料退化现象。它受基体、粘结层和陶瓷的材料组合及制备工艺的影响，具体表现为导致热生长氧化物(TGO)界面粗糙化，是涂层最终失效的根本原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-df31d8a0cc69400a7fd30dcdb24ab502" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-df31d8a0cc69400a7fd30dcdb24ab502-e-4" label="thermally cycled TBC systems">
        <attvalues>
          <attvalue for="0" value="thermally cycled TBC systems" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="指在服役过程中经历反复升温和降温（即热循环）的热障涂层系统。这种循环会产生热失配应力，是导致涂层开裂、剥落等损伤机制并最终失效的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-df31d8a0cc69400a7fd30dcdb24ab502" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-df31d8a0cc69400a7fd30dcdb24ab502-e-4&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-df31d8a0cc69400a7fd30dcdb24ab502-e-6" label="TGO/ceramic interface">
        <attvalues>
          <attvalue for="0" value="TGO/ceramic interface" />
          <attvalue for="1" value="Interface" />
          <attvalue for="2" value="TGO/陶瓷界面是热障涂层(TBC)系统中，位于热生长氧化物(TGO)与陶瓷面层之间的关键接触面。在高温服役环境下，多种损伤机制会导致该界面逐渐粗糙化并形成波浪状起伏，这种形貌演化是影响涂层剥落失效的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-df31d8a0cc69400a7fd30dcdb24ab502" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;TGO/ceramic interfaces&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-df31d8a0cc69400a7fd30dcdb24ab502-e-6&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-df31d8a0cc69400a7fd30dcdb24ab502-e-7" label="TBC">
        <attvalues>
          <attvalue for="0" value="TBC" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="TBC（热障涂层）是一种具有光学透明性的特种材料体系。其独特的透光特性使其能够用于实现对下方基材表面起伏的检测。" />
          <attvalue for="3" value="{&quot;optical_property&quot;: &quot;transparent to light&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-df31d8a0cc69400a7fd30dcdb24ab502" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1850c2ae231fdcb9fe7ba03b78412841-e-1" label="Striations">
        <attvalues>
          <attvalue for="0" value="Striations" />
          <attvalue for="1" value="Surface Feature" />
          <attvalue for="2" value="一种表面粗糙化形式，指材料表面出现的光学可检测的条纹状构造，其起伏振幅会随循环过程而增大。该特征在形态上与“褶皱”或“扇形”等表面形貌具有一致性或伴随发生。" />
          <attvalue for="3" value="{&quot;detectability&quot;: &quot;optically under oblique illumination&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-1850c2ae231fdcb9fe7ba03b78412841" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1850c2ae231fdcb9fe7ba03b78412841-e-5" label="MCrAlY-type Coatings">
        <attvalues>
          <attvalue for="0" value="MCrAlY-type Coatings" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="MCrAlY涂层是一种以M（镍、钴或其合金）、Cr、Al、Y为主要元素的高温防护涂层。它常用于保护航空发动机和燃气轮机叶片等热端部件，抵抗高温氧化与腐蚀。在循环氧化条件下，其表面会产生称为“褶皱”或“扇形褶皱”的失效现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1850c2ae231fdcb9fe7ba03b78412841" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1850c2ae231fdcb9fe7ba03b78412841-e-6" label="TBC (Thermal Barrier Coating)">
        <attvalues>
          <attvalue for="0" value="TBC (Thermal Barrier Coating)" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="热障涂层（Thermal Barrier Coating, TBC）是一种应用于金属基体表面的先进材料，用于在高温环境下隔热，以保护基体。缺少该涂层是导致基体表面出现“波纹”或“扇形”等热腐蚀现象的条件之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-1850c2ae231fdcb9fe7ba03b78412841" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1850c2ae231fdcb9fe7ba03b78412841-e-7" label="Roughening">
        <attvalues>
          <attvalue for="0" value="Roughening" />
          <attvalue for="1" value="Surface Condition" />
          <attvalue for="2" value="**粗糙化**是一种表面状态，指材料表面变得不平滑。它可能由氧化过程引起，其具体表现形式包括形成条纹和褶皱。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-1850c2ae231fdcb9fe7ba03b78412841" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1850c2ae231fdcb9fe7ba03b78412841-e-8" label="Oxidation Process">
        <attvalues>
          <attvalue for="0" value="Oxidation Process" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="氧化过程是一种化学过程，其明确结果是导致热生长氧化物（TGO）层增厚。此外，该过程也可能是造成材料表面粗糙化的潜在原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-1850c2ae231fdcb9fe7ba03b78412841" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1850c2ae231fdcb9fe7ba03b78412841-e-9" label="TGO Thickening">
        <attvalues>
          <attvalue for="0" value="TGO Thickening" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="TGO增厚是一种由高温氧化导致的物理现象，指热生长氧化物（Thermally Grown Oxide）层不断增厚的过程。该现象会累积界面应力，是造成热障涂层等高温防护系统发生剥落失效的关键机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-1850c2ae231fdcb9fe7ba03b78412841" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1850c2ae231fdcb9fe7ba03b78412841-e-9&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-93d10ba2903ae8b18e5582634fca4a8c-e-3" label="Thermal Misfit">
        <attvalues>
          <attvalue for="0" value="Thermal Misfit" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="热失配是一种物理现象，指因材料间热膨胀系数不同，在温度变化时发生不同程度的形变而产生的内部应力。它是导致（例如涂层与基底）压应力的主要因素，其影响通常被认为大于生长应力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-93d10ba2903ae8b18e5582634fca4a8c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-25a792195888d0ec7e1a3d86f8775f12-e-4" label="Debonding">
        <attvalues>
          <attvalue for="0" value="Debonding" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="脱粘是一种失效机制，指因粘附力丧失导致材料界面（如热生长氧化物层界面）分离的现象。此过程会使界面处积聚的应力得到显著或完全的释放，是导致涂层、复合材料等结构失效的关键原因之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-25a792195888d0ec7e1a3d86f8775f12" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-25a792195888d0ec7e1a3d86f8775f12-e-4&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-25a792195888d0ec7e1a3d86f8775f12-e-6" label="Sub-critical cracking">
        <attvalues>
          <attvalue for="0" value="Sub-critical cracking" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="亚临界开裂是一种失效机制，指裂纹在低于材料临界断裂韧性的载荷下缓慢、稳定扩展的现象。该过程常由热循环等载荷驱动，通过释放材料的应变能来降低其内部应力，例如可导致热生长氧化物(TGO)层中的应力减小。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-25a792195888d0ec7e1a3d86f8775f12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-25a792195888d0ec7e1a3d86f8775f12-e-7" label="Creep relaxation">
        <attvalues>
          <attvalue for="0" value="Creep relaxation" />
          <attvalue for="1" value="Material Behavior" />
          <attvalue for="2" value="蠕变松弛是一种材料行为，指在总应变保持不变时，材料内部的应力因蠕变（时间依赖的塑性变形）而随时间逐渐降低的现象。该过程在高温下尤为显著，是热循环中热生长氧化物（TGO）应力降低的可能原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-25a792195888d0ec7e1a3d86f8775f12" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-25a792195888d0ec7e1a3d86f8775f12-e-7&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-25a792195888d0ec7e1a3d86f8775f12-e-8" label="Morphological evolution">
        <attvalues>
          <attvalue for="0" value="Morphological evolution" />
          <attvalue for="1" value="Material Behavior" />
          <attvalue for="2" value="形态演变是一种材料行为，特指热生长氧化物(TGO)的几何形状随时间推移而发生改变，如变得更加蜿蜒。这种形态上的变化被认为是可能有助于降低材料内部应力的一种机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-25a792195888d0ec7e1a3d86f8775f12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-25a792195888d0ec7e1a3d86f8775f12-e-9" label="Ceramic layer">
        <attvalues>
          <attvalue for="0" value="Ceramic layer" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="一种存在于热障涂层系统中的材料层，通常指提供隔热作用的陶瓷顶涂层。其关键失效模式是在高温下从下方的热生长氧化物（TGO）层上发生剥落。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-25a792195888d0ec7e1a3d86f8775f12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-625310d5be435bb7decacc8d5c5d55fb-e-1" label="Ceramic layer">
        <attvalues>
          <attvalue for="0" value="Ceramic layer" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="一种由陶瓷材料构成的层。其特性是会发生剥落（spalling），这一过程会揭示并暴露出其下方基底（如α-氧化铝）的形态与结构。" />
          <attvalue for="3" value="{&quot;behavior&quot;: &quot;spallation&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-625310d5be435bb7decacc8d5c5d55fb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-625310d5be435bb7decacc8d5c5d55fb-e-2" label="α-Alumina (α-Al₂O₃)">
        <attvalues>
          <attvalue for="0" value="α-Alumina (α-Al₂O₃)" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="α-Al₂O₃，又称刚玉或α-氧化铝，是氧化铝（Al₂O₃）热力学上最稳定的一种同质异形体。它具有高硬度、高熔点和优异的化学稳定性。其致密的晶体结构在形成过程中（如由γ相转变）会产生压应力，这一特性常被用于提高材料的机械性能和耐用性。" />
          <attvalue for="3" value="{&quot;morphology&quot;: &quot;ridged&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-625310d5be435bb7decacc8d5c5d55fb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;a-Al2O3&quot;, &quot;a-Al2O3 compound&quot;, &quot;a-alumina&quot;, &quot;α-Al2O3&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-db78ddbf62abad0b3c908872d469b5fa-e-7&quot;, &quot;chunk-06d99f061d242b2c3104dc4852dc4811-e-6&quot;, &quot;chunk-e66fbe12748379e18cc5f75f5238013e-e-3&quot;, &quot;chunk-c4027f79a0ee2caae7fc9e91bab6483f-e-2&quot;, &quot;chunk-a489ad53b1434170d93d0b020b96b655-e-5&quot;, &quot;chunk-625310d5be435bb7decacc8d5c5d55fb-e-2&quot;, &quot;chunk-3b9fc12d9e53d6f182e075b23403b4d9-e-6&quot;, &quot;chunk-b97c646fdd3d882523c919f4eb1503cb-e-8&quot;, &quot;chunk-3de7fb49bbb1a56b800f051f299d5884-e-5&quot;, &quot;chunk-7638042a561888cfdce1fb2ee9ad0428-e-11&quot;, &quot;chunk-4e1df0fa0fa7afa66a5ee088dbcbc837-e-2&quot;, &quot;chunk-8fe8d1c616def00dd2818c380aea80d6-e-4&quot;, &quot;chunk-93d10ba2903ae8b18e5582634fca4a8c-e-1&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="11" />
        </attvalues>
      </node>
      <node id="chunk-625310d5be435bb7decacc8d5c5d55fb-e-3" label="polycrystalline β–NiAl">
        <attvalues>
          <attvalue for="0" value="polycrystalline β–NiAl" />
          <attvalue for="1" value="Substrate Material" />
          <attvalue for="2" value="多晶β-NiAl是一种具有多晶体结构的β相镍铝金属间化合物。在材料科学领域，它是一种重要的基底材料，常被用于在其表面外延生长α-氧化铝（a-alumina）薄膜或涂层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-625310d5be435bb7decacc8d5c5d55fb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-625310d5be435bb7decacc8d5c5d55fb-e-4" label="Coating Interfaces">
        <attvalues>
          <attvalue for="0" value="Coating Interfaces" />
          <attvalue for="1" value="System Component" />
          <attvalue for="2" value="一种系统组件，指热障涂层系统中不同材料层之间的接触面，例如粘结层与热生长氧化物(TGO)之间，以及TGO与陶瓷面层之间的界面。其关键特征是因“脊线”(Ridges)的存在而导致表面不平滑。" />
          <attvalue for="3" value="{&quot;smoothness&quot;: &quot;not smooth&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-625310d5be435bb7decacc8d5c5d55fb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-625310d5be435bb7decacc8d5c5d55fb-e-5" label="Ridges">
        <attvalues>
          <attvalue for="0" value="Ridges" />
          <attvalue for="1" value="Morphological Feature" />
          <attvalue for="2" value="一种存在于α-氧化铝表面的形态学特征，表现为脊状凸起。这种结构会使涂层界面变得不平滑，并且是引发材料损伤的潜在起始点。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-625310d5be435bb7decacc8d5c5d55fb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-625310d5be435bb7decacc8d5c5d55fb-e-6" label="Damage initiation">
        <attvalues>
          <attvalue for="0" value="Damage initiation" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="损伤起始是一种失效机制，指材料内部开始形成微观缺陷（如微裂纹或空洞）的过程。作为宏观失效的前兆，该过程通常首先发生在应力集中部位，例如材料或结构的脊线处。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-625310d5be435bb7decacc8d5c5d55fb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-625310d5be435bb7decacc8d5c5d55fb-e-7" label="TBC life">
        <attvalues>
          <attvalue for="0" value="TBC life" />
          <attvalue for="1" value="System Property" />
          <attvalue for="2" value="TBC life 指热障涂层（Thermal Barrier Coating）的有效工作寿命，是衡量其耐久性与可靠性的关键性能指标。该寿命并非固定值，会受到涂层所附着的基体表面状况等多种物理和化学因素的显著影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-625310d5be435bb7decacc8d5c5d55fb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-625310d5be435bb7decacc8d5c5d55fb-e-8" label="Aluminised coating">
        <attvalues>
          <attvalue for="0" value="Aluminised coating" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="**镀铝涂层 (Aluminised coating)**&#10;&#10;一种含铝的材料涂层，其表面状态对后续的陶瓷沉积过程具有决定性影响。抛光等表面处理工艺对其有益，能改善沉积效果；而喷砂处理则会对涂层造成损害，不利于陶瓷附着。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-625310d5be435bb7decacc8d5c5d55fb" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;aluminised coating&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-625310d5be435bb7decacc8d5c5d55fb-e-8&quot;, &quot;chunk-56221da56587b6ebb1c6eef7e8ed2a6e-e-1&quot;, &quot;chunk-8e4f95988fb5d512b274348d9b3d4dca-e-1&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-625310d5be435bb7decacc8d5c5d55fb-e-9" label="Surface condition">
        <attvalues>
          <attvalue for="0" value="Surface condition" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="作为渗铝涂层的一种材料属性，指其表面的物理和化学状态。该属性是影响其上附着的热障涂层（TBC）使用寿命的关键因素之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-625310d5be435bb7decacc8d5c5d55fb" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-56221da56587b6ebb1c6eef7e8ed2a6e-e-2" label="Ceramic deposition">
        <attvalues>
          <attvalue for="0" value="Ceramic deposition" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="陶瓷沉积是一种制造工艺，通过物理或化学方法将陶瓷材料以薄膜或涂层的形式附着于基材表面，以提升其耐磨、耐腐蚀、隔热等性能。该工艺的效果与质量，常受到基材或预涂层（例如渗铝涂层）的表面状况的显著影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-56221da56587b6ebb1c6eef7e8ed2a6e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-56221da56587b6ebb1c6eef7e8ed2a6e-e-3" label="Grit blasting">
        <attvalues>
          <attvalue for="0" value="Grit blasting" />
          <attvalue for="1" value="Surface Preparation Method" />
          <attvalue for="2" value="喷砂处理是一种利用压缩空气驱动磨料（如砂砾、钢丸）高速冲击工件表面的处理工艺。该工艺通过磨削和冲击作用，达到清洁、除锈、强化或改变表面粗糙度的目的。其强磨蚀性在去除污染的同时，也可能损坏如渗铝层等既有的保护性涂层。" />
          <attvalue for="3" value="{&quot;effect&quot;: &quot;detrimental&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-56221da56587b6ebb1c6eef7e8ed2a6e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Grit-blasting&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b6c046cc51d2c72553ce28c1316afa3c-e-6&quot;, &quot;chunk-56221da56587b6ebb1c6eef7e8ed2a6e-e-3&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-56221da56587b6ebb1c6eef7e8ed2a6e-e-4" label="Polishing">
        <attvalues>
          <attvalue for="0" value="Polishing" />
          <attvalue for="1" value="Surface Treatment" />
          <attvalue for="2" value="一种表面处理工艺，通过去除工件表面的脊状形态等瑕疵，以获得光滑平整的表面。该工艺对渗铝涂层有益，能够改善其表面质量和性能。" />
          <attvalue for="3" value="{&quot;effect&quot;: &quot;beneficial&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-56221da56587b6ebb1c6eef7e8ed2a6e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-56221da56587b6ebb1c6eef7e8ed2a6e-e-9" label="Bond coat">
        <attvalues>
          <attvalue for="0" value="Bond coat" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="作为热障涂层系统中的一个关键金属中间层，它位于陶瓷面层与高温合金基底之间。其主要功能是增强涂层结合力并为基底提供抗氧化保护。在高温下，其表面会生成热生长氧化物（TGO）层，该层的生长状态直接影响涂层的整体寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-56221da56587b6ebb1c6eef7e8ed2a6e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-56221da56587b6ebb1c6eef7e8ed2a6e-e-10" label="O2+ diffusion">
        <attvalues>
          <attvalue for="0" value="O2+ diffusion" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="一种物理扩散机制，指在高温氧化过程中，氧离子穿过已形成的热生长氧化物（TGO）层，与内部的金属基体发生反应。该过程是主导TGO层在金属/氧化物界面处不断增厚，即向内生长的关键控制步骤。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-56221da56587b6ebb1c6eef7e8ed2a6e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-56221da56587b6ebb1c6eef7e8ed2a6e-e-10&quot;, &quot;chunk-68c5be2cf8e0d90b4fdb45e22dc55649-e-2&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-68c5be2cf8e0d90b4fdb45e22dc55649-e-1" label="inward-growing scale">
        <attvalues>
          <attvalue for="0" value="inward-growing scale" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="一种以向内生长为特征的α-氧化铝热生长氧化物层（TGO）。其生长过程由氧离子（O²⁺）沿该氧化物层晶界的扩散所主导和控制，导致在基体与氧化物界面处形成新相。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-68c5be2cf8e0d90b4fdb45e22dc55649" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-68c5be2cf8e0d90b4fdb45e22dc55649-e-3" label="grain boundaries in the a-alumina TGO">
        <attvalues>
          <attvalue for="0" value="grain boundaries in the a-alumina TGO" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="α-氧化铝热生长氧化物（TGO）层中的一种微观结构特征，是构成该氧化物层的各个氧化铝晶粒之间的界面。在高温环境下，这些晶界作为主要的扩散通道，使得氧离子能够沿着其快速迁移，从而主导TGO层的生长过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-68c5be2cf8e0d90b4fdb45e22dc55649" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-68c5be2cf8e0d90b4fdb45e22dc55649-e-3&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-68c5be2cf8e0d90b4fdb45e22dc55649-e-4" label="oxide">
        <attvalues>
          <attvalue for="0" value="oxide" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="在足够高的氧分压条件下，优先在B晶界处形成的一种材料。它的形成会引起材料内部缺陷密度的增加。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-68c5be2cf8e0d90b4fdb45e22dc55649" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-68c5be2cf8e0d90b4fdb45e22dc55649-e-5" label="B-grain boundaries">
        <attvalues>
          <attvalue for="0" value="B-grain boundaries" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="B-晶界是一种位于粘结层中的微观结构特征。它作为一种晶体缺陷，被认为是材料中应力集中的薄弱区域，是导致裂纹萌生的关键位置，从而影响涂层的整体性能与服役寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-68c5be2cf8e0d90b4fdb45e22dc55649" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-68c5be2cf8e0d90b4fdb45e22dc55649-e-5&quot;, &quot;chunk-751499c91bd84a08839fce6991037b26-e-1&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-68c5be2cf8e0d90b4fdb45e22dc55649-e-6" label="TGO/bond coat interface">
        <attvalues>
          <attvalue for="0" value="TGO/bond coat interface" />
          <attvalue for="1" value="Interface" />
          <attvalue for="2" value="bond coat/TGO interface: 指热障涂层（TBC）系统中，粘结层（bond coat）与热生长氧化物（TGO）之间的界面。在多种损伤机制作用下，该界面会发生渐进性粗糙化并形成褶皱（undulations），是影响涂层寿命和失效的关键区域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-68c5be2cf8e0d90b4fdb45e22dc55649" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Bond coat/TGO interface&quot;, &quot;bond coat/TGO interface&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-68c5be2cf8e0d90b4fdb45e22dc55649-e-6&quot;, &quot;chunk-751499c91bd84a08839fce6991037b26-e-4&quot;, &quot;chunk-8f3b49d954f278e4e921209ef50d8c33-e-3&quot;, &quot;chunk-c4027f79a0ee2caae7fc9e91bab6483f-e-7&quot;, &quot;chunk-df31d8a0cc69400a7fd30dcdb24ab502-e-5&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-68c5be2cf8e0d90b4fdb45e22dc55649-e-7" label="oxygen partial pressure">
        <attvalues>
          <attvalue for="0" value="oxygen partial pressure" />
          <attvalue for="1" value="Physical Condition" />
          <attvalue for="2" value="氧分压（oxygen partial pressure）是混合气体中氧气的分压力，为衡量氧气浓度的物理量。作为一个关键的热力学条件，当其数值在特定温度下达到或超过某一物质（如金属）的平衡氧分压阈值时，会驱动该物质发生氧化反应，从而形成相应的氧化物。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-68c5be2cf8e0d90b4fdb45e22dc55649" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-68c5be2cf8e0d90b4fdb45e22dc55649-e-8" label="density of imperfections">
        <attvalues>
          <attvalue for="0" value="density of imperfections" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一项材料属性，定义为因氧化物在B-晶界处优先形成所导致的微观缺陷的分布密度。它量化了材料由于选择性氧化而产生的内部结构不均匀性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-68c5be2cf8e0d90b4fdb45e22dc55649" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-751499c91bd84a08839fce6991037b26-e-2" label="bond coat">
        <attvalues>
          <attvalue for="0" value="bond coat" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="一种位于热障涂层系统中的金属材料层，夹在陶瓷面层与高温合金基体之间。它主要起两个作用：一是为面层提供牢固的机械结合；二是在高温下生成一层致密的热生长氧化物（TGO），以保护基体免受氧化和腐蚀。其内部的β相晶界是形成TGO的关键。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-751499c91bd84a08839fce6991037b26" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-751499c91bd84a08839fce6991037b26-e-5" label="β phase">
        <attvalues>
          <attvalue for="0" value="β phase" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="β相是一种具有高铝扩散速率的材料相。此特性使其成为形成热生长氧化物（TGO）的铝供给源，在氧化过程中，TGO/粘结层界面会优先消耗该相并向其内部推进。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-751499c91bd84a08839fce6991037b26" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-751499c91bd84a08839fce6991037b26-e-6" label="y' phase">
        <attvalues>
          <attvalue for="0" value="y' phase" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="y'相是一种因铝元素耗尽而形成的材料相。在热障涂层等应用中，它被认为是在热生长氧化物(TGO)与粘结层界面处应避免形成的不利物相，其存在通常与涂层性能退化相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-751499c91bd84a08839fce6991037b26" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-751499c91bd84a08839fce6991037b26-e-7" label="aluminium depletion">
        <attvalues>
          <attvalue for="0" value="aluminium depletion" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种由氧化及与基体的相互扩散所引发的物理化学过程。该过程导致材料（尤指高温合金）表层区域的铝元素含量降低或耗尽，并因此形成通常记为γ'的析出相。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-751499c91bd84a08839fce6991037b26" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-751499c91bd84a08839fce6991037b26-e-9" label="interdiffusion with the substrate">
        <attvalues>
          <attvalue for="0" value="interdiffusion with the substrate" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="与衬底的互扩散是一种材料物理过程，指薄膜或涂层与衬底在界面处发生的原子相互渗透、迁移的现象，通常由高温激活。该过程会改变界面处的成分与结构，是导致功能层材料（如铝）损耗或器件性能退化的原因之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-751499c91bd84a08839fce6991037b26" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-751499c91bd84a08839fce6991037b26-e-9&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-751499c91bd84a08839fce6991037b26-e-10" label="aluminium diffusion">
        <attvalues>
          <attvalue for="0" value="aluminium diffusion" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种物理过程，指铝原子在材料相界面处的迁移。由于其在特定相中的扩散速率更快，该过程是导致γ'相晶粒形成的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-751499c91bd84a08839fce6991037b26" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-751499c91bd84a08839fce6991037b26-e-10&quot;, &quot;chunk-8f3b49d954f278e4e921209ef50d8c33-e-1&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8f3b49d954f278e4e921209ef50d8c33-e-2" label="γ' grains">
        <attvalues>
          <attvalue for="0" value="γ' grains" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="γ'相晶粒是一种由铝扩散驱动的微观结构特征，它随时间推移在热生长氧化物(TGO)与粘结层的界面处逐渐形成，并沿该界面分布。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-8f3b49d954f278e4e921209ef50d8c33" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8f3b49d954f278e4e921209ef50d8c33-e-4" label="nucleation events">
        <attvalues>
          <attvalue for="0" value="nucleation events" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="一种物理过程，指材料中新晶粒或新物相核心的形成。其发生密度与涂层的β晶粒尺寸相符，是决定材料最终微观结构的关键步骤。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-8f3b49d954f278e4e921209ef50d8c33" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="210" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8f3b49d954f278e4e921209ef50d8c33-e-5" label="coating's β-grain size">
        <attvalues>
          <attvalue for="0" value="coating's β-grain size" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="涂层中β物相晶粒的平均尺寸。它是一种关键的材料微观结构参数，其大小与形核事件的密度密切相关，通常形核密度越高，最终形成的晶粒尺寸越小。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-8f3b49d954f278e4e921209ef50d8c33" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="210" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8f3b49d954f278e4e921209ef50d8c33-e-7" label="prior β-grain boundaries">
        <attvalues>
          <attvalue for="0" value="prior β-grain boundaries" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="一种显微组织特征，常见于经历固态相变的金属材料（如钛合金和钢）中。它指材料在高温β相区时所形成的晶粒边界，即使在冷却并转变为α相或马氏体等新组织后，这些原始边界的轮廓或“遗迹”依然保留在最终的室温组织中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-8f3b49d954f278e4e921209ef50d8c33" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8f3b49d954f278e4e921209ef50d8c33-e-7&quot;, &quot;chunk-db78ddbf62abad0b3c908872d469b5fa-e-2&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-db78ddbf62abad0b3c908872d469b5fa-e-1" label="leation">
        <attvalues>
          <attvalue for="0" value="leation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="Leation，很可能是nucleation（形核）的拼写错误。该过程指在材料相变初期，新相在特定位置（如原始贝塔晶界）优先形成稳定晶核的现象，是相变开始的标志。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-db78ddbf62abad0b3c908872d469b5fa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-db78ddbf62abad0b3c908872d469b5fa-e-3" label="microstructural model of the damage evolution">
        <attvalues>
          <attvalue for="0" value="microstructural model of the damage evolution" />
          <attvalue for="1" value="Model" />
          <attvalue for="2" value="一种从微观结构层面描述损伤演化过程的理论模型。该模型为特定观测现象提供了另一种解释，如果成立，其解释力足以替代“棘轮机制”（ratcheting mechanism），使后者在解释这些现象时变得不再必要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-db78ddbf62abad0b3c908872d469b5fa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="115" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-db78ddbf62abad0b3c908872d469b5fa-e-4" label="ratcheting mechanism">
        <attvalues>
          <attvalue for="0" value="ratcheting mechanism" />
          <attvalue for="1" value="Mechanism" />
          <attvalue for="2" value="一种基于力学原理的理论机制，用于解释特定现象中累进、不可逆的演化过程。该机制提供了一种宏观解释，但如果存在更精确的微观结构损伤演化模型，则可能无需援引此机制，因为它可被更基础的微观解释所取代。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-db78ddbf62abad0b3c908872d469b5fa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="115" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-db78ddbf62abad0b3c908872d469b5fa-e-5" label="mechanics">
        <attvalues>
          <attvalue for="0" value="mechanics" />
          <attvalue for="1" value="Scientific Field" />
          <attvalue for="2" value="力学是物理学的一个分支，研究物体在力的作用下的运动规律以及物体间的相互作用。它为分析物体的静止或运动状态提供了基本原理，是土木、机械等众多工程技术学科的理论基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-db78ddbf62abad0b3c908872d469b5fa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="115" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-db78ddbf62abad0b3c908872d469b5fa-e-6" label="oxide phases">
        <attvalues>
          <attvalue for="0" value="oxide phases" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="一类由金属氧化物构成的材料相，包含尖晶石等具体类型。其主要特征是在α-氧化铝（a-alumina）材料的表面或其附近区域形成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-db78ddbf62abad0b3c908872d469b5fa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-db78ddbf62abad0b3c908872d469b5fa-e-9" label="NiCrAlY-type bond coats">
        <attvalues>
          <attvalue for="0" value="NiCrAlY-type bond coats" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种以镍(Ni)为基，添加铬(Cr)、铝(Al)、钇(Y)的合金材料，通常在热障涂层系统中用作粘结层。其核心功能是在高温下形成一层致密、稳定的氧化铝保护膜，以增强涂层附着力并保护基体合金免受氧化腐蚀。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-db78ddbf62abad0b3c908872d469b5fa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-489a70985937a8298a8310efcc20db59-e-2" label="NiCrAlY-type bond coats">
        <attvalues>
          <attvalue for="0" value="NiCrAlY-type bond coats" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="一种以镍、铬、铝、钇为主要成分的合金粘结涂层。作为热障涂层(TBC)系统的关键中间层，它用于增强陶瓷面层与金属基体的结合力，并提供高温抗氧化保护。在其长期服役过程中，常会观察到尖晶石氧化物的生成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-489a70985937a8298a8310efcc20db59" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-489a70985937a8298a8310efcc20db59-e-5" label="TBC systems">
        <attvalues>
          <attvalue for="0" value="TBC systems" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="TBC systems是一种用于高温防护的热障涂层系统。它采用铝化物涂层作为关键组分，其区别性特征是在特定工作条件下，涂层内部会生成石榴石（garnets）相结构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-489a70985937a8298a8310efcc20db59" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-489a70985937a8298a8310efcc20db59-e-8" label="overlay-type bond coats">
        <attvalues>
          <attvalue for="0" value="overlay-type bond coats" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="罩面型粘结涂层（Overlay-type bond coats）是用于热障涂层（TBC）体系中的一类关键涂层。它通常以MCrAlY合金形式直接沉积在基体上，作为陶瓷面层与基体间的中间层，主要作用是提供抗高温氧化性能，并增强涂层体系的附着力与整体寿命，与扩散型涂层相对应。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-489a70985937a8298a8310efcc20db59" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-489a70985937a8298a8310efcc20db59-e-9" label="TBC life">
        <attvalues>
          <attvalue for="0" value="TBC life" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="TBC寿命是一项衡量热障涂层（TBC）系统性能的关键指标，指涂层能够有效工作的时长。其寿命是陶瓷面层与粘结层组合的函数，因此会因粘结层类型（如扩散型或覆盖型）的不同而存在显著差异。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-489a70985937a8298a8310efcc20db59" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-489a70985937a8298a8310efcc20db59-e-10" label="ceramic/bond coat combination">
        <attvalues>
          <attvalue for="0" value="ceramic/bond coat combination" />
          <attvalue for="1" value="System Component" />
          <attvalue for="2" value="作为热障涂层（TBC）系统的关键组成部分，它是由陶瓷面层和金属粘结层构成的材料体系。该组合的材料选择、性能匹配及相互作用，是决定整个涂层系统可靠性与服役寿命的核心因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-489a70985937a8298a8310efcc20db59" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0911f0446e7a84e6ad1cfebbf249a936-e-1" label="TBC life">
        <attvalues>
          <attvalue for="0" value="TBC life" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="**TBC life** 是衡量热障涂层（TBC）在高温工况下维持其隔热保护功能直至失效的时间或循环次数的关键性能指标。它用于评估涂层的耐久性和可靠性，其长短是基体化学成分等多种因素的函数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-0911f0446e7a84e6ad1cfebbf249a936" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="76" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0911f0446e7a84e6ad1cfebbf249a936-e-2" label="Substrate chemistry">
        <attvalues>
          <attvalue for="0" value="Substrate chemistry" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="基体化学成分是一种关键材料属性，指涂层体系中基底材料的化学组成。该成分是影响并决定热障涂层（TBC）寿命的关键因素，其作用效果会因铂扩散粘结层等中间层的存在而加剧。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-0911f0446e7a84e6ad1cfebbf249a936" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="76" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0911f0446e7a84e6ad1cfebbf249a936-e-3" label="Ceramic/bond coat combination">
        <attvalues>
          <attvalue for="0" value="Ceramic/bond coat combination" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="一种由陶瓷面层和金属粘结层构成的复合涂层结构。陶瓷面层提供隔热、耐磨或抗腐蚀等核心功能，而其下方的金属粘结层则增强涂层与基体的附着力，并缓解热失配应力。该组合是热障涂层等高性能防护系统中的关键部分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-0911f0446e7a84e6ad1cfebbf249a936" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="326" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-0911f0446e7a84e6ad1cfebbf249a936-e-4" label="Platinum-diffused 'low-cost' bond coat">
        <attvalues>
          <attvalue for="0" value="Platinum-diffused 'low-cost' bond coat" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="铂扩散“低成本”粘结涂层是一种通过铂扩散工艺制备的经济型材料。作为热障涂层的粘结层，它无需进行渗铝处理，简化了工艺流程，但会加剧基体化学成分对涂层整体服役寿命的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0911f0446e7a84e6ad1cfebbf249a936" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Platinum-diffused 'low-cost' bond coats&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0911f0446e7a84e6ad1cfebbf249a936-e-4&quot;]}]" />
          <attvalue for="9" value="76" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0911f0446e7a84e6ad1cfebbf249a936-e-5" label="Aluminisation treatment">
        <attvalues>
          <attvalue for="0" value="Aluminisation treatment" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种表面改性工艺，通过将铝扩散渗入金属基材表面，形成富铝或铝化物保护层。该工艺旨在显著提高材料的高温抗氧化和抗腐蚀性能，常作为一种经济型粘结层的制备方法。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-0911f0446e7a84e6ad1cfebbf249a936" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="76" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0911f0446e7a84e6ad1cfebbf249a936-e-6" label="Modern gas turbine">
        <attvalues>
          <attvalue for="0" value="Modern gas turbine" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="现代燃气轮机是一种先进的旋转式动力机械，在极端高温高压条件下运行。它通过燃烧燃料产生高温燃气，驱动涡轮高速旋转做功。因其高效率和功率密度，广泛应用于发电、航空推进和工业驱动领域，是现代工业的核心动力装置之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0911f0446e7a84e6ad1cfebbf249a936" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0911f0446e7a84e6ad1cfebbf249a936-e-7" label="Coating technologies">
        <attvalues>
          <attvalue for="0" value="Coating technologies" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="涂层技术 (Coating technologies) 是一类在涡轮部件表面制备保护涂层，以抵御氧化和腐蚀的技术总称。其主要工艺包括电子束物理气相沉积(EB-PVD)、等离子喷涂(PS)和化学气相沉积(CVD)等。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-0911f0446e7a84e6ad1cfebbf249a936" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Coating Technologies&quot;, &quot;Coatings technologies&quot;, &quot;Coatings technology&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0911f0446e7a84e6ad1cfebbf249a936-e-7&quot;, &quot;chunk-04fc5332fa43dcac6331c45b022dd378-e-1&quot;, &quot;chunk-4d89b1c6dd9d01d4a51ca83d9e6e5c24-e-8&quot;, &quot;chunk-3f32f2a159ceed7150fba353307d3969-e-6&quot;, &quot;chunk-ece73a04275b10b6ad2874686306213a-e-8&quot;, &quot;chunk-6cc9936949c5f333eaac7910b952ef48-e-2&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-0911f0446e7a84e6ad1cfebbf249a936-e-8" label="Components">
        <attvalues>
          <attvalue for="0" value="Components" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="指构成大型总成（如燃气轮机）的零件或构件。它们通常在高温、腐蚀等严苛工况下运行，因此必须通过涂层技术进行表面防护，以保障其性能、可靠性与使用寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-0911f0446e7a84e6ad1cfebbf249a936" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-04fc5332fa43dcac6331c45b022dd378-e-2" label="Turbine components">
        <attvalues>
          <attvalue for="0" value="Turbine components" />
          <attvalue for="1" value="Component Category" />
          <attvalue for="2" value="涡轮部件是指构成涡轮机的各类关键组件，是涡轮机的核心部分。该类别包括涡轮叶片、导向叶片和燃烧室等。因其工作在高温高压的恶劣环境中，通常需要先进涂层技术加以保护，以延长使用寿命并确保性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-04fc5332fa43dcac6331c45b022dd378" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-04fc5332fa43dcac6331c45b022dd378-e-5" label="Turbine blading">
        <attvalues>
          <attvalue for="0" value="Turbine blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮叶片是涡轮机的核心做功部件，指位于高温高压气流通道中的一系列叶片。其关键功能是将气流的动能和热能，转化为驱动涡轮转子高速旋转的机械功，因工作环境恶劣而需要特殊保护。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-04fc5332fa43dcac6331c45b022dd378" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-04fc5332fa43dcac6331c45b022dd378-e-6" label="Nozzle guide vanes">
        <attvalues>
          <attvalue for="0" value="Nozzle guide vanes" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="喷管导向叶片(Nozzle guide vanes)是燃气轮机中的一组关键静止叶片（静子），位于燃烧室与涡轮转子之间。其功能是将高温高压燃气加速，并以最佳角度导向后续的涡轮动叶，从而高效驱动涡轮旋转做功。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-04fc5332fa43dcac6331c45b022dd378" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;nozzle guide vanes&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-04fc5332fa43dcac6331c45b022dd378-e-6&quot;, &quot;chunk-19fc204ae20f257516bfb4e63a049a77-e-7&quot;, &quot;chunk-355e3199ba9477d489a169627728bb4e-e-1&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-04fc5332fa43dcac6331c45b022dd378-e-9" label="Electron beam physical vapour deposition (EB-PVD)">
        <attvalues>
          <attvalue for="0" value="Electron beam physical vapour deposition (EB-PVD)" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="电子束物理气相沉积（Electron Beam-Physical Vapor Deposition, EB-PVD）是一种物理气相沉积（PVD）技术。它在真空环境下，利用高能电子束轰击并蒸发源材料，使原子或分子气相沉积到基体表面，形成薄膜或涂层。该工艺常用于制备结构致密、呈柱状晶特征的高性能涂层，如航空发动机涡轮叶片上的热障涂层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-04fc5332fa43dcac6331c45b022dd378" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Aluminised coating&quot;, &quot;EB-PVD&quot;, &quot;EB-PVD (Electron Beam-Physical Vapor Deposition)&quot;, &quot;EB-PVD Technology&quot;, &quot;EB-PVD method&quot;, &quot;EB-PVD process&quot;, &quot;EB-PVD processing&quot;, &quot;Electron beam-physical vapor deposition&quot;, &quot;electron beam deposition&quot;, &quot;electron beam physical [deposition]&quot;, &quot;electron beam physical vapour deposition&quot;, &quot;electron beam physical vapour deposition (EB-PVD)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a4fbcaedb1a3455b29f18439a3d53ae7-e-8&quot;, &quot;chunk-04fc5332fa43dcac6331c45b022dd378-e-9&quot;, &quot;chunk-b39db212478fb453fe79022a544f44e9-e-9&quot;, &quot;chunk-069e9bb3e2c8dfdab86052450cf45cd2-e-1&quot;, &quot;chunk-c209c0babaaedf7bee28e398db9c505e-e-3&quot;, &quot;chunk-8a98946fce80230f54608d957bf8fa18-e-11&quot;, &quot;chunk-821a3f267f9ff96b58c19914c2c7eff8-e-3&quot;, &quot;chunk-15ec833d634a94516c077a6a065429ad-e-2&quot;, &quot;chunk-d55298f42964ce23c30b0bcafa72ab6c-e-2&quot;, &quot;chunk-fab5556d25e36a12308d5e081229601a-e-13&quot;, &quot;chunk-2b7a9fe88ca8d6ac202cedf8f0e4d421-e-10&quot;, &quot;chunk-491e59c42061a40a1fe533ef4ec8d245-e-13&quot;, &quot;chunk-e780ac83d97fe15870adf76ec9226ed9-e-8&quot;, &quot;chunk-be8d9004ced79264b7784b3065b5da94-e-2&quot;, &quot;chunk-6f4c84e8661d1e3a5f359969b56cd45d-e-3&quot;, &quot;chunk-22e09ee7f38295f048d1264e0df1823f-e-3&quot;, &quot;chunk-f35df7e25f9cadfabe05aeb0e4fee010-e-7&quot;, &quot;chunk-31cd2366f102780cc28ad1a099e8127d-e-4&quot;, &quot;chunk-356a95a5ba9ccf9ed595619218c5107b-e-13&quot;, &quot;chunk-e4ee2b4726b7ab716e9f01d209b1fd11-e-5&quot;, &quot;chunk-a489ad53b1434170d93d0b020b96b655-e-10&quot;, &quot;chunk-047adffb203a8742a16f24b4f8936843-e-2&quot;, &quot;chunk-a7d8669831007c6978b4f97d67359deb-e-6&quot;, &quot;chunk-411c58f6cae102022f2bf19e1c6ff24d-e-8&quot;, &quot;chunk-e0eaec940932f96aaacae0dab5000c8c-e-6&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="10" />
        </attvalues>
      </node>
      <node id="chunk-04fc5332fa43dcac6331c45b022dd378-e-11" label="Chemical Vapour Deposition (CVD)">
        <attvalues>
          <attvalue for="0" value="Chemical Vapour Deposition (CVD)" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="化学气相沉积（CVD）工艺是一种先进的制造技术，通过气态前驱体在基材表面发生化学反应，以沉积形成固态薄膜或涂层。根据工艺参数的调控，该方法可用于在涂层上制备具有特定微观结构，例如脊状形态（ridged morphology）的表面。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-04fc5332fa43dcac6331c45b022dd378" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;CVD&quot;, &quot;CVD process&quot;, &quot;Chemical vapour deposition (CVD)&quot;, &quot;chemical vapour deposition&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-411c58f6cae102022f2bf19e1c6ff24d-e-6&quot;, &quot;chunk-56221da56587b6ebb1c6eef7e8ed2a6e-e-6&quot;, &quot;chunk-04fc5332fa43dcac6331c45b022dd378-e-11&quot;, &quot;chunk-b39db212478fb453fe79022a544f44e9-e-1&quot;, &quot;chunk-fbbf41abcd4950c59415caeec768db40-e-8&quot;, &quot;chunk-8a98946fce80230f54608d957bf8fa18-e-9&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-b39db212478fb453fe79022a544f44e9-e-3" label="PS">
        <attvalues>
          <attvalue for="0" value="PS" />
          <attvalue for="1" value="Fabrication Process" />
          <attvalue for="2" value="PS是一种用于制备覆盖涂层（Overlay coatings）的制造工艺。在当前上下文中，PS是该工艺的缩写，其具体全称未被提及。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-b39db212478fb453fe79022a544f44e9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b39db212478fb453fe79022a544f44e9-e-4" label="Diffusion-type aluminide bond coat">
        <attvalues>
          <attvalue for="0" value="Diffusion-type aluminide bond coat" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="扩散涂层是一种通过原子扩散工艺，将涂层元素渗入基材表面形成的冶金结合保护层。它主要用于提高材料的高温抗氧化与抗腐蚀性能。在高温服役中，涂层与基材间的元素互扩散可能诱导拓扑密排相（TCP相）的形成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-b39db212478fb453fe79022a544f44e9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Aluminide diffusion coating&quot;, &quot;CVD diffusion-type aluminide&quot;, &quot;Diffusion-type aluminide bond coats&quot;, &quot;Diffusion-type coatings&quot;, &quot;Simple aluminide diffusion coatings&quot;, &quot;aluminide coating&quot;, &quot;aluminide diffusion coating&quot;, &quot;aluminide-type diffusion coatings&quot;, &quot;diffusion aluminide coatings&quot;, &quot;diffusion coatings&quot;, &quot;diffusion-based bond coats&quot;, &quot;diffusion-type aluminide bond coats&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ef2350bf97175d40c9900d549c35b9f1-e-5&quot;, &quot;chunk-5abc3c05849dadfca952537bf1c8dc41-e-1&quot;, &quot;chunk-489a70985937a8298a8310efcc20db59-e-7&quot;, &quot;chunk-b39db212478fb453fe79022a544f44e9-e-4&quot;, &quot;chunk-069e9bb3e2c8dfdab86052450cf45cd2-e-2&quot;, &quot;chunk-aedbe4412d2761c1e12ab362e44dea99-e-1&quot;, &quot;chunk-e09ab40c542042f5c2612bfc3901180e-e-1&quot;, &quot;chunk-5d7f538c5d3017feeaf09d39e949ccdc-e-6&quot;, &quot;chunk-15c033042f1da840c39554ca327f7acd-e-1&quot;, &quot;chunk-8031eb636b002393280031950b878895-e-3&quot;, &quot;chunk-0440023a44a202881a859e66f23ec3de-e-4&quot;, &quot;chunk-480d57aecb221d6739d918eba055fa57-e-6&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="16" />
        </attvalues>
      </node>
      <node id="chunk-b39db212478fb453fe79022a544f44e9-e-7" label="Thermal Barrier Coatings (TBCs)">
        <attvalues>
          <attvalue for="0" value="Thermal Barrier Coatings (TBCs)" />
          <attvalue for="1" value="Coating System" />
          <attvalue for="2" value="热障涂层（TBCs）是一种先进的复合涂层系统，由起隔热作用的陶瓷顶层与起过渡和抗氧化作用的金属粘结层（扩散型铝化物或覆盖涂层）构成。其核心功能是保护航空发动机、燃气轮机等高温环境下的金属部件免受热损伤，延长其服役寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-b39db212478fb453fe79022a544f44e9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b39db212478fb453fe79022a544f44e9-e-8" label="Ceramic top coat">
        <attvalues>
          <attvalue for="0" value="Ceramic top coat" />
          <attvalue for="1" value="Coating Layer" />
          <attvalue for="2" value="陶瓷面层是热障涂层(TBCs)的关键组成部分，主要起到隔热作用。它通常采用电子束物理气相沉积(EB-PVD)工艺，在扩散型涂层或覆盖型涂层等粘结层之上沉积而成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-b39db212478fb453fe79022a544f44e9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b39db212478fb453fe79022a544f44e9-e-10" label="NiCoCrAlY">
        <attvalues>
          <attvalue for="0" value="NiCoCrAlY" />
          <attvalue for="1" value="Material Composition" />
          <attvalue for="2" value="NiCoCrAlY是一种镍钴基MCrAlY高温合金，由镍(Ni)、钴(Co)、铬(Cr)、铝(Al)、钇(Y)组成。它主要用作抗高温氧化和热腐蚀的覆层涂层，其防护性源于表面形成的稳定氧化层，而钇元素能显著增强该氧化层的附着力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-b39db212478fb453fe79022a544f44e9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-069e9bb3e2c8dfdab86052450cf45cd2-e-4" label="TBC systems">
        <attvalues>
          <attvalue for="0" value="TBC systems" />
          <attvalue for="1" value="Technology" />
          <attvalue for="2" value="热障涂层系统（TBCs）是一种应用于燃气轮机等高温部件的先进多层涂层技术。它通常由陶瓷面层、粘结层和高温合金基体构成，作用是提供热绝缘以保护基体，其主要失效模式为涂层剥落。" />
          <attvalue for="3" value="{&quot;function&quot;: &quot;thermal insulation&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-069e9bb3e2c8dfdab86052450cf45cd2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-069e9bb3e2c8dfdab86052450cf45cd2-e-7" label="thermal cycling">
        <attvalues>
          <attvalue for="0" value="thermal cycling" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="热循环是指材料经受反复高低温变化的过程。这种交变温度会在材料内部引起热应力，是导致材料热疲劳、性能退化乃至发生剥落失效的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-069e9bb3e2c8dfdab86052450cf45cd2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-069e9bb3e2c8dfdab86052450cf45cd2-e-7&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-069e9bb3e2c8dfdab86052450cf45cd2-e-8" label="ceramic top coat">
        <attvalues>
          <attvalue for="0" value="ceramic top coat" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="热障涂层(TBC)系统的关键组成部分，通常为陶瓷材料。它通过电子束物理气相沉积(EB-PVD)等方法沉积在粘结层(如渗铝化物或覆盖涂层)之上，作为最外层，提供主要的隔热保护功能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-069e9bb3e2c8dfdab86052450cf45cd2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-069e9bb3e2c8dfdab86052450cf45cd2-e-9" label="bond coat">
        <attvalues>
          <attvalue for="0" value="bond coat" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;热障涂层（TBC）系统的关键中间层，位于陶瓷顶涂层与金属基体之间。它通常是扩散渗铝涂层或覆盖涂层等类型，主要作用是增强涂层结合强度并为基体提供抗氧化保护。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-069e9bb3e2c8dfdab86052450cf45cd2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-069e9bb3e2c8dfdab86052450cf45cd2-e-10" label="superalloy substrate">
        <attvalues>
          <attvalue for="0" value="superalloy substrate" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种由高温合金制成的基底材料，是热障涂层系统（TBCs）的关键组成部分。它为整个涂层体系提供结构支撑，并承受高温环境下的机械和热负荷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-069e9bb3e2c8dfdab86052450cf45cd2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d1fe7409ba7204cdc10b650e7502783c-e-1" label="TBC systems">
        <attvalues>
          <attvalue for="0" value="TBC systems" />
          <attvalue for="1" value="Coating System" />
          <attvalue for="2" value="热障涂层（TBC）系统是一种应用于高温合金基底的多层材料系统，通常由粘结层和陶瓷顶涂层组成。它旨在提供隔热保护，使部件能在更高温度下工作，其失效机制和涂层寿命是评估其性能的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-d1fe7409ba7204cdc10b650e7502783c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="42" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-d1fe7409ba7204cdc10b650e7502783c-e-2" label="Top coat">
        <attvalues>
          <attvalue for="0" value="Top coat" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="面层 (Top coat) 是热障涂层 (TBC) 系统的核心隔热层，位于粘结层之上，是涂层结构的最外层。它直接暴露于高温服役环境，主要功能是提供隔热保护，以降低金属基体的温度，抵御高温氧化和腐蚀。该层通常由低热导率的陶瓷材料（如氧化钇稳定氧化锆）构成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-d1fe7409ba7204cdc10b650e7502783c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="42" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d1fe7409ba7204cdc10b650e7502783c-e-3" label="Bond coat">
        <attvalues>
          <attvalue for="0" value="Bond coat" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="粘结涂层是热障涂层（TBC）系统中的一个关键金属层，位于基体与陶瓷顶涂层之间。其主要功能是增强顶涂层的附着力，缓解二者因热膨胀不匹配产生的应力，并保护基体免受高温氧化和腐蚀。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d1fe7409ba7204cdc10b650e7502783c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="42" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d1fe7409ba7204cdc10b650e7502783c-e-4" label="Superalloy substrate">
        <attvalues>
          <attvalue for="0" value="Superalloy substrate" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="指由高温合金制成的基底或构件。在热障涂层（TBC）体系中，它既是承载结构，也是涂层保护的对象。涂层沉积于其上，用以抵御极端高温和氧化环境，从而延长其服役寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d1fe7409ba7204cdc10b650e7502783c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="42" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d1fe7409ba7204cdc10b650e7502783c-e-5" label="Coating life">
        <attvalues>
          <attvalue for="0" value="Coating life" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="一项衡量热障涂层（TBC）系统耐久性的关键性能指标，定义为涂层在规定服役条件下，能够有效发挥隔热、抗氧化等保护功能直至失效的时间。它是评估涂层可靠性与服役期限的核心依据，其最大化是涂层设计的关键目标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d1fe7409ba7204cdc10b650e7502783c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="42" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d1fe7409ba7204cdc10b650e7502783c-e-6" label="Mechanisms of failure">
        <attvalues>
          <attvalue for="0" value="Mechanisms of failure" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="一种导致热障涂层系统（TBCs）失效的现象，具体表现为一系列物理化学过程。其发生和演化路径取决于所使用的涂层材料与制备工艺，是决定涂层寿命的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-d1fe7409ba7204cdc10b650e7502783c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="42" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-d1fe7409ba7204cdc10b650e7502783c-e-7" label="Processes">
        <attvalues>
          <attvalue for="0" value="Processes" />
          <attvalue for="1" value="Factor" />
          <attvalue for="2" value="工艺（Processes）是与材料共同作用，影响热障涂层（TBC）体系失效机制的一个关键因素。它涵盖了涂层的制备、加工、服役等一系列具体的操作流程与环境条件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d1fe7409ba7204cdc10b650e7502783c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d1fe7409ba7204cdc10b650e7502783c-e-7&quot;]}]" />
          <attvalue for="9" value="42" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d1fe7409ba7204cdc10b650e7502783c-e-8" label="Coating materials">
        <attvalues>
          <attvalue for="0" value="Coating materials" />
          <attvalue for="1" value="Factor" />
          <attvalue for="2" value="指用于热障涂层（TBC）系统的材料。其成分、微观结构和物理化学性能，是与制备工艺等因素共同决定涂层系统最终失效机制、性能和服役寿命的关键内在因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-d1fe7409ba7204cdc10b650e7502783c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="42" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d1fe7409ba7204cdc10b650e7502783c-e-10" label="Extra temperature capability">
        <attvalues>
          <attvalue for="0" value="Extra temperature capability" />
          <attvalue for="1" value="Benefit" />
          <attvalue for="2" value="由热障涂层（TBC）系统提供的一项关键益处，指它能使部件在超出基材固有耐温极限的更高温度下可靠运行的能力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-d1fe7409ba7204cdc10b650e7502783c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="42" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3bddba5642b8475906b4fe90443b6049-e-1" label="thermal barrier coating system">
        <attvalues>
          <attvalue for="0" value="thermal barrier coating system" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="热障涂层系统是一种先进的多层材料系统，用于为金属基体提供高温隔热保护。它通常由起主要隔热作用的陶瓷面层和增强涂层附着力的金属粘结层构成，广泛应用于航空发动机及燃气轮机的热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-3bddba5642b8475906b4fe90443b6049" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="116" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3bddba5642b8475906b4fe90443b6049-e-2" label="bond coat">
        <attvalues>
          <attvalue for="0" value="bond coat" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="粘结层（bond coat）是热障涂层系统中的一个关键中间层，位于陶瓷面层与金属基体之间。其主要功能是增强面层的附着力，并为基体提供高温抗氧化和抗腐蚀保护，是确保整个涂层系统结构完整性和耐久性的核心。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-3bddba5642b8475906b4fe90443b6049" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="116" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3bddba5642b8475906b4fe90443b6049-e-3" label="ceramic top coat">
        <attvalues>
          <attvalue for="0" value="ceramic top coat" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="陶瓷面层是热障涂层系统的关键组成部分和最外层。它直接暴露于高温环境中，利用其低热导率特性为底层基体提供主要的隔热保护，以防止基体在高温下过热失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-3bddba5642b8475906b4fe90443b6049" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="116" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3bddba5642b8475906b4fe90443b6049-e-5" label="turbine aerofoil">
        <attvalues>
          <attvalue for="0" value="turbine aerofoil" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮翼型是燃气轮机（如航空发动机）中的关键部件，通常指其动叶或静叶。它具有经精确设计的翼型剖面，能从高温高速的燃气流中提取能量，驱动涡轮转子旋转做功。为抵御极端工作温度，其表面常需应用热障涂层进行防护。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3bddba5642b8475906b4fe90443b6049" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-237995b9cf6d28ae47223438bc5c64d5-e-3" label="Heat">
        <attvalues>
          <attvalue for="0" value="Heat" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="热（Heat）是一种物理现象，指因温度差而从较热物体传递到较冷物体的能量。它是能量传递的一种基本形式，其本质是物质内部微观粒子无规则运动的体现。在国际单位制中，热的单位是焦耳（J）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-237995b9cf6d28ae47223438bc5c64d5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-237995b9cf6d28ae47223438bc5c64d5-e-4" label="Turbine blading">
        <attvalues>
          <attvalue for="0" value="Turbine blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮叶片是燃气轮机或喷气发动机的关键旋转部件，由一组翼型叶片构成，用于从高温燃气流中提取能量。为承受极端工作温度，其表面常应用热障涂层进行隔热保护，以防止基体金属过热。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-237995b9cf6d28ae47223438bc5c64d5" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a9fc67de05915b361fe22b50c698339d-e-2" label="High-Pressure (HP) Turbine Blading">
        <attvalues>
          <attvalue for="0" value="High-Pressure (HP) Turbine Blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="高压涡轮叶片（High-Pressure Turbine Blading）是燃气轮机高压段的核心旋转部件。它具有含前缘和后缘的翼型结构，用于从高温高压气流中提取能量。为抵御极端工作温度，其表面常应用热障涂层进行防护。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a9fc67de05915b361fe22b50c698339d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a9fc67de05915b361fe22b50c698339d-e-4" label="Leading Edge">
        <attvalues>
          <attvalue for="0" value="Leading Edge" />
          <attvalue for="1" value="Component Part" />
          <attvalue for="2" value="作为高压(HP)涡轮叶片的最前端边缘，它直接承受并引导来自燃烧室的高温高速气流。该部件是热负荷与机械应力高度集中的关键部位，因此是涂层剥落等损伤现象的易发区域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a9fc67de05915b361fe22b50c698339d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Leading edge&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a9fc67de05915b361fe22b50c698339d-e-4&quot;, &quot;chunk-a6f8ce7a7c55e9b6f962543810b6ee71-e-8&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a9fc67de05915b361fe22b50c698339d-e-5" label="Trailing Edge">
        <attvalues>
          <attvalue for="0" value="Trailing Edge" />
          <attvalue for="1" value="Component Location" />
          <attvalue for="2" value="作为高压涡轮叶片的一部分，后缘（Trailing Edge）是指叶片翼型最末端的锋利边缘。它是叶片压力面和吸力面气流的交汇点，其几何形状和厚度对涡轮的空气动力学性能、效率及冷却效果有关键影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a9fc67de05915b361fe22b50c698339d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Trailing edge of the turbine blade&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a9b18faea9fc2dc16504c23ff224a743-e-2&quot;, &quot;chunk-a9fc67de05915b361fe22b50c698339d-e-5&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a9fc67de05915b361fe22b50c698339d-e-6" label="Engine Testing">
        <attvalues>
          <attvalue for="0" value="Engine Testing" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="发动机测试是一种试验过程，旨在通过模拟严苛的运行工况，评估发动机及其部件（如涂层叶片）的性能、耐久性和可靠性，并识别如涂层剥落等潜在失效模式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a9fc67de05915b361fe22b50c698339d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a6f8ce7a7c55e9b6f962543810b6ee71-e-1" label="High-pressure turbine blading">
        <attvalues>
          <attvalue for="0" value="High-pressure turbine blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="高压涡轮叶片是航空发动机（如Trent 500）的关键组件。它由一组包含前缘等结构的叶片构成，直接在高温燃气流中运行。其核心功能是从高速气流中提取能量，以驱动高压压气机旋转，是决定发动机性能和效率的核心部件之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-a6f8ce7a7c55e9b6f962543810b6ee71" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a6f8ce7a7c55e9b6f962543810b6ee71-e-6" label="Trent 500 engine">
        <attvalues>
          <attvalue for="0" value="Trent 500 engine" />
          <attvalue for="1" value="Product" />
          <attvalue for="2" value="罗尔斯·罗伊斯公司研制的Trent 500是一款大涵道比涡轮风扇发动机，隶属特伦特（Trent）发动机系列。它是空中客车A340-500与A340-600机型的唯一动力装置，其高压涡轮叶片是其关键组件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a6f8ce7a7c55e9b6f962543810b6ee71" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a6f8ce7a7c55e9b6f962543810b6ee71-e-6&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6c012ee00f9a31a25711418938f2f2ba-e-2" label="Single-crystal superalloy blading">
        <attvalues>
          <attvalue for="0" value="Single-crystal superalloy blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种由单晶高温合金铸造而成的高性能构件，通常指涡轮发动机中的空心冷却叶片。该叶片具有精确的壁厚和导热特性，其内外表面形成复杂的冷却结构，并常施加热障涂层以抵御极端高温。" />
          <attvalue for="3" value="{&quot;wall thickness&quot;: &quot;5 mm&quot;, &quot;thermal conductivity&quot;: &quot;100 W/(mK)&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-6c012ee00f9a31a25711418938f2f2ba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-6c012ee00f9a31a25711418938f2f2ba-e-3" label="Outer Surface">
        <attvalues>
          <attvalue for="0" value="Outer Surface" />
          <attvalue for="1" value="Component Part" />
          <attvalue for="2" value="单晶高温合金叶片的外部表面。作为叶片的一个组成部分，该表面直接暴露于高温燃气流中，是与工作环境发生热交换的关键界面。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;1000 °C&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-6c012ee00f9a31a25711418938f2f2ba" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;outer surface&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-6c012ee00f9a31a25711418938f2f2ba-e-3&quot;, &quot;chunk-2723cf8c1579af89abde800442361a57-e-5&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-6c012ee00f9a31a25711418938f2f2ba-e-4" label="Inner Surface">
        <attvalues>
          <attvalue for="0" value="Inner Surface" />
          <attvalue for="1" value="Component Part" />
          <attvalue for="2" value="指单晶高温合金叶片中，为实现内部冷却功能而设计的表面。它作为关键的热交换界面，与内部流动的冷却介质直接接触，从而高效地将叶片在高温燃气中吸收的热量传导并带走。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;800 °C&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-6c012ee00f9a31a25711418938f2f2ba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9e8ea14457e39729a875ffa2ee3efdb0-e-2" label="Blading">
        <attvalues>
          <attvalue for="0" value="Blading" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="指燃气轮机或航空发动机中的叶片组件，是承受高温和高压的关键部件。其表面常施加一层热障涂层（TBC），用于隔热并延长其在高负荷环境下的使用寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-9e8ea14457e39729a875ffa2ee3efdb0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9e8ea14457e39729a875ffa2ee3efdb0-e-3" label="Heat Transfer Coefficient">
        <attvalues>
          <attvalue for="0" value="Heat Transfer Coefficient" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="传热系数（Heat Transfer Coefficient），又称对流传热系数，是表征对流换热过程强度的物理量。它定义为在单位温差驱动下，单位面积上流体与固体表面之间通过对流方式传递的热量，数值上等于热通量与温差之比。" />
          <attvalue for="3" value="{&quot;state&quot;: &quot;unaltered&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-9e8ea14457e39729a875ffa2ee3efdb0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Heat transfer coefficient&quot;, &quot;Heat transfer coefficients&quot;, &quot;heat transfer coefficient&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9e8ea14457e39729a875ffa2ee3efdb0-e-3&quot;, &quot;chunk-9b8241b51916aa0fe236ff3e6c045cdf-e-2&quot;, &quot;chunk-ee2c916092b69050b73e7898f576b082-e-4&quot;, &quot;chunk-6261bb103f1582e3eddbed3d2b069224-e-5&quot;, &quot;chunk-523637843506c3574fe003659e8f0b3e-e-1&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-9e8ea14457e39729a875ffa2ee3efdb0-e-4" label="Steady-state Flux">
        <attvalues>
          <attvalue for="0" value="Steady-state Flux" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="稳态热通量（Steady-state Heat Flux）指在热传导达到稳定状态，即系统内各点温度不随时间变化时，单位时间内垂直通过单位面积的热量。它是衡量材料隔热性能的关键物理量，其数值受热障涂层（TBC）等材料影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-9e8ea14457e39729a875ffa2ee3efdb0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9e8ea14457e39729a875ffa2ee3efdb0-e-5" label="Mean Metal Temperature">
        <attvalues>
          <attvalue for="0" value="Mean Metal Temperature" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="平均金属温度是一个关键物理量，指金属部件在特定工况下的平均温度。它常用于评估热障涂层（TBC）等隔热技术的性能，其数值的降低表明部件得到了有效的热防护，从而延长使用寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-9e8ea14457e39729a875ffa2ee3efdb0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9e8ea14457e39729a875ffa2ee3efdb0-e-6" label="Sintering">
        <attvalues>
          <attvalue for="0" value="Sintering" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="烧结（Sintering）是在高温下，热障涂层（TBC）内部的微观结构发生变化，导致材料致密化的过程。该过程会使涂层的孔隙率降低，导热系数随时间增加，从而削弱其隔热性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-9e8ea14457e39729a875ffa2ee3efdb0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-aedbe4412d2761c1e12ab362e44dea99-e-2" label="superalloy">
        <attvalues>
          <attvalue for="0" value="superalloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="高温合金（Superalloy）是一种金属基合金，通常以铁、镍、钴为基体。它能在600℃以上的高温及复杂应力作用下长期工作，具有优异的组织稳定性、抗氧化和抗腐蚀能力，是制造航空航天发动机、燃气轮机等热端部件的关键材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-aedbe4412d2761c1e12ab362e44dea99" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-aedbe4412d2761c1e12ab362e44dea99-e-4" label="aluminium">
        <attvalues>
          <attvalue for="0" value="aluminium" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="铝是一种化学元素。在材料科学中，它被用于粉末包渗工艺，并且是δ-Ni2Al3相与超化学计量的β-NiAl相中的主要扩散元素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-aedbe4412d2761c1e12ab362e44dea99" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-aedbe4412d2761c1e12ab362e44dea99-e-5" label="δ-Ni2Al3 phase">
        <attvalues>
          <attvalue for="0" value="δ-Ni2Al3 phase" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="δ-Ni2Al3相是一种镍铝金属间化合物相，常见于铝化物涂层的外表面。在该物相结构中，铝是主要的扩散元素，其扩散行为对涂层的形成和性能至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-aedbe4412d2761c1e12ab362e44dea99" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-12839dddacb541f1c423c238ab49ba6e-e-1" label="Coated superalloy">
        <attvalues>
          <attvalue for="0" value="Coated superalloy" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="涂层高温合金是一种材料体系，由高温合金基体和表面的防护涂层构成，旨在提高材料在高温下的抗氧化性能。尽管有涂层保护，该体系在循环氧化条件下的抵抗能力相对较差。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-12839dddacb541f1c423c238ab49ba6e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-12839dddacb541f1c423c238ab49ba6e-e-3" label="Isothermal test">
        <attvalues>
          <attvalue for="0" value="Isothermal test" />
          <attvalue for="1" value="Test Method" />
          <attvalue for="2" value="等温试验 (Isothermal tests) 是一种在恒定温度条件下，采用单轴载荷控制或应变控制等方式，用以表征材料疲劳性能的试验方法。该测试因温度恒定而相对易于控制。" />
          <attvalue for="3" value="{&quot;duration&quot;: &quot;1000h&quot;, &quot;temperature&quot;: &quot;1150 °C&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-12839dddacb541f1c423c238ab49ba6e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Isothermal laboratory tests&quot;, &quot;Isothermal tests&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bec9ddac9ea109abb615ddd436849b16-e-6&quot;, &quot;chunk-a5192ee579410694b4542905f037961f-e-1&quot;, &quot;chunk-e3fb38d02a415446b1548e163c6a6dda-e-6&quot;, &quot;chunk-12839dddacb541f1c423c238ab49ba6e-e-3&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-12839dddacb541f1c423c238ab49ba6e-e-5" label="High-aluminum coating">
        <attvalues>
          <attvalue for="0" value="High-aluminum coating" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="高铝涂层是一种材料层，其定义特征是铝的原子百分比含量大于51%。该涂层通常通过与基体发生反应，并以向内生长的扩散机制形成，主要用于在高温等恶劣环境下提供表面防护。" />
          <attvalue for="3" value="{&quot;Al content&quot;: &quot;&gt; 51 at%&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-12839dddacb541f1c423c238ab49ba6e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="327" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-12839dddacb541f1c423c238ab49ba6e-e-7" label="Pack particles">
        <attvalues>
          <attvalue for="0" value="Pack particles" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;指在包埋渗镀工艺中，源于包埋粉末（Pack）的固体颗粒。在特定工艺条件（如低活性包埋法）下，这些颗粒会残留在工件表面并嵌入到最终形成的涂层中，成为一种潜在的涂层缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-12839dddacb541f1c423c238ab49ba6e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c209c0babaaedf7bee28e398db9c505e-e-1" label="Isothermal 1000h test at 1150 °C">
        <attvalues>
          <attvalue for="0" value="Isothermal 1000h test at 1150 °C" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="一种材料性能测试条件，指在1150℃的恒定高温下持续暴露1000小时。与温度反复变化的循环加热/冷却试验相对，该试验旨在评估材料在长期、稳定热负荷下的性能退化和热稳定性。" />
          <attvalue for="3" value="{&quot;duration&quot;: &quot;1000h&quot;, &quot;temperature&quot;: &quot;1150 °C&quot;, &quot;type&quot;: &quot;isothermal&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-c209c0babaaedf7bee28e398db9c505e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="211" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c209c0babaaedf7bee28e398db9c505e-e-2" label="Cyclic heating/cooling test">
        <attvalues>
          <attvalue for="0" value="Cyclic heating/cooling test" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="一种热循环测试条件，要求在室温与1150°C之间进行1000次加热冷却循环，且每次循环均在1150°C的峰值温度下保持1小时，用于评估对象在温度剧烈交变下的性能稳定性。" />
          <attvalue for="3" value="{&quot;cycles&quot;: &quot;1000&quot;, &quot;temperature_range&quot;: &quot;ambient to 1150 °C&quot;, &quot;hold_time&quot;: &quot;1 h&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c209c0babaaedf7bee28e398db9c505e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="211" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c209c0babaaedf7bee28e398db9c505e-e-4" label="Ceramic coatings">
        <attvalues>
          <attvalue for="0" value="Ceramic coatings" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="陶瓷涂层是一种以陶瓷材料为基础的表面保护层，具有耐高温、耐腐蚀、高硬度和耐磨损等优异性能。它可通过电子束物理气相沉积（EB-PVD）、热喷涂等工艺施加于基材表面，以提升部件的使用寿命和可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c209c0babaaedf7bee28e398db9c505e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c209c0babaaedf7bee28e398db9c505e-e-5" label="Pack aluminisation">
        <attvalues>
          <attvalue for="0" value="Pack aluminisation" />
          <attvalue for="1" value="Deposition Process" />
          <attvalue for="2" value="**包埋渗铝 (pack aluminisation)**&#10;&#10;一种表面涂层工艺，通过在部件表面形成富铝层，为航空、工业和船用发动机提供抗氧化与腐蚀保护。然而，该工艺在严重热腐蚀环境以及超过1050°C的高温条件下，其防护性能会受到限制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c209c0babaaedf7bee28e398db9c505e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;pack aluminisation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c209c0babaaedf7bee28e398db9c505e-e-5&quot;, &quot;chunk-b90367b4b5b4b46e86c0cb9e61cfbb14-e-1&quot;]}]" />
          <attvalue for="9" value="57" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-c209c0babaaedf7bee28e398db9c505e-e-6" label="Coatings produced by pack aluminisation">
        <attvalues>
          <attvalue for="0" value="Coatings produced by pack aluminisation" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="一种通过包渗铝工艺在基材表面形成的铝化物扩散涂层。该涂层具有优异的高温抗氧化和抗腐蚀性能，主要用于保护航空、工业及船用发动机的热端部件，以延长其使用寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c209c0babaaedf7bee28e398db9c505e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c209c0babaaedf7bee28e398db9c505e-e-6&quot;]}]" />
          <attvalue for="9" value="57" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c209c0babaaedf7bee28e398db9c505e-e-7" label="Aviation, industrial and marine engine">
        <attvalues>
          <attvalue for="0" value="Aviation, industrial and marine engine" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="航空、工业和船用发动机是包埋渗铝涂层的典型应用领域。这类发动机通常在高温、腐蚀等严苛环境下工作，其关键部件（如涡轮叶片）表面施加渗铝涂层，以显著提升抗高温氧化、抗腐蚀性能和服役寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c209c0babaaedf7bee28e398db9c505e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;aviation, industrial and marine engine applications&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c209c0babaaedf7bee28e398db9c505e-e-7&quot;, &quot;chunk-b90367b4b5b4b46e86c0cb9e61cfbb14-e-2&quot;]}]" />
          <attvalue for="9" value="57" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b90367b4b5b4b46e86c0cb9e61cfbb14-e-3" label="severe hot corrosion conditions">
        <attvalues>
          <attvalue for="0" value="severe hot corrosion conditions" />
          <attvalue for="1" value="Operating Condition" />
          <attvalue for="2" value="一种恶劣的高温腐蚀操作条件，通常由熔融盐等污染物引起，会导致材料表面加速降解。在这种环境下，如包埋渗铝等传统防护涂层技术所能提供的保护作用会受到严重限制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-b90367b4b5b4b46e86c0cb9e61cfbb14" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="57" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b90367b4b5b4b46e86c0cb9e61cfbb14-e-4" label="temperatures above 1050 °C">
        <attvalues>
          <attvalue for="0" value="temperatures above 1050 °C" />
          <attvalue for="1" value="Operating Condition" />
          <attvalue for="2" value="一个高于1050°C的工作温度范围。在此临界条件之上，通过包埋渗铝（pack aluminisation）工艺所提供的保护作用会受到限制，因此是评估该工艺有效性的一个重要性能指标。" />
          <attvalue for="3" value="{&quot;temperature_threshold&quot;: &quot;&gt; 1050 °C&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-b90367b4b5b4b46e86c0cb9e61cfbb14" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="57" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b90367b4b5b4b46e86c0cb9e61cfbb14-e-5" label="yttria-stabilised zirconia">
        <attvalues>
          <attvalue for="0" value="yttria-stabilised zirconia" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="氧化钇稳定氧化锆（YSZ）是一种先进陶瓷材料，通过将氧化钇（Y₂O₃）掺杂到二氧化锆（ZrO₂）中，以稳定其在室温下的晶体结构。掺杂产生的点缺陷（氧空位）使其具有极低的热导率和优异的离子导电性，常被用作热障涂层和固体燃料电池的电解质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-b90367b4b5b4b46e86c0cb9e61cfbb14" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b90367b4b5b4b46e86c0cb9e61cfbb14-e-5&quot;, &quot;chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-21&quot;, &quot;chunk-e4ee2b4726b7ab716e9f01d209b1fd11-e-1&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-b90367b4b5b4b46e86c0cb9e61cfbb14-e-8" label="point defect spacing">
        <attvalues>
          <attvalue for="0" value="point defect spacing" />
          <attvalue for="1" value="Material Characteristic" />
          <attvalue for="2" value="点缺陷间距 (point defect spacing) 是指晶体材料中各点缺陷（如空位、间隙原子）之间的统计平均距离。它是一个关键的微观结构参数，作为衡量点缺陷浓度的物理量，并与其浓度成反比。此间距的大小直接影响材料的电学、力学及扩散等宏观性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-b90367b4b5b4b46e86c0cb9e61cfbb14" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9205fd6987f1eb506eff11a839efe879-e-2" label="Oxygen vacancy">
        <attvalues>
          <attvalue for="0" value="Oxygen vacancy" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="氧空位是一种材料点缺陷，指在晶体（如氧化锆晶格）中，由于阳离子（如Y³⁺）取代等原因，导致氧原子从其正常格点位置上缺失而形成的空位。它的存在会改变声子散射的平均自由程，从而影响材料的物理性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-9205fd6987f1eb506eff11a839efe879" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-9205fd6987f1eb506eff11a839efe879-e-3" label="Zirconia lattice">
        <attvalues>
          <attvalue for="0" value="Zirconia lattice" />
          <attvalue for="1" value="Crystal Structure" />
          <attvalue for="2" value="指二氧化锆（ZrO₂）的晶体点阵结构。当通过掺杂（如钇）引入氧空位后，其立方或四方等高对称性晶相在室温下得以稳定，从而抑制了有害的马氏体相变。这种缺陷结构也是氧化锆成为优良氧离子导体和固体电解质的基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-9205fd6987f1eb506eff11a839efe879" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9205fd6987f1eb506eff11a839efe879-e-4" label="Y³+">
        <attvalues>
          <attvalue for="0" value="Y³+" />
          <attvalue for="1" value="Ion" />
          <attvalue for="2" value="钇离子(Y³⁺)是在氧化锆(ZrO₂)晶格中，通过取代原有锆离子(Zr⁴⁺)而引入的一种掺杂离子。由于Y³⁺与Zr⁴⁺的电荷不匹配，为维持晶格整体的电中性，这种取代会必然导致氧空位的形成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-9205fd6987f1eb506eff11a839efe879" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-9205fd6987f1eb506eff11a839efe879-e-5" label="Zr²+">
        <attvalues>
          <attvalue for="0" value="Zr²+" />
          <attvalue for="1" value="Ion" />
          <attvalue for="2" value="Zr²+是一种二价锆阳离子。在特定晶体材料中，它是一种被三价钇离子（Y³⁺）在晶格位置上发生替代的离子实体，这种取代过程常用于材料掺杂改性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-9205fd6987f1eb506eff11a839efe879" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9205fd6987f1eb506eff11a839efe879-e-6" label="Partially stabilised zirconia">
        <attvalues>
          <attvalue for="0" value="Partially stabilised zirconia" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="部分稳定氧化锆是一种先进陶瓷材料。它通过在氧化锆中添加氧化钇等稳定剂，使其在室温下保留部分亚稳的四方相结构。当受到应力时，这种结构会发生相变以阻止裂纹扩展（即相变增韧），从而赋予材料极高的强度、断裂韧性和耐磨性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-9205fd6987f1eb506eff11a839efe879" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="212" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9205fd6987f1eb506eff11a839efe879-e-7" label="Yttria">
        <attvalues>
          <attvalue for="0" value="Yttria" />
          <attvalue for="1" value="Material Additive" />
          <attvalue for="2" value="氧化钇（Yttria），化学式为Y₂O₃，是一种重要的无机化合物和材料添加剂。它主要用作氧化锆的稳定剂，通过抑制其在冷却过程中的相变，使其在室温下保持高韧性的晶体结构，从而制备出性能优异的部分稳定或全稳定氧化锆（如YSZ）陶瓷。" />
          <attvalue for="3" value="{&quot;concentration&quot;: &quot;7 wt%&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-9205fd6987f1eb506eff11a839efe879" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9205fd6987f1eb506eff11a839efe879-e-7&quot;]}]" />
          <attvalue for="9" value="212" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9205fd6987f1eb506eff11a839efe879-e-8" label="Mean free path for phonon dispersion">
        <attvalues>
          <attvalue for="0" value="Mean free path for phonon dispersion" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="声子平均自由程（Mean free path for phonon）是固体物理中的一个基本属性，指声子在晶格中两次连续散射之间行进的平均距离。它直接决定了材料的热导率，晶格中存在的氧空位等缺陷会增强对声子的散射，从而缩短其平均自由程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-9205fd6987f1eb506eff11a839efe879" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-4bc43156e1a0a7c73048cc8f158c8919-e-2" label="NiCrAlY system">
        <attvalues>
          <attvalue for="0" value="NiCrAlY system" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="一种由镍(Ni)、铬(Cr)、铝(Al)和钇(Y)组成的镍基高温合金体系。它凭借优异的高温抗氧化与抗腐蚀性能，常被用作航空发动机等高温部件表面的防护罩层涂层或热障涂层中的粘结层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-4bc43156e1a0a7c73048cc8f158c8919" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4bc43156e1a0a7c73048cc8f158c8919-e-3" label="Proprietary coatings">
        <attvalues>
          <attvalue for="0" value="Proprietary coatings" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="专有涂层（Proprietary coatings）是一种作为罩面涂层（Overlay coatings）成分变体的材料涂层。其配方具有专有性，通常以包含硅(Si)、铼(Re)和铪(Hf)等特定改性元素为特征，以提升涂层性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-4bc43156e1a0a7c73048cc8f158c8919" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-4bc43156e1a0a7c73048cc8f158c8919-e-7" label="'modified' overlay coatings">
        <attvalues>
          <attvalue for="0" value="'modified' overlay coatings" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="一种覆层涂层（Overlay coatings）的子类型。它特指通过系统性地改变或调整基础化学成分，而形成的一系列具有不同特性或性能的成分变体，以满足特定的功能需求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-4bc43156e1a0a7c73048cc8f158c8919" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2dc25af7062fe95786ac7680318cbe70-e-1" label="Ni-rich, Group I-type Ni-Cr-Al alloys">
        <attvalues>
          <attvalue for="0" value="Ni-rich, Group I-type Ni-Cr-Al alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种富镍的I型镍铬铝（Ni-Cr-Al）合金。其主要特征是在氧化作用影响下，会在材料表面形成外部氧化层（external scale），同时在基体内部形成内部氧化层（internal scale）。" />
          <attvalue for="3" value="{&quot;composition&quot;: &quot;Ni-Cr-Al&quot;, &quot;category&quot;: &quot;Ni-rich, Group I-type&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-2dc25af7062fe95786ac7680318cbe70" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2dc25af7062fe95786ac7680318cbe70-e-5" label="Internal scale">
        <attvalues>
          <attvalue for="0" value="Internal scale" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="内部氧化皮（Internal scale）是在富镍I型镍铬铝合金氧化时，于其内部形成的一种材料层。它主要由氧化铬（Chromia）和氧化铝（Alumina）构成，存在于合金基体内部，区别于表面氧化皮。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2dc25af7062fe95786ac7680318cbe70" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2dc25af7062fe95786ac7680318cbe70-e-5&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2dc25af7062fe95786ac7680318cbe70-e-7" label="Alumina">
        <attvalues>
          <attvalue for="0" value="Alumina" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="氧化铝（Al₂O₃）是一种化学化合物。在材料学中，它是构成内氧化层（internal scale）的组分之一，其在氧化层中的分布位置通常比氧化铬（Chromia）更深。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-2dc25af7062fe95786ac7680318cbe70" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3ef3a46d5883ceba55b19f3ce086fd54-e-3" label="raw coating powder">
        <attvalues>
          <attvalue for="0" value="raw coating powder" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种用于等离子喷涂的粉末状原材料，是制备NiCrAlY型罩面涂层的核心原料。该粉末通常含有活性元素（如钇），用以增强最终涂层的附着力与高温抗氧化性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-3ef3a46d5883ceba55b19f3ce086fd54" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3ef3a46d5883ceba55b19f3ce086fd54-e-6" label="air">
        <attvalues>
          <attvalue for="0" value="air" />
          <attvalue for="1" value="Process Environment" />
          <attvalue for="2" value="作为等离子喷涂的一种工艺环境，它是一种影响活性元素最佳水平的介质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-3ef3a46d5883ceba55b19f3ce086fd54" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3ef3a46d5883ceba55b19f3ce086fd54-e-7" label="vacuum">
        <attvalues>
          <attvalue for="0" value="vacuum" />
          <attvalue for="1" value="Process Environment" />
          <attvalue for="2" value="在等离子喷涂工艺中应用的低压环境。通过隔绝空气，它可以有效防止喷涂材料在高温下发生氧化等化学反应，从而实现对涂层中活性元素含量的精确控制，以确保最终涂层的质量和性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-3ef3a46d5883ceba55b19f3ce086fd54" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3ef3a46d5883ceba55b19f3ce086fd54-e-10" label="Figure 5.36">
        <attvalues>
          <attvalue for="0" value="Figure 5.36" />
          <attvalue for="1" value="Reference" />
          <attvalue for="2" value="图5.36是技术或学术文献中的一个插图编号。该图以可视化的方式，清晰展示了覆盖层（overlay coating）材料内部产生的裂纹的形态、分布与特征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-3ef3a46d5883ceba55b19f3ce086fd54" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3ef3a46d5883ceba55b19f3ce086fd54-e-13" label="bond coat">
        <attvalues>
          <attvalue for="0" value="bond coat" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="作为多层涂层体系（如热障涂层）中的金属中间层，主要用于增强陶瓷面层与金属基体的结合力。它通过在高温下形成一层致密的氧化铝（TGO）来保护基体。该层中铝元素的持续消耗与耗尽是导致涂层最终失效的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-3ef3a46d5883ceba55b19f3ce086fd54" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-06d99f061d242b2c3104dc4852dc4811-e-1" label="Depletion of aluminium from the bond coat">
        <attvalues>
          <attvalue for="0" value="Depletion of aluminium from the bond coat" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="指热障涂层系统中，粘结层内的铝元素因热生长氧化物(TGO)的形成及与基体的相互扩散而被消耗的现象。该现象是导致热障涂层最终失效的关键前兆。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-06d99f061d242b2c3104dc4852dc4811" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Depletion of aluminium&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3ef3a46d5883ceba55b19f3ce086fd54-e-11&quot;, &quot;chunk-06d99f061d242b2c3104dc4852dc4811-e-1&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-06d99f061d242b2c3104dc4852dc4811-e-2" label="Failure of a thermal barrier coating">
        <attvalues>
          <attvalue for="0" value="Failure of a thermal barrier coating" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="热障涂层失效是指热障涂层系统发生的最终退化和功能丧失现象。该现象以粘结层中铝元素的耗尽为关键前兆，最终导致涂层开裂或剥落，从而完全失去其隔热保护能力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-06d99f061d242b2c3104dc4852dc4811" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-06d99f061d242b2c3104dc4852dc4811-e-3" label="Thermal barrier coating">
        <attvalues>
          <attvalue for="0" value="Thermal barrier coating" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="热障涂层（Thermal barrier coating）是一种应用于高温部件（如燃气轮机叶片）表面的先进材料系统。它通常由陶瓷隔热层和金属粘结层等多层结构组成，为基体金属提供隔热和抗氧化保护，以延长其在严苛环境下的服役寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-06d99f061d242b2c3104dc4852dc4811" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-06d99f061d242b2c3104dc4852dc4811-e-4" label="Bond coat">
        <attvalues>
          <attvalue for="0" value="Bond coat" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="在热障涂层系统中，粘结层是位于陶瓷面层与金属基体之间的关键金属层。其主要功能是通过消耗自身的铝元素，在高温下原位生成一层致密的氧化铝膜，为基体提供抗氧化保护，并增强涂层附着力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-06d99f061d242b2c3104dc4852dc4811" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-06d99f061d242b2c3104dc4852dc4811-e-5" label="Thermally Grown Oxide (TGO)">
        <attvalues>
          <attvalue for="0" value="Thermally Grown Oxide (TGO)" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="TGO，全称热生长氧化物层（Thermally Grown Oxide），是在高温环境下于材料（如热障涂层）表面形成的一种氧化物薄层。其微观形态（如起伏）和性能由制备工艺决定，常见的工艺包括电子束物理气相沉积（EB-PVD）和等离子喷涂（PS）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-06d99f061d242b2c3104dc4852dc4811" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;TGO&quot;, &quot;TGO (Thermally Grown Oxide)&quot;, &quot;TGO layer&quot;, &quot;Thermally Grown Oxide&quot;, &quot;Thermally grown oxide&quot;, &quot;Thermally grown oxide (TGO)&quot;, &quot;thermally grown oxide&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-56221da56587b6ebb1c6eef7e8ed2a6e-e-8&quot;, &quot;chunk-06d99f061d242b2c3104dc4852dc4811-e-5&quot;, &quot;chunk-ada1760fca7d3e8b09d0a55e2e6b2f4f-e-1&quot;, &quot;chunk-e66fbe12748379e18cc5f75f5238013e-e-1&quot;, &quot;chunk-157f6129afe364a84d6ecbefe4df9e7a-e-2&quot;, &quot;chunk-a4fbcaedb1a3455b29f18439a3d53ae7-e-3&quot;, &quot;chunk-2723cf8c1579af89abde800442361a57-e-2&quot;, &quot;chunk-8765b343b5bd5551f3f9be47330d68d2-e-10&quot;, &quot;chunk-59a3edbbbcb792361a0376e0da5d6d3f-e-5&quot;, &quot;chunk-ea2d68ee6ba96502ab007d093c1ef915-e-10&quot;, &quot;chunk-23df60e783372fb64b1a5a9966ec4edc-e-1&quot;, &quot;chunk-b5c5988ef25b1d82cffcb2320a89119f-e-3&quot;, &quot;chunk-8ae2a6e700e675a50e2388df07f07883-e-1&quot;, &quot;chunk-c4027f79a0ee2caae7fc9e91bab6483f-e-1&quot;, &quot;chunk-c88b048c96dc246f3cddc3e769c47af8-e-1&quot;, &quot;chunk-a489ad53b1434170d93d0b020b96b655-e-1&quot;, &quot;chunk-047adffb203a8742a16f24b4f8936843-e-3&quot;, &quot;chunk-a9b18faea9fc2dc16504c23ff224a743-e-5&quot;, &quot;chunk-9d4090cefd14aa31985c686534f57a73-e-8&quot;, &quot;chunk-31c18b0689504fd2041e550630408d61-e-5&quot;, &quot;chunk-80545b960495f33fd33c6ee9963001b5-e-12&quot;, &quot;chunk-88706c8690b0d2b2ae8b3e515c553936-e-2&quot;, &quot;chunk-93d10ba2903ae8b18e5582634fca4a8c-e-5&quot;, &quot;chunk-25a792195888d0ec7e1a3d86f8775f12-e-1&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="30" />
        </attvalues>
      </node>
      <node id="chunk-06d99f061d242b2c3104dc4852dc4811-e-7" label="Interdiffusion with the superalloy substrate">
        <attvalues>
          <attvalue for="0" value="Interdiffusion with the superalloy substrate" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="一种发生在粘结层与高温合金基体界面上的原子互扩散过程。该过程导致粘结层中的关键元素铝向基体迁移，是造成粘结层发生铝耗尽现象的主要原因之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-06d99f061d242b2c3104dc4852dc4811" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-06d99f061d242b2c3104dc4852dc4811-e-8" label="Superalloy substrate">
        <attvalues>
          <attvalue for="0" value="Superalloy substrate" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种由高温合金制成的基体材料，作为热障涂层等防护涂层系统的结构基础。它用于承载粘结层，并在高温下与之发生元素相互扩散，这一过程直接影响整个涂层系统的性能与寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-06d99f061d242b2c3104dc4852dc4811" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3b4a29632c8b1d02d0265d40c4880791-e-2" label="thin coating">
        <attvalues>
          <attvalue for="0" value="thin coating" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="一种附着于基底的材料薄层。由于与基底在热膨胀系数等物理属性上存在差异，其内部会产生应力（如双轴压应力）。其力学行为由自身的杨氏模量、泊松比等关键属性决定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-3b4a29632c8b1d02d0265d40c4880791" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-3b4a29632c8b1d02d0265d40c4880791-e-3" label="stiff substrate">
        <attvalues>
          <attvalue for="0" value="stiff substrate" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="一种具有高刚度的基底材料，用以承载和支撑薄涂层。其热膨胀系数是影响整个涂层-基底体系稳定性和性能的关键物理属性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-3b4a29632c8b1d02d0265d40c4880791" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3b4a29632c8b1d02d0265d40c4880791-e-5" label="temperature difference">
        <attvalues>
          <attvalue for="0" value="temperature difference" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="温差指物体或系统在不同时间或不同位置上的温度数值之差。作为一个关键物理量，它不仅是描述冷却等热传递过程的基础，也是引起热应力等物理现象的直接原因。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;ΔT&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3b4a29632c8b1d02d0265d40c4880791" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3b4a29632c8b1d02d0265d40c4880791-e-7" label="Young's modulus of the coating">
        <attvalues>
          <attvalue for="0" value="Young's modulus of the coating" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="涂层杨氏模量 (Young's modulus of the coating) 是表征特定薄涂层材料抵抗弹性形变能力的力学属性，其值为应力与应变之比。它是一个关键参数，用于计算该涂层材料内部的双轴面内压应力。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;E₀&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-3b4a29632c8b1d02d0265d40c4880791" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3b4a29632c8b1d02d0265d40c4880791-e-9" label="Equation for biaxial compressive in-plane stress">
        <attvalues>
          <attvalue for="0" value="Equation for biaxial compressive in-plane stress" />
          <attvalue for="1" value="Formula" />
          <attvalue for="2" value="一个用于定义和计算双轴面内压应力的数学表达式。该应力描述了物体（如薄膜或涂层）在一个平面内的两个相互垂直方向上，同时受到压缩作用时的应力状态。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;σο = (ΕοΔα₀ΔΤ) / (1 − ν₀)&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-3b4a29632c8b1d02d0265d40c4880791" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3b4a29632c8b1d02d0265d40c4880791-e-9&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ada1760fca7d3e8b09d0a55e2e6b2f4f-e-2" label="TBC system">
        <attvalues>
          <attvalue for="0" value="TBC system" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="热障涂层系统（TBC system）是一种用于高温部件的先进多层防护涂层。它通过在基体上施加包含粘结层（Bond coat）和热生长氧化物（TGO）层的结构，为部件提供优异的隔热和抗氧化保护。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-ada1760fca7d3e8b09d0a55e2e6b2f4f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-ada1760fca7d3e8b09d0a55e2e6b2f4f-e-3" label="Bond coat">
        <attvalues>
          <attvalue for="0" value="Bond coat" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="作为热障涂层系统（TBCs）的关键组成部分，它是一种位于陶瓷面层与金属基体之间的金属材料层。其主要作用是增强涂层与基体的结合强度，并为基体提供抗高温氧化和腐蚀的保护。" />
          <attvalue for="3" value="{&quot;thermal expansion coefficient&quot;: &quot;13–16 ppm/K&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-ada1760fca7d3e8b09d0a55e2e6b2f4f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ada1760fca7d3e8b09d0a55e2e6b2f4f-e-4" label="Alumina TGO">
        <attvalues>
          <attvalue for="0" value="Alumina TGO" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种主要成分为氧化铝（Al₂O₃）的热生长氧化物（Thermally Grown Oxide, TGO）层。它通常在热障涂层等高温应用中，于金属基体或粘结层表面原位生长形成，起着保护下方金属免受进一步氧化的关键作用，其稳定性直接决定涂层系统的服役寿命。" />
          <attvalue for="3" value="{&quot;thermal expansion coefficient&quot;: &quot;8–9 ppm/K&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-ada1760fca7d3e8b09d0a55e2e6b2f4f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;thermally grown alumina&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ada1760fca7d3e8b09d0a55e2e6b2f4f-e-4&quot;, &quot;chunk-c2ec04cbf3c90264a785b174dcc622ba-e-10&quot;, &quot;chunk-6dac0a4c73567f8946fa9c50957af9ca-e-5&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-ada1760fca7d3e8b09d0a55e2e6b2f4f-e-5" label="Stress">
        <attvalues>
          <attvalue for="0" value="Stress" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="指热生长氧化物（TGO）的一种力学性能。该应力可通过脱粘几乎完全地释放，并通过热循环得到降低。此外，亚临界开裂、蠕变松弛和形貌演变也可能使其减小。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ada1760fca7d3e8b09d0a55e2e6b2f4f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ada1760fca7d3e8b09d0a55e2e6b2f4f-e-5&quot;, &quot;chunk-25a792195888d0ec7e1a3d86f8775f12-e-3&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-e66fbe12748379e18cc5f75f5238013e-e-4" label="γ-Ni3Al">
        <attvalues>
          <attvalue for="0" value="γ-Ni3Al" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="γ-Ni3Al是一种镍铝基金属间化合物，通常指具有L1₂有序晶体结构的γ'相。作为镍基高温合金中的关键强化相，它赋予了合金卓越的高温强度、硬度和抗蠕变性能，是现代航空发动机等领域的核心材料。" />
          <attvalue for="3" value="{&quot;density&quot;: &quot;7.5 g/cm³&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-e66fbe12748379e18cc5f75f5238013e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="328" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-e66fbe12748379e18cc5f75f5238013e-e-6" label="TBC">
        <attvalues>
          <attvalue for="0" value="TBC" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="热障涂层（Thermal Barrier Coating, TBC），一种应用于高温部件（如航空发动机叶片）表面的先进陶瓷涂层系统。其核心功能是隔绝热量，显著降低基体金属的温度，从而保护其在严苛环境中免受热损伤、氧化和腐蚀，以延长使用寿命。" />
          <attvalue for="3" value="{&quot;failure_mechanism_type&quot;: &quot;nucleation- or propagation-controlled&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e66fbe12748379e18cc5f75f5238013e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="329" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-e66fbe12748379e18cc5f75f5238013e-e-7" label="Watanabe et al. [149]">
        <attvalues>
          <attvalue for="0" value="Watanabe et al. [149]" />
          <attvalue for="1" value="Research Group/Publication" />
          <attvalue for="2" value="由Watanabe等学者发表的科学文献，引文编号为[149]。该研究以其应用“晶圆曲率法”（Wafer curvature method）来测定材料中的残余应力而著称。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-e66fbe12748379e18cc5f75f5238013e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e66fbe12748379e18cc5f75f5238013e-e-8" label="Wafer curvature method">
        <attvalues>
          <attvalue for="0" value="Wafer curvature method" />
          <attvalue for="1" value="Measurement Technique" />
          <attvalue for="2" value="晶圆曲率法是一种广泛用于测定薄膜残余应力的测量技术。它通过精确测量薄膜沉积前后基底晶圆的曲率变化量，并常依据斯托尼（Stoney）公式，将该变化量换算为薄膜内部的应力值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-e66fbe12748379e18cc5f75f5238013e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e66fbe12748379e18cc5f75f5238013e-e-9" label="Residual stress">
        <attvalues>
          <attvalue for="0" value="Residual stress" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="残余应力（Residual stress）是一种物理现象，指材料在外部作用（如力、热）移除后，仍保留在物体内部并自我平衡的应力。在本上下文中，它特指存在于铂铝化物粘结涂层中的应力水平，其大小可通过晶片曲率法等技术进行测量和确定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-e66fbe12748379e18cc5f75f5238013e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Residual stresses&quot;, &quot;residual stress&quot;, &quot;residual stresses&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2ac3d73c1ded0ce49421b66e585b5916-e-1&quot;, &quot;chunk-e66fbe12748379e18cc5f75f5238013e-e-9&quot;, &quot;chunk-e3bf4592567fa4c79f22955763ff9714-e-3&quot;, &quot;chunk-31cd2366f102780cc28ad1a099e8127d-e-1&quot;, &quot;chunk-7027df3183981418ce449ee96ef327a1-e-10&quot;, &quot;chunk-569a3d8aec20d9df6a256b4cf4b263a7-e-10&quot;, &quot;chunk-3d0590efade07af78fea353ef909c7ec-e-5&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-e66fbe12748379e18cc5f75f5238013e-e-10" label="Pt-aluminide bond coat deposit">
        <attvalues>
          <attvalue for="0" value="Pt-aluminide bond coat deposit" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="一种由铂和铝化物通过沉积工艺形成的粘结涂层。它作为一种功能性涂层材料，其内部存在的残余应力是表征其服役性能和可靠性的一个关键被测量物理量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-e66fbe12748379e18cc5f75f5238013e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e3bf4592567fa4c79f22955763ff9714-e-1" label="Pt-aluminide bond coat">
        <attvalues>
          <attvalue for="0" value="Pt-aluminide bond coat" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="铂-铝化物粘结涂层是一种由铂铝金属间化合物构成的防护涂层。它被沉积于Rene N5等单晶高温合金基体上，常作为热障涂层系统的一部分，以提供高温抗氧化保护。残余应力是决定其附着性能和服役寿命的关键物理属性。" />
          <attvalue for="3" value="{&quot;residual_stress_level&quot;: &quot;about 140 MPa (tensile)&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-e3bf4592567fa4c79f22955763ff9714" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="13" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e3bf4592567fa4c79f22955763ff9714-e-6" label="Piezospectroscopy">
        <attvalues>
          <attvalue for="0" value="Piezospectroscopy" />
          <attvalue for="1" value="Technique" />
          <attvalue for="2" value="压电光谱学是一种利用压谱效应的光谱学表征技术。它通过测量材料在应力作用下，其荧光或拉曼光谱谱线的位移量，来无损、高精度地定量分析材料内部的应力或应变状态。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e3bf4592567fa4c79f22955763ff9714" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e3bf4592567fa4c79f22955763ff9714-e-6&quot;, &quot;chunk-157f6129afe364a84d6ecbefe4df9e7a-e-1&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-157f6129afe364a84d6ecbefe4df9e7a-e-3" label="TBC system">
        <attvalues>
          <attvalue for="0" value="TBC system" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="TBC system是一种热障涂层系统，其关键特征是在高温服役时会生成一层热生长氧化物（TGO）。该系统可通过激光照射来激发，并通过检测TGO发出的荧光/磷光信号，实现对涂层健康状态的无损评估。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-157f6129afe364a84d6ecbefe4df9e7a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-157f6129afe364a84d6ecbefe4df9e7a-e-4" label="Luminescence">
        <attvalues>
          <attvalue for="0" value="Luminescence" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="一种源于氧化铝(Al2O3)的发光现象。其光谱会随材料所受应力而发生位移，这一特性是压致光谱技术(Piezospectroscopy)的物理基础，常用于无损检测热障涂层(TBC)等系统中的内部应力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-157f6129afe364a84d6ecbefe4df9e7a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-157f6129afe364a84d6ecbefe4df9e7a-e-5" label="Raman spectra">
        <attvalues>
          <attvalue for="0" value="Raman spectra" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="拉曼光谱是由拉曼散射现象产生的光谱，可提供材料分子振动和转动的“指纹”信息。由于其谱峰位置会因应力或应变而发生位移，这一特性是压致光谱学（Piezospectroscopy）进行材料分析的物理基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-157f6129afe364a84d6ecbefe4df9e7a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-157f6129afe364a84d6ecbefe4df9e7a-e-6" label="Laser">
        <attvalues>
          <attvalue for="0" value="Laser" />
          <attvalue for="1" value="Instrument" />
          <attvalue for="2" value="一种用作激发光源的精密仪器。它发射特定波长的激光束照射热障涂层（TBC）系统，通过诱导其产生可供分析检测的发光（如荧光、磷光）现象，来实现对该系统的测量与表征。" />
          <attvalue for="3" value="{&quot;property&quot;: &quot;appropriate wavelength&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-157f6129afe364a84d6ecbefe4df9e7a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-157f6129afe364a84d6ecbefe4df9e7a-e-8" label="Bond coat">
        <attvalues>
          <attvalue for="0" value="Bond coat" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="作为热障涂层系统（TBCs）的关键组成部分，是一种金属材料层。它在高温下通过自身氧化，形成一层致密且稳定的氧化铝（Al₂O₃）层，该氧化层能保护基体免受进一步氧化，并为陶瓷面层提供牢固的附着力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-157f6129afe364a84d6ecbefe4df9e7a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f76ae1d909a43808db3e1dc38409d881-e-1" label="Sintering resistance">
        <attvalues>
          <attvalue for="0" value="Sintering resistance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="抗烧结性（Sintering resistance）是衡量材料（尤其是陶瓷材料）在高温下抵抗其颗粒发生固结、致密化能力的物理属性。此性能与材料的熔点正相关，通常熔点越高的材料，其抗烧结性越强，在高温环境中也越能保持其原有的结构与性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-f76ae1d909a43808db3e1dc38409d881" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f76ae1d909a43808db3e1dc38409d881-e-5" label="Hafnia-based TBC">
        <attvalues>
          <attvalue for="0" value="Hafnia-based TBC" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="A proposed type of thermal barrier coating based on hafnia." />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-f76ae1d909a43808db3e1dc38409d881" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f76ae1d909a43808db3e1dc38409d881-e-6" label="Hafnia">
        <attvalues>
          <attvalue for="0" value="Hafnia" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="氧化铪（Hafnia），化学式为HfO₂，是一种陶瓷材料。因其高熔点、低热导率和良好的高温稳定性，被视为一种有潜力的新一代热障涂层（TBC）核心基础材料，用于保护航空发动机等处于极端环境下的关键部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-f76ae1d909a43808db3e1dc38409d881" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f76ae1d909a43808db3e1dc38409d881-e-7" label="Evans and co-workers">
        <attvalues>
          <attvalue for="0" value="Evans and co-workers" />
          <attvalue for="1" value="Researcher Group" />
          <attvalue for="2" value="一个在20世纪90年代末期对热障涂层（TBCs）失效机制进行建模的科研团队。该团队的工作以建立失效模型而著称，并着重强调了作为关键失效模式之一的棘轮机制（Ratcheting mechanism）。" />
          <attvalue for="3" value="{&quot;time_period&quot;: &quot;late 1990s&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-f76ae1d909a43808db3e1dc38409d881" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f76ae1d909a43808db3e1dc38409d881-e-8" label="Failure mechanisms">
        <attvalues>
          <attvalue for="0" value="Failure mechanisms" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="一种物理现象，指在高温服役环境中，由热失配应力、氧化等因素引发，并最终导致热障涂层产生开裂、分层与剥落的一系列物理机理。棘轮机制（Ratcheting mechanism）是其具体类型之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-f76ae1d909a43808db3e1dc38409d881" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-f76ae1d909a43808db3e1dc38409d881-e-9" label="Ratcheting mechanism">
        <attvalues>
          <attvalue for="0" value="Ratcheting mechanism" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="**棘轮机制 (Ratcheting mechanism)**&#10;&#10;一种失效机制，指材料在热循环等非对称循环载荷下，塑性应变或损伤发生单向、逐级累积，最终导致结构失效的物理现象。该机制是解释热障涂层（TBCs）在服役过程中产生和扩展损伤的关键模型之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-f76ae1d909a43808db3e1dc38409d881" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a4fbcaedb1a3455b29f18439a3d53ae7-e-1" label="Ratcheting mechanism">
        <attvalues>
          <attvalue for="0" value="Ratcheting mechanism" />
          <attvalue for="1" value="Mechanism" />
          <attvalue for="2" value="棘轮机制是一种在早期论文中被提出的理论模型，旨在解释涂层中发生的特定现象。然而，该模型在现实中的有效性和可操作性受到了后续观察结果的挑战与质疑，其可靠性尚存争议。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-a4fbcaedb1a3455b29f18439a3d53ae7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a4fbcaedb1a3455b29f18439a3d53ae7-e-2" label="Diffusional reactions">
        <attvalues>
          <attvalue for="0" value="Diffusional reactions" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="扩散反应（Diffusional reactions）是一种由物质（如原子、离子）扩散速率控制的化学反应过程。它特指在热生长氧化物（TGO）层及其下方发生的系列反应，是影响材料界面结构演变的关键因素，其重要性在后续的观测研究中得到证实。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a4fbcaedb1a3455b29f18439a3d53ae7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a4fbcaedb1a3455b29f18439a3d53ae7-e-2&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a4fbcaedb1a3455b29f18439a3d53ae7-e-4" label="Slow-diffusing elements">
        <attvalues>
          <attvalue for="0" value="Slow-diffusing elements" />
          <attvalue for="1" value="Element Category" />
          <attvalue for="2" value="慢扩散元素 (Slow-diffusing elements) 是一类扩散速率较慢的化学元素，主要包括铼(Re)、钨(W)和钼(Mo)。在渗铝涂层工艺中，这类元素在涂层表面的浓度高低取决于所使用包埋剂（高活度或低活度）的活度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a4fbcaedb1a3455b29f18439a3d53ae7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a4fbcaedb1a3455b29f18439a3d53ae7-e-9" label="High-activity pack">
        <attvalues>
          <attvalue for="0" value="High-activity pack" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="一种表面改性工艺，属于化学气相沉积的包埋法（Pack Cementation）。它将工件包埋于含有铝源和高活性卤化物活化剂的粉末中并加热，使铝扩散渗入基体表面，形成一层致密的保护性铝化物涂层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-a4fbcaedb1a3455b29f18439a3d53ae7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;high-activity pack&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a4fbcaedb1a3455b29f18439a3d53ae7-e-9&quot;, &quot;chunk-8e4f95988fb5d512b274348d9b3d4dca-e-2&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a4fbcaedb1a3455b29f18439a3d53ae7-e-10" label="Low-activity pack">
        <attvalues>
          <attvalue for="0" value="Low-activity pack" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="一种低活性包埋渗镀工艺，属表面改性技术。其特点是渗剂包中涂层元素的化学活性较低，涂层生长速率主要由元素在基体中的扩散控制。该工艺用于在工件表面形成保护性扩散涂层（如渗铝层），以提高其高温抗氧化和抗腐蚀能力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-a4fbcaedb1a3455b29f18439a3d53ae7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;low-activity pack&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a4fbcaedb1a3455b29f18439a3d53ae7-e-10&quot;, &quot;chunk-8e4f95988fb5d512b274348d9b3d4dca-e-3&quot;, &quot;chunk-12839dddacb541f1c423c238ab49ba6e-e-6&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a4fbcaedb1a3455b29f18439a3d53ae7-e-11" label="Early papers">
        <attvalues>
          <attvalue for="0" value="Early papers" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="指在“棘轮机制”(Ratcheting mechanism)研究领域，早期发表的一批着重阐述该机制的奠基性科学文献。这些出版物为该理论的建立和发展提供了核心思想与基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-a4fbcaedb1a3455b29f18439a3d53ae7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a4fbcaedb1a3455b29f18439a3d53ae7-e-12" label="Later observations">
        <attvalues>
          <attvalue for="0" value="Later observations" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="指一系列后续发表的科学出版物。这些研究通过强调扩散反应的发生，对先前存在的“棘轮机制”理论提出了质疑。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-a4fbcaedb1a3455b29f18439a3d53ae7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8e4f95988fb5d512b274348d9b3d4dca-e-5" label="environmental properties">
        <attvalues>
          <attvalue for="0" value="environmental properties" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="指镀铝涂层在服役环境中表现出的性能，主要包括抗氧化、耐腐蚀等。这些特性直接受到镀铝工艺中不同包埋剂（pack type）的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-8e4f95988fb5d512b274348d9b3d4dca" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8e4f95988fb5d512b274348d9b3d4dca-e-7" label="as-processed diffusion coating">
        <attvalues>
          <attvalue for="0" value="as-processed diffusion coating" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="指扩散涂层在制备工艺完成后，未经任何后续机械加工或热处理的原始状态。此状态下的涂层直接保留了扩散过程所形成的固有表面特征（如脊状形貌）和材料性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-8e4f95988fb5d512b274348d9b3d4dca" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8e4f95988fb5d512b274348d9b3d4dca-e-8" label="TBC system">
        <attvalues>
          <attvalue for="0" value="TBC system" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="TBC系统指热障涂层系统（Thermal Barrier Coating system），是一种应用于高温部件、起隔热保护作用的多层材料体系。该系统通常由陶瓷顶层和金属扩散粘结层组成，其中粘结层的表面形貌是影响其整体服役寿命的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-8e4f95988fb5d512b274348d9b3d4dca" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8e4f95988fb5d512b274348d9b3d4dca-e-9" label="life of a TBC system">
        <attvalues>
          <attvalue for="0" value="life of a TBC system" />
          <attvalue for="1" value="System Property" />
          <attvalue for="2" value="热障涂层（TBC）系统的寿命，是指该系统在失效前能够有效工作的持续时间，是衡量其性能的关键指标。此项系统属性会受到涂层微观形貌的显著影响，例如具有脊状结构的表面形态会改变其最终寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-8e4f95988fb5d512b274348d9b3d4dca" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8e4f95988fb5d512b274348d9b3d4dca-e-11" label="single-crystal superalloy substrate">
        <attvalues>
          <attvalue for="0" value="single-crystal superalloy substrate" />
          <attvalue for="1" value="Substrate" />
          <attvalue for="2" value="单晶高温合金基体是一种整体由单一晶粒构成的高性能合金材料。因消除了晶界，它具有优异的高温力学性能和抗蠕变性，常用于制造航空发动机涡轮叶片等核心热端部件。它可作为基底，与NiCrAlY等覆盖涂层发生互扩散，形成保护层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-8e4f95988fb5d512b274348d9b3d4dca" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8e4f95988fb5d512b274348d9b3d4dca-e-12" label="service">
        <attvalues>
          <attvalue for="0" value="service" />
          <attvalue for="1" value="Operational Condition" />
          <attvalue for="2" value="一种操作工况，指涂层部件在服役期间，涂层与基体材料之间发生原子互扩散的阶段。此过程通常在高温下发生，是影响涂层系统长期性能和寿命的关键物理现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-8e4f95988fb5d512b274348d9b3d4dca" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="330" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-be5a585b4779a163f574e99353c822f8-e-2" label="Single-crystal superalloy substrate">
        <attvalues>
          <attvalue for="0" value="Single-crystal superalloy substrate" />
          <attvalue for="1" value="Material Substrate" />
          <attvalue for="2" value="一种整体呈单晶结构的镍基高温合金，用作涂层基体。因消除了晶界，其高温强度、抗蠕变和热疲劳性能优异。它是制造航空发动机涡轮叶片等热端部件的关键基础材料，与涂层间会发生元素互扩散。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-be5a585b4779a163f574e99353c822f8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-be5a585b4779a163f574e99353c822f8-e-3" label="Microstructural changes">
        <attvalues>
          <attvalue for="0" value="Microstructural changes" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="指在涂层与基体界面处，因高温、应力等服役条件导致的微观结构演变现象。该过程涉及相变、元素扩散及析出物粗化等，是影响材料性能退化、并决定其剩余寿命的关键物理机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-be5a585b4779a163f574e99353c822f8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="213" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-be5a585b4779a163f574e99353c822f8-e-4" label="Remanent life">
        <attvalues>
          <attvalue for="0" value="Remanent life" />
          <attvalue for="1" value="Component Property" />
          <attvalue for="2" value="剩余寿命（Remanent Life）是一项部件属性，指工程部件在当前损伤状态下，直至最终失效前所剩余的安全服役时间。其评估与预测是设备完整性管理的关键，通常依赖于对材料微观结构演变、裂纹扩展等性能退化指标的分析。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-be5a585b4779a163f574e99353c822f8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="213" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-be5a585b4779a163f574e99353c822f8-e-5" label="Walston and colleagues">
        <attvalues>
          <attvalue for="0" value="Walston and colleagues" />
          <attvalue for="1" value="Research Group" />
          <attvalue for="2" value="由沃尔斯顿（Walston）领导的研究团队。该团队因对二次反应区（Secondary reaction zone, SRZ）的生长进行测量研究而知名。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-be5a585b4779a163f574e99353c822f8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-be5a585b4779a163f574e99353c822f8-e-7" label="Aluminide-coated third-generation single-crystal superalloy">
        <attvalues>
          <attvalue for="0" value="Aluminide-coated third-generation single-crystal superalloy" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="一种先进材料系统，由第三代单晶高温合金基体与表面的铝化物涂层构成。该系统为基体提供高温抗氧化保护，但涂层与基体界面处形成的次生反应区（SRZ）会随时间生长，进而影响材料的综合性能。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;1090 °C&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-be5a585b4779a163f574e99353c822f8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-be5a585b4779a163f574e99353c822f8-e-7&quot;, &quot;chunk-04a3cb746085dbc29f8c34f061cca5f6-e-1&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-04a3cb746085dbc29f8c34f061cca5f6-e-2" label="Growth">
        <attvalues>
          <attvalue for="0" value="Growth" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种发生在“渗铝涂层三代单晶高温合金”中的材料学过程。该过程由扩散机制控制，其生长动力学特征是厚度随时间呈抛物线规律变化，并可通过一个有效扩散常数来定量描述。" />
          <attvalue for="3" value="{&quot;kinetics&quot;: &quot;parabolic&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-04a3cb746085dbc29f8c34f061cca5f6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-04a3cb746085dbc29f8c34f061cca5f6-e-3" label="Effective diffusion constant">
        <attvalues>
          <attvalue for="0" value="Effective diffusion constant" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="有效扩散常数是在高温合金等多组分材料中，用于量化驱动特定组织生长过程（如析出相粗化）的综合原子扩散速率的一个宏观物理参数。它将复杂的微观扩散行为简化为描述该过程动力学的单一有效值。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;6.7 × 10−11 cm²/s&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-04a3cb746085dbc29f8c34f061cca5f6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-04a3cb746085dbc29f8c34f061cca5f6-e-5" label="Aluminide coating">
        <attvalues>
          <attvalue for="0" value="Aluminide coating" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="铝化物涂层是一种高温防护涂层，通过扩散工艺在金属基材（如高温合金）表面形成富铝的金属间化合物层（如NiAl）。其主要功能是在高温下生成一层致密稳定的氧化铝（Al₂O₃）膜，以抵抗氧化和热腐蚀，常用于航空发动机涡轮叶片等热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-04a3cb746085dbc29f8c34f061cca5f6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Aluminide Coatings&quot;, &quot;Aluminide coatings&quot;, &quot;Aluminides&quot;, &quot;aluminide coatings&quot;, &quot;aluminides&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-489a70985937a8298a8310efcc20db59-e-6&quot;, &quot;chunk-b39db212478fb453fe79022a544f44e9-e-5&quot;, &quot;chunk-e59e76ae369265e25373e5545e9102c3-e-3&quot;, &quot;chunk-151e712d06b4c385e5757120e064b560-e-7&quot;, &quot;chunk-fbbf41abcd4950c59415caeec768db40-e-9&quot;, &quot;chunk-8a98946fce80230f54608d957bf8fa18-e-8&quot;, &quot;chunk-04a3cb746085dbc29f8c34f061cca5f6-e-5&quot;, &quot;chunk-e09ab40c542042f5c2612bfc3901180e-e-4&quot;, &quot;chunk-203cb57048ee781208098d35869844a7-e-3&quot;, &quot;chunk-e3fb38d02a415446b1548e163c6a6dda-e-2&quot;, &quot;chunk-5682b41ca5ff8b266cfe8297070b22b7-e-1&quot;, &quot;chunk-1a10b9ced7aeca4719469cc8e85d9ba9-e-7&quot;, &quot;chunk-31cd2366f102780cc28ad1a099e8127d-e-7&quot;, &quot;chunk-005fa05cc92b868ff65d4cf5445802b2-e-4&quot;, &quot;chunk-1f9144440e619377d400c98debe3a6dc-e-1&quot;, &quot;chunk-98dc45a2c81a5783151664ba74c4681e-e-4&quot;, &quot;chunk-1850c2ae231fdcb9fe7ba03b78412841-e-4&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="18" />
        </attvalues>
      </node>
      <node id="chunk-04a3cb746085dbc29f8c34f061cca5f6-e-6" label="Platinum-aluminide coating">
        <attvalues>
          <attvalue for="0" value="Platinum-aluminide coating" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种通过低活性化学气相沉积（CVD）工艺制备的高温防护涂层。该涂层在铂铝化物的基础上，通过添加活性元素进行改性以提升性能，常用于航空发动机等领域。此项技术由B. M. Warnes在其发表于《表面与涂层技术》期刊的论文中进行了详细阐述。" />
          <attvalue for="3" value="{&quot;property&quot;: &quot;beneficial&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-04a3cb746085dbc29f8c34f061cca5f6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;(Ni,Pt)Al coating&quot;, &quot;Platinum Aluminide Coating&quot;, &quot;Platinum aluminide diffusion coating&quot;, &quot;Platinum modified diffusion aluminide bond coat&quot;, &quot;Platinum-aluminides&quot;, &quot;Platinum-aluminised EB-PVD coatings&quot;, &quot;Pt-Al bond coat&quot;, &quot;Pt-aluminide bond coat&quot;, &quot;Pt-modified aluminide&quot;, &quot;Pt-modified aluminide coatings&quot;, &quot;Pt-modified aluminide diffusion coatings&quot;, &quot;Reactive element modified chemical vapour deposition low activity platinum aluminide coatings&quot;, &quot;platinum aluminide coatings&quot;, &quot;platinum-aluminide coating&quot;, &quot;platinum-modified nickel-aluminide bond coats&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-56221da56587b6ebb1c6eef7e8ed2a6e-e-7&quot;, &quot;chunk-b39db212478fb453fe79022a544f44e9-e-6&quot;, &quot;chunk-04a3cb746085dbc29f8c34f061cca5f6-e-6&quot;, &quot;chunk-a40956025386a6a3ce8ffbe5ab8d14d9-e-1&quot;, &quot;chunk-27d4439c082e1df0f703012a02b14ffb-e-2&quot;, &quot;chunk-b740c8122a3674caed65056e75488d1f-e-7&quot;, &quot;chunk-23667ab4826d0039e851f5cb53aa5455-e-1&quot;, &quot;chunk-edb9affa83770653e14e4cc8e96d4809-e-2&quot;, &quot;chunk-4897104ddb336b2f8f129d218c5a2cc4-e-11&quot;, &quot;chunk-c5385f7f28e0875405c91c30084a5d9b-e-6&quot;, &quot;chunk-8031eb636b002393280031950b878895-e-2&quot;, &quot;chunk-50f39f54006f612a0e1ae1be19a6ae87-e-14&quot;, &quot;chunk-8a8245180b98739270d9b9b4befedd30-e-10&quot;, &quot;chunk-6f4f79d57f35ab3e77324ff6707d70bf-e-4&quot;, &quot;chunk-dde5366a87c0d6eb632ea242ae19554c-e-2&quot;, &quot;chunk-7027df3183981418ce449ee96ef327a1-e-9&quot;, &quot;chunk-89e037006a60ff84d312fb1878f7b7ba-e-1&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="16" />
        </attvalues>
      </node>
      <node id="chunk-a40956025386a6a3ce8ffbe5ab8d14d9-e-2" label="TGO formation">
        <attvalues>
          <attvalue for="0" value="TGO formation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="热生长氧化物（TGO）的形成，指在等温氧化期间，于镀铝单晶高温合金表面生成氧化物层的过程。该过程的速率是材料科学研究中的一个关键问题，并可能受到陶瓷YSZ（氧化钇稳定氧化锆）涂层等因素的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a40956025386a6a3ce8ffbe5ab8d14d9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a40956025386a6a3ce8ffbe5ab8d14d9-e-2&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-a40956025386a6a3ce8ffbe5ab8d14d9-e-3" label="Aluminised single-crystal superalloy">
        <attvalues>
          <attvalue for="0" value="Aluminised single-crystal superalloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种表面带有富铝涂层的单晶高温合金。在高温氧化环境中，该涂层会与氧反应，在基体表面原位生成一层致密且具有保护作用的热生长氧化物（TGO），以提高合金的抗氧化和抗腐蚀性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-a40956025386a6a3ce8ffbe5ab8d14d9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;aluminised single-crystal superalloy&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a40956025386a6a3ce8ffbe5ab8d14d9-e-3&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a40956025386a6a3ce8ffbe5ab8d14d9-e-5" label="ceramic YSZ layer">
        <attvalues>
          <attvalue for="0" value="ceramic YSZ layer" />
          <attvalue for="1" value="Layer" />
          <attvalue for="2" value="指由氧化钇稳定氧化锆(Yttria-Stabilized Zirconia, YSZ)构成的陶瓷薄层。作为一种重要的热障涂层材料，它的存在与特性会影响基材的表面反应，能够潜在地改变材料在恒定高温下的等温氧化过程，进而影响其性能与寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-a40956025386a6a3ce8ffbe5ab8d14d9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a40956025386a6a3ce8ffbe5ab8d14d9-e-5&quot;, &quot;chunk-83ca3f8149515d0fbab6094084e6dc12-e-2&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-83ca3f8149515d0fbab6094084e6dc12-e-1" label="isothermal oxidation">
        <attvalues>
          <attvalue for="0" value="isothermal oxidation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="等温氧化是一种高温腐蚀过程，指材料在恒定温度下与氧化剂（通常是氧气）发生化学反应。该过程是评估高温合金、热障涂层粘结层等材料在持续高温工况下性能、稳定性和寿命的关键研究方法，也是其主要失效机制之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-83ca3f8149515d0fbab6094084e6dc12" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Isothermal oxidation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-83ca3f8149515d0fbab6094084e6dc12-e-1&quot;, &quot;chunk-67429b99cdb3121ddbb638d5930365e4-e-6&quot;, &quot;chunk-0d900d0d4731636b239cbd9f79877db4-e-6&quot;, &quot;chunk-a40956025386a6a3ce8ffbe5ab8d14d9-e-4&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-83ca3f8149515d0fbab6094084e6dc12-e-3" label="root-mean-square roughness">
        <attvalues>
          <attvalue for="0" value="root-mean-square roughness" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="均方根粗糙度是衡量表面微观几何特征的物理量。它作为涡轮叶片翼型的一项关键表面属性，直接影响其空气动力学性能，其数值可通过等离子喷涂或EB-PVD等涂层技术进行调整。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-83ca3f8149515d0fbab6094084e6dc12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-83ca3f8149515d0fbab6094084e6dc12-e-4" label="turbine blade aerofoil">
        <attvalues>
          <attvalue for="0" value="turbine blade aerofoil" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮叶片翼型是涡轮叶片沿流体方向的横截面轮廓。其核心功能是通过与高速流体相互作用，高效地将流体的动能与热能转化为驱动涡轮旋转的机械能。它的空气动力学性能对表面粗糙度等物理属性高度敏感。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-83ca3f8149515d0fbab6094084e6dc12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-83ca3f8149515d0fbab6094084e6dc12-e-5" label="aerodynamic performance">
        <attvalues>
          <attvalue for="0" value="aerodynamic performance" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="空气动力学性能是一项性能指标，用于衡量物体与流体（如空气）相互作用时的效率。它直接关系到升力、阻力等关键参数，并会受到物体表面特性（如均方根粗糙度）的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-83ca3f8149515d0fbab6094084e6dc12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-83ca3f8149515d0fbab6094084e6dc12-e-6" label="uncoated blade">
        <attvalues>
          <attvalue for="0" value="uncoated blade" />
          <attvalue for="1" value="Component State" />
          <attvalue for="2" value="一种涡轮叶片组件的状态，指叶片表面没有任何涂层。该状态以一个特定的均方根粗糙度值为其关键物理属性。" />
          <attvalue for="3" value="{&quot;roughness&quot;: &quot;close to 1 µm&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-83ca3f8149515d0fbab6094084e6dc12" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-83ca3f8149515d0fbab6094084e6dc12-e-7" label="plasma-sprayed coating">
        <attvalues>
          <attvalue for="0" value="plasma-sprayed coating" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="等离子喷涂涂层是一种通过热喷涂技术制备的表面涂层。该技术利用高温等离子射流将金属、陶瓷等粉末材料熔化并加速，使其高速喷射到基体表面，快速凝固后形成具有特定功能（如耐磨、耐腐蚀、隔热）的致密保护层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-83ca3f8149515d0fbab6094084e6dc12" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-83ca3f8149515d0fbab6094084e6dc12-e-7&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-83ca3f8149515d0fbab6094084e6dc12-e-8" label="EB-PVD coating">
        <attvalues>
          <attvalue for="0" value="EB-PVD coating" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="电子束物理气相沉积(EB-PVD)涂层是一种通过高能电子束在真空中蒸发材料，使其在基材表面凝结形成的薄膜。该工艺常用于制备致密的柱状晶结构涂层，以提升部件的耐磨、耐腐蚀或隔热等性能，其沉积过程可能改变基材的表面粗糙度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-83ca3f8149515d0fbab6094084e6dc12" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;electron beam vapor deposited coatings&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-83ca3f8149515d0fbab6094084e6dc12-e-8&quot;, &quot;chunk-e215022d1d6f514980641a512c1ab4f3-e-4&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-83ca3f8149515d0fbab6094084e6dc12-e-9" label="TGO thickness">
        <attvalues>
          <attvalue for="0" value="TGO thickness" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="TGO厚度（h）指热生长氧化物层的厚度，是预测界面脱粘（decohesion）起始的关键参数。该氧化物层在高温下于材料表面形成，其临界厚度可通过应变能进行估算，直接影响材料体系的服役可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-83ca3f8149515d0fbab6094084e6dc12" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;TGO thickness, h&quot;, &quot;Thickness&quot;, &quot;thickness of the TGO&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-83ca3f8149515d0fbab6094084e6dc12-e-9&quot;, &quot;chunk-9d4090cefd14aa31985c686534f57a73-e-9&quot;, &quot;chunk-c88b048c96dc246f3cddc3e769c47af8-e-7&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-83ca3f8149515d0fbab6094084e6dc12-e-10" label="Decohesion">
        <attvalues>
          <attvalue for="0" value="Decohesion" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="脱粘（Decohesion）是一种失效机制，指当热生长氧化物（TGO）层厚度达到特定临界值时，通过边缘剥落（edge spallation）方式发生的材料界面分离现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-83ca3f8149515d0fbab6094084e6dc12" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;decohesion&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-83ca3f8149515d0fbab6094084e6dc12-e-10&quot;, &quot;chunk-c929de8b876cec7f9e52b5cbc0ebb2c8-e-2&quot;, &quot;chunk-2723cf8c1579af89abde800442361a57-e-9&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-83ca3f8149515d0fbab6094084e6dc12-e-11" label="Edge spallation">
        <attvalues>
          <attvalue for="0" value="Edge spallation" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="一种失效机理，特指材料或涂层在边缘区域，因受到冲击或应力集中，导致局部发生断裂而形成碎片或薄片并剥离的现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-83ca3f8149515d0fbab6094084e6dc12" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;edge spallation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-83ca3f8149515d0fbab6094084e6dc12-e-11&quot;, &quot;chunk-c929de8b876cec7f9e52b5cbc0ebb2c8-e-3&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c929de8b876cec7f9e52b5cbc0ebb2c8-e-4" label="Strain energy per unit area">
        <attvalues>
          <attvalue for="0" value="Strain energy per unit area" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="一种物理属性，指单位面积内储存的应变能。在脱粘分析中，该值在数值上等于单位面积粘附能，是确定材料脱粘厚度h的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c929de8b876cec7f9e52b5cbc0ebb2c8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c929de8b876cec7f9e52b5cbc0ebb2c8-e-5" label="Adhesion energy per unit area">
        <attvalues>
          <attvalue for="0" value="Adhesion energy per unit area" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="**单位面积附着能**是一种物理性质，指分离单位面积的界面所需要的能量。它也称为界面断裂韧性，符号为Γi，其数值等于界面扩展单位面积时所释放的应变能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c929de8b876cec7f9e52b5cbc0ebb2c8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c929de8b876cec7f9e52b5cbc0ebb2c8-e-6" label="Γi">
        <attvalues>
          <attvalue for="0" value="Γi" />
          <attvalue for="1" value="Physical Variable" />
          <attvalue for="2" value="Γi是一个物理量符号，代表界面断裂韧性（Interfacial Fracture Toughness）。它在物理上定义为分离单位面积界面所需的能量，因此也被称为单位面积的附着能。该参数是衡量两种材料间界面结合强度的关键指标，常用于材料科学和断裂力学中，例如在内聚区厚度方程中计算界面的抗断裂能力。" />
          <attvalue for="3" value="{&quot;value_range&quot;: &quot;5 to 20 J/m²&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c929de8b876cec7f9e52b5cbc0ebb2c8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c929de8b876cec7f9e52b5cbc0ebb2c8-e-7" label="E">
        <attvalues>
          <attvalue for="0" value="E" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="符号E，指热生长氧化物(TGO)的杨氏模量，是衡量该材料刚度的关键力学性能参数。它在界面分离厚度方程等理论模型中，被用作一个重要的计算变量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c929de8b876cec7f9e52b5cbc0ebb2c8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c929de8b876cec7f9e52b5cbc0ebb2c8-e-8" label="ν">
        <attvalues>
          <attvalue for="0" value="ν" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="符号ν，代表TGO（热生长氧化物）的泊松比。该材料属性定义为材料在单向受力时，其横向应变与轴向应变之比的绝对值，是“脱粘厚度方程”等力学模型中的一个关键变量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-c929de8b876cec7f9e52b5cbc0ebb2c8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c929de8b876cec7f9e52b5cbc0ebb2c8-e-9" label="TGO">
        <attvalues>
          <attvalue for="0" value="TGO" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="TGO是一种材料，其关键力学性能由杨氏模量（E）和泊松比（ν）这两个基本参数来定义。这两个参数共同描述了该材料在线弹性范围内的刚度与变形特性，是进行力学分析和工程设计时必需的材料常数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-c929de8b876cec7f9e52b5cbc0ebb2c8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c929de8b876cec7f9e52b5cbc0ebb2c8-e-10" label="σ₀ (critical decohesion stress)">
        <attvalues>
          <attvalue for="0" value="σ₀ (critical decohesion stress)" />
          <attvalue for="1" value="Physical Variable" />
          <attvalue for="2" value="σ₀是一个物理量，代表材料的内聚强度或临界脱粘应力。作为计算脱粘厚度（h）公式中的一个关键参数，它定义了材料界面开始发生分离时所需达到的应力阈值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-c929de8b876cec7f9e52b5cbc0ebb2c8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;σ₀&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c929de8b876cec7f9e52b5cbc0ebb2c8-e-10&quot;]}]" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c929de8b876cec7f9e52b5cbc0ebb2c8-e-11" label="Decohesion Thickness Equation">
        <attvalues>
          <attvalue for="0" value="Decohesion Thickness Equation" />
          <attvalue for="1" value="Formula" />
          <attvalue for="2" value="一个在断裂力学内聚区模型中使用的物理方程。它依据材料的杨氏模量(E)、界面断裂能(Γi)、内聚强度(σ₀)和泊松比(ν)等参数，计算在分离过程中产生的特征长度——脱聚厚度(h)。" />
          <attvalue for="3" value="{&quot;expression&quot;: &quot;h = (EΓi) / (σ₀²(1 − ν²))&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-c929de8b876cec7f9e52b5cbc0ebb2c8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-2723cf8c1579af89abde800442361a57-e-1" label="h at decohesion">
        <attvalues>
          <attvalue for="0" value="h at decohesion" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="h at decohesion是一个计算参数，指材料发生脱聚（decohesion）时的临界高度。该参数常用于评估材料的失效机理，并与热生长氧化物（TGO）层进行比较。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;appreciably smaller than 1 µm&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-2723cf8c1579af89abde800442361a57" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-2723cf8c1579af89abde800442361a57-e-3" label="turbine blade aerofoil">
        <attvalues>
          <attvalue for="0" value="turbine blade aerofoil" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮叶片翼型是涡轮叶片的关键气动部件，用于将高温气流的能量转化为功。其结构特征为包含用于输送冷却气体的内部钻孔，并在表面涂覆热障涂层，以抵御极端工作温度，保护叶片基体材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-2723cf8c1579af89abde800442361a57" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-2723cf8c1579af89abde800442361a57-e-4" label="drilled holes">
        <attvalues>
          <attvalue for="0" value="drilled holes" />
          <attvalue for="1" value="Feature" />
          <attvalue for="2" value="加工在涡轮叶片上的孔状结构。它连通内部冷却通道与叶片外表面，将冷却介质引至叶片外部，从而在高温工作时对翼型进行有效冷却。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-2723cf8c1579af89abde800442361a57" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2723cf8c1579af89abde800442361a57-e-6" label="internal cooling channels">
        <attvalues>
          <attvalue for="0" value="internal cooling channels" />
          <attvalue for="1" value="Feature" />
          <attvalue for="2" value="一种位于高温部件（如燃气轮机叶片）内部的结构特征，由通道及附属的孔组成，用于输送冷却介质（如空气）以实现内部降温。其内壁常施加有热障涂层，以增强对基体材料的耐热保护。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-2723cf8c1579af89abde800442361a57" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Internal cooling channels&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2723cf8c1579af89abde800442361a57-e-6&quot;, &quot;chunk-163aeb0fe9c2f9723756068968baddac-e-1&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2723cf8c1579af89abde800442361a57-e-7" label="thermal barrier coating">
        <attvalues>
          <attvalue for="0" value="thermal barrier coating" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="热障涂层是一种应用于金属基底（如涡轮叶片）表面的先进陶瓷涂层系统。它能在高温环境下提供有效的热隔离，保护基底免受热腐蚀和氧化，从而显著提高发动机的运行温度、效率及部件的服役寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-2723cf8c1579af89abde800442361a57" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2723cf8c1579af89abde800442361a57-e-8" label="failure">
        <attvalues>
          <attvalue for="0" value="failure" />
          <attvalue for="1" value="State" />
          <attvalue for="2" value="指因热生长氧化物（TGO）的厚度达到临界值，从而导致材料或部件功能丧失的一种特定状态。此时观测到的TGO厚度是判断其失效的关键依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-2723cf8c1579af89abde800442361a57" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-163aeb0fe9c2f9723756068968baddac-e-2" label="Thermal barrier coating">
        <attvalues>
          <attvalue for="0" value="Thermal barrier coating" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="热障涂层是一种先进的陶瓷材料体系，应用于高温环境下的金属部件表面。它通过提供热绝缘来保护基材，从而允许更高的运行温度、提升效率并延长部件寿命，常用于燃气轮机等带有内部冷却通道的部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-163aeb0fe9c2f9723756068968baddac" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-163aeb0fe9c2f9723756068968baddac-e-3" label="Holes">
        <attvalues>
          <attvalue for="0" value="Holes" />
          <attvalue for="1" value="Component Feature" />
          <attvalue for="2" value="一种组件内部的结构特征，是内部冷却通道的组成部分。它通过特定的制造方法生成，其设计和生产必须确保在涂层等后续工艺中不会被堵塞，以维持冷却功能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-163aeb0fe9c2f9723756068968baddac" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-163aeb0fe9c2f9723756068968baddac-e-4" label="Manufacturing methods">
        <attvalues>
          <attvalue for="0" value="Manufacturing methods" />
          <attvalue for="1" value="Process Category" />
          <attvalue for="2" value="指为在工件上制造孔洞而采用的，基于材料去除或塑性成形等不同原理的各类工艺方法的总称。它是一个工艺类别，其最终产出物是“孔”这一几何特征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-163aeb0fe9c2f9723756068968baddac" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-163aeb0fe9c2f9723756068968baddac-e-5" label="Coating method">
        <attvalues>
          <attvalue for="0" value="Coating method" />
          <attvalue for="1" value="Process Category" />
          <attvalue for="2" value="指一类特定的热障涂层制备工艺。其关键技术特征是在涂覆过程中，能有效避免涂层材料堵塞部件上的孔洞，从而保证部件（如带有冷却通道的涡轮叶片）的原有功能不受影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-163aeb0fe9c2f9723756068968baddac" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-163aeb0fe9c2f9723756068968baddac-e-6" label="Y. Tamarin">
        <attvalues>
          <attvalue for="0" value="Y. Tamarin" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="Y. Tamarin，作家与学者，因撰写《涡轮叶片防护涂层》(Protective Coatings for Turbine Blades)一书而知名。该书是研究涡轮发动机部件保护涂层技术的重要学术专著，奠定了其在该领域的专家地位。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-163aeb0fe9c2f9723756068968baddac" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-163aeb0fe9c2f9723756068968baddac-e-6&quot;, &quot;chunk-fb8636aebcb8b8d854ebe34fb885b102-e-1&quot;]}]" />
          <attvalue for="9" value="39" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fb8636aebcb8b8d854ebe34fb885b102-e-2" label="Protective Coatings for Turbine Blades">
        <attvalues>
          <attvalue for="0" value="Protective Coatings for Turbine Blades" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Protective Coatings for Turbine Blades》是由Y. Tamarin撰写，ASM International于2002年出版的一本材料科学专著。该书系统地阐述了用于保护燃气轮机叶片免受高温氧化和腐蚀的各种涂层技术、材料、工艺及应用。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2002&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-fb8636aebcb8b8d854ebe34fb885b102" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Protective Coatings for Turbine Bla&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-163aeb0fe9c2f9723756068968baddac-e-7&quot;, &quot;chunk-fb8636aebcb8b8d854ebe34fb885b102-e-2&quot;]}]" />
          <attvalue for="9" value="39" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-fb8636aebcb8b8d854ebe34fb885b102-e-3" label="ASM International">
        <attvalues>
          <attvalue for="0" value="ASM International" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="ASM International是一个服务于材料科学与工程领域的全球性专业学会和信息资源提供商。它通过出版专业书籍（如《燃气轮机材料技术》）、期刊和数据库来传播行业知识，是该领域重要的信息权威机构。" />
          <attvalue for="3" value="{&quot;location&quot;: &quot;Materials Park, OH&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-fb8636aebcb8b8d854ebe34fb885b102" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fb8636aebcb8b8d854ebe34fb885b102-e-3&quot;, &quot;chunk-326ba48df9469bbb4fb6ddd6a5c15eb8-e-10&quot;]}]" />
          <attvalue for="9" value="39" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
