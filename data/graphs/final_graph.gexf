      <edge source="chunk-f942fb543f3ac01d63fdbc3537940608-e-2" target="chunk-f942fb543f3ac01d63fdbc3537940608-e-8" id="chunk-f942fb543f3ac01d63fdbc3537940608-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DEMONSTRATES_CONCEPT_OF" />
          <attvalue for="12" value="The concept of a dual grain structure has been demonstrated for the ME3 turbine disc superalloy." />
          <attvalue for="13" value="This concept has been demonstrated for the state-of-the-art ME3 turbine disc superalloy" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-f942fb543f3ac01d63fdbc3537940608" />
          <attvalue for="16" value="7.496251874062968e-05" />
          <attvalue for="17" value="0.4000449775112444" />
        </attvalues>
      </edge>
      <edge source="chunk-f942fb543f3ac01d63fdbc3537940608-e-2" target="chunk-f942fb543f3ac01d63fdbc3537940608-e-3" id="chunk-f942fb543f3ac01d63fdbc3537940608-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="HAS_SUPERIOR_PROPERTY" />
          <attvalue for="12" value="The ME3 superalloy has superior tensile data in its bore regions." />
          <attvalue for="13" value="with tensile and creep data which are superior in bore and rim regions, respectively" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-f942fb543f3ac01d63fdbc3537940608" />
          <attvalue for="16" value="0.00014992503748125936" />
          <attvalue for="17" value="0.4000899550224888" />
        </attvalues>
      </edge>
