      <node id="chunk-5d1954b761cf7718ff2558f9e10a2fac-e-8" label="F. Carchedi">
        <attvalues>
          <attvalue for="0" value="F. Carchedi" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="F. Carchedi是一位专家或研究员，因撰写了关于工业燃气轮机未来挑战的论文《Industrial gas turbines: challenges for the future》而知名。他的研究领域可确定为工业燃气轮机技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
