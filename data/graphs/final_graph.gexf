      </node>
      <node id="chunk-cb57093a6357773efc0ab02b57f76fa1-e-25" label="Qinetiq">
        <attvalues>
          <attvalue for="0" value="Qinetiq" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="Qinetiq是一家总部位于英国的跨国国防科技公司。它由英国前国防评估与研究局（DERA）私有化而来，主要为国防、航空航天和安全市场提供技术、产品与解决方案，是重要的政府与军事承包商。" />
          <attvalue for="3" value="{}" />
