        <attvalues>
          <attvalue for="11" value="CARRIED_OUT_IN" />
          <attvalue for="12" value="Superalloy development was carried out in the USA." />
          <attvalue for="13" value="most cutting-edge superalloy development was carried out in support of engine designs for military aircraft – notably in the USA, Europe and the former USSR." />
          <attvalue for="14" value="r-3" />
