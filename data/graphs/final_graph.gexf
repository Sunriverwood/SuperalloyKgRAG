        <attvalues>
          <attvalue for="11" value="IS_NOT_PRONE_TO" />
          <attvalue for="12" value="Platinum-diffused diffusion coatings are not prone to the SRZ effect." />
          <attvalue for="13" value="these are not prone to the SRZ effect, although TCP formation is still possible in the bulk." />
          <attvalue for="14" value="r-5" />
