      <node id="chunk-413a7900ebed3c0bb042bc07c13cf29f-e-11" label="R. M. Cotgrove">
        <attvalues>
          <attvalue for="0" value="R. M. Cotgrove" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="R. M. Cotgrove是一位学者及作家，其代表作为材料科学领域的专著《涂层高温合金的热机械疲劳》(Thermomechanical fatigue of coated superalloys)。" />
          <attvalue for="3" value="{}" />
