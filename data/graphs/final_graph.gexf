        <attvalues>
          <attvalue for="11" value="IS_EXPECTED_FROM" />
          <attvalue for="12" value="Nickel oxide might have been expected to form because nickel is the majority component in the alloys." />
          <attvalue for="13" value="this despite nickel being the majority component in these alloys so that nickel oxide might have been expected under all circumstances." />
          <attvalue for="14" value="r-2" />
