      <node id="chunk-5d1954b761cf7718ff2558f9e10a2fac-e-11" label="Parsons">
        <attvalues>
          <attvalue for="0" value="Parsons" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Parsons》是一部由 A. Strang 等人编辑的论文集出版物。该著作汇集了多篇学术论文，收录了包括《工业燃气轮机：未来的挑战》在内的研究成果，其性质通常为学术会议论文集或专题著作。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-5d1954b761cf7718ff2558f9e10a2fac" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="35" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-5d1954b761cf7718ff2558f9e10a2fac-e-13" label="Utility gas turbine">
        <attvalues>
          <attvalue for="0" value="Utility gas turbine" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="公用燃气轮机（Utility gas turbine）是一种用于公共事业大规模发电的重型燃气轮机，是发电厂的核心动力设备。其设计目标为高功率、高效率和长运行寿命，因此涡轮叶片等热端关键部件因需承受极端高温，必须采用超级合金等先进耐高温材料制造。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-5d1954b761cf7718ff2558f9e10a2fac" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5d1954b761cf7718ff2558f9e10a2fac-e-14" label="Industrial gas turbines">
        <attvalues>
          <attvalue for="0" value="Industrial gas turbines" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="工业燃气轮机是一种将燃料（通常为天然气）的化学能转化为机械功的旋转式内燃机。它作为核心动力组件，主要用于驱动发电机进行大规模发电，或在石油和天然气等行业中直接驱动压缩机、泵等设备。因其高功率和运行灵活性而得到广泛应用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-5d1954b761cf7718ff2558f9e10a2fac" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="35" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7156e9ba9e827ebbbc4b86d5bd16aa0b-e-3" label="Parsons 2003: Engineering Issues in Turbine Machinery, Power Plant and Renewables">
        <attvalues>
          <attvalue for="0" value="Parsons 2003: Engineering Issues in Turbine Machinery, Power Plant and Renewables" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="《Parsons 2003: Engineering Issues in Turbine Machinery, Power Plant and Renewables》是一部工程论文集。该书由A. Strang等人编辑，Maney出版社于2003年出版，内容聚焦于涡轮机械、发电厂及可再生能源等领域的工程议题。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2003&quot;, &quot;location&quot;: &quot;London&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-7156e9ba9e827ebbbc4b86d5bd16aa0b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="35" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-7156e9ba9e827ebbbc4b86d5bd16aa0b-e-4" label="A. Strang et al.">
        <attvalues>
          <attvalue for="0" value="A. Strang et al." />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="A. Strang等人是《Parsons 2003: Engineering Issues in Turbine Machinery, Power Plant and Renewables》一书的编辑团队。该实体代表由A. Strang作为第一署名人及其他合作者共同组成的编者团体。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-7156e9ba9e827ebbbc4b86d5bd16aa0b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="35" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7156e9ba9e827ebbbc4b86d5bd16aa0b-e-5" label="Maney">
        <attvalues>
          <attvalue for="0" value="Maney" />
          <attvalue for="1" value="Organization" />
          <attvalue for="2" value="Maney是一家学术出版商，为材料、矿物与采矿学会(IOM3)等专业机构出版刊物。其出版物专注于材料科学、工程技术和能源（如涡轮机械、发电厂）等领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-7156e9ba9e827ebbbc4b86d5bd16aa0b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="35" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7156e9ba9e827ebbbc4b86d5bd16aa0b-e-6" label="Institute of Materials, Minerals and Mining">
        <attvalues>
          <attvalue for="0" value="Institute of Materials, Minerals and Mining" />
          <attvalue for="1" value="Publisher" />
          <attvalue for="2" value="材料、矿物与采矿学会（IOM3）是一个总部位于英国的专业工程机构。它服务于全球从事材料、矿物、采矿及相关技术领域的科学家、技术人员和工程师，通过提供专业认证、教育资源和出版物等方式，致力于推动该领域的科学发展与技术创新。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-7156e9ba9e827ebbbc4b86d5bd16aa0b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;The Institute of Materials&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-27d4439c082e1df0f703012a02b14ffb-e-7&quot;, &quot;chunk-7156e9ba9e827ebbbc4b86d5bd16aa0b-e-6&quot;]}]" />
          <attvalue for="9" value="35" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7156e9ba9e827ebbbc4b86d5bd16aa0b-e-7" label="J. Gayda">
        <attvalues>
          <attvalue for="0" value="J. Gayda" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="J. Gayda是一位材料科学家，也是科学论文《双重微观结构热处理对先进镍基盘形合金的影响》的合著者之一。其研究领域涉及先进镍基高温合金的材料性能与热处理工艺。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-7156e9ba9e827ebbbc4b86d5bd16aa0b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7156e9ba9e827ebbbc4b86d5bd16aa0b-e-8" label="T. Gabb">
        <attvalues>
          <attvalue for="0" value="T. Gabb" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="T. Gabb是一位材料科学领域的研究人员，其研究方向涉及先进镍基盘片合金。他是学术论文《The effect of dual microstructure heat treatment on an advanced nickel-base disk alloy》的合著者之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-7156e9ba9e827ebbbc4b86d5bd16aa0b" />
          <attvalue for="6" value="true" />
