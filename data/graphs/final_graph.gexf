        <attvalues>
          <attvalue for="11" value="MEASURED_IN" />
          <attvalue for="12" value="Paris exponents are a parameter considered within stage II growth." />
          <attvalue for="13" value="However, at both temperatures, the Paris exponents in stage II growth were not heavily influenced by grain size." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-c5e3ecc2944d1e5e7853c5fa9484d5fa" />
          <attvalue for="16" value="0.0009153318077803204" />
          <attvalue for="17" value="0.40054919908466824" />
