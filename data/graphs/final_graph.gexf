        <attvalues>
          <attvalue for="0" value="Assistant Director of Research" />
          <attvalue for="1" value="Role" />
          <attvalue for="2" value="研究副总监是罗尔斯·罗伊斯大学技术中心的一个职位，由一位匿名人士于1994年至2002年间担任。" />
