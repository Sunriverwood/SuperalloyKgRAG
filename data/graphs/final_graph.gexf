      <edge source="chunk-f5c07b55f3d29bb402b546962b69a445-e-8" target="chunk-c66cb4a523402b814bf33ff19d16eb24-e-4" id="chunk-c66cb4a523402b814bf33ff19d16eb24-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="COMPONENT_OF" />
          <attvalue for="12" value="Turbine discs are components for a large land-based turbine." />
          <attvalue for="13" value="...each of which is sufficient for just two turbine discs for a large land-based turbine." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-c66cb4a523402b814bf33ff19d16eb24" />
          <attvalue for="16" value="0.0011763680724991286" />
          <attvalue for="17" value="0.4007058208434995" />
        </attvalues>
      </edge>
      <edge source="chunk-f5c07b55f3d29bb402b546962b69a445-e-8" target="chunk-7e79124b1e7a81a0aeb685547f1f14b7-e-3" id="chunk-7e79124b1e7a81a0aeb685547f1f14b7-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="IS_MADE_FROM" />
          <attvalue for="12" value="The final machined disc is made from a turbine disc forging, with the final mass being a small fraction of the initial mass." />
          <attvalue for="13" value="These steps are obviously such that the mass of material in the final machined disc is only a small fraction of that in the turbine disc forging from which it is made." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-7e79124b1e7a81a0aeb685547f1f14b7" />
          <attvalue for="16" value="0.0011763680724991286" />
          <attvalue for="17" value="0.4007058208434995" />
