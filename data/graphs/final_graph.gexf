      <node id="chunk-2b7a9fe88ca8d6ac202cedf8f0e4d421-e-5" label="Publication [15]">
        <attvalues>
          <attvalue for="0" value="Publication [15]" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇于2004年发表在期刊《Surface and Coatings Technology》上的科学论文，标题为“Tailored microstructure of EB-PVD 8YSZ thermal barrier coatings with low thermal conductivity and high thermal reflectivity for turbine applications”。该论文由D. M. Zhu等人撰写，主要研究了用于涡轮应用的EB-PVD 8YSZ热障涂层的微观结构、低导热性和高热反射率特性。" />
          <attvalue for="3" value="{&quot;year&quot;: &quot;2004&quot;, &quot;volume&quot;: &quot;190&quot;, &quot;pages&quot;: &quot;132–149&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2b7a9fe88ca8d6ac202cedf8f0e4d421" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="23" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2b7a9fe88ca8d6ac202cedf8f0e4d421-e-6" label="K. Wada">
        <attvalues>
          <attvalue for="0" value="K. Wada" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="K. Wada是一名研究人员，作为科学论文《Crystallographic texture evolution in ZrO2-Y2O3 layers...》的共同作者而在此上下文中被识别。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
