          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-6f4f79d57f35ab3e77324ff6707d70bf-e-13" label="advanced jet engine service-retired TBC component">
        <attvalues>
          <attvalue for="0" value="advanced jet engine service-retired TBC component" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种带有热障涂层（TBC）的部件，从先进航空喷气发动机上拆卸而来，并已结束其服役周期。该部件是研究其在长期真实工况下材料性能退化与失效机制的物理样本。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-6f4f79d57f35ab3e77324ff6707d70bf" />
          <attvalue for="6" value="true" />
