        <attvalues>
          <attvalue for="0" value="fatal flaw" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="指一种由夹杂物类别（Di）导致的严重缺陷。它是一个可能发生的概念性事件，其出现的概率由符号 p3 表示。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-82c9ced81969f3e1552c36cf4bd5f22e" />
