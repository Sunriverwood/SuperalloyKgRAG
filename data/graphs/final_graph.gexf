      <node id="chunk-d6790fb9c1169445a5d3fb409c8aba9c-e-6" label="p2">
        <attvalues>
          <attvalue for="0" value="p2" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="一个与损伤相关的因变量，其值受变量d的制约。当d从0增加到D时，p2的值从其初始值p1衰减至0。该变量通常用于量化某种随距离或损伤程度而减弱的效应强度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-d6790fb9c1169445a5d3fb409c8aba9c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
