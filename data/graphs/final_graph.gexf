        </attvalues>
      </node>
      <node id="chunk-841b2737c18dab16d8441fbf4d0199c2-e-4" label="T">
        <attvalues>
          <attvalue for="0" value="T" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="T，即线张力，是一个物理量，指作用于线状物（如位错线或三相接触线）上，使其趋于缩短的单位长度力。它与系统的静态平衡条件密切相关，其数值在一些理论模型中可由G和b等参数近似估算。" />
          <attvalue for="3" value="{&quot;approximation&quot;: &quot;½Gb²&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-841b2737c18dab16d8441fbf4d0199c2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-841b2737c18dab16d8441fbf4d0199c2-e-4&quot;, &quot;chunk-c026408b0eb125d3c56d1ed05d0a0f15-e-11&quot;]}]" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-841b2737c18dab16d8441fbf4d0199c2-e-5" label="F">
        <attvalues>
          <attvalue for="0" value="F" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="F是一个物理量，指在静力平衡条件下，作用于物体竖直方向的力。它与其他竖直方向的力大小相等、方向相反，共同维持物体在竖直方向上的平衡状态，使其合力为零。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-841b2737c18dab16d8441fbf4d0199c2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-841b2737c18dab16d8441fbf4d0199c2-e-6" label="φ">
        <attvalues>
          <attvalue for="0" value="φ" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="φ是一个物理学变量，特指在静力平衡（static equilibrium）问题中定义的一个角度。该角度与另一角度θ存在函数或定义上的关联，其具体数值或物理意义由θ确定。" />
          <attvalue for="3" value="{&quot;definition&quot;: &quot;π − 2θ&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-841b2737c18dab16d8441fbf4d0199c2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-841b2737c18dab16d8441fbf4d0199c2-e-6&quot;, &quot;chunk-7a6c9fcb3f2b7a674344b4f3de5375ce-e-5&quot;]}]" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-841b2737c18dab16d8441fbf4d0199c2-e-7" label="θ">
        <attvalues>
          <attvalue for="0" value="θ" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="变量θ是一个角度，其具体定义见图2.45(b)。它是一个基础参数，被用于定义φ和λ₁等其他相关变量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-841b2737c18dab16d8441fbf4d0199c2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-841b2737c18dab16d8441fbf4d0199c2-e-8" label="λ₁ (Geometric Variable)">
        <attvalues>
          <attvalue for="0" value="λ₁ (Geometric Variable)" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="λ₁是一个几何学变量，代表由半径R和对应圆心角θ所决定的特定弧长。它通常在数学表达式中作为分母，用于计算与其他长度（如2r₁）的比值。" />
          <attvalue for="3" value="{&quot;definition&quot;: &quot;2R sin θ&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-841b2737c18dab16d8441fbf4d0199c2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;λ₁&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-841b2737c18dab16d8441fbf4d0199c2-e-8&quot;]}]" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-841b2737c18dab16d8441fbf4d0199c2-e-9" label="G">
        <attvalues>
          <attvalue for="0" value="G" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="G是一个用于计算线张力（T）近似值的变量。在相关物理模型中，它被用作T的估算值或作为计算其近似值的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-841b2737c18dab16d8441fbf4d0199c2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-841b2737c18dab16d8441fbf4d0199c2-e-10" label="b">
        <attvalues>
          <attvalue for="0" value="b" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="一个用于近似计算线张力（T）的变量。在相关的物理模型或经验公式中，它通常作为一个关键参数，其数值直接影响或决定了线张力T的最终近似结果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-841b2737c18dab16d8441fbf4d0199c2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-841b2737c18dab16d8441fbf4d0199c2-e-12" label="2r₁/λ₁">
        <attvalues>
          <attvalue for="0" value="2r₁/λ₁" />
          <attvalue for="1" value="Ratio" />
          <attvalue for="2" value="一个数学比率，通过公式 2r₁/λ₁ 计算，表示变量r₁的两倍与变量λ₁的比值。该比率的值是λ₁的函数，且在特定上下文中是一个需要被估算的量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-841b2737c18dab16d8441fbf4d0199c2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c57d743ecd992fc77a60fae245010e74-e-1" label="estimate of 2r₁/λ₁">
        <attvalues>
          <attvalue for="0" value="estimate of 2r₁/λ₁" />
          <attvalue for="1" value="Objective" />
          <attvalue for="2" value="一个旨在通过数学推导来估算物理量比值 2r₁/λ₁ 的目标。该估算过程依赖于对变量 λ₁ 以及 A 的分析与运用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-c57d743ecd992fc77a60fae245010e74" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c57d743ecd992fc77a60fae245010e74-e-2" label="2r₁/λ₁">
        <attvalues>
          <attvalue for="0" value="2r₁/λ₁" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="一个无量纲参数，定义为颗粒直径（2r₁）与平均颗粒间距（λ₁）的比值。它用于描述颗粒系统中的空间分布和填充密度，是表征颗粒间相互作用强弱和系统物理特性的重要指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-c57d743ecd992fc77a60fae245010e74" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c57d743ecd992fc77a60fae245010e74-e-4" label="A">
        <attvalues>
          <attvalue for="0" value="A" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="参数A，代表由“解旋过程”产生的扫过面积。该参数由L定义，其数值与2r₁/λ₁的估计值存在计算上的关联。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;L²&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c57d743ecd992fc77a60fae245010e74" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c57d743ecd992fc77a60fae245010e74-e-5" label="unzipping process">
        <attvalues>
          <attvalue for="0" value="unzipping process" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="在材料科学中，指位错线在晶体滑移面上运动的过程。该过程如同拉链般逐次切开并重组原子键，从而扫过一个已滑移的区域'A'，导致材料的塑性变形。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c57d743ecd992fc77a60fae245010e74" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c57d743ecd992fc77a60fae245010e74-e-6" label="random array of particles">
        <attvalues>
          <attvalue for="0" value="random array of particles" />
          <attvalue for="1" value="Physical System" />
          <attvalue for="2" value="指在滑移面上随机排布的粒子所构成的物理系统。它代表了粒子的真实、不规则的物理构型，在理论分析中，常将其简化并建模为方形晶格等有序结构以便于研究。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c57d743ecd992fc77a60fae245010e74" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c57d743ecd992fc77a60fae245010e74-e-7" label="square lattice">
        <attvalues>
          <attvalue for="0" value="square lattice" />
          <attvalue for="1" value="Conceptual Model" />
          <attvalue for="2" value="一种概念模型，通过将粒子抽象为排布在二维正方形网格上的点，来模拟粒子的随机阵列。该模型中，相邻格点间的距离（晶格间距）被定义为'L'。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-c57d743ecd992fc77a60fae245010e74" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c57d743ecd992fc77a60fae245010e74-e-8" label="L">
        <attvalues>
          <attvalue for="0" value="L" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="参数L，代表正方晶格模型的晶格常数（Lattice constant），即晶格中相邻格点间的距离。它是一个基础物理量，用于定义和计算模型的面积A、总格点数Ns等其他相关属性。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;A⁻¹/²&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-c57d743ecd992fc77a60fae245010e74" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c57d743ecd992fc77a60fae245010e74-e-9" label="Ns">
        <attvalues>
          <attvalue for="0" value="Ns" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="Ns，即粒子面数密度（particle surface number density），是一个物理参数，定义为单位面积上存在的粒子数量。它通常是一个派生量，可通过体积数密度（Nv）、特征厚度（L）或粒子直径（2r）等参数计算得出。" />
          <attvalue for="3" value="{&quot;formula_1&quot;: &quot;L⁻²&quot;, &quot;formula_2&quot;: &quot;Nv × 2r&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-c57d743ecd992fc77a60fae245010e74" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c57d743ecd992fc77a60fae245010e74-e-9&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c57d743ecd992fc77a60fae245010e74-e-10" label="Nv">
        <attvalues>
          <attvalue for="0" value="Nv" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="Nv，即粒子数密度（Number Density），是物理学中的一个基本物理量，定义为单位体积内的粒子数量。它被用来描述物质的宏观状态，并作为计算平均自由程（L）等其他相关量的基础。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;f/⅓πr₁³&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-c57d743ecd992fc77a60fae245010e74" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c57d743ecd992fc77a60fae245010e74-e-10&quot;, &quot;chunk-54db0fe1dd89cd8e8ede6b8d3623ba34-e-2&quot;]}]" />
          <attvalue for="9" value="31" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c57d743ecd992fc77a60fae245010e74-e-11" label="2r">
        <attvalues>
          <attvalue for="0" value="2r" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="代表颗粒直径的参数，其值为颗粒半径(r)的两倍。它是一个用于定义或计算Ns的关键变量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-c57d743ecd992fc77a60fae245010e74" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c57d743ecd992fc77a60fae245010e74-e-12" label="f">
        <attvalues>
          <attvalue for="0" value="f" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="参数 `f`，代表体积分数（Volume Fraction），即混合物中特定组分的体积与总体积之比。在特定公式中，它是一个用于计算物理量 `Nv` 的关键变量。" />
          <attvalue for="3" value="{}" />
