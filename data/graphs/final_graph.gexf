        <attvalues>
          <attvalue for="11" value="HAS_PROPERTY" />
          <attvalue for="12" value="The superlattice extrinsic stacking fault (SESF) has a low fault energy." />
          <attvalue for="13" value="As with the SISF fault, no nearest-neighbour violations are produced, so the fault energy is low." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-e69ec61e4ba33a69deaed5cb75487264" />
          <attvalue for="16" value="4.224043254202923e-05" />
