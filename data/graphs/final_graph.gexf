        <attvalues>
          <attvalue for="11" value="CONTRIBUTES_TO" />
          <attvalue for="12" value="The improvement in fuel economy is a key factor in the overall technological success." />
          <attvalue for="13" value="a fuel economy which has improved by a factor of about 2; ... a number of factors have contributed to this technological success" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-c66ff8a529b9512996f0b3af456f00ce" />
