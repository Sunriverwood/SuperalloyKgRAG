        </attvalues>
      </node>
      <node id="chunk-833b212eb3a569521f9a95be24874ec1-e-6" label="Acta Metallurgica">
        <attvalues>
          <attvalue for="0" value="Acta Metallurgica" />
          <attvalue for="1" value="Journal" />
          <attvalue for="2" value="`Acta Metallurgica`是一本国际知名的学术期刊，专注于冶金学和材料科学领域。它发表该领域的原创性研究，是著名期刊《Acta Materialia》的前身，在学界具有重要历史地位。" />
          <attvalue for="3" value="{&quot;volume&quot;: &quot;28&quot;, &quot;pages&quot;: &quot;1085–1101&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-833b212eb3a569521f9a95be24874ec1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="91" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5b143324ae92718a4dde1cd69bd72bd2-e-2" label="d block">
        <attvalues>
          <attvalue for="0" value="d block" />
          <attvalue for="1" value="Periodic Table Section" />
          <attvalue for="2" value="d区（d-block）是元素周期表的一个分区，包含第3族至第12族的元素。其元素的最高能量电子填充在d轨道，因此该区元素也常被称为过渡金属。代表元素有铼(Re)和钌(Ru)等。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-5b143324ae92718a4dde1cd69bd72bd2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;d block of the periodic table&quot;]" />
