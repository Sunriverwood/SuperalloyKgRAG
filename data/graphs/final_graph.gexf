      <node id="chunk-50f39f54006f612a0e1ae1be19a6ae87-e-13" label="Microstructural and microchemical development of simple and Pt-modified aluminide">
        <attvalues>
          <attvalue for="0" value="Microstructural and microchemical development of simple and Pt-modified aluminide" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由J. Angenete、K. Stiller和E. Bakchinova合著的研究论文。该论文主要探讨了简单铝化物及经铂改性的铝化物在微观结构与微观化学层面的发展与演变过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-50f39f54006f612a0e1ae1be19a6ae87" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-8031eb636b002393280031950b878895-e-4" label="Long term oxidation">
        <attvalues>
          <attvalue for="0" value="Long term oxidation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="长期氧化是一种化学过程，指材料（如Pt改性铝化物涂层）在高温环境下长时间与氧发生反应，导致表面形成氧化层并可能发生性能退化。在材料科学中，该过程常被用作一种实验方法，以研究和评估材料或涂层的抗氧化性能、稳定性和使用寿命。" />
          <attvalue for="3" value="{&quot;temperature&quot;: &quot;1050 °C&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-8031eb636b002393280031950b878895" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8031eb636b002393280031950b878895-e-6" label="W. S. Walston">
        <attvalues>
          <attvalue for="0" value="W. S. Walston" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="W. S. Walston是一位材料科学领域的研究人员。他撰写了一篇关于高温合金微观结构不稳定性的论文，该论文发表于1996年的国际高温合金会议论文集（Superalloys 1996）中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-8031eb636b002393280031950b878895" />
          <attvalue for="6" value="true" />
