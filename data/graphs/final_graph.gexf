        <attvalues>
          <attvalue for="11" value="PRECEDES_ACTION_OF" />
          <attvalue for="12" value="The conversion process is performed to achieve a fine-grained structure before the forgemaster's shaping operation." />
          <attvalue for="13" value="Having achieved a fine-grained uniform structure through the conversion process, the objective of the forgemaster is to turn the cylinder of metal into a shape close to that of the turbine disc." />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-6542d72e1fe020ba20ec3d195bda41be" />
          <attvalue for="16" value="0.004262574595055414" />
