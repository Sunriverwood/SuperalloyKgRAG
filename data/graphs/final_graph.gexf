        <attvalues>
          <attvalue for="11" value="PROMOTES_FORMATION_OF" />
          <attvalue for="12" value="Interdiffusion with the substrate promotes the formation of the y' phase." />
          <attvalue for="13" value="interdiffusion with the substrate, which causes... the formation of y' to be promoted" />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-c4027f79a0ee2caae7fc9e91bab6483f" />
          <attvalue for="16" value="0.00013365410318096765" />
          <attvalue for="17" value="0.4000801924619086" />
        </attvalues>
      </edge>
