        <attvalues>
          <attvalue for="11" value="HAS" />
          <attvalue for="12" value="The bore region of the part has a greater thermal mass." />
          <attvalue for="13" value="enhancing the heat transport coefficient at the bore region of the part on account of its greater thermal mass" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-6261bb103f1582e3eddbed3d2b069224" />
          <attvalue for="16" value="0.00248015873015873" />
          <attvalue for="17" value="0.40148809523809526" />
        </attvalues>
