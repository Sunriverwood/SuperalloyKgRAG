      <edge source="chunk-2b79180c24fc2ac7584f9f1d82b69f2b-e-8" target="chunk-2b79180c24fc2ac7584f9f1d82b69f2b-e-4" id="chunk-2b79180c24fc2ac7584f9f1d82b69f2b-r-2" weight="5.0">
        <attvalues>
          <attvalue for="11" value="MAINTAINS_TEMPERATURE_NEAR" />
          <attvalue for="12" value="During the three forging operations, the temperature is kept very close to the solvus of the alloy." />
          <attvalue for="13" value="In these three operations the temperature is typically kept very close to the appropriate solvus of the alloy being forged" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-2b79180c24fc2ac7584f9f1d82b69f2b" />
          <attvalue for="16" value="7.002801120448179e-05" />
          <attvalue for="17" value="0.4000420168067227" />
        </attvalues>
      </edge>
      <edge source="chunk-2b79180c24fc2ac7584f9f1d82b69f2b-e-8" target="chunk-0b79cef081fe645143c11d92068c62ab-e-5" id="chunk-2b79180c24fc2ac7584f9f1d82b69f2b-r-5" weight="4.0">
        <attvalues>
          <attvalue for="11" value="PROMOTES" />
          <attvalue for="12" value="The controlled temperature during the forging operations ensures that any recrystallisation occurs." />
          <attvalue for="13" value="thereby ensuring that any recrystallisation that does occur results in a finer grain structure" />
          <attvalue for="14" value="r-5" />
          <attvalue for="15" value="chunk-2b79180c24fc2ac7584f9f1d82b69f2b" />
          <attvalue for="16" value="0.00014005602240896358" />
          <attvalue for="17" value="0.26675070028011205" />
        </attvalues>
      </edge>
      <edge source="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-1" target="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-e-2" id="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="SUBJECTED_TO" />
          <attvalue for="12" value="Forged discs are subjected to a quenching process at the end of processing." />
          <attvalue for="13" value="At the end of processing the forged discs are either quenched into a bath of oil or water, or else left to cool on the shop floor." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-7020c5ad4ec34b1e7bf297a57e5aeaad" />
          <attvalue for="16" value="0.0020536025060911936" />
          <attvalue for="17" value="0.40123216150365476" />
        </attvalues>
      </edge>
