        <attvalues>
          <attvalue for="11" value="DESIGNED_FOR" />
          <attvalue for="12" value="The design of N18 emphasized the promotion of damage tolerance." />
          <attvalue for="13" value="When designing the powder disc superalloy N18 in the mid-1980s, SNECMA placed considerable emphasis [38] on promoting damage tolerance..." />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-2457bc4af0771717326f8f8489539e06" />
          <attvalue for="17" value="0.4" />
