          <attvalue for="0" value="Figure 2.47" />
          <attvalue for="1" value="Figure" />
          <attvalue for="2" value="图2.47是一张关于单晶镍铝合金时效硬化的数据图。它通过实验数据，直观描绘了材料硬化效果所遵循的 r¹/² 依赖关系，用以阐明其物理机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
