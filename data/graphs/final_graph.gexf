      <node id="chunk-e59e76ae369265e25373e5545e9102c3-e-4" label="Inward aluminide coating">
        <attvalues>
          <attvalue for="0" value="Inward aluminide coating" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="内扩散铝化物涂层是一种高温防护涂层。其形成机理是：在涂层生长过程中，外部源的铝是主要扩散物种，向内扩散渗入基体材料中。这种以铝元素向内扩散为主的生长机制，是其与基体元素向外扩散为主的外扩散铝化物涂层的核心区别。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-e59e76ae369265e25373e5545e9102c3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;inward aluminide coatings&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e59e76ae369265e25373e5545e9102c3-e-4&quot;]}]" />
          <attvalue for="9" value="231" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e59e76ae369265e25373e5545e9102c3-e-5" label="Outward aluminide coating">
        <attvalues>
          <attvalue for="0" value="Outward aluminide coating" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="一种高温防护铝化物涂层。其形成机理为：高温下，基体中的主要金属原子（如镍）向外扩散，与外部的铝源反应，使涂层在工件原始表面之上生长形成。该机理与铝向内扩散的内生涂层相反。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e59e76ae369265e25373e5545e9102c3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;outward aluminide coatings&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e59e76ae369265e25373e5545e9102c3-e-5&quot;]}]" />
          <attvalue for="9" value="231" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e59e76ae369265e25373e5545e9102c3-e-7" label="gas phase aluminisation">
        <attvalues>
          <attvalue for="0" value="gas phase aluminisation" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="一种高温表面化学热处理工艺。通过在气态介质中，使活性铝原子渗入工件表层，与基体金属反应形成一层铝化物涂层，以显著提高材料的抗高温氧化和耐腐蚀性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-e59e76ae369265e25373e5545e9102c3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e59e76ae369265e25373e5545e9102c3-e-8" label="high temperature low activity (HTLA) variant">
        <attvalues>
          <attvalue for="0" value="high temperature low activity (HTLA) variant" />
          <attvalue for="1" value="Process Variant" />
          <attvalue for="2" value="高温低活度（HTLA）变体是一种特定的铝化物涂层制备工艺。该工艺在高温和低铝活度条件下，主要通过基材元素（如镍）向外扩散与铝反应形成涂层。它常用于为航空发动机涡轮叶片等高温合金部件提供抗氧化和抗腐蚀保护。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-e59e76ae369265e25373e5545e9102c3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e59e76ae369265e25373e5545e9102c3-e-8&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e59e76ae369265e25373e5545e9102c3-e-9" label="interdiffusion effects">
        <attvalues>
          <attvalue for="0" value="interdiffusion effects" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="一种物理现象，指铝化物涂层与基体材料之间，因原子在界面处相互扩散，而引发的材料成分、结构与性能发生变化的总称。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-e59e76ae369265e25373e5545e9102c3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e59e76ae369265e25373e5545e9102c3-e-9&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e59e76ae369265e25373e5545e9102c3-e-10" label="low temperature high activity (LTHA) variant">
        <attvalues>
          <attvalue for="0" value="low temperature high activity (LTHA) variant" />
          <attvalue for="1" value="Process Variant" />
          <attvalue for="2" value="低温高活性（LTHA）是一种制备渗铝涂层的工艺变体。其特点是在相对较低的温度下，利用高活性铝源，在基材表面快速形成一层致密的保护性涂层，以抵抗高温氧化和腐蚀。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-e59e76ae369265e25373e5545e9102c3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e59e76ae369265e25373e5545e9102c3-e-10&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e59e76ae369265e25373e5545e9102c3-e-12" label="pack cementation">
        <attvalues>
          <attvalue for="0" value="pack cementation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="粉末渗镀是一种表面扩散涂层工艺。它将工件埋在含有渗镀元素、活化剂和惰性填料的粉末混合物中并密闭加热。渗镀元素通过气相传递在工件表面沉积并向内扩散，形成致密的合金化保护层，以提高基体的抗高温氧化、耐腐蚀等性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-e59e76ae369265e25373e5545e9102c3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e59e76ae369265e25373e5545e9102c3-e-12&quot;, &quot;chunk-151e712d06b4c385e5757120e064b560-e-2&quot;, &quot;chunk-aedbe4412d2761c1e12ab362e44dea99-e-3&quot;, &quot;chunk-fbbf41abcd4950c59415caeec768db40-e-7&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-151e712d06b4c385e5757120e064b560-e-1" label="LTHA variant 293">
        <attvalues>
          <attvalue for="0" value="LTHA variant 293" />
          <attvalue for="1" value="Material Variant" />
          <attvalue for="2" value="LTHA 变体 293 是一种特定的材料变体。它可通过包埋渗镀等工艺进行加工，其氧化行为是评估其性能的关键特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-151e712d06b4c385e5757120e064b560" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-151e712d06b4c385e5757120e064b560-e-3" label="alumina-silica moulds">
        <attvalues>
          <attvalue for="0" value="alumina-silica moulds" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种以氧化铝(Al₂O₃)和二氧化硅(SiO₂)为主要成分的耐火材料模具。因其优异的耐高温性、化学稳定性和抗热震性，被广泛应用于航空航天和工业领域的金属熔模铸造（精密铸造）工艺中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-151e712d06b4c385e5757120e064b560" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="385" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-151e712d06b4c385e5757120e064b560-e-4" label="aluminium">
        <attvalues>
          <attvalue for="0" value="aluminium" />
          <attvalue for="1" value="Alloying Element" />
          <attvalue for="2" value="作为一种合金元素，它用于强化γ'（伽马）相、提供抗氧化性，并且是铝化物涂层的组成部分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-151e712d06b4c385e5757120e064b560" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-151e712d06b4c385e5757120e064b560-e-5" label="gamma prime">
        <attvalues>
          <attvalue for="0" value="gamma prime" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="Gamma prime (γ') 是一种在镍基高温合金中起主要强化作用的金属间化合物相。其化学成分通常为Ni₃(Al, Ti)，具有L1₂有序晶体结构。该相作为共格沉淀相弥散分布在γ基体中，是合金具备优异高温强度和抗蠕变性能的关键。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-151e712d06b4c385e5757120e064b560" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Gamma prime&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-151e712d06b4c385e5757120e064b560-e-5&quot;, &quot;chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-13&quot;, &quot;chunk-c8a13933656ed9f144b18b40f2e9861e-e-14&quot;, &quot;chunk-cad1eaa9ffb0e731892120bbe3415da7-e-5&quot;, &quot;chunk-be2e5714ffd15b4d499890769149ecb3-e-12&quot;, &quot;chunk-44260d4b7de8c9a00040496e0aad271b-e-13&quot;, &quot;chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-151e712d06b4c385e5757120e064b560-e-8" label="aluminium-nickel">
        <attvalues>
          <attvalue for="0" value="aluminium-nickel" />
          <attvalue for="1" value="Alloy System" />
          <attvalue for="2" value="一种由铝和镍组成的基础二元合金系。其关键特征是通过析出具有L1₂结构的γ'相（Ni₃Al金属间化合物）作为强化相，实现显著的沉淀强化效果，是现代镍基高温合金的核心基础。" />
          <attvalue for="3" value="{&quot;phase_diagram&quot;: &quot;binary&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-151e712d06b4c385e5757120e064b560" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-151e712d06b4c385e5757120e064b560-e-9" label="anelastic strain">
        <attvalues>
          <attvalue for="0" value="anelastic strain" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="滞弹性应变是一种材料力学性能，指由内部缺陷（如点缺陷、位错）在外力下运动而引起的形变。其特征是：形变的发展和恢复都与时间相关，但移除外力后，形变最终可以完全恢复，表现出应变响应滞后于应力变化的特点。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-151e712d06b4c385e5757120e064b560" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Anelastic strains&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-151e712d06b4c385e5757120e064b560-e-9&quot;, &quot;chunk-264495632c5fce243bda26582e560253-e-1&quot;, &quot;chunk-8a245245cb1a365cd2add49b05ab2208-e-10&quot;, &quot;chunk-6ec49b4807352fc50a7eb77173350dba-e-1&quot;, &quot;chunk-3ca2e169452aac1fe72512e4665d8d85-e-2&quot;]}]" />
          <attvalue for="9" value="32" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-264495632c5fce243bda26582e560253-e-4" label="gamma prime alloys">
        <attvalues>
          <attvalue for="0" value="gamma prime alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="伽马'相合金（Gamma prime alloys）是一类以金属间化合物γ'相为主要强化相的高温合金。其最显著的特征是“反常屈服效应”，即其屈服强度在一定温度范围内随温度升高而增加。这一独特性能使其成为制造航空发动机涡轮叶片等高温结构部件的关键材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-264495632c5fce243bda26582e560253" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Gamma prime alloys&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-264495632c5fce243bda26582e560253-e-4&quot;, &quot;chunk-be2e5714ffd15b4d499890769149ecb3-e-18&quot;, &quot;chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-3&quot;, &quot;chunk-502aba15d381acd1fe322927c6f750ed-e-8&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-264495632c5fce243bda26582e560253-e-6" label="strengthening models">
        <attvalues>
          <attvalue for="0" value="strengthening models" />
          <attvalue for="1" value="Theoretical Concept" />
          <attvalue for="2" value="一种材料科学的理论概念，指将反相畴界能作为关键参数，用以解释和量化有序合金中位错运动受阻、从而使材料强度提高的理论模型。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-264495632c5fce243bda26582e560253" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-264495632c5fce243bda26582e560253-e-7" label="anti-site defects">
        <attvalues>
          <attvalue for="0" value="anti-site defects" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="反位缺陷是一种晶体点缺陷，指在有序合金或化合物中，一种元素的原子占据了本应由另一种元素原子占据的晶格位置。这种原子错位破坏了材料的理想有序结构，是Ni3Al、NiAl等金属间化合物中常见的缺陷类型。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-264495632c5fce243bda26582e560253" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-264495632c5fce243bda26582e560253-e-10" label="argon atomisation">
        <attvalues>
          <attvalue for="0" value="argon atomisation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="标准化描述:&#10;一种先进的粉末冶金技术，利用高压惰性氩气将熔融金属流雾化成细小的球形液滴。该过程可防止氧化，生产出用于增材制造、热喷涂等领域的高纯度、高质量金属粉末。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-264495632c5fce243bda26582e560253" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="386" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-264495632c5fce243bda26582e560253-e-12" label="gamma prime phase">
        <attvalues>
          <attvalue for="0" value="gamma prime phase" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="γ'相（Gamma Prime Phase）是镍基高温合金中的主要强化相，是一种具有L1₂有序晶体结构的金属间化合物，通常化学式为Ni₃(Al, Ti)。它通过与γ基体形成共格沉淀，赋予合金优异的高温强度和抗蠕变性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-264495632c5fce243bda26582e560253" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-264495632c5fce243bda26582e560253-e-12&quot;, &quot;chunk-f0829bcd269a8d2dfa4641c4b0e70d30-e-9&quot;, &quot;chunk-0ba22e2612dbc225416101c15d4cb857-e-1&quot;, &quot;chunk-66ba88a6026c55d38eeb24aad6777073-e-2&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-264495632c5fce243bda26582e560253-e-13" label="polycrystalline powder disc alloy">
        <attvalues>
          <attvalue for="0" value="polycrystalline powder disc alloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种具有多晶微观结构的盘状合金材料。它通常由金属粉末压制烧结而成，其原子级的成分与微观结构可通过原子探针断层扫描技术进行精确分析，属于一种先进功能或结构材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-264495632c5fce243bda26582e560253" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-264495632c5fce243bda26582e560253-e-14" label="atomic diameter">
        <attvalues>
          <attvalue for="0" value="atomic diameter" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="原子直径是衡量原子整体大小的物理属性。它在元素周期表中呈现出明显的周期性规律：同一周期内，原子直径随原子序数的增加而减小；同一主族内，则随原子序数的增加而增大。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-264495632c5fce243bda26582e560253" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-264495632c5fce243bda26582e560253-e-15" label="Atomic number">
        <attvalues>
          <attvalue for="0" value="Atomic number" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="原子序数（Atomic Number）是原子核中的质子数量，用符号Z表示。它唯一地标识了一种化学元素，并决定其化学性质。在中性原子中，该数值也等于核外电子数，是影响原子直径等物理性质的基本属性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-264495632c5fce243bda26582e560253" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;atomic number&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-264495632c5fce243bda26582e560253-e-15&quot;, &quot;chunk-1410988dfcbd0392c9d01a4bc32fcff9-e-5&quot;, &quot;chunk-54728fc56c44ccf66b9375798fee1dd9-e-9&quot;, &quot;chunk-114d612b5f5f30e54d96d2a909a6dd20-e-3&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-264495632c5fce243bda26582e560253-e-18" label="Billet Cogging">
        <attvalues>
          <attvalue for="0" value="Billet Cogging" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="钢坯开坯（Billet Cogging）是一种金属初步热加工工艺，通常指在高温下对钢坯或钢锭进行开式模锻。其主要目的是通过塑性变形减小坯料的横截面、增加其长度，同时破碎其原始的粗大铸态组织，消除内部缺陷，从而改善材料的力学性能，为后续轧制或锻造工序做准备。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-18" />
          <attvalue for="5" value="chunk-264495632c5fce243bda26582e560253" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;billet cogging&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-264495632c5fce243bda26582e560253-e-18&quot;, &quot;chunk-61a441c3ea495edfbd1f923ab25e12c9-e-5&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-61a441c3ea495edfbd1f923ab25e12c9-e-1" label="mic diameter">
        <attvalues>
          <attvalue for="0" value="mic diameter" />
          <attvalue for="1" value="Technical Parameter" />
          <attvalue for="2" value="mic diameter是一个技术参数，指材料中微观结构（如晶粒、颗粒或纤维）的直径。该物理尺寸的变化与原子序数为42的元素（即钼）的含量、分布或处理工艺密切相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-61a441c3ea495edfbd1f923ab25e12c9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="232" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-61a441c3ea495edfbd1f923ab25e12c9-e-2" label="atomic number 42">
        <attvalues>
          <attvalue for="0" value="atomic number 42" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="原子序数（atomic number）是一种基本物理性质，指原子核内的质子数量。原子序数为42的化学元素是钼（Mo），该数值唯一地标识了此元素，并决定了其化学特性以及在元素周期表中的位置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-61a441c3ea495edfbd1f923ab25e12c9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="232" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-61a441c3ea495edfbd1f923ab25e12c9-e-3" label="basic fluxing">
        <attvalues>
          <attvalue for="0" value="basic fluxing" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="碱性熔融 (basic fluxing) 是热腐蚀的一种关键机理。指在高温下，高碱度的熔融盐（如硫酸钠）与材料表面的保护性氧化膜发生反应并将其溶解，使基体金属失去保护，从而导致加速腐蚀的过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-61a441c3ea495edfbd1f923ab25e12c9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-61a441c3ea495edfbd1f923ab25e12c9-e-3&quot;, &quot;chunk-264495632c5fce243bda26582e560253-e-16&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-61a441c3ea495edfbd1f923ab25e12c9-e-7" label="conversion practice">
        <attvalues>
          <attvalue for="0" value="conversion practice" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="指对钢坯进行再加工的制造过程。该过程通常通过轧制、锻造或挤压等塑性变形方法，改变钢坯的形状、尺寸和机械性能，将其转化为棒材、线材、型钢等具有特定用途的成品或半成品。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-61a441c3ea495edfbd1f923ab25e12c9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-61a441c3ea495edfbd1f923ab25e12c9-e-8" label="extrusion of powder metallurgy product">
        <attvalues>
          <attvalue for="0" value="extrusion of powder metallurgy product" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种金属成形工艺。指将由金属粉末压制并烧结而成的坯料加热后，通过模具进行挤压，以制成具有恒定横截面的致密化产品。该工艺能显著改善材料的力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-61a441c3ea495edfbd1f923ab25e12c9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-61a441c3ea495edfbd1f923ab25e12c9-e-8&quot;]}]" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-61a441c3ea495edfbd1f923ab25e12c9-e-9" label="bimodal gamma prime distribution">
        <attvalues>
          <attvalue for="0" value="bimodal gamma prime distribution" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="一种在高温合金（尤指镍基合金）中常见的显微组织特征。指其关键强化相γ′（伽马撇）的析出物呈现出两种显著不同的尺寸分布（即双峰分布），通常由粗大的初生γ′相和弥散的细小次生γ′相构成。这种结构经特定热处理形成，旨在优化材料的高温强度与蠕变抗力等综合性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-61a441c3ea495edfbd1f923ab25e12c9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-61a441c3ea495edfbd1f923ab25e12c9-e-9&quot;]}]" />
          <attvalue for="9" value="387" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-61a441c3ea495edfbd1f923ab25e12c9-e-12" label="creep rupture behaviour">
        <attvalues>
          <attvalue for="0" value="creep rupture behaviour" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="蠕变断裂行为是一种材料力学性能，指材料在高温和恒定应力作用下，随时间推移发生缓慢塑性变形并最终导致断裂的现象。它是衡量材料在高温下长期承载能力的关键指标，通常用蠕变断裂寿命和断裂伸长率来表征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-61a441c3ea495edfbd1f923ab25e12c9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-61a441c3ea495edfbd1f923ab25e12c9-e-12&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-61a441c3ea495edfbd1f923ab25e12c9-e-18" label="design of composition">
        <attvalues>
          <attvalue for="0" value="design of composition" />
          <attvalue for="1" value="Design Aspect" />
          <attvalue for="2" value="成分设计是涡轮叶片设计的一个关键环节，指确定叶片材料的化学成分与合金配比。此过程旨在优化材料的高温强度、抗蠕变及抗腐蚀等性能，以确保涡轮在极端工况下的安全、可靠与高效运行。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-18" />
          <attvalue for="5" value="chunk-61a441c3ea495edfbd1f923ab25e12c9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-61a441c3ea495edfbd1f923ab25e12c9-e-18&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-61a441c3ea495edfbd1f923ab25e12c9-e-19" label="design of shape and size">
        <attvalues>
          <attvalue for="0" value="design of shape and size" />
          <attvalue for="1" value="Design Aspect" />
          <attvalue for="2" value="涡轮叶片设计中的一个关键方面，指为达到最佳空气动力学性能和结构完整性，而对其几何外形、轮廓和尺寸进行精确定义的过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-19" />
          <attvalue for="5" value="chunk-61a441c3ea495edfbd1f923ab25e12c9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2f922c93a3f1955e166d2270226ee05e-e-5" label="calcium fluoride">
        <attvalues>
          <attvalue for="0" value="calcium fluoride" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="氟化钙（CaF₂）是一种无机化合物，天然存在于矿物萤石中。它是一种不溶于水的白色晶体固体，在冶金工业中被广泛用作助熔剂（如在电渣重熔工艺中），并且是商业上生产氢氟酸和元素氟的最重要来源。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2f922c93a3f1955e166d2270226ee05e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="233" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2f922c93a3f1955e166d2270226ee05e-e-6" label="electroslag remelting slags">
        <attvalues>
          <attvalue for="0" value="electroslag remelting slags" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="电渣重熔渣是电渣重熔工艺中使用的一种关键辅料，通常以氟化钙为主要组分。它在通电后利用电阻热熔化形成熔池，对自耗电极进行重熔、精炼，并能有效去除金属中的杂质，同时隔绝空气以防止金属被氧化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-2f922c93a3f1955e166d2270226ee05e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="233" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2f922c93a3f1955e166d2270226ee05e-e-12" label="turbine disc production">
        <attvalues>
          <attvalue for="0" value="turbine disc production" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="指制造涡轮盘的一系列工艺。涡轮盘是燃气轮机和喷气发动机的关键旋转部件，该过程通常以铸锻产品为原料，通过锻造、热处理和精密加工等工序，使其获得在高温高应力环境下工作所需的高强度和可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-2f922c93a3f1955e166d2270226ee05e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2f922c93a3f1955e166d2270226ee05e-e-13" label="investment casting">
        <attvalues>
          <attvalue for="0" value="investment casting" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="熔模铸造 (Investment casting)，亦称失蜡法，是一种通过精确控制液态金属冷却时的热量传递来生产部件的制造工艺。它采用晶种法和晶粒选择器等技术，并调控抽拉速度、炉体布置等关键参数，以形成具有择优取向的单晶或树枝晶结构，同时避免缺陷的产生。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-2f922c93a3f1955e166d2270226ee05e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Investment casting process&quot;, &quot;investment casting process&quot;, &quot;lost wax process&quot;, &quot;lost-wax process&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2f922c93a3f1955e166d2270226ee05e-e-13&quot;, &quot;chunk-fbbf41abcd4950c59415caeec768db40-e-3&quot;, &quot;chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-12&quot;, &quot;chunk-a67bfee0cc0003cfb8efe7f82e7665c2-e-12&quot;, &quot;chunk-569a3d8aec20d9df6a256b4cf4b263a7-e-9&quot;, &quot;chunk-1297af8788c2be7a2a158412cd2652f3-e-14&quot;, &quot;chunk-d548052a2344b0da613ab35155dcbdaa-e-1&quot;, &quot;chunk-d548052a2344b0da613ab35155dcbdaa-e-13&quot;, &quot;chunk-a9fba026e3b8980c4957dbe16260f585-e-3&quot;, &quot;chunk-d9d581e86b96c92ccf2b9c353b4e4e11-e-5&quot;, &quot;chunk-1159c2afbaaccc92d505d71fb856dee1-e-17&quot;, &quot;chunk-ec1da0ebfe72b58a50620a5a71c6abf7-e-3&quot;, &quot;chunk-dae9be5eb4b7208070b473c392dd0478-e-5&quot;, &quot;chunk-8c75d16dc148897cf486c21cbe30e4be-e-6&quot;, &quot;chunk-2954a9d8cd39d35e1c2ce761efb0de31-e-8&quot;, &quot;chunk-502aba15d381acd1fe322927c6f750ed-e-6&quot;, &quot;chunk-58ee51f26d85456c13aa639ae170ab36-e-4&quot;, &quot;chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-9&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="20" />
        </attvalues>
      </node>
      <node id="chunk-fbbf41abcd4950c59415caeec768db40-e-1" label="turbine disc production">
        <attvalues>
          <attvalue for="0" value="turbine disc production" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="指制造航空发动机及燃气轮机核心旋转部件——涡轮盘的一整套复杂工艺。该过程通常涉及高温合金的锻造、热处理、精密加工及严格的无损检测，以确保成品在高温、高压和高速旋转的极端工况下具有高可靠性与安全性。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;218&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-fbbf41abcd4950c59415caeec768db40" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="388" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-fbbf41abcd4950c59415caeec768db40-e-4" label="cell structure">
        <attvalues>
          <attvalue for="0" value="cell structure" />
          <attvalue for="1" value="Material Microstructure" />
          <attvalue for="2" value="一种在材料发生幂律蠕变等高温塑性变形时，由位错通过动态回复形成的亚晶结构。其特征是高密度位错墙（胞壁）包围着低密度位错的区域（胞内），是材料强韧化的重要机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-fbbf41abcd4950c59415caeec768db40" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fbbf41abcd4950c59415caeec768db40-e-6" label="cementation">
        <attvalues>
          <attvalue for="0" value="cementation" />
          <attvalue for="1" value="Surface Treatment Process" />
          <attvalue for="2" value="一种高温化学热处理工艺，通过将一种或多种元素（如碳、铝、铬等）以扩散方式渗入到固体材料（通常是金属）的表层，从而改变其表面成分和组织，以获得耐磨、耐腐蚀等特定性能。包埋渗镀（pack cementation）是该工艺的一种具体实现方法。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-fbbf41abcd4950c59415caeec768db40" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fbbf41abcd4950c59415caeec768db40-e-6&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a98946fce80230f54608d957bf8fa18-e-1" label="chromium-nickel binary phase diagram">
        <attvalues>
          <attvalue for="0" value="chromium-nickel binary phase diagram" />
          <attvalue for="1" value="Technical Concept" />
          <attvalue for="2" value="铬镍二元相图是一种以温度和成分为坐标的图谱，用于表征铬(Cr)和镍(Ni)两种元素构成的合金系统在平衡状态下的物相组成与转变关系。它清晰地展示了液相线、固相线以及不同固溶体相区的分布，是指导不锈钢、高温合金等材料设计、生产及热处理工艺的关键基础工具。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-8a98946fce80230f54608d957bf8fa18" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="389" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-8a98946fce80230f54608d957bf8fa18-e-2" label="class I alloys">
        <attvalues>
          <attvalue for="0" value="class I alloys" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="I类合金是一种材料分类名称，指在特定标准或技术体系中被归为第一类的合金。该分类通常基于材料的成分、性能或应用领域，并用以区别于II类合金等其他不同等级的合金。其具体定义取决于所应用的特定标准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-8a98946fce80230f54608d957bf8fa18" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8a98946fce80230f54608d957bf8fa18-e-2&quot;]}]" />
          <attvalue for="9" value="234" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a98946fce80230f54608d957bf8fa18-e-3" label="class II alloys">
        <attvalues>
          <attvalue for="0" value="class II alloys" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="II类合金是一种材料分类，指在特定合金分类体系中，与I类合金相区别的一个组别。此分类用于系统地组织和区分不同种类的合金，是合金材料管理和索引中的一个类别。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-8a98946fce80230f54608d957bf8fa18" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8a98946fce80230f54608d957bf8fa18-e-3&quot;]}]" />
          <attvalue for="9" value="234" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a98946fce80230f54608d957bf8fa18-e-4" label="climb">
        <attvalues>
          <attvalue for="0" value="climb" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="在材料科学中，“攀移”（climb）是一种晶体缺陷的运动机制。它特指刃位错在热激活下，通过吸收或释放点缺陷（如空位），从而垂直于其滑移面运动的现象。该过程是材料在高温下发生蠕变等塑性变形的关键微观机制之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-8a98946fce80230f54608d957bf8fa18" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="390" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-8a98946fce80230f54608d957bf8fa18-e-10" label="Diffusion type coating">
        <attvalues>
          <attvalue for="0" value="Diffusion type coating" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="**扩散型涂层**是一种通过热化学处理，使涂层元素在高温下扩散渗入基材表面，从而形成一层与基体具有冶金结合的表面合金化层。这种涂层是基材的组成部分，而非简单的附着层，主要用于提升材料的抗高温氧化、耐腐蚀和耐磨损性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-8a98946fce80230f54608d957bf8fa18" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;diffusion type coatings&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8a98946fce80230f54608d957bf8fa18-e-10&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a98946fce80230f54608d957bf8fa18-e-13" label="failure mechanisms">
        <attvalues>
          <attvalue for="0" value="failure mechanisms" />
          <attvalue for="1" value="Technical Concept" />
          <attvalue for="2" value="失效机制是指导致热障涂层性能下降、结构破坏或最终脱落的各种物理和化学过程。这些过程是决定涂层服役寿命与可靠性的内在属性，具体表现为氧化、开裂、分层和剥落等形式，是热障涂层研究中的关键技术概念。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-8a98946fce80230f54608d957bf8fa18" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a98946fce80230f54608d957bf8fa18-e-14" label="Lifetime estimation models">
        <attvalues>
          <attvalue for="0" value="Lifetime estimation models" />
          <attvalue for="1" value="Technical Concept" />
          <attvalue for="2" value="寿命估算模型指用于系统性预测和评估阻隔涂层有效服务寿命的数学、物理或统计模型。这类模型基于材料的失效机理和环境因素，通过模拟或实验数据分析，来确定涂层的长期耐久性与可靠性，为材料设计与工程应用提供科学依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-8a98946fce80230f54608d957bf8fa18" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;lifetime estimation models&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8a98946fce80230f54608d957bf8fa18-e-14&quot;, &quot;chunk-ea2d68ee6ba96502ab007d093c1ef915-e-6&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f7942340b7bda97e3a76f6ceb1d90c75-e-2" label="failure mechanisms of thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="failure mechanisms of thermal barrier coatings" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="**热障涂层失效机制**是指在高温、氧化及热循环等服役条件下，导致热障涂层性能退化并最终剥落的系列物理与化学过程。主要包括热生长氧化物（TGO）的形成与增厚、陶瓷层烧结、相变、以及由应力集中引发的裂纹萌生与扩展，最终导致涂层分层或剥落。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-f7942340b7bda97e3a76f6ceb1d90c75" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f7942340b7bda97e3a76f6ceb1d90c75-e-3" label="Lifetime estimation models of thermal barrier coatings">
        <attvalues>
          <attvalue for="0" value="Lifetime estimation models of thermal barrier coatings" />
          <attvalue for="1" value="Model" />
          <attvalue for="2" value="一类用于预测热障涂层（TBCs）在高温、复杂应力环境下服役寿命的理论或计算模型。该模型通过分析热循环、氧化、腐蚀等关键因素引起的损伤累积过程，为涂层的可靠性评估和维护决策提供科学依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-f7942340b7bda97e3a76f6ceb1d90c75" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Lifetime estimation models&quot;, &quot;lifetime estimation models of thermal barrier coatings&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-897e7353863e7f334da90636833fd561-e-7&quot;, &quot;chunk-f7942340b7bda97e3a76f6ceb1d90c75-e-3&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f7942340b7bda97e3a76f6ceb1d90c75-e-4" label="MCrAlX-type overlays">
        <attvalues>
          <attvalue for="0" value="MCrAlX-type overlays" />
          <attvalue for="1" value="Coating Overlay" />
          <attvalue for="2" value="MCrAlX覆层是一种高温防护涂层。其化学式中，M代表镍(Ni)或钴(Co)基体，Cr和Al提供抗热腐蚀与抗氧化性，X为钇(Y)等活性元素，用以增强表面保护性氧化膜的附着力，常用于保护航空发动机热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f7942340b7bda97e3a76f6ceb1d90c75" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f7942340b7bda97e3a76f6ceb1d90c75-e-8" label="processing methods">
        <attvalues>
          <attvalue for="0" value="processing methods" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="指用于制造热障涂层（TBC）系统的一系列特定工艺技术。这些方法直接决定了涂层的微观结构、物理性能和结合强度，从而深刻影响其在服役过程中的损伤机制、可靠性及最终使用寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-f7942340b7bda97e3a76f6ceb1d90c75" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f7942340b7bda97e3a76f6ceb1d90c75-e-8&quot;, &quot;chunk-df31d8a0cc69400a7fd30dcdb24ab502-e-2&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-5d942c8f1c01db54bab51b31faea4836-e-2" label="NiCrAlY coatings">
        <attvalues>
          <attvalue for="0" value="NiCrAlY coatings" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="一种由镍(Ni)、铬(Cr)、铝(Al)、钇(Y)组成的镍基高温合金涂层。它能在高温下形成致密的氧化物保护层，提供优异的抗氧化与抗腐蚀性能，常用作热障涂层的粘结层，其性能可通过添加其他合金元素来进一步优化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-5d942c8f1c01db54bab51b31faea4836" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5d942c8f1c01db54bab51b31faea4836-e-4" label="Cobalt-chromium-aluminium-yttrium (CoCrAlY) coatings">
        <attvalues>
          <attvalue for="0" value="Cobalt-chromium-aluminium-yttrium (CoCrAlY) coatings" />
          <attvalue for="1" value="Coating" />
          <attvalue for="2" value="CoCrAlY（钴铬铝钇）是一种由钴、铬、铝、钇组成的金属高温防护涂层。它通过在高温下形成一层致密、稳定的氧化铝保护膜，为基体材料提供优异的抗氧化和抗热腐蚀性能。该涂层广泛用于燃气轮机和航空发动机的高温部件，常在热障涂层系统中充当关键的粘结层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-5d942c8f1c01db54bab51b31faea4836" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="391" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-5d942c8f1c01db54bab51b31faea4836-e-7" label="Coherency">
        <attvalues>
          <attvalue for="0" value="Coherency" />
          <attvalue for="1" value="Material State" />
          <attvalue for="2" value="共格性（Coherency）是描述多相材料中不同相界面处晶格连续性的属性。在γ/γ'结构中，它特指γ'析出相与γ基体的晶格点阵能够完全连续、原子一一对应的特征。这种高度匹配是材料高温强度的关键来源。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-5d942c8f1c01db54bab51b31faea4836" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;elastic coherency&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bd6f6e5d223dd374971ce11dcab2f7b5-e-5&quot;, &quot;chunk-5d942c8f1c01db54bab51b31faea4836-e-7&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-5d942c8f1c01db54bab51b31faea4836-e-8" label="gamma/gamma prime structure">
        <attvalues>
          <attvalue for="0" value="gamma/gamma prime structure" />
          <attvalue for="1" value="Microstructure" />
          <attvalue for="2" value="γ/γ'结构是镍基高温合金中的一种关键两相微观结构。它由面心立方的γ基体相与有序的γ'沉淀相构成。两相间通常存在晶格错配度极低的共格界面，能有效阻碍位错运动，从而赋予材料卓越的高温强度与抗蠕变性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-5d942c8f1c01db54bab51b31faea4836" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5d942c8f1c01db54bab51b31faea4836-e-8&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5d942c8f1c01db54bab51b31faea4836-e-12" label="Superalloy grades">
        <attvalues>
          <attvalue for="0" value="Superalloy grades" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="高温合金牌号是为区分不同超级合金而设立的标准化分类。每个牌号都代表一种独特的、精准的化学成分，该成分决定了合金在高温、高压等极端环境下的力学性能、耐腐蚀性及最终应用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-5d942c8f1c01db54bab51b31faea4836" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;superalloy grades&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5d942c8f1c01db54bab51b31faea4836-e-12&quot;, &quot;chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-5&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-1" label="old shuts">
        <attvalues>
          <attvalue for="0" value="old shuts" />
          <attvalue for="1" value="Defect" />
          <attvalue for="2" value="一种锻造缺陷，指金属在锻造时表面发生折叠，但未能完全焊合而形成的线状不连续。这种缺陷会严重降低锻件的力学性能和表面质量。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;231&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-45ecdbf5bbf3393bc51ac55cc2386745" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-6" label="turbine blade alloys">
        <attvalues>
          <attvalue for="0" value="turbine blade alloys" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="涡轮叶片合金是专用于制造航空发动机、燃气轮机等设备核心部件叶片的特种金属材料，通常为高温合金。它们能在高温、高应力和腐蚀等极端工况下保持结构稳定，并具备优异的抗蠕变、抗疲劳和抗氧化性能。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;148-151&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-45ecdbf5bbf3393bc51ac55cc2386745" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-7" label="turbine disc alloys">
        <attvalues>
          <attvalue for="0" value="turbine disc alloys" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="涡轮盘合金是用于制造航空发动机和燃气轮机等核心部件——涡轮盘的一类高性能金属材料。由于需在高温和高应力等极端环境下工作，其化学成分、微观结构以及二者之间的关系是决定其力学性能和可靠性的关键，也是该材料领域的核心研究内容。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;237, 236-259&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-45ecdbf5bbf3393bc51ac55cc2386745" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-8" label="composition-microstructure relationships">
        <attvalues>
          <attvalue for="0" value="composition-microstructure relationships" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="材料科学中的核心概念，指合金的化学成分（元素及含量）与其最终形成的微观结构（如晶相、尺寸、形态）之间的内在联系和规律。它是通过调控成分来设计和优化材料宏观性能的理论基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-45ecdbf5bbf3393bc51ac55cc2386745" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Composition-microstructure relationships&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-8&quot;, &quot;chunk-323f9e8ea85610f0279e242666644995-e-9&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-9" label="nickel and its alloys">
        <attvalues>
          <attvalue for="0" value="nickel and its alloys" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="镍及其合金是一类以镍为基体并添加其他元素形成的金属材料。它们通常具有优异的强度、耐腐蚀性和高温性能，而这些特性主要由其化学成分与微观结构的相互关系所决定。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;34-54&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-45ecdbf5bbf3393bc51ac55cc2386745" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-10" label="single crystal alloys">
        <attvalues>
          <attvalue for="0" value="single crystal alloys" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="单晶合金是一种整体由单一晶粒构成的合金材料。由于其内部完全没有晶界这一薄弱环节，它具有卓越的高温强度、抗蠕变和抗疲劳性能，是先进的高温结构材料，常用于制造航空发动机和燃气轮机的涡轮叶片等关键部件。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;146–170&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-45ecdbf5bbf3393bc51ac55cc2386745" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-11" label="conduction">
        <attvalues>
          <attvalue for="0" value="conduction" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="热传导，也称传导，是热传递的三种基本方式之一。它指热能通过物体内微观粒子的直接接触和碰撞，从高温部分传递到低温部分的物理现象，过程中没有物质的宏观运动。该现象在固体中尤为显著，并在熔模铸造等工业过程中扮演着关键角色。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;131&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-45ecdbf5bbf3393bc51ac55cc2386745" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-14" label="constitutive equations">
        <attvalues>
          <attvalue for="0" value="constitutive equations" />
          <attvalue for="1" value="Model" />
          <attvalue for="2" value="本构方程是描述材料宏观物理性质的数学模型，它建立了材料内部的应力与应变之间的定量关系。这些方程反映了材料的内在属性，是连接外部载荷与材料变形响应的桥梁，在固体力学和材料科学中用于分析和预测材料行为。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;175&quot;}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-45ecdbf5bbf3393bc51ac55cc2386745" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="235" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-15" label="single crystal deformation">
        <attvalues>
          <attvalue for="0" value="single crystal deformation" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="单晶变形是在外力作用下，单晶材料发生的形状和尺寸改变的现象。由于其晶格具有连续性和各向异性，变形通常沿着特定的晶体学平面和方向，以滑移或孪生为主要机制进行。描述其应力-应变关系的力学行为，需要通过特定的本构方程来建立。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;175&quot;}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-45ecdbf5bbf3393bc51ac55cc2386745" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="235" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-18" label="acidic conditions">
        <attvalues>
          <attvalue for="0" value="acidic conditions" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="指环境中pH值小于7的一种化学状态。这种条件由于氢离子浓度较高，能够显著促进或加速多种化学反应，是导致金属等材料发生电化学腐蚀的关键环境因素之一。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;168&quot;}" />
          <attvalue for="4" value="e-18" />
          <attvalue for="5" value="chunk-45ecdbf5bbf3393bc51ac55cc2386745" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Acidic conditions&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-18&quot;, &quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-5&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-19" label="basic conditions">
        <attvalues>
          <attvalue for="0" value="basic conditions" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="指pH值大于7的碱性化学环境。这种环境能够引发、加速或抑制特定金属材料的腐蚀过程，是评估和控制材料在特定介质中发生电化学腐蚀的关键条件之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-19" />
          <attvalue for="5" value="chunk-45ecdbf5bbf3393bc51ac55cc2386745" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Basic conditions&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-19&quot;, &quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-6&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-1" label="Total deformation">
        <attvalues>
          <attvalue for="0" value="Total deformation" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="总变形是固体力学中的一个基本物理现象，指物体在受到外加载荷或温度变化等作用后，其几何形状和尺寸发生的总体变化。它通常用各点位移矢量的大小来衡量，是评估结构强度与刚度的关键指标。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;175&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-8e7d60876a49f4d9b2d47d88562c5c59" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="392" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-7" label="Hot (deposit-modified) corrosion">
        <attvalues>
          <attvalue for="0" value="Hot (deposit-modified) corrosion" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="沉积改性热腐蚀是一种在高温下，由沉积在材料表面的熔融盐（如硫酸盐、氯化物）所加速的腐蚀过程。它通过溶解或破坏金属基底的保护性氧化膜，导致材料的快速降解。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;165-170&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-8e7d60876a49f4d9b2d47d88562c5c59" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-7&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-9" label="Molten salts">
        <attvalues>
          <attvalue for="0" value="Molten salts" />
          <attvalue for="1" value="Substance" />
          <attvalue for="2" value="熔融盐是在高温下呈液态的离子化合物或其混合物。它具有高热稳定性、高导电性等特点，常用作热载体、电解质和高温溶剂。同时，它也是一种重要的腐蚀介质，能对金属等材料的性能产生显著影响。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;167-169&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-8e7d60876a49f4d9b2d47d88562c5c59" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-10" label="Sulphidisation">
        <attvalues>
          <attvalue for="0" value="Sulphidisation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="硫化 (sulphidisation) 是一种高温腐蚀过程。在此过程中，金属或合金与环境中的硫或含硫化合物发生化学反应，在其表面生成金属硫化物层，从而导致材料性能退化。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;167, 169-170&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-8e7d60876a49f4d9b2d47d88562c5c59" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;sulphidisation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-10&quot;, &quot;chunk-0625d83d7200f989528119d9ba61865a-e-12&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-11" label="Type I (high-temperature) corrosion">
        <attvalues>
          <attvalue for="0" value="Type I (high-temperature) corrosion" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="I型（高温）腐蚀是一种在高温环境中发生的材料加速降解过程。它特指由熔融盐（尤其是硫酸盐）沉积在材料表面，破坏了原有的保护性氧化膜，从而引发的急速氧化和侵蚀。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;168&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-8e7d60876a49f4d9b2d47d88562c5c59" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-11&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-12" label="Type II (low-temperature) corrosion">
        <attvalues>
          <attvalue for="0" value="Type II (low-temperature) corrosion" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="II型低温腐蚀是一种在低温条件下发生的腐蚀过程。它主要发生在燃烧含硫燃料的设备中，当金属表面温度低于烟气中硫酸的露点时，凝结形成的硫酸液滴会对金属材料造成迅速且严重的腐蚀。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;168&quot;}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-8e7d60876a49f4d9b2d47d88562c5c59" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-17" label="Anisotropy of creep">
        <attvalues>
          <attvalue for="0" value="Anisotropy of creep" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="蠕变各向异性是材料的一种特性，指其蠕变性能（如蠕变速率、蠕变抗力）因受力或测量方向的不同而呈现差异。这种方向依赖性常见于具有择优取向微观结构的材料中。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;176-180&quot;}" />
          <attvalue for="4" value="e-17" />
          <attvalue for="5" value="chunk-8e7d60876a49f4d9b2d47d88562c5c59" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-19" label="Breakdown of power-law creep">
        <attvalues>
          <attvalue for="0" value="Breakdown of power-law creep" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="一种材料科学现象，指在高应力条件下，材料的稳态蠕变速率与应力之间的关系严重偏离幂律关系，转而呈指数级增长，导致描述位错蠕变的幂律蠕变模型失效。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;101&quot;}" />
          <attvalue for="4" value="e-19" />
          <attvalue for="5" value="chunk-8e7d60876a49f4d9b2d47d88562c5c59" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-19&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-22" label="Secondary creep">
        <attvalues>
          <attvalue for="0" value="Secondary creep" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="次级蠕变（Secondary creep），也称稳态蠕变，是材料蠕变过程的第二阶段。其核心特征是应变速率在该阶段内几乎保持恒定，达到一个最小值。这种稳定状态是由于材料内部的加工硬化（强化）与热软化/回复（弱化）两种机制达到了动态平衡。该阶段通常是材料蠕变寿命中最长的部分，对预测部件的长期服役寿命至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-22" />
          <attvalue for="5" value="chunk-8e7d60876a49f4d9b2d47d88562c5c59" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-22&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-23" label="Tertiary creep">
        <attvalues>
          <attvalue for="0" value="Tertiary creep" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="三次蠕变（Tertiary Creep），又称加速蠕变，是材料蠕变过程的最后阶段。其特征为应变速率随时间加速增长直至材料断裂，其微观机制源于内部空洞形成、微裂纹扩展等结构性损伤的累积。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-23" />
          <attvalue for="5" value="chunk-8e7d60876a49f4d9b2d47d88562c5c59" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;tertiary creep&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-23&quot;, &quot;chunk-502aba15d381acd1fe322927c6f750ed-e-9&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-3" label="primary, secondary and tertiary creep modes">
        <attvalues>
          <attvalue for="0" value="primary, secondary and tertiary creep modes" />
          <attvalue for="1" value="Classification" />
          <attvalue for="2" value="指材料在恒定应力下蠕变过程所划分的三个连续阶段。初级蠕变（第一阶段）应变率递减；次级蠕变（第二阶段）应变率恒定，也称稳态蠕变；三级蠕变（第三阶段）应变率加速增加，并最终导致材料断裂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c9dadd21668b4b1a7fa3bfd8b2933c99" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-3&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-4" label="gamma prime precipitates">
        <attvalues>
          <attvalue for="0" value="gamma prime precipitates" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="γ'相沉淀物（gamma prime precipitates）是一种关键的强化微观结构特征，主要存在于镍基等高温合金中。作为有序的金属间化合物相（如Ni₃Al），它们通过在高温下有效阻碍位错运动，从而显著提高材料的强度和抗幂律蠕变性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c9dadd21668b4b1a7fa3bfd8b2933c99" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-4&quot;, &quot;chunk-eb23a1fa1bb857c2e5b4e84047321caa-e-3&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-5" label="elongation">
        <attvalues>
          <attvalue for="0" value="elongation" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="伸长是一种力学性能，指材料在持续应力作用下，因蠕变（如幂律蠕变）而发生的缓慢塑性形变，具体表现为试样长度随时间的逐渐增加。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c9dadd21668b4b1a7fa3bfd8b2933c99" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-6" label="failure">
        <attvalues>
          <attvalue for="0" value="failure" />
          <attvalue for="1" value="Outcome" />
          <attvalue for="2" value="由蠕变过程导致的材料最终断裂或失效。在持续应力作用下，材料内部损伤（如微裂纹和空洞）逐渐累积并扩展，最终导致结构性破坏。幂律蠕变是引发此类失效的典型机制之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c9dadd21668b4b1a7fa3bfd8b2933c99" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-6&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-10" label="nominally pure nickel">
        <attvalues>
          <attvalue for="0" value="nominally pure nickel" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="名义纯镍是一种高纯度金属材料，主要成分为镍(Ni)，但含有微量杂质。作为纯金属的典型代表，它在高温和应力作用下会表现出幂律蠕变（power-law creep）行为，是材料科学中研究该现象的重要对象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-c9dadd21668b4b1a7fa3bfd8b2933c99" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-10&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-11" label="binary alloys">
        <attvalues>
          <attvalue for="0" value="binary alloys" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="二元合金（Binary Alloys）是由两种主要化学元素组成的合金。作为一类材料，其重要特征之一是在高温和应力作用下会表现出幂律蠕变（power-law creep）的力学行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-c9dadd21668b4b1a7fa3bfd8b2933c99" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-11&quot;, &quot;chunk-eb23a1fa1bb857c2e5b4e84047321caa-e-6&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-12" label="recovery-controlled creep models">
        <attvalues>
          <attvalue for="0" value="recovery-controlled creep models" />
          <attvalue for="1" value="Model" />
          <attvalue for="2" value="一类解释稳态蠕变的材料科学理论模型。该模型认为，稳态蠕变是材料内部由形变引起的加工硬化与由热激活驱动的回复软化这两个相反过程达到动态平衡的结果，从而使蠕变速率在此阶段保持恒定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-c9dadd21668b4b1a7fa3bfd8b2933c99" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;'Recovery-controlled' model of creep deformation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-12&quot;, &quot;chunk-5c24b22e063be5dfa3ae3afab37099c6-e-13&quot;, &quot;chunk-3f04709d6681598a00c3a9a4a76620aa-e-3&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-13" label="steady-state creep">
        <attvalues>
          <attvalue for="0" value="steady-state creep" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="稳态蠕变（steady-state creep），也称第二阶段蠕变，是材料蠕变过程中应变率近似恒定的一个阶段。其特征是加工硬化（强化）与回复（软化）过程达到动态平衡，因此行为稳定且易于建模。该现象可由恢复控制模型解释，并且是幂律蠕变等蠕变形式包含的关键阶段。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-c9dadd21668b4b1a7fa3bfd8b2933c99" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-13&quot;, &quot;chunk-3f04709d6681598a00c3a9a4a76620aa-e-2&quot;, &quot;chunk-8c75d16dc148897cf486c21cbe30e4be-e-1&quot;, &quot;chunk-be2e5714ffd15b4d499890769149ecb3-e-15&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3f04709d6681598a00c3a9a4a76620aa-e-1" label="creep alloys">
        <attvalues>
          <attvalue for="0" value="creep alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="蠕变合金，通常指抗蠕变合金或高温合金，是一类在高温和长期应力作用下能有效抵抗缓慢塑性变形（即蠕变）的金属材料。它们具备优异的高温强度、抗氧化性和组织稳定性，常用于航空发动机、燃气轮机等领域。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;96-99&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-3f04709d6681598a00c3a9a4a76620aa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3f04709d6681598a00c3a9a4a76620aa-e-1&quot;]}]" />
          <attvalue for="9" value="393" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-3f04709d6681598a00c3a9a4a76620aa-e-5" label="primary creep regime">
        <attvalues>
          <attvalue for="0" value="primary creep regime" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="第一蠕变阶段 (Primary Creep Regime)，又称瞬态蠕变，是材料蠕变过程的初始阶段。其特征为应变速率随时间递减，直至达到一个稳定值。此现象由材料内部的加工硬化主导，在单晶高温合金中尤为重要。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;176-180&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-3f04709d6681598a00c3a9a4a76620aa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3f04709d6681598a00c3a9a4a76620aa-e-5&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3f04709d6681598a00c3a9a4a76620aa-e-6" label="rafting-modified regime">
        <attvalues>
          <attvalue for="0" value="rafting-modified regime" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="单晶高温合金在蠕变变形过程中，因受到筏排现象影响而呈现出的一个特定阶段。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;180-187&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-3f04709d6681598a00c3a9a4a76620aa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3f04709d6681598a00c3a9a4a76620aa-e-7" label="tertiary creep regime">
        <attvalues>
          <attvalue for="0" value="tertiary creep regime" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="三级蠕变区是材料蠕变过程的最终阶段。其特征为应变速率随时间急剧加速，直至材料发生断裂。这种加速通常由材料内部的颈缩、微观空洞或裂纹的形成与扩展等累积损伤所引起。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;172–176&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-3f04709d6681598a00c3a9a4a76620aa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3f04709d6681598a00c3a9a4a76620aa-e-7&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3f04709d6681598a00c3a9a4a76620aa-e-8" label="turbine disc alloys">
        <attvalues>
          <attvalue for="0" value="turbine disc alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="涡轮盘合金是一类用于制造涡轮盘的多晶盘件合金。由于其在高温和高离心应力环境下工作，这类合金的一个关键力学行为是在服役期间会发生以稳态蠕变为代表的蠕变变形。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;249, 358&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-3f04709d6681598a00c3a9a4a76620aa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3f04709d6681598a00c3a9a4a76620aa-e-11" label="polycrystalline disc alloys">
        <attvalues>
          <attvalue for="0" value="polycrystalline disc alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="多晶盘件合金是一类由多个晶粒组成的高性能高温合金，专用于制造航空发动机及燃气轮机中的涡轮盘等关键旋转部件。其核心特征是在高温工况下仍具备优异的蠕变断裂强度，以承受巨大的离心应力。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;245-259&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-3f04709d6681598a00c3a9a4a76620aa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-3f04709d6681598a00c3a9a4a76620aa-e-12" label="cross-slip">
        <attvalues>
          <attvalue for="0" value="cross-slip" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="交滑移（cross-slip）是晶体材料的一种塑性变形机制，指螺位错从一个滑移面转移至另一个与之相交的滑移面上继续运动。该过程能使位错绕过障碍物，在特定金属间化合物中，它会导致位错钉扎，是解释反常屈服效应（屈服强度随温度升高而增加）的关键机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-3f04709d6681598a00c3a9a4a76620aa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Cross-slip of dislocations&quot;, &quot;Cross-slip of segments&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b90feda161b295cfb50134cb85d41526-e-11&quot;, &quot;chunk-8001720db94f44ac88b442f606ab7d39-e-5&quot;, &quot;chunk-3f04709d6681598a00c3a9a4a76620aa-e-12&quot;, &quot;chunk-44a9440aa3e5fad0c388f77698c519bf-e-3&quot;, &quot;chunk-eb23a1fa1bb857c2e5b4e84047321caa-e-2&quot;, &quot;chunk-fab5556d25e36a12308d5e081229601a-e-9&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-44a9440aa3e5fad0c388f77698c519bf-e-2" label="polycrystalline disc alloys">
        <attvalues>
          <attvalue for="0" value="polycrystalline disc alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种由多个取向各异的晶粒构成的金属材料，晶粒间由晶界分隔。这类合金通常指用于制造航空发动机和燃气轮机中涡轮盘等关键旋转部件的高性能合金，在高温高应力环境下具备优异的强度和抗疲劳性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-44a9440aa3e5fad0c388f77698c519bf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-44a9440aa3e5fad0c388f77698c519bf-e-5" label="crystallographic defects">
        <attvalues>
          <attvalue for="0" value="crystallographic defects" />
          <attvalue for="1" value="Defect Category" />
          <attvalue for="2" value="晶体缺陷是一类材料缺陷，指晶体中原子排列偏离其理想周期性结构的区域。它是一个总称，根据几何特征可分为点缺陷（零维）、位错（一维）、堆垛层错（二维）等类型，这些不完整的结构会显著影响材料的宏观性质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-44a9440aa3e5fad0c388f77698c519bf" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-44a9440aa3e5fad0c388f77698c519bf-e-5&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-44a9440aa3e5fad0c388f77698c519bf-e-6" label="stacking faults">
        <attvalues>
          <attvalue for="0" value="stacking faults" />
          <attvalue for="1" value="Crystallographic Defect" />
          <attvalue for="2" value="堆垛层错是一种面缺陷，指晶体结构中原子面的正常周期性堆垛顺序发生错乱。例如在面心立方结构中，理想的ABCABC...顺序被破坏。这种缺陷通常源于一个原子面的缺失（内禀型）或额外插入（外禀型），会在晶体生长或塑性变形时形成，并显著影响材料的力学及电学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-44a9440aa3e5fad0c388f77698c519bf" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Stacking faults&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-44a9440aa3e5fad0c388f77698c519bf-e-6&quot;, &quot;chunk-be2e5714ffd15b4d499890769149ecb3-e-6&quot;, &quot;chunk-dc4fc8b9731ff54ceedadcde2ec92655-e-4&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-44a9440aa3e5fad0c388f77698c519bf-e-9" label="superalloy single crystals">
        <attvalues>
          <attvalue for="0" value="superalloy single crystals" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="高温合金单晶是一种由单个连续晶格构成、无晶界的先进材料。它表现出优异的抗蠕变和抗疲劳形变性能，并具有显著的弹性各向异性。其高温强度和稳定性在很大程度上依赖于增强相与基体间的晶格错配，是航空发动机等极端环境下的关键材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-44a9440aa3e5fad0c388f77698c519bf" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-44a9440aa3e5fad0c388f77698c519bf-e-12" label="environmental performance">
        <attvalues>
          <attvalue for="0" value="environmental performance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="环境性能是一种材料属性，指材料在特定服役环境（如高温、腐蚀介质）中抵抗氧化、腐蚀等化学侵蚀，从而保持其性能稳定性的能力。该性能对高温合金等材料至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-44a9440aa3e5fad0c388f77698c519bf" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Environmental performance&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-44a9440aa3e5fad0c388f77698c519bf-e-12&quot;, &quot;chunk-2954a9d8cd39d35e1c2ce761efb0de31-e-15&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-44a9440aa3e5fad0c388f77698c519bf-e-13" label="fatigue deformation behaviour">
        <attvalues>
          <attvalue for="0" value="fatigue deformation behaviour" />
          <attvalue for="1" value="Material Behavior" />
          <attvalue for="2" value="疲劳变形行为指材料在循环载荷（应力或应变）作用下，因内部损伤累积而产生渐进性、永久性变形的力学行为。该行为涉及微观结构的演变、裂纹的萌生与扩展，是导致材料疲劳失效和断裂的主要机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-44a9440aa3e5fad0c388f77698c519bf" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Fatigue deformation behaviour&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-44a9440aa3e5fad0c388f77698c519bf-e-13&quot;, &quot;chunk-2954a9d8cd39d35e1c2ce761efb0de31-e-16&quot;, &quot;chunk-dcabec43f1f2206a87597ccc217e55d1-e-1&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-44a9440aa3e5fad0c388f77698c519bf-e-14" label="lattice misfit">
        <attvalues>
          <attvalue for="0" value="lattice misfit" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="晶格错配（Lattice Misfit）是表征晶体材料中两相（如单晶高温合金中的γ和γ'相）之间晶格常数不匹配程度的物理量。作为一个关键的材料属性，它显著影响材料的微观结构和力学性能。在单晶高温合金中，该值通常会随着温度的升高而变得更负。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-44a9440aa3e5fad0c388f77698c519bf" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Lattice misfit&quot;, &quot;Misfit&quot;, &quot;misfit&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bfbc49438adee74f98c04c5e0bb57599-e-3&quot;, &quot;chunk-bd6f6e5d223dd374971ce11dcab2f7b5-e-2&quot;, &quot;chunk-44a9440aa3e5fad0c388f77698c519bf-e-14&quot;, &quot;chunk-0e400a717c0177b6e54870a3d685e980-e-1&quot;, &quot;chunk-807030ab9eb9ee85e606b0c18c1d17af-e-5&quot;, &quot;chunk-60c0ee3413a86135d14081dd80f51aaf-e-3&quot;, &quot;chunk-dcabec43f1f2206a87597ccc217e55d1-e-12&quot;, &quot;chunk-e1a389bc8645b3e7fa58f05c1e0a798f-e-12&quot;, &quot;chunk-5af1439dfd2daa394494b8c8df9e4287-e-5&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="10" />
        </attvalues>
      </node>
      <node id="chunk-0e400a717c0177b6e54870a3d685e980-e-2" label="cube-cube orientation relationship">
        <attvalues>
          <attvalue for="0" value="cube-cube orientation relationship" />
          <attvalue for="1" value="Crystallographic Relationship" />
          <attvalue for="2" value="立方-立方取向关系是一种晶体学关系，用以表征γ/γ'微观结构。它指面心立方结构的γ基体与γ'析出相的晶体学主轴完全平行（即[100]γ || [100]γ'），形成共格界面。此关系常见于镍基高温合金等材料中，对材料的高温强度起着决定性作用。" />
          <attvalue for="3" value="{&quot;page_numbers&quot;: &quot;45, 46&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-0e400a717c0177b6e54870a3d685e980" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="236" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0e400a717c0177b6e54870a3d685e980-e-3" label="gamma and gamma prime microstructure">
        <attvalues>
          <attvalue for="0" value="gamma and gamma prime microstructure" />
          <attvalue for="1" value="Microstructure" />
          <attvalue for="2" value="镍基高温合金中的一种典型显微组织，由面心立方的γ基体相与弥散分布的γ'强化相构成。两相间具有特定的立方-立方取向关系，这种共格或半共格的结构是其优异高温强度的主要来源。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-0e400a717c0177b6e54870a3d685e980" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0e400a717c0177b6e54870a3d685e980-e-3&quot;]}]" />
          <attvalue for="9" value="236" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0e400a717c0177b6e54870a3d685e980-e-4" label="cyclic deformation">
        <attvalues>
          <attvalue for="0" value="cyclic deformation" />
          <attvalue for="1" value="Mechanical Process" />
          <attvalue for="2" value="循环变形是一种力学过程，指材料在周期性变化的应力或应变作用下产生的变形。该过程是导致材料疲劳损伤与断裂的根本原因，常见于承受交变载荷的工程材料中，如盘状合金和单晶合金。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0e400a717c0177b6e54870a3d685e980" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="123" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0e400a717c0177b6e54870a3d685e980-e-5" label="disc alloys">
        <attvalues>
          <attvalue for="0" value="disc alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="盘用合金(disc alloys)是一类高性能合金，专用于制造航空发动机、燃气轮机中的涡轮盘等关键旋转部件。其核心特性是在高温和巨大离心力作用下，仍能承受长期循环载荷（循环形变），具备优异的抗疲劳、抗蠕变性能，以确保设备的安全可靠运行。" />
          <attvalue for="3" value="{&quot;page_numbers&quot;: &quot;238-258&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-0e400a717c0177b6e54870a3d685e980" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="123" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0e400a717c0177b6e54870a3d685e980-e-6" label="single crystal alloys">
        <attvalues>
          <attvalue for="0" value="single crystal alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="单晶合金（single crystal alloys）是一种整体由单一、连续晶粒构成的金属材料。由于完全消除了作为力学薄弱环节的晶界，它具有卓越的高温强度、抗蠕变和抗疲劳（循环形变）性能，是制造航空发动机涡轮叶片等关键热端部件的核心材料。" />
          <attvalue for="3" value="{&quot;page_numbers&quot;: &quot;187-194&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0e400a717c0177b6e54870a3d685e980" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="123" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0e400a717c0177b6e54870a3d685e980-e-8" label="Lifing">
        <attvalues>
          <attvalue for="0" value="Lifing" />
          <attvalue for="1" value="Engineering Concept" />
          <attvalue for="2" value="Lifing是一项工程寿命评估过程，它应用“初始裂纹寿命法”（life-to-first-crack approach），通过预测构件产生首个疲劳裂纹所需的时间或循环次数，来确定其安全使用寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-0e400a717c0177b6e54870a3d685e980" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;lifing&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0e400a717c0177b6e54870a3d685e980-e-8&quot;, &quot;chunk-c54fb0cde287461ac785a255da940d8d-e-9&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0e400a717c0177b6e54870a3d685e980-e-9" label="damage parameters">
        <attvalues>
          <attvalue for="0" value="damage parameters" />
          <attvalue for="1" value="Technical Parameter" />
          <attvalue for="2" value="损伤参数是在材料科学与工程领域中，用于定量描述、模拟和预测材料或结构在载荷作用下损伤萌生、扩展及累积过程的一组技术变量。这些参数是进行结构完整性评估和寿命预测的关键依据。" />
          <attvalue for="3" value="{&quot;page_numbers&quot;: &quot;175&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-0e400a717c0177b6e54870a3d685e980" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="394" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-0e400a717c0177b6e54870a3d685e980-e-11" label="defects">
        <attvalues>
          <attvalue for="0" value="defects" />
          <attvalue for="1" value="Material Imperfection" />
          <attvalue for="2" value="一种材料缺陷的通用类别，指材料中存在的、会影响其性能的不完美之处。该类别包含斑点（freckles）和白斑（white spots）等具体形式，它们的存在会对材料的低周疲劳性能产生不利影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-0e400a717c0177b6e54870a3d685e980" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Defects&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0e400a717c0177b6e54870a3d685e980-e-11&quot;, &quot;chunk-d2428cb3e80954cab38bfce19b363f27-e-2&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-0e400a717c0177b6e54870a3d685e980-e-13" label="low-cycle fatigue performance">
        <attvalues>
          <attvalue for="0" value="low-cycle fatigue performance" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="低周疲劳性能是一项材料力学性能，指材料在足以引起塑性变形的循环载荷作用下，于较低周次内抵抗断裂的能力。它衡量材料在强应变循环下的耐久性，对内部缺陷高度敏感，缺陷的存在会显著降低材料的疲劳寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-0e400a717c0177b6e54870a3d685e980" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Low-cycle fatigue performance&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0e400a717c0177b6e54870a3d685e980-e-13&quot;, &quot;chunk-d2428cb3e80954cab38bfce19b363f27-e-4&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d2428cb3e80954cab38bfce19b363f27-e-7" label="Dendritic growth">
        <attvalues>
          <attvalue for="0" value="Dendritic growth" />
          <attvalue for="1" value="Metallurgical Process" />
          <attvalue for="2" value="树枝状生长是一种冶金过程中的晶体生长形态，其特征是形成树枝状结构。该过程会引发微观偏析，且其枝晶间距的大小主要取决于凝固时的温度梯度和生长速率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d2428cb3e80954cab38bfce19b363f27" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d2428cb3e80954cab38bfce19b363f27-e-7&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-d2428cb3e80954cab38bfce19b363f27-e-13" label="Deoxidation">
        <attvalues>
          <attvalue for="0" value="Deoxidation" />
          <attvalue for="1" value="Metallurgical Process" />
          <attvalue for="2" value="一种冶金精炼过程，通过向熔融金属中添加脱氧剂或利用真空环境，去除其中的溶解氧与氧化物，以提高金属纯度、改善其力学性能。该过程是真空感应熔炼等高质量合金生产中的关键步骤。" />
          <attvalue for="3" value="{&quot;page&quot;: &quot;220&quot;}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-d2428cb3e80954cab38bfce19b363f27" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d2428cb3e80954cab38bfce19b363f27-e-15" label="Design of alloy compositions for blades">
        <attvalues>
          <attvalue for="0" value="Design of alloy compositions for blades" />
          <attvalue for="1" value="Design Process" />
          <attvalue for="2" value="一种为高性能叶片（如涡轮叶片）开发专用合金材料的设计过程。该过程通过优化选择金属基体与合金元素的配比，旨在赋予材料特定的高温强度、抗腐蚀和抗疲劳等性能，以满足叶片在航空发动机等极端环境下的严苛服役要求。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;146-170&quot;}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-d2428cb3e80954cab38bfce19b363f27" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;design of alloy compositions for blades&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d2428cb3e80954cab38bfce19b363f27-e-15&quot;, &quot;chunk-b6d430b58fe5b3336f2235e2e6daa465-e-1&quot;]}]" />
          <attvalue for="9" value="237" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d2428cb3e80954cab38bfce19b363f27-e-16" label="Design of alloy compositions for discs">
        <attvalues>
          <attvalue for="0" value="Design of alloy compositions for discs" />
          <attvalue for="1" value="Design Process" />
          <attvalue for="2" value="一种材料设计过程，通过系统优化化学元素配比，开发满足特定盘状件（如航空发动机涡轮盘）性能需求的合金。该过程旨在实现部件在高温、高压和高转速等严苛工况下所需的高温强度、抗疲劳性和组织稳定性。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;236-258&quot;}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-d2428cb3e80954cab38bfce19b363f27" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;design of alloy compositions for discs&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d2428cb3e80954cab38bfce19b363f27-e-16&quot;, &quot;chunk-b6d430b58fe5b3336f2235e2e6daa465-e-3&quot;]}]" />
          <attvalue for="9" value="37" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b6d430b58fe5b3336f2235e2e6daa465-e-2" label="blades">
        <attvalues>
          <attvalue for="0" value="blades" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种在涡轮机、压缩机或发动机等旋转机械中，用于与流体相互作用产生或转化能量的关键部件。由于其工作环境通常涉及高温、高压和高速旋转，因此需要专门设计其合金成分以确保卓越的机械性能和可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-b6d430b58fe5b3336f2235e2e6daa465" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="237" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b6d430b58fe5b3336f2235e2e6daa465-e-8" label="dewaxing">
        <attvalues>
          <attvalue for="0" value="dewaxing" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="脱蜡（Dewaxing）是一种工业分离工艺，旨在从石油馏分（如润滑油）或食用油等原料中去除蜡质成分。其主要目的是改善产品的低温性能，如降低润滑油的倾点以保证其低温流动性，或防止食用油在冷藏时变得浑浊。" />
          <attvalue for="3" value="{&quot;page_numbers&quot;: &quot;122, 123&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-b6d430b58fe5b3336f2235e2e6daa465" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="395" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-b6d430b58fe5b3336f2235e2e6daa465-e-11" label="transition metal solutes">
        <attvalues>
          <attvalue for="0" value="transition metal solutes" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="作为溶质溶解在镍（Ni）基体中，并能在其中通过原子迁移进行扩散的一类过渡金属。它们通常与镍形成固溶体，是研究金属材料中扩散现象和性能演化的关键物质。" />
          <attvalue for="3" value="{&quot;page_number&quot;: &quot;63&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-b6d430b58fe5b3336f2235e2e6daa465" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b6d430b58fe5b3336f2235e2e6daa465-e-14" label="axial and transverse rates of heat transfer">
        <attvalues>
          <attvalue for="0" value="axial and transverse rates of heat transfer" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="指在定向凝固过程中，沿晶体生长方向（轴向）和垂直于该方向（横向）的热量传递速率。这两个速率的比值是决定固液界面形态和稳定性的关键物理参数，直接影响最终材料的微观结构与质量。" />
          <attvalue for="3" value="{&quot;page_numbers&quot;: &quot;135-136&quot;}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-b6d430b58fe5b3336f2235e2e6daa465" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b6d430b58fe5b3336f2235e2e6daa465-e-14&quot;, &quot;chunk-d548052a2344b0da613ab35155dcbdaa-e-2&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b6d430b58fe5b3336f2235e2e6daa465-e-15" label="defect formation">
        <attvalues>
          <attvalue for="0" value="defect formation" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="指在定向凝固过程中，材料内部因热应力、溶质再分配等因素而产生晶体结构不完整性（即缺陷）的物理现象。" />
          <attvalue for="3" value="{&quot;page_numbers&quot;: &quot;139–143&quot;}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-b6d430b58fe5b3336f2235e2e6daa465" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b6d430b58fe5b3336f2235e2e6daa465-e-16" label="single crystal morphology">
        <attvalues>
          <attvalue for="0" value="single crystal morphology" />
          <attvalue for="1" value="Material Structure" />
          <attvalue for="2" value="单晶形貌是一种在定向凝固过程中形成的材料结构。其核心特征是整个材料由单一、连续且无晶界的晶格构成，从而呈现出特定的宏观外形与微观组织。这种结构赋予材料独特的物理和化学性能。" />
          <attvalue for="3" value="{&quot;page_number&quot;: &quot;132&quot;}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-b6d430b58fe5b3336f2235e2e6daa465" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b6d430b58fe5b3336f2235e2e6daa465-e-17" label="furnace arrangement">
        <attvalues>
          <attvalue for="0" value="furnace arrangement" />
          <attvalue for="1" value="Equipment Setup" />
          <attvalue for="2" value="**熔炉布置 (Furnace Arrangement)**&#10;&#10;一种设备配置，指为满足特定工艺（如定向凝固）所需的热工条件，而对炉体、加热及冷却系统等组件进行的特定物理组合与空间布局。" />
          <attvalue for="3" value="{&quot;page_number&quot;: &quot;126&quot;}" />
          <attvalue for="4" value="e-17" />
          <attvalue for="5" value="chunk-b6d430b58fe5b3336f2235e2e6daa465" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b6d430b58fe5b3336f2235e2e6daa465-e-17&quot;, &quot;chunk-a67bfee0cc0003cfb8efe7f82e7665c2-e-3&quot;, &quot;chunk-d548052a2344b0da613ab35155dcbdaa-e-5&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a67bfee0cc0003cfb8efe7f82e7665c2-e-2" label="single crystal morphology">
        <attvalues>
          <attvalue for="0" value="single crystal morphology" />
          <attvalue for="1" value="Material Structure" />
          <attvalue for="2" value="指整个物体由单一、连续的晶体点阵构成的材料结构，其内部没有晶界。这种宏观形貌通常通过定向凝固等受控生长技术形成，以获得特定的、通常是更优越的材料性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-a67bfee0cc0003cfb8efe7f82e7665c2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a67bfee0cc0003cfb8efe7f82e7665c2-e-4" label="grain selector">
        <attvalues>
          <attvalue for="0" value="grain selector" />
          <attvalue for="1" value="Component/Technique" />
          <attvalue for="2" value="晶粒选择器 (grain selector) 是一种在定向凝固工艺中使用的特殊结构部件或技术。它通常具有螺旋或收缩的几何形状，利用晶粒竞争生长原理，筛选并只允许具有特定取向的单个晶粒优先长大，最终获得单晶或定向柱状晶组织。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-a67bfee0cc0003cfb8efe7f82e7665c2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a67bfee0cc0003cfb8efe7f82e7665c2-e-4&quot;, &quot;chunk-d548052a2344b0da613ab35155dcbdaa-e-6&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a67bfee0cc0003cfb8efe7f82e7665c2-e-6" label="industrial practice">
        <attvalues>
          <attvalue for="0" value="industrial practice" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="指将定向凝固技术规模化应用于工业制造的过程。该实践旨在精确控制金属或合金的结晶过程，以生产出具有优越机械性能和特定微观结构的先进材料，例如航空发动机的高性能涡轮叶片。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-a67bfee0cc0003cfb8efe7f82e7665c2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a67bfee0cc0003cfb8efe7f82e7665c2-e-8" label="preferred orientation">
        <attvalues>
          <attvalue for="0" value="preferred orientation" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="择优取向是一种材料属性，指多晶材料中的晶粒在结晶或加工过程中，其晶体学取向呈现出非随机的、趋向于某个或某些特定方向排列的现象。这种取向性会使材料的物理和力学性能表现出显著的各向异性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-a67bfee0cc0003cfb8efe7f82e7665c2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a67bfee0cc0003cfb8efe7f82e7665c2-e-8&quot;, &quot;chunk-d548052a2344b0da613ab35155dcbdaa-e-9&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-a67bfee0cc0003cfb8efe7f82e7665c2-e-10" label="seeding">
        <attvalues>
          <attvalue for="0" value="seeding" />
          <attvalue for="1" value="Technique" />
          <attvalue for="2" value="晶种法（Seeding）是在定向凝固等材料工艺中，通过引入籽晶（Seed Crystal）作为生长模板，来引发并控制晶体按特定取向生长的技术，用于获得具有特定微观结构的材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-a67bfee0cc0003cfb8efe7f82e7665c2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a67bfee0cc0003cfb8efe7f82e7665c2-e-10&quot;, &quot;chunk-d548052a2344b0da613ab35155dcbdaa-e-11&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-eb23a1fa1bb857c2e5b4e84047321caa-e-1" label="Dislocation">
        <attvalues>
          <attvalue for="0" value="Dislocation" />
          <attvalue for="1" value="Crystal Defect" />
          <attvalue for="2" value="位错（Dislocation）是晶体材料内部的一种线状晶体缺陷，指原子晶格排列发生的局部不规则。它的存在与运动是晶体发生塑性变形的主要微观机制，并因其周围的晶格畸变而具有被称为线能量的特定能量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-eb23a1fa1bb857c2e5b4e84047321caa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;dislocation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-eb23a1fa1bb857c2e5b4e84047321caa-e-1&quot;, &quot;chunk-171c1deb2bffaad5a637104b101eb41f-e-5&quot;, &quot;chunk-c54fb0cde287461ac785a255da940d8d-e-11&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-eb23a1fa1bb857c2e5b4e84047321caa-e-4" label="Shockley partial dislocations">
        <attvalues>
          <attvalue for="0" value="Shockley partial dislocations" />
          <attvalue for="1" value="Crystallographic Defect" />
          <attvalue for="2" value="一种晶体学缺陷，为不全位错的一种。其特征是伯氏矢量（Burgers vector）位于滑移面内，使其能够滑移。它通常由一个完美位错分解产生，并与另一个肖克利不全位错共同界定一个内禀层错，是面心立方等晶体结构中塑性变形的关键机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-eb23a1fa1bb857c2e5b4e84047321caa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-eb23a1fa1bb857c2e5b4e84047321caa-e-4&quot;, &quot;chunk-c8a13933656ed9f144b18b40f2e9861e-e-10&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-eb23a1fa1bb857c2e5b4e84047321caa-e-8" label="superpartial dislocation">
        <attvalues>
          <attvalue for="0" value="superpartial dislocation" />
          <attvalue for="1" value="Crystallographic Defect" />
          <attvalue for="2" value="超偏位错（Superpartial Dislocation）是一种材料缺陷，特指在有序金属间化合物或超晶格结构中，由一个晶格全位错分解成的两个或多个部分位错。这些部分位错之间由反相畴界（APB）等平面缺陷连接，共同构成一个超位错。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-eb23a1fa1bb857c2e5b4e84047321caa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Superpartial&quot;, &quot;superpartial dislocations&quot;, &quot;superpartials&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f263635cd44ee57c5a9142ff0e73030b-e-1&quot;, &quot;chunk-3e64561be3c56bb2625ff8ce6474f540-e-9&quot;, &quot;chunk-bcb76bb0ef5881469a3b9478e223d894-e-1&quot;, &quot;chunk-eb23a1fa1bb857c2e5b4e84047321caa-e-8&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-eb23a1fa1bb857c2e5b4e84047321caa-e-11" label="dwell fatigue crack propagation">
        <attvalues>
          <attvalue for="0" value="dwell fatigue crack propagation" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="驻留疲劳裂纹扩展是一种失效机制，指材料在循环载荷的峰值或附近经历一段保载时间（驻留）时，所发生的裂纹扩展现象。在此期间，蠕变或环境等时间相关性损伤会与疲劳损伤相互作用，显著加速裂纹的扩展速率。该机制是评估航空发动机涡轮盘等高温承力部件寿命的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-eb23a1fa1bb857c2e5b4e84047321caa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-eb23a1fa1bb857c2e5b4e84047321caa-e-11&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fab5556d25e36a12308d5e081229601a-e-1" label="heat treatment process for turbine discs">
        <attvalues>
          <attvalue for="0" value="heat treatment process for turbine discs" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种专门应用于涡轮盘的金属热处理工艺。通过精确控制加热、保温和冷却过程，调整并优化材料的微观组织结构，以获得所需的高温强度、抗疲劳性能和断裂韧性，确保其在极端工况下的安全可靠运行。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;253&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-fab5556d25e36a12308d5e081229601a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fab5556d25e36a12308d5e081229601a-e-3" label="dwell fatigue crack propagation data">
        <attvalues>
          <attvalue for="0" value="dwell fatigue crack propagation data" />
          <attvalue for="1" value="Data" />
          <attvalue for="2" value="一项实验数据集，记录并量化涡轮盘合金在高温和持续载荷（驻留）作用下，疲劳裂纹的萌生与扩展规律。该数据是进行材料损伤机理分析、关键部件寿命预测和结构完整性评估的基础。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;245, 246&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-fab5556d25e36a12308d5e081229601a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="238" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fab5556d25e36a12308d5e081229601a-e-4" label="turbine disc alloys">
        <attvalues>
          <attvalue for="0" value="turbine disc alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="涡轮盘合金指用于制造航空发动机及燃气轮机核心旋转部件（涡轮盘）的一类特种高温合金。因在高温和高应力下工作，其抗驻留疲劳裂纹扩展性能是评估其可靠性和寿命的关键指标，以确保结构安全。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-fab5556d25e36a12308d5e081229601a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="238" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fab5556d25e36a12308d5e081229601a-e-5" label="reactive (rare) element">
        <attvalues>
          <attvalue for="0" value="reactive (rare) element" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="指化学性质活泼、易与其它物质发生化学反应的一类化学元素。这类元素在自然界中通常丰度较低，因此也常被归类为稀有元素。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;319-322&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-fab5556d25e36a12308d5e081229601a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="396" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-fab5556d25e36a12308d5e081229601a-e-6" label="efficiency factors">
        <attvalues>
          <attvalue for="0" value="efficiency factors" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="决定热机（Heat Engine）热效率的各项关键物理参数和条件的总称。这些因素共同决定了热机将热能有效转化为机械功的能力，是评估和优化热机性能的核心依据。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;10-14&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-fab5556d25e36a12308d5e081229601a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fab5556d25e36a12308d5e081229601a-e-6&quot;, &quot;chunk-569a3d8aec20d9df6a256b4cf4b263a7-e-7&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fab5556d25e36a12308d5e081229601a-e-10" label="elastic constants">
        <attvalues>
          <attvalue for="0" value="elastic constants" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="弹性常数是衡量材料抵抗弹性变形能力的力学性能指标，定义为弹性极限内应力与应变之间的比例系数，遵循广义胡克定律。它是材料的固有属性，主要包括杨氏模量、剪切模量、泊松比等。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;103-107&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-fab5556d25e36a12308d5e081229601a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fab5556d25e36a12308d5e081229601a-e-10&quot;]}]" />
          <attvalue for="9" value="397" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-fab5556d25e36a12308d5e081229601a-e-11" label="electrodes">
        <attvalues>
          <attvalue for="0" value="electrodes" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="电极是一种关键导电部件。在二次重熔工艺中，它通过传导大电流以产生电弧或电阻热，将电能转化为热能，从而实现对金属或合金的熔化与提纯。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;222, 227&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-fab5556d25e36a12308d5e081229601a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fab5556d25e36a12308d5e081229601a-e-11&quot;, &quot;chunk-1522e93c065590bf976748cff2b67e57-e-6&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-fab5556d25e36a12308d5e081229601a-e-12" label="Secondary remelting processes">
        <attvalues>
          <attvalue for="0" value="Secondary remelting processes" />
          <attvalue for="1" value="Process Category" />
          <attvalue for="2" value="二次熔炼工艺 (Secondary melting processes) 是一类冶金精炼工艺，指对初次熔炼后的金属或合金（如IN718）进行二次重熔，以提高其纯净度和组织均匀性。该工艺是决定最终铸锭最大直径的关键因素，典型方法包括真空自耗重熔(VAR)和电渣重熔(ESR)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-fab5556d25e36a12308d5e081229601a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Remelting processes&quot;, &quot;Secondary melting processes&quot;, &quot;Secondary remelting&quot;, &quot;remelting&quot;, &quot;remelting processes&quot;, &quot;secondary melting&quot;, &quot;secondary remelting processes&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-621e146c65396b0355e74f1485e77bf8-e-9&quot;, &quot;chunk-18c533341a9790d5a6a16a72face3f19-e-4&quot;, &quot;chunk-8c811c47750a116467f7951f64cda580-e-4&quot;, &quot;chunk-fab5556d25e36a12308d5e081229601a-e-12&quot;, &quot;chunk-ec1da0ebfe72b58a50620a5a71c6abf7-e-4&quot;, &quot;chunk-dae9be5eb4b7208070b473c392dd0478-e-7&quot;, &quot;chunk-3d0590efade07af78fea353ef909c7ec-e-2&quot;, &quot;chunk-bd63f78238a96a3498c5ca89d8572bea-e-6&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-fab5556d25e36a12308d5e081229601a-e-15" label="hole calculations">
        <attvalues>
          <attvalue for="0" value="hole calculations" />
          <attvalue for="1" value="Calculation Method" />
          <attvalue for="2" value="在固体物理学中，一种将半导体或绝缘体价带中电子的缺失状态，等效为带正电的准粒子（即空穴）进行处理的计算方法。该方法简化了对载流子浓度、电导率和霍尔效应等材料电学性质的分析与计算。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-fab5556d25e36a12308d5e081229601a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-fab5556d25e36a12308d5e081229601a-e-15&quot;, &quot;chunk-13f1fdc70fe0c4a699a3307c18f29c33-e-10&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fab5556d25e36a12308d5e081229601a-e-16" label="Electroslag Remelting (ESR)">
        <attvalues>
          <attvalue for="0" value="Electroslag Remelting (ESR)" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="电渣重熔（Electroslag Remelting, ESR）是一种二次精炼冶金工艺。它利用电流通过导电炉渣产生的电阻热，将自耗金属电极重熔并提纯。该工艺能有效去除金属中的杂质，提高其纯净度、致密性和组织均匀性。在双联熔炼工艺中，它通常是真空自耗电弧重熔（VAR）的前续工序，用于生产高品质特种钢及合金。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-fab5556d25e36a12308d5e081229601a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;ESR&quot;, &quot;ESR process&quot;, &quot;ESR processing&quot;, &quot;ESR refining&quot;, &quot;Electro-Slag Remelting (ESR)&quot;, &quot;Electro-slag remelting&quot;, &quot;Electroslag remelting (ESR)&quot;, &quot;electroslag remelting (ESR)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8672ed457160465cfb20b55abb713612-e-4&quot;, &quot;chunk-351e8ba4c7ea5776fa307b38afdc31ab-e-2&quot;, &quot;chunk-35442490006b7aff468c9227749684e6-e-7&quot;, &quot;chunk-c20cadb2415cd2dfc078d894fd496ac4-e-1&quot;, &quot;chunk-abbdf8441a4bf6e918fd13c6184c324e-e-1&quot;, &quot;chunk-c66cb4a523402b814bf33ff19d16eb24-e-1&quot;, &quot;chunk-1c645de8358fdb4503314332514003ba-e-4&quot;, &quot;chunk-0365022a18454a90e4598122a8f449ca-e-6&quot;, &quot;chunk-ff1788efa63f5e7e3624028146e850d4-e-4&quot;, &quot;chunk-fab5556d25e36a12308d5e081229601a-e-16&quot;, &quot;chunk-13f1fdc70fe0c4a699a3307c18f29c33-e-1&quot;, &quot;chunk-3d0590efade07af78fea353ef909c7ec-e-3&quot;, &quot;chunk-bd63f78238a96a3498c5ca89d8572bea-e-7&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="20" />
        </attvalues>
      </node>
      <node id="chunk-13f1fdc70fe0c4a699a3307c18f29c33-e-3" label="melt-related defects">
        <attvalues>
          <attvalue for="0" value="melt-related defects" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="与熔炼相关的缺陷是在真空电弧重熔(VAR)过程中产生的一类冶金缺陷。它们会破坏金属铸锭的完整性和均匀性，从而对材料的力学性能和最终产品质量产生不利影响，是该工艺中需要严格控制的关键问题。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;224-227&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-13f1fdc70fe0c4a699a3307c18f29c33" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-13f1fdc70fe0c4a699a3307c18f29c33-e-3&quot;, &quot;chunk-1522e93c065590bf976748cff2b67e57-e-7&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-13f1fdc70fe0c4a699a3307c18f29c33-e-4" label="slag">
        <attvalues>
          <attvalue for="0" value="slag" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="电渣重熔工艺所用的熔渣，是一种具有特定成分和物理化学性能的功能材料。它利用电流通过时产生的电阻热来熔化金属，同时起到精炼金属液、防止其氧化以及控制结晶的作用。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;228&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-13f1fdc70fe0c4a699a3307c18f29c33" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-13f1fdc70fe0c4a699a3307c18f29c33-e-6" label="powder metallurgy product">
        <attvalues>
          <attvalue for="0" value="powder metallurgy product" />
          <attvalue for="1" value="Product" />
          <attvalue for="2" value="粉末冶金产品是一种以金属粉末为原料，经压制成形和烧结工艺制成的材料或制品。该技术适于制造形状复杂的近净成形零件，且产品可通过锻造等后续处理，进一步提升其密度与力学性能。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;233&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-13f1fdc70fe0c4a699a3307c18f29c33" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-13f1fdc70fe0c4a699a3307c18f29c33-e-6&quot;, &quot;chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676-e-9&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-13f1fdc70fe0c4a699a3307c18f29c33-e-8" label="defects in FCC">
        <attvalues>
          <attvalue for="0" value="defects in FCC" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="面心立方(FCC)晶体结构中，原子排列对理想周期性晶格的偏离。这类缺陷破坏了晶体的完整性，主要包括空位、位错、堆垛层错等不同维度的晶格不完整性，并显著影响材料的宏观物理和力学性能。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;55-65&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-13f1fdc70fe0c4a699a3307c18f29c33" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-13f1fdc70fe0c4a699a3307c18f29c33-e-8&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a91b63add4adbc77d4752d41b7c75aa-e-5" label="fatigue">
        <attvalues>
          <attvalue for="0" value="fatigue" />
          <attvalue for="1" value="Mechanical Phenomenon" />
          <attvalue for="2" value="一种机械现象，指材料在循环载荷作用下，因裂纹萌生与扩展而导致的渐进性结构损伤和断裂。它依赖于合金成分和应力比等因素，微观机制涉及循环滑移局部化，高周疲劳(HCF)是其主要类型之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-8a91b63add4adbc77d4752d41b7c75aa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-8a91b63add4adbc77d4752d41b7c75aa-e-6" label="Coffin-Manson relationship">
        <attvalues>
          <attvalue for="0" value="Coffin-Manson relationship" />
          <attvalue for="1" value="Model" />
          <attvalue for="2" value="科芬-曼森关系是材料科学和力学中描述低周疲劳（LCF）的经验模型。它建立了材料在循环加载下的塑性应变幅与失效循环次数（即疲劳寿命）之间的定量关系。该模型是预测和评估经受显著塑性变形的金属部件疲劳性能的关键工具。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-8a91b63add4adbc77d4752d41b7c75aa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a91b63add4adbc77d4752d41b7c75aa-e-11" label="dwell fatigue crack growth">
        <attvalues>
          <attvalue for="0" value="dwell fatigue crack growth" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="驻留疲劳裂纹扩展 (Dwell Fatigue Crack Growth) 是一种材料损伤过程。其特征是在循环载荷的峰值处引入一个持续的保载时间（驻留）。在此期间，蠕变、氧化等时间依赖性损伤机制与循环疲劳损伤发生耦合，导致裂纹扩展速率显著快于常规疲劳。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-8a91b63add4adbc77d4752d41b7c75aa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8a91b63add4adbc77d4752d41b7c75aa-e-11&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a91b63add4adbc77d4752d41b7c75aa-e-14" label="hysteresis loops">
        <attvalues>
          <attvalue for="0" value="hysteresis loops" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="**滞回环 (hysteresis loops)**&#10;&#10;一种典型的低周疲劳（LCF）力学现象。它指材料在循环加载下，应力-应变关系形成的闭合曲线。由于塑性变形，加载与卸载路径不重合，环路所包围的面积代表每个循环中耗散的塑性应变能，是疲劳损伤累积的直接体现。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-8a91b63add4adbc77d4752d41b7c75aa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8a91b63add4adbc77d4752d41b7c75aa-e-14&quot;, &quot;chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-3&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-1" label="Creep-Fatigue (CF)">
        <attvalues>
          <attvalue for="0" value="Creep-Fatigue (CF)" />
          <attvalue for="1" value="Mechanical Phenomenon" />
          <attvalue for="2" value="蠕变-疲劳（Creep-Fatigue, CF）是一种材料失效机制，指材料在高温循环载荷下，因蠕变损伤与疲劳损伤的交互作用而导致的累积损伤和最终断裂。它是单晶高温合金等高温承载部件的关键失效模式之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-0312a7fa360bfa79c9a28fd422e8b92f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-5" label="load-controlled fatigue">
        <attvalues>
          <attvalue for="0" value="load-controlled fatigue" />
          <attvalue for="1" value="Test Condition" />
          <attvalue for="2" value="一种材料疲劳试验方法。其核心特征是在循环加载过程中，将载荷或应力的幅值作为控制变量并保持恒定，以评估材料的疲劳性能。该方法与将应变幅值作为控制变量的应变控制疲劳试验形成对比。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-0312a7fa360bfa79c9a28fd422e8b92f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-5&quot;]}]" />
          <attvalue for="9" value="27" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-7" label="LCF performance">
        <attvalues>
          <attvalue for="0" value="LCF performance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="低周疲劳性能（LCF performance）是一项材料属性，表征材料在足以引起循环塑性变形的高应力或应变下，抵抗重复加载直至失效的能力。该性能通常与材料的微观结构相关，并表现出显著的取向依赖性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-0312a7fa360bfa79c9a28fd422e8b92f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-7&quot;]}]" />
          <attvalue for="9" value="124" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-13" label="fuel contamination">
        <attvalues>
          <attvalue for="0" value="fuel contamination" />
          <attvalue for="1" value="Operational Issue" />
          <attvalue for="2" value="燃料污染是一种操作性问题，指燃料中存在超出规定容许水平的杂质（如水、颗粒物、微生物等）。这些杂质会影响燃料性能、损害设备并带来安全隐患，因此其含量必须控制在特定的标准限值内。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-0312a7fa360bfa79c9a28fd422e8b92f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="239" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-14" label="permitted levels">
        <attvalues>
          <attvalue for="0" value="permitted levels" />
          <attvalue for="1" value="Specification" />
          <attvalue for="2" value="指规定燃料中污染物可接受含量的技术规范或标准。它被用作评估燃料质量的依据，以确保发动机及相关设备能够安全、高效地运行。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-0312a7fa360bfa79c9a28fd422e8b92f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="239" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-17" label="allowable flaws">
        <attvalues>
          <attvalue for="0" value="allowable flaws" />
          <attvalue for="1" value="Specification" />
          <attvalue for="2" value="容许缺陷（Allowable Flaws）是一种材料缺陷。指在相关工程标准或规范内，其尺寸、数量和位置等特征在规定限度中，经评定不会对材料或结构件的安全性、功能及预期寿命产生有害影响，因此被允许存在的缺陷。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-17" />
          <attvalue for="5" value="chunk-0312a7fa360bfa79c9a28fd422e8b92f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-17&quot;, &quot;chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676-e-3&quot;]}]" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676-e-4" label="probability of detection">
        <attvalues>
          <attvalue for="0" value="probability of detection" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="探测概率（Probability of Detection, POD）是衡量检测系统或方法发现特定尺寸缺陷能力的量化指标。它通常表示为缺陷尺寸的函数，是评估无损检测方法性能和可靠性的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="22" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676-e-5" label="metal flow">
        <attvalues>
          <attvalue for="0" value="metal flow" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="金属流动指在锻造、挤压等塑性成形工艺中，固态金属在外力作用下发生塑性变形，以填充模具型腔并形成所需形状的物理过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676-e-11" label="shape relationship">
        <attvalues>
          <attvalue for="0" value="shape relationship" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="形状关系是锻造领域的核心概念，指初始坯料、中间预锻件到最终锻件之间几何形状的演变与关联。它决定了金属的流动方式、模具的填充效果以及成形质量，是锻造工艺设计的关键依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5518f1c4ab4a7b4e100f841b3b90e572-e-5" label="casting size">
        <attvalues>
          <attvalue for="0" value="casting size" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="铸件尺寸（casting size）是指导铸件宏观几何尺寸的关键工艺参数。它通过影响铸件的冷却速率和凝固过程，对材料内部组织及雀斑（freckling）等铸造缺陷的形成具有决定性作用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-5518f1c4ab4a7b4e100f841b3b90e572" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5518f1c4ab4a7b4e100f841b3b90e572-e-6" label="electroslag remelted (ESR) product">
        <attvalues>
          <attvalue for="0" value="electroslag remelted (ESR) product" />
          <attvalue for="1" value="Material Product" />
          <attvalue for="2" value="电渣重熔（ESR）产品指通过电渣重熔二次精炼工艺制成的高纯净度、组织均匀的金属材料。该工艺利用导电熔渣的精炼作用去除杂质，显著提升材料的机械性能和可靠性，广泛用于航空航天等关键领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-5518f1c4ab4a7b4e100f841b3b90e572" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5518f1c4ab4a7b4e100f841b3b90e572-e-7" label="Friedel statistics">
        <attvalues>
          <attvalue for="0" value="Friedel statistics" />
          <attvalue for="1" value="Statistical Model" />
          <attvalue for="2" value="Friedel统计是材料科学中描述固溶强化的一个经典统计模型。它将位错视为柔性线，通过统计方法计算其克服随机分布的溶质原子等钉扎点障碍所需的临界剪切应力。该模型预测，在低浓度下，材料强度的提升与溶质浓度的平方根成正比。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-5518f1c4ab4a7b4e100f841b3b90e572" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="240" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5518f1c4ab4a7b4e100f841b3b90e572-e-8" label="strengthening models">
        <attvalues>
          <attvalue for="0" value="strengthening models" />
          <attvalue for="1" value="Physical Model" />
          <attvalue for="2" value="一种应用弗里德尔统计的物理模型，用于定量描述材料的强化机制。该模型尤其适用于分析位错与溶质原子相互作用，并预测由此产生的固溶强化效应。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-5518f1c4ab4a7b4e100f841b3b90e572" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="240" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5518f1c4ab4a7b4e100f841b3b90e572-e-10" label="gamma (matrix) phase">
        <attvalues>
          <attvalue for="0" value="gamma (matrix) phase" />
          <attvalue for="1" value="Microstructural Phase" />
          <attvalue for="2" value="γ相是高温合金中的基体相，具有面心立方晶体结构。它由某些合金元素（如镍、钴、铁）所稳定，在高温下作为蠕变变形的主要载体，其特性是决定合金整体高温力学性能的关键。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-5518f1c4ab4a7b4e100f841b3b90e572" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5518f1c4ab4a7b4e100f841b3b90e572-e-10&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-5518f1c4ab4a7b4e100f841b3b90e572-e-11" label="alloying elements">
        <attvalues>
          <attvalue for="0" value="alloying elements" />
          <attvalue for="1" value="Chemical Element Group" />
          <attvalue for="2" value="一类能够促进、扩大并稳定伽马相（γ相，即奥氏体）存在区域的化学元素。在钢铁材料中，它们通过稳定奥氏体组织，使其能在更宽的温度范围甚至室温下存在，从而改善材料的性能。镍、锰是其典型代表。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-5518f1c4ab4a7b4e100f841b3b90e572" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f0829bcd269a8d2dfa4641c4b0e70d30-e-4" label="gamma double prime phase">
        <attvalues>
          <attvalue for="0" value="gamma double prime phase" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="γ''相是镍基高温合金（如Inconel 718）中的一种关键沉淀强化相，化学式为Ni₃Nb，具有体心四方（D0₂₂）晶体结构。它通常呈盘状，与基体共格，通过产生强烈的应变场有效阻碍位错运动，从而赋予合金优异的高温强度和硬度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-f0829bcd269a8d2dfa4641c4b0e70d30" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f0829bcd269a8d2dfa4641c4b0e70d30-e-4&quot;]}]" />
          <attvalue for="9" value="398" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-f0829bcd269a8d2dfa4641c4b0e70d30-e-5" label="gamma prime particles">
        <attvalues>
          <attvalue for="0" value="gamma prime particles" />
          <attvalue for="1" value="Material Microstructure" />
          <attvalue for="2" value="γ'相粒子是γ'相的颗粒形态，一种作为关键强化相的微观结构，主要分布在涡轮盘合金中。它通过有效阻碍位错运动来提高材料强度，并在特定服役条件下会表现出筏排(rafting)现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-f0829bcd269a8d2dfa4641c4b0e70d30" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f0829bcd269a8d2dfa4641c4b0e70d30-e-5&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-f0829bcd269a8d2dfa4641c4b0e70d30-e-7" label="turbine disc alloys">
        <attvalues>
          <attvalue for="0" value="turbine disc alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="涡轮盘合金是一类用于制造航空发动机和燃气轮机核心部件——涡轮盘的高性能材料，通常为镍基高温合金。其优异的高温强度、抗蠕变和抗疲劳性能，源于基体中弥散分布的γ'（伽马撇）相强化粒子。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-f0829bcd269a8d2dfa4641c4b0e70d30" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f0829bcd269a8d2dfa4641c4b0e70d30-e-8" label="rafting">
        <attvalues>
          <attvalue for="0" value="rafting" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="一种材料科学中的物理现象，指镍基高温合金等材料中的 γ' 强化相在高温和应力作用下，其颗粒发生定向粗化和连接，从立方形态演变为筏状或板状微观结构的过程。这种形态变化是影响材料高温性能的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-f0829bcd269a8d2dfa4641c4b0e70d30" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f0829bcd269a8d2dfa4641c4b0e70d30-e-8&quot;, &quot;chunk-4e2080b39d531470813c664fcc6dedf9-e-1&quot;, &quot;chunk-1297af8788c2be7a2a158412cd2652f3-e-8&quot;, &quot;chunk-64f0b642dc984a92646a132ee856bc18-e-2&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-0ba22e2612dbc225416101c15d4cb857-e-3" label="electron diffraction">
        <attvalues>
          <attvalue for="0" value="electron diffraction" />
          <attvalue for="1" value="Analysis Technique" />
          <attvalue for="2" value="电子衍射是一种基于电子的波动性，利用电子束照射晶体样品，通过分析其产生的衍射图样来确定材料的晶体结构、物相、晶体取向等信息的分析技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-0ba22e2612dbc225416101c15d4cb857" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0ba22e2612dbc225416101c15d4cb857-e-4" label="gamma prime precipitation">
        <attvalues>
          <attvalue for="0" value="gamma prime precipitation" />
          <attvalue for="1" value="Metallurgical Process" />
          <attvalue for="2" value="一种在镍基高温合金等材料中，通过热处理使γ'相从过饱和固溶体中析出的过程。该过程是这些合金获得优异高温强度的主要强化机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0ba22e2612dbc225416101c15d4cb857" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;γ' precipitation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1f9144440e619377d400c98debe3a6dc-e-3&quot;, &quot;chunk-0ba22e2612dbc225416101c15d4cb857-e-4&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0ba22e2612dbc225416101c15d4cb857-e-5" label="gamma prime strengthening">
        <attvalues>
          <attvalue for="0" value="gamma prime strengthening" />
          <attvalue for="1" value="Strengthening Mechanism" />
          <attvalue for="2" value="γ'相强化是高温合金（尤其是镍基）中的一种关键强化机制。它通过在基体中弥散分布的、有序且共格的γ'相沉淀颗粒，有效阻碍位错运动，从而赋予材料卓越的高温强度与抗蠕变性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-0ba22e2612dbc225416101c15d4cb857" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Strengthening by γ'&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0ba22e2612dbc225416101c15d4cb857-e-5&quot;, &quot;chunk-c2b78e8b376569da6104df59fa66c5ca-e-9&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0ba22e2612dbc225416101c15d4cb857-e-7" label="gettering">
        <attvalues>
          <attvalue for="0" value="gettering" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="Gettering是一种工艺，指利用特定材料（吸气剂）通过化学反应或物理吸附方式，捕获并去除真空器件或半导体材料中残留气体与杂质的过程。其主要目的是在密闭空间内获得并维持高真空环境，或提升材料的纯度与性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-0ba22e2612dbc225416101c15d4cb857" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0ba22e2612dbc225416101c15d4cb857-e-7&quot;]}]" />
          <attvalue for="9" value="399" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-0ba22e2612dbc225416101c15d4cb857-e-8" label="Goodman diagram">
        <attvalues>
          <attvalue for="0" value="Goodman diagram" />
          <attvalue for="1" value="Engineering Diagram" />
          <attvalue for="2" value="古德曼图（Goodman Diagram）是机械工程中用于评估材料疲劳寿命的图表。它以平均应力为横轴，交变应力为纵轴，图中连接材料疲劳极限与极限抗拉强度的直线（古德曼线）定义了安全工作区域，该线下方区域的应力组合被预测具有无限寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-0ba22e2612dbc225416101c15d4cb857" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0ba22e2612dbc225416101c15d4cb857-e-8&quot;, &quot;chunk-870742dec10263e0078e94a0b6a827aa-e-1&quot;]}]" />
          <attvalue for="9" value="400" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-0ba22e2612dbc225416101c15d4cb857-e-11" label="crystallography">
        <attvalues>
          <attvalue for="0" value="crystallography" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="晶体学（Crystallography）指材料内部原子的三维空间排列方式。它描述了晶体的几何形态、晶格结构、对称性及晶胞参数。作为材料的一项基本属性，晶体结构直接影响并决定了其电学、光学和力学等宏观性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-0ba22e2612dbc225416101c15d4cb857" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0ba22e2612dbc225416101c15d4cb857-e-11&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0ba22e2612dbc225416101c15d4cb857-e-12" label="lattice parameter">
        <attvalues>
          <attvalue for="0" value="lattice parameter" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="晶格参数是描述晶体结构中晶胞尺寸与形状的一组物理量。它由晶胞的边长（a, b, c）和它们之间的夹角（α, β, γ）所构成，是决定材料晶体结构、对称性及物理性质的基本参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-0ba22e2612dbc225416101c15d4cb857" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0ba22e2612dbc225416101c15d4cb857-e-13" label="morphology">
        <attvalues>
          <attvalue for="0" value="morphology" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**形貌 (Morphology)** 是一种材料属性，指材料内部微观结构（如物相、晶粒）的形状、尺寸、分布和结构特征。它深刻影响并决定了材料的力学、物理及化学等宏观性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-0ba22e2612dbc225416101c15d4cb857" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0ba22e2612dbc225416101c15d4cb857-e-14" label="ordering">
        <attvalues>
          <attvalue for="0" value="ordering" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="有序化（Ordering）是一种物理现象，指晶体结构中不同种类的原子占据特定的、非随机的晶格位置，形成规则的周期性排列。这种原子排列方式是晶体结构的一种特性，在镍铝二元系的γ'相（Gamma Prime）中尤为典型。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-0ba22e2612dbc225416101c15d4cb857" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0ba22e2612dbc225416101c15d4cb857-e-14&quot;, &quot;chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-12&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-0ba22e2612dbc225416101c15d4cb857-e-15" label="compression ratio">
        <attvalues>
          <attvalue for="0" value="compression ratio" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="压缩比是燃气轮机的一个关键性能指标，定义为其压气机出口总压与进口总压之比。它是决定燃气轮机热效率和功率输出的核心因素。通常，提高压缩比可以显著提升热效率，从而降低比燃料消耗。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-0ba22e2612dbc225416101c15d4cb857" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0ba22e2612dbc225416101c15d4cb857-e-17" label="thermodynamic principles">
        <attvalues>
          <attvalue for="0" value="thermodynamic principles" />
          <attvalue for="1" value="Scientific Principle" />
          <attvalue for="2" value="热力学原理是物理学中关于热、功及能量转换的基本定律。它们描述了宏观系统中能量守恒、传递方向和转换效率的根本限制，构成了燃气轮机等各类热机运行和设计的理论基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-17" />
          <attvalue for="5" value="chunk-0ba22e2612dbc225416101c15d4cb857" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-870742dec10263e0078e94a0b6a827aa-e-5" label="Elemental segregation">
        <attvalues>
          <attvalue for="0" value="Elemental segregation" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="元素偏析（Elemental segregation）指在多晶材料中，某些溶质或杂质原子在晶界处的浓度显著高于其在晶粒内部（晶体）浓度的现象。这种原子不均匀分布会显著影响材料的机械、化学及电学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-870742dec10263e0078e94a0b6a827aa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-870742dec10263e0078e94a0b6a827aa-e-7" label="Mechanical properties of disc alloys">
        <attvalues>
          <attvalue for="0" value="Mechanical properties of disc alloys" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="盘用合金的机械性能是指其在载荷作用下的响应能力，包含强度、韧性、疲劳寿命和蠕变抗力等一系列指标。这些性能决定了涡轮盘等高温承力部件的服役可靠性，并受到晶粒尺寸等微观结构的显著影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-870742dec10263e0078e94a0b6a827aa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-870742dec10263e0078e94a0b6a827aa-e-11" label="Yield properties">
        <attvalues>
          <attvalue for="0" value="Yield properties" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="屈服性能是一组关键的机械性能，主要指材料的屈服强度，即材料开始发生塑性（永久）变形时的应力极限。它是衡量材料抵抗永久变形能力的重要指标，其数值会受到化学成分的影响，例如铝(Al)、钛(Ti)和铌(Nb)等合金元素的添加通常能有效提升该性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-870742dec10263e0078e94a0b6a827aa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Yield Properties&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-870742dec10263e0078e94a0b6a827aa-e-11&quot;, &quot;chunk-99e1c2354bf8364a02d01889797902c8-e-4&quot;, &quot;chunk-127ccac0bbb9a57ea78fa0e8276b38f5-e-4&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-870742dec10263e0078e94a0b6a827aa-e-12" label="Grain structure">
        <attvalues>
          <attvalue for="0" value="Grain structure" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="晶粒结构是指多晶材料内部晶粒的大小、形状及排列方式等微观结构特征。它可以通过锻造、热处理等工艺进行主动控制，从而决定材料最终的力学性能和物理性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-870742dec10263e0078e94a0b6a827aa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="24" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-569a3d8aec20d9df6a256b4cf4b263a7-e-14" label="single crystal alloys">
        <attvalues>
          <attvalue for="0" value="single crystal alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="单晶合金是一种整个部件由单一、连续晶格构成的金属材料。由于其完全消除了晶界这一高温下的薄弱环节，因此具有卓越的高温强度、抗蠕变和抗疲劳性能。其性能常通过固溶热处理等工艺进一步优化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-569a3d8aec20d9df6a256b4cf4b263a7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-86425bad56c0d52ed7246eff0fe06dd8-e-6" label="homogenisation">
        <attvalues>
          <attvalue for="0" value="homogenisation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="均质化是一种材料处理过程，指通过高压、强剪切等物理手段，将液体或半固体混合物中的颗粒或液滴粉碎细化并使其均匀分散，从而增强体系的稳定性、改善质地并防止分层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-86425bad56c0d52ed7246eff0fe06dd8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-86425bad56c0d52ed7246eff0fe06dd8-e-6&quot;]}]" />
          <attvalue for="9" value="401" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-86425bad56c0d52ed7246eff0fe06dd8-e-12" label="incubation period">
        <attvalues>
          <attvalue for="0" value="incubation period" />
          <attvalue for="1" value="Time Period" />
          <attvalue for="2" value="指材料蠕变变形的初始阶段。在此期间，材料内部的微观结构发生调整与演化，为后续的应变积累做准备，但宏观上的变形量极小或尚未显现。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-86425bad56c0d52ed7246eff0fe06dd8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-86425bad56c0d52ed7246eff0fe06dd8-e-14" label="industrial gas turbine">
        <attvalues>
          <attvalue for="0" value="industrial gas turbine" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="工业燃气轮机是一种专为地面工业应用（如发电、机械驱动）设计的内燃式动力机械。它将燃料化学能转化为机械功，特点是功率大、运行可靠、可长时间连续工作，用于驱动发电机、泵和压缩机等大型设备。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-86425bad56c0d52ed7246eff0fe06dd8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="402" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-1297af8788c2be7a2a158412cd2652f3-e-2" label="industrial gas turbine">
        <attvalues>
          <attvalue for="0" value="industrial gas turbine" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="工业燃气轮机是一种将燃料化学能转化为可用机械功的旋转式动力机械。它通过燃烧燃料产生高温高压燃气，驱动涡轮高速旋转，主要用于发电或为大型工业设备提供动力。其涡轮叶片等关键热端部件，需采用金属间化合物等先进耐高温材料制造以承受极端工况。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-1297af8788c2be7a2a158412cd2652f3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1297af8788c2be7a2a158412cd2652f3-e-7" label="PHACOMP">
        <attvalues>
          <attvalue for="0" value="PHACOMP" />
          <attvalue for="1" value="Computational Method" />
          <attvalue for="2" value="PHACOMP，全称“相计算法”(Phase Computation)，是一种在材料科学领域预测合金微观结构稳定性的计算方法。它通过计算合金的平均电子空位数，评估有害拓扑密排相(TCP相)的形成风险，是高温合金成分设计的关键工具，用于避免材料因组织不稳定而导致性能退化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-1297af8788c2be7a2a158412cd2652f3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;PHACOMP 160&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1297af8788c2be7a2a158412cd2652f3-e-7&quot;, &quot;chunk-64f0b642dc984a92646a132ee856bc18-e-16&quot;, &quot;chunk-cad1eaa9ffb0e731892120bbe3415da7-e-1&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1297af8788c2be7a2a158412cd2652f3-e-12" label="superalloy">
        <attvalues>
          <attvalue for="0" value="superalloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="高温合金（Superalloy）是一种以铁、镍或钴为基的金属材料。它能在600℃以上的高温和复杂应力环境下长期工作，并保持优异的高温强度、抗氧化性、抗腐蚀性及良好的组织稳定性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-1297af8788c2be7a2a158412cd2652f3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1297af8788c2be7a2a158412cd2652f3-e-15" label="heat transfer">
        <attvalues>
          <attvalue for="0" value="heat transfer" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="热传递是因温差而引起的热能从高温物体或系统转移到低温物体或系统的物理过程。它自然地朝向热平衡状态进行，其三种基本方式是热传导、热对流和热辐射。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-1297af8788c2be7a2a158412cd2652f3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d548052a2344b0da613ab35155dcbdaa-e-3" label="defect formation">
        <attvalues>
          <attvalue for="0" value="defect formation" />
          <attvalue for="1" value="Process Outcome" />
          <attvalue for="2" value="缺陷形成是在熔模铸造等制造过程中，因工艺或材料问题导致产品产生裂纹、气孔等非预期瑕疵，从而影响其性能和质量的一种不良结果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d548052a2344b0da613ab35155dcbdaa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d548052a2344b0da613ab35155dcbdaa-e-4" label="single crystal morphology">
        <attvalues>
          <attvalue for="0" value="single crystal morphology" />
          <attvalue for="1" value="Material Structure" />
          <attvalue for="2" value="一种材料结构，指整个宏观部件由一个无晶界的单一晶体构成。这种特定的结构形态通常在熔模铸造等定向凝固工艺中，通过控制结晶过程而形成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-d548052a2344b0da613ab35155dcbdaa" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d548052a2344b0da613ab35155dcbdaa-e-12" label="speed of withdrawal">
        <attvalues>
          <attvalue for="0" value="speed of withdrawal" />
          <attvalue for="1" value="Process Parameter" />
          <attvalue for="2" value="作为一个过程参数，指在特定工艺中，将物体（如基板、工具）从介质或工件中移出的速率。该参数是浸涂、铸造、焊接等制造过程中的关键变量，直接影响最终产品的涂层厚度、表面质量或微观结构等性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-d548052a2344b0da613ab35155dcbdaa" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d548052a2344b0da613ab35155dcbdaa-e-12&quot;, &quot;chunk-a9fba026e3b8980c4957dbe16260f585-e-2&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a9fba026e3b8980c4957dbe16260f585-e-1" label="seeding">
        <attvalues>
          <attvalue for="0" value="seeding" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="在索引编制领域，指为特定主题或术语创建初始索引条目的过程。该条目包含一个指向正文中具体位置的引用（如页码），是构建和扩展完整索引的基础步骤。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;124&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-a9fba026e3b8980c4957dbe16260f585" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="403" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-a9fba026e3b8980c4957dbe16260f585-e-7" label="Jet engine">
        <attvalues>
          <attvalue for="0" value="Jet engine" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="喷气发动机是一种通过高速喷射燃气产生推力的连续流热机，通常用作飞机的动力装置。因其核心部件（如涡轮叶片）需在极端高温高压环境下工作，它的研发与进步极大推动了超级合金等先进耐高温材料的发展。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;2&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-a9fba026e3b8980c4957dbe16260f585" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Jet Engines&quot;, &quot;Modern jet engine&quot;, &quot;jet engine&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a9fba026e3b8980c4957dbe16260f585-e-7&quot;, &quot;chunk-97a0a28a657f3432d5d667cd779eea4b-e-2&quot;, &quot;chunk-c87d6224a6dfa2402ba4ce5b82dd066c-e-1&quot;, &quot;chunk-49fe0f122b885e8929f914d54a677b92-e-4&quot;, &quot;chunk-6961c93f48e22019dc09686be94a57fd-e-6&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a9fba026e3b8980c4957dbe16260f585-e-8" label="Kear-Wilsdorf locking mechanism">
        <attvalues>
          <attvalue for="0" value="Kear-Wilsdorf locking mechanism" />
          <attvalue for="1" value="Scientific Mechanism" />
          <attvalue for="2" value="Kear-Wilsdorf锁定机制是一种材料科学中的硬化机理，用于解释特定合金（如高温合金）屈服强度随温度升高而异常增加的现象（正温度依赖性）。其核心是螺位错通过形成扭折(jogs)和宏观纽结(macrokinks)等不可移动的障碍而被钉扎，阻碍其运动，从而提高材料强度。" />
          <attvalue for="3" value="{&quot;introduction_page&quot;: &quot;71&quot;, &quot;details_pages&quot;: &quot;86-90&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-a9fba026e3b8980c4957dbe16260f585" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Kear-Wilsdorf lock&quot;, &quot;dislocations in screw orientations&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a9fba026e3b8980c4957dbe16260f585-e-8&quot;, &quot;chunk-a9fba026e3b8980c4957dbe16260f585-e-10&quot;, &quot;chunk-d965a70b739082dfa928e6608abf4061-e-5&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-a9fba026e3b8980c4957dbe16260f585-e-9" label="Hirsch model">
        <attvalues>
          <attvalue for="0" value="Hirsch model" />
          <attvalue for="1" value="Scientific Model" />
          <attvalue for="2" value="赫希模型（Hirsch model）是一种科学模型，作为科尔-维尔斯多夫锁定机制（Kear-Wilsdorf locking mechanism）的关键组成部分。它具体描述了在特定合金中，螺位错通过在{111}面上交滑移到{100}面上，形成不可动位错段而被钉扎的过程，从而解释了材料屈服强度随温度异常升高的现象。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;90&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-a9fba026e3b8980c4957dbe16260f585" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a9fba026e3b8980c4957dbe16260f585-e-11" label="jogs">
        <attvalues>
          <attvalue for="0" value="jogs" />
          <attvalue for="1" value="Material Science Concept" />
          <attvalue for="2" value="**割阶 (Jogs)**&#10;&#10;材料科学概念，指位错线上的一种几何缺陷，其方向不位于位错的主滑移面内。割阶会阻碍位错的滑移运动，是一种重要的强化机制，例如在Kear-Wilsdorf锁定机制中扮演关键角色。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;87&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-a9fba026e3b8980c4957dbe16260f585" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a9fba026e3b8980c4957dbe16260f585-e-12" label="macrokinks">
        <attvalues>
          <attvalue for="0" value="macrokinks" />
          <attvalue for="1" value="Material Science Concept" />
          <attvalue for="2" value="宏观扭折(Macrokinks)是材料科学中的一个概念，指在Kear-Wilsdorf锁定机制下，被固定的螺位错上形成的大尺寸可动段。这些扭折沿位错线的运动是材料高温塑性变形的关键机制，用以解释特定金属间化合物的异常屈服现象。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;87&quot;}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-a9fba026e3b8980c4957dbe16260f585" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a9fba026e3b8980c4957dbe16260f585-e-13" label="L12 crystal structure">
        <attvalues>
          <attvalue for="0" value="L12 crystal structure" />
          <attvalue for="1" value="Crystal Structure" />
          <attvalue for="2" value="L12结构是一种基于面心立方（FCC）晶格的有序超晶格结构，其化学通式为A₃B，原型为AuCu₃。在晶胞中，A原子占据立方体顶点，B原子占据面心位置。该结构是许多金属间化合物的典型结构，尤其以作为镍基高温合金中的重要强化相γ'相（如Ni₃Al）的晶体结构而闻名。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;40&quot;}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-a9fba026e3b8980c4957dbe16260f585" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;L12 crystal structures&quot;, &quot;L12 structure&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a9fba026e3b8980c4957dbe16260f585-e-13&quot;, &quot;chunk-c54fb0cde287461ac785a255da940d8d-e-1&quot;, &quot;chunk-96f36e4af04723225cb4d274300efd6e-e-4&quot;, &quot;chunk-cab35826f1356487207a5472cfaf8878-e-4&quot;, &quot;chunk-003c7763c31b55c8a5748939ac729c6a-e-4&quot;, &quot;chunk-d965a70b739082dfa928e6608abf4061-e-7&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-a9fba026e3b8980c4957dbe16260f585-e-14" label="ladder diagram">
        <attvalues>
          <attvalue for="0" value="ladder diagram" />
          <attvalue for="1" value="Diagram" />
          <attvalue for="2" value="梯形图是一种图形化编程语言，也称梯形逻辑（Ladder Logic）。它借鉴继电器控制电路图的形式，外观形似梯子，是可编程逻辑控制器（PLC）最常用的编程语言，广泛应用于工业自动化控制领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-a9fba026e3b8980c4957dbe16260f585" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="404" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-a9fba026e3b8980c4957dbe16260f585-e-16" label="hardening (Kear-Wilsdorf locking mechanism)">
        <attvalues>
          <attvalue for="0" value="hardening (Kear-Wilsdorf locking mechanism)" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种由Kear-Wilsdorf锁定机制引起的材料强化过程。该机制通过形成稳定的位错锁，阻碍位错运动，从而显著提高材料（尤其是有序金属间化合物）的强度和硬度。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;86-90&quot;}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-a9fba026e3b8980c4957dbe16260f585" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;hardening&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a9fba026e3b8980c4957dbe16260f585-e-16&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-a9fba026e3b8980c4957dbe16260f585-e-17" label="positive temperature dependence">
        <attvalues>
          <attvalue for="0" value="positive temperature dependence" />
          <attvalue for="1" value="Material Behavior" />
          <attvalue for="2" value="一种反常的材料行为，指材料的屈服强度在特定温度区间内随温度升高而增加的现象。该行为常见于L1₂结构的金属间化合物，其物理机制可由Kear-Wilsdorf位错锁固模型来解释。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;90&quot;}" />
          <attvalue for="4" value="e-17" />
          <attvalue for="5" value="chunk-a9fba026e3b8980c4957dbe16260f585" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c54fb0cde287461ac785a255da940d8d-e-3" label="Lattice stabilities">
        <attvalues>
          <attvalue for="0" value="Lattice stabilities" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="晶格稳定性是一种物理性质，指材料在特定条件下（如温度、压力），其不同可能晶体结构（如FCC、BCC）的相对热力学稳定性。通常由吉布斯自由能衡量，能量越低的结构越稳定。该性质对理解镍及其他过渡金属的相变行为至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c54fb0cde287461ac785a255da940d8d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c54fb0cde287461ac785a255da940d8d-e-4" label="Ni">
        <attvalues>
          <attvalue for="0" value="Ni" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="镍（Nickel）是一种化学元素，符号为Ni，原子序数为28。它是一种具有磁性的银白色过渡金属，质地坚硬且耐腐蚀，常被用于制造不锈钢、特殊合金、硬币及催化剂。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c54fb0cde287461ac785a255da940d8d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c54fb0cde287461ac785a255da940d8d-e-5" label="Transition metals">
        <attvalues>
          <attvalue for="0" value="Transition metals" />
          <attvalue for="1" value="Element Group" />
          <attvalue for="2" value="过渡金属（Transition metal）是元素周期表中d区的一系列化学元素的统称。它们的原子具有部分填充的d轨道，因此表现出多种价态和独特的催化、磁性等性质，是构成多种高性能合金（如镍基合金）的关键元素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c54fb0cde287461ac785a255da940d8d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Transition Metals&quot;, &quot;Transition metal (X)&quot;, &quot;transition metal series&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c54fb0cde287461ac785a255da940d8d-e-5&quot;, &quot;chunk-1410988dfcbd0392c9d01a4bc32fcff9-e-6&quot;, &quot;chunk-951c3bbe670e3cf4f0dc7a8bc55e7730-e-1&quot;, &quot;chunk-421a0cbf74306b155ad41d43e8de9233-e-1&quot;, &quot;chunk-1f5d781c40896f23b19d1622a0e99572-e-6&quot;, &quot;chunk-833b212eb3a569521f9a95be24874ec1-e-8&quot;, &quot;chunk-5b143324ae92718a4dde1cd69bd72bd2-e-3&quot;, &quot;chunk-3ca8a51d3be3a429f4f741571769150f-e-5&quot;, &quot;chunk-f86488a9b0d8a6ad97c3c2b189dd5035-e-3&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="12" />
        </attvalues>
      </node>
      <node id="chunk-c54fb0cde287461ac785a255da940d8d-e-10" label="Line energy">
        <attvalues>
          <attvalue for="0" value="Line energy" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="线能量是与晶体中的位错线相关联的一种物理性质，指位错线单位长度所具有的能量。它的大小主要取决于位错周围晶格畸变所引起的弹性应变能，是决定位错行为和材料力学性能的重要参数。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;77&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-c54fb0cde287461ac785a255da940d8d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c54fb0cde287461ac785a255da940d8d-e-12" label="Liquid density">
        <attvalues>
          <attvalue for="0" value="Liquid density" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="液体密度指在特定温度和压力下，液体单位体积内所含的质量。它是一种重要的物理性质和物质的固有属性，用于表征液体的紧密程度。其国际标准单位为千克每立方米（kg/m³）。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;144&quot;}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-c54fb0cde287461ac785a255da940d8d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="405" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-d9d581e86b96c92ccf2b9c353b4e4e11-e-2" label="liquid aluminium">
        <attvalues>
          <attvalue for="0" value="liquid aluminium" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="金属铝的熔融形态，一种常见的液态金属冷却剂。由于其独特的热物理性质，在相关技术应用中，其性能和成本常与锡等其他低熔点金属进行比较，以作选择。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-d9d581e86b96c92ccf2b9c353b4e4e11" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d9d581e86b96c92ccf2b9c353b4e4e11-e-3" label="Tin">
        <attvalues>
          <attvalue for="0" value="Tin" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="锡是一种化学元素，符号为Sn，原子序数50。它是一种银白色的低熔点金属，因其良好的导热性，在液态时可用作液态金属冷却技术中的传热介质。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-d9d581e86b96c92ccf2b9c353b4e4e11" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;tin&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d9d581e86b96c92ccf2b9c353b4e4e11-e-3&quot;, &quot;chunk-23df60e783372fb64b1a5a9966ec4edc-e-8&quot;]}]" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d9d581e86b96c92ccf2b9c353b4e4e11-e-7" label="creep rupture">
        <attvalues>
          <attvalue for="0" value="creep rupture" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="蠕变断裂(creep rupture)是一种材料失效机制，指材料在高温和持续应力作用下，随时间推移发生的断裂。在单晶高温合金中，这种失效模式的发生会受到小角度晶界的影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d9d581e86b96c92ccf2b9c353b4e4e11" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d9d581e86b96c92ccf2b9c353b4e4e11-e-11" label="austenitic (gamma) matrix">
        <attvalues>
          <attvalue for="0" value="austenitic (gamma) matrix" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="奥氏体（伽马）基体是材料微观结构中的主要连续相，由奥氏体（γ相）构成。奥氏体是碳在铁中的一种固溶体，具有面心立方（FCC）晶体结构。它作为其他相（如铁素体、渗碳体）的衬底，是高温下钢以及室温下不锈钢中的典型基体组织。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-d9d581e86b96c92ccf2b9c353b4e4e11" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d9d581e86b96c92ccf2b9c353b4e4e11-e-11&quot;, &quot;chunk-1159c2afbaaccc92d505d71fb856dee1-e-3&quot;]}]" />
          <attvalue for="9" value="406" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-d9d581e86b96c92ccf2b9c353b4e4e11-e-12" label="MCrAlY coatings">
        <attvalues>
          <attvalue for="0" value="MCrAlY coatings" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="MCrAlY涂层是一类重要的高温防护涂层。其名称代表其主要化学成分：金属基体（M: 镍、钴或其合金）、铬（Cr）、铝（Al）和钇（Y）。它通过在高温下形成致密稳定的氧化铝保护膜，赋予基体优异的抗氧化和抗热腐蚀性能，常作为热障涂层的粘结层用于航空发动机等领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-d9d581e86b96c92ccf2b9c353b4e4e11" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="407" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-1159c2afbaaccc92d505d71fb856dee1-e-1" label="stalline superalloys">
        <attvalues>
          <attvalue for="0" value="stalline superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="“stalline superalloys”通常是“crystalline superalloys”（晶体高温合金）的拼写错误。后者指具有高度有序原子结构的高性能合金，能在高温下保持优异的机械强度、抗蠕变和耐腐蚀性，常被制成单晶或定向凝固部件，用于航空发动机涡轮叶片等极端环境。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;236-259, 260-274&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-1159c2afbaaccc92d505d71fb856dee1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="408" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-1159c2afbaaccc92d505d71fb856dee1-e-4" label="MCrAlY coatings">
        <attvalues>
          <attvalue for="0" value="MCrAlY coatings" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="MCrAlY涂层是一类金属基高温防护涂层，其名称代表核心化学组分：M（镍和/或钴）、铬（Cr）、铝（Al）和钇（Y）。它通过在高温下形成致密的氧化铝保护层，赋予基材卓越的抗氧化与抗热腐蚀性能，是燃气轮机热端部件的关键材料，也用作热障涂层的粘结层。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;283, 305, 306&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1159c2afbaaccc92d505d71fb856dee1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="409" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-1159c2afbaaccc92d505d71fb856dee1-e-5" label="creep">
        <attvalues>
          <attvalue for="0" value="creep" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="蠕变是一种力学性能，指材料在恒定应力和高温作用下，随时间缓慢产生塑性变形的现象。它是评估单晶高温合金等材料在高温环境下长期服役时，其尺寸稳定性和结构完整性的关键指标。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;170-194&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1159c2afbaaccc92d505d71fb856dee1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1159c2afbaaccc92d505d71fb856dee1-e-10" label="mesh sizes">
        <attvalues>
          <attvalue for="0" value="mesh sizes" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="目数（Mesh Size）是表征粉末等颗粒状物料粒度或细度的物理属性。它通常定义为每英寸长度筛网上的筛孔数量，数值越大代表筛孔越小，说明能够通过该筛网的物料颗粒越细。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;234-235&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-1159c2afbaaccc92d505d71fb856dee1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1159c2afbaaccc92d505d71fb856dee1-e-13" label="misfit dislocations">
        <attvalues>
          <attvalue for="0" value="misfit dislocations" />
          <attvalue for="1" value="Crystallographic Defect" />
          <attvalue for="2" value="失配位错是一种在两种不同晶体材料的界面处形成的晶体缺陷。它的形成是为了调节两种材料因晶格常数不匹配（即晶格失配）而产生的弹性应变，通常以位错网络的形式存在于界面上。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;180-187&quot;}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-1159c2afbaaccc92d505d71fb856dee1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1159c2afbaaccc92d505d71fb856dee1-e-14" label="modelling">
        <attvalues>
          <attvalue for="0" value="modelling" />
          <attvalue for="1" value="Technique" />
          <attvalue for="2" value="一种应用于锻造、热处理等工艺过程的技术。它是一个广义的技术类别，包含了“本构建模”等更为具体的建模类型，用于描述、分析或预测物理过程的行为。" />
          <attvalue for="3" value="{&quot;page_references&quot;: &quot;260, 361-362&quot;}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-1159c2afbaaccc92d505d71fb856dee1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-1159c2afbaaccc92d505d71fb856dee1-e-18" label="constitutive modelling">
        <attvalues>
          <attvalue for="0" value="constitutive modelling" />
          <attvalue for="1" value="Technique" />
          <attvalue for="2" value="本构建模是一种在物理学和工程学中，为材料或物质的物理行为（如应力-应变关系）创建数学模型的专门技术。它通过建立本构方程，来描述材料如何响应各种外部刺激（如力、温度变化）的内在特性。" />
          <attvalue for="3" value="{&quot;page_reference&quot;: &quot;175&quot;}" />
          <attvalue for="4" value="e-18" />
          <attvalue for="5" value="chunk-1159c2afbaaccc92d505d71fb856dee1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1159c2afbaaccc92d505d71fb856dee1-e-19" label="melting">
        <attvalues>
          <attvalue for="0" value="melting" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="熔化是一种基础热过程，指通过加热使固体物质（尤其是金属、合金等）从固态转变为液态的物理变化。它是铸造、精炼和材料制备中的关键环节，具体工艺包含真空感应熔炼等多种类型。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-19" />
          <attvalue for="5" value="chunk-1159c2afbaaccc92d505d71fb856dee1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1159c2afbaaccc92d505d71fb856dee1-e-19&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ec1da0ebfe72b58a50620a5a71c6abf7-e-5" label="Molten-salt hot corrosion">
        <attvalues>
          <attvalue for="0" value="Molten-salt hot corrosion" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="熔盐热腐蚀是一种加速的高温腐蚀形式。它指在高温含盐气氛中，材料表面沉积的熔融盐薄膜通过溶解或破坏其保护性氧化层，从而导致基体材料快速氧化和降解的现象，常见于燃气轮机热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ec1da0ebfe72b58a50620a5a71c6abf7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ec1da0ebfe72b58a50620a5a71c6abf7-e-5&quot;]}]" />
          <attvalue for="9" value="410" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-ec1da0ebfe72b58a50620a5a71c6abf7-e-8" label="Moulds">
        <attvalues>
          <attvalue for="0" value="Moulds" />
          <attvalue for="1" value="Tool" />
          <attvalue for="2" value="在熔模铸造工艺中使用的工具，其内部具有特定形状的型腔，用于注入熔融金属等材料，冷却凝固后得到所需形状的铸件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-ec1da0ebfe72b58a50620a5a71c6abf7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ec1da0ebfe72b58a50620a5a71c6abf7-e-11" label="Solvent">
        <attvalues>
          <attvalue for="0" value="Solvent" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="一种以镍为基体的材料组分，在高温合金中作为溶剂。它构成了合金的基体结构，并将其他合金元素（溶质）溶解于其中，从而决定合金的基本性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-ec1da0ebfe72b58a50620a5a71c6abf7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ec1da0ebfe72b58a50620a5a71c6abf7-e-12" label="Creep curves">
        <attvalues>
          <attvalue for="0" value="Creep curves" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="蠕变曲线（Creep curves）是在恒定应力和温度下，材料的应变随时间变化的图形表示。它直观地描述了材料的蠕变过程（通常分为减速、稳定和加速三个阶段），是衡量如镍等金属材料在高温下长期服役时抵抗塑性变形能力的重要性能指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-ec1da0ebfe72b58a50620a5a71c6abf7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ec1da0ebfe72b58a50620a5a71c6abf7-e-12&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ec1da0ebfe72b58a50620a5a71c6abf7-e-13" label="Physical metallurgy of nickel">
        <attvalues>
          <attvalue for="0" value="Physical metallurgy of nickel" />
          <attvalue for="1" value="Field of Study" />
          <attvalue for="2" value="镍物理冶金学是冶金学和材料科学的分支学科，它系统研究镍及其合金的成分、加工工艺、微观组织结构与宏观物理、力学性能之间的内在联系和规律，旨在控制其结构以获得优异性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-ec1da0ebfe72b58a50620a5a71c6abf7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c8fee299c7ba0eef0fb9057ffd13203c-e-3" label="nickel-aluminium system">
        <attvalues>
          <attvalue for="0" value="nickel-aluminium system" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="镍-铝体系是由镍(Ni)和铝(Al)组成的二元合金体系，其相平衡关系通过二元相图表示。该体系能形成多种具有优异高温抗氧化性能的金属间化合物（镍铝化物），是研发高温防护涂层和高温结构材料的重要基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-c8fee299c7ba0eef0fb9057ffd13203c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c8fee299c7ba0eef0fb9057ffd13203c-e-4" label="nickel-chromium-aluminium-yttrium (NiCrAlY) coatings">
        <attvalues>
          <attvalue for="0" value="nickel-chromium-aluminium-yttrium (NiCrAlY) coatings" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="一种以镍为基体，添加了铬、铝和钇的高温防护合金涂层。其核心功能是通过在高温下形成一层致密、稳定且附着力强的氧化铝保护膜，为基材提供卓越的抗氧化和抗热腐蚀性能，广泛应用于航空发动机和燃气轮机的热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c8fee299c7ba0eef0fb9057ffd13203c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c8fee299c7ba0eef0fb9057ffd13203c-e-5" label="nickel-chromium system">
        <attvalues>
          <attvalue for="0" value="nickel-chromium system" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="一种以镍和铬为主要组元的二元合金材料体系。该体系表现出特定的抗氧化与抗硫化性能，其不同温度和成分下的相平衡关系可通过二元相图进行描述。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c8fee299c7ba0eef0fb9057ffd13203c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c8fee299c7ba0eef0fb9057ffd13203c-e-8" label="Physical Metallurgy">
        <attvalues>
          <attvalue for="0" value="Physical Metallurgy" />
          <attvalue for="1" value="Scientific Field" />
          <attvalue for="2" value="物理冶金学是冶金学和材料科学的重要分支。它系统研究金属与合金的成分、晶体结构、微观组织与其物理、化学和力学性能之间的关系及变化规律，为改善和控制材料性能提供理论基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-c8fee299c7ba0eef0fb9057ffd13203c" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c8fee299c7ba0eef0fb9057ffd13203c-e-10" label="Binary Phase Diagram">
        <attvalues>
          <attvalue for="0" value="Binary Phase Diagram" />
          <attvalue for="1" value="Scientific Diagram" />
          <attvalue for="2" value="二元相图（Binary Phase Diagram），又称二元系状态图，是在材料科学和热力学中，以图解方式表示双组分系统在热力学平衡状态下，其物相与温度、成分之间关系的几何图形。它直观地标明了不同相区的存在范围、相变温度及各相的相对含量。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-c8fee299c7ba0eef0fb9057ffd13203c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;binary phase diagram&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c8fee299c7ba0eef0fb9057ffd13203c-e-10&quot;, &quot;chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-1&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-c8fee299c7ba0eef0fb9057ffd13203c-e-12" label="Sulphidisation Behaviour">
        <attvalues>
          <attvalue for="0" value="Sulphidisation Behaviour" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**硫化行为 (sulphidisation behaviour)**&#10;&#10;一种材料属性，指材料（尤其是金属和合金）在高温含硫环境中，与硫或硫化合物发生化学反应，从而在其表面形成金属硫化物腐蚀层的特性。此过程通常会导致材料的性能退化和结构失效。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-c8fee299c7ba0eef0fb9057ffd13203c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;sulphidisation behaviour&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c8fee299c7ba0eef0fb9057ffd13203c-e-12&quot;, &quot;chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-3&quot;]}]" />
          <attvalue for="9" value="12" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-7" label="Non-stoichiometry">
        <attvalues>
          <attvalue for="0" value="Non-stoichiometry" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="**非化学计量 (Non-stoichiometry)**&#10;&#10;一种材料属性，指晶体化合物（如Ni3Al）因其晶格中存在点缺陷（如反位缺陷），导致其实际元素组成偏离化学式所定义的理想整数比的现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-7418f6b06f5e1352f4e9b57edaa1a516" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;non-stoichiometry&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-7&quot;, &quot;chunk-c8291b746df8607dee394ae506322bb2-e-9&quot;]}]" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-8" label="anti-site defects">
        <attvalues>
          <attvalue for="0" value="anti-site defects" />
          <attvalue for="1" value="Defect Type" />
          <attvalue for="2" value="反位缺陷是一种晶体点缺陷，指在晶格中，一种类型的原子错误地占据了本应由另一种类型原子占据的位置。这种原子错位是导致化合物（如Ni3Al）产生非化学计量（non-stoichiometry）的重要机制之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-7418f6b06f5e1352f4e9b57edaa1a516" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-10" label="NiAl">
        <attvalues>
          <attvalue for="0" value="NiAl" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="**NiAl**，又称镍铝化物，是一种由镍(Ni)和铝(Al)组成的金属间化合物。它具有非化学计量(non-stoichiometry)的显著特性，即其化学成分可在一定范围内变化，同时保持其稳定的有序晶体结构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-7418f6b06f5e1352f4e9b57edaa1a516" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-15" label="crystal structure">
        <attvalues>
          <attvalue for="0" value="crystal structure" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="晶体结构是一种材料属性，指晶体材料中原子、离子或分子的有序、周期性三维排列方式。这种独特的微观排列（即晶格）从根本上决定了材料的宏观物理性质，如硬度、导电性和熔点。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-7418f6b06f5e1352f4e9b57edaa1a516" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Crystal structure&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-15&quot;, &quot;chunk-2555e274f1223f9245526a48267868ff-e-1&quot;, &quot;chunk-951c3bbe670e3cf4f0dc7a8bc55e7730-e-10&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-16" label="Ni-Al binary system">
        <attvalues>
          <attvalue for="0" value="Ni-Al binary system" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="由镍(Ni)和铝(Al)元素构成的二元合金体系。该体系因原子间强烈的相互作用而发生显著的有序化现象，能形成NiAl、Ni₃Al等多种稳定的金属间化合物，是重要的高温结构材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-7418f6b06f5e1352f4e9b57edaa1a516" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-17" label="orientation dependence">
        <attvalues>
          <attvalue for="0" value="orientation dependence" />
          <attvalue for="1" value="Characteristic" />
          <attvalue for="2" value="方向依赖性（Orientation-dependence）是一种材料特性，指其低周疲劳（LCF）性能会随着载荷施加方向相对于材料内部结构（如晶粒取向）的变化而呈现出差异。这种各向异性是影响材料在循环载荷下寿命和可靠性的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-17" />
          <attvalue for="5" value="chunk-7418f6b06f5e1352f4e9b57edaa1a516" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;orientation-dependence&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-8&quot;, &quot;chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-17&quot;]}]" />
          <attvalue for="9" value="124" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-18" label="creep curve">
        <attvalues>
          <attvalue for="0" value="creep curve" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="蠕变曲线（Creep Curve）是在恒定应力和温度下，表征材料应变随时间变化的图形。典型的蠕变曲线包含三个阶段：蠕变速率递减的初始阶段、速率近乎恒定的稳态阶段，以及速率激增并最终导致材料断裂的加速阶段。它是预测材料在长期服役下的变形和寿命的重要依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-18" />
          <attvalue for="5" value="chunk-7418f6b06f5e1352f4e9b57edaa1a516" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-7418f6b06f5e1352f4e9b57edaa1a516-e-18&quot;, &quot;chunk-2555e274f1223f9245526a48267868ff-e-3&quot;]}]" />
          <attvalue for="9" value="124" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2555e274f1223f9245526a48267868ff-e-2" label="Ni-Al binary system">
        <attvalues>
          <attvalue for="0" value="Ni-Al binary system" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="镍铝二元体系 (Ni-Al binary system) 是由镍（Ni）和铝（Al）两种元素组成的材料体系。该体系的特点是能形成多种具有独特晶体结构的金属间化合物（如NiAl、Ni₃Al），这些化合物因其优异的高温性能，常作为关键相应用于高温合金中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-2555e274f1223f9245526a48267868ff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2555e274f1223f9245526a48267868ff-e-4" label="outgassing">
        <attvalues>
          <attvalue for="0" value="outgassing" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="一种物理过程，指材料在受热或处于真空环境下，释放其内部原先被溶解、吸附或束缚的气体。此现象在真空感应熔炼等需要高纯度材料的工艺中尤为常见。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-2555e274f1223f9245526a48267868ff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2555e274f1223f9245526a48267868ff-e-6" label="overaging">
        <attvalues>
          <attvalue for="0" value="overaging" />
          <attvalue for="1" value="Heat Treatment Process" />
          <attvalue for="2" value="过时效 (Overaging) 是一种热处理工艺现象。它指沉淀强化合金在时效处理中，因保温时间过长或温度过高，导致强化的沉淀相粒子聚集粗化，从而使材料的强度和硬度越过峰值后开始下降的阶段。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-2555e274f1223f9245526a48267868ff" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2555e274f1223f9245526a48267868ff-e-6&quot;]}]" />
          <attvalue for="9" value="411" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-2555e274f1223f9245526a48267868ff-e-8" label="gas turbine">
        <attvalues>
          <attvalue for="0" value="gas turbine" />
          <attvalue for="1" value="Machine" />
          <attvalue for="2" value="燃气轮机是一种以连续流动的气体为工质的内燃动力机械。它将燃料的化学能转化为有用的机械功或推力，其性能通常由整体压力比（OPR）等关键参数来表征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-2555e274f1223f9245526a48267868ff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2555e274f1223f9245526a48267868ff-e-10" label="Ductile-Brittle Transition">
        <attvalues>
          <attvalue for="0" value="Ductile-Brittle Transition" />
          <attvalue for="1" value="Material Behavior" />
          <attvalue for="2" value="韧脆转变（Ductile-Brittle Transition）是材料的一种力学行为，指其断裂模式随温度降低而发生转变的现象：从伴有显著塑性变形的韧性断裂，过渡到几乎无预兆的突发性脆性断裂。这一转变发生的温度范围是衡量材料低温性能的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-2555e274f1223f9245526a48267868ff" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Ductile/brittle transition&quot;, &quot;ductile-brittle transition&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2555e274f1223f9245526a48267868ff-e-10&quot;, &quot;chunk-466225ab73e7ea49ac0af36e5725c4c1-e-4&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-2555e274f1223f9245526a48267868ff-e-12" label="low-cycle fatigue (LCF)">
        <attvalues>
          <attvalue for="0" value="low-cycle fatigue (LCF)" />
          <attvalue for="1" value="Mechanical Property" />
          <attvalue for="2" value="低周疲劳（LCF）是一种机械性能，指材料或构件（如覆盖涂层）在足以引起塑性形变的高应力作用下，经历较少循环次数即发生失效的现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-2555e274f1223f9245526a48267868ff" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2555e274f1223f9245526a48267868ff-e-13" label="mechanical behaviour">
        <attvalues>
          <attvalue for="0" value="mechanical behaviour" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="力学行为是一种材料属性，指材料在受到拉伸、压缩等外力作用时所产生的变形、屈服和断裂等响应。它揭示了材料的强度、塑性、韧性等性能，是评估材料承载能力、可靠性以及进行工程设计和选材的关键依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-2555e274f1223f9245526a48267868ff" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2555e274f1223f9245526a48267868ff-e-13&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2555e274f1223f9245526a48267868ff-e-14" label="Plasma spraying">
        <attvalues>
          <attvalue for="0" value="Plasma spraying" />
          <attvalue for="1" value="Processing Method" />
          <attvalue for="2" value="等离子喷涂是一种材料加工方法，属于热喷涂技术。它利用等离子焰流将陶瓷等粉末材料加热至熔融或半熔融状态，并高速喷射到工件表面形成致密涂层。该方法常用于沉积陶瓷面涂层，但在制备高性能热障涂层（TBCs）方面，其性能存在局限性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-2555e274f1223f9245526a48267868ff" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Plasma Spraying&quot;, &quot;Plasma spraying (PS)&quot;, &quot;Plasma-spraying&quot;, &quot;Plasma-spraying technology&quot;, &quot;plasma spraying&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2555e274f1223f9245526a48267868ff-e-14&quot;, &quot;chunk-f35df7e25f9cadfabe05aeb0e4fee010-e-8&quot;, &quot;chunk-04fc5332fa43dcac6331c45b022dd378-e-10&quot;, &quot;chunk-e3fb38d02a415446b1548e163c6a6dda-e-8&quot;, &quot;chunk-e039cb317db23e5137b0d2d1164a7ea9-e-1&quot;, &quot;chunk-f7942340b7bda97e3a76f6ceb1d90c75-e-7&quot;, &quot;chunk-e4ee2b4726b7ab716e9f01d209b1fd11-e-6&quot;, &quot;chunk-a7d8669831007c6978b4f97d67359deb-e-7&quot;, &quot;chunk-411c58f6cae102022f2bf19e1c6ff24d-e-1&quot;, &quot;chunk-3ef3a46d5883ceba55b19f3ce086fd54-e-4&quot;, &quot;chunk-db7cc890c68f0a43d000b2dba6ecf910-e-1&quot;, &quot;chunk-6d7a887b0ad8aa25cf8cb0d2e4a60af2-e-5&quot;, &quot;chunk-d55298f42964ce23c30b0bcafa72ab6c-e-1&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-e039cb317db23e5137b0d2d1164a7ea9-e-8" label="High temperature oxidation">
        <attvalues>
          <attvalue for="0" value="High temperature oxidation" />
          <attvalue for="1" value="Chemical Process" />
          <attvalue for="2" value="高温氧化是一种化学过程，特指材料（尤指金属和合金）在高温环境中与气相氧化剂（如氧气、水蒸气）发生反应，在其表面形成固态氧化物层的现象。它是材料高温腐蚀和性能退化的主要形式之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-e039cb317db23e5137b0d2d1164a7ea9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e039cb317db23e5137b0d2d1164a7ea9-e-8&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e039cb317db23e5137b0d2d1164a7ea9-e-9" label="Internal oxidation">
        <attvalues>
          <attvalue for="0" value="Internal oxidation" />
          <attvalue for="1" value="Chemical Process" />
          <attvalue for="2" value="内氧化是一种发生在固溶体合金中的化学过程。指在高温下，氧原子渗入合金内部，与其中比基体金属更活泼的溶质元素发生选择性反应，从而在金属基体中形成弥散分布的氧化物析出相，常用于材料的弥散强化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-e039cb317db23e5137b0d2d1164a7ea9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e039cb317db23e5137b0d2d1164a7ea9-e-11" label="Ni-Cr-Al ternary system">
        <attvalues>
          <attvalue for="0" value="Ni-Cr-Al ternary system" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="镍铬铝三元体系是由镍（Ni）、铬（Cr）、铝（Al）三种元素组成的合金体系。该体系因在高温下能形成致密的氧化物保护膜而表现出优异的抗氧化性能，是现代高温合金与防护涂层的关键基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-e039cb317db23e5137b0d2d1164a7ea9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e039cb317db23e5137b0d2d1164a7ea9-e-14" label="Rare earths">
        <attvalues>
          <attvalue for="0" value="Rare earths" />
          <attvalue for="1" value="Element Group" />
          <attvalue for="2" value="稀土是17种化学元素的总称，包括化学周期表中的钪、钇及15个镧系元素。它们具有优异的光、电、磁等物理特性，且化学性质活泼，可在催化、氧化等反应中起关键作用。因其在冶金、永磁材料和高科技电子产品中不可或缺，被誉为“工业维生素”。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-e039cb317db23e5137b0d2d1164a7ea9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e039cb317db23e5137b0d2d1164a7ea9-e-14&quot;, &quot;chunk-c8a13933656ed9f144b18b40f2e9861e-e-2&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e039cb317db23e5137b0d2d1164a7ea9-e-15" label="Selective oxidation">
        <attvalues>
          <attvalue for="0" value="Selective oxidation" />
          <attvalue for="1" value="Chemical Process" />
          <attvalue for="2" value="一种化学过程，指在特定条件下，氧化剂有选择地作用于分子中的特定官能团或位置，而其他可被氧化的部分保持不变。该方法是实现目标产物高效、精准合成的关键技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-e039cb317db23e5137b0d2d1164a7ea9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c8a13933656ed9f144b18b40f2e9861e-e-4" label="Thermodynamics of formation">
        <attvalues>
          <attvalue for="0" value="Thermodynamics of formation" />
          <attvalue for="1" value="Scientific Concept" />
          <attvalue for="2" value="生成热力学是指在标准状态下，由最稳定单质生成1摩尔纯物质时，所发生的特定热力学函数变化。它主要包括标准生成焓（ΔH°f）和标准生成吉布斯自由能（ΔG°f），是判断化合物相对稳定性的重要物理化学指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-c8a13933656ed9f144b18b40f2e9861e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c8a13933656ed9f144b18b40f2e9861e-e-5" label="Oxide scale">
        <attvalues>
          <attvalue for="0" value="Oxide scale" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="氧化皮（Oxide Scales）是在高温氧化环境下，于合金等金属材料表面形成的金属氧化物层。作为一种材料现象，其附着力是决定该层能否有效保护基体、减缓后续腐蚀的关键性能。因此，氧化皮的形成机制与附着特性是材料科学中的重要研究课题。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-c8a13933656ed9f144b18b40f2e9861e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Oxide Scales&quot;, &quot;Oxide scales&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c8a13933656ed9f144b18b40f2e9861e-e-5&quot;, &quot;chunk-99354e5831501ba1d07293128331db80-e-2&quot;, &quot;chunk-7638042a561888cfdce1fb2ee9ad0428-e-9&quot;]}]" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c8a13933656ed9f144b18b40f2e9861e-e-6" label="Ni-Cr-Al alloys">
        <attvalues>
          <attvalue for="0" value="Ni-Cr-Al alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍铬铝合金（Ni-Cr-Al alloys）是一种以镍为基体，添加铬和铝等元素的高温合金。其关键特性是在高温环境中，表面能生成一层致密、稳定的氧化物保护膜，从而赋予合金卓越的抗氧化和抗腐蚀能力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-c8a13933656ed9f144b18b40f2e9861e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="10" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-c8a13933656ed9f144b18b40f2e9861e-e-11" label="Particle coarsening">
        <attvalues>
          <attvalue for="0" value="Particle coarsening" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="粗化是一种材料物理现象，指材料在热力学驱动下，其内部的微观结构（如晶粒、析出相）随时间演变，导致小尺寸特征消失、大尺寸特征长大，从而使平均尺寸增大的过程。此现象旨在降低系统总界面能，漂筏效应是其在特定条件下的表现形式之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-c8a13933656ed9f144b18b40f2e9861e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;coarsening&quot;, &quot;particle coarsening&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c8a13933656ed9f144b18b40f2e9861e-e-11&quot;, &quot;chunk-64f0b642dc984a92646a132ee856bc18-e-1&quot;, &quot;chunk-8a98946fce80230f54608d957bf8fa18-e-5&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-c8a13933656ed9f144b18b40f2e9861e-e-13" label="Particle distributions">
        <attvalues>
          <attvalue for="0" value="Particle distributions" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种表征γ'（伽马撇）相的材料属性，指构成该相的颗粒在尺寸、形态、数量和空间位置上的统计性分布规律。该分布是决定材料宏观性能的关键微观结构特征之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-c8a13933656ed9f144b18b40f2e9861e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;particle distributions&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c8a13933656ed9f144b18b40f2e9861e-e-13&quot;, &quot;chunk-64f0b642dc984a92646a132ee856bc18-e-3&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-64f0b642dc984a92646a132ee856bc18-e-4" label="gamma prime">
        <attvalues>
          <attvalue for="0" value="gamma prime" />
          <attvalue for="1" value="Phase" />
          <attvalue for="2" value="γ'相 (Gamma Prime) 是高温合金中的关键强化相，通常为具有L1₂晶体结构的有序金属间化合物。它以弥散析出颗粒的形式存在，其分布、尺寸和形态是决定合金高温强度的关键因素，通过阻碍位错运动来产生强化效果。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-64f0b642dc984a92646a132ee856bc18" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-64f0b642dc984a92646a132ee856bc18-e-5" label="Particle shearing">
        <attvalues>
          <attvalue for="0" value="Particle shearing" />
          <attvalue for="1" value="Mechanism" />
          <attvalue for="2" value="粒子剪切是一种材料强化机制。它指位错在剪应力产生的驱动力(τbλᵢ)作用下，克服强化相粒子提供的弹性阻力(R)，并直接穿越、切过该粒子的过程。此过程的启动由驱动力与弹性阻力的相互抗衡所控制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-64f0b642dc984a92646a132ee856bc18" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;particle shearing&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-64f0b642dc984a92646a132ee856bc18-e-5&quot;, &quot;chunk-ac23817ca85b5e2cba9cb1da3a1960fc-e-5&quot;, &quot;chunk-aaf1405fdcaab5726ea1519f7e18e407-e-4&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-64f0b642dc984a92646a132ee856bc18-e-6" label="particle strengthening">
        <attvalues>
          <attvalue for="0" value="particle strengthening" />
          <attvalue for="1" value="Strengthening Mechanism" />
          <attvalue for="2" value="**粒子强化 (particle strengthening)**: 一种在高温合金中由γ'相粒子引起的强化机制。它通过这些弥散分布的粒子阻碍位错运动，并通过位错切过粒子（即粒子剪切）等微观过程，显著提高材料的强度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-64f0b642dc984a92646a132ee856bc18" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Particle-strengthening effect&quot;, &quot;particle-strengthening mechanisms&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-542eb38b71ebf203cb6df08f03ceb063-e-5&quot;, &quot;chunk-c2b78e8b376569da6104df59fa66c5ca-e-8&quot;, &quot;chunk-64f0b642dc984a92646a132ee856bc18-e-6&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-64f0b642dc984a92646a132ee856bc18-e-8" label="partitioning">
        <attvalues>
          <attvalue for="0" value="partitioning" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种化学分离过程，特指在核燃料后处理中，将高放射性废液里的特定放射性核素（如钌）分离出来的操作。该过程旨在降低核废料的长期毒性并回收有用元素，其效率会受到钌等元素的化学行为影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-64f0b642dc984a92646a132ee856bc18" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-64f0b642dc984a92646a132ee856bc18-e-10" label="performance">
        <attvalues>
          <attvalue for="0" value="performance" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="性能（Performance）是材料在特定服役条件下所表现出的行为或响应的综合属性。它涵盖了蠕变、疲劳等多种具体力学行为，其优劣会受到热腐蚀、氧化等外部环境因素的显著影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-64f0b642dc984a92646a132ee856bc18" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-64f0b642dc984a92646a132ee856bc18-e-11" label="Coating">
        <attvalues>
          <attvalue for="0" value="Coating" />
          <attvalue for="1" value="Material Layer" />
          <attvalue for="2" value="涂层（Coating）是一种覆盖在基材表面的保护性、装饰性或功能性层状体系。作为一个整体系统，它可能会因内外因素发生失效，尽管很少完全失效。分层（Delamination）是其一种典型的失效模式，表现为涂层从基材或层与层之间发生剥离。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-64f0b642dc984a92646a132ee856bc18" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Coatings&quot;, &quot;Protective coatings&quot;, &quot;coating&quot;, &quot;coatings&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-e039cb317db23e5137b0d2d1164a7ea9-e-4&quot;, &quot;chunk-ef56fb2a5c4451551a2024d8490545ff-e-8&quot;, &quot;chunk-64f0b642dc984a92646a132ee856bc18-e-11&quot;, &quot;chunk-81338b3114de6771de08181ee402e596-e-7&quot;, &quot;chunk-dc948aa78d11700723dfefe1c5756cc9-e-1&quot;, &quot;chunk-cad1eaa9ffb0e731892120bbe3415da7-e-9&quot;, &quot;chunk-0440023a44a202881a859e66f23ec3de-e-10&quot;, &quot;chunk-58ee51f26d85456c13aa639ae170ab36-e-2&quot;, &quot;chunk-8a98946fce80230f54608d957bf8fa18-e-7&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-64f0b642dc984a92646a132ee856bc18-e-12" label="creep">
        <attvalues>
          <attvalue for="0" value="creep" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="蠕变是一种材料退化过程，指固体材料在持续应力和高温作用下，随时间缓慢发生的永久性塑性变形。其性能表现（如蠕变速率）是决定工程构件在高温环境下长期服役可靠性的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-64f0b642dc984a92646a132ee856bc18" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-64f0b642dc984a92646a132ee856bc18-e-13" label="fatigue">
        <attvalues>
          <attvalue for="0" value="fatigue" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="疲劳（Fatigue）指材料在循环应力或应变作用下，结构性能发生渐进性、局部性永久损伤的退化过程。这一过程会导致裂纹萌生与扩展，并最终引发断裂。材料抵抗该过程的能力即为其疲劳性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-64f0b642dc984a92646a132ee856bc18" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-64f0b642dc984a92646a132ee856bc18-e-17" label="phases">
        <attvalues>
          <attvalue for="0" value="phases" />
          <attvalue for="1" value="Material Component Category" />
          <attvalue for="2" value="材料科学中的一个基本类别，指材料体系内物理性质均一、化学成分相同且与其他部分有明确界面的区域。它涵盖了不同的物质状态（如液相）及多种固态微观组分（如伽马相、碳化物、拓扑密排相等）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-17" />
          <attvalue for="5" value="chunk-64f0b642dc984a92646a132ee856bc18" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-64f0b642dc984a92646a132ee856bc18-e-17&quot;, &quot;chunk-cad1eaa9ffb0e731892120bbe3415da7-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-64f0b642dc984a92646a132ee856bc18-e-19" label="gamma">
        <attvalues>
          <attvalue for="0" value="gamma" />
          <attvalue for="1" value="Material Phase" />
          <attvalue for="2" value="Gamma相（γ相）是材料科学与物理学中的术语，特指材料在特定条件下呈现的一种晶体结构或同素异形体。它由希腊字母γ命名，用以区别于同一物质的Alpha（α）、Beta（β）等其他相态，例如钢铁中的奥氏体（γ-Fe）即为一种典型的Gamma相。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-19" />
          <attvalue for="5" value="chunk-64f0b642dc984a92646a132ee856bc18" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-64f0b642dc984a92646a132ee856bc18-e-19&quot;, &quot;chunk-cad1eaa9ffb0e731892120bbe3415da7-e-4&quot;, &quot;chunk-be2e5714ffd15b4d499890769149ecb3-e-9&quot;, &quot;chunk-44260d4b7de8c9a00040496e0aad271b-e-12&quot;, &quot;chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-cad1eaa9ffb0e731892120bbe3415da7-e-6" label="liquid">
        <attvalues>
          <attvalue for="0" value="liquid" />
          <attvalue for="1" value="Phase" />
          <attvalue for="2" value="液体是物质的主要相态之一，介于固体与气体之间。其特点是分子排列不规则且可自由移动，因此没有确定形状，但体积相对固定，具有流动性和一定的表面张力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-cad1eaa9ffb0e731892120bbe3415da7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cad1eaa9ffb0e731892120bbe3415da7-e-12" label="iridium">
        <attvalues>
          <attvalue for="0" value="iridium" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="铱（Iridium）是一种化学元素，符号为Ir，原子序数77。它属于铂族金属，是一种极为坚硬、脆、呈银白色的过渡金属，拥有极高的密度和在所有金属中最强的耐腐蚀性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-cad1eaa9ffb0e731892120bbe3415da7" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-cad1eaa9ffb0e731892120bbe3415da7-e-13" label="osmium">
        <attvalues>
          <attvalue for="0" value="osmium" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="锇（Os）是一种硬而脆的蓝白色过渡金属，属于铂族金属和六方密堆积（HCP）金属。它是自然界中密度最大的稳定元素，其形成的氧化物四氧化二锇（OsO₄）具有强挥发性和剧毒性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-cad1eaa9ffb0e731892120bbe3415da7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Os&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cad1eaa9ffb0e731892120bbe3415da7-e-13&quot;, &quot;chunk-1ad3d9def6416eb2826a0448d6287c6f-e-6&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-cad1eaa9ffb0e731892120bbe3415da7-e-16" label="rhodium">
        <attvalues>
          <attvalue for="0" value="rhodium" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="铑是一种化学元素，符号为Rh，原子序数为45。它是一种稀有、银白色的铂族贵金属，质地坚硬且耐腐蚀。主要用作汽车尾气催化转换器中的催化剂，以及用于制造硬度高、耐腐蚀的贵金属合金。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-cad1eaa9ffb0e731892120bbe3415da7" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cad1eaa9ffb0e731892120bbe3415da7-e-16&quot;, &quot;chunk-dddd9f3ab574da5297f93e141b49d4a6-e-1&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dddd9f3ab574da5297f93e141b49d4a6-e-6" label="turbine disc">
        <attvalues>
          <attvalue for="0" value="turbine disc" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="一种可通过粉末冶金工艺制造的关键组件。成品通常采用声波检测技术进行检验，以评估其内部结构完整性并确保使用可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-dddd9f3ab574da5297f93e141b49d4a6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-dddd9f3ab574da5297f93e141b49d4a6-e-7" label="sonic inspection">
        <attvalues>
          <attvalue for="0" value="sonic inspection" />
          <attvalue for="1" value="Inspection Method" />
          <attvalue for="2" value="声波检测是一种无损检测技术，它利用高频声波（通常是超声波）探测材料内部的缺陷。通过分析声波在工件（如涡轮盘）中传播时的反射或衰减，可以定位裂纹、夹杂等不连续性，以评估部件的结构完整性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-dddd9f3ab574da5297f93e141b49d4a6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dddd9f3ab574da5297f93e141b49d4a6-e-7&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dddd9f3ab574da5297f93e141b49d4a6-e-8" label="power-law creep">
        <attvalues>
          <attvalue for="0" value="power-law creep" />
          <attvalue for="1" value="Mechanical Phenomenon" />
          <attvalue for="2" value="幂律蠕变（Power-law creep），又称位错蠕变，是材料在高温和中等应力下的主要塑性变形机制。其核心特征是稳态蠕变速率与所施加的应力遵循幂律关系（即与应力的n次方成正比），其物理过程由位错攀移等位错运动所主导。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-dddd9f3ab574da5297f93e141b49d4a6" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Power-law creep&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dddd9f3ab574da5297f93e141b49d4a6-e-8&quot;, &quot;chunk-fbbf41abcd4950c59415caeec768db40-e-5&quot;, &quot;chunk-8e7d60876a49f4d9b2d47d88562c5c59-e-18&quot;, &quot;chunk-33a73eedd5f0ffd402fd2e071201f517-e-3&quot;, &quot;chunk-c9dadd21668b4b1a7fa3bfd8b2933c99-e-1&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="13" />
        </attvalues>
      </node>
      <node id="chunk-33a73eedd5f0ffd402fd2e071201f517-e-1" label="ultrasonic inspection of discs">
        <attvalues>
          <attvalue for="0" value="ultrasonic inspection of discs" />
          <attvalue for="1" value="Inspection Method" />
          <attvalue for="2" value="一种无损检测技术，通过向盘状部件发射高频声波（超声波），并分析其反射或透射信号，来探测材料内部及表面的裂纹、夹杂、空洞等缺陷，或测量其厚度等物理特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-33a73eedd5f0ffd402fd2e071201f517" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-33a73eedd5f0ffd402fd2e071201f517-e-1&quot;]}]" />
          <attvalue for="9" value="37" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-33a73eedd5f0ffd402fd2e071201f517-e-4" label="alloying effects">
        <attvalues>
          <attvalue for="0" value="alloying effects" />
          <attvalue for="1" value="Influencing Factor" />
          <attvalue for="2" value="合金效应（Alloying Effects）是在材料科学中，指通过向基体金属中添加一种或多种合金元素，以改变其幂律蠕变性能的综合影响。这些影响通常通过固溶强化或沉淀强化等机制，旨在提高材料在高温下的抗蠕变能力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-33a73eedd5f0ffd402fd2e071201f517" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-33a73eedd5f0ffd402fd2e071201f517-e-5" label="mechanisms of power-law creep">
        <attvalues>
          <attvalue for="0" value="mechanisms of power-law creep" />
          <attvalue for="1" value="Scientific Concept" />
          <attvalue for="2" value="指导致材料发生幂律蠕变的微观物理过程。它主要由位错运动主导，包括位错滑移，以及作为速率控制步骤、依赖原子空位扩散的位错攀移。这些机制共同决定了材料在高温和中等应力下的时间相关性形变行为。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-33a73eedd5f0ffd402fd2e071201f517" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-33a73eedd5f0ffd402fd2e071201f517-e-5&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-33a73eedd5f0ffd402fd2e071201f517-e-6" label="prediction of component service life">
        <attvalues>
          <attvalue for="0" value="prediction of component service life" />
          <attvalue for="1" value="Engineering Analysis" />
          <attvalue for="2" value="一项工程分析技术，旨在综合评估材料特性、工作载荷和环境条件，利用理论模型、仿真或试验数据，来预测零部件在特定工况下的可靠使用寿命，以指导设计、维护和保障系统安全。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-33a73eedd5f0ffd402fd2e071201f517" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="412" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-33a73eedd5f0ffd402fd2e071201f517-e-7" label="primary creep">
        <attvalues>
          <attvalue for="0" value="primary creep" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="初始蠕变是蠕变过程的第一阶段，特指单晶高温合金在低温、高应力条件下发生的物理现象。此阶段的核心特征是蠕变速率随时间逐渐降低。其研究涉及微观变形机制，并具有特定的启动阈值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-33a73eedd5f0ffd402fd2e071201f517" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-33a73eedd5f0ffd402fd2e071201f517-e-8" label="low temperature / high stress regime">
        <attvalues>
          <attvalue for="0" value="low temperature / high stress regime" />
          <attvalue for="1" value="Operating Condition" />
          <attvalue for="2" value="指单晶高温合金发生初始蠕变（primary creep）时所处的特定工况，其特征为相对较低的温度和较高的应力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-33a73eedd5f0ffd402fd2e071201f517" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-33a73eedd5f0ffd402fd2e071201f517-e-11" label="dynamics of movement of ribbon">
        <attvalues>
          <attvalue for="0" value="dynamics of movement of ribbon" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="一种解释初始蠕变微观机理的物理过程。它研究材料内部的带状缺陷（如位错带）在应力作用下的运动动力学，该微观运动是初始蠕变阶段变形的主要机制之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-33a73eedd5f0ffd402fd2e071201f517" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-33a73eedd5f0ffd402fd2e071201f517-e-12" label="shape of creep curves">
        <attvalues>
          <attvalue for="0" value="shape of creep curves" />
          <attvalue for="1" value="Characteristic" />
          <attvalue for="2" value="蠕变曲线的形状指材料在恒定应力下，其应变随时间变化的图形特征。作为主蠕变的典型特征，该阶段的曲线斜率（即蠕变速率）会随时间推移而不断减小。这反映了材料因发生应变硬化，其抵抗变形能力增强的现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-33a73eedd5f0ffd402fd2e071201f517" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-33a73eedd5f0ffd402fd2e071201f517-e-12&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-33a73eedd5f0ffd402fd2e071201f517-e-13" label="threshold for operation of primary creep">
        <attvalues>
          <attvalue for="0" value="threshold for operation of primary creep" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="指启动第一阶段蠕变所需的临界条件，通常是在特定温度下材料必须承受的最小应力值。当外部应力低于此阈值时，材料不会发生显著的蠕变变形。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-33a73eedd5f0ffd402fd2e071201f517" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-33a73eedd5f0ffd402fd2e071201f517-e-14" label="probabilistic approach to disc lifing">
        <attvalues>
          <attvalue for="0" value="probabilistic approach to disc lifing" />
          <attvalue for="1" value="Analysis Method" />
          <attvalue for="2" value="一种用于预测盘状部件（disc）使用寿命的分析方法。该方法应用概率论和统计学原理，综合考虑材料性能、载荷、制造缺陷等变量的不确定性，通过计算部件在特定时间内的失效概率，来对其可靠性和寿命进行评估，而非给出一个固定的寿命值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-33a73eedd5f0ffd402fd2e071201f517" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-33a73eedd5f0ffd402fd2e071201f517-e-14&quot;, &quot;chunk-dae9be5eb4b7208070b473c392dd0478-e-1&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-33a73eedd5f0ffd402fd2e071201f517-e-15" label="disc lifing">
        <attvalues>
          <attvalue for="0" value="disc lifing" />
          <attvalue for="1" value="Engineering Analysis" />
          <attvalue for="2" value="盘件寿命评估（Disc Lifing）是一种工程分析过程，旨在通过确定性或概率性方法，预测和评估盘状部件（尤指航空发动机涡轮盘）在特定工况下的安全服役寿命，以确保其结构完整性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-33a73eedd5f0ffd402fd2e071201f517" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-33a73eedd5f0ffd402fd2e071201f517-e-15&quot;, &quot;chunk-d3a1f3c2b5fdbd63bbdb83aac4b9a676-e-13&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-dae9be5eb4b7208070b473c392dd0478-e-10" label="gas turbine">
        <attvalues>
          <attvalue for="0" value="gas turbine" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="燃气轮机是一种以连续流动的气体为工质的内燃动力机械。它将燃料燃烧产生的热能，通过驱动涡轮叶片旋转，转化为可用的机械功。其核心部件包括压气机、燃烧室和涡轮。因其功率大、功重比高等特点，广泛应用于航空（作为喷气发动机，推进效率是其关键性能）、发电及船舶驱动领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-dae9be5eb4b7208070b473c392dd0478" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dae9be5eb4b7208070b473c392dd0478-e-12" label="radiation">
        <attvalues>
          <attvalue for="0" value="radiation" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="辐射是一种以电磁波或粒子形式传递能量的物理现象。在熔模铸造工艺中，它是一种关键的热传递方式，指高温熔融金属通过热辐射将热量传递给模具，此过程对铸件的冷却速率、凝固模式及最终的显微组织和力学性能有重要影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-dae9be5eb4b7208070b473c392dd0478" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dae9be5eb4b7208070b473c392dd0478-e-15" label="creep failure mechanism">
        <attvalues>
          <attvalue for="0" value="creep failure mechanism" />
          <attvalue for="1" value="Failure Mechanism" />
          <attvalue for="2" value="指材料在高温和持续应力作用下，随时间发生缓慢塑性变形，并最终导致断裂或功能失效的过程。它常涉及微观组织演变（如筏形化），是单晶高温合金等材料在高温服役环境下的关键失效模式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-dae9be5eb4b7208070b473c392dd0478" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Creep failure mechanism&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dae9be5eb4b7208070b473c392dd0478-e-15&quot;, &quot;chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-2&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-3" label="Rafted single crystal superalloy">
        <attvalues>
          <attvalue for="0" value="Rafted single crystal superalloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="一种单晶高温合金在高温蠕变过程中形成的特定显微组织状态。在此状态下，其原始立方形强化相会连接、长大并定向排列，形成层状的“筏排”结构。这种组织演变显著影响合金的抗蠕变性能及最终的失效机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-f9c91f67ac3e07c68ad32e0660a06ece" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;rafted single crystal superalloy&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-3&quot;, &quot;chunk-dae9be5eb4b7208070b473c392dd0478-e-16&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-7" label="Pre-straining">
        <attvalues>
          <attvalue for="0" value="Pre-straining" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;预应变（Pre-straining）是一种材料预处理工艺，指在材料正式投入使用或进入后续工序前，预先对其施加一定应变。该工艺会影响材料在后续过程中发生的筏排（Rafting）现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-f9c91f67ac3e07c68ad32e0660a06ece" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-8" label="Interfacial dislocation networks">
        <attvalues>
          <attvalue for="0" value="Interfacial dislocation networks" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="界面位错网络（Interfacial Dislocation Networks）是一种微观结构特征，指在材料（如高温合金）的两相界面处，为调节晶格错配而形成的位错网。在高温和应力下，这些位错的运动是导致γ'相定向粗化（即筏排现象）并影响蠕变性能的关键机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-f9c91f67ac3e07c68ad32e0660a06ece" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Equilibrium dislocation networks&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-4&quot;, &quot;chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-8&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-12" label="Steady-state creep">
        <attvalues>
          <attvalue for="0" value="Steady-state creep" />
          <attvalue for="1" value="Deformation Stage" />
          <attvalue for="2" value="稳态蠕变是材料蠕变变形的一个阶段，其特征是蠕变速率恒定。该现象是由于材料内部的加工硬化效应与“回复”软化效应达到了动态平衡。此阶段通常是蠕变寿命中最长的部分，对材料寿命预测至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-f9c91f67ac3e07c68ad32e0660a06ece" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-12&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-13" label="Recrystallised grains">
        <attvalues>
          <attvalue for="0" value="Recrystallised grains" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="一种材料组织特征，指在塑性变形的金属中，经热处理或热加工（如等温锻造）形成的新生、无应变的晶粒。它们具有较低的位错密度，其形成与长大过程对材料的力学性能，尤其是在稳态蠕变等高温行为中起着关键作用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-f9c91f67ac3e07c68ad32e0660a06ece" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;recrystallised grains&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-13&quot;, &quot;chunk-8c75d16dc148897cf486c21cbe30e4be-e-2&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-14" label="Heat treatment of single crystal">
        <attvalues>
          <attvalue for="0" value="Heat treatment of single crystal" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="一种针对单晶材料的热加工工艺，旨在通过精确控制加热参数，消除其内部应力、减少缺陷或均匀化成分，以优化其物理和机械性能。该工艺的关键是避免产生破坏其原有单一晶体结构的再结晶晶粒。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-f9c91f67ac3e07c68ad32e0660a06ece" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;heat treatment of single crystal casting&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f9c91f67ac3e07c68ad32e0660a06ece-e-14&quot;, &quot;chunk-8c75d16dc148897cf486c21cbe30e4be-e-3&quot;]}]" />
          <attvalue for="9" value="18" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8c75d16dc148897cf486c21cbe30e4be-e-5" label="refractories">
        <attvalues>
          <attvalue for="0" value="refractories" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="耐火材料（Refractories）是一类耐火度不低于1580℃的无机非金属材料。它们能在高温环境下抵抗物理和化学作用，保持结构和性能稳定，是构筑熔炉、窑炉内衬以及制造失蜡法铸模等高温工业应用中不可或缺的关键材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-8c75d16dc148897cf486c21cbe30e4be" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8c75d16dc148897cf486c21cbe30e4be-e-7" label="refractory metals">
        <attvalues>
          <attvalue for="0" value="refractory metals" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="难熔金属是对一类熔点极高、高温下性能稳定的金属的统称。它们具有高硬度、耐磨损和耐腐蚀的特点，典型代表为钨(W)、钼(Mo)、钽(Ta)和铌(Nb)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-8c75d16dc148897cf486c21cbe30e4be" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-bd63f78238a96a3498c5ca89d8572bea-e-3" label="Reverse partitioning effect">
        <attvalues>
          <attvalue for="0" value="Reverse partitioning effect" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="反向分配效应是镍基高温合金中的一种关键物理现象。它指合金元素铼（Re）与钨（W）等其他难熔元素相反，在凝固和时效中优先富集于γ'强化相而非γ基体。这种独特的分配行为是提升合金高温蠕变抗性和结构稳定性的重要原因。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-bd63f78238a96a3498c5ca89d8572bea" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bd63f78238a96a3498c5ca89d8572bea-e-4" label="Schmid law">
        <attvalues>
          <attvalue for="0" value="Schmid law" />
          <attvalue for="1" value="Scientific Law" />
          <attvalue for="2" value="施密特法则（Schmid law）是材料科学中描述晶体材料塑性变形的物理定律。它指出，当外力在晶体特定滑移系上产生的分切应力（resolved shear stress）达到一个临界值时，滑移便会启动，从而引发材料的塑性变形。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-bd63f78238a96a3498c5ca89d8572bea" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="413" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-bd63f78238a96a3498c5ca89d8572bea-e-5" label="Secondary reaction zone">
        <attvalues>
          <attvalue for="0" value="Secondary reaction zone" />
          <attvalue for="1" value="Technical Term" />
          <attvalue for="2" value="一个技术术语。根据上下文，该术语被收录于一部文献的索引中，其相关论述或定义位于正文第317页。此上下文未提供该术语本身的科学或技术定义。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-bd63f78238a96a3498c5ca89d8572bea" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="414" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-bd63f78238a96a3498c5ca89d8572bea-e-9" label="Segregation">
        <attvalues>
          <attvalue for="0" value="Segregation" />
          <attvalue for="1" value="Metallurgical Phenomenon" />
          <attvalue for="2" value="在材料科学中，偏析是一种物理现象，指合金等多元材料在凝固或相变过程中，因组分在不同物相中的溶解度差异，导致其化学成分在微观或宏观尺度上产生不均匀分布。枝晶偏析是其典型类型之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-bd63f78238a96a3498c5ca89d8572bea" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bd63f78238a96a3498c5ca89d8572bea-e-9&quot;, &quot;chunk-2954a9d8cd39d35e1c2ce761efb0de31-e-2&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-bd63f78238a96a3498c5ca89d8572bea-e-10" label="Dendritic segregation">
        <attvalues>
          <attvalue for="0" value="Dendritic segregation" />
          <attvalue for="1" value="Metallurgical Phenomenon" />
          <attvalue for="2" value="一种在金属合金凝固过程中发生的微观偏析现象。由于溶质在固液两相中的溶解度不同，先结晶的枝晶干与后凝固的枝晶间区域会产生组分差异，导致低熔点元素和杂质富集于枝晶间。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-bd63f78238a96a3498c5ca89d8572bea" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bd63f78238a96a3498c5ca89d8572bea-e-10&quot;, &quot;chunk-2954a9d8cd39d35e1c2ce761efb0de31-e-3&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-bd63f78238a96a3498c5ca89d8572bea-e-11" label="Homogenisation">
        <attvalues>
          <attvalue for="0" value="Homogenisation" />
          <attvalue for="1" value="Metallurgical Process" />
          <attvalue for="2" value="均匀化是一种在固溶处理(Solutioning)过程中进行的高温热处理工艺。其目的在于通过促进原子扩散，消除或减少由枝晶偏析(Dendritic segregation)所导致的合金化学成分不均匀性，从而获得均一的组织和性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-bd63f78238a96a3498c5ca89d8572bea" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bd63f78238a96a3498c5ca89d8572bea-e-11&quot;, &quot;chunk-2954a9d8cd39d35e1c2ce761efb0de31-e-4&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-bd63f78238a96a3498c5ca89d8572bea-e-12" label="Solutioning">
        <attvalues>
          <attvalue for="0" value="Solutioning" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="固溶处理（Solutioning）是一种金属热处理工艺。它通过将合金加热至高温并长时间保温，促进原子扩散，以消除金属在凝固过程中产生的枝晶偏析，最终使合金的内部组织和化学成分实现均匀化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-bd63f78238a96a3498c5ca89d8572bea" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;solutioning heat treatment&quot;, &quot;solutioning of single crystal alloys&quot;, &quot;solutioning treatment&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-bd63f78238a96a3498c5ca89d8572bea-e-12&quot;, &quot;chunk-2954a9d8cd39d35e1c2ce761efb0de31-e-5&quot;, &quot;chunk-b7b41d99b7968db6938fc41d4745dc0d-e-12&quot;, &quot;chunk-ada80b922694fd6450f48225d9ee63bb-e-7&quot;, &quot;chunk-54d9cab0bf8e738ae99d8958ce8cd086-e-3&quot;, &quot;chunk-569a3d8aec20d9df6a256b4cf4b263a7-e-13&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-2954a9d8cd39d35e1c2ce761efb0de31-e-6" label="Near net shape">
        <attvalues>
          <attvalue for="0" value="Near net shape" />
          <attvalue for="1" value="Manufacturing Goal" />
          <attvalue for="2" value="近净成形 (Near net shape) 是一种制造目标，指零件经一次成形后的几何形状已非常接近最终产品，只需少量或无需后续机加工。该技术旨在通过减少材料去除工序，来显著节约材料、能耗与生产成本。" />
          <attvalue for="3" value="{&quot;page&quot;: &quot;235&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-2954a9d8cd39d35e1c2ce761efb0de31" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="415" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-2954a9d8cd39d35e1c2ce761efb0de31-e-7" label="Shell moulds">
        <attvalues>
          <attvalue for="0" value="Shell moulds" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="壳模是熔模铸造（失蜡法）工艺中使用的关键部件。它是由耐火材料和粘合剂逐层包裹在蜡模上形成的陶瓷外壳，经脱蜡和焙烧后形成具有精密型腔的铸型，用于浇注熔融金属。" />
          <attvalue for="3" value="{&quot;page&quot;: &quot;122&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-2954a9d8cd39d35e1c2ce761efb0de31" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2954a9d8cd39d35e1c2ce761efb0de31-e-9" label="Short crack growth">
        <attvalues>
          <attvalue for="0" value="Short crack growth" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="短裂纹扩展是一种材料疲劳现象，指微小裂纹的扩展速率显著快于传统断裂力学模型（如帕里斯定律）的预测值，并且能在低于长裂纹疲劳门槛值的应力水平下发生。此现象对涡轮盘等关键部件的疲劳寿命评估至关重要。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;249, 252&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-2954a9d8cd39d35e1c2ce761efb0de31" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Short-crack growth&quot;, &quot;short crack growth&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-2954a9d8cd39d35e1c2ce761efb0de31-e-9&quot;, &quot;chunk-cbf4d780dd2a841aa5348c2c70b0276f-e-1&quot;, &quot;chunk-0312a7fa360bfa79c9a28fd422e8b92f-e-10&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-2954a9d8cd39d35e1c2ce761efb0de31-e-10" label="Sigma phase">
        <attvalues>
          <attvalue for="0" value="Sigma phase" />
          <attvalue for="1" value="Metallurgical Phenomenon" />
          <attvalue for="2" value="σ相析出是一种冶金现象，指在不锈钢、高温合金等含铬合金中，因长时间处于特定高温范围而析出的富铬、硬脆的σ金属间相。它的形成会显著降低材料的韧性、延展性和耐腐蚀性，降低铬含量可有效抑制其析出敏感性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-2954a9d8cd39d35e1c2ce761efb0de31" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;σ formation&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-44a103d3439804fea5910e3206b26742-e-4&quot;, &quot;chunk-2954a9d8cd39d35e1c2ce761efb0de31-e-10&quot;]}]" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2954a9d8cd39d35e1c2ce761efb0de31-e-12" label="Superalloy single crystals">
        <attvalues>
          <attvalue for="0" value="Superalloy single crystals" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="高温合金单晶是一种由单一晶粒构成的先进材料。因完全消除了作为薄弱环节的晶界，它在高温下具有卓越的抗蠕变和抗疲劳性能，同时因其晶体结构而表现出显著的弹性各向异性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-2954a9d8cd39d35e1c2ce761efb0de31" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-dcabec43f1f2206a87597ccc217e55d1-e-3" label="fatigue">
        <attvalues>
          <attvalue for="0" value="fatigue" />
          <attvalue for="1" value="Mechanical Failure Mode" />
          <attvalue for="2" value="在材料科学中，疲劳是一种机械失效模式。它指材料在远低于其静态强度的循环载荷作用下，因内部滑移带的形成与发展，导致微裂纹萌生和扩展，并最终引发突然断裂的现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-dcabec43f1f2206a87597ccc217e55d1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dcabec43f1f2206a87597ccc217e55d1-e-4" label="sodium sulphate">
        <attvalues>
          <attvalue for="0" value="sodium sulphate" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="硫酸钠 (Na₂SO₄)，是一种由硫酸根与钠离子结合生成的无机盐。作为一种重要的化工原料，它被广泛用于制造洗涤剂、纸张和玻璃等。在高温环境下，熔融的硫酸钠是导致金属发生热腐蚀的主要介质之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-dcabec43f1f2206a87597ccc217e55d1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dcabec43f1f2206a87597ccc217e55d1-e-6" label="cyclic softening">
        <attvalues>
          <attvalue for="0" value="cyclic softening" />
          <attvalue for="1" value="Mechanical Behavior" />
          <attvalue for="2" value="循环软化是一种材料力学行为，指单晶高温合金等材料在循环载荷作用下，其循环应力响应（通常表现为应力幅）随循环次数的增加而持续降低的现象。该行为表明材料的循环变形抗力逐渐减弱，是影响其疲劳寿命的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-dcabec43f1f2206a87597ccc217e55d1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dcabec43f1f2206a87597ccc217e55d1-e-8" label="solidification behaviour">
        <attvalues>
          <attvalue for="0" value="solidification behaviour" />
          <attvalue for="1" value="Material Behavior" />
          <attvalue for="2" value="凝固行为是指材料从液态向固态转变过程中的一系列物理和化学现象。它决定了材料最终的微观结构、相组成和性能，涉及形核、沿优先生长方向的晶体生长（如竞争生长）等关键机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-dcabec43f1f2206a87597ccc217e55d1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dcabec43f1f2206a87597ccc217e55d1-e-8&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-dcabec43f1f2206a87597ccc217e55d1-e-9" label="competitive growth">
        <attvalues>
          <attvalue for="0" value="competitive growth" />
          <attvalue for="1" value="Mechanism" />
          <attvalue for="2" value="一种晶体生长机制，常见于高温合金的定向凝固过程。指具有有利晶体学取向的晶粒，在生长中凭借速率优势淘汰取向不利的晶粒，从而获得具有特定择优取向（如柱状晶或单晶）显微组织的过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-dcabec43f1f2206a87597ccc217e55d1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dcabec43f1f2206a87597ccc217e55d1-e-9&quot;, &quot;chunk-b7b41d99b7968db6938fc41d4745dc0d-e-1&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dcabec43f1f2206a87597ccc217e55d1-e-10" label="preferred growth direction">
        <attvalues>
          <attvalue for="0" value="preferred growth direction" />
          <attvalue for="1" value="Crystallographic Property" />
          <attvalue for="2" value="优先生长方向是一种晶体学性质，指在凝固过程中，晶体因其内在的各向异性，沿特定晶体学方向（如&lt;100&gt;）优先快速生长的趋势。这种现象是凝固行为的一个关键方面，它决定了枝晶的取向，并显著影响材料的最终微观结构与性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-dcabec43f1f2206a87597ccc217e55d1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-dcabec43f1f2206a87597ccc217e55d1-e-10&quot;, &quot;chunk-b7b41d99b7968db6938fc41d4745dc0d-e-2&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-dcabec43f1f2206a87597ccc217e55d1-e-11" label="guidelines for development of superalloys">
        <attvalues>
          <attvalue for="0" value="guidelines for development of superalloys" />
          <attvalue for="1" value="Methodology" />
          <attvalue for="2" value="一套指导高温合金开发的系统性方法论。该方法论将晶格错配（lattice misfit）视为核心设计参数，用以优化合金的微观结构稳定性与高温力学性能，从而指导材料的成分设计与工艺开发。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-dcabec43f1f2206a87597ccc217e55d1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-dcabec43f1f2206a87597ccc217e55d1-e-13" label="optimisation of composition">
        <attvalues>
          <attvalue for="0" value="optimisation of composition" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种材料设计过程，通过计算模拟或实验方法，系统地调整高温合金的化学元素种类与比例，旨在获得最优的高温强度、抗蠕变及抗氧化等综合性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-dcabec43f1f2206a87597ccc217e55d1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b7b41d99b7968db6938fc41d4745dc0d-e-4" label="modelling of growth of isolated dendrite">
        <attvalues>
          <attvalue for="0" value="modelling of growth of isolated dendrite" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种数值模拟过程，旨在通过计算固液界面的运动和演化，来预测和研究孤立枝晶在凝固过程中的生长形态与动力学特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-b7b41d99b7968db6938fc41d4745dc0d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="125" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b7b41d99b7968db6938fc41d4745dc0d-e-5" label="isolated dendrite">
        <attvalues>
          <attvalue for="0" value="isolated dendrite" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="孤立枝晶是一种微观结构特征，指在材料凝固过程中，单个独立生长且形态不受相邻晶粒影响的树枝状晶体。由于其生长环境相对简单，常作为研究晶体生长动力学理论和数值模拟的理想模型。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-b7b41d99b7968db6938fc41d4745dc0d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="125" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b7b41d99b7968db6938fc41d4745dc0d-e-6" label="solid/liquid interface motion">
        <attvalues>
          <attvalue for="0" value="solid/liquid interface motion" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="固液界面运动是在熔化、凝固等相变过程中，固相与液相分界面的动态演变。该现象是理解和模拟材料微观结构（如枝晶）形成与演化的关键物理过程，在材料科学和凝聚态物理中具有重要意义。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-b7b41d99b7968db6938fc41d4745dc0d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b7b41d99b7968db6938fc41d4745dc0d-e-6&quot;]}]" />
          <attvalue for="9" value="125" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b7b41d99b7968db6938fc41d4745dc0d-e-8" label="solid solution strengthening">
        <attvalues>
          <attvalue for="0" value="solid solution strengthening" />
          <attvalue for="1" value="Mechanism" />
          <attvalue for="2" value="固溶强化是一种材料强化机制。通过将合金元素（溶质原子）融入基体金属的晶格中形成固溶体，溶质原子造成晶格畸变，其产生的应力场会阻碍位错运动，从而提高材料的屈服强度和硬度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-b7b41d99b7968db6938fc41d4745dc0d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="416" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-b7b41d99b7968db6938fc41d4745dc0d-e-9" label="solubility of solutes in nickel">
        <attvalues>
          <attvalue for="0" value="solubility of solutes in nickel" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一项材料属性，指在特定温度和压力下，一种或多种溶质（如其他金属或非金属元素）在溶剂镍中达到饱和状态时所能溶解的最大量。它决定了镍基合金的成分范围与相结构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-b7b41d99b7968db6938fc41d4745dc0d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b7b41d99b7968db6938fc41d4745dc0d-e-10" label="solutes">
        <attvalues>
          <attvalue for="0" value="solutes" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="溶质，指在溶液中被溶剂溶解的物质。在此上下文中，特指溶解在作为溶剂的金属镍中的其他元素或化合物，其在镍中的溶解度是其一项关键属性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-b7b41d99b7968db6938fc41d4745dc0d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b7b41d99b7968db6938fc41d4745dc0d-e-13" label="gamma prime dissolution">
        <attvalues>
          <attvalue for="0" value="gamma prime dissolution" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="一种在固溶热处理工艺中发生的物理冶金过程，指高温合金中的γ'强化相重新溶入金属基体。该过程需要在特定工艺窗口内精确控制，是后续时效处理和优化材料最终性能的关键步骤。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-b7b41d99b7968db6938fc41d4745dc0d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b7b41d99b7968db6938fc41d4745dc0d-e-13&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-be2e5714ffd15b4d499890769149ecb3-e-2" label="industrial practice">
        <attvalues>
          <attvalue for="0" value="industrial practice" />
          <attvalue for="1" value="Topic" />
          <attvalue for="2" value="工业实践 (Industrial Practice) 是指将科学理论、工程技术与管理知识应用于实际工业生产、制造和运营环境中的一系列具体活动和方法。它注重解决现实问题，涉及工艺流程、质量控制、安全管理等方面，旨在提高生产效率、保证产品质量和优化成本。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;272-273&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-be2e5714ffd15b4d499890769149ecb3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="417" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-be2e5714ffd15b4d499890769149ecb3-e-3" label="overview">
        <attvalues>
          <attvalue for="0" value="overview" />
          <attvalue for="1" value="Section" />
          <attvalue for="2" value="源文本中题为“overview”的一个章节，具体内容位于第271-274页。该章节旨在对全文或特定主题进行概括性介绍与总结，为读者提供一个总体性框架和背景信息。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;271-274&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-be2e5714ffd15b4d499890769149ecb3" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="418" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-be2e5714ffd15b4d499890769149ecb3-e-8" label="Pure Nickel">
        <attvalues>
          <attvalue for="0" value="Pure Nickel" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="纯镍是一种化学元素（Ni），为银白色铁磁性金属，具有面心立方晶体结构。它拥有良好的延展性和耐腐蚀性，其层错能是决定其在塑性变形过程中的微观结构演变和宏观力学行为的关键物理参数。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;58&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-be2e5714ffd15b4d499890769149ecb3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Pure nickel&quot;, &quot;pure nickel&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-be2e5714ffd15b4d499890769149ecb3-e-8&quot;, &quot;chunk-7319e10c21751146ade723f5be6c80d4-e-2&quot;, &quot;chunk-acebf0b59de1a04e5bd5c03c23e7d583-e-3&quot;, &quot;chunk-d4ec865719f1815d38483ef812cf9ed2-e-1&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="8" />
        </attvalues>
      </node>
      <node id="chunk-be2e5714ffd15b4d499890769149ecb3-e-10" label="extrinsic stacking fault">
        <attvalues>
          <attvalue for="0" value="extrinsic stacking fault" />
          <attvalue for="1" value="Planar Defect" />
          <attvalue for="2" value="外禀堆垛层错（Extrinsic Stacking Faults）是一种晶体面缺陷，指在规则的原子堆垛序列中，因插入一个额外的原子面而造成的局部堆垛次序错误。它相当于在晶格中增加了一个原子层，破坏了原有周期性，例如在面心立方结构中将...ABCABC...序列变为...ABCACBC...。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;55&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-be2e5714ffd15b4d499890769149ecb3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;extrinsic stacking faults&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9108d08e6e7d916cfb35fde79b233c67-e-7&quot;, &quot;chunk-be2e5714ffd15b4d499890769149ecb3-e-10&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-be2e5714ffd15b4d499890769149ecb3-e-11" label="intrinsic stacking fault">
        <attvalues>
          <attvalue for="0" value="intrinsic stacking fault" />
          <attvalue for="1" value="Planar Defect" />
          <attvalue for="2" value="内禀层错是一种存在于伽马相(gamma phase)中的平面晶体缺陷。它通常因晶体结构中缺少一个原子层而产生，导致晶面正常的堆垛顺序（如ABCABC...）被破坏，形成局部错误序列（如ABCACABC...）。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;55&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-be2e5714ffd15b4d499890769149ecb3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Intrinsic stacking fault in γ&quot;, &quot;Intrinsic stacking faults&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9108d08e6e7d916cfb35fde79b233c67-e-6&quot;, &quot;chunk-be2e5714ffd15b4d499890769149ecb3-e-11&quot;, &quot;chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-10&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-be2e5714ffd15b4d499890769149ecb3-e-13" label="Superlattice Extrinsic Stacking Fault (SESF)">
        <attvalues>
          <attvalue for="0" value="Superlattice Extrinsic Stacking Fault (SESF)" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="SESF，全称超晶格外禀层错（Superlattice Extrinsic Stacking Fault），是一种存在于超晶格结构中的晶体缺陷。它作为一种在{111}晶面上发生的位错分解机制，通过改变原子堆垛顺序来影响材料的力学性能。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;70&quot;}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-be2e5714ffd15b4d499890769149ecb3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;SESF&quot;, &quot;superlattice extrinsic stacking fault (SESF)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-be2e5714ffd15b4d499890769149ecb3-e-13&quot;, &quot;chunk-988dabd61f21e6f460ff885a9055c6a6-e-11&quot;, &quot;chunk-e69ec61e4ba33a69deaed5cb75487264-e-1&quot;, &quot;chunk-cb76da6f86e534b7b2a34ae7c293d1f0-e-4&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-be2e5714ffd15b4d499890769149ecb3-e-14" label="Superlattice intrinsic stacking fault (SISF)">
        <attvalues>
          <attvalue for="0" value="Superlattice intrinsic stacking fault (SISF)" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="超晶格内禀层错（Superlattice Intrinsic Stacking Fault, SISF）是一种晶体缺陷。其结构特点是不产生最近邻原子错配（nearest-neighbour violations），因此具有较低的层错能（fault energy）。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;69&quot;}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-be2e5714ffd15b4d499890769149ecb3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;SISF&quot;, &quot;SISF fault&quot;, &quot;superlattice intrinsic stacking fault (SISF)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-be2e5714ffd15b4d499890769149ecb3-e-14&quot;, &quot;chunk-988dabd61f21e6f460ff885a9055c6a6-e-7&quot;, &quot;chunk-cb76da6f86e534b7b2a34ae7c293d1f0-e-3&quot;, &quot;chunk-73d5b71bcd1ef30ab316c29ee8b4abf6-e-9&quot;, &quot;chunk-dc5958ae6c6275575fd05993164bcb7f-e-1&quot;, &quot;chunk-e69ec61e4ba33a69deaed5cb75487264-e-4&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="10" />
        </attvalues>
      </node>
      <node id="chunk-be2e5714ffd15b4d499890769149ecb3-e-16" label="Strengthening effects">
        <attvalues>
          <attvalue for="0" value="Strengthening effects" />
          <attvalue for="1" value="Topic" />
          <attvalue for="2" value="强化效应是一种材料属性，指通过在晶体中引入障碍物（如溶质原子、晶界等）以阻碍位错运动，从而提高材料抵抗塑性变形能力的现象。该效应能显著增加材料的屈服强度和硬度，是改善金属力学性能的核心原理，其具体类型包括反常屈服效应等。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;73-90&quot;}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-be2e5714ffd15b4d499890769149ecb3" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;strengthening effects&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-be2e5714ffd15b4d499890769149ecb3-e-16&quot;, &quot;chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-1&quot;, &quot;chunk-3ca2e169452aac1fe72512e4665d8d85-e-8&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-6" label="Peak strength">
        <attvalues>
          <attvalue for="0" value="Peak strength" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="峰值强度 (Peak strength) 是指一个系统在耦合状态从弱耦合过渡到强耦合的临界点时，所能达到的最大强度值。它标志着两种不同耦合状态转换的关键时刻。" />
          <attvalue for="3" value="{&quot;page_numbers&quot;: &quot;81&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-d6e744ceeb4078f9ef25397d9a3c586a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="241" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-7" label="Transition from weak to strong coupling">
        <attvalues>
          <attvalue for="0" value="Transition from weak to strong coupling" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="一种临界现象，指两个或多个相互作用的系统，其耦合强度由弱变强。该转变的标志是耦合强度达到峰值，此时系统间的能量交换和行为影响最为显著，并常导致系统整体性质发生根本性改变。" />
          <attvalue for="3" value="{&quot;page_numbers&quot;: &quot;81&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d6e744ceeb4078f9ef25397d9a3c586a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="241" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-9" label="Strongly coupled dislocations">
        <attvalues>
          <attvalue for="0" value="Strongly coupled dislocations" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="强耦合位错是材料科学中的一种强化机制，指位错以“位错对”的形式协同切过析出相的现象。其成因是前导位错在析出相中产生高能界面（如反相畴界），尾随位错的运动可消除该界面以降低能量，因此二者倾向于成对运动。" />
          <attvalue for="3" value="{&quot;page_numbers&quot;: &quot;78-81&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-d6e744ceeb4078f9ef25397d9a3c586a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-9&quot;, &quot;chunk-af1f9e9d18ac9effde532d2b56262cf6-e-7&quot;, &quot;chunk-2a630be2b8090ec92842cc9c1737eb42-e-1&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-10" label="Temperature dependence of strengthening">
        <attvalues>
          <attvalue for="0" value="Temperature dependence of strengthening" />
          <attvalue for="1" value="Property Relationship" />
          <attvalue for="2" value="一种材料学属性关系，描述材料的强度（如屈服强度、硬度）随温度变化的规律。通常，多数强化机制在低温时更有效，而在高温下，热激活过程（如回复、再结晶）会使其减弱或失效，导致材料发生软化。" />
          <attvalue for="3" value="{&quot;page_numbers&quot;: &quot;81-86&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-d6e744ceeb4078f9ef25397d9a3c586a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="419" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-11" label="Weakly coupled dislocations">
        <attvalues>
          <attvalue for="0" value="Weakly coupled dislocations" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="在材料科学中，弱耦合位错指构成超位错的领先位错与滞后位错之间相互作用力较弱的一种状态。当其与析出相等障碍物作用时，领先位错会独立地在障碍物间发生弓出。这种行为是沉淀强化理论中的一种关键机制，它决定了位错克服障碍物的方式，从而影响材料的屈服强度。" />
          <attvalue for="3" value="{&quot;page_numbers&quot;: &quot;75-78&quot;}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-d6e744ceeb4078f9ef25397d9a3c586a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;'weakly coupled' dislocations&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-11&quot;, &quot;chunk-41c4572391c7a506f02a50c6ea737ecc-e-7&quot;, &quot;chunk-6c8bf2ccc7af91368e39bedeb76382ef-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-12" label="Stress analysis">
        <attvalues>
          <attvalue for="0" value="Stress analysis" />
          <attvalue for="1" value="Topic" />
          <attvalue for="2" value="应力分析是固体力学中的核心领域，通过分析和计算，确定构件在载荷、温度变化（如热处理）等因素作用下的内部应力、应变和变形。其目的是评估结构（如旋转盘）的强度、刚度和稳定性，以确保其安全可靠。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-d6e744ceeb4078f9ef25397d9a3c586a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-14" label="Rotating disc">
        <attvalues>
          <attvalue for="0" value="Rotating disc" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="旋转盘是一种围绕中心轴旋转的圆形机械组件。对其进行应力分析，旨在确定由离心力引起的内部应力分布，从而评估其强度、确保结构完整性与运行安全。" />
          <attvalue for="3" value="{&quot;page_numbers&quot;: &quot;259, 260&quot;}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-d6e744ceeb4078f9ef25397d9a3c586a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-15" label="Stress ratio R">
        <attvalues>
          <attvalue for="0" value="Stress ratio R" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="应力比R (Stress Ratio R) 是一个关键的无量纲力学参数，用于表征疲劳分析中的循环载荷特性。它定义为一个应力周期内的最小应力（σ_min）与最大应力（σ_max）之比。R值是决定材料疲劳性能和寿命的核心因素之一。" />
          <attvalue for="3" value="{&quot;page_numbers&quot;: &quot;188&quot;}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-d6e744ceeb4078f9ef25397d9a3c586a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Load Ratio (R)&quot;, &quot;R-ratio&quot;, &quot;R-ratios&quot;, &quot;stress ratio R&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a5192ee579410694b4542905f037961f-e-8&quot;, &quot;chunk-b8f64fb156fdeb0f33d3fd48ce26370d-e-6&quot;, &quot;chunk-0c0cb15f0b332db0e8b9015221af9b16-e-5&quot;, &quot;chunk-8a91b63add4adbc77d4752d41b7c75aa-e-10&quot;, &quot;chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-15&quot;, &quot;chunk-0625d83d7200f989528119d9ba61865a-e-2&quot;]}]" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-17" label="Stress rupture strength">
        <attvalues>
          <attvalue for="0" value="Stress rupture strength" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="应力断裂强度（Stress Rupture Strength），又称持久强度，是衡量材料高温力学性能的关键指标。它指材料在恒定高温和应力作用下，经过规定时间发生断裂时的最大应力值，反映了材料在高温下抵抗长期载荷的能力。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-17" />
          <attvalue for="5" value="chunk-d6e744ceeb4078f9ef25397d9a3c586a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;stress rupture strength&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-d6e744ceeb4078f9ef25397d9a3c586a-e-17&quot;, &quot;chunk-0625d83d7200f989528119d9ba61865a-e-4&quot;]}]" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0625d83d7200f989528119d9ba61865a-e-1" label="isc">
        <attvalues>
          <attvalue for="0" value="isc" />
          <attvalue for="1" value="Technical Term" />
          <attvalue for="2" value="isc是一个多义的技术术语缩写。最常见的含义指：1) Internet Systems Consortium（互联网系统协会），负责开发和维护BIND等核心互联网协议软件的非营利组织；2) (ISC)²（国际信息系统安全认证联盟），提供CISSP等全球公认网络安全专业认证的权威机构。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;259, 260&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-0625d83d7200f989528119d9ba61865a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="420" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-0625d83d7200f989528119d9ba61865a-e-6" label="single crystals">
        <attvalues>
          <attvalue for="0" value="single crystals" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="单晶是一种宏观上由单一、连续晶格构成的晶体材料形态，其内部不存在晶界。由于消除了晶界这一在高温下的结构弱点，单晶材料通常具有极为优异的应力断裂强度和抗蠕变性能。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;127, 130&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0625d83d7200f989528119d9ba61865a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="421" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-0625d83d7200f989528119d9ba61865a-e-8" label="instability">
        <attvalues>
          <attvalue for="0" value="instability" />
          <attvalue for="1" value="Material Condition" />
          <attvalue for="2" value="一种材料状态，指材料在高温和应力长期作用下，其微观组织发生变化（如相变、析出相粗化），进而导致其应力断裂强度等力学性能劣化的现象，是影响材料高温服役寿命的关键因素。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;159&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-0625d83d7200f989528119d9ba61865a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="20" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0625d83d7200f989528119d9ba61865a-e-9" label="sub-grain structure">
        <attvalues>
          <attvalue for="0" value="sub-grain structure" />
          <attvalue for="1" value="Microstructural Feature" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;亚晶结构是晶粒内部的一种显微组织，由多个晶体学取向略有差异的亚晶粒构成，彼此被小角度晶界分隔。它通常在材料塑性变形和回复过程中，因位错重排而形成，能有效提高材料的强度和韧性。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;92, 93&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-0625d83d7200f989528119d9ba61865a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="422" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-0625d83d7200f989528119d9ba61865a-e-10" label="sulphates">
        <attvalues>
          <attvalue for="0" value="sulphates" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="硫酸盐是含有硫酸根离子(SO₄²⁻)的化合物。在高温环境中，熔融的硫酸盐（尤其是碱金属硫酸盐）能够破坏金属表面的保护性氧化膜，是引发热腐蚀攻击的关键因素。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;165-170&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-0625d83d7200f989528119d9ba61865a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0625d83d7200f989528119d9ba61865a-e-17" label="nickel-base superalloys">
        <attvalues>
          <attvalue for="0" value="nickel-base superalloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍基高温合金是一类以镍为基体，能在650°C以上高温下保持高强度、优良抗蠕变和抗腐蚀性能的金属材料。常通过添加铬、钴、钽等多种合金元素来进一步强化其综合性能，是制造航空发动机和燃气轮机热端部件的关键材料。" />
          <attvalue for="3" value="{&quot;pages&quot;: &quot;20, 25, 34-35, 39, 43&quot;}" />
          <attvalue for="4" value="e-17" />
          <attvalue for="5" value="chunk-0625d83d7200f989528119d9ba61865a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3b4422ce09cd66eaf6abd58690d6f8ef-e-3" label="nickel-base superalloys">
        <attvalues>
          <attvalue for="0" value="nickel-base superalloys" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="镍基高温合金是一种以镍为基体，添加了铬、钴、钽等多种元素的高性能合金。它能在高温和应力下保持优异的强度、抗蠕变和抗腐蚀性能，是制造航空发动机、燃气轮机等热端部件的关键材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-3b4422ce09cd66eaf6abd58690d6f8ef" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3b4422ce09cd66eaf6abd58690d6f8ef-e-4" label="temperature anomaly of flow stress">
        <attvalues>
          <attvalue for="0" value="temperature anomaly of flow stress" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="指某些材料（特别是Ni₃Al等金属间化合物）在特定温度区间内，其流变应力随温度升高不降反升的反常现象。这种行为与大多数金属材料的热软化效应相反，通常由热激活的位错锁定机制引起。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-3b4422ce09cd66eaf6abd58690d6f8ef" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="26" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3b4422ce09cd66eaf6abd58690d6f8ef-e-10" label="alloying">
        <attvalues>
          <attvalue for="0" value="alloying" />
          <attvalue for="1" value="Metallurgical Process" />
          <attvalue for="2" value="合金化（Alloying）是一种冶金过程，通过将一种金属与一种或多种其他元素（金属或非金属）熔合以形成合金。该过程旨在改变基体金属的物理或化学性能，例如调整其熔点、提高硬度或增强耐腐蚀性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-3b4422ce09cd66eaf6abd58690d6f8ef" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3b4422ce09cd66eaf6abd58690d6f8ef-e-13" label="Incipient melting (thermodynamic definition)">
        <attvalues>
          <attvalue for="0" value="Incipient melting (thermodynamic definition)" />
          <attvalue for="1" value="Thermodynamic Property" />
          <attvalue for="2" value="初熔是一种热力学性质，指物质从固态加热时，开始转变为液态并出现第一滴液体的温度。它标志着熔融过程的起始点，对于合金等多组分系统，该温度也称为固相线温度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-3b4422ce09cd66eaf6abd58690d6f8ef" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;incipient melting&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-3b4422ce09cd66eaf6abd58690d6f8ef-e-13&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-3b4422ce09cd66eaf6abd58690d6f8ef-e-15" label="temperature capability">
        <attvalues>
          <attvalue for="0" value="temperature capability" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="一种材料属性，指材料在高温环境中维持其关键物理、化学性能并可靠工作的能力。它是衡量材料热稳定性的重要指标，通常用材料所能承受的最高工作温度来表示。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-3b4422ce09cd66eaf6abd58690d6f8ef" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-502aba15d381acd1fe322927c6f750ed-e-7" label="tension-compression asymmetry">
        <attvalues>
          <attvalue for="0" value="tension-compression asymmetry" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="拉压不对称性 (Tension-Compression Asymmetry) 是一种材料力学特性，指材料在承受拉伸与压缩载荷时，其屈服强度等力学性能表现出显著差异。这种现象在γ'相合金等先进材料中尤为突出。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-502aba15d381acd1fe322927c6f750ed" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-502aba15d381acd1fe322927c6f750ed-e-11" label="micromechanism of deformation">
        <attvalues>
          <attvalue for="0" value="micromechanism of deformation" />
          <attvalue for="1" value="Scientific Concept" />
          <attvalue for="2" value="变形微观机制（Micromechanism of Deformation）是一种在微观尺度上阐释材料宏观变形内在原因的科学概念。它用于揭示特定材料（如单晶高温合金）在第三蠕变阶段发生加速变形并最终失效的根本物理机理。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-502aba15d381acd1fe322927c6f750ed" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-502aba15d381acd1fe322927c6f750ed-e-11&quot;, &quot;chunk-33a73eedd5f0ffd402fd2e071201f517-e-10&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-502aba15d381acd1fe322927c6f750ed-e-13" label="Burner rig">
        <attvalues>
          <attvalue for="0" value="Burner rig" />
          <attvalue for="1" value="Test Equipment" />
          <attvalue for="2" value="燃烧器试验台（Burner rigs）是一种通过产生高速高温燃气射流，来模拟发动机等恶劣服役环境的测试设备。它主要用于对热障涂层（TBC）等材料的样品进行热循环和耐久性评估，以测试其高温性能和寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-502aba15d381acd1fe322927c6f750ed" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Burner rigs&quot;, &quot;burner rig&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-897e7353863e7f334da90636833fd561-e-10&quot;, &quot;chunk-5423bf2afd28acca7cc612d33b8885b0-e-2&quot;, &quot;chunk-502aba15d381acd1fe322927c6f750ed-e-13&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-502aba15d381acd1fe322927c6f750ed-e-14" label="Nondestructive testing (NDT)">
        <attvalues>
          <attvalue for="0" value="Nondestructive testing (NDT)" />
          <attvalue for="1" value="Test Method" />
          <attvalue for="2" value="无损检测（Nondestructive Testing, NDT）指在不损害或不影响被检测对象使用性能的前提下，利用物理或化学方法，对材料、构件或设备的内部及表面结构、性质或缺陷进行检查与评估的技术总称。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-502aba15d381acd1fe322927c6f750ed" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;nondestructive testing&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-502aba15d381acd1fe322927c6f750ed-e-14&quot;]}]" />
          <attvalue for="9" value="423" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-502aba15d381acd1fe322927c6f750ed-e-16" label="rare earth additions">
        <attvalues>
          <attvalue for="0" value="rare earth additions" />
          <attvalue for="1" value="Material Additive" />
          <attvalue for="2" value="稀土添加物 (rare earth additions) 是一类用作材料添加剂的稀土元素或其化合物。它们通常作为掺杂剂或稳定剂，被引入氧化钇稳定氧化锆(YSZ)等基体材料中，用以调控并优化材料的相稳定性、离子电导率、热学或力学等关键性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-502aba15d381acd1fe322927c6f750ed" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;RE additions&quot;, &quot;Rare earth additions&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0e56d036a3d2e550af5ea66665ba607a-e-5&quot;, &quot;chunk-502aba15d381acd1fe322927c6f750ed-e-16&quot;, &quot;chunk-ea2d68ee6ba96502ab007d093c1ef915-e-3&quot;, &quot;chunk-e4ee2b4726b7ab716e9f01d209b1fd11-e-7&quot;, &quot;chunk-db7cc890c68f0a43d000b2dba6ecf910-e-2&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-ea2d68ee6ba96502ab007d093c1ef915-e-1" label="Barrier coatings">
        <attvalues>
          <attvalue for="0" value="Barrier coatings" />
          <attvalue for="1" value="Material Coating" />
          <attvalue for="2" value="障涂层（Barrier coatings）是一种先进的材料涂层系统，通常由低热导率的陶瓷材料构成，用于为基体提供隔热保护。其性能和寿命受到加工工艺、粘结层成分及微观形貌的影响，而热生长氧化物是导致其失效的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-ea2d68ee6ba96502ab007d093c1ef915" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-ea2d68ee6ba96502ab007d093c1ef915-e-5" label="Failure mechanisms">
        <attvalues>
          <attvalue for="0" value="Failure mechanisms" />
          <attvalue for="1" value="Phenomenon" />
          <attvalue for="2" value="失效机制是指导致防护涂层丧失其保护性能的具体物理或化学过程。在阻隔涂层领域，这通常包括因腐蚀、开裂、起泡、分层或环境侵蚀导致的涂层降解，最终使被保护的基材暴露于有害环境中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ea2d68ee6ba96502ab007d093c1ef915" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ea2d68ee6ba96502ab007d093c1ef915-e-7" label="Morphologies">
        <attvalues>
          <attvalue for="0" value="Morphologies" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="一种物理属性，指阻隔涂层在微观和宏观尺度上的结构形态与外形。它包括材料的晶相、颗粒分布、表面形貌等，是决定涂层阻隔性能与耐久性的关键特征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-ea2d68ee6ba96502ab007d093c1ef915" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ea2d68ee6ba96502ab007d093c1ef915-e-8" label="Processing">
        <attvalues>
          <attvalue for="0" value="Processing" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="指阻隔涂层的制造或应用工艺。此过程涵盖从涂层材料的生产、配制，到最终将其施加于基材以形成功能性薄膜的所有技术步骤。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-ea2d68ee6ba96502ab007d093c1ef915" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ea2d68ee6ba96502ab007d093c1ef915-e-9" label="Bond coat composition">
        <attvalues>
          <attvalue for="0" value="Bond coat composition" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="指在热障涂层等防护涂层体系中，金属粘结层的化学元素构成及比例。此材料属性直接决定了涂层的结合强度与抗高温氧化能力，并通过形成稳定的氧化物保护层，影响整个系统的服役寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-ea2d68ee6ba96502ab007d093c1ef915" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ea2d68ee6ba96502ab007d093c1ef915-e-11" label="Segmentation cracking">
        <attvalues>
          <attvalue for="0" value="Segmentation cracking" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="分段开裂（Segmentation cracking）是阻隔涂层的一种失效模式，其特征是因热失配等应力作用，涂层内部产生贯穿厚度的网状裂纹，将涂层分割成多个独立的块状区域，最终破坏涂层的完整性和保护功能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-ea2d68ee6ba96502ab007d093c1ef915" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;segmentation cracking&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ea2d68ee6ba96502ab007d093c1ef915-e-11&quot;, &quot;chunk-2555e274f1223f9245526a48267868ff-e-15&quot;, &quot;chunk-e039cb317db23e5137b0d2d1164a7ea9-e-2&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-23df60e783372fb64b1a5a9966ec4edc-e-3" label="Thermal Insulation">
        <attvalues>
          <attvalue for="0" value="Thermal Insulation" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="热绝缘（Thermal Insulation）是一种物理性质，指材料能够减少或阻止热量在不同区域间传递的能力。它通过阻碍热传导、热对流或热辐射来实现热量隔离，是热生长氧化物等绝缘材料的关键特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-23df60e783372fb64b1a5a9966ec4edc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="9" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-23df60e783372fb64b1a5a9966ec4edc-e-5" label="Coating Performance">
        <attvalues>
          <attvalue for="0" value="Coating Performance" />
          <attvalue for="1" value="Metric" />
          <attvalue for="2" value="一项用于评估涂层有效性与耐久性的综合指标。它重点衡量涂层在经受热循环（反复高低温变化）等应力后，其附着力、抗裂性等关键特性的保持能力或退化程度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-23df60e783372fb64b1a5a9966ec4edc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-23df60e783372fb64b1a5a9966ec4edc-e-12" label="Gamma Prime Strengthener">
        <attvalues>
          <attvalue for="0" value="Gamma Prime Strengthener" />
          <attvalue for="1" value="Role" />
          <attvalue for="2" value="一种材料强化角色，通常由钛、铝等合金元素扮演。它通过在合金基体中促进有序的γ'相（伽马撇相）弥散析出，有效阻碍位错运动，从而显著提高材料（尤其是高温合金）的高温强度与抗蠕变性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-23df60e783372fb64b1a5a9966ec4edc" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;gamma prime strengthener&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-23df60e783372fb64b1a5a9966ec4edc-e-12&quot;, &quot;chunk-0440023a44a202881a859e66f23ec3de-e-1&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-23df60e783372fb64b1a5a9966ec4edc-e-13" label="Oxidation Resistance">
        <attvalues>
          <attvalue for="0" value="Oxidation Resistance" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="抗氧化性是一种材料性能，指其在含氧环境中抵抗因化学反应导致性能退化或腐蚀的能力。在某些材料体系中，钛（Ti）元素的存在会对该性能产生负面影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-23df60e783372fb64b1a5a9966ec4edc" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-58ee51f26d85456c13aa639ae170ab36-e-3" label="cooling passages">
        <attvalues>
          <attvalue for="0" value="cooling passages" />
          <attvalue for="1" value="Feature" />
          <attvalue for="2" value="一种设置在涡轮叶片等高温部件内部的复杂通道或型腔结构。它通过引导冷却介质（通常是空气）流经其中，以对流换热的方式带走热量，从而降低部件的工作温度，确保其在高温环境下的结构完整性和使用寿命。" />
          <attvalue for="3" value="{&quot;reference_page&quot;: &quot;129&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-58ee51f26d85456c13aa639ae170ab36" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-58ee51f26d85456c13aa639ae170ab36-e-6" label="alloys">
        <attvalues>
          <attvalue for="0" value="alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="专为制造涡轮盘而开发的特种合金，通常指高温合金。它们具有优异的高温强度、抗蠕变和抗疲劳性能，能够承受航空发动机等设备在极端温度和应力下的严苛工作环境。" />
          <attvalue for="3" value="{&quot;historical development reference&quot;: &quot;pages 256-258&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-58ee51f26d85456c13aa639ae170ab36" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9c5b2b7dade746247326fc0930d280e0-e-1" label="turbine engine">
        <attvalues>
          <attvalue for="0" value="turbine engine" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="涡轮发动机是一种旋转式热机，将燃料燃烧的热能转化为机械功。为承受极高的“涡轮前温度”这一关键参数，其核心部件由超级合金制造。主要类型包括涡轮喷气式和涡轮风扇式发动机，是现代飞机的主要动力来源。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-9c5b2b7dade746247326fc0930d280e0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-9c5b2b7dade746247326fc0930d280e0-e-6" label="ultrasonic methods">
        <attvalues>
          <attvalue for="0" value="ultrasonic methods" />
          <attvalue for="1" value="Inspection Technique" />
          <attvalue for="2" value="一种无损检测技术，通过向材料内部发射高频声波（超声波），并分析其反射、衰减等回波信号，来探测内部缺陷、测量尺寸或表征材料性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-9c5b2b7dade746247326fc0930d280e0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9c5b2b7dade746247326fc0930d280e0-e-6&quot;]}]" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9c5b2b7dade746247326fc0930d280e0-e-10" label="vacancies">
        <attvalues>
          <attvalue for="0" value="vacancies" />
          <attvalue for="1" value="Material Defect" />
          <attvalue for="2" value="空位是一种晶体点缺陷，指晶格上一个原子位点未被占据而形成的空穴。它是在镍及其合金等金属中常见的热力学缺陷，其形成具有特定的形成焓，且其平衡浓度（或分数）会随温度升高而显著增加。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-9c5b2b7dade746247326fc0930d280e0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-9c5b2b7dade746247326fc0930d280e0-e-10&quot;, &quot;chunk-1522e93c065590bf976748cff2b67e57-e-3&quot;, &quot;chunk-b38b75a018fa569ff580b1d94d62395d-e-6&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-9c5b2b7dade746247326fc0930d280e0-e-11" label="enthalpy of formation">
        <attvalues>
          <attvalue for="0" value="enthalpy of formation" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="在晶体材料学中，特指形成一个孤立空位（点缺陷）所引起的焓变，常被称为“空位形成焓”。它是一个重要的热力学参数，其数值大小反映了在晶格中形成一个空位的难易程度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-9c5b2b7dade746247326fc0930d280e0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1522e93c065590bf976748cff2b67e57-e-4" label="nickel and its alloys">
        <attvalues>
          <attvalue for="0" value="nickel and its alloys" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍及其合金是以金属元素镍为基体，通过添加其他元素（如铬、铁、铜等）所构成的一类金属材料。这类材料通常具有优异的耐腐蚀性、高温强度、高韧性和特殊的物理性能，广泛应用于航空航天、化工、能源及电子工业等领域。" />
          <attvalue for="3" value="{&quot;reference_pages&quot;: &quot;58-65&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1522e93c065590bf976748cff2b67e57" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1522e93c065590bf976748cff2b67e57-e-8" label="Vacuum Induction Melting (VIM)">
        <attvalues>
          <attvalue for="0" value="Vacuum Induction Melting (VIM)" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="VIM processing，全称为真空感应熔炼（Vacuum Induction Melting），是一种先进的冶金工艺。它在真空环境下，利用电磁感应加热原理熔炼金属，以精确控制化学成分并去除杂质，主要用于生产高纯度的母合金、高温合金及特种钢等材料。" />
          <attvalue for="3" value="{&quot;reference_pages&quot;: &quot;219-222&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-1522e93c065590bf976748cff2b67e57" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;VIM processing&quot;, &quot;Vacuum Arc Melting (VIM)&quot;, &quot;Vacuum induction melting&quot;, &quot;vacuum induction melting&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-a82c14bced3fe39a05a14c312bfa9c9d-e-4&quot;, &quot;chunk-0365022a18454a90e4598122a8f449ca-e-5&quot;, &quot;chunk-d2428cb3e80954cab38bfce19b363f27-e-14&quot;, &quot;chunk-b6d430b58fe5b3336f2235e2e6daa465-e-6&quot;, &quot;chunk-1159c2afbaaccc92d505d71fb856dee1-e-7&quot;, &quot;chunk-2555e274f1223f9245526a48267868ff-e-5&quot;, &quot;chunk-dae9be5eb4b7208070b473c392dd0478-e-8&quot;, &quot;chunk-1522e93c065590bf976748cff2b67e57-e-8&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-1522e93c065590bf976748cff2b67e57-e-11" label="nitrogen">
        <attvalues>
          <attvalue for="0" value="nitrogen" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="氮是一种化学元素，符号为N，原子序数为7。它是一种非金属元素，是地球大气中含量最丰富的气体（约占78%）。在标准状况下，氮气是一种无色无味的惰性双原子气体。氮是构成生命体的基本元素，是氨基酸与核酸等有机分子的重要组成部分。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-1522e93c065590bf976748cff2b67e57" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1522e93c065590bf976748cff2b67e57-e-13" label="degassing">
        <attvalues>
          <attvalue for="0" value="degassing" />
          <attvalue for="1" value="Process Step" />
          <attvalue for="2" value="一种工业工艺，指通过真空处理、惰性气体吹扫等脱气手段，去除熔融金属（如钢液）、合金或液体中溶解的氮和氧。该工艺旨在消除由这些气体杂质引起的缺陷（如气孔、脆性），从而显著提高材料的纯净度、机械性能和整体质量。" />
          <attvalue for="3" value="{&quot;reference_page&quot;: &quot;220&quot;}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-1522e93c065590bf976748cff2b67e57" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;nitrogen and oxygen reduction by degassing&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1522e93c065590bf976748cff2b67e57-e-13&quot;, &quot;chunk-44260d4b7de8c9a00040496e0aad271b-e-3&quot;]}]" />
          <attvalue for="9" value="16" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-44260d4b7de8c9a00040496e0aad271b-e-1" label="furnace operation">
        <attvalues>
          <attvalue for="0" value="furnace operation" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="指为实现材料特定的物理或化学变化，而对炉窑设备进行的一系列受控操作。该过程通过调控温度、压力和气氛等参数，对物料进行加热、熔化或热处理，通常包含启炉、装料、升温、保温及出料等关键阶段。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-44260d4b7de8c9a00040496e0aad271b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="424" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-44260d4b7de8c9a00040496e0aad271b-e-2" label="laundering">
        <attvalues>
          <attvalue for="0" value="laundering" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="冶金学中的一道工序，指使用被称为“流槽”（Launder）的耐火材料通道，将熔炉中的高温熔融物（如金属液或熔渣）平稳地引导并输送到模具或其他设备的过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-44260d4b7de8c9a00040496e0aad271b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="425" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-44260d4b7de8c9a00040496e0aad271b-e-5" label="vanadium">
        <attvalues>
          <attvalue for="0" value="vanadium" />
          <attvalue for="1" value="Chemical Element" />
          <attvalue for="2" value="钒（Vanadium）是一种化学元素，符号V，原子序数23。作为一种重要的合金元素，它能显著提升钢等材料的强度和韧性，但在高温环境下，其氧化物（如五氧化二钒）会严重腐蚀金属，从而损害高温合金的热腐蚀抗性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-44260d4b7de8c9a00040496e0aad271b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;V&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-44260d4b7de8c9a00040496e0aad271b-e-5&quot;, &quot;chunk-1410988dfcbd0392c9d01a4bc32fcff9-e-7&quot;, &quot;chunk-951c3bbe670e3cf4f0dc7a8bc55e7730-e-2&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-44260d4b7de8c9a00040496e0aad271b-e-8" label="vanadium pentoxide">
        <attvalues>
          <attvalue for="0" value="vanadium pentoxide" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="五氧化二钒（V₂O₅）是一种无机化合物，是重要的工业催化剂（如用于生产硫酸）。同时，它也是引起热腐蚀的关键物质之一，因为它在高温下会形成腐蚀性熔融物，破坏金属表面的保护性氧化层。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-44260d4b7de8c9a00040496e0aad271b" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-44260d4b7de8c9a00040496e0aad271b-e-10" label="vanes">
        <attvalues>
          <attvalue for="0" value="vanes" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮导向叶片（Turbine Guide Vanes）是涡轮机（如燃气轮机或蒸汽轮机）中的一组静止环形排列的翼型部件。它的主要作用是将高温高压的工作流体（气体或蒸汽）以预设的最佳角度和速度导向旋转的转子叶片，以最大限度地提高能量转换效率和涡轮机的整体性能。" />
          <attvalue for="3" value="{&quot;type&quot;: &quot;turbine guide&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-44260d4b7de8c9a00040496e0aad271b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-44260d4b7de8c9a00040496e0aad271b-e-10&quot;]}]" />
          <attvalue for="9" value="426" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-44260d4b7de8c9a00040496e0aad271b-e-14" label="viscous glide processes">
        <attvalues>
          <attvalue for="0" value="viscous glide processes" />
          <attvalue for="1" value="Physical Process" />
          <attvalue for="2" value="一种蠕变变形机制，其变形速率由晶体位错的“黏性滑移”过程所决定。在此过程中，位错的运动因受到溶质原子等缺陷的拖拽而受阻，表现出类似于黏性流体的、与应力相关的缓慢滑移特征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-44260d4b7de8c9a00040496e0aad271b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-44260d4b7de8c9a00040496e0aad271b-e-14&quot;, &quot;chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-4&quot;]}]" />
          <attvalue for="9" value="21" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-6" label="volatilisation">
        <attvalues>
          <attvalue for="0" value="volatilisation" />
          <attvalue for="1" value="Chemical Process" />
          <attvalue for="2" value="挥发是一种化学过程，指物质由固态或液态转变为气态。在特定上下文中，它特指氧化铬（chromia）在高温下反应形成气态物质，导致其作为保护层发生损耗的现象。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-f775a6da6fa39b459ac49387ef2bf6f0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-8" label="waxes">
        <attvalues>
          <attvalue for="0" value="waxes" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="在熔模铸造（失蜡法）工艺中使用的一类材料。它们被用来制造与最终铸件形状相同的牺牲式蜡模（原型）。在后续工序中，蜡模被加热熔化并排出，从而在模壳中留下用于金属浇注的精确型腔。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-f775a6da6fa39b459ac49387ef2bf6f0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="14" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-10" label="welding">
        <attvalues>
          <attvalue for="0" value="welding" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="焊接是一种制造工艺与连接技术。它通过加热、加压或两者并用的方式，并可添加填充材料，使金属或热塑性塑料等工件在接合处实现原子间结合，从而形成一个永久性的连接。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-f775a6da6fa39b459ac49387ef2bf6f0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="427" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-12" label="workability">
        <attvalues>
          <attvalue for="0" value="workability" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="加工性 (Workability) 是一种材料属性，衡量材料在不受损坏（如开裂）的情况下，通过塑性变形来改变其形状的难易程度。它是评价材料是否适合锻造、轧制等变形加工过程的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-f775a6da6fa39b459ac49387ef2bf6f0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="242" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-13" label="deformation processes">
        <attvalues>
          <attvalue for="0" value="deformation processes" />
          <attvalue for="1" value="Manufacturing Process" />
          <attvalue for="2" value="变形过程是一类制造工艺，指通过施加外力使金属等材料发生塑性变形，以获得特定形状、尺寸及性能的零件或毛坯。加工性是其关键属性，根据温度可分为热加工与冷加工。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-f775a6da6fa39b459ac49387ef2bf6f0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-13&quot;]}]" />
          <attvalue for="9" value="242" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-14" label="X-ray methods">
        <attvalues>
          <attvalue for="0" value="X-ray methods" />
          <attvalue for="1" value="Analytical Method" />
          <attvalue for="2" value="一类利用X射线与物质相互作用来分析材料结构与性质的分析方法总称。它通过测量衍射或吸收等信号，用于测定堆垛层错概率等晶体缺陷参数。该类别下包含同步辐射衍射和射线照相术等具体技术。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-f775a6da6fa39b459ac49387ef2bf6f0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="62" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-15" label="stacking fault probability">
        <attvalues>
          <attvalue for="0" value="stacking fault probability" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="堆垛层错概率是一种材料属性，指晶体中原子面正常堆垛顺序被破坏的概率。它是一种重要的晶体缺陷度量，影响材料的力学和物理性能，通常可通过X射线衍射等方法测定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
          <attvalue for="5" value="chunk-f775a6da6fa39b459ac49387ef2bf6f0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="62" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-16" label="synchrotron diffraction">
        <attvalues>
          <attvalue for="0" value="synchrotron diffraction" />
          <attvalue for="1" value="Analytical Method" />
          <attvalue for="2" value="同步辐射衍射是一种先进的X射线衍射分析技术。它利用同步辐射光源产生的高强度、高准直性X射线作为探针，通过分析样品产生的衍射图样，来精确解析晶体、非晶体及纳米材料等的原子或分子尺度结构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-16" />
          <attvalue for="5" value="chunk-f775a6da6fa39b459ac49387ef2bf6f0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="62" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-18" label="yielding behaviour">
        <attvalues>
          <attvalue for="0" value="yielding behaviour" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="屈服行为是一种材料力学属性，指材料在应力达到屈服强度后，开始从弹性变形过渡到永久塑性变形的现象。该行为具有显著的温度依赖性，材料的屈服强度通常会随温度的变化而改变。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-18" />
          <attvalue for="5" value="chunk-f775a6da6fa39b459ac49387ef2bf6f0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-20" label="Young's modulus">
        <attvalues>
          <attvalue for="0" value="Young's modulus" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="杨氏模量（Young's modulus, E），又称弹性模量，是表征材料刚度的物理量，定义为在弹性极限内，单轴向的应力与应变之比。其值越高，材料越不易发生弹性形变。对于各向同性材料，该属性在所有方向上都保持不变。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-20" />
          <attvalue for="5" value="chunk-f775a6da6fa39b459ac49387ef2bf6f0" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Young's Modulus&quot;, &quot;Young's modulus, E&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-f775a6da6fa39b459ac49387ef2bf6f0-e-20&quot;, &quot;chunk-5e30fb63f189d46677273b5c0f9ed52d-e-7&quot;, &quot;chunk-59efde3cc28eec2ad611a5941651c5d8-e-1&quot;, &quot;chunk-91405e06bb69c5ec0eb63c43e028bfc6-e-3&quot;]}]" />
          <attvalue for="9" value="17" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-e4ee2b4726b7ab716e9f01d209b1fd11-e-3" label="alternative ceramic materials">
        <attvalues>
          <attvalue for="0" value="alternative ceramic materials" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="一类可用作热障涂层材料的先进陶瓷，旨在替代传统的氧化钇稳定氧化锆（YSZ），以寻求更优异的高温防护性能或成本效益。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-e4ee2b4726b7ab716e9f01d209b1fd11" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-db7cc890c68f0a43d000b2dba6ecf910-e-6" label="residual sulphur">
        <attvalues>
          <attvalue for="0" value="residual sulphur" />
          <attvalue for="1" value="Substance" />
          <attvalue for="2" value="残留硫（Residual Sulphur）指在材料（尤指钢铁）精炼后仍存在的有害硫杂质。添加钇等稀土元素能与其强力结合，形成稳定的高熔点硫化物，从而净化金属，显著改善材料的韧性和机械性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-db7cc890c68f0a43d000b2dba6ecf910" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-db7cc890c68f0a43d000b2dba6ecf910-e-8" label="creep-rupture resistance">
        <attvalues>
          <attvalue for="0" value="creep-rupture resistance" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="材料在高温和长期应力作用下抵抗蠕变变形直至最终断裂的性能。它是衡量材料在高温下长期承载能力和使用寿命的重要力学指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-db7cc890c68f0a43d000b2dba6ecf910" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-db7cc890c68f0a43d000b2dba6ecf910-e-8&quot;]}]" />
          <attvalue for="9" value="5" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e6c8cf32e29caa40f92e13ee8d574c84-e-4" label="Nickel">
        <attvalues>
          <attvalue for="0" value="Nickel" />
          <attvalue for="1" value="Material Element" />
          <attvalue for="2" value="镍（Ni）是一种坚韧、耐腐蚀的银白色过渡金属。基于其优异的耐高温性能，它常被用作制造高温合金的主要组分，在合金中充当溶剂基体。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-e6c8cf32e29caa40f92e13ee8d574c84" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e6c8cf32e29caa40f92e13ee8d574c84-e-5" label="High-temperature alloy">
        <attvalues>
          <attvalue for="0" value="High-temperature alloy" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="高温合金（High-temperature alloy）是一类以镍为基体的金属材料，通常也被称为超合金（Superalloy）。其核心特征是在极端高温环境下，仍能保持卓越的机械强度、抗蠕变性能和化学稳定性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-e6c8cf32e29caa40f92e13ee8d574c84" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8904cb48a935223e48567818a6621b2f-e-1" label="High-Temperature Deformation">
        <attvalues>
          <attvalue for="0" value="High-Temperature Deformation" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="高温变形是指材料（如镍等金属）在高于其再结晶温度下，因受力而发生的持续塑性变形。该条件下，材料行为常以蠕变为主要特征，并可通过蠕变剪切应变率等指标进行观测。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-8904cb48a935223e48567818a6621b2f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8904cb48a935223e48567818a6621b2f-e-2" label="Creep Shear Strain Rate (y)">
        <attvalues>
          <attvalue for="0" value="Creep Shear Strain Rate (y)" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="蠕变剪切应变率(y)是一个物理性质，用于衡量材料（尤指纯金属）在高温和持续应力下发生蠕变时的剪切变形速率。其数值通常与材料的体积扩散率成正比，反映了高温变形过程中的原子扩散机制。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;y&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-8904cb48a935223e48567818a6621b2f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8904cb48a935223e48567818a6621b2f-e-4" label="Volume Diffusivity">
        <attvalues>
          <attvalue for="0" value="Volume Diffusivity" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="体积扩散系数是一种衡量原子在材料内部扩散速率的物理属性，是高温蠕变的关键参数。蠕变剪切应变率与其成正比。该性质通常遵循阿伦尼乌斯关系，其温度依赖性由一个指前因子（Do, v）和一个活化能（Q）所表征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-8904cb48a935223e48567818a6621b2f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8904cb48a935223e48567818a6621b2f-e-5" label="Activation energy (Q)">
        <attvalues>
          <attvalue for="0" value="Activation energy (Q)" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="活化能（Q）是一个关键物理参数，用于表征材料的体扩散（Volume Diffusivity）特性。它定义了原子在晶格中从一个位置迁移到另一个位置时所需克服的最低能量势垒。其数值大小直接决定了扩散速率对温度的依赖性和扩散过程的难易程度。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;Q&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-8904cb48a935223e48567818a6621b2f" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Activation Energy (Q)&quot;, &quot;Activation energy&quot;, &quot;Q&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-efc4350d2f88b203eca8b021ce05f9b3-e-11&quot;, &quot;chunk-1cdb1c1dd2e4f71643372fbdac975f4e-e-10&quot;, &quot;chunk-8904cb48a935223e48567818a6621b2f-e-5&quot;, &quot;chunk-e3bc91d02528ce132349b28825081f88-e-11&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-8904cb48a935223e48567818a6621b2f-e-6" label="Pre-exponential Term (Do, v)">
        <attvalues>
          <attvalue for="0" value="Pre-exponential Term (Do, v)" />
          <attvalue for="1" value="Physical Parameter" />
          <attvalue for="2" value="指前因子（Do, v）是在描述体积扩散率与温度关系的阿伦尼乌斯方程中，指数项前的常数乘子，也称频率因子。它代表了在无限温度下的最大扩散系数，是表征材料固有扩散特性的一个重要物理参数。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;Do, v&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-8904cb48a935223e48567818a6621b2f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8981e8877dd5635849029e4451056d6d-e-1" label="T">
        <attvalues>
          <attvalue for="0" value="T" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="一个表示温度的无量纲变量。其数值是通过将绝对温度与一个称为Tm的参考量进行比较而归一化得到的，常用于物理和化学模型中。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;T&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-8981e8877dd5635849029e4451056d6d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8981e8877dd5635849029e4451056d6d-e-2" label="Tm">
        <attvalues>
          <attvalue for="0" value="Tm" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="Tm，全称熔点（Melting Temperature），是指物质（尤指金属）由固态转变为液态的临界温度。它是一个关键的物理性能参数，在此上下文中被用作一个基准，以归一化处理和评估其他依赖于它的性能指标。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;Tm&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-8981e8877dd5635849029e4451056d6d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Melting temperature (Tm)&quot;, &quot;Tm (Melting Temperature)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8981e8877dd5635849029e4451056d6d-e-2&quot;, &quot;chunk-5b67fbff0206633355ba0e17d910b688-e-8&quot;, &quot;chunk-e3bc91d02528ce132349b28825081f88-e-13&quot;, &quot;chunk-e169602f8c36042ddef4827a52729f2a-e-2&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-8981e8877dd5635849029e4451056d6d-e-3" label="y">
        <attvalues>
          <attvalue for="0" value="y" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="变量 y 是一个经过归一化处理的数值，其原始值已通过与 'DTm/22/3' 进行运算（如相除）而被缩放调整。此操作旨在消除数据的量纲和数量级差异，使其可以在统一尺度下进行比较和分析。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;y&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-8981e8877dd5635849029e4451056d6d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="89" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8981e8877dd5635849029e4451056d6d-e-4" label="DTm">
        <attvalues>
          <attvalue for="0" value="DTm" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="DTm是一个变量，指物质在熔点温度下的扩散系数（diffusivity）。它用于量化原子或分子在熔融状态临界点的扩散能力。在部分文本中，该变量也被记作“Drm”。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;DTm&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-8981e8877dd5635849029e4451056d6d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="89" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8981e8877dd5635849029e4451056d6d-e-5" label="Ω">
        <attvalues>
          <attvalue for="0" value="Ω" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="Ω，一个代表原子体积（atomic volume）的变量。在材料科学和固体物理学中，它指一摩尔元素在固态时所占据的体积，是计算材料扩散、熔化等热力学性质时的一个关键物理量。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;Ω&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-8981e8877dd5635849029e4451056d6d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="89" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8981e8877dd5635849029e4451056d6d-e-7" label="Dimensionless Shear Strain Rate">
        <attvalues>
          <attvalue for="0" value="Dimensionless Shear Strain Rate" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="无量纲剪切应变率是一个描述材料剪切变形速率的归一化物理量，没有单位，通常用符号γ表示。它在材料科学和流变学中被广泛用于表征材料的塑性流动与蠕变等行为，其数值与材料的扩散、温度和熔点等内在属性密切相关。" />
          <attvalue for="3" value="{&quot;symbol&quot;: &quot;γ&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-8981e8877dd5635849029e4451056d6d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="126" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8981e8877dd5635849029e4451056d6d-e-8" label="Dimensionless Groups">
        <attvalues>
          <attvalue for="0" value="Dimensionless Groups" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="在物理学和工程学中，由多个物理变量组合而成、最终量纲为一的参数。它能简化物理问题，并用于判断不同尺度下系统的物理相似性，是材料比较和模型实验中的重要指标，如同系温度。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-8981e8877dd5635849029e4451056d6d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8981e8877dd5635849029e4451056d6d-e-9" label="yx Do, v exp{-Qv/RT}">
        <attvalues>
          <attvalue for="0" value="yx Do, v exp{-Qv/RT}" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="一个描述固体中空位扩散系数随温度变化的阿伦尼乌斯方程。该公式是理解材料原子扩散行为的基础。其中，D₀,v是指前因子，Qv是扩散激活能（通常为空位形成能与迁移能之和），R是气体常数，T为绝对温度。" />
          <attvalue for="3" value="{&quot;equation_number&quot;: &quot;1.12&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-8981e8877dd5635849029e4451056d6d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="126" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8981e8877dd5635849029e4451056d6d-e-10" label="γΩ2/3 / DTm = α Ω2/3 exp{Qv / RTm (Tm / T − 1)}">
        <attvalues>
          <attvalue for="0" value="γΩ2/3 / DTm = α Ω2/3 exp{Qv / RTm (Tm / T − 1)}" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="一个定义无量纲剪切应变率的物理方程。它由描述热激活过程的基础本构方程经变量归一化推导而来，揭示了无量纲应变率与归一化温度（T/Tm）及材料活化能之间的定量关系。" />
          <attvalue for="3" value="{&quot;equation_number&quot;: &quot;1.13&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-8981e8877dd5635849029e4451056d6d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="126" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8981e8877dd5635849029e4451056d6d-e-11" label="DTm/22/3">
        <attvalues>
          <attvalue for="0" value="DTm/22/3" />
          <attvalue for="1" value="Expression" />
          <attvalue for="2" value="DTm/22/3 是在 DTm 中定义的数学表达式，用于对变量 y 进行归一化处理。该表达式的计算与实体 Ω 相关。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-8981e8877dd5635849029e4451056d6d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="89" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8981e8877dd5635849029e4451056d6d-e-12" label="T/Tm">
        <attvalues>
          <attvalue for="0" value="T/Tm" />
          <attvalue for="1" value="Expression" />
          <attvalue for="2" value="同系温度（Homologous Temperature）的定义，指材料的绝对温度（T）与其绝对熔点（Tm）的比值。该无量纲参数用于跨材料比较在不同温度下的物理及力学性能，尤其是在蠕变和扩散等高温行为中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-8981e8877dd5635849029e4451056d6d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8981e8877dd5635849029e4451056d6d-e-12&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ebfa8b7ae005eda909fbe4d14158391d-e-2" label="Qv/(RTm)">
        <attvalues>
          <attvalue for="0" value="Qv/(RTm)" />
          <attvalue for="1" value="Dimensionless Group" />
          <attvalue for="2" value="Qv/(RT)是一个物理参数，常作为衡量特定晶体类别性能的品质因数。在这些晶体中，最大化该参数是获得其最优异材料性能的关键。该参数的数值通常反映了某一能量（如激活能）与热能（RT）的比值。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;Qv/(RTm)&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-ebfa8b7ae005eda909fbe4d14158391d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Qv/(RT)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ebfa8b7ae005eda909fbe4d14158391d-e-2&quot;, &quot;chunk-5b67fbff0206633355ba0e17d910b688-e-5&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-ebfa8b7ae005eda909fbe4d14158391d-e-3" label="DTm/22/3">
        <attvalues>
          <attvalue for="0" value="DTm/22/3" />
          <attvalue for="1" value="Normalizing Parameter" />
          <attvalue for="2" value="DTm/22/3是一个归一化参数，专门用于高温性能的相关分析。它在评估过程中作为一个关键的标准化或参考指标，以确保数据的一致性和可比性。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;DTm/22/3&quot;}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-ebfa8b7ae005eda909fbe4d14158391d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ebfa8b7ae005eda909fbe4d14158391d-e-4" label="High-temperature performance">
        <attvalues>
          <attvalue for="0" value="High-temperature performance" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="高温性能 (High-temperature performance) 是一项关键的材料性能指标，用于评估材料在高温工况下的可靠性，如抗蠕变与抗氧化能力。它与同系温度及原子扩散过程密切相关，并由指标“y”来量化。根据其定义，y值越小，则代表材料的高温性能越优异。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-ebfa8b7ae005eda909fbe4d14158391d" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-ebfa8b7ae005eda909fbe4d14158391d-e-4&quot;, &quot;chunk-5b67fbff0206633355ba0e17d910b688-e-1&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-ebfa8b7ae005eda909fbe4d14158391d-e-5" label="y">
        <attvalues>
          <attvalue for="0" value="y" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="`y`是一个用于衡量高温性能的变量指标。该变量的数值与性能表现呈负相关关系，即数值越小，代表高温性能越优越。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-ebfa8b7ae005eda909fbe4d14158391d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-ebfa8b7ae005eda909fbe4d14158391d-e-6" label="Different materials">
        <attvalues>
          <attvalue for="0" value="Different materials" />
          <attvalue for="1" value="Material Group" />
          <attvalue for="2" value="指为特定应用而筛选的一组候选材料。其核心假设是，该组内所有材料的空位形成活化能(Qv)与气体常数(R)和绝对熔点(Tm)乘积的比值[Qv/(RTm)]为一个恒定值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-ebfa8b7ae005eda909fbe4d14158391d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5b67fbff0206633355ba0e17d910b688-e-3" label="Materials which melt at high temperatures">
        <attvalues>
          <attvalue for="0" value="Materials which melt at high temperatures" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="高熔点材料指在高温环境下仍能保持固态及其物理化学性质稳定的一类材料。这类材料因其优越的耐热性，是实现各种设备和系统在高温工况下获得良好性能的关键基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-5b67fbff0206633355ba0e17d910b688" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5b67fbff0206633355ba0e17d910b688-e-3&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5b67fbff0206633355ba0e17d910b688-e-4" label="Crystal classes">
        <attvalues>
          <attvalue for="0" value="Crystal classes" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="晶体类别 (Crystal classes) 是一种材料分类，指代在特定条件下能展现最优性能的材料。其性能特征通过最大化的 Qv/(RT) 值和最小化的 DT/22/3 值来表征。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-5b67fbff0206633355ba0e17d910b688" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-5b67fbff0206633355ba0e17d910b688-e-6" label="DT/22/3">
        <attvalues>
          <attvalue for="0" value="DT/22/3" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="DT/22/3是一个用于评估特定晶类性能的关键参数。在晶体学应用中，该参数的数值需要被最小化，其最小值表征了该晶类所能达到的最优性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-5b67fbff0206633355ba0e17d910b688" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5b67fbff0206633355ba0e17d910b688-e-7" label="Best properties">
        <attvalues>
          <attvalue for="0" value="Best properties" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="一种性能指标，指特定晶体类别在特定同系温度下所表现出的最优材料性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-5b67fbff0206633355ba0e17d910b688" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1410988dfcbd0392c9d01a4bc32fcff9-e-2" label="Metallic elements">
        <attvalues>
          <attvalue for="0" value="Metallic elements" />
          <attvalue for="1" value="Element Family" />
          <attvalue for="2" value="金属元素是元素周期表中的一个主要类别，占全部元素的绝大多数。它们通常具有金属光泽、良好的延展性和导电导热性，在化学反应中易失去电子形成阳离子。镍是其典型成员之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-1410988dfcbd0392c9d01a4bc32fcff9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1410988dfcbd0392c9d01a4bc32fcff9-e-3" label="Periodic table">
        <attvalues>
          <attvalue for="0" value="Periodic table" />
          <attvalue for="1" value="Scientific Chart" />
          <attvalue for="2" value="元素周期表是根据原子序数、电子排布和化学性质排列化学元素的图表。它以表格形式直观地揭示了元素性质的周期性变化规律，并将性质相似的元素归于同族，是化学及相关科学领域中用于系统化研究和预测物质特性的基础工具。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-1410988dfcbd0392c9d01a4bc32fcff9" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1410988dfcbd0392c9d01a4bc32fcff9-e-3&quot;, &quot;chunk-951c3bbe670e3cf4f0dc7a8bc55e7730-e-11&quot;, &quot;chunk-421a0cbf74306b155ad41d43e8de9233-e-2&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-1410988dfcbd0392c9d01a4bc32fcff9-e-4" label="Melting temperature">
        <attvalues>
          <attvalue for="0" value="Melting temperature" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="熔点（Melting temperature）是一种物理性质，指元素在标准大气压下由固态转变为液态时的温度，缩写为Tm。它与原子序数有很强的相关性，数值在元素周期表中呈现周期性变化，其中过渡金属通常具有最高的熔点。" />
          <attvalue for="3" value="{&quot;abbreviation&quot;: &quot;Tm&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1410988dfcbd0392c9d01a4bc32fcff9" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-951c3bbe670e3cf4f0dc7a8bc55e7730-e-5" label="First row / 3d row">
        <attvalues>
          <attvalue for="0" value="First row / 3d row" />
          <attvalue for="1" value="Periodic Table Row" />
          <attvalue for="2" value="第一过渡系元素，又称3d过渡元素，是元素周期表第四周期中从钪(Sc)到锌(Zn)的十种金属元素。它们的共同特征是原子的价电子依次填充3d轨道，其中包含钒(V)等重要工业金属。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-951c3bbe670e3cf4f0dc7a8bc55e7730" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-951c3bbe670e3cf4f0dc7a8bc55e7730-e-6" label="Second row / 4d row">
        <attvalues>
          <attvalue for="0" value="Second row / 4d row" />
          <attvalue for="1" value="Periodic Table Row" />
          <attvalue for="2" value="第二过渡金属系，也称4d系元素，指元素周期表中第五周期的10种d区元素。它们的价电子主要填充在4d轨道上，该系元素始于钇(Y)，止于镉(Cd)，包含了钼(Mo)等重要金属。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-951c3bbe670e3cf4f0dc7a8bc55e7730" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-951c3bbe670e3cf4f0dc7a8bc55e7730-e-7" label="Third row / 5d row">
        <attvalues>
          <attvalue for="0" value="Third row / 5d row" />
          <attvalue for="1" value="Periodic Table Row" />
          <attvalue for="2" value="指元素周期表第六周期的第三行过渡金属，也称5d过渡系或5d区元素。该系元素（如钨W）因镧系收缩效应，性质特殊，其熔点等物理性质通常显著高于前两个过渡金属系中的同族元素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-951c3bbe670e3cf4f0dc7a8bc55e7730" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-951c3bbe670e3cf4f0dc7a8bc55e7730-e-9" label="d electrons">
        <attvalues>
          <attvalue for="0" value="d electrons" />
          <attvalue for="1" value="Subatomic Particle" />
          <attvalue for="2" value="d电子是原子中填充在d亚层轨道上的电子。在过渡金属（如镍）中，它们通常作为外层价电子参与形成金属键，对元素的内聚能、磁性、多变的化合价及催化活性等物理化学性质具有决定性作用。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-951c3bbe670e3cf4f0dc7a8bc55e7730" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-951c3bbe670e3cf4f0dc7a8bc55e7730-e-9&quot;, &quot;chunk-67e83ce412e1a2b3ed6d85749ac58af6-e-5&quot;, &quot;chunk-1f5d781c40896f23b19d1622a0e99572-e-1&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-951c3bbe670e3cf4f0dc7a8bc55e7730-e-12" label="Bonding characteristics">
        <attvalues>
          <attvalue for="0" value="Bonding characteristics" />
          <attvalue for="1" value="Chemical Property" />
          <attvalue for="2" value="一种由d电子诱导的化学性质，指原子间的键合方式与特征，它决定了元素的晶体结构。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-951c3bbe670e3cf4f0dc7a8bc55e7730" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-421a0cbf74306b155ad41d43e8de9233-e-4" label="Hexagonally close-packed (HCP) metals">
        <attvalues>
          <attvalue for="0" value="Hexagonally close-packed (HCP) metals" />
          <attvalue for="1" value="Material Category" />
          <attvalue for="2" value="六方密堆积结构（Hexagonal Close-Packed, HCP），是一种常见的金属晶体结构类型。其原子在晶格中呈六边形致密排列，具有极高的空间利用率（约74%），是原子最紧密的堆积方式之一。典型的HCP金属包括镁（Mg）、锌（Zn）、钛（Ti）和钴（Co）等。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-421a0cbf74306b155ad41d43e8de9233" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;HCP&quot;, &quot;HCP metals&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-421a0cbf74306b155ad41d43e8de9233-e-4&quot;, &quot;chunk-23123c36459ce21f6a8a455f84fb6d73-e-2&quot;, &quot;chunk-52c2368c38f01bd3aedce678a81a8dc2-e-10&quot;, &quot;chunk-1ad3d9def6416eb2826a0448d6287c6f-e-1&quot;, &quot;chunk-e169602f8c36042ddef4827a52729f2a-e-5&quot;, &quot;chunk-a84c0c4e9e29df6948391158c41ca449-e-3&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="9" />
        </attvalues>
      </node>
      <node id="chunk-421a0cbf74306b155ad41d43e8de9233-e-6" label="Groups VIII and 1B">
        <attvalues>
          <attvalue for="0" value="Groups VIII and 1B" />
          <attvalue for="1" value="Periodic Table Group" />
          <attvalue for="2" value="根据旧的化学元素周期表命名法（CAS系统），指代第VIII族（现代第8、9、10族）和第1B族（现代第11族）。这些族均属于过渡金属，是众多具有面心立方（FCC）晶体结构的金属，如镍、铜、金等的主要分布区域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-421a0cbf74306b155ad41d43e8de9233" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-421a0cbf74306b155ad41d43e8de9233-e-7" label="Group VIIB">
        <attvalues>
          <attvalue for="0" value="Group VIIB" />
          <attvalue for="1" value="Periodic Table Group" />
          <attvalue for="2" value="VIIB族是元素周期表中的第7族，属于过渡金属。该族包含锰(Mn)、锝(Tc)、铼(Re)和𬭛(Bh)四个元素，其中锝和铼是典型的六方密堆积(HCP)金属。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-421a0cbf74306b155ad41d43e8de9233" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-421a0cbf74306b155ad41d43e8de9233-e-8" label="Groups VB, VIB">
        <attvalues>
          <attvalue for="0" value="Groups VB, VIB" />
          <attvalue for="1" value="Periodic Table Group" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;元素周期表中的第5族（VB族）和第6族（VIB族），即钒族与铬族。它们属于过渡金属，是体心立方（BCC）金属元素的主要分布区域，包含了钒、铬、钼、钨等重要金属。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-421a0cbf74306b155ad41d43e8de9233" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-4447e58998840565fc7fc92584e2060b-e-2" label="platinum group metals (PGMs)">
        <attvalues>
          <attvalue for="0" value="platinum group metals (PGMs)" />
          <attvalue for="1" value="Material Group" />
          <attvalue for="2" value="铂族金属（PGMs）是六种化学性质相似的贵金属元素的合称，包括钌(Ru)、铑(Rh)、钯(Pd)、锇(Os)、铱(Ir)和铂(Pt)。它们均为稀有金属，物理化学性质相似，具有高熔点、高密度和优良的催化活性及抗腐蚀性。" />
          <attvalue for="3" value="{&quot;density&quot;: &quot;high&quot;, &quot;cost&quot;: &quot;significant&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-4447e58998840565fc7fc92584e2060b" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;PGMs&quot;, &quot;Platinum group metals (PGMs)&quot;, &quot;platinum group metals&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-cad1eaa9ffb0e731892120bbe3415da7-e-10&quot;, &quot;chunk-4447e58998840565fc7fc92584e2060b-e-2&quot;, &quot;chunk-1f5d781c40896f23b19d1622a0e99572-e-7&quot;, &quot;chunk-52c2368c38f01bd3aedce678a81a8dc2-e-1&quot;, &quot;chunk-1ad3d9def6416eb2826a0448d6287c6f-e-5&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="10" />
        </attvalues>
      </node>
      <node id="chunk-5958782fd9c70500d1cba42b1e98a7f8-e-1" label="Normalised activation energies, Qv/(RTm)">
        <attvalues>
          <attvalue for="0" value="Normalised activation energies, Qv/(RTm)" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="归一化激活能 (Normalised activation energies, Qv/(RTm))：一种材料属性，是表示空位形成能(Qv)与熔点热能(RTm)之比的无量纲参数。该属性值在氧化物和碳化物陶瓷体系中分布广泛，而面心立方(FCC)金属则通常表现出很高的数值。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-5958782fd9c70500d1cba42b1e98a7f8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-5958782fd9c70500d1cba42b1e98a7f8-e-2" label="Melting point diffusivity, Dr">
        <attvalues>
          <attvalue for="0" value="Melting point diffusivity, Dr" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="熔点扩散率（Dr），也记作DTm，是一项表征材料在熔点时扩散能力的物理属性。该属性的数值在氧化物和碳化物陶瓷体系中分布范围较广，而在面心立方（FCC）金属中则普遍表现出非常低的值。" />
          <attvalue for="3" value="{&quot;alternate_notation&quot;: &quot;DTm&quot;}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-5958782fd9c70500d1cba42b1e98a7f8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-5958782fd9c70500d1cba42b1e98a7f8-e-3" label="Oxides">
        <attvalues>
          <attvalue for="0" value="Oxides" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="氧化物 (Oxides) 是一种由含氧化合物构成的材料体系。因其多样的晶体结构，该体系在归一化激活能、熔点扩散率等关键材料性能上表现出显著的离散分布（即数据分散范围广）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-5958782fd9c70500d1cba42b1e98a7f8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-5958782fd9c70500d1cba42b1e98a7f8-e-4" label="Carbide ceramic systems">
        <attvalues>
          <attvalue for="0" value="Carbide ceramic systems" />
          <attvalue for="1" value="Material System" />
          <attvalue for="2" value="碳化物陶瓷体系是一种由金属或准金属的碳化物为主要成分构成的材料体系。由于该体系内部包含多种不同的晶体类别，其在归一化激活能、熔点扩散率等关键材料性能上表现出显著的离散分布特性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-5958782fd9c70500d1cba42b1e98a7f8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-5958782fd9c70500d1cba42b1e98a7f8-e-5" label="Figures 1.21 and 1.22">
        <attvalues>
          <attvalue for="0" value="Figures 1.21 and 1.22" />
          <attvalue for="1" value="Data Source" />
          <attvalue for="2" value="一个由图1.21和图1.22组成的数据源，以图形方式提供了多种晶体结构的归一化激活能（Qv/RTm）和熔点扩散系数（DTm）的经验数据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-5958782fd9c70500d1cba42b1e98a7f8" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-5958782fd9c70500d1cba42b1e98a7f8-e-6" label="FCC metals">
        <attvalues>
          <attvalue for="0" value="FCC metals" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="FCC金属指具有面心立方（Face-Centered Cubic）晶体结构的金属材料。在其晶胞结构中，原子分布于立方体的八个顶点及六个面的中心。该结构使这类金属通常具备优良的延展性和塑性，常见的例子包括铝(Al)、铜(Cu)、镍(Ni)和金(Au)。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-5958782fd9c70500d1cba42b1e98a7f8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;FCC metal&quot;, &quot;Face-centered cubic (FCC) metals&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5958782fd9c70500d1cba42b1e98a7f8-e-6&quot;, &quot;chunk-23123c36459ce21f6a8a455f84fb6d73-e-3&quot;, &quot;chunk-e3bc91d02528ce132349b28825081f88-e-14&quot;, &quot;chunk-e169602f8c36042ddef4827a52729f2a-e-3&quot;, &quot;chunk-062c12e756b5b5e7f808077ef31ba609-e-5&quot;, &quot;chunk-a84c0c4e9e29df6948391158c41ca449-e-1&quot;, &quot;chunk-52c2368c38f01bd3aedce678a81a8dc2-e-7&quot;, &quot;chunk-f6159d3dd840711c5298adf7f057d3b6-e-7&quot;, &quot;chunk-421a0cbf74306b155ad41d43e8de9233-e-3&quot;, &quot;chunk-4447e58998840565fc7fc92584e2060b-e-1&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="11" />
        </attvalues>
      </node>
      <node id="chunk-5958782fd9c70500d1cba42b1e98a7f8-e-7" label="BCC">
        <attvalues>
          <attvalue for="0" value="BCC" />
          <attvalue for="1" value="Crystal Structure" />
          <attvalue for="2" value="体心立方（BCC）是一种常见的晶体结构类型，全称为Body-Centered Cubic。其晶胞中，原子位于立方体的八个顶点及体心位置。这种原子排列方式是铁、铬、钨等多种金属在特定条件下的结构形态，并决定了其独特的物理与机械性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-5958782fd9c70500d1cba42b1e98a7f8" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5958782fd9c70500d1cba42b1e98a7f8-e-7&quot;, &quot;chunk-062c12e756b5b5e7f808077ef31ba609-e-6&quot;, &quot;chunk-a84c0c4e9e29df6948391158c41ca449-e-2&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-23123c36459ce21f6a8a455f84fb6d73-e-1" label="BCC metals">
        <attvalues>
          <attvalue for="0" value="BCC metals" />
          <attvalue for="1" value="Metal Crystal Structure" />
          <attvalue for="2" value="体心立方金属（BCC metals）是一类晶体结构为体心立方的金属，如铬（Cr）、铁（Fe）等。这种原子排列结构使其具有较高的强度，但同时具有脆性倾向，并表现出显著的韧脆转变现象，即材料的力学行为会随温度变化发生从韧性到脆性的突变。" />
          <attvalue for="3" value="{&quot;Qv/(RTm)&quot;: &quot;17.8&quot;, &quot;DT&quot;: &quot;10-12 – 10-11 m²/s&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-23123c36459ce21f6a8a455f84fb6d73" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Body-centered cubic (BCC) metals&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-23123c36459ce21f6a8a455f84fb6d73-e-1&quot;, &quot;chunk-e169602f8c36042ddef4827a52729f2a-e-4&quot;, &quot;chunk-1ad3d9def6416eb2826a0448d6287c6f-e-11&quot;, &quot;chunk-466225ab73e7ea49ac0af36e5725c4c1-e-1&quot;, &quot;chunk-421a0cbf74306b155ad41d43e8de9233-e-5&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="7" />
        </attvalues>
      </node>
      <node id="chunk-23123c36459ce21f6a8a455f84fb6d73-e-4" label="BCC → FCC transformation">
        <attvalues>
          <attvalue for="0" value="BCC → FCC transformation" />
          <attvalue for="1" value="Phase Transformation" />
          <attvalue for="2" value="指材料晶体结构从体心立方(BCC)向面心立方(FCC)转变的固态相变。此过程在铁(Fe)中尤为典型，由于FCC结构中原子排列更致密，该转变会导致材料的原子扩散率降低。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-23123c36459ce21f6a8a455f84fb6d73" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-23123c36459ce21f6a8a455f84fb6d73-e-4&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-23123c36459ce21f6a8a455f84fb6d73-e-5" label="BCC → HCP transformation">
        <attvalues>
          <attvalue for="0" value="BCC → HCP transformation" />
          <attvalue for="1" value="Phase Transformation" />
          <attvalue for="2" value="指晶体结构从体心立方(BCC)转变为密排六方(HCP)的一种固态相变。该过程是纯钛(Ti)及其合金在冷却时的典型转变，会使原子排列更紧密，从而导致材料的原子扩散率降低。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-23123c36459ce21f6a8a455f84fb6d73" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-23123c36459ce21f6a8a455f84fb6d73-e-5&quot;]}]" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-23123c36459ce21f6a8a455f84fb6d73-e-7" label="Ti">
        <attvalues>
          <attvalue for="0" value="Ti" />
          <attvalue for="1" value="Element" />
          <attvalue for="2" value="钛（Ti）是一种化学元素，其晶体结构会发生从体心立方（BCC）到密排六方（HCP）的同素异构转变。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-23123c36459ce21f6a8a455f84fb6d73" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-23123c36459ce21f6a8a455f84fb6d73-e-8" label="Diffusivity">
        <attvalues>
          <attvalue for="0" value="Diffusivity" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="扩散率是一种表征材料中原子、分子等粒子扩散速率的物理性质。它受材料的晶体结构影响，当发生从原子堆积较疏松的体心立方(BCC)结构向更致密的面心立方(FCC)或密排六方(HCP)结构转变时，扩散率会降低。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-23123c36459ce21f6a8a455f84fb6d73" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-67e83ce412e1a2b3ed6d85749ac58af6-e-1" label="Nickel-based alloys">
        <attvalues>
          <attvalue for="0" value="Nickel-based alloys" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="镍基合金（Nickel-based alloys），常被称为高温合金，是指以金属镍为基体的一类合金。它们在高温下具有出色的强度、抗氧化和耐腐蚀性能，是制造航空发动机、燃气轮机热端部件等高温应用领域的关键材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-67e83ce412e1a2b3ed6d85749ac58af6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-67e83ce412e1a2b3ed6d85749ac58af6-e-6" label="Cohesive energy">
        <attvalues>
          <attvalue for="0" value="Cohesive energy" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="内聚能（Cohesive energy）是将固体中的原子分离成孤立中性原子所需的能量，用以衡量原子间结合键的强度。在过渡金属（如镍）中，该能量主要源于d电子的成键作用，是决定材料韧性和延展性等力学性质的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-67e83ce412e1a2b3ed6d85749ac58af6" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1f5d781c40896f23b19d1622a0e99572-e-3" label="FCC form">
        <attvalues>
          <attvalue for="0" value="FCC form" />
          <attvalue for="1" value="Crystal Structure" />
          <attvalue for="2" value="一种晶体结构，为铂族金属（PGMs）所具有的结构形式。在这种结构中，镍（nickel）能在很宽的温度范围内保持稳定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-1f5d781c40896f23b19d1622a0e99572" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1f5d781c40896f23b19d1622a0e99572-e-4" label="phase transformations">
        <attvalues>
          <attvalue for="0" value="phase transformations" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="相变是一种物理现象，指材料的物相（如晶体结构）随温度等条件变化而转变。该过程常伴随体积膨胀或收缩，会影响高温部件的尺寸稳定性，使其应用复杂化，因此是某些高性能合金（如镍基合金）在设计时需避免的。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1f5d781c40896f23b19d1622a0e99572" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-1f5d781c40896f23b19d1622a0e99572-e-5" label="high-temperature components">
        <attvalues>
          <attvalue for="0" value="high-temperature components" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="指在高温环境下工作的工程构件。其设计与应用常因构成材料发生相变而变得复杂，因为相变会导致构件的物理或机械性能发生显著变化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1f5d781c40896f23b19d1622a0e99572" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1f5d781c40896f23b19d1622a0e99572-e-8" label="bonding">
        <attvalues>
          <attvalue for="0" value="bonding" />
          <attvalue for="1" value="Physical Interaction" />
          <attvalue for="2" value="一种物理相互作用，特指由外层d电子提供的、将原子结合在一起的化学键合力。这种作用力常见于过渡金属及其化合物中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-1f5d781c40896f23b19d1622a0e99572" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1f5d781c40896f23b19d1622a0e99572-e-9" label="thermally activated creep">
        <attvalues>
          <attvalue for="0" value="thermally activated creep" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="热激活蠕变指材料在高温和恒定应力作用下，随时间缓慢发生塑性变形的现象。该过程由热能激活原子扩散、位错攀移等微观机制所驱动，其变形速率对温度和应力水平高度敏感，是决定材料高温服役寿命的关键性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-1f5d781c40896f23b19d1622a0e99572" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Thermally activated creep&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-1f5d781c40896f23b19d1622a0e99572-e-9&quot;, &quot;chunk-52c2368c38f01bd3aedce678a81a8dc2-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-52c2368c38f01bd3aedce678a81a8dc2-e-4" label="Self-diffusion">
        <attvalues>
          <attvalue for="0" value="Self-diffusion" />
          <attvalue for="1" value="Physical Phenomenon" />
          <attvalue for="2" value="自扩散是一种物理现象，指固体材料（特别是纯金属）中的原子在自身晶格内迁移的过程。它是一种热激活过程，其激活能与材料的高温蠕变激活能密切相关，这表明原子通过自扩散的迁移是控制蠕变变形速率的基本机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-52c2368c38f01bd3aedce678a81a8dc2" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-52c2368c38f01bd3aedce678a81a8dc2-e-4&quot;]}]" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-52c2368c38f01bd3aedce678a81a8dc2-e-8" label="Ni">
        <attvalues>
          <attvalue for="0" value="Ni" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="镍（Ni）是一种具有面心立方（FCC）晶体结构的金属化学元素，是此类金属的典型范例。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-52c2368c38f01bd3aedce678a81a8dc2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-52c2368c38f01bd3aedce678a81a8dc2-e-9" label="Microstructural stability">
        <attvalues>
          <attvalue for="0" value="Microstructural stability" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="微观结构稳定性是一种材料属性，指材料在高温下抵抗其微观结构发生变化（如晶粒长大或相变）的能力。该特性通常在原子扩散速率低的材料中表现优异，例如面心立方（FCC）金属。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-52c2368c38f01bd3aedce678a81a8dc2" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1ad3d9def6416eb2826a0448d6287c6f-e-7" label="Osmium oxide">
        <attvalues>
          <attvalue for="0" value="Osmium oxide" />
          <attvalue for="1" value="Chemical Compound" />
          <attvalue for="2" value="锇的氧化物，通常指四氧化锇（OsO₄）。它是一种剧毒、高挥发性的淡黄色固体，具有强氧化性，在有机合成中用作催化剂，并在电子显微镜技术中用作生物组织的染色剂和固定剂。" />
          <attvalue for="3" value="{&quot;toxicity&quot;: &quot;poisonous&quot;}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-1ad3d9def6416eb2826a0448d6287c6f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1ad3d9def6416eb2826a0448d6287c6f-e-8" label="Tc">
        <attvalues>
          <attvalue for="0" value="Tc" />
          <attvalue for="1" value="Metal" />
          <attvalue for="2" value="锝（Technetium），符号为Tc，是一种人造放射性化学元素。它是一种银灰色的过渡金属，其晶体结构为六方密堆积（HCP），是六方密堆积金属的一员，也是所有元素中最轻的没有稳定同位素的元素。" />
          <attvalue for="3" value="{&quot;property&quot;: &quot;radioactive&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-1ad3d9def6416eb2826a0448d6287c6f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="1" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1ad3d9def6416eb2826a0448d6287c6f-e-9" label="Co-based superalloys">
        <attvalues>
          <attvalue for="0" value="Co-based superalloys" />
          <attvalue for="1" value="Alloy" />
          <attvalue for="2" value="钴基高温合金（Co-based superalloys）是一种以钴为基体、专为极端高温环境设计的合金。它们拥有卓越的高温强度、优良的抗热腐蚀和抗蠕变性能，通常比镍基高温合金成本更高，主要用于航空发动机和燃气轮机的涡轮叶片等关键热端部件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-1ad3d9def6416eb2826a0448d6287c6f" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-466225ab73e7ea49ac0af36e5725c4c1-e-5" label="Toughness">
        <attvalues>
          <attvalue for="0" value="Toughness" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="韧性（Toughness），材料属性之一，指材料在发生断裂前吸收能量和进行塑性变形的能力。它综合了材料的强度与塑性，是衡量材料抵抗冲击载荷或裂纹扩展能力的重要性能指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-466225ab73e7ea49ac0af36e5725c4c1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-466225ab73e7ea49ac0af36e5725c4c1-e-5&quot;]}]" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-466225ab73e7ea49ac0af36e5725c4c1-e-10" label="High-temperature operation">
        <attvalues>
          <attvalue for="0" value="High-temperature operation" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="高温运行是一种应用领域，指设备或部件在极端高温下工作。由于对材料的高温强度、抗蠕变性和耐久性有极高要求，它成为镍基高温合金等特种材料的主要应用场景。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-466225ab73e7ea49ac0af36e5725c4c1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-466225ab73e7ea49ac0af36e5725c4c1-e-10&quot;, &quot;chunk-6961c93f48e22019dc09686be94a57fd-e-2&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-466225ab73e7ea49ac0af36e5725c4c1-e-12" label="Fatigue">
        <attvalues>
          <attvalue for="0" value="Fatigue" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="疲劳是一种失效模式，指材料在远低于其静态强度极限的循环载荷或交变应力作用下，发生局部、渐进性的损伤，并最终导致裂纹形成、扩展直至断裂的过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-466225ab73e7ea49ac0af36e5725c4c1" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-466225ab73e7ea49ac0af36e5725c4c1-e-13" label="Environmental degradation">
        <attvalues>
          <attvalue for="0" value="Environmental degradation" />
          <attvalue for="1" value="Failure Mode" />
          <attvalue for="2" value="在材料科学中，环境致劣是一种材料失效模式，指材料因与服役环境（如高温、腐蚀介质）发生物理化学作用，导致其关键性能逐渐劣化并最终失效的现象。它是超合金等应用于严苛环境的材料必须抵抗的关键挑战，直接影响其结构完整性与使用寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-466225ab73e7ea49ac0af36e5725c4c1" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-466225ab73e7ea49ac0af36e5725c4c1-e-13&quot;, &quot;chunk-6961c93f48e22019dc09686be94a57fd-e-5&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-6961c93f48e22019dc09686be94a57fd-e-4" label="Fatigue">
        <attvalues>
          <attvalue for="0" value="Fatigue" />
          <attvalue for="1" value="Material Failure Mode" />
          <attvalue for="2" value="疲劳（Fatigue）是一种材料失效模式，指材料在承受远低于其极限强度的重复或交变载荷时，因微观裂纹的萌生、扩展并最终汇合，而导致的突然性断裂现象。高温会显著加速这一过程。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-6961c93f48e22019dc09686be94a57fd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-6961c93f48e22019dc09686be94a57fd-e-7" label="Turbines used for electricity generation">
        <attvalues>
          <attvalue for="0" value="Turbines used for electricity generation" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="指将蒸汽或燃气等流体的动能与热能转化为高速旋转的机械功，用以驱动发电机发电的旋转式动力机械。由于其核心部件（如涡轮叶片）需在极端高温高压环境下工作，因此通常由具有优异高温强度的超级合金等材料制成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-6961c93f48e22019dc09686be94a57fd" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9eb2cadb717d72e1940b942340621320-e-1" label="Modern turbine systems">
        <attvalues>
          <attvalue for="0" value="Modern turbine systems" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="现代涡轮系统是一种先进动力系统，旨在通过在更高的温度下运行，来提升燃料效率并减少排放。这是实现更优越性能和环保标准的关键设计要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-9eb2cadb717d72e1940b942340621320" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="90" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-9eb2cadb717d72e1940b942340621320-e-2" label="Enhanced fuel efficiency">
        <attvalues>
          <attvalue for="0" value="Enhanced fuel efficiency" />
          <attvalue for="1" value="Goal" />
          <attvalue for="2" value="提高燃油效率指提升能量转换效率，以更少的燃料消耗获得更大的有效功或能量输出。作为一项关键性能指标，它是现代涡轮系统等动力装置的核心设计与优化目标，旨在降低运行成本和环境影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-9eb2cadb717d72e1940b942340621320" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="90" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9eb2cadb717d72e1940b942340621320-e-3" label="Reduced emissions">
        <attvalues>
          <attvalue for="0" value="Reduced emissions" />
          <attvalue for="1" value="Goal" />
          <attvalue for="2" value="减少排放指在工业、能源（如现代涡轮系统）及交通等领域中，有目的地降低污染物和温室气体的释放量。这是一项关键的环境保护目标，旨在减缓空气污染与应对气候变化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-9eb2cadb717d72e1940b942340621320" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="90" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9eb2cadb717d72e1940b942340621320-e-4" label="Higher operating temperatures">
        <attvalues>
          <attvalue for="0" value="Higher operating temperatures" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="一项现代涡轮系统为提高热力学效率与功率输出而必须达到的关键运行条件。根据热力学原理，更高的温度可显著提升系统性能，是先进涡轮设计的核心技术要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-9eb2cadb717d72e1940b942340621320" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="90" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9eb2cadb717d72e1940b942340621320-e-7" label="Failure by fracture or fatigue">
        <attvalues>
          <attvalue for="0" value="Failure by fracture or fatigue" />
          <attvalue for="1" value="Risk" />
          <attvalue for="2" value="构件的一种失效风险，主要包括两种形式。断裂是指在载荷作用下发生的瞬时分离；疲劳则是指材料在反复的循环应力下，因裂纹的萌生和扩展而导致的渐进性破坏。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-9eb2cadb717d72e1940b942340621320" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-9eb2cadb717d72e1940b942340621320-e-8" label="Highest integrity">
        <attvalues>
          <attvalue for="0" value="Highest integrity" />
          <attvalue for="1" value="Property" />
          <attvalue for="2" value="最高完整性（Highest integrity）是组件为最大限度降低失效风险所必须具备的最高级别质量属性。它确保组件在结构和功能上的健全与可靠，是保障关键系统安全、稳定运行的核心要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-9eb2cadb717d72e1940b942340621320" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-bf906ca2cbc8d790d36fdc40a9295b24-e-2" label="inspection and lifetime estimation procedures">
        <attvalues>
          <attvalue for="0" value="inspection and lifetime estimation procedures" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="指针对高温合金部件进行检验和寿命评估的一系列标准化流程，对于保障其在役期间的安全可靠运行至关重要。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-bf906ca2cbc8d790d36fdc40a9295b24" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-995a2b9cc489b030d64e320f8fc16f28-e-1" label="FCC crystal structure">
        <attvalues>
          <attvalue for="0" value="FCC crystal structure" />
          <attvalue for="1" value="Crystal Structure" />
          <attvalue for="2" value="面心立方晶体结构（FCC）是一种常见的晶体结构，属于立方晶系。其晶胞中，原子（或格点）位于立方体的8个顶点和6个面的中心。它等同于立方密堆积（CCP），具有约74%的最高理论堆积密度。许多金属元素如铜、铝、金、银等在室温下都具有此结构。" />
          <attvalue for="3" value="{&quot;alias&quot;: &quot;face-centered cubic&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-995a2b9cc489b030d64e320f8fc16f28" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;FCC structure&quot;, &quot;Face-centred cubic (FCC)&quot;, &quot;e-centred cubic (FCC) crystal structure&quot;, &quot;face-centered cubic crystal structure&quot;, &quot;face-centred cubic (FCC) crystal structure&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-995a2b9cc489b030d64e320f8fc16f28-e-1&quot;, &quot;chunk-f0829bcd269a8d2dfa4641c4b0e70d30-e-3&quot;, &quot;chunk-67e83ce412e1a2b3ed6d85749ac58af6-e-4&quot;, &quot;chunk-13f1fdc70fe0c4a699a3307c18f29c33-e-7&quot;, &quot;chunk-5b143324ae92718a4dde1cd69bd72bd2-e-11&quot;, &quot;chunk-8a91b63add4adbc77d4752d41b7c75aa-e-1&quot;, &quot;chunk-dc5958ae6c6275575fd05993164bcb7f-e-3&quot;, &quot;chunk-13624c30d54236964523cb607119931d-e-2&quot;]}]" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-995a2b9cc489b030d64e320f8fc16f28-e-2" label="Gas turbine engine">
        <attvalues>
          <attvalue for="0" value="Gas turbine engine" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="燃气涡轮发动机是一种将燃料化学能转变为可用机械功的内燃动力机械。它由风扇、压气机、燃烧室和涡轮等核心部件构成，通过吸入并压缩空气，燃烧燃料产生高温燃气，驱动涡轮高速旋转，从而产生推力或输出轴功率。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-995a2b9cc489b030d64e320f8fc16f28" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-995a2b9cc489b030d64e320f8fc16f28-e-5" label="Combustor">
        <attvalues>
          <attvalue for="0" value="Combustor" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="**燃烧室 (Combustor)**&#10;&#10;燃气轮机发动机的核心部件。它将来自压气机的高压空气与燃料混合并持续燃烧，产生高温高压燃气以驱动涡轮做功。因其严苛的高温工作环境，通常采用镍基高温合金等先进耐热材料制造。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-995a2b9cc489b030d64e320f8fc16f28" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Combustor sections&quot;, &quot;combustor&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-04fc5332fa43dcac6331c45b022dd378-e-7&quot;, &quot;chunk-995a2b9cc489b030d64e320f8fc16f28-e-5&quot;, &quot;chunk-237995b9cf6d28ae47223438bc5c64d5-e-5&quot;, &quot;chunk-b505bbe1d912bcde398fe7f44b786cf0-e-2&quot;, &quot;chunk-5d942c8f1c01db54bab51b31faea4836-e-11&quot;, &quot;chunk-45ecdbf5bbf3393bc51ac55cc2386745-e-3&quot;, &quot;chunk-769ba0c0d24bfa76e90ec2af6878e559-e-7&quot;, &quot;chunk-c1f941cda4f8b36efca8168f378f1be7-e-6&quot;]}]" />
          <attvalue for="9" value="3" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-995a2b9cc489b030d64e320f8fc16f28-e-6" label="Turbine">
        <attvalues>
          <attvalue for="0" value="Turbine" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮是燃气涡轮发动机的核心旋转部件，用于从高温燃气中提取能量，以驱动压气机或对外输出功。因其在高温高压环境下工作，通常采用镍基高温合金等具备优异耐热强度的材料制造。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-995a2b9cc489b030d64e320f8fc16f28" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-995a2b9cc489b030d64e320f8fc16f28-e-9" label="Average temperature">
        <attvalues>
          <attvalue for="0" value="Average temperature" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="平均温度是一种物理属性，指发动机内部气流在特定截面或区域内的平均热力学温度。它是一个关键性能参数，其数值会因流经压缩机等做功部件而发生变化。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-995a2b9cc489b030d64e320f8fc16f28" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b505bbe1d912bcde398fe7f44b786cf0-e-3" label="turbine sections">
        <attvalues>
          <attvalue for="0" value="turbine sections" />
          <attvalue for="1" value="Engine Section" />
          <attvalue for="2" value="涡轮段是燃气涡轮发动机的核心热端部件，负责将高温高压燃气的能量转化为机械功，以驱动压气机及输出功率。因其工作在极端严苛的环境下，通常由具备优异高温强度和抗蠕变性能的镍基高温合金等先进材料制成。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-b505bbe1d912bcde398fe7f44b786cf0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b505bbe1d912bcde398fe7f44b786cf0-e-4" label="compressor regions">
        <attvalues>
          <attvalue for="0" value="compressor regions" />
          <attvalue for="1" value="Engine Section" />
          <attvalue for="2" value="燃气涡轮发动机的核心部件，位于进气道与燃烧室之间，负责将空气逐级压缩以提高压力和密度。由于其工作温度低于涡轮区域，该部件通常由钛合金或钢合金制成，而非用于高温环境的镍基高温合金。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-b505bbe1d912bcde398fe7f44b786cf0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b505bbe1d912bcde398fe7f44b786cf0-e-6" label="low-pressure (LP) turbine blades">
        <attvalues>
          <attvalue for="0" value="low-pressure (LP) turbine blades" />
          <attvalue for="1" value="Engine Component" />
          <attvalue for="2" value="低压涡轮叶片是航空发动机涡轮部分的关键部件。其主要功能是吸收来自高压涡轮的低压燃气能量，以驱动风扇及低压压气机。因工作在较低的压力和温度下，其外形通常比高压涡轮叶片更长。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-b505bbe1d912bcde398fe7f44b786cf0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b505bbe1d912bcde398fe7f44b786cf0-e-7" label="high-pressure (HP) blading">
        <attvalues>
          <attvalue for="0" value="high-pressure (HP) blading" />
          <attvalue for="1" value="Engine Component" />
          <attvalue for="2" value="高压叶片（HP blading）是航空发动机的核心部件，指高压压气机或高压涡轮中的叶片。它在高温高压的极端环境下工作，负责对气体增压或提取燃气能量。由于所处阶段气体密度大、体积流率小，其叶片径向尺寸通常比低压部分的叶片更短。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-b505bbe1d912bcde398fe7f44b786cf0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="11" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-b505bbe1d912bcde398fe7f44b786cf0-e-8" label="first row of turbine blades">
        <attvalues>
          <attvalue for="0" value="first row of turbine blades" />
          <attvalue for="1" value="Engine Component" />
          <attvalue for="2" value="民用航空发动机的关键热端部件，指涡轮的第一排转子叶片。它直接承受来自燃烧室的最高温高压燃气，将其热能转化为驱动压气机和附件的机械功，是发动机中工作环境最恶劣的部件之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-b505bbe1d912bcde398fe7f44b786cf0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b505bbe1d912bcde398fe7f44b786cf0-e-9" label="aeroengine for a civil aircraft">
        <attvalues>
          <attvalue for="0" value="aeroengine for a civil aircraft" />
          <attvalue for="1" value="System" />
          <attvalue for="2" value="为民用飞机提供推力的航空发动机，通常指以遄达800和GE90为代表的大涵道比涡轮风扇发动机。它是一种由涡轮叶片等精密部件构成的复杂动力系统，是现代大型客机获取推力的核心装置。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-b505bbe1d912bcde398fe7f44b786cf0" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-1176c140725a24bab24c669fe05a7824-e-4" label="Military jet">
        <attvalues>
          <attvalue for="0" value="Military jet" />
          <attvalue for="1" value="Aircraft Type" />
          <attvalue for="2" value="军用喷气机是一种由喷气发动机驱动的固定翼飞机，由武装部队用于执行战斗、侦察、拦截或训练等军事任务。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-1176c140725a24bab24c669fe05a7824" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1176c140725a24bab24c669fe05a7824-e-5" label="Land-based industrial gas turbine (IGT)">
        <attvalues>
          <attvalue for="0" value="Land-based industrial gas turbine (IGT)" />
          <attvalue for="1" value="Turbine Type" />
          <attvalue for="2" value="陆基工业燃气轮机是一种安装在地面，用于发电或提供机械驱动的燃气轮机。其任务周期为满足长期、稳定的高功率输出需求而优化，这与航空发动机多变的运行工况有显著区别。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-1176c140725a24bab24c669fe05a7824" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1176c140725a24bab24c669fe05a7824-e-6" label="Alloy">
        <attvalues>
          <attvalue for="0" value="Alloy" />
          <attvalue for="1" value="Material" />
          <attvalue for="2" value="**标准化描述:**&#10;&#10;合金是一种用于涡轮机制造的材料，其关键性能体现在蠕变与疲劳特性上。特定合金的选择直接受到任务周期的影响，因为它决定了材料在高温高压等严苛工况下的可靠性与耐久性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-1176c140725a24bab24c669fe05a7824" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-1176c140725a24bab24c669fe05a7824-e-8" label="Fatigue properties">
        <attvalues>
          <attvalue for="0" value="Fatigue properties" />
          <attvalue for="1" value="Material Property" />
          <attvalue for="2" value="疲劳性能是衡量材料在循环载荷或交变应力作用下，抵抗损伤和断裂能力的关键力学性能指标。它直接决定了材料（如涡轮合金）在长期服役下的可靠性、安全性和使用寿命。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-1176c140725a24bab24c669fe05a7824" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-1176c140725a24bab24c669fe05a7824-e-13" label="Mission cycle">
        <attvalues>
          <attvalue for="0" value="Mission cycle" />
          <attvalue for="1" value="Operating Condition" />
          <attvalue for="2" value="**任务循环 (Mission cycle)**&#10;&#10;一种运行工况，定义了发动机在特定应用下的完整运行剖面。该剖面会根据应用场景（如军用喷气机与陆基工业燃气轮机）的不同而变化，并对合金等工程材料的选择具有决定性影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-1176c140725a24bab24c669fe05a7824" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="15" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-38bfa031d75570a78eacff17ed6bac4a-e-7" label="Thermal Efficiency (Nth)">
        <attvalues>
          <attvalue for="0" value="Thermal Efficiency (Nth)" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="热效率（Nth）是衡量热力学循环（如发动机、发电厂）性能的无量纲指标。它被定义为系统输出的净有用功（Useful Work）与从高温热源吸收的总热量之比，是评估热能转化为机械功效率的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-38bfa031d75570a78eacff17ed6bac4a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-38bfa031d75570a78eacff17ed6bac4a-e-7&quot;, &quot;chunk-b4a23a49ff02000ccb51fce56eab7364-e-2&quot;, &quot;chunk-8a64ae02bc80ec0db6abf53700e681de-e-5&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-38bfa031d75570a78eacff17ed6bac4a-e-8" label="Specific Heat at Constant Pressure (cp)">
        <attvalues>
          <attvalue for="0" value="Specific Heat at Constant Pressure (cp)" />
          <attvalue for="1" value="Physical Constant" />
          <attvalue for="2" value="变量cp代表恒压比热容（Specific Heat Capacity at Constant Pressure）。在给定的工程热力学上下文中，它是一个关键的物理量参数，被用于定义和计算轴功率（Shaft Power）的方程中。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;1000 J/(kg K)&quot;}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-38bfa031d75570a78eacff17ed6bac4a" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;cp&quot;, &quot;cp (Heat Capacity)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-c25d44ad87f3dc200703221956ca5dd1-e-4&quot;, &quot;chunk-38bfa031d75570a78eacff17ed6bac4a-e-8&quot;, &quot;chunk-77e7186c113af3c719badc55546273f4-e-4&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-38bfa031d75570a78eacff17ed6bac4a-e-9" label="Intake Temperature">
        <attvalues>
          <attvalue for="0" value="Intake Temperature" />
          <attvalue for="1" value="Thermodynamic State Variable" />
          <attvalue for="2" value="进气温度 (Intake Temperature) 是一个热力学状态变量，指工作流体（工质）在进入一个热力学系统（如内燃机、压缩机）时的初始温度。它是确定系统初始状态、分析理想循环性能和计算热效率的关键输入参数。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;288 K&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-38bfa031d75570a78eacff17ed6bac4a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-38bfa031d75570a78eacff17ed6bac4a-e-13" label="Isentropic Temperature-Pressure Relation">
        <attvalues>
          <attvalue for="0" value="Isentropic Temperature-Pressure Relation" />
          <attvalue for="1" value="Governing Equation" />
          <attvalue for="2" value="一个热力学控制方程，它定量描述了在等熵过程（即绝热且可逆的过程）中，系统温度与压力之间遵循的特定数学关系。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;T / Tref = (P / Pref)(γ-1)/γ&quot;}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-38bfa031d75570a78eacff17ed6bac4a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b4a23a49ff02000ccb51fce56eab7364-e-1" label="Adiabatic Isentropic Reversible Process Equation">
        <attvalues>
          <attvalue for="0" value="Adiabatic Isentropic Reversible Process Equation" />
          <attvalue for="1" value="Equation" />
          <attvalue for="2" value="绝热等熵可逆过程方程是一个热力学基本公式，用于描述理想气体在无热量交换且熵保持不变的可逆过程中，其温度（T）和压力（P）之间的定量关系。该方程是分析理想热力循环（如卡诺循环、布雷顿循环）中工质状态变化和计算热效率的关键工具。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;T / Tref = (P / Pref)(γ-1)/γ&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-b4a23a49ff02000ccb51fce56eab7364" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b4a23a49ff02000ccb51fce56eab7364-e-1&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-b4a23a49ff02000ccb51fce56eab7364-e-5" label="Turbine Engine Performance">
        <attvalues>
          <attvalue for="0" value="Turbine Engine Performance" />
          <attvalue for="1" value="Application Context" />
          <attvalue for="2" value="涡轮发动机性能 (Turbine Engine Performance) 是对其整体运行效能的综合评估。它主要通过推力、推进效率等关键指标来衡量，并受到涡轮前温度等设计与运行参数的显著影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-b4a23a49ff02000ccb51fce56eab7364" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-b4a23a49ff02000ccb51fce56eab7364-e-5&quot;, &quot;chunk-5ef6f14d86770095e6f2e178382f2c4c-e-4&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-5ef6f14d86770095e6f2e178382f2c4c-e-7" label="Vo">
        <attvalues>
          <attvalue for="0" value="Vo" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="Vo是一个物理量，指气体在进入特定系统、设备或管道时的初始速度。作为流体动力学中的关键边界条件，它直接影响后续的流动状态、传质传热效率以及反应过程，是相关领域计算与模拟中的重要输入参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-5ef6f14d86770095e6f2e178382f2c4c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Entry Velocity (Vo)&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5ef6f14d86770095e6f2e178382f2c4c-e-7&quot;, &quot;chunk-116daeb47bda22d9815dd14d2f95ed25-e-3&quot;, &quot;chunk-8a64ae02bc80ec0db6abf53700e681de-e-1&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-5ef6f14d86770095e6f2e178382f2c4c-e-8" label="Performance Diagrams">
        <attvalues>
          <attvalue for="0" value="Performance Diagrams" />
          <attvalue for="1" value="Analytical Tool" />
          <attvalue for="2" value="性能图是一种用于分析涡轮喷气发动机的专用图表和分析工具。它通过图形化方式，直观地展示发动机在不同工况下的关键性能参数及其相互关系，用于评估和优化其运行表现。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-5ef6f14d86770095e6f2e178382f2c4c" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;performance diagrams&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-5ef6f14d86770095e6f2e178382f2c4c-e-8&quot;, &quot;chunk-116daeb47bda22d9815dd14d2f95ed25-e-6&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-116daeb47bda22d9815dd14d2f95ed25-e-1" label="prop">
        <attvalues>
          <attvalue for="0" value="prop" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="一个表示推进效率的物理量，通常缩写为prop。其值由两个等效公式 2/(1+Vjet/Vo) 和 1/(1+FN/(2V0M)) 定义，是喷射速度(Vjet)、飞行速度(Vo)和净推力(FN)等参数的函数。" />
          <attvalue for="3" value="{&quot;formula_1&quot;: &quot;2 / (1 + Vjet/Vo)&quot;, &quot;formula_2&quot;: &quot;1 / (1+ FN/(2V0M))&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-116daeb47bda22d9815dd14d2f95ed25" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-116daeb47bda22d9815dd14d2f95ed25-e-5" label="M">
        <attvalues>
          <attvalue for="0" value="M" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="M是在“prop”的第二个公式中使用的变量。它作为一个占位符，其具体数值或含义由该公式的上下文决定。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-116daeb47bda22d9815dd14d2f95ed25" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="428" />
          <attvalue for="10" value="0" />
        </attvalues>
      </node>
      <node id="chunk-116daeb47bda22d9815dd14d2f95ed25-e-10" label="C">
        <attvalues>
          <attvalue for="0" value="C" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="变量C，代表燃料的热值（calorific value），指单位质量或体积的燃料完全燃烧时所释放的热量。它是一个关键的热力学参数，在发动机工程中直接用于计算比油耗等核心性能指标。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;43 MJ/kg&quot;}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-116daeb47bda22d9815dd14d2f95ed25" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-116daeb47bda22d9815dd14d2f95ed25-e-11" label="Mcp">
        <attvalues>
          <attvalue for="0" value="Mcp" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="一个变量，在定义理想燃烧功（Z）的计算公式中作为一个关键术语。Z是该变量的函数，因此Mcp是计算理想燃烧功数值的核心输入参数之一。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-116daeb47bda22d9815dd14d2f95ed25" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-116daeb47bda22d9815dd14d2f95ed25-e-12" label="∆T">
        <attvalues>
          <attvalue for="0" value="∆T" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="∆T 是一个关键热力学参数，定义为燃气轮机等热力系统中，涡轮进口温度与压气机出口温度的差值。该值直接反映了燃烧室的温升，是评估系统热效率和性能的重要指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-116daeb47bda22d9815dd14d2f95ed25" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-116daeb47bda22d9815dd14d2f95ed25-e-12&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-116daeb47bda22d9815dd14d2f95ed25-e-14" label="compressor exit temperature">
        <attvalues>
          <attvalue for="0" value="compressor exit temperature" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="压气机出口温度是一个关键参数，指气体或流体经过压气机压缩增压后，在出口处测得的温度。它直接反映了压缩过程的做功情况和效率，常用于计算温差（∆T）及监控设备运行状态。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-116daeb47bda22d9815dd14d2f95ed25" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-8a64ae02bc80ec0db6abf53700e681de-e-4" label="Overall Efficiency (Noverall)">
        <attvalues>
          <attvalue for="0" value="Overall Efficiency (Noverall)" />
          <attvalue for="1" value="Performance Metric" />
          <attvalue for="2" value="总效率（Noverall）是衡量发动机性能的关键指标，定义为热效率（Nth）与推进效率（Nprop）的乘积。它综合评价发动机将燃料的化学能转化为有效推进功的能力，其数值常被视为总压比（OPR）的函数，并受涡轮进口温度（TET）等参数影响。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;Nth * Nprop&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-8a64ae02bc80ec0db6abf53700e681de" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-8a64ae02bc80ec0db6abf53700e681de-e-11" label="Engine Clearance">
        <attvalues>
          <attvalue for="0" value="Engine Clearance" />
          <attvalue for="1" value="Design Constraint" />
          <attvalue for="2" value="**发动机离翼间隙 (Engine Clearance)**&#10;&#10;一项关键的飞机设计约束，指安装于机翼下方的发动机与机翼结构间的距离。该间隙的大小直接制约着发动机可选用的最大风扇直径，并且是保证飞机在起飞阶段安全、防止发动机触地的关键因素。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-8a64ae02bc80ec0db6abf53700e681de" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8a64ae02bc80ec0db6abf53700e681de-e-12" label="Wing">
        <attvalues>
          <attvalue for="0" value="Wing" />
          <attvalue for="1" value="Aircraft Component" />
          <attvalue for="2" value="机翼是飞机的核心空气动力部件，其主要功能是产生升力以支撑飞机在空中飞行。它作为飞机的关键结构件，发动机通常被安装或吊挂在其下方。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-8a64ae02bc80ec0db6abf53700e681de" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8a64ae02bc80ec0db6abf53700e681de-e-12&quot;, &quot;chunk-d4872d4d3fa3d8ec025e5fc82bfd4fba-e-2&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-8a64ae02bc80ec0db6abf53700e681de-e-13" label="Aircraft">
        <attvalues>
          <attvalue for="0" value="Aircraft" />
          <attvalue for="1" value="Vehicle" />
          <attvalue for="2" value="一种能在大气层内飞行的机器，是包含机翼和发动机等关键部件的复杂系统。它通过机翼与空气相互作用产生升力，或由发动机直接提供推力来克服自身重力，从而实现空中航行。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-8a64ae02bc80ec0db6abf53700e681de" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-8a64ae02bc80ec0db6abf53700e681de-e-13&quot;, &quot;chunk-d4872d4d3fa3d8ec025e5fc82bfd4fba-e-3&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-8a64ae02bc80ec0db6abf53700e681de-e-14" label="Take-off">
        <attvalues>
          <attvalue for="0" value="Take-off" />
          <attvalue for="1" value="Flight Phase" />
          <attvalue for="2" value="起飞是飞机从地面加速滑跑直至离地升空的飞行阶段。在此过程中，保持足够的发动机离地间隙是一项至关重要的安全要求，以防止发动机在抬轮或初始爬升时与地面发生碰擦。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-14" />
          <attvalue for="5" value="chunk-8a64ae02bc80ec0db6abf53700e681de" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d4872d4d3fa3d8ec025e5fc82bfd4fba-e-5" label="Fan blades">
        <attvalues>
          <attvalue for="0" value="Fan blades" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="作为发动机风扇的核心气动组件，它是一组安装在轮盘上的翼型叶片。其内外径比等几何参数是关键的设计约束，直接决定了发动机的进气量、效率和推力性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-d4872d4d3fa3d8ec025e5fc82bfd4fba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d4872d4d3fa3d8ec025e5fc82bfd4fba-e-6" label="Ratio of inner and outer diameter">
        <attvalues>
          <attvalue for="0" value="Ratio of inner and outer diameter" />
          <attvalue for="1" value="Constraint" />
          <attvalue for="2" value="内外径比，是指应用于风扇叶片的一项尺寸约束。它通过规定叶片轮毂处内径与叶片顶端外径之间的比例，来限制叶片的几何形状，是影响风扇气动性能和结构强度的关键设计参数。" />
          <attvalue for="3" value="{&quot;value&quot;: &quot;0.37&quot;}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-d4872d4d3fa3d8ec025e5fc82bfd4fba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d4872d4d3fa3d8ec025e5fc82bfd4fba-e-7" label="Rate of mass intake">
        <attvalues>
          <attvalue for="0" value="Rate of mass intake" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="一个关键的发动机性能参数，指单位时间内流入发动机的工质（如空气）的质量。其数值大小由发动机尺寸和巡航速度等运行条件共同决定，是评估发动机性能和效率的基础。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-d4872d4d3fa3d8ec025e5fc82bfd4fba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d4872d4d3fa3d8ec025e5fc82bfd4fba-e-8" label="Cruising speed">
        <attvalues>
          <attvalue for="0" value="Cruising speed" />
          <attvalue for="1" value="Condition" />
          <attvalue for="2" value="巡航速度是一种典型的运行速度，作为一项关键条件参数，它被用以计算并直接决定单位时间内的质量吸入率（Rate of mass intake）。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-d4872d4d3fa3d8ec025e5fc82bfd4fba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-d4872d4d3fa3d8ec025e5fc82bfd4fba-e-9" label="Mass intake into the turbine section">
        <attvalues>
          <attvalue for="0" value="Mass intake into the turbine section" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="指单位时间内流入航空发动机涡轮段的工质（燃气）质量，是流经核心机的流量。在涡扇发动机中，该参数与总进气量的比例由涵道比（BPR）决定，是计算核心推力的关键依据。" />
          <attvalue for="3" value="{&quot;unit&quot;: &quot;kg/s&quot;}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-d4872d4d3fa3d8ec025e5fc82bfd4fba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-d4872d4d3fa3d8ec025e5fc82bfd4fba-e-11" label="Turbine section">
        <attvalues>
          <attvalue for="0" value="Turbine section" />
          <attvalue for="1" value="Component" />
          <attvalue for="2" value="涡轮发动机的核心组件，位于燃烧室下游。它接收高温高压燃气，并引导其膨胀做功，将气流的热能转化为旋转机械能，用以驱动发动机的压气机及附件。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-d4872d4d3fa3d8ec025e5fc82bfd4fba" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-77e7186c113af3c719badc55546273f4-e-1" label="Shaft Power">
        <attvalues>
          <attvalue for="0" value="Shaft Power" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="**轴功率 (Shaft Power)**&#10;&#10;一种物理量，特指涡轮级将工质热能转化为的机械输出功率。其大小可由工质的质量流量(M)、定压比热容(cp)与温降(∆T)的乘积（Mcp∆T）近似计算。" />
          <attvalue for="3" value="{&quot;formula&quot;: &quot;Mcp∆T&quot;}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-77e7186c113af3c719badc55546273f4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Shaft power&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-77e7186c113af3c719badc55546273f4-e-1&quot;, &quot;chunk-0f24474e96c9ef42ab24560f2ccf918e-e-8&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="5" />
        </attvalues>
      </node>
      <node id="chunk-77e7186c113af3c719badc55546273f4-e-2" label="Turbine Stage">
        <attvalues>
          <attvalue for="0" value="Turbine Stage" />
          <attvalue for="1" value="System Component" />
          <attvalue for="2" value="涡轮级是涡轮机的基本能量转换单元，通常由一列静叶和一列动叶组成。在热力学分析中，为了简化计算和评估效率，其工作过程常被理想化地假设为无摩擦、无热量交换的等熵过程，作为评估实际性能的基准。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-77e7186c113af3c719badc55546273f4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;Turbine stages&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-4093026dc043845c048897c7c1f6fe61-e-3&quot;, &quot;chunk-77e7186c113af3c719badc55546273f4-e-2&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-77e7186c113af3c719badc55546273f4-e-5" label="∆T (Temperature Drop)">
        <attvalues>
          <attvalue for="0" value="∆T (Temperature Drop)" />
          <attvalue for="1" value="Variable" />
          <attvalue for="2" value="∆T（温降）是一个物理变量，指工质（如燃气）流经涡轮机等旋转机械的叶片时所发生的温度降低。在轴功率方程中，它是一个核心参数，用于量化热能到机械功的转换效率，并据此计算最终的功率输出。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-77e7186c113af3c719badc55546273f4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-77e7186c113af3c719badc55546273f4-e-5&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-77e7186c113af3c719badc55546273f4-e-6" label="High-Pressure (HP) Stage">
        <attvalues>
          <attvalue for="0" value="High-Pressure (HP) Stage" />
          <attvalue for="1" value="Engine Component" />
          <attvalue for="2" value="高压（HP）级是涡轮系统中的一个组件总成，作为高压工质能量转换的初始阶段。它包含高压转轴以及一级或多级静叶与动叶，其核心功能是将工质的热能与压力能高效转化为驱动转轴旋转的机械功。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-77e7186c113af3c719badc55546273f4" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[&quot;High-Pressure (HP) stage&quot;]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-77e7186c113af3c719badc55546273f4-e-6&quot;, &quot;chunk-0f24474e96c9ef42ab24560f2ccf918e-e-1&quot;]}]" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-77e7186c113af3c719badc55546273f4-e-10" label="Turbine">
        <attvalues>
          <attvalue for="0" value="Turbine" />
          <attvalue for="1" value="Engine Section" />
          <attvalue for="2" value="涡轮是航空发动机的核心部件，位于燃烧室下游，由一系列涡轮级组成。它将高温高压燃气的能量转化为旋转机械功，用于驱动压气机和风扇等。其入口温度（TET）是衡量发动机性能的关键参数。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-77e7186c113af3c719badc55546273f4" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0f24474e96c9ef42ab24560f2ccf918e-e-4" label="HP shaft">
        <attvalues>
          <attvalue for="0" value="HP shaft" />
          <attvalue for="1" value="System Component" />
          <attvalue for="2" value="高压轴（HP shaft）是高压级的核心旋转部件。作为系统组件，它的主要功能是连接高压级的涡轮与压气机（或类似部件），并传递由该级产生的扭矩与功率。" />
          <attvalue for="3" value="{&quot;angular_speed&quot;: &quot;1000 rad/s&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-0f24474e96c9ef42ab24560f2ccf918e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-0f24474e96c9ef42ab24560f2ccf918e-e-5" label="LP shaft">
        <attvalues>
          <attvalue for="0" value="LP shaft" />
          <attvalue for="1" value="System Component" />
          <attvalue for="2" value="低压轴（LP shaft）是构成低压级（Low-Pressure stage）核心的系统组件，其主要功能是传递由该级产生的动力，并承受与之相关的扭矩。" />
          <attvalue for="3" value="{&quot;angular_speed&quot;: &quot;300 rad/s&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-0f24474e96c9ef42ab24560f2ccf918e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-0f24474e96c9ef42ab24560f2ccf918e-e-6" label="Power">
        <attvalues>
          <attvalue for="0" value="Power" />
          <attvalue for="1" value="Physical Quantity" />
          <attvalue for="2" value="功率（Power）是表示做功快慢的物理量，即单位时间内所做的功。在此特指由高压（HP）轴和低压（LP）轴所产生的机械功率，是评估其性能的关键指标。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-0f24474e96c9ef42ab24560f2ccf918e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="2" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0f24474e96c9ef42ab24560f2ccf918e-e-10" label="Superalloy components">
        <attvalues>
          <attvalue for="0" value="Superalloy components" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="高温合金构件是由特种金属合金制造的部件，能在极端高温环境下保持优异的机械强度、抗蠕变和抗腐蚀性能。它们是制造航空发动机、燃气轮机等设备中关键热端部件（如涡轮叶片）的核心材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-0f24474e96c9ef42ab24560f2ccf918e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-0f24474e96c9ef42ab24560f2ccf918e-e-12" label="Single-crystal form">
        <attvalues>
          <attvalue for="0" value="Single-crystal form" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="一种材料形态，指整个部件由单一、连续的晶格构成，无内部晶界。它通过定向凝固等特殊铸造工艺制成，具有卓越的高温强度和抗蠕变性，是制造航空发动机涡轮叶片等高性能热端部件的理想形式。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-0f24474e96c9ef42ab24560f2ccf918e" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-0f24474e96c9ef42ab24560f2ccf918e-e-13" label="Columnar form">
        <attvalues>
          <attvalue for="0" value="Columnar form" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="一种通过定向凝固等铸造工艺获得的材料形态。其内部晶粒沿特定方向平行生长，形成柱状结构，以消除横向晶界，从而为涡轮叶片等部件提供优异的定向高温力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-13" />
          <attvalue for="5" value="chunk-0f24474e96c9ef42ab24560f2ccf918e" />
          <attvalue for="6" value="true" />
          <attvalue for="7" value="[]" />
          <attvalue for="8" value="[{&quot;merged_from&quot;: [&quot;chunk-0f24474e96c9ef42ab24560f2ccf918e-e-13&quot;, &quot;chunk-e3bc91d02528ce132349b28825081f88-e-3&quot;]}]" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e3bc91d02528ce132349b28825081f88-e-2" label="Single-crystal form">
        <attvalues>
          <attvalue for="0" value="Single-crystal form" />
          <attvalue for="1" value="Material Form" />
          <attvalue for="2" value="一种材料形态，指整个部件由单一、连续且无晶界的晶体构成。它通常通过定向凝固等特殊铸造工艺制成，用于制造涡轮叶片等高性能构件，以获得卓越的高温力学性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-e3bc91d02528ce132349b28825081f88" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e3bc91d02528ce132349b28825081f88-e-8" label="High-temperature alloy">
        <attvalues>
          <attvalue for="0" value="High-temperature alloy" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="高温合金（或称超合金）是一类以铁、镍、钴为基体（金属溶剂）的合金。其核心特征是在600°C以上的高温环境中，仍能保持优异的机械强度、抗蠕变性、持久的稳定性以及良好的抗氧化和抗腐蚀能力，主要应用于航空航天和能源领域。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-e3bc91d02528ce132349b28825081f88" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e3bc91d02528ce132349b28825081f88-e-9" label="Metal solvent">
        <attvalues>
          <attvalue for="0" value="Metal solvent" />
          <attvalue for="1" value="Material Component" />
          <attvalue for="2" value="作为高温合金的基体金属和主要组分，其选择基于关键物理参数Qv/(RTm)进行。该参数是决定合金高温稳定性和力学性能的重要指标，确保材料在极端环境下的可靠性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-9" />
          <attvalue for="5" value="chunk-e3bc91d02528ce132349b28825081f88" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-e3bc91d02528ce132349b28825081f88-e-10" label="Qv/(RTm)">
        <attvalues>
          <attvalue for="0" value="Qv/(RTm)" />
          <attvalue for="1" value="Parameter" />
          <attvalue for="2" value="一个用于为高温合金选择最佳金属溶剂的物理参数，表达式为Qv/(RTm)。该参数由材料的空位形成能(Qv)、绝对熔点(Tm)和气体常数(R)构成，是评估金属溶剂适用性的重要判据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-e3bc91d02528ce132349b28825081f88" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="4" />
        </attvalues>
      </node>
      <node id="chunk-e169602f8c36042ddef4827a52729f2a-e-6" label="Diffusivity at the melting temperature">
        <attvalues>
          <attvalue for="0" value="Diffusivity at the melting temperature" />
          <attvalue for="1" value="Performance Measure" />
          <attvalue for="2" value="熔点扩散率是一种衡量金属性能的指标，指物质在熔点（Tm）温度下的原子扩散速率。它被用作一种替代性评估标准，来补充或替代仅基于熔点本身的性能评估方法。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-6" />
          <attvalue for="5" value="chunk-e169602f8c36042ddef4827a52729f2a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e169602f8c36042ddef4827a52729f2a-e-7" label="Gas turbine applications">
        <attvalues>
          <attvalue for="0" value="Gas turbine applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="燃气轮机的一种应用领域。其材料选择对金属绝对温度、密度和成本等因素高度敏感，旨在平衡极端工况下的性能、重量及经济性。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-7" />
          <attvalue for="5" value="chunk-e169602f8c36042ddef4827a52729f2a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-e169602f8c36042ddef4827a52729f2a-e-8" label="Absolute metal temperature">
        <attvalues>
          <attvalue for="0" value="Absolute metal temperature" />
          <attvalue for="1" value="Physical Property" />
          <attvalue for="2" value="绝对金属温度指以绝对温标（如开尔文）计量的金属部件实际温度。在燃气轮机等高温应用中，它是评估材料性能、预测寿命及确保结构安全性的直接物理依据，通常被认为比归一化熔点温度更具工程实践意义。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
          <attvalue for="5" value="chunk-e169602f8c36042ddef4827a52729f2a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e169602f8c36042ddef4827a52729f2a-e-10" label="Cost">
        <attvalues>
          <attvalue for="0" value="Cost" />
          <attvalue for="1" value="Economic Factor" />
          <attvalue for="2" value="成本是一种经济因素，指为获取、运营和维护资产或服务所付出的资源总价值，通常以货币计量。它全面涵盖初始资本支出、持续运营费用和维护费用。对全生命周期成本的评估是衡量项目（如燃气轮机应用）经济可行性的关键依据。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-10" />
          <attvalue for="5" value="chunk-e169602f8c36042ddef4827a52729f2a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="4" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-e169602f8c36042ddef4827a52729f2a-e-11" label="Performance suggestions based on Tm">
        <attvalues>
          <attvalue for="0" value="Performance suggestions based on Tm" />
          <attvalue for="1" value="Concept" />
          <attvalue for="2" value="一种材料性能评估方法，用于对FCC、BCC和HCP等晶体结构的金属进行排序。该方法的核心是依据一个经材料自身熔点(Tm)归一化的数值进行评估，可作为熔点扩散率等指标的替代评估方案。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-11" />
          <attvalue for="5" value="chunk-e169602f8c36042ddef4827a52729f2a" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="19" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-062c12e756b5b5e7f808077ef31ba609-e-1" label="Turbine blade applications">
        <attvalues>
          <attvalue for="0" value="Turbine blade applications" />
          <attvalue for="1" value="Application" />
          <attvalue for="2" value="一个特定的工程应用领域，其核心任务是根据预设的性能评价标准（merit criterion），为涡轮叶片评估并筛选出最合适的过渡金属（transition metal）材料。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-1" />
          <attvalue for="5" value="chunk-062c12e756b5b5e7f808077ef31ba609" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="79" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-062c12e756b5b5e7f808077ef31ba609-e-2" label="Transition metals">
        <attvalues>
          <attvalue for="0" value="Transition metals" />
          <attvalue for="1" value="Material Class" />
          <attvalue for="2" value="过渡金属是一类金属元素。在当前上下文中，它们是为涡轮叶片应用而评估的一组候选材料，目标是筛选出能最大化特定优值标准的最佳选择。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-062c12e756b5b5e7f808077ef31ba609" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="79" />
          <attvalue for="10" value="2" />
        </attvalues>
      </node>
      <node id="chunk-062c12e756b5b5e7f808077ef31ba609-e-3" label="Merit criterion">
        <attvalues>
          <attvalue for="0" value="Merit criterion" />
          <attvalue for="1" value="Evaluation Metric" />
          <attvalue for="2" value="一种性能评估指标，用于为涡轮叶片应用筛选最优的过渡金属。该指标综合衡量材料的绝对温度、密度和成本等关键因素，以实现性能最大化，其设计受Brown and Ashby研究的启发。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-062c12e756b5b5e7f808077ef31ba609" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="79" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-062c12e756b5b5e7f808077ef31ba609-e-4" label="Brown and Ashby">
        <attvalues>
          <attvalue for="0" value="Brown and Ashby" />
          <attvalue for="1" value="Reference" />
          <attvalue for="2" value="由布朗与阿什比 (Brown and Ashby) 所著的一篇参考文献。该文献中提出的考量因素，为“优值标准”(Merit criterion)的分析与建立提供了理论依据和指导。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
