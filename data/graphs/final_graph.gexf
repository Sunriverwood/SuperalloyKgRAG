      <node id="chunk-b18667fadfdf7cfdf2bd35cc10bf1f84-e-7" label="CFM56-3C-1 Turbofan Engine">
        <attvalues>
          <attvalue for="0" value="CFM56-3C-1 Turbofan Engine" />
