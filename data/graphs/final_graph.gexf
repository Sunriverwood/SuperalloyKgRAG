        <attvalues>
          <attvalue for="11" value="CAUSES_FORMATION_OF" />
          <attvalue for="12" value="The oxidation of Group II alloys causes the formation of an external scale of Cr2O3." />
          <attvalue for="13" value="The oxidation of Group II alloys, which contain high levels of Cr, causes an external scale of Cr2O3 and internal precipitation" />
          <attvalue for="14" value="r-9" />
          <attvalue for="15" value="chunk-2292cbd804c7d75d1e8a3ada6e8b42bd" />
          <attvalue for="16" value="0.0005439956480348157" />
