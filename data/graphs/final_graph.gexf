        <attvalues>
          <attvalue for="11" value="REDUCED_IN" />
          <attvalue for="12" value="The concentration of Titanium (Ti) was reduced in single-crystal superalloys." />
          <attvalue for="13" value="Of note is the introduction of significant additions of Re, and the reduction of Ti and Mo to low concentrations." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-f14b0074e13363327f2213611a99c96e" />
          <attvalue for="17" value="0.4" />
