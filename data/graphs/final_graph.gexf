        <attvalues>
          <attvalue for="11" value="IMPROVES" />
          <attvalue for="12" value="Increasing the γ' size improved the fatigue crack propagation rates at 650°C." />
          <attvalue for="13" value="fatigue crack propagation rates at 650°C were improved by increasing the γ' fraction and size" />
          <attvalue for="14" value="r-2" />
          <attvalue for="15" value="chunk-198cb71263c64f896cad9847f29b39cf" />
          <attvalue for="16" value="0.00021008403361344536" />
