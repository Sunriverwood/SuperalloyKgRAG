        <attvalues>
          <attvalue for="11" value="IS_PERTINENT_TO" />
          <attvalue for="12" value="The failure conditions are relevant to the operational environment of a gas turbine." />
          <attvalue for="13" value="failure conditions (for example, temperature gradients, cycling times) pertinent to the gas turbine in the laboratory" />
          <attvalue for="14" value="r-5" />
