        <attvalues>
          <attvalue for="11" value="COVERS" />
          <attvalue for="12" value="At its optimum concentration, Carbon covers y-grain boundaries with a few monolayers." />
          <attvalue for="13" value="At these levels, it can be demonstrated that the y-grain boundaries are covered with just a few monolayers of these grain-boundary elements." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-6007146f18f54e1531784eefc3822dae" />
          <attvalue for="16" value="0.0002496878901373283" />
