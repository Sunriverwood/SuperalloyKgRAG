      <edge source="chunk-d89de553b45749db88cca84e98f06178-e-8" target="chunk-d89de553b45749db88cca84e98f06178-e-10" id="chunk-d89de553b45749db88cca84e98f06178-r-10" weight="5.0">
        <attvalues>
          <attvalue for="11" value="CHILLS" />
          <attvalue for="12" value="Heat sinks chill the central portion of the disc." />
          <attvalue for="13" value="which chill the central portion of the disc as it resides in the furnace above the γ'-solvus" />
          <attvalue for="14" value="r-10" />
          <attvalue for="15" value="chunk-d89de553b45749db88cca84e98f06178" />
          <attvalue for="16" value="3.4806822137138876e-05" />
          <attvalue for="17" value="0.4000208840932823" />
        </attvalues>
