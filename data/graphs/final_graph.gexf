        </attvalues>
      </node>
      <node id="chunk-2a7c59397b735114b173a918c874616d-e-2" label="D. A. Cooper">
        <attvalues>
          <attvalue for="0" value="D. A. Cooper" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. A. Cooper，英国航空事故调查官员，1985年英航28M号班机曼彻斯特空难官方调查报告的主笔作者。该报告对波音737（G-BGJL）客机的事故进行了权威分析，其提出的安全建议对全球民航业产生了深远影响。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-2" />
          <attvalue for="5" value="chunk-2a7c59397b735114b173a918c874616d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2a7c59397b735114b173a918c874616d-e-3" label="D. F. King">
        <attvalues>
          <attvalue for="0" value="D. F. King" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="D. F. King，英国航空事故调查局（AAIB）的调查员。他作为主要作者，撰写了关于1985年8月22日发生在曼彻斯特机场的波音737（G-BGJL）空难（即英国空旅航空28M号班机事故）的官方调查报告。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-2a7c59397b735114b173a918c874616d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-2a7c59397b735114b173a918c874616d-e-4" label="Report on the Accident to Boeing 737-237 Series 1 (G-BGJL) at Manchester International Airport on 22nd August 1985">
        <attvalues>
          <attvalue for="0" value="Report on the Accident to Boeing 737-237 Series 1 (G-BGJL) at Manchester International Airport on 22nd August 1985" />
          <attvalue for="1" value="Document" />
          <attvalue for="2" value="一份由英国交通部赞助的官方航空事故调查报告，正式编号为“航空事故报告8/88”。报告由D. A. Cooper与D. F. King合著，详细分析了1985年8月22日发生在曼彻斯特国际机场的波音737-237（G-BGJL）空难的经过与原因。该报告由女王陛下文书局于1988年出版。" />
          <attvalue for="3" value="{&quot;publication_year&quot;: &quot;1988&quot;, &quot;report_number&quot;: &quot;8/88&quot;}" />
          <attvalue for="4" value="e-4" />
          <attvalue for="5" value="chunk-2a7c59397b735114b173a918c874616d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
          <attvalue for="10" value="6" />
        </attvalues>
      </node>
      <node id="chunk-2a7c59397b735114b173a918c874616d-e-5" label="Boeing 737-237 Series 1">
        <attvalues>
          <attvalue for="0" value="Boeing 737-237 Series 1" />
          <attvalue for="1" value="Aircraft" />
          <attvalue for="2" value="波音737-200系列窄体客机的一个型号，其中“-37”是波音公司给予英国空旅航空（British Airtours）的客户代码。注册号为G-BGJL的该型号飞机因1985年8月22日发生在曼彻斯特国际机场的空难而广为人知。" />
          <attvalue for="3" value="{&quot;registration&quot;: &quot;G-BGJL&quot;}" />
          <attvalue for="4" value="e-5" />
          <attvalue for="5" value="chunk-2a7c59397b735114b173a918c874616d" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="8" />
