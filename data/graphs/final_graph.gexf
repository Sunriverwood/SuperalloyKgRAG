          <attvalue for="9" value="7" />
          <attvalue for="10" value="3" />
        </attvalues>
      </node>
      <node id="chunk-fd0257f35193366950536d3c582b3768-e-3" label="quality assurance">
        <attvalues>
          <attvalue for="0" value="quality assurance" />
          <attvalue for="1" value="Process" />
          <attvalue for="2" value="质量保证是一种系统性的管理过程，旨在通过监控和改进生产或服务流程来预防缺陷，以确保最终产品或服务能持续满足既定的质量标准与客户要求。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-3" />
          <attvalue for="5" value="chunk-fd0257f35193366950536d3c582b3768" />
          <attvalue for="6" value="true" />
          <attvalue for="9" value="7" />
          <attvalue for="10" value="1" />
        </attvalues>
      </node>
      <node id="chunk-fd0257f35193366950536d3c582b3768-e-4" label="physical insights">
        <attvalues>
          <attvalue for="0" value="physical insights" />
          <attvalue for="1" value="Information" />
          <attvalue for="2" value="一种通过过程建模获得的、对流程内在物理规律的深刻认识。这种知识能够启发并指导流程的再造与优化，以提升其效率和性能。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-4" />
