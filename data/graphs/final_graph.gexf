        <attvalues>
          <attvalue for="0" value="Thoria-doped tungsten" />
          <attvalue for="1" value="Exotic Alloy" />
          <attvalue for="2" value="An exotic alloy that shows promise as a high-temperature material but has not yet found application in the gas turbine." />
