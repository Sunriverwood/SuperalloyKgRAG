      <edge source="chunk-5af1439dfd2daa394494b8c8df9e4287-e-4" target="chunk-44a9440aa3e5fad0c388f77698c519bf-e-14" id="chunk-5af1439dfd2daa394494b8c8df9e4287-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="DISPROVES_CORRELATION_WITH" />
          <attvalue for="12" value="Experimental results disprove the view that diffusion is least rapid when the lattice misfit is greatest." />
          <attvalue for="13" value="These experimental results are interesting, since they disprove the widely held view that diffusion is least rapid when the lattice misfit between solute and solvent atom radii is the greatest." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-5af1439dfd2daa394494b8c8df9e4287" />
          <attvalue for="16" value="0.0004524886877828054" />
          <attvalue for="17" value="0.4002714932126697" />
        </attvalues>
      </edge>
      <edge source="chunk-5af1439dfd2daa394494b8c8df9e4287-e-8" target="chunk-5af1439dfd2daa394494b8c8df9e4287-e-4" id="chunk-5af1439dfd2daa394494b8c8df9e4287-r-6" weight="5.0">
        <attvalues>
          <attvalue for="11" value="EXPLAINS" />
          <attvalue for="12" value="Quantum-mechanical modelling has been used to rationalize observations related to diffusion." />
          <attvalue for="13" value="These observations have been rationalised using quantum-mechanical modelling" />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-5af1439dfd2daa394494b8c8df9e4287" />
          <attvalue for="17" value="0.4" />
        </attvalues>
      </edge>
      <edge source="chunk-5af1439dfd2daa394494b8c8df9e4287-e-8" target="chunk-7e95d744723775d720f898b62dc67090-e-2" id="chunk-7e95d744723775d720f898b62dc67090-r-1" weight="5.0">
        <attvalues>
          <attvalue for="11" value="USES" />
          <attvalue for="12" value="Quantum-mechanical modelling is performed using first principles methods." />
          <attvalue for="13" value="These observations have been rationalised using quantum-mechanical modelling using first principles methods [31,32];" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-7e95d744723775d720f898b62dc67090" />
          <attvalue for="16" value="1.4736221632773356e-05" />
          <attvalue for="17" value="0.4000088417329797" />
        </attvalues>
      </edge>
