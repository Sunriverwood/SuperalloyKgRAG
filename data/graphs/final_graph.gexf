        <attvalues>
          <attvalue for="11" value="IS_DEFINED_BY" />
          <attvalue for="12" value="Thermal efficiency is defined as the ratio of useful work to another quantity." />
          <attvalue for="13" value="The efficiency, η, defined as the ratio of the useful work obtained, W, to the heat absorbed from the heat source, QAB, is given by η = W/QAB" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-c7e7be1b79841f37e4aee97dd32c3432" />
          <attvalue for="16" value="0.031796176853436296" />
