        <attvalues>
          <attvalue for="0" value="W. H. Murphy" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="W. H. Murphy是一位材料科学领域的研究者。他撰写了一篇关于高温合金微观结构不稳定性的论文，该论文发表于学术出版物《Superalloys 1996》中。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-8" />
