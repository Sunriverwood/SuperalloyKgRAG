        <attvalues>
          <attvalue for="11" value="IS_CALCULATED_USING" />
          <attvalue for="12" value="The probability p2 is calculated using the term (D - d)/D." />
          <attvalue for="13" value="p2 {Np &lt; No} = [1 - (1 - DS/V)^(n_v V)] [(D - d)/D] (4.11)" />
          <attvalue for="14" value="r-6" />
