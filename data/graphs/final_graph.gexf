      <node id="chunk-6f4f79d57f35ab3e77324ff6707d70bf-e-12" label="Degradation mechanisms of an advanced jet engine service-retired TBC component">
        <attvalues>
          <attvalue for="0" value="Degradation mechanisms of an advanced jet engine service-retired TBC component" />
          <attvalue for="1" value="Publication" />
          <attvalue for="2" value="一篇由R. T. Wu、M. Osawa等人合著并提交至《Acta Materialia》期刊的科学论文。该论文通过研究一件从先进航空发动机上服役后退役的部件，深入分析了其热障涂层（TBC）的降解机制。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-12" />
          <attvalue for="5" value="chunk-6f4f79d57f35ab3e77324ff6707d70bf" />
