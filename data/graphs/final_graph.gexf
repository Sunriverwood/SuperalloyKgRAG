        <attvalues>
          <attvalue for="11" value="HINDERS_REMOVAL_OF" />
          <attvalue for="12" value="The presence of titanium, a nitride-forming element, makes it difficult to completely remove nitrogen." />
          <attvalue for="13" value="it is difficult to remove them completely when nitride-forming elements such as titanium and niobium are present." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-a112fb1af2aeb898bf0f5a14a40c216f" />
