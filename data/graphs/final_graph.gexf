      <edge source="chunk-f5c07b55f3d29bb402b546962b69a445-e-8" target="chunk-49fe0f122b885e8929f914d54a677b92-e-2" id="chunk-49fe0f122b885e8929f914d54a677b92-r-1" weight="4.0">
        <attvalues>
          <attvalue for="11" value="COMPONENT_OF" />
          <attvalue for="12" value="The turbine disc is a component intended for a business jet." />
          <attvalue for="13" value="business jet. The final disc weighs about 8 kg, but it is machined from a disc of mass 45 kg." />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-49fe0f122b885e8929f914d54a677b92" />
          <attvalue for="16" value="0.0011763680724991286" />
          <attvalue for="17" value="0.2673724875101661" />
        </attvalues>
      </edge>
      <edge source="chunk-f5c07b55f3d29bb402b546962b69a445-e-8" target="chunk-a9fba026e3b8980c4957dbe16260f585-e-7" id="chunk-49fe0f122b885e8929f914d54a677b92-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="COMPONENT_OF" />
          <attvalue for="12" value="Turbine discs are a component of jet engines." />
          <attvalue for="13" value="Although superalloys have been used for the turbine discs in jet engines for about 50 years, the processing is not without some challenges." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-49fe0f122b885e8929f914d54a677b92" />
          <attvalue for="16" value="0.0011763680724991286" />
          <attvalue for="17" value="0.4007058208434995" />
        </attvalues>
      </edge>
      <edge source="chunk-f5c07b55f3d29bb402b546962b69a445-e-8" target="chunk-577e71f977df9c88b625f750e5b679c3-e-5" id="chunk-577e71f977df9c88b625f750e5b679c3-r-4" weight="4.0">
        <attvalues>
          <attvalue for="11" value="REQUIRES" />
          <attvalue for="12" value="Turbine discs have a need for fatigue resistance." />
          <attvalue for="13" value="...this was problematical in view of the need for fatigue resistance." />
          <attvalue for="14" value="r-4" />
          <attvalue for="15" value="chunk-577e71f977df9c88b625f750e5b679c3" />
          <attvalue for="17" value="0.26666666666666666" />
        </attvalues>
      </edge>
      <edge source="chunk-f5c07b55f3d29bb402b546962b69a445-e-8" target="chunk-1cedf1737fe4754f24d3e9eaa5f64aed-e-4" id="chunk-1cedf1737fe4754f24d3e9eaa5f64aed-r-3" weight="5.0">
        <attvalues>
          <attvalue for="11" value="EXPERIENCES_GREATER_STRESS_THAN" />
          <attvalue for="12" value="The stresses experienced by turbine discs are much greater than those experienced by turbine blading." />
          <attvalue for="13" value="Our considerations indicate that the operating temperatures for turbine discs are considerably lower than for turbine blading, but that the stresses experienced are much greater." />
          <attvalue for="14" value="r-3" />
          <attvalue for="15" value="chunk-1cedf1737fe4754f24d3e9eaa5f64aed" />
          <attvalue for="16" value="0.0011763680724991286" />
          <attvalue for="17" value="0.4007058208434995" />
        </attvalues>
      </edge>
