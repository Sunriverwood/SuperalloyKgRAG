        <attvalues>
          <attvalue for="11" value="INFLUENCED_BY" />
          <attvalue for="12" value="Buckling is more likely to occur when the thickness (h) is small." />
          <attvalue for="13" value="This occurs when h is small, b is large or for low in-plane stiffness, E||, i.e. on the bottom left-hand side of the failure map." />
          <attvalue for="14" value="r-6" />
          <attvalue for="15" value="chunk-80545b960495f33fd33c6ee9963001b5" />
          <attvalue for="16" value="0.02138702460850112" />
