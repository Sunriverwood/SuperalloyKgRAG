        <attvalues>
          <attvalue for="11" value="SEPARATES" />
          <attvalue for="12" value="The elastic force, R, acts to keep the pair of dislocations separated." />
          <attvalue for="13" value="acting to keep the pair separated" />
          <attvalue for="14" value="r-8" />
          <attvalue for="15" value="chunk-ac23817ca85b5e2cba9cb1da3a1960fc" />
          <attvalue for="16" value="0.0017459378784038747" />
