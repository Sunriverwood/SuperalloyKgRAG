        <attvalues>
          <attvalue for="11" value="DEPENDS_ON" />
          <attvalue for="12" value="The properties of a turbine disc alloy are critically dependent on the heat treatment applied to it." />
          <attvalue for="13" value="turbine disc alloy has been found to depend critically on the heat treatment applied to it" />
          <attvalue for="14" value="r-1" />
          <attvalue for="15" value="chunk-54d9cab0bf8e738ae99d8958ce8cd086" />
          <attvalue for="17" value="0.4" />
        </attvalues>
