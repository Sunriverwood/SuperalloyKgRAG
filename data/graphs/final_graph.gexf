      <node id="chunk-cb57093a6357773efc0ab02b57f76fa1-e-15" label="Dr Mike Miller">
        <attvalues>
          <attvalue for="0" value="Dr Mike Miller" />
          <attvalue for="1" value="Person" />
          <attvalue for="2" value="迈克·米勒博士（Dr Mike Miller），美国橡树岭国家实验室的研究人员。他与该实验室存在隶属关系，表明其可能在该机构从事科研或其他相关工作。" />
          <attvalue for="3" value="{}" />
          <attvalue for="4" value="e-15" />
