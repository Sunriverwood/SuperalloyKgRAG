        <attvalues>
          <attvalue for="11" value="INFLUENCES REQUIREMENT FOR" />
          <attvalue for="12" value="The large size of the blading is given as a reason for the emphasis on castability." />
          <attvalue for="13" value="...greater emphasis on... castability due to the large size of the blading..." />
          <attvalue for="14" value="r-7" />
          <attvalue for="15" value="chunk-d59969b39f742308167ec01469929e5b" />
